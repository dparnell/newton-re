// The Metric Conversion panel (@8306): a measurement picker (length, area,
// weight, U.S. and British liquid, temperature) and two unit lines, U.S. (line
// 0) and metric (line 1); filling either computes the other.  The tables give,
// for each metric unit (row) and U.S. unit (column), how many of the metric unit
// make one of the U.S. unit.  The measurement and the units picked are kept with
// the panel's values.

export114 := {
	// The factor from the U.S. unit picked to the metric one picked, for the
	// measurement picked (curMeasurement, the picker's index; temperature has none).
	GetConversionFactor: func() begin
		local lengthTable2;
		if (curMeasurement = 0) then begin
				lengthTable2 := lengthTable
			end else begin
				if (curMeasurement = 1) then begin
						lengthTable2 := areaTable
					end else begin
						if (curMeasurement = 2) then begin
								lengthTable2 := weightTable
							end else begin
								if (curMeasurement = 3) then begin
										lengthTable2 := USLiquidTable
									end else begin
										if (curMeasurement = 4) then begin
												lengthTable2 := BritishLiquidTable
											end
									end
							end
					end
			end;
		return lengthTable2[Metric:GetPickerItemNumber()][US:GetPickerItemNumber()]
	end,
	// The panel's lines: U.S. first, then metric.
	viewSetupDoneScript: func() begin
		AddArraySlot((FSViews := [Array: ]), US);
		AddArraySlot(FSViews, Metric);
		self:InitFieldBasedOnMeasurement();
		inherited:?viewSetupDoneScript()
	end,
	// Millilitres and litres to a U.S. fluid ounce, pint, quart and gallon.
	USLiquidTable: [|Array|:
		[|Array|:
			real('|Real|, 29.573),
			real('|Real|, 473.176),
			real('|Real|, 946.35),
			real('|Real|, 3785.4)
		],
		[|Array|:
			real('|Real|, 0.029573),
			real('|Real|, 0.473176),
			real('|Real|, 0.94635),
			real('|Real|, 3.7854)
		]
	],
	// Square centimetres, square metres and hectares to a square inch, foot and
	// yard and an acre.
	areaTable: [|Array|:
		[|Array|:
			real('|Real|, 6.4516),
			real('|Real|, 929.03),
			real('|Real|, 8361.27),
			real('|Real|, 40468564.21)
		],
		[|Array|:
			real('|Real|, 0.00064516),
			real('|Real|, 0.092903),
			real('|Real|, 0.836127),
			real('|Real|, 4046.856421)
		],
		[|Array|:
			real('|Real|, 6.4516e-08),
			real('|Real|, 9.2903e-06),
			real('|Real|, 8.36127e-05),
			real('|Real|, 0.4046856421)
		]
	],
	// Keeps the measurement and the units picked with the panel's values.
	viewQuitScript: func() begin
		local formulaValues;
		(formulaValues := self:GetFormulaValues()).(formulaSymbol).measurement := curMeasurement;
		formulaValues.(formulaSymbol).USItem := US:GetPickerItemNumber();
		formulaValues.(formulaSymbol).MetricItem := Metric:GetPickerItemNumber();
		inherited:?viewQuitScript()
	end,
	// The metric unit each measurement starts with (an index into its labels).
	MetricDefaults: [|Array|: 1, 2, 1, 1, 1, 0],
	MetricLabels: [|Array|:
		[|Array|: "Centimeters", "Meters", "Kilometers"],
		[|Array|: "Square Cms", "Square Meters", "Hectares"],
		[|Array|: "Grams", "Kilograms"],
		[|Array|: milliliters, liters],
		[|Array|: milliliters, liters],
		[|Array|: "Celsius"]
	],
	// Neither line is whole numbers only, for any measurement.
	InitFieldBasedOnMeasurement: func() begin
		US:SetIntegerField(nil);
		Metric:SetIntegerField(nil)
	end,
	// Grams and kilograms to an ounce, a pound, a (short) ton and a long ton.
	weightTable: [|Array|:
		[|Array|:
			real('|Real|, 28.3495),
			real('|Real|, 453.59237),
			real('|Real|, 907184.74),
			real('|Real|, 1016046.909)
		],
		[|Array|:
			real('|Real|, 0.0283495),
			real('|Real|, 0.45359237),
			real('|Real|, 907.18474),
			real('|Real|, 1016.046909)
		]
	],
	Metric: nil,
	viewBounds: {left: 0, top: 0, right: 224, bottom: 157},
	_proto: @8303,
	formulaSymbol: 'MetricConversion,
	category: nil,
	curMeasurement: nil,
	// Centimetres, metres and kilometres to an inch, a foot, a yard and a mile.
	lengthTable: [|Array|:
		[|Array|:
			real('|Real|, 2.54),
			real('|Real|, 30.48),
			real('|Real|, 91.44),
			real('|Real|, 160934.4)
		],
		[|Array|:
			real('|Real|, 0.0254),
			real('|Real|, 0.3048),
			real('|Real|, 0.9144),
			real('|Real|, 1609.344)
		],
		[|Array|:
			real('|Real|, 2.54e-05),
			real('|Real|, 0.0003048),
			real('|Real|, 0.0009144),
			real('|Real|, 1.609344)
		]
	],
	// The U.S. unit each measurement starts with.
	USDefaults: [|Array|: 1, 3, 1, 3, 3, 0],
	USLabels: [|Array|:
		[|Array|: "Inches", "Feet", "Yards", "Miles"],
		[|Array|: "Square Inches", "Square Feet", "Square Yards", "Acres"],
		[|Array|: "Ounces", "Pounds", "Tons", "Long Tons"],
		[|Array|: fluidOunces, pints, quarts, gallons],
		[|Array|: fluidOunces, pints, quarts, gallons],
		[|Array|: "Fahrenheit"]
	],
	stepAllocateContext: [|Array|: 'category, measurement, 'US, export114Item, 'Metric, export114Item_2],
	solvedFor: nil,
	// Starts on the measurement and units kept, or length and the default units.
	viewSetupFormScript: func() begin
		local formulaValues;
		if ((formulaValues := self:GetFormulaValues()).(formulaSymbol).measurement = nil) then begin
				curMeasurement := 0
			end else begin
				curMeasurement := formulaValues.(formulaSymbol).measurement
			end;
		if (formulaValues.(formulaSymbol).USItem = nil) then begin
				SetValue(US, 'defaultItem, USDefaults[curMeasurement])
			end else begin
				SetValue(US, 'defaultItem, formulaValues.(formulaSymbol).USItem)
			end;
		if (formulaValues.(formulaSymbol).MetricItem = nil) then begin
				SetValue(Metric, 'defaultItem, MetricDefaults[curMeasurement])
			end else begin
				SetValue(Metric, 'defaultItem, formulaValues.(formulaSymbol).MetricItem)
			end;
		inherited:?viewSetupFormScript()
	end,
	// Millilitres and litres to an imperial fluid ounce, pint, quart and gallon
	// (the gallon written as the integer 4546).
	BritishLiquidTable: [|Array|:
		[|Array|: real('|Real|, 28.413), real('|Real|, 568.26), real('|Real|, 1136.5), 4546],
		[|Array|:
			real('|Real|, 0.028413),
			real('|Real|, 0.56826),
			real('|Real|, 1.1365),
			real('|Real|, 4.546)
		]
	],
	US: nil,
	stepChildren: [stepChildren:
		clear,
		export111Item,
		{
			title: metricConversion,
			viewBounds: {left: 2, top: 2, right: 138, bottom: 26},
			_proto: @protoTitle
		},
		measurement,
		export114Item,
		export114Item_2
	],
	changeInProgress: nil,
	overview: metricConversion
};

milliliters := "Milliliters";

liters := "Liters";

fluidOunces := "Fluid ounces";

pints := "Pints";

quarts := "Quarts";

gallons := "Gallons";

// The measurement picker.
measurement := {
	labelCommands: [|Array|: "Length", "Area", "Weight", "U.S. Liquid", "British Liquid", "Temperature"],
	viewBounds: {left: 5, top: 15, right: 220, bottom: 35},
	viewJustify: vjParentBottomV + vjSiblingBottomV + oneLineOnly,
	text: "Measurement",
	indent: 110,
	viewFont: @fontSystem10Bold,
	// Another measurement picked: clears the lines and gives both pickers that
	// measurement's units at their defaults.
	labelActionScript: func(index) begin
		curMeasurement := index;
		self:ClearAllFields();
		SetValue(US, 'labelItems, USLabels[index]);
		SetValue(US, 'defaultItem, USDefaults[index]);
		US:ResetPicker();
		SetValue(Metric, 'labelItems, MetricLabels[index]);
		SetValue(Metric, 'defaultItem, MetricDefaults[index]);
		Metric:ResetPicker();
		self:InitFieldBasedOnMeasurement()
	end,
	// The picker's text: the measurement picked.
	textSetup: func() begin
		return labelCommands[curMeasurement]
	end,
	_proto: @protoLabelPicker,
	preAllocatedContext: 'category
};

// The U.S. line (line 0).
export114Item := {
	// Computes the U.S. value from the metric one (list[1]): Fahrenheit from
	// Celsius for temperature (measurement 5), else divided by the factor.
	ComputeValue: func(list) begin
		(if (curMeasurement = 5) then return ((list[1] * 1.8) + 32) else return (list[1] / self:GetConversionFactor()))
	end,
	labelItems: nil,
	// The U.S. units of the measurement picked.
	viewSetupFormScript: func() begin
		(self.labelItems := USLabels[curMeasurement])
	end,
	defaultItem: nil,
	lineNumber: 0,
	// Puts the caret at the end of the line's field.
	viewSetupDoneScript: func() begin
		inherited:?viewSetupDoneScript();
		SetKeyView(self.value.value, 9999)
	end,
	_proto: @8300,
	preAllocatedContext: 'US
};

// The metric line (line 1).
export114Item_2 := {
	// Computes the metric value from the U.S. one (list[0]): Celsius from
	// Fahrenheit for temperature, else multiplied by the factor.
	ComputeValue: func(list) begin
		(if (curMeasurement = 5) then return ((list[0] - 32) / 1.8) else return (list[0] * self:GetConversionFactor()))
	end,
	labelItems: nil,
	// The metric units of the measurement picked.
	viewSetupFormScript: func() begin
		(self.labelItems := MetricLabels[curMeasurement])
	end,
	defaultItem: nil,
	lineNumber: 1,
	_proto: @8300,
	preAllocatedContext: 'Metric
};

metricConversion := "Metric Conversion";

// what the functions above hold and share with other objects (same(): romsrc/README.md)

InitFieldBasedOnMeasurement_code := same("export114.InitFieldBasedOnMeasurement.instructions");

ComputeValue_literal1 := same("export114Item.ComputeValue.literals[1]");

viewSetupFormScript_code_2 := same("export114Item.viewSetupFormScript.instructions");

viewSetupDoneScript_code := same("export114Item.viewSetupDoneScript.instructions");
