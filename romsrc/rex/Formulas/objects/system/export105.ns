// A formula line (@8297) with a "/12" button after its field, which divides the
// value by 12 (a yearly amount or rate made monthly) and solves the formula.

export105 := {
	viewBounds: {left: 0, top: 0, right: 0, bottom: 36},
	viewFlags: vVisible,
	viewFormat: 0,
	stepChildren: [stepChildren:
		export105Item,
		{
			// The button divides the line's value by 12.
			buttonClickScript: func() begin
				self:Div12()
			end,
			text: "÷12",
			viewBounds: {left: -26, top: 15, right: -3, bottom: 26},
			viewJustify: vjCenterH + vjCenterV + vjSiblingRightH + oneLineOnly,
			_proto: @protoTextButton
		}
	],
	// The line's value (its inner line's).
	GetNumericValue: func() begin
		return CalcLine:GetNumericValue()
	end,
	// Sets the line's value.
	SetNumericValue: func(a1) begin
		CalcLine:SetNumericValue(a1)
	end,
	viewJustify: vjParentFullH + vjParentBottomV + vjSiblingBottomV,
	// Divides the value by 12 and solves the formula, with an undo action.
	Div12: func() begin
		local numericValue;
		(if ((numericValue := self:GetNumericValue()) <> nil) then begin
				AddUndoAction('UndoDiv12, [Array: numericValue]);
				self:SetNumericValue((numericValue / 12));
				self:SolveFormula(lineNumber)
			end)
	end,
	// Undoes Div12: puts back the old value a1 (and is itself undoable).
	UndoDiv12: func(a1) begin
		AddUndoAction('UndoDiv12, [Array: self:GetNumericValue()]);
		self:SetNumericValue(a1);
		self:SolveFormula(lineNumber)
	end,
	viewClass: clView,
	CalcLine: nil,
	stepAllocateContext: [|Array|: 'CalcLine, export105Item]
};

// The inner line: four decimal places, room on the right for the button.
export105Item := {rightmargin: 35, decimalPlaces: 4, _proto: @8296, preAllocatedContext: 'CalcLine};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

buttonClickScript_code := same("export105.stepChildren[1].buttonClickScript.instructions");

UndoDiv12_code := same("export105.UndoDiv12.instructions");
