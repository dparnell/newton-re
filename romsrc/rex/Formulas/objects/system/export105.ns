// export105, and what only it reaches

export105 := {
	viewBounds: {left: 0, top: 0, right: 0, bottom: 36},
	viewFlags: vVisible,
	viewFormat: 0,
	stepChildren: [stepChildren:
		export105Item,
		{
			buttonClickScript: func() begin
				self:Div12()
			end,
			text: "÷12",
			viewBounds: {left: -26, top: 15, right: -3, bottom: 26},
			viewJustify: 8389638,
			_proto: @protoTextButton
		}
	],
	GetNumericValue: func() begin
		return CalcLine:GetNumericValue()
	end,
