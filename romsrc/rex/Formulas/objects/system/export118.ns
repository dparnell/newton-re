// The Date Calculator panel (@8310): a start date, a number of days and an end
// date - any two give the third.  Dates are minutes since 1904 (1440 to a day).

export118 := {
	stepChildren: [stepChildren:
		clear,
		export111Item,
		{
			title: dateCalculator,
			viewBounds: {left: 14, top: 0, right: 102, bottom: 16},
			_proto: @protoTitle
		},
		export118Item,
		export118Item_2,
		export118Item_3
	],
	viewBounds: {left: 0, top: 0, right: 224, bottom: 158},
	// The panel's lines, in the order the solver's list has them.
	viewSetupDoneScript: func() begin
		AddArraySlot((FSViews := [Array: ]), StartDateField);
		AddArraySlot(FSViews, NumberOfDaysField);
		AddArraySlot(FSViews, EndDateField);
		inherited:?viewSetupDoneScript()
	end,
	formulaSymbol: 'DateCalculator,
	overview: dateCalculator,
	// True for a date the panel will not show: before 1904 or after the last
	// minute of 2099 (103088159 minutes since 1904).
	DateOutOfRange: func(a1) begin
		return ((a1 < 0) or (a1 > 103088159))
	end,
	_proto: @8303,
	StartDateField: nil,
	stepAllocateContext: [|Array|:
		'StartDateField,
		export118Item,
		'NumberOfDaysField,
		export118Item_2,
		'EndDateField,
		export118Item_3
	],
	NumberOfDaysField: nil,
	EndDateField: nil
};

dateCalculator := "Date Calculator";

// The start date (line 0).
export118Item := {
	calcLineLabel: "ﰁStart Date",
	// The start: the end date less the days; an alert when out of range.
	ComputeValue: func(list) begin
		local l1, listItem, listItem2;
		l1 := nil;
		listItem := list[1];
		if self:DateOutOfRange((l1 := ((listItem2 := list[2]) - (listItem * 1440)))) then begin
				l1 := nil;
				self:Notify(kNotifyAlert, "Date Calculator", "The calculated date is out of range.")
			end;
		return l1
	end,
	lineNumber: 0,
	indent: 93,
	_proto: @8302,
	preAllocatedContext: 'StartDateField
};

// The number of days (line 1), whole numbers.
export118Item_2 := {
	calcLineLabel: "# of Days",
	// The days from the start date to the end date.
	ComputeValue: func(list) begin
		local listItem, l2, listItem2;
		listItem := list[0];
		l2 := nil;
		return (((listItem2 := list[2]) - listItem) div 1440)
	end,
	integerField: true,
	indent: 93,
	lineNumber: 1,
	// Puts the caret at the end of the line's field.
	viewSetupDoneScript: func() begin
		inherited:?viewSetupDoneScript();
		SetKeyView(self.value.value, 9999)
	end,
	_proto: @8296,
	preAllocatedContext: 'NumberOfDaysField
};

// The end date (line 2).
export118Item_3 := {
	calcLineLabel: "ﰁEnd Date",
	// The end: the start date plus the days; an alert when out of range.
	ComputeValue: func(list) begin
		local listItem, listItem2, l3;
		listItem := list[0];
		listItem2 := list[1];
		if self:DateOutOfRange((l3 := (listItem + (listItem2 * 1440)))) then begin
				l3 := nil;
				self:Notify(kNotifyAlert, "Date Calculator", "The calculated date is out of range.")
			end;
		return l3
	end,
	lineNumber: 2,
	indent: 93,
	_proto: @8302,
	preAllocatedContext: 'EndDateField
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

ComputeValue_literal2 := same("export118Item.ComputeValue.literals[2]");
