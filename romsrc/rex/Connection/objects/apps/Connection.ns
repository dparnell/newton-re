				l1 := true;
				overrideApp:ButtonToggle()
			end else begin
				if self.theEndpoint then begin
						if theEndpoint.disconnecting then begin
								l1 := true;
								AddDelayedSend(GetRoot().Connection, 'ButtonToggle, nil, 1000)
							end else begin
								l1 := true;
								if keyPassthroughOn then begin
