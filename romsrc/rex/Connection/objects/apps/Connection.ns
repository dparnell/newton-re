// The Dock application (Connection, @8275, the package's theForm): the floater
// with which the Newton connects to Newton Connection Utilities or Newton
// Backup Utility on a desktop computer.  It owns the docking endpoint
// (theEndpoint, a protoDesktopEndpoint: the ROM's docker, with WriteCommand
// and ReadCommandHeader for the four-letter dock commands), keeps the
// connection preferences (a "Connection" entry of the app prefs), lists the
// Newton's applications by soup for synchronize and backup, and opens the
// slips the session needs: which connection (@8274), the progress slip
// (@8269), file browser, import, get info, passwords.  Other parts of the
// system reach it as GetRoot().Connection and through the globals its
// install script defines.

Connection := {
	initialized: nil,
	// The saved password (a DES key), or "" when none is saved.
	PasswordRead: func() begin
		local password;
		if ((password := self:ConnectionPrefsRead('password)) = nil) then begin
				password := ""
			end;
		return password
	end,
	// How a message names the desktop: by the desktop's type (0 a Mac OS
	// computer, else a PC; 2 or unknown "desktop computer").
	GetDesktopString: func(a1) begin
		local desktopType;
		if (((desktopType := a1:DesktopType()) = nil) or (desktopType = 2)) then begin
				which := "desktop computer"
			end else begin
				if (desktopType = 0) then begin
						which := "Mac OS computer"
					end else begin
						which := "PC"
					end
			end;
		return which
	end,
	GetWorksite: @8279,
	special: nil,
	// Adds a slip to the open windows (CloseOpenWindows closes them), in the
	// first free place.
	AddOpenWindow: func(callOptionsSlip) begin
		if (openWindows = nil) then begin
				return nil
			end;
		local l1;
		(for i := 0 to (Length(openWindows) - 1) do begin
				if (openWindows[i] = nil) then begin
						openWindows[i] := callOptionsSlip;
						l1 := true;
						break
					end
			end);
		(if (not l1) then AddArraySlot(openWindows, callOptionsSlip))
	end,
	// Docks at once (RegAutoDock's 'connect, or the Dock button for the auto-dock
	// settings): with the communications idle, sets up the endpoint and connects
	// with the auto-dock parameters (the progress slip's OpenForSync, auto-dock
	// true).
	autodock: compile(
		constants: {
			kROM_8269: @8269
		},
		func() begin
			(if (not self:TransportsIdle()) then self:Notify(kNotifyAlert, "Dock", "You can\u2019\ut start a connection when other communications are in progress.") else begin
					if (not theEndpoint) then begin
							self:SetupEndpoint()
						end;
					if (self:ConnectionPrefsRead('timeoutConnection) = nil) then begin
							theEndpoint.maxIdleTime := nil
						end;
					(if (not startingConnection) then self:BuildAutoDockParams(func(a1) begin
							(if (not startingConnection) then (if a1 then begin
										startingConnection := true;
										kROM_8269:OpenForSync(a1.password, a1.connectOptions, theEndpoint, true)
									end else begin
										self:Notify(kNotifyAlert, "Dock", "The necessary connection options weren\u2019\ut filled in.");
										theEndpoint:ConnectionDone(0)
									end))
						end))
				end)
		end),
	keyPassthroughOn: nil,
	applications: nil,
	connectionPrefs: nil,
	// Ends an automatic dock: sends 'disc' and, a second later, finishes the
	// connection (at once with the error when the send failed).
	WrapUpAutoDock: func(endpoint) begin
		local error;
		error := 0;
		try begin
				endpoint.disconnecting := true;
				endpoint:WriteCommand("disc", nil, nil)
			end onexception |evt.ex| do begin
				error := CurrentException().error
			end;
		if (error = 0) then begin
				AddDelayedCall(func() begin
					endpoint:ConnectionDone(0)
				end, nil, 1000)
			end else begin
				endpoint:ConnectionDone(error)
			end;
		(closeBoxTapped := nil)
	end,
	// Puts "Other information" last in the applications list, and "Packages"
	// first when the store (or any store) has packages to back up.
	AddDefaultApps: func(applications, currentStore) begin
		local found, application;
		if (found := BFind(applications, "Other information", '|str<|, '[pathExpr: name])) then begin
				application := applications[found];
				ArrayRemoveCount(applications, found, 1);
				AddArraySlot(applications, application)
			end;
		(if self:AnyPackages(currentStore) then ArrayInsert(applications, '{name: "Packages", packages: true, soups: [Array: "Packages"], class: packageFrame}, 0))
	end,
	// An exception during the session: a cancel (kCommErrRequestCanceled) goes
	// back to the which-connection slip, anything else ends the connection.
	HandleException: func(error, endpoint) begin
		(if (error = kCommErrRequestCanceled) then self:OpenWhichConnection(endpoint) else endpoint:ConnectionDone(error))
	end,
	// Puts back the views hidden while a slip had the screen (savedChildren), and
	// the which-connection slip that was open.
	ReopenBlessed: func() begin
		local l1;
		l1 := (if self.whichConnection then whichConnection.whichConnectionOpen);
		self:LockScreen(true);
		try begin
				if l1 then begin
						whichConnection.closing := true;
						whichConnection:Close()
					end;
				self:|ResurrectRootChildren!|(savedChildren);
				self.savedChildren := nil;
				if l1 then begin
						self:OpenWhichConnection(theEndpoint)
					end
			end onexception |evt.ex| do begin
				self:LockScreen(nil);
				Rethrow()
			end;
		self:LockScreen(nil)
	end,
	// The application name a soup belongs to (for a desktop's request), from the
	// applications list; "Packages", "Card backup" or "".
	SoupNameToAppName: compile(
		constants: {
			kFunction_75ad31: func() begin
				nil
			end,
			kLiteral_748ff5: "Packages"
		},
		func(name) begin
			self:BuildApplicationList(kFunction_75ad31);
			(foreach item in applications do begin
					if (if item.soups then BFind(item.soups, name, '|str<|, nil)) then begin
							return item.name
						end
				end);
			if StrEqual(name, kLiteral_748ff5) then begin
					return kLiteral_748ff5
				end;
			if (BeginsWith(name, "Backup_") or StrEqual(name, "BackupInfo")) then begin
					return "Card backup"
				end;
			return ""
		end),
	// Starts an automatic backup: the session state sync, and the progress slip
	// backing up 'all.
	StartAutoBackup: compile(
		constants: {
			kROM_8269: @8269
		},
		func(endpoint) begin
			endpoint:SetState(kDockStateSync);
			kROM_8269:OpenOnEndpoint('all, endpoint, true)
		end),
	// The endpoint options for an auto-dock connection type: the built-in
	// transports' option templates (@8256, @8255, @8257, @8290, @8293, @8292,
	// @8291 for serial, modem, AppleTalk, IrDA and the three serial speeds), with
	// AppleTalk's address checked; or another transport's from
	// GetDesktopConnTransports.  Returns nil when an address is missing.
	GetAutoDockOptions: func(prefsFrame, myCallback) begin
		local type, pos, copy, l4, verifyNetworkAddress, desktopConnTransports;
		type := prefsFrame.type;
		if (pos := LSearch('[Array: serial, modem, AppleTalk, IrDA, |2400Serial|, |4800Serial|, |9600Serial|], type, 0, '|=|, nil)) then begin
				copy := '[Array: @8256, @8255, @8257, @8290, @8293, @8292, @8291][pos];
				if (type = 'AppleTalk) then begin
						l4 := 'AppleTalkAddress;
						verifyNetworkAddress := self:VerifyNetworkAddress(prefsFrame.networkCurrentChoice, myCallback)
					end;
				if l4 then begin
						if verifyNetworkAddress then begin
								(copy := Clone(copy)).(l4) := verifyNetworkAddress
							end else begin
								copy := nil
							end
					end
			end else begin
				if (if (desktopConnTransports := GetDesktopConnTransports()) then desktopConnTransports.transports) then begin
						copy := desktopConnTransports.transports.(type)
					end
			end;
		return copy
	end,
	openWindows: nil,
	// GetApplicationNames(store, soupsToo): the applications on one store or all.
	GetApplicationNames: func(a1, a2) begin
		(if a1 then self:GetAppsForStore([Array: a1], a2) else self:GetAppsForStore(GetStores(), a2))
	end,
	// A store's frame for the desktop (ConnBuildStoreFrame), with its soups' names
	// and signatures when a2.
	BuildStoreFrame: func(a1, a2, a3) begin
		connBuildStoreFrame2 := ConnBuildStoreFrame(a1, a3);
		if a2 then begin
				list := [Array: ];
				list2 := [Array: ];
				local connBuildStoreFrame2;
				local list;
				local list2;
				(foreach item in a1:GetSoupNames() do begin
						AddArraySlot(list, item);
						AddArraySlot(list2, a1:GetSoup(item):GetSignature())
					end);
