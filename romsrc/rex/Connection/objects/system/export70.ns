	// The drive part of a path name: up to its first ':' or space, with a ':'
	// ("C:"); "" for none.
	GetDriveFromName: func(name) begin
		if (if name then (Length(name) > 0)) then begin
				if ((i2 := (StrLen(name) - 1)) > 1) then begin
						local text;
						local i2;
						(for i := 1 to i2 do begin
								if ((name[i] = $:) or (name[i] = $ )) then begin
										i2 := i;
										break
									end
							end)
					end;
				text := Stringer([Array: Substr(name, 0, i2), ":"])
			end;
		if (not text) then begin
				text := ""
			end;
		return text
	end,
