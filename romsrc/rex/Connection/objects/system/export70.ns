	// "C:\folder\folder".  (For a path of the drive alone the count cannot be 0
	// here, so no backslash is added.)
	UpdateDirectoryText: func() begin
		if (if currentPath then (Length(currentPath) > 0)) then begin
				driveFromName := self:GetDriveFromName(currentPath[0].name);
				if ((count := Length(currentPath)) = 0) then begin
