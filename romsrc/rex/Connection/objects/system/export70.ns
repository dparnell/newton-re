										text := "sdrv"
									end else begin
										(copy := DeepClone((driveFromName := Clone(currentPath))[0])).name := self:GetDriveFromName(copy.name);
										driveFromName[0] := copy;
										text := "spth"
									end
							end;
						checkCommandsInIdle := nil;
						callReadCommand := protoContext:GetNewFiles(endpoint, driveFromName, text, func(a1) begin
