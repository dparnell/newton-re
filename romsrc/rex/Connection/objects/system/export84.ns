// The user name and password slip (@8276, ConnOpenUserPsswdSlip): a name line
// (remembered names, and "Guest" when allowed), a password line (hidden or
// visible as asked), a cancel-like button and a keyboard - each only when the
// configOptions frame asks for it.  The answer {userName, password,
// userCancel} goes to the callback; the slip closes itself when the connection
// drops.

export84 := {
	viewBounds: {left: 0, top: 30, right: 224, bottom: 280},
	stepChildren: [stepChildren:
		{
			title: nil,
			// The title configOptions gives, or "Dock".
			viewSetupFormScript: func() begin
				self.title := configOptions.title;
				if (not title) then begin
						self.title := "Dock"
					end;
				inherited:?viewSetupFormScript()
			end,
			_proto: @protoTitle
		},
		name,
		password,
		export84Item,
		export84Item_2,
		export84Item_3
	],
	configOptions: nil,
	// Hides what configOptions does not ask for (-2 clears vVisible) and shortens
	// the slip by their heights; idles the connection while it is up.
	viewSetupFormScript: func() begin
		local configOptions2, l2, l3;
		configOptions2 := configOptions;
		l2 := 0;
		if (not configOptions2.|name?|) then begin
				nameInput.viewFlags := BAnd(nameInput.viewFlags, -2);
				l2 := (l2 + 55)
			end;
		l3 := true;
		if ((if (not configOptions2.|password?|.guest) then (not configOptions2.|password?|.users)) or (if (not configOptions2.|guest?|) then (not configOptions2.|password?|.users))) then begin
				passwordInput.viewFlags := BAnd(passwordInput.viewFlags, -2);
				l3 := nil;
				l2 := (l2 + 55)
			end;
		if (not configOptions2.buttonTitle) then begin
				cancelButton.viewFlags := BAnd(cancelButton.viewFlags, -2)
			end;
		if ((not configOptions2.Keyboard) or (if (not configOptions2.|name?|) then (not l3))) then begin
				Keyboard.viewFlags := BAnd(Keyboard.viewFlags, -2);
				l2 := (l2 + 91)
			end;
		if (l2 > 0) then begin
				self.viewBounds := Clone(viewBounds);
				viewBounds.bottom := (viewBounds.bottom - l2)
			end;
		(if endpoint then endpoint:StartIdle(self, 2000))
	end,
	endpoint: nil,
	callback: nil,
	// Opens the slip on endpoint options, with callback a2 and configOptions a3,
	// modally when a3.modal.
	OpenOn: func(options, a2, a3) begin
		local context;
		(context := BuildContext(self)).endpoint := options;
		context.callback := a2;
		context.configOptions := a3;
		(if a3.modal then context:ModalDialog() else context:FilterDialog())
	end,
	// Keeps the connection alive; when it has dropped, closes the slip and gives
	// the callback nil.
	viewIdleScript: func() begin
		(if (if endpoint then endpoint.connected) then return endpoint:IdleConnection(true) else begin
				self.needToAbort := true;
				AddDeferredSend(self, 'Close, nil);
				return 0
			end)
	end,
	// Gives the callback the answer: the name ('guest for Guest) and the password
	// when one is asked for that kind of user.
	viewQuitScript: func() begin
		local frame2;
		if needToAbort then begin
				if configOptions.modal then begin
						call callback with (nil)
					end else begin
						AddDeferredCall(callback, [Array: nil])
					end;
				return nil
			end;
		if endpoint then begin
				endpoint:StopIdle(self)
			end;
		frame2 := {userName: nil, password: nil, userCancel: nil};
		if configOptions.|name?| then begin
				frame2.userName := nameInput.entryLine.text;
				if (if configOptions.|guest?| then (nameInput.curLabelCommand = (Length(nameInput.labelCommands) - 1))) then begin
						frame2.userName := 'guest
					end
			end;
		if (configOptions.|password?|.guest or configOptions.|password?|.users) then begin
				if ((if (frame2.userName = 'guest) then configOptions.|password?|.guest) or (if (not (frame2.userName = 'guest)) then configOptions.|password?|.users)) then begin
						if passwordInput.passwordVisible then begin
								frame2.password := passwordInput.entryLine.text
							end else begin
								frame2.password := passwordInput.realText
							end
					end
			end;
		frame2.userCancel := userCancel;
		if callback then begin
				if configOptions.modal then begin
						call callback with (frame2)
					end else begin
						AddDeferredCall(callback, [Array: frame2])
					end
			end;
		inherited:?viewQuitScript()
	end,
	userCancel: nil,
	// Puts the caret in the name line (or the password line).
	viewSetupDoneScript: func() begin
		if Visible(nameInput) then begin
				SetKeyView(nameInput.entryLine, 9999)
			end else begin
				if Visible(passwordInput) then begin
						SetKeyView(passwordInput.entryLine, 0)
					end
			end;
		inherited:?viewSetupDoneScript();
		nameInput:ShowHidePasswordInput(nameInput.guestMode)
	end,
	needToAbort: nil,
	viewFlags: vFloating + vClickable,
	_proto: @protoFloater,
	nameInput: nil,
	stepAllocateContext: [|Array|:
		'nameInput,
		name,
		'passwordInput,
		password,
		'_defaultButton,
		export84Item,
		'cancelButton,
		export84Item_2,
		'Keyboard,
		export84Item_3
	],
	passwordInput: nil,
	_defaultButton: nil,
	cancelButton: nil,
	Keyboard: nil
};

// The name line: a label picker of remembered names, and "Guest".
name := {
	viewBounds: {left: 3, top: 10, right: -3, bottom: 55},
	viewJustify: vjParentFullH + vjSiblingBottomV + oneLineOnly,
	label: "Name",
	memory: nil,
	// A name picked: the password line follows (shown or not for a guest).
	labelActionScript: func(index) begin
		local l1;
		self:ShowHidePasswordInput((l1 := (if configOptions.|guest?| then (index = (Length(labelCommands) - 1)))));
		guestMode := l1;
		curLabelCommand := index;
		nil
	end,
	guestMode: nil,
	viewLineSpacing: 32,
	// Remembers the name, but not "Guest".
	viewQuitScript: func() begin
		(if (not guestMode) then inherited:?viewQuitScript())
	end,
	// The name to start with: the one picked.
	textSetup: func() begin
		(if (if IsArray(labelCommands) then (Length(labelCommands) > 0)) then (if IsFrame(labelCommands[curLabelCommand]) then Clone(labelCommands[curLabelCommand].item) else Clone(labelCommands[curLabelCommand])))
	end,
	// Lists the remembered names (configOptions.memory: a function returning them,
	// or a memory symbol), the marked one picked, with "Guest" after a separator.
	viewSetupChildrenScript: compile(
		constants: {
			kLiteral_76021d: "Guest"
		},
		func() begin
			if IsFunction(configOptions.memory) then begin
					self.labelCommands := (memoryItems := call configOptions.memory with ());
					local memoryItems;
					local key2;
					(foreach key, value in labelCommands do begin
							if (if IsFrame(value) then value.mark) then begin
									break (key2 := key)
								end
						end)
				end else begin
					self.memory := configOptions.memory;
					memoryItems := GetMemoryItems(memory)
				end;
			if (if IsArray(memoryItems) then (Length(memoryItems) > 0)) then begin
					if key2 then begin
							self.curLabelCommand := key2
						end else begin
							self.curLabelCommand := 0
						end;
					inherited:?viewSetupChildrenScript();
					if configOptions.|guest?| then begin
							AddArraySlot((labelCommands := Clone(labelCommands)), 'pickseparator);
							AddArraySlot(labelCommands, kLiteral_76021d)
						end
				end else begin
					if configOptions.|guest?| then begin
							self.labelCommands := [Array: kLiteral_76021d]
						end;
					if (if IsArray(labelCommands) then (Length(labelCommands) > 0)) then begin
							self.curLabelCommand := 0
						end;
					inherited:?viewSetupChildrenScript()
				end;
			if (if configOptions.|guest?| then (curLabelCommand = (Length(labelCommands) - 1))) then begin
					guestMode := true
				end;
			(labelLine.viewClickScript := labelLineFix)
		end),
	// Writing "Guest" in the line works as picking it.
	textChanged: func() begin
		local l1;
		if (if configOptions.|guest?| then StrEqual(entryLine.text, labelCommands[(Length(labelCommands) - 1)])) then begin
				l1 := true;
				curLabelCommand := (Length(labelCommands) - 1)
			end else begin
				l1 := nil;
				curLabelCommand := nil
			end;
		self:ShowHidePasswordInput(l1);
		(guestMode := l1)
	end,
	// A tap on the label: pops up the names with the current one checked.
	labelLineFix: func(a1) begin
		local labelCommands2, labelCommand, item;
		(if (if (not self:labelClick(a1)) then labelCommands) then begin
				if self:TrackHilite(a1) then begin
						if curLabelCommand then begin
								if IsFrame((labelCommand := labelCommands[curLabelCommand])) then begin
										item := labelCommand.item
									end else begin
										item := labelCommand
									end;
								if (not StrEqual(entryLine.text, item)) then begin
										curLabelCommand := nil
									end
							end;
						if (curLabelCommand = nil) then begin
								labelCommands2 := labelCommands
							end else begin
								if (not IsFrame((labelCommands2 := Clone(labelCommands))[curLabelCommand])) then begin
										labelCommands2[curLabelCommand] := {item: labelCommands2[curLabelCommand], mark: $\uFC0B}
									end else begin
										(labelCommands2[curLabelCommand] := Clone(labelCommands2[curLabelCommand])).mark := $\uFC0B
									end
							end;
						self:PopupMenu(labelCommands2, {indent: indent});
						entryLine:dirty()
					end;
				true
			end)
	end,
	// Shows or hides the password line for a guest or a user, empty, its text
	// visible when configOptions says 'Visible.
	ShowHidePasswordInput: func(guestMode) begin
		local l1, l2;
		l1 := true;
		if ((if guestMode then (not configOptions.|password?|.guest)) or (if (not guestMode) then (not configOptions.|password?|.users))) then begin
				l1 := nil
			end;
		(if (if passwordInput then passwordInput.viewCObject) then begin
				if l1 then begin
						passwordInput:Show()
					end else begin
						passwordInput:Hide()
					end;
				SetValue(passwordInput.entryLine, 'text, "");
				SetValue(passwordInput, 'realText, "");
				(if l1 then begin
						if ((if guestMode then (configOptions.|password?|.guest = 'Visible)) or (if (not guestMode) then (configOptions.|password?|.users = 'Visible))) then begin
								l2 := true
							end;
						(passwordInput.passwordVisible := l2)
					end)
			end)
	end,
	_proto: @protoLabelInputLine,
	preAllocatedContext: 'nameInput
};

// The password line (a blindEntryLine), or plain text when visible.
password := {
	viewBounds: {left: 3, top: 10, right: -3, bottom: 55},
	viewJustify: vjParentFullH + vjSiblingBottomV + oneLineOnly,
	label: "Password",
	viewLineSpacing: 32,
	indent: nil,
	passwordVisible: nil,
	textChanged: func() begin
		(if (not passwordVisible) then inherited:textChanged())
	end,
	// A visible password is set as text, with an undo.
	UpdateText: func(a1) begin
		(if (not passwordVisible) then inherited:UpdateText(a1) else begin
				AddUndoAction('UpdateText, [Array: Clone(entryLine.text)]);
				SetValue(entryLine, 'text, a1);
				entryLine:SetHilite(9999, 9999, true)
			end)
	end,
	_proto: @blindEntryLine,
	preAllocatedContext: 'passwordInput
};

export84Item := {_proto: @protoCancelButton, preAllocatedContext: '_defaultButton};

// The button configOptions names (buttonTitle): closes the slip, a cancel.
export84Item_2 := {
	buttonClickScript: func() begin
		base.userCancel := true;
		AddDeferredAction(func() begin
			base:Close()
		end, nil)
	end,
	text: nil,
	viewBounds: {left: -100, top: 0, right: -6, bottom: 0},
	viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH + vjSiblingFullV + oneLineOnly,
	// Sized to its title.
	viewSetupFormScript: func() begin
		self.text := configOptions.buttonTitle;
		(self.viewBounds := {left: (((-StrWidth(text)) - 6) - 7), top: 0, right: -7, bottom: 0})
	end,
	_proto: @protoTextButton,
	preAllocatedContext: 'cancelButton
};

// The keyboard.
export84Item_3 := {
	viewBounds: {top: -91, left: 0, right: 226, bottom: -10},
	viewJustify: vjParentCenterH + vjSiblingTopV,
	_proto: @alphaKeys,
	preAllocatedContext: 'Keyboard
};
