			buttonClickScript: func() begin
				if (Length(appsList.selectedItems) = Length(appsList.listItems)) then begin
						appsList.selectedItems := [Array: ]
					end else begin
						self:SelectAll(appsList)
					end;
				appsList:DrawHilite()
			end,
			text: all,
			viewBounds: {left: 0, top: 7, right: 36, bottom: 20},
			viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH + vjSiblingBottomV + oneLineOnly,
