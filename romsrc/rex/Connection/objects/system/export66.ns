		export66Item_3,
		export66Item_4,
		export66Item_5,
		{
			// Cancel: tells the desktop ('opca') and goes back to the which-connection slip.
			buttonClickScript: func() begin
				protoContext:SendCancelToDesktop(endpoint);
				protoContext:OpenWhichConnection(endpoint);
				inherited:?buttonClickScript()
			end,
			_proto: @protoCancelButton
		},
		{
			// Restore: after a confirmation, stops idling, builds the applications list
			// and restores (deferred DoRestore).
			buttonClickScript: func() begin
				(if (not restoring) then begin
						restoring := true;
						(if (ModalConfirm("Restore replaces the information on your Newton device with the information in the backup and then restarts. Are you sure you want to do this?", '[Array: {value: Restore, text: "Restore"}, {value: cancel, text: "Cancel"}]) = 'Restore) then begin
								endpoint:StopIdle(base);
								protoContext:BuildApplicationList(func() begin
									endpoint:IdleConnection(true)
								end);
								AddDeferredSend(base, 'DoRestore, [Array: ])
							end else (restoring := nil))
					end)
			end,
			text: restore,
			viewBounds: {left: -54, top: 0, right: -7, bottom: 13},
			viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH + vjSiblingTopV + oneLineOnly,
			_proto: @protoTextButton
		}
	],
	// A backup with no packages: a shorter slip without the packages list.
	viewSetupFormScript: func() begin
		local copy;
		self.protoContext := GetRoot().Connection;
		protoContext:AddOpenWindow(self);
		if ((not restoreOptions.packages) or (Length(restoreOptions.packages) = 0)) then begin
				(copy := Clone(self.viewBounds)).top := (copy.top + 40);
				copy.bottom := (copy.bottom - 60);
				viewBounds := copy
			end;
		endpoint:StartIdle(self, 2000)
	end,
	// Stops idling and leaves the open windows.
	viewQuitScript: func() begin
		endpoint:StopIdle(self);
		protoContext:RemoveOpenWindow(self)
	end,
	// Fills list a1 with a2, all selected.
	InitializeTextList: func(a1, a2) begin
		if (not a2) then begin
				a2 := [Array: ]
			end;
		a1.listItems := a2;
		a1.selectedItems := self:SelectAll(a1);
		a1:SetupList()
	end,
	// Selects every item of list a1.
	SelectAll: func(a1) begin
		list := Array((count := Length(a1.listItems)), nil);
		local count;
		local list;
		(for i := 0 to (count - 1) do begin
				list[i] := i
			end);
		(a1.selectedItems := list)
	end,
	// The applications and packages selected, into the options frame a1.
	CollectOptions: func(a1) begin
		local l1;
		l1 := (foreach item in appsList.selectedItems collect appsList.listItems[item]);
		l6 := (if packageList.selectedItems then (foreach item in packageList.selectedItems collect begin
				local l6;
				packageList.listItems[item]
			end) else '[Array: ]);
		a1.applications := l1;
		a1.packages := l6;
		(a1.merge := nil)
	end,
	// Sends the options picked ('ropt') and opens the progress slip; an alert when
	// nothing is picked.  (The 'rall' branch, restoring everything, is never taken:
	// l2 is always nil.)
	DoRestore: compile(
		constants: {
			kROM_8269: @8269
		},
		func() begin
			local frame2, l2, error, l4;
			if endpoint.closingDown then begin
					return nil
				end;
			self:CollectOptions((frame2 := {}));
			l2 := nil;
			if (if IsArray(storePicker.labelCommands) then (Length(storePicker.labelCommands) > 0)) then begin
					frame2.storeToUse := storePicker.labelCommands[storePicker.indexValue].store
				end;
			(if (if (Length(frame2.applications) = 0) then (Length(frame2.packages) = 0)) then begin
					AddDeferredSend(self, 'Notify, [Array: 5, "Dock", "You didn\u2019\ut select anything to restore."]);
					(restoring := nil)
				end else begin
					error := 0;
					if l2 then begin
							l4 := 0;
							try begin
									endpoint:WriteCommand("rall", l4, true)
								end onexception |evt.ex| do begin
									endpoint:ConnectionDone((error := CurrentException().error))
								end
						end else begin
							try begin
									endpoint:WriteCommand("ropt", frame2, true)
								end onexception |evt.ex| do begin
									endpoint:ConnectionDone((error := CurrentException().error))
								end
						end;
					base:Close();
					(if (error = 0) then kROM_8269:OpenOnEndpoint(nil, endpoint, nil))
				end)
		end),
	// Keeps the connection alive while the slip is up.
	viewIdleScript: func() begin
		return endpoint:IdleConnection(true)
	end,
	// Shows or hides the packages' views and the store picker.
	viewSetupChildrenScript: func() begin
		packageTitle:SetupViewflags();
		packageList:SetupViewflags();
		checkAllPackages:SetupViewflags();
		storePicker:SetupViewflags()
	end,
	restoring: nil,
	_proto: @protoFloater,
	appsList: nil,
	stepAllocateContext: [|Array|:
		'appsList,
		export66Item,
		'packageTitle,
		export66Item_2,
		'packageList,
		export66Item_3,
		'checkAllPackages,
		export66Item_4,
		'storePicker,
		export66Item_5
	],
	packageTitle: nil,
	packageList: nil,
	checkAllPackages: nil,
	storePicker: nil
};

