// The store to restore to: the internal store for an internal backup
// (storeType 0), else a card's, picked from the writable cards.
export66Item_5 := {
	viewBounds: {left: 0, top: 5, right: 184, bottom: 21},
	viewFlags: vVisible,
	viewFormat: 0,
	viewJustify: vjParentCenterH + vjSiblingBottomV + oneLineOnly,
	stepChildren: [stepChildren: restoreTo, export66Item_5Item],
	// Hidden for a card backup with no stores given, or with no card in (-2
	// clears vVisible).
	SetupViewflags: func() begin
		(if (if (not (restoreOptions.storeType = 0)) then ((not restoreOptions.stores) or (Length(GetStores()) = 1))) then (self.viewFlags := BAnd(viewFlags, -2)))
	end,
	// Picks the card that matches the backup's store: by signature, else by name,
	// else the first card.
	FindCandidateStore: func(store) begin
		name := store.name;
		signature := store.signature;
		list := [Array: ];
		local name;
		local signature;
		local list;
		(foreach item in popup do begin
				if (item.store:GetSignature() = signature) then begin
						break (list := [Array: item.store])
					end else begin
						if StrEqual(item.store:GetName(), name) then begin
								SetAdd(list, item.store, true)
							end
					end
			end);
		if (Length(list) = 0) then begin
				selectedStore := popup[0].store
			end else begin
				selectedStore := list[0]
			end;
		(restoreOptions.stores := [Array: {name: selectedStore:GetName(), signature: selectedStore:GetSignature()}])
	end,
	// Offers the internal store, or the cards (by name, a read-only card by its
	// kind), the matching one checked (U+FC0B).
	viewSetupFormScript: func() begin
		l2 := (stores := GetStores())[0];
		(if (restoreOptions.storeType = 0) then begin
				self.popup := [Array: {item: l2:GetName(), store: l2, mark: $\uFC0B}];
				(selectedStore := l2)
			end else begin
				self.popup := [Array: ];
				local stores;
				local l2;
				(for i := 1 to (Length(stores) - 1) do begin
						local store2, name, store;
						if (not (store2 := stores[i]):IsReadOnly()) then begin
								name := store2:GetName()
							end;
						if (not StrFilled(name)) then begin
								name := store2:GetKind()
							end;
						AddArraySlot(popup, {item: name, store: store2})
					end);
				self:FindCandidateStore(restoreOptions.stores[0]);
				((store := LFetch(popup, selectedStore, 0, '|=|, 'store)).mark := $\uFC0B)
			end)
	end,
	popup: nil,
	selectedStore: nil,
	viewClass: clView,
	picker: nil,
	stepAllocateContext: [|Array|: 'picker, restoreTo, 'storeName, export66Item_5Item],
	storeName: nil,
	preAllocatedContext: 'storePicker
};

// The "Restore to" popup.
restoreTo := {
	text: "ﰁ Restore to",
	viewBounds: {left: 0, top: 0, right: 50, bottom: 0},
	viewJustify: vjCenterH + vjCenterV + vjParentFullV + oneLineOnly,
