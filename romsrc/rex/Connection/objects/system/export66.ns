	end,
	// A store picked: becomes the one to restore to, checked and shown.
	pickActionScript: func(index) begin
		local store;
		RemoveSlot((store := LFetch(popup, selectedStore, 0, '|=|, 'store)), 'mark);
		selectedStore := popup[index].store;
		restoreOptions.stores := [Array: {name: selectedStore:GetName(), signature: selectedStore:GetSignature()}];
		popup[index].mark := $\uFC0B;
		SetValue(storeName, 'text, popup[index].item);
		self:hilite(nil)
	end,
	viewFormat: vfFillWhite + vfRound(4),
	viewFlags: vVisible + vReadOnly + vClickable,
	// Pops the stores up when tapped.
	viewClickScript: func(unit) begin
