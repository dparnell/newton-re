// CallValidate (@8281): checks that worksite a1 has a computer to connect with
// (its connectionNetwork), asking for one in the validate slip; a2 is called
// with the answer (ValidateDone).

export89 := func(a1, a2) begin
	self.thecallback := a2;
	return self:ValidateConfig('location, a1, [Array: WorksiteNetworkSlot], "Choose a computer to connect with.", 'validateDialog, 'ValidateDone)
end;
