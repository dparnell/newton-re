// The slip after a restore (@8272): the Newton must restart to use what was
// restored (and a note that some data was not, when the restore stopped with
// an error); its only button restarts.

export80 := {
	viewBounds: {left: 0, top: 60, right: 210, bottom: 170},
	stepChildren: [stepChildren:
		{
			title: dock,
			titleIcon: {bits: titleIconBits, bounds: {left: 0, top: 0, right: 19, bottom: 11}},
			_proto: @protoTitle
		},
		{
			text: nil,
			viewBounds: {left: 0, top: 10, right: 195, bottom: 60},
			viewJustify: vjParentCenterH + vjSiblingBottomV,
			viewFont: @fontSystem10,
			// The message for a restore that completed or stopped (error).
			viewSetupFormScript: func() begin
				(if (error <> 0) then begin
						self.text := "The restore operation stopped before it was completed so some of your data was not restored.  Your Newton device needs to be restarted to use the restored information.";
						self.viewBounds := Clone(viewBounds);
						(viewBounds.bottom := (viewBounds.bottom + 20))
					end else (self.text := "Your Newton device needs to be restarted to use the restored information."))
			end,
			_proto: @protoStaticText
		},
		restart
	],
	viewFlags: vApplication + vFloating + vClickable,
	// Taller for the longer message.
	viewSetupFormScript: func() begin
		(if (error <> 0) then begin
				self.viewBounds := Clone(viewBounds);
				(viewBounds.bottom := (viewBounds.bottom + 20))
			end)
	end,
	// Puts the caret in the slip.
	viewSetupDoneScript: func() begin
		inherited:?viewSetupDoneScript();
		SetKeyView(self, 0)
	end,
	_nextKeyView: 'none,
	textFlags: 33792,
	_proto: @protoFloater,
	_defaultButton: nil,
	stepAllocateContext: [|Array|: '_defaultButton, restart]
};

// Restart: reboots the Newton.
restart := {
	text: "Restart",
	buttonClickScript: func() begin
		ReBoot()
	end,
	viewBounds: {left: -54, top: -18, right: -7, bottom: -5},
	viewJustify: vjCenterH + vjCenterV + vjParentRightH + vjParentBottomV + oneLineOnly,
	_proto: @protoTextButton,
	preAllocatedContext: '_defaultButton
};
