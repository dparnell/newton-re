viewSetupFormScript_literal3 := same("export71.stepChildren[4].viewSetupFormScript.literals[3]");

viewSetupFormScript_code_5 := same("export71.stepChildren[6].viewSetupFormScript.instructions");

viewQuitScript_code_2 := same("export71.viewQuitScript.instructions");
