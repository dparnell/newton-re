// The File Info slip (@8263): the icon, name, kind, size and modification date
// of a desktop file, from the desktop's answer ('finf') to the Get Info request.

export71 := {
	viewBounds: {left: 0, top: 69, right: 200, bottom: 207},
	stepChildren: [stepChildren:
		{title: fileInfo, _proto: @protoTitle},
		export71Item,
		{
			text: nil,
			viewBounds: {left: 5, top: 0, right: 140, bottom: 12},
			viewFont: tsSimple + tsSize(9),
			// The file's name.
			viewSetupFormScript: func() begin
				(text := Clone(fileName))
			end,
			viewJustify: vjSiblingRightH + vjSiblingCenterV + oneLineOnly,
			_proto: @protoStaticText
		},
		{
			text: "Kind",
			viewBounds: {left: 10, top: 74, right: 57, bottom: 86},
			viewJustify: vjRightH + oneLineOnly,
			_proto: @protoStaticText
		},
		{
			text: nil,
			viewBounds: {left: 5, top: 0, right: 140, bottom: 12},
			viewFont: tsSimple + tsSize(9),
			viewJustify: vjSiblingRightH + vjSiblingTopV + oneLineOnly,
			// Its kind, or "Unknown".
			viewSetupFormScript: func() begin
				(if fileInfo.kind then (text := fileInfo.kind) else (text := "Unknown"))
			end,
			_proto: @protoStaticText
		},
		{
			text: "Size",
			viewBounds: {left: 10, top: 1, right: 57, bottom: 13},
			viewJustify: vjRightH + vjSiblingBottomV + oneLineOnly,
			_proto: @protoStaticText
		},
		{
			text: nil,
			viewBounds: {left: 5, top: 0, right: 140, bottom: 12},
			viewFont: tsSimple + tsSize(9),
			viewJustify: vjSiblingRightH + vjSiblingTopV + oneLineOnly,
			// Its size, or "Unknown".
			viewSetupFormScript: func() begin
				(if fileInfo.size then (text := NumberStr(fileInfo.size)) else (text := "Unknown"))
			end,
			_proto: @protoStaticText
		},
		{
			text: "Modified",
			viewBounds: {left: 10, top: 1, right: 57, bottom: 13},
			viewJustify: vjRightH + vjSiblingBottomV + oneLineOnly,
			_proto: @protoStaticText
		},
		{
			text: nil,
			viewBounds: {left: 5, top: 0, right: 140, bottom: 12},
			viewFont: tsSimple + tsSize(9),
			viewJustify: vjSiblingRightH + vjSiblingTopV + oneLineOnly,
			// When it was modified, or "Unknown".
			viewSetupFormScript: func() begin
				(if fileInfo.modified then (text := DateNTime(fileInfo.modified)) else (text := "Unknown"))
			end,
			_proto: @protoStaticText
		},
		{_proto: @protoCancelButton}
	],
	// Reads the desktop's 'finf' frame; on an error the slip closes itself.
	viewSetupFormScript: func() begin
		local callReadCommand;
		self.protoContext := GetRoot().Connection;
		protoContext:AddOpenWindow(self);
		(try begin
				if (not IsFrame((callReadCommand := protoContext:CallReadCommand(endpoint, "finf")).data)) then begin
						Throw('|evt.ex.error|, kDockErrDesktopError)
					end;
				(fileInfo := callReadCommand.data)
			end onexception |evt.ex| do begin
				protoContext:HandleErrorDuringStartup(endpoint, self, CurrentException().error);
				(fileInfo := {})
			end)
	end,
	fileInfo: nil,
	killMyself: nil,
	// Leaves the open windows.
	viewQuitScript: func() begin
		protoContext:RemoveOpenWindow(self)
	end,
	viewFlags: vApplication + vFloating + vClickable,
	// Sets up the icon's flags.
	viewSetupChildrenScript: func() begin
		filesIcon:SetupViewflags()
	end,
	_proto: @protoFloater,
	filesIcon: nil,
	stepAllocateContext: [|Array|: 'filesIcon, export71Item]
};

// The file's icon: the desktop's 32 x 32 one-bit icon (128 bytes) copied into
// a bitmap a word at a time; a blank one when it has none.
export71Item := {
	viewFlags: vVisible,
	icon: nil,
	viewFormat: nil,
	viewBounds: {left: 25, top: 25, right: 57, bottom: 57},
	// The file's 32 by 32 icon from the desktop's 128 bytes (64 words copied into
	// the bitmap); blank if there are none.
	viewSetupFormScript: func() begin
		newIcon := MakeBitmap(32, 32, nil);
		if (if fileInfo.icon then (Length(fileInfo.icon) = 128)) then begin
				bitmapInfo := GetBitmapInfo(newIcon);
				local bitmapInfo;
				(for i := 0 to 63 do begin
						StuffWord(bitmapInfo.bits, ((i * 2) + bitmapInfo.scanOffset), ExtractWord(fileInfo.icon, (i * 2)))
					end)
			end;
		(self.icon := newIcon)
	end,
	// Draws the icon.
	viewDrawScript: func() begin
		self:DrawShape(icon, nil)
	end,
	// Nothing to set up.
	SetupViewflags: func() begin
		nil
	end,
	viewClass: clPictureView,
	preAllocatedContext: 'filesIcon
};

