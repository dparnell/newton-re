// The import translator slip (@8273): the desktop's translators for the file
// being imported (translateWhich), one to pick; Import has the import
// (context) go on with it.

export81 := {
	viewBounds: {left: 0, top: 40, right: 200, bottom: 206},
	stepChildren: [stepChildren:
		{
			title: dock,
			titleIcon: {bits: titleIconBits, bounds: {left: 0, top: 0, right: 19, bottom: 11}},
			_proto: @protoTitle
		},
		{
			text: "Select a translator for",
			viewBounds: {left: 10, top: 6, right: 200, bottom: 18},
			viewJustify: vjSiblingBottomV + oneLineOnly,
			viewFont: @fontSystem10Bold,
			_proto: @protoStaticText
		},
		export81Item,
		export81Item_2,
		{
			// Cancel: tells the desktop ('opca') and ends the import.
			buttonClickScript: func() begin
				closing := true;
				inherited:?buttonClickScript();
				context:Close();
				protoContext:SendCancelToDesktop(endpoint);
				protoContext:ImportFileClose(endpoint);
				(if callWhenDone then call callWhenDone with ())
			end,
			_proto: @protoCancelButton
		},
		{
			text: import,
			// Import with the translator picked.
			buttonClickScript: func() begin
				context:Import(selectedTranslator);
				closing := true;
				base:Close()
			end,
			viewBounds: {top: -18, left: -47, right: -9, bottom: -5},
			viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingLeftH + oneLineOnly,
			_proto: @protoTextButton
		}
	],
	translators: nil,
	// Joins the open windows and idles the endpoint every 2 seconds.
	viewSetupFormScript: func() begin
		self.protoContext := GetRoot().Connection;
		protoContext:AddOpenWindow(self);
		self.closing := nil;
		translateFileName.text := translateWhich;
		endpoint:StartIdle(self, 2000)
	end,
	selectedTranslator: nil,
	// Ends the connection when the slip was closed some other way.
	viewQuitScript: func() begin
		protoContext:RemoveOpenWindow(self);
		endpoint:StopIdle(self);
		(if (not closing) then endpoint:ConnectionDone(0))
	end,
	// Keeps the connection alive; ends the import when the desktop has finished.
	viewIdleScript: func() begin
		local idleConnection;
		if (if ((idleConnection := endpoint:IdleConnection(true)) = 0) then (not endpoint.closingDown)) then begin
				protoContext:ImportFileClose(endpoint);
				if callWhenDone then begin
						call callWhenDone with ()
					end
			end;
		return idleConnection
	end,
	viewFlags: vApplication + vFloating + vClickable,
	closing: nil,
	_proto: @protoFloater,
	translateFileName: nil,
	stepAllocateContext: [|Array|: 'translateFileName, export81Item, 'translatorList, export81Item_2],
	translatorList: nil
};

// The file's name.
export81Item := {
	text: nil,
	viewBounds: {left: 20, top: 3, right: 200, bottom: 16},
	viewJustify: vjSiblingBottomV + oneLineOnly,
	_proto: @protoStaticText,
	preAllocatedContext: 'translateFileName
};

// The list of translators (selectedTranslator its index).
export81Item_2 := {
	viewBounds: {left: 10, top: 6, right: 190, bottom: 78},
	// Lists the translators, the first picked.
	viewSetupFormScript: func() begin
		self.listItems := translators;
		self:SetupList();
		(selectedTranslator := 0)
	end,
	viewFont: @fontSystem9,
	// A translator tapped.
	buttonClickScript: func(a1) begin
		(selectedTranslator := a1)
	end,
	useScrollers: true,
	viewJustify: vjSiblingBottomV,
	_proto: @protoTextList,
	preAllocatedContext: 'translatorList
};

import := "Import";

// what the functions above hold and share with other objects (same(): romsrc/README.md)

buttonClickScript_code_6 := same("export81Item_2.buttonClickScript.instructions");
