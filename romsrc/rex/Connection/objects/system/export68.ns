		export68Item_5,
		export68Item_6
	],
	viewSetupFormScript: func() begin
		self.protoContext := GetRoot().Connection;
		protoContext:AddOpenWindow(self);
		self.clickHandled := nil;
		if config then begin
				message.text := config.message;
				if config.title then begin
						title.text := config.text
					end;
				if config.button1 then begin
						button1.text := config.button1
					end;
				if config.button2 then begin
						button2.text := config.button2
					end;
				if config.button3 then begin
						button3.text := config.button3
					end
			end;
		endpoint:StartIdle(self, 2000)
	end,
	SetTextBounds: func(a1) begin
		local l1;
		(l1 := Clone(a1.viewBounds)).left := (l1.right - min(90, max(15, (StrWidth(a1.text) + 7))));
		(a1.viewBounds := l1)
	end,
	HandleClick: func(a1) begin
		(if (not clickHandled) then begin
				clickHandled := true;
				call DesktopInputDone with (a1);
				(if (a1 <> 0) then base:Close())
			end)
	end,
	viewIdleScript: func() begin
		return endpoint:IdleConnection(true)
	end,
	viewQuitScript: func() begin
		protoContext:RemoveOpenWindow(self);
		self:HandleClick(0);
		endpoint:StopIdle(self)
	end,
	viewFlags: vApplication + vFloating + vClickable,
	clickHandled: nil,
	_proto: @protoFloater,
	title: nil,
	stepAllocateContext: [|Array|:
		'title,
		export68Item,
		'message,
		export68Item_2,
		'xButton,
		export68Item_3,
		'button1,
		export68Item_4,
		'button2,
		export68Item_5,
		'button3,
		export68Item_6
	],
	message: nil,
	xButton: nil,
	button1: nil,
	button2: nil,
	button3: nil
};

