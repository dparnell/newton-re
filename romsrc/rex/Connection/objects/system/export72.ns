// The "Getting file list..." status slip (@8264) that ConnOpenFileBrowser
// opens: waits for the desktop's answer to the browse request and opens the
// file browser - the Mac OS one (@8261) or the PC one (@8262) - then closes.

export72 := {
	viewBounds: {left: 0, top: 60, right: 180, bottom: 145},
	viewSetupFormScript: compile(
		constants: {
			kROM_8261: @8261,
			kROM_8262: @8262
		},
		// Once: joins the open windows and, deferred, reads the desktop's answer (for
		// whichFiles 1, first its 'gist' request, answered with the internal store's
		// frame 'isto'), then the 'dres' result, and opens the browser for the
		// desktop's type.  A cancel just closes; other errors end the connection.
		func() begin
			if (not inited) then begin
					inited := true;
					self.protoContext := GetRoot().Connection;
					protoContext:AddOpenWindow(self);
					self.initialSetup := DeepClone(initialSetup);
					initialSetup.values.statusText := labels[0];
					self.currentStatusSetup := DeepClone(initialSetup);
					self.stopping := nil;
					self.closing := nil;
					AddDeferredCall(func() begin
						local callReadCommand, error;
						(try begin
								if (whichFiles = 1) then begin
										callReadCommand := protoContext:CallReadCommand(endpoint, "gist");
										endpoint:WriteCommand("isto", protoContext:BuildStoreFrame(GetStores()[0], nil, nil), true)
									end;
								callReadCommand := protoContext:CallReadCommand(endpoint, "dres");
								if (endpoint:DesktopType() = 0) then begin
										self.theFileBrowser := BuildContext(kROM_8261)
									end else begin
										self.theFileBrowser := BuildContext(kROM_8262)
									end;
								theFileBrowser.whichFiles := whichFiles;
								theFileBrowser.labels := labels;
								theFileBrowser.callWhenDone := callWhenDone;
								theFileBrowser.callWhenSetup := func() begin
									closing := true;
									self:Close()
								end;
								theFileBrowser.endpoint := endpoint;
								theFileBrowser:FilterDialog()
							end onexception |evt.ex| do begin
								if ((error := CurrentException().error) <> kCommErrRequestCanceled) then begin
										endpoint:ConnectionDone(error)
									end;
								closing := true;
								self:Close()
							end)
					end, nil);
					endpoint:StartIdle(self, 500)
				end;
			inherited:?viewSetupFormScript()
		end),
	// Ends the connection when the slip was closed some other way.
	viewQuitScript: func() begin
		endpoint:StopIdle(self);
		protoContext:RemoveOpenWindow(self);
		if (if (not closing) then (not stopping)) then begin
				endpoint:ConnectionDone(0)
			end;
		(inited := nil)
	end,
	viewFlags: vApplication + vFloating + vClickable,
	// Stop: says "Stopping...", stops the browser and the endpoint's operation.
	CancelRequest: func(symbol2) begin
		(if (not stopping) then begin
				stopping := true;
				currentStatusSetup.values.titleText := "Stopping...";
				self:viewSet(currentStatusSetup);
				if self.theFileBrowser then begin
						theFileBrowser:StopOpen(0)
					end;
				protoContext:StopOperation(endpoint)
			end)
	end,
	inited: nil,
	initialSetup: {
		name: 'vBarber,
		values: {
			statusText: nil,
			titleText: "Getting file list...",
			barber: true,
			icon: valuesIcon,
			closeBox: nil
		},
		appSymbol: 'Connection
	},
	// Turns the barber pole every half second.
	viewIdleScript: func() begin
		self:updateIndicator(currentStatusSetup);
		return 500
	end,
	theFileBrowser: nil,
	currentStatusSetup: nil,
	stopping: nil,
	closing: nil,
	_proto: @protoStatusTemplate
};

