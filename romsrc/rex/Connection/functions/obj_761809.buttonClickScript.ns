@@ 0x761845
func() begin
	local l1, l2;
	l1 := GetRoot().Connection;
	if (if (l2 := l1:GetWorksite(prefsFrame.phoneCurrentChoice)) then l2.connectionPhone) then begin
			callOptionsSlip.inNumber := MakePhone({areacode: l2.areacode, phone: l2.connectionPhone})
		end else begin
			callOptionsSlip.inNumber := ""
		end;
	callOptionsSlip.inCountry := l1:WorksiteToCountry(l2);
	callOptionsSlip.invoker := self;
	callOptionsSlip:Toggle()
end
@@end
