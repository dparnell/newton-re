@@ 0x75a819
func(endpoint) begin
	local l1;
	l1 := 0;
	try begin
			endpoint.disconnecting := true;
			endpoint:WriteCommand("disc", nil, nil)
		end onexception |evt.ex| do begin
			l1 := CurrentException().error
		end;
	if (l1 = 0) then begin
			AddDelayedCall(func() begin
				endpoint:ConnectionDone(0)
			end, nil, 1000)
		end else begin
			endpoint:ConnectionDone(l1)
		end;
	(closeBoxTapped := nil)
end
@@end
