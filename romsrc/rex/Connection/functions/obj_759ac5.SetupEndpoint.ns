@@ 0x75b3b5
func() begin
	local where;
	local l1, l2;
	(l1 := Clone((where := GetRoot().Connection).dtEndpoint)).callWhenDone := func(a1) begin
		where:MyCleanup(a1)
	end;
	l1:Instantiate('Connection, "Dock");
	where.theEndpoint := l1;
	l2 := func(a1) begin
		a1:FlushCommandData();
		a1:WriteCommand("kybd", nil, nil);
		a1:SetState(9);
		AddDeferredSend(where, 'ToggleKeyboardPassthrough, [Array: true]);
		return nil
	end;
	(try begin
			l1:InstallAnyProtocolExtension("kybd", l2)
		end onexception |evt.ex| do begin
			nil
		end)
end
@@end
