	end;
	(if (not IsFrame((options := self:GetAutoDockOptions(prefsFrame, myCallback)))) then return nil else (if ((prefsFrame.type = 'modem) or options.button) then kROM_8277:OpenOn(options, prefsFrame, password, callback) else (if options.callBeforeConnect then options:callBeforeConnect((options := DeepClone(options)), func(a1) begin
