											if (v18_xxxwwwwwwwwwwwwww.ownerApp <> 'SystemScratch) then begin
													if (not (v19_xxxxxxxxwwwwwwwwwwww := v18_xxxwwwwwwwwwwwwww.ownerAppName)) then begin
															if IsSymbol(v18_xxxwwwwwwwwwwwwww.ownerApp) then begin
																	v19_xxxxxxxxwwwwwwwwwwww := GetAppName(v18_xxxwwwwwwwwwwwwww.ownerApp)
																end else begin
																	v19_xxxxxxxxwwwwwwwwwwww := soupName
																end
														end
												end;
											call v12_tttttttt with (v19_xxxxxxxxwwwwwwwwwwww)
										end else begin
											(foreach v16_wwwwwwwwvvvvvv in a1 do begin
													if (v10_zzzzzzzzzzzzzzzyyyyyyyyyyyy := v16_wwwwwwwwvvvvvv:GetSoup(soupName)) then begin
															break
														end
												end);
											if (if IsArray((v18_xxxwwwwwwwwwwwwww := v10_zzzzzzzzzzzzzzzyyyyyyyyyyyy:GetInfo('applications))) then (Length(v18_xxxwwwwwwwwwwwwww) > 0)) then begin
													(foreach v7_vvvvvvvvvvvvvvvvvvu in v18_xxxwwwwwwwwwwwwww do begin
															if IsSymbol(v7_vvvvvvvvvvvvvvvvvvu) then begin
																	v19_xxxxxxxxwwwwwwwwwwww := GetAppName(v7_vvvvvvvvvvvvvvvvvvu)
																end else begin
																	v19_xxxxxxxxwwwwwwwwwwww := soupName
																end;
															call v12_tttttttt with (v19_xxxxxxxxwwwwwwwwwwww)
														end)
												end else begin
													v13_zzzzzzyyy := call v12_tttttttt with ("Other information");
													if (not v22_yyyyyyyxxxxxxxxxxxxxxxx) then begin
															v22_yyyyyyyxxxxxxxxxxxxxxxx := SetClass(v13_zzzzzzyyy, 'otherFrame)
														end
												end
										end
								end
