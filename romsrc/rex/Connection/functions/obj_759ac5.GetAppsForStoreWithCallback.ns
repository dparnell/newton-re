@@ 0x75c7b1
@@const kROM_8278
@8278
@@main
func(a1, soupsToo, a3) begin
	local appList, soupName;
	local v9_mmll, v12_tttttttt, v13_zzzzzzyyy, v14_vvvvvvvuuuu, v17_zzzzzzzzzzzzyyy, v18_xxxwwwwwwwwwwwwww, v19_xxxxxxxxwwwwwwwwwwww, v22_yyyyyyyxxxxxxxxxxxxxxxx;
	appList := [Array: ];
	v12_tttttttt := func(a1) begin
		local l1;
		l1 := BInsert(appList, {name: a1}, '|str<|, '[pathExpr: name], 'returnElt);
		if soupsToo then begin
				if (not l1.soups) then begin
						l1.soups := [Array: soupName]
					end else begin
						BInsert(l1.soups, soupName, '|str<|, nil, true)
					end
			end;
		l1
	end;
	v17_zzzzzzzzzzzzyyy := a1[0]:GetSoupNames();
	(for v21_tttttttttss := 1 to (Length(a1) - 1) do begin
			(foreach v10_zzzzzzzzzzzzzzzyyyyyyyyyyyy in a1[v21_tttttttttss]:GetSoupNames() do begin
					call a3 with ();
					BInsert(v17_zzzzzzzzzzzzyyy, v10_zzzzzzzzzzzzzzzyyyyyyyyyyyy, '|str<|, nil, true)
				end)
		end);
	(foreach soupName in v17_zzzzzzzzzzzzyyy do begin
			call a3 with ();
			if (not StrEqual(soupName, "Packages")) then begin
					if BFind(kROM_8278, soupName, '|str<|, nil) then begin
							v13_zzzzzzyyy := call v12_tttttttt with ("System information");
							if (not v9_mmll) then begin
									v9_mmll := SetClass(v13_zzzzzzyyy, 'systemFrame)
								end
						end else begin
							if (BeginsWith(soupName, "Backup_") or StrEqual(soupName, "BackupInfo")) then begin
