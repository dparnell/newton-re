// export158: Setup's labelled input line (a static-text label and a protoInputLine,
// vInputLine), the proto of the name and address pages' lines (label, labelFont,
// text slots). The file holds it and what only it reaches.

export158 := {
	viewBounds: {left: 0, top: 5, right: 240, bottom: 20},
	viewFormat: vfPen(1),
	stepChildren: [stepChildren:
		{
			viewBounds: {left: 0, top: 3, right: 70, bottom: 17},
			// viewSetupFormScript: takes the label's text and font from the line's label and labelFont slots.
			viewSetupFormScript: func() begin
				if (label exists) then begin
						self.text := label
					end;
				(if (labelFont exists) then (self.viewFont := labelFont))
			end,
			viewJustify: oneLineOnly,
			viewFormat: vfPen(1),
			viewFont: viewFont,
			_proto: @protoStaticText
		},
		export158Item
	],
	viewJustify: vjParentCenterH + vjParentBottomV + vjSiblingBottomV,
	// TextLength(): the length of the line's text (0 when empty).
	TextLength: func() begin
		(if vInputLine.text then StrLen(vInputLine.text) else 0)
	end,
	// SetText(text): sets the line's text.
	SetText: func(a1) begin
		SetValue(vInputLine, 'text, a1)
	end,
	declareSelf: 'inputBase,
	// GetText(): the line's text.
	GetText: func() begin
		vInputLine.text
	end,
	viewFlags: vVisible + vClickable,
	viewClass: clView,
	vInputLine: nil,
	stepAllocateContext: [|Array|: 'vInputLine, export158Item]
};

export158Item := {
	viewBounds: {left: 5, top: 1, right: 160, bottom: 17},
	viewFormat: vfPen(1) + vfLinesGray + vfInset(3),
	viewJustify: vjParentRightH + vjSiblingRightH + oneLineOnly,
	// viewSetupFormScript: line spacing to fit the font.
	viewSetupFormScript: func() begin
		self.text := text;
		self.viewLineSpacing := fontHeight(viewFont);
		inherited:?viewSetupFormScript()
	end,
	// TextLength(): the length of the text (0 when empty).
	TextLength: func() begin
		(if self.text then StrLen(self.text) else 0)
	end,
	// viewChangedScript: tells the page (textChanged) that the line changed.
	viewChangedScript: func(slot, view) begin
		self:?textChanged()
	end,
	viewFont: tsFancy + tsSize(12),
	viewFlags: vVisible + vClickable + vGesturesAllowed,
	_proto: @protoInputLine,
	preAllocatedContext: 'vInputLine
};

