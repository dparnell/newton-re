// phone, and what only it reaches

phone := {
	description: tapOnALine,
	TearDown: func() begin
		l2 := Length((l1 := fPersona.phones));
		l3 := nil;
		l4 := nil;
		l6 := "";
		fWorkSite.AreaCode := vVoice:GetTextArea();
		SetClass((l6 := MakePhone({AreaCode: vVoice:GetTextArea(), phone: vVoice:GetTextLocal()})), 'homePhone);
		if (l2 > 0) then begin
				local l1;
				local l2;
				local l3;
				local l4;
				local l5;
				local l6;
				local l7;
				(for l5 := 0 to (l2 - 1) do begin
						if (ClassOf(l1[l5]) = 'homePhone) then begin
								l1[l5] := l6;
								l3 := true
							end
					end)
			end;
		if ((l3 = nil) or (l2 = 0)) then begin
				if (not StrEqual(l6, "")) then begin
						AddArraySlot(fPersona.phones, l6)
					end
			end;
		SetClass((l7 := MakePhone({AreaCode: vFax:GetTextArea(), phone: vFax:GetTextLocal()})), 'homefaxPhone);
		if (l2 > 0) then begin
				(for l5 := 0 to (l2 - 1) do begin
						if (ClassOf(l1[l5]) = 'homefaxPhone) then begin
								l1[l5] := l7;
								l4 := true
							end
					end)
			end;
		if ((l4 = nil) or (l2 = 0)) then begin
				if (not StrEqual(l7, "")) then begin
						AddArraySlot(fPersona.phones, l7)
					end
			end;
		(fWorkSite.place := "Home")
	end,
	titleTExt: "Enter your Home \u000dPhone Numbers",
	stepChildren: [stepChildren:
		nameItem,
		homeVoice,
		homeFax,
		{
			viewBounds: {left: -5, top: 162, right: 217, bottom: 212},
			viewFlags: vVisible,
			viewFormat: nil,
			viewJustify: vjParentCenterH,
			viewClass: clPictureView,
			icon: picture('picture, "resources/picture/7b1e69")
		},
		{_proto: @8352}
	],
	declareSelf: 'PageBase,
	viewSetupDoneScript: func() begin
		SetKeyView(vVoice.vInputCityCode, 0);
		inherited:?viewSetupDoneScript()
	end,
	debug: "phone",
	_proto: @8353,
	vVoice: nil,
	stepAllocateContext: [|Array|:
		'_defaultButton,
		nameItem_2,
		'vGoBackButton,
		nameItem_3,
		'vCloser,
		nameItem_4,
		'vFeedback,
		nameItem_5,
		'vVoice,
		homeVoice,
		'vFax,
		homeFax
	],
	vFax: nil
};

homeVoice := {
	entryFlags: 513,
	viewBounds: {left: 0, top: 2, right: 236, bottom: 23},
	viewSetupFormScript: func() begin
		local l1;
		local l2;
		local l3;
		local l4;
		(if ((l2 := Length((l1 := fPersona.phones))) > 0) then (foreach l3 in l1 do begin
					if (ClassOf(l3) = 'homePhone) then begin
							if (if ((l4 := ParsePhone(l3)).AreaCode <> nil) then (not StrEqual(l4.AreaCode, ""))) then begin
									vVoice:SetTextArea(l4.AreaCode)
								end;
							if (if (l4.phone <> nil) then (not StrEqual(l4.phone, ""))) then begin
									vVoice:SetTextLocal(l4.phone)
								end
						end
				end))
	end,
	label: "Home Voice",
	_proto: @8351,
	preAllocatedContext: 'vVoice
};

homeFax := {
	label: "Home Fax",
	textChanged: func() begin
		nil
	end,
	entryFlags: 513,
	viewBounds: {left: 0, top: 2, right: 236, bottom: 23},
	viewSetupFormScript: func() begin
		local l1;
		local l2;
		local l3;
		local l4;
		(if ((l2 := Length((l1 := fPersona.phones))) > 0) then (foreach l3 in l1 do begin
					if (ClassOf(l3) = 'homefaxPhone) then begin
							if (if ((l4 := ParsePhone(l3)).AreaCode <> nil) then (not StrEqual(l4.AreaCode, ""))) then begin
									vFax:SetTextArea(l4.AreaCode)
								end;
							if (if (l4.phone <> nil) then (not StrEqual(l4.phone, ""))) then begin
									vFax:SetTextLocal(l4.phone)
								end
						end
				end))
	end,
	_proto: @8351,
	preAllocatedContext: 'vFax
};
