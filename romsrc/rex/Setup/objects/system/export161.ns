// export161, and what only it reaches

export161 := {
	viewFlags: 0,
	viewFormat: vfFillWhite + vfPen(1),
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	stepChildren: [stepChildren: nameItem],
	viewSetupFormScript: func() begin
		local l1, l2;
		if ((l2 := (Length((l1 := self.stepChildren)) - 1)) > 0) then begin
				ArrayMunger((fSonOfStepChildren := Array(l2, nil)), 0, nil, l1, 1, l2);
				self.stepChildren := [Array: l1[0]]
			end;
		if (fformat = 'wide) then begin
				titleTExt := StringFilter(titleTExt, "\n", 'rejectAll)
			end;
		SetKeyView(self, 0)
	end,
	fSonOfStepChildren: [|Array|: ],
	SetFeedback: func(a1) begin
		vFeedback:SetText(a1)
	end,
	AllowContinue: func(a1) begin
		(if a1 then _defaultButton:Open() else _defaultButton:Hide())
	end,
	viewQuitScript: func() begin
		(if fCompleted then (fCompleted.(Intern(debug)) := true))
	end,
	_proto: @protoContainerView,
	_defaultButton: nil,
	stepAllocateContext: [|Array|:
		'_defaultButton,
		nameItem_2,
		'vGoBackButton,
		nameItem_3,
		'vCloser,
		nameItem_4,
		'vFeedback,
		nameItem_5
	],
	vGoBackButton: nil,
	vCloser: nil,
	vFeedback: nil
};
