// SetUp, and what only it reaches

SetUp := {
	viewSetupDoneScript: func() begin
		local currentPersona, appPrefs;
		if (currentPersona := GetUserConfig('currentPersona)) then begin
				fPersona := ResolveEntryAlias(currentPersona)
			end else begin
				fPersona := {name: {first: Clone(""), last: Clone("")}, phones: [Array: ]}
			end;
		if (appPrefs := GetAppPrefs(appSymbol, '{})) then begin
				fWorkSite := ResolveEntryAlias(appPrefs.homeWorksite);
				fWorkworksite := ResolveEntryAlias(appPrefs.workWorksite)
			end;
		if (not fWorkSite) then begin
				fWorkSite := {}
			end;
		if (not fWorkworksite) then begin
				fWorkworksite := {}
			end;
		self:ShowPage(fFirstPage);
		AddDeferredSend(self, 'MoveBehind, [Array: nil])
	end,
	fBizCard: nil,
	viewFormat: nil,
	fFirstName: nil,
	fReadyToQuit: nil,
	viewQuitScript: func() begin
		appPrefs := GetAppPrefs(appSymbol, '{});
		if (IsSoupEntry(fWorkSite) or IsSoupEntry(fWorkworksite)) then begin
				l6 := true
			end else begin
				l6 := ((not (emporia := GetUserConfig('emporia))) or (Length(emporia) = 0))
			end;
		if (fCompleted.name = true) then begin
				if (saveWorksiteInfo := self:SaveWorksiteInfo(fWorkSite, l6)) then begin
						fWorkSite := saveWorksiteInfo;
						appPrefs.homeWorksite := MakeEntryAlias(fWorkSite)
					end;
				if IsSoupEntry(fPersona) then begin
						EntryChange(fPersona);
						UseCurrentPersona()
					end else begin
						fPersona := GetRoot().cardfile:AddCard('owner, fPersona)
					end;
				if fPersona then begin
						AddPersona(fPersona)
					end
			end;
		if (fCompleted.PhoneWork = true) then begin
				if (saveWorksiteInfo := self:SaveWorksiteInfo(fWorkworksite, l6)) then begin
						fWorkworksite := saveWorksiteInfo;
						appPrefs.workWorksite := MakeEntryAlias(fWorkworksite)
					end
			end;
		EntryChange(appPrefs);
		now := Time();
		if GetRoot().worldClock.SetLocation then begin
				if fPersona.city then begin
						if ((count := Length((cityEntry := GetCityEntry(fPersona.city)))) > 0) then begin
								if (count = 1) then begin
										newCity2 := cityEntry[0]
									end else begin
										if (count > 1) then begin
												local newCity2;
												local appPrefs;
												local l3;
												local saveWorksiteInfo;
												local emporia;
												local l6;
												local entryAlias;
												local now;
												local i;
												local count;
												local cityEntry;
												(for i := 0 to (count - 1) do begin
														if ((cityEntry[i].country = mapCountry) or (not mapCountry)) then begin
																break (newCity2 := cityEntry[i])
															end
													end)
											end
									end
							end
					end;
				if (not newCity2) then begin
						if mapCountry then begin
								if (if fWorkSite then StrFilled(fWorkSite.AreaCode)) then begin
										if (NewCity := self:GetCityFromAreacode(fWorkSite.AreaCode, mapCountry)) then begin
												newCity2 := NewCity
											end
									end;
								if (if (if (not newCity2) then fWorkworksite) then StrFilled(fWorkworksite.AreaCode)) then begin
										if (NewCity := self:GetCityFromAreacode(fWorkworksite.AreaCode, mapCountry)) then begin
												newCity2 := NewCity
											end
									end;
								if newCity2 then begin
										if (if IsSoupEntry(fWorkSite) then StrEqual(newCity2.AreaCode, fWorkSite.AreaCode)) then begin
												entryAlias := MakeEntryAlias(fWorkSite)
											end else begin
												if IsSoupEntry(fWorkworksite) then begin
														entryAlias := MakeEntryAlias(fWorkworksite)
													end
											end;
										if entryAlias then begin
												SetUserConfig('currentEmporium, entryAlias);
												UseCurrentEmporium()
											end
									end
							end
					end else begin
						GetRoot().worldClock:SetLocation(newCity2)
					end
			end;
		SetTime(now);
		BusyBoxControl(1);
		'postQuit
	end,
	CountryPicker: nil,
	PhoneWork: nil,
	viewFlags: vApplication + vClipping + vFloating,
	SaveWorksiteInfo: func(a1, a2) begin
		local cityFromAreacode, areaCode, isSoupEntry2;
		if (if (not (isSoupEntry2 := IsSoupEntry(a1))) then (not a2)) then begin
				return nil
			end;
		if (if mapCountry then (areaCode := a1.AreaCode)) then begin
				if (cityFromAreacode := self:GetCityFromAreacode(areaCode, mapCountry)) then begin
						a1.cityAlias := MakeEntryAlias(cityFromAreacode);
						a1.country := GetCountryEntry(cityFromAreacode.country)[0].name;
						a1.countrySymbol := cityFromAreacode.country
					end
			end;
		if isSoupEntry2 then begin
				EntryChange(a1)
			end else begin
				a1 := GetRoot().cardfile:AddCard('worksite, a1)
			end;
		a1
	end,
	NextPage: func() begin
		self.fReadyToQuit := nil;
		(if (if (if fCompleted.fully then (fCurrentPageIndex < (Length(fPages) - 1))) then fReviewDone) then return self:ShowPage((Length(fPages) - 1)) else return self:ShowPage((fCurrentPageIndex + 1)))
	end,
	viewBounds: {left: 0, top: 0, right: 240, bottom: 320},
	datePicker: nil,
	fCurrentPage: nil,
	fWorkworksite: nil,
	viewOverviewScript: func() begin
		PlaySound(@funBeep);
		(if fReadyToQuit then self:SetupClose() else (fReadyToQuit := true))
	end,
	fPersona: nil,
	ShowPage: func(a1) begin
		local fPage;
		if (a1 >= Length(fPages)) then begin
				return nil
			end;
		self:LockScreen(true);
		if fCurrentPage then begin
				RemoveStepView(self, fCurrentPage);
				stepChildren := [Array: ];
				fCurrentPage := nil
			end;
		if ((fPage := fPages[a1]) <> nil) then begin
				fCurrentPageIndex := a1;
				if (fCurrentPage := AddStepView(self, fPage)) then begin
						fCurrentPage:Open()
					end;
				self:dirty()
			end;
		self:LockScreen(nil);
		fCurrentPageIndex := a1;
		return fCurrentPage
	end,
	appSymbol: 'SetUp,
	viewJustify: 0,
	name: nil,
	viewPostQuitScript: func() begin
		inherited:?viewPostQuitScript();
		self:ClearCut()
	end,
	fFirstPage: 0,
	stepAllocateContext: [|Array|:
		'name,
		@8345,
		'CountryPicker,
		@8342,
		'PhoneWork,
		@8347,
		'datePicker,
		@8343,
		'TimePicker,
		@8356
	],
	fPages: nil,
	fformat: 'normal,
	declareSelf: 'base,
	viewSetupFormScript: func() begin
		local appAreaWidth, appAreaHeight;
		BusyBoxControl(0);
		if ((savedBlessed := UserConfiguration.blessedApp) = 'SetUp) then begin
				savedBlessed := 'paperroll
			end;
		if (not fPages) then begin
				fPages := stepChildren
			end;
		stepChildren := [Array: ];
		fCompleted := {};
		fFirstTime := (GetUserConfig('blessedApp) = 'SetUp);
		appAreaWidth := GetAppParams().appAreaWidth;
		appAreaHeight := GetAppParams().appAreaHeight;
		if (appAreaWidth > appAreaHeight) then begin
				fformat := 'wide
			end;
		(if (appAreaWidth <> 240) then (self.viewBounds := OffsetRect(displayParams.rootBounds, (-displayParams.appAreaGlobalLeft), (-displayParams.appAreaGlobalTop))))
	end,
	fCompleted: nil,
	mapCountry: nil,
	fFirstTime: nil,
	GetCityFromAreacode: func(areaCode, mapCountry) begin
		local cursor, next;
		(if StrFilled(areaCode) then begin
				next := (cursor := GetLocationSoup(@citySoupName):Query({type: 'index, IndexPath: 'AreaCode, beginKey: areaCode, endKey: areaCode})):entry();
				(while next do (if (next.country = mapCountry) then break next else (next := cursor:Next())))
			end)
	end,
	fScreenSize: nil,
	viewClass: clView,
	PreviousPage: func() begin
		self.fReadyToQuit := nil;
		(if (fCurrentPageIndex = 0) then return self:ShowPage(fCurrentPageIndex) else return self:ShowPage((fCurrentPageIndex - 1)))
	end,
	fCurrentPageIndex: 0,
	stepChildren: [stepChildren: @8357, @8345, @8342, @8340, @8346, @8347, @8343, @8356, @8344, @8355, @8341],
	fWorkSite: nil,
	TimePicker: nil,
	savedBlessed: nil,
	fReviewDone: true,
	SetupClose: func() begin
		(if (UserConfiguration.blessedApp <> savedBlessed) then GetRoot():BlessApp(savedBlessed) else base:Close())
	end
};
