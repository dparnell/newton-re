	viewBounds: {top: -22, left: 0, right: -8, bottom: -6},
	viewJustify: 8390790,
	viewSetupFormScript: func() begin
		if (buttonText exists) then begin
				self.text := buttonText
			end else begin
				self.text := "Go Back"
			end;
