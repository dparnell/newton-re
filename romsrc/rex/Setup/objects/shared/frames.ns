// objects several roots reach, none alone (naturalize.py)

nameItem := {
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewFlags: vVisible + vClickable,
	viewFormat: vfFillWhite + vfPen(1),
	stepChildren: [stepChildren:
		{
			viewFlags: vVisible,
			viewFormat: nil,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
			viewJustify: vjParentFullH + vjParentFullV,
			stepChildren: [stepChildren:
				{_proto: nameItemProto},
				{_proto: nameItemProto_2},
				{_proto: nameItemProto_3},
				nameItem_2,
				nameItem_3,
				nameItem_4,
				nameItem_5,
				{_proto: @8354},
				{
					viewBounds: {left: 2, top: 1, right: 240, bottom: 112},
					viewFont: viewFont,
					viewJustify: vjParentCenterH + vjParentBottomV + vjSiblingBottomV,
					viewSetupFormScript: func() begin
						if (description exists) then begin
								self.text := description
							end;
						if (descriptionHeight exists) then begin
								self.viewBounds := Clone(viewBounds);
								viewBounds.bottom := (viewBounds.top + descriptionHeight)
							end else begin
								width := viewBounds.right;
								viewBounds := TextBounds(text, {font: viewFont}, RelBounds(0, 1, width, 0))
							end;
						(self.viewLineSpacing := fontHeight(viewFont))
					end,
					viewSetupDoneScript: func() begin
						nil
					end,
					viewTransferMode: 0,
					_proto: @protoStaticText,
					text: nil
				}
			],
			viewSetupFormScript: func() begin
				(if (if (if HasPath(self, 'stepChildren) then (stepChildren <> nil)) then (Length(fSonOfStepChildren) > 0)) then begin
						if IsReadOnly(stepChildren) then begin
								self.stepChildren := Clone(stepChildren)
							end;
						ArrayMunger(stepChildren, Length(stepChildren), nil, fSonOfStepChildren, 0, Length(fSonOfStepChildren))
					end)
			end,
			viewSetupDoneScript: func() begin
				(if fFirstTime then vCloser:Hide())
			end,
			viewClass: clView
		}
	],
	viewSetupFormScript: func() begin
		nil
	end,
	viewJustify: vjParentFullH + vjParentFullV,
	viewClass: clView
};

