// function_3: the link manager's RemoveLinkClient action while going down (shared by
// several states): counted and kept to be told when the link is down; -60506 (the maximum
// number of links) for another link, -60501 (no link setup) without one. The file holds
// it and what only it reaches.

function_3 := func(a1) begin
	(if a1.fLinkID then (if (a1.fLinkID = fLinkEntry.linkID) then begin
				fLinKRefCount := (fLinKRefCount - 1);
				AddArraySlot(fLinkClients_Release, a1)
			end else self:MDoCallback(a1, [Array: a1.fLinkID, self:MBuildStatusFrameFromError(-60506), -60506])) else self:MDoCallback(a1, [Array: a1.fLinkID, self:MBuildStatusFrameFromError(-60501), -60501]))
end;
