// frame_2: the keyboard button of the device setup slip, shown instead of its keyboard
// when that does not fit (part.ns). The file holds it and what only it reaches.

frame_2 := {
	viewBounds: {left: 6, top: -18, right: 34, bottom: -5},
	viewFlags: vVisible + vReadOnly + vClickable,
	viewJustify: vjCenterH + vjCenterV + vjParentBottomV,
	_proto: @protoKeyboardButton,
	preAllocatedContext: 'keyButton
};
