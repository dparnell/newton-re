@@ 0x72d6fd
func(a1) begin
	local l1, l2, l3, l4;
	l4 := ClassOf((l2 := a1[0]));
	if StrFilled(a1[1]) then begin
			if StrFilled(l2) then begin
					l1 := ParsePhone(l2)
				end else begin
					l1 := {}
				end;
			l1.extension := ParamStr("^?0^0^?1 ^1|||^?1^1|", [Array: l1.extension, a1[1]]);
