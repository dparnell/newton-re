@@ 0x730779
func(a1) begin
	local l1, l2;
	if (if (if (if (l2 := StringToDateFrame(a1)) then (not l2.day)) then l2.month) then l2.year) then begin
			l2.day := 1;
			l1 := inherited:TextToPath(ShortDateStr(TotalMinutes(l2), 0))
		end else begin
			l1 := inherited:TextToPath(a1)
		end;
	l1
end
@@end
