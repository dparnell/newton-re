@@ 0x73b3c5
func(a1, a2) begin
	local l1, l2, l3, l4;
	if ((screenSize := GetAppParams()).appAreaWidth <= 240) then begin
			l1 := 0
		end else begin
			l1 := 8
		end;
	if ((a1.superSymbol = 'ownerNames) or (a2 = 'default)) then begin
			l2 := (if (a1.superSymbol = 'ownerNames) then 202 else 220)
		end else begin
			l2 := (screenSize.appAreaHeight - (l1 * 2));
			if (l1 > 0) then begin
					l2 := min(((220 - l1) * 2), l2)
				end
		end;
	l3 := SetBounds(0, ((-l2) - l1), 240, (-l1));
	if (l1 = 0) then begin
			l4 := 0
		end else begin
			l4 := GetRoot().cardfile._proto.viewFormat
		end;
	{bounds: l3, justify: 144, viewFormat: l4, draggerBorder: l1}
end
@@end
