				a2.top := (a2.top + (l1 * Length(l2)))
			end;
		(if (l3 := inherited:shapeFunc(a1, a2, a3, a4)) then begin
				if l2 then begin
						ArrayMunger(l3.shape, Length(l3.shape), 0, l2, 0, nil)
					end;
				l3.misc.phoneNum := a1[0];
				l3
			end else {shape: l2, misc: {bbox: SetBounds(0, 0, 0, 0), phoneNum: a1[0]}})
	end
};
