// objects several roots reach, none alone (naturalize.py)

layouts := {person: [|Array|: 'company], company: [|Array|: 'name]};

layouts_2 := {person: [|Array|: 'default], company: [|Array|: 'default]};

layouts_3 := {person: [|Array|: 'address, 'email], company: [|Array|: 'address, 'email]};

layouts_4 := {person: [|Array|: 'phone, 'pager], company: [|Array|: 'phone]};

addressItem_5Proto := {
	viewBounds: {left: 0, top: 0, right: 0, bottom: 40},
	viewLineSpacing: 32,
	flavor: flavor,
	viewChangedScript: func(slot, view) begin
		inherited:viewChangedScript(slot, view);
		(if (not target.(path)) then begin
				target.(path) := Clone("");
				self:StartFlush()
			end)
	end,
	_proto: @newtLabelInputLine
};

flavor := {
	_proto: @newtCustomFilter,
	recFlags: 25201153,
	TextToPath: func(a1) begin
		local l1;
		l1 := inherited:TextToPath(a1);
		target.(path) := l1;
		if ((target.class = 'person) or (target.class = 'owner)) then begin
				if StrFilled(target.name.last) then begin
						self:SetSorton(ParamStr("^0 ^1", [Array: target.name.last, target.name.first]))
					end else begin
						if StrFilled(target.name.first) then begin
								self:SetSorton(target.name.first)
							end else begin
								self:SetSorton(Clone(""))
							end
					end
			end else begin
				self:SetSorton(target.(path))
			end;
		GetRoot().cardfile:SetIAClass(target);
		l1
	end
};

defaultProto := {
	viewSetupFormScript: func() begin
		inherited:viewSetupFormScript();
		(if (if (not suppressAreaCode) then (not StrFilled(currAreaCode))) then (currAreaCode := Clone(GetUserConfig('currentAreaCode))))
	end,
	_proto: @newtAreacodePhoneLine
};

infoFrameProto := {
	shapeFunc: func(v20_wwwwwwwwwwvvvvvv, v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy, a3, a4) begin
		local strFontWidth2, l2, text, leftInfo, fontAscent2, frame2;
		fontAscent2 := FontAscent(a4.font);
		(if StrFilled(v20_wwwwwwwwwwvvvvvv[0]) then begin
				strFontWidth2 := StrFontWidth((text := ParamStr("^0 ^1", [Array: MakeDisplayPhone(v20_wwwwwwwwwwvvvvvv[0]), phoneTypes.phoneLabels.(ClassOf(v20_wwwwwwwwwwvvvvvv[0]))])), a4.font);
				l2 := (v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.right - v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.left);
				if a4.leftInfo then begin
						leftInfo := a4.leftInfo
					end else begin
						if (a4.justification = 'right) then begin
								leftInfo := ((l2 - strFontWidth2) - 16)
							end else begin
								if (a4.justification = 'center) then begin
										leftInfo := ceiling((((l2 - strFontWidth2) - 16) / 2))
									end else begin
										leftInfo := v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.left
									end
							end
					end;
				frame2 := {shape: [Array: {font: a4.font, justification: 'left}, OffsetShape(MakeShape(@phoneBitmap), leftInfo, (v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.top + 2)), MakeText(text, (leftInfo + 16), v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.top, v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.right, (v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.top + fontAscent2)), a4], misc: {bbox: RelBounds(leftInfo, (v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.top - a3), 16, 16)}};
				v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.top := (v24_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.top + fontHeight(a4.font));
				frame2
			end)
	end,
	actionFunc: func(a1, a2, a3, box, target, path, misc) begin
		(if (if (if (if (a1 >= misc.bbox.left) then (a1 <= misc.bbox.right)) then (a2 >= misc.bbox.top)) then (a2 <= misc.bbox.bottom)) then begin
				box := SetBounds((box.left + misc.bbox.left), (box.top + misc.bbox.top), ((box.left + misc.bbox.right) - 3), ((box.top + misc.bbox.bottom) - 3));
				a3:DoDrawing('Hiliter, [Array: MakeShape(box)]);
				call GetRoot().cardfile.kDoCallSlip with (a3, target, (if misc.phoneNum then misc.phoneNum else target.(path)));
				true
			end)
	end,
	formatFunc: func(v20_wwwwwwwwwwvvvvvv) begin
		ParamStr("^0 ^1", [Array: MakeDisplayPhone(v20_wwwwwwwwwwvvvvvv[0]), phoneTypes.phoneLabels.(ClassOf(v20_wwwwwwwwwwvvvvvv[0]))])
	end
};

