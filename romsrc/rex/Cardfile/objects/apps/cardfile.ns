// The "Cards" print format: a card's layout per printed card, 225 x 160.
cfCardsFormat := {
	routingType: 'Print,
	type: 'printFormat,
	name: cards,
	title: cards,
	symbol: 'cfCardsFormat,
	usesCursors: true,
	// Adds a card (target in layout) at a3, a4; returns its size.
	AddPrintChild: func(layout, target, a3, a4) begin
		AddArraySlot(stepChildren, {_proto: layout, target: target, viewBounds: RelBounds(a3, a4, 225, 160), viewJustify: 0});
		{bottom: 160, right: 225}
	end,
	protection: 'private,
	_proto: @8238
};

cards := "Cards";

// The route format for a card (beaming, mail): sends a copy of the card
// without its Date Book links, its notes (unless the preferences say to send
// them), and for an owner card its private data and passwords, sent as a
// person card.
cardfileRouteFormat := {
	_proto: @targetFrameFormat,
	symbol: 'cardfileRouteFormat,
	// The card as it is beamed or sent: without its birthday and anniversary
	// events, its notes unless the preference says to send them, and an owner
	// card as a plain person without its private data and e-mail passwords.
	SetupSlip: func(a1, fields) begin
		fields.body := DeepClone(a1.target);
		RemoveSlot(fields.body, 'bdayEvent);
		RemoveSlot(fields.body, 'anniversaryEvent);
		if (not GetRoot().cardfile:GetAppPreferences().beamNotes) then begin
				RemoveSlot(fields.body, 'notes)
			end;
		(if (a1.target.class = 'owner) then begin
				RemoveSlot(fields.body, 'owner);
				fields.body.labels := nil;
				fields.body.class := 'person;
				RemoveSlot(fields.body, 'emailPassword);
				(if fields.body.emailAddrs then (foreach item in fields.body.emailAddrs do begin
							if item.emailPassword then begin
									RemoveSlot(item, 'emailPassword)
								end
						end))
			end)
	end
};

