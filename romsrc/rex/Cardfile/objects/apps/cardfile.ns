// The Names application (its app symbol is 'cardfile, the name it had on the
// first Newtons): the base view of the Cardfile package, which the package's
// install script builds and puts in place of the built-in Names with
// OverrideBuiltinApp.  A newtApplication over the Names soup holding cards of
// the classes person, owner, company, group and worksite, each with its data
// definition (allDataDefs), its info views and business-card layouts
// (allViewDefs, the package's exports @8193-@8253), and the code the rest of
// the system calls on it: birthdays into the Date Book, owner (persona) cards,
// business-card data for the card layouts (bc...), custom fields and the
// paths of a card's data (GetInfoFrame, MakeDataPaths, GetNewPath).

cardfile := {
	// Sent to fit the application to the screen: new justification, bounds and
	// format, then the children rebuilt (syncing keeps the change from saving state).
	Resize: func(a1, a2, a3) begin
		viewJustify := a1;
		viewBounds := a2;
		syncing := true;
		SetValue(self, 'viewFormat, a3);
		syncing := nil;
		self:RedoChildren()
	end,
	prefsView: @8222,
	// The view definitions registered for each card class, by the view's symbol:
	// info views (address, phone, ...), business-card layouts (bizCard...), print
	// and route formats.
	allViewDefs: {
		cardfileOverviewPrint: {
			allCards: cfCardsFormat,
			allCardsNotes: @8194,
			summary: @8252,
			phoneBook: @8232,
			cardfileOverFrameFormat: {
				_proto: @targetFrameFormat,
				// Routing several names: a frame format whose title is "Selected Names".
				symbol: 'cardfileOverFrameFormat,
				title: "Selected Names",
				// The item's title is "Selected Names".
				SetupItem: func(fields, frame2) begin
					fields.title := title;
					inherited:SetupItem(fields, frame2)
				end
			}
		},
		person: {
			cfPhoneListFormat: @8232,
			bizCardDottedLine: @8202,
			address: @8193,
			bizCardSquiggle: @8207,
			cfSingleFormat: @8250,
			personal: @8230,
			cardfileRouteFormat: cardfileRouteFormat,
			bizCardCross: @8201,
			email: @8220,
			allinfo: @8195,
			default: @8231,
			cfAllFieldsFormat: @8252,
			custom: @8217,
			bizCardBulletLine: @8200,
			inboxCard: @8208,
			name: @8224,
			phone: @8233,
			company: @8213,
			cfCardsFormat: cfCardsFormat,
			bizCardPlain: @8205,
			bizCardSeparate: @8206,
			cfCardsNNotesFormat: @8194,
			pager: @8228,
			style: @8251,
			bizCardBulletHoles: @8199,
			notes: @8225
		},
		owner: {
			cfPhoneListFormat: @8232,
			creditCard: @8216,
			address: @8193,
			cfSingleFormat: @8250,
			personal: @8230,
			cardfileRouteFormat: cardfileRouteFormat,
			signature: @8249,
			email: @8220,
			allinfo: @8195,
			default: @8231,
			cfAllFieldsFormat: @8252,
			custom: @8217,
			inboxCard: @8208,
			name: @8224,
			phone: @8233,
			company: @8213,
			cfCardsFormat: cfCardsFormat,
			cfCardsNNotesFormat: @8194,
			pager: @8228,
			style: @8251,
			notes: @8225,
			bizCardOwner: @8204,
			bankAccount: @8197
		},
		company: {
			cfPhoneListFormat: @8232,
			bizCardDottedLine: @8202,
			address: @8193,
			bizCardSquiggle: @8207,
			cfSingleFormat: @8250,
			cardfileRouteFormat: cardfileRouteFormat,
			bizCardCross: @8201,
			email: @8220,
			allinfo: @8195,
			default: @8214,
			cfAllFieldsFormat: @8252,
			custom: @8217,
			bizCardBulletLine: @8200,
			inboxCard: @8208,
			name: {
				_proto: @8224,
				infoFrame: {
					checkPrefix: [|Array|: [pathExpr: 'name], [pathExpr: 'names]],
					checkPaths: [|Array|: 'honorific, 'first, 'last, 'title],
					format: format
				}
			},
			phone: @8233,
			cfCardsFormat: cfCardsFormat,
			bizCardPlain: @8205,
			bizCardSeparate: @8206,
			cfCardsNNotesFormat: @8194,
			style: @8251,
			bizCardBulletHoles: @8199,
			notes: @8225
		},
		group: {
			default: @8221,
			allinfo: @8195,
			notes: @8225,
			custom: @8217,
			cfSingleFormat: @8250,
			cfCardsFormat: cfCardsFormat,
			cfCardsNNotesFormat: @8194,
			cfAllFieldsFormat: @8252,
			cfPhoneListFormat: @8232,
			inboxCard: @8208,
			bizCardGroup: @8203,
			cardfileRouteFormat: cardfileRouteFormat
		},
		worksite: {
			default: @8253,
			allinfo: @8195,
			Connection: @8215,
			accessNumbers: @8223,
			notes: @8225,
			custom: @8217,
			cfSingleFormat: @8250,
			cfCardsFormat: cfCardsFormat,
			cfCardsNNotesFormat: @8194,
			cfAllFieldsFormat: @8252,
			cfPhoneListFormat: @8232,
			inboxCard: @8208,
			bizCardWorksite: @8209,
			cardfileRouteFormat: cardfileRouteFormat
		}
	},
	// The business-card layout for a card (target): the class's bizcard view whose
	// bizCardNum is the card's cardType, else the first bizcard view, else the
	// 'noBizCard view.  Returns {slot: its symbol, layout: the view}.
	GetBCLayout: func(target) begin
		key2 := nil;
		if target.class then begin
				class2 := target.class
			end else begin
				class2 := 'person
			end;
		if (viewDefs := GetViewDefs(class2)) then begin
				local key;
				local value;
				local key2;
				local class2;
				local noBizCard;
				local viewDefs;
				(foreach key, value in GetViewDefs(class2) do begin
						if (if (not key2) then (value.type = 'bizcard)) then begin
								key2 := key
							end;
						if (if (value.type = 'bizcard) then (value.bizCardNum = target.cardType)) then begin
								key2 := key;
								break
							end
					end)
			end;
		(if (not key2) then begin
				(noBizCard := GetDataView(class2, 'noBizCard)).type := 'bizcard;
				{slot: 'noBizCard, layout: noBizCard}
			end else {slot: key2, layout: viewDefs.(key2)})
	end,
	superSymbol: 'names,
	// After the view opens: offers to put new birthdays into the Date Book.
	viewSetupDoneScript: func() begin
		if (if (if newBdays then (superSymbol = 'names)) then ((newBdays = true) or (Length(newBdays) > 0))) then begin
				GetRoot():Confirm(@cardfileSoupName, "There are new birthdays in Names.  Do you want to add them to the Date Book?", self, 'AddNewBdays)
			end;
		inherited:?viewSetupDoneScript()
	end,
	// Collects data for a business card: from card a1 (the current owner when nil;
	// a group's members each in turn), the values of the slots named in a3 (arrays,
	// such as phones or addresses) whose class is one of a2 - or, when a4 names
	// slots, those sub-frames whose a4[0] slot has such a class (and the card's own
	// a4 slots, cloned into a frame).  Returns an array, or nil when nothing is found.
	bcHelper: func(a1, a2, a3, a4) begin
		local v10_xxxxxxxxxxxwwwwwwww, v13_wwwvvvvvvvvvvvvvvvv, v14_uuuuuuuuuutt, v15_uttttttttttt, v16_ttttssssssss, v17_zzzzzzzzzzzzzzzzzzzzyy, v20_iiihh;
		v10_xxxxxxxxxxxwwwwwwww := [Array: ];
		v15_uttttttttttt := a1;
		v13_wwwvvvvvvvvvvvvvvvv := a2;
		if (not v15_uttttttttttt) then begin
				v15_uttttttttttt := UserConfiguration.currentPersona
			end;
		if IsEntryAlias(v15_uttttttttttt) then begin
				v15_uttttttttttt := ResolveEntryAlias(v15_uttttttttttt)
			end;
		if v15_uttttttttttt then begin
				if (v15_uttttttttttt.class = 'group) then begin
						(foreach v22_yyyyyyyyyyyyxxx in v15_uttttttttttt.members do begin
								if (v16_ttttssssssss := self:bcHelper(v22_yyyyyyyyyyyyxxx._alias, v13_wwwvvvvvvvvvvvvvvvv, a3, a4)) then begin
										ArrayMunger(v10_xxxxxxxxxxxwwwwwwww, Length(v10_xxxxxxxxxxxwwwwwwww), 0, v16_ttttssssssss, 0, nil)
									end
							end)
					end else begin
						if (not IsArray(v13_wwwvvvvvvvvvvvvvvvv)) then begin
								v13_wwwvvvvvvvvvvvvvvvv := [Array: v13_wwwvvvvvvvvvvvvvvvv]
							end;
						if a4 then begin
								if v15_uttttttttttt.(a4[0]) then begin
										v17_zzzzzzzzzzzzzzzzzzzzyy := (foreach v12_wwwwwwwwwwwwvvvvvvv in v13_wwwvvvvvvvvvvvvvvvv do begin
												if IsInstance(v15_uttttttttttt.(a4[0]), v12_wwwwwwwwwwwwvvvvvvv) then begin
														break true
													end
											end);
										if v17_zzzzzzzzzzzzzzzzzzzzyy then begin
												v20_iiihh := {};
												(foreach v7_xxwwwwwwwwwwwwwwwwwwww in a4 do begin
														if v15_uttttttttttt.(v7_xxwwwwwwwwwwwwwwwwwwww) then begin
																v20_iiihh.(v7_xxwwwwwwwwwwwwwwwwwwww) := Clone(v15_uttttttttttt.(v7_xxwwwwwwwwwwwwwwwwwwww))
															end
													end);
												AddArraySlot(v10_xxxxxxxxxxxwwwwwwww, v20_iiihh)
											end
									end
							end;
						(foreach v9_qqqqqpppp in a3 do begin
								if v15_uttttttttttt.(v9_qqqqqpppp) then begin
										(foreach v19_iiihh in v15_uttttttttttt.(v9_qqqqqpppp) do begin
												if (v14_uuuuuuuuuutt := (if a4 then v19_iiihh.(a4[0]) else v19_iiihh)) then begin
														v17_zzzzzzzzzzzzzzzzzzzzyy := (foreach v12_wwwwwwwwwwwwvvvvvvv in v13_wwwvvvvvvvvvvvvvvvv do begin
																if IsInstance(v14_uuuuuuuuuutt, v12_wwwwwwwwwwwwvvvvvvv) then begin
																		break true
																	end
															end);
														if v17_zzzzzzzzzzzzzzzzzzzzyy then begin
																AddArraySlot(v10_xxxxxxxxxxxwwwwwwww, Clone(v19_iiihh))
															end
													end
											end)
									end
							end)
					end
			end;
		(if (Length(v10_xxxxxxxxxxxwwwwwwww) > 0) then v10_xxxxxxxxxxxwwwwwwww)
	end,
	// The card's custom fields as {value, label} frames: those named in a2 (all the
	// soup's 'customFields when nil), for card a1 (the owner when nil; a group's
	// members each in turn).
	bcCustomFields: func(a1, a2) begin
		l1 := [Array: ];
		l2 := a1;
		l3 := a2;
		if (not l2) then begin
				l2 := UserConfiguration.currentPersona
			end;
		if IsEntryAlias(l2) then begin
				l2 := ResolveEntryAlias(l2)
			end;
		if l2 then begin
				if (l2.class = 'group) then begin
						local l1;
						local l2;
						local l3;
						local l4;
						(foreach l5 in l2.members do begin
								if (l7 := self:bcCustomFields(l5, l3)) then begin
										ArrayMunger(l1, Length(l1), 0, l7, 0, nil)
									end
							end)
					end else begin
						if ((l8 := GetStores()[0]:GetSoup(@cardfileSoupName):GetInfo('customFields)) = nil) then begin
								return l1
							end;
						if (not l3) then begin
								local l7;
								local l8;
								l3 := (foreach l9, l10 in l8 collect l9)
							end else begin
								if (not IsArray(l3)) then begin
										l3 := [Array: l3]
									end
							end;
						(foreach l14 in l3 do begin
								if HasPath(l2, l14) then begin
										AddArraySlot(l1, {value: l2.(l14), label: l8.(l14).label})
									end
							end)
					end
			end;
		l1
	end,
	// The mail access entries of a worksite (currentEmporium) whose mailNetwork is
	// one of id (a symbol or an array of them), or nil when none.
	bcEmailNetwork: func(currentEmporium, id) begin
		list := [Array: ];
		if (not IsArray(id)) then begin
				id := [Array: id]
			end;
		if currentEmporium.mailAccess then begin
				local list;
				(foreach item in currentEmporium.mailAccess do begin
						if SetContains(id, item.mailNetwork) then begin
								AddArraySlot(list, Clone(item))
							end
					end)
			end;
		(if (Length(list) > 0) then list)
	end,
	// Where new data of the info view slot should go in card target: the view's
	// first path when it is empty there, else a path into its array (checkPrefix[1])
	// at the first element with no data, a new element being added when all have
	// some; nil when the view has no array.  (Called by AddCardData.)
	GetNewPath: func(target, slot) begin
		local dataPaths, checkPrefixItem2, infoFrame, l4, count, l6, checkPrefixItem;
		l4 := 0;
		l6 := nil;
		if (infoFrame := self:GetInfoFrame(slot, target.class)) then begin
				if (if (dataPaths := self:MakeDataPaths(infoFrame.checkPrefix[0], infoFrame.checkPaths, infoFrame.stringData)) then (not self:HasPathData(target, dataPaths, infoFrame.stringData))) then begin
						checkPrefixItem := infoFrame.checkPrefix[0]
					end else begin
						if (checkPrefixItem2 := infoFrame.checkPrefix[1]) then begin
								l4 := 0;
								if (not target.(checkPrefixItem2)) then begin
										target.(checkPrefixItem2) := [Array: ]
									end;
								count := Length(target.(checkPrefixItem2));
								(while (l4 < count) do begin
										AddArraySlot((newPath := Clone(infoFrame.checkPrefix[1])), l4);
										if (if (dataPaths := self:MakeDataPaths(newPath, infoFrame.checkPaths, infoFrame.stringData)) then (not self:HasPathData(target, dataPaths, infoFrame.stringData))) then begin
												break (l6 := true)
											end;
										(l4 := (l4 + 1))
									end);
								if (not l6) then begin
										if infoFrame.stringData then begin
												AddArraySlot(target.(infoFrame.checkPrefix[1]), "")
											end else begin
												AddArraySlot(target.(infoFrame.checkPrefix[1]), {})
											end
									end;
								AddArraySlot((checkPrefixItem := Clone(infoFrame.checkPrefix[1])), l4)
							end else begin
								checkPrefixItem := nil
							end
					end
			end;
		checkPrefixItem
	end,
	// Opens the application on the owner cards (ownerNames) at full size.
	DoOwnerOpen: func() begin
		superSymbol := 'ownerNames;
		RemoveSlot(self, 'viewBounds);
		RemoveSlot(self, 'viewJustify);
		self:Open()
	end,
	// The info views to show for a card: its data definition's viewsToDisplay plus
	// any other editor views registered for its class.
	kViewsToDisplay: func(a1) begin
		if (dataDefs := GetDataDefs(a1.class)) then begin
				copy := Clone(dataDefs.viewsToDisplay);
				local viewDefs;
				local copy;
				local dataDefs;
				(foreach key, value in (viewDefs := GetViewDefs(a1.class)) do begin
						if (if (value.type = 'editor) then (key <> 'default)) then begin
								SetAdd(copy, key, true)
							end
					end)
			end;
		copy
	end,
	// Undo of adding data: puts back the entry a2 (in a1's store) in place of a1.
	UndoAddData: func(a1, a2) begin
		local store;
		store := EntryStore(a1);
		layout:KillEntry(a1);
		layout:newEntry(a2, true, store);
		true
	end,
	// Opens the editor of the custom fields' labels (customEditor).
	EditCustomLabels: func() begin
		local context;
		(context := BuildContext(customEditor)).appBase := (context.newtAppBase := newtAppBase);
		context.customInfo := self:GetCustomInfo();
		newtAppBase:RememberedOpen(context)
	end,
	// True while Resize changes the view (so that changes are not saved).
	syncing: nil,
	// Adds to text a4 a line of card a1's data at path prefix a3, as the info
	// frame a2 formats it (its formatFunc or format string); a4 unchanged when the
	// data is empty.
	kTextDumper: func(a1, a2, a3, a4) begin
		if (dataPaths := GetRoot().cardfile:MakeDataPaths(a3, a2.checkPaths, a2.stringData)) then begin
				local dataPaths;
				local formatFunc;
				local l3;
				l3 := (foreach item in dataPaths collect a1.(item));
				if a2.formatFunc then begin
						formatFunc := a2:formatFunc(l3)
					end else begin
						formatFunc := ParamStr(a2.format, l3)
					end;
				TrimString(formatFunc)
			end;
		if (if formatFunc then StrFilled(formatFunc)) then begin
				if a4 then begin
						a4 := Stringer([Array: a4, "\n", formatFunc])
					end else begin
						a4 := formatFunc
					end
			end;
		a4
	end,
	// The answer to the new-birthdays Confirm slip (a1 true for yes): adds every
	// card's birthday (newBdays true) or the new ones' to the Date Book.
	AddNewBdays: func(a1) begin
		local newCursor, progressData;
		progressData := {barber: true, statusText: "Adding new birthdays to the Date Book.", primary: nil, closeBox: nil};
		if a1 then begin
				if (newBdays = true) then begin
						newCursor := self:GetBdayCursor();
						DoProgress('vBarber, progressData, func(a1) begin
							local entry;
							entry := newCursor:entry();
							(while entry do begin
									self:AddBdayToCalendar(entry, 'bday, 'bdayEvent, "Bday: ^0");
									entry := newCursor:Next();
									a1:UpdateIndicator(progressData)
								end)
						end)
					end else begin
						local resolveEntryAlias2;
						local l2;
						(foreach item in newBdays do begin
								if (resolveEntryAlias2 := ResolveEntryAlias(item.entry)) then begin
										self:AddBdayToCalendar(resolveEntryAlias2, 'bday, 'bdayEvent, "Bday: ^0")
									end
							end)
					end
			end;
		(newBdays := nil)
	end,
	// The slots of a card that are not its data.
	kDatalessSlots: {
		class: true,
		version: true,
		cardType: true,
		sorton: true,
		_uniqueID: true,
		_modTime: true,
		labels: true
	},
	// Sent when the application's button (or the Names icon) is tapped: puts the
	// template back to the package's form (dropping the scripts an owner-cards
	// open added) and closes or reopens the application; true when handled.
	buttonToggleScript: compile(
		constants: {
			kROM_8192: @8192
		},
		func(childViewFrame) begin
			(foreach item in '[Array: viewSetupFormScript, viewSetupChildrenScript, viewSetupDoneScript, viewQuitScript, viewShowScript, viewHideScript] do begin
					RemoveSlot(self, item)
				end);
			self._proto := kROM_8192;
			(if self.viewCObject then (if (self.superSymbol = 'ownerNames) then begin
						AddDeferredSend(self, 'Close, '[Array: ]);
						AddDeferredSend(self, 'Open, '[Array: ]);
						true
					end else (if (childViewFrame.appBase = self) then begin
							self:Toggle();
							true
						end else begin
							self:RememberedCloseAll();
							nil
						end)))
		end),
	// Takes the card's birthday (a meeting "Bday: <name>") out of the Date Book.
	RemoveBdayFromCalendar: func(target) begin
		local calendar, text, appointment;
		calendar := GetRoot().calendar;
		(if (appointment := calendar:FindAppointment((text := ParamStr("Bday: ^0", [Array: GetRoot():PrimaryName(target)])), nil, nil, '[Array: RepeatingMeeting, RepeatingEvent], 1)) then calendar:DeleteRepeatingEntry(text, appointment[0].mtgStartDate, true))
	end,
	// Puts the application back to the ordinary Names when it closes (an owner
	// open changed its symbol, title and help topic).
	viewQuitScript: func() begin
		local l1;
		inherited:?viewQuitScript();
		superSymbol := 'names;
		RemoveSlot(self, 'title);
		RemoveSlot(self, 'viewHelpTopic);
		'postQuit
	end,
	// The folder tab's text for all the cards.
	appAll: "All Names",
	// What the system's import and export (the custom fields) asks of the soup.
	CustomMetaData: {
		// The custom fields' definitions, by path, for import and export, with
		// CustomValidation to check them.
		GetExtensionFrame: func() begin
			(if (customInfo := GetRoot().cardfile:GetCustomInfo()) then begin
					frame2 := {};
					list := [Array: ];
					local customInfo;
					local frame2;
					local list;
					(foreach key, value in customInfo do begin
							frame2.(key) := Clone(value);
							frame2.(key).path := key;
							AddArraySlot(list, key)
						end);
					{FieldDefinitionsFrame: frame2, ImportExportArray: list, FunctionsFrame: {ValidateCustom: CustomValidation}, ValidateEntry: [Array: 'ValidateCustom]}
				end)
		end,
		// Makes each custom field of entry a1 a string of class string.custom.  Looks
		// like a ROM bug: a field that is not a string is removed by its index in the
		// list (RemoveSlot(a1, key)) rather than its name, and then made a string.
		CustomValidation: func(a1) begin
			local l1;
			local l2;
			(foreach key, value in (l2 := '[Array: custom1, custom2, custom3, custom4, custom5, custom6, custom7, custom8, custom9, custom10]) do begin
					if (l1 := a1.(value)) then begin
							if (not IsInstance(l1, 'string)) then begin
									RemoveSlot(a1, key)
								end;
							SetClass(l1, '|string.custom|)
						end
				end)
		end
	},
	hideSound: @drawerClose,
	// The info frame (checkPrefix, checkPaths, format...) of the view layout for a
	// card of class class2: the view's own infoFrame, else layoutDataMap's.
	GetInfoFrame: func(layout, class2) begin
		local infoFrame, l2;
		if ((not (l2 := GetViewDefs(class2).(layout))) or (not (infoFrame := l2.infoFrame))) then begin
				infoFrame := GetRoot().cardfile.layoutDataMap.(layout)
			end;
		infoFrame
	end,
	// A card's data as text (Find, routing): each of its views' data, a line each.
	// Looks like a ROM bug: the loop over an array runs to Length inclusive, one
	// past its last element (that path finds no data, so no harm is done).
	kGenericTextFunc: func(a1) begin
		local infoFrame;
		local copy;
		local l3;
		local l4;
		(foreach item in call GetRoot().cardfile.kViewsToDisplay with (a1) do begin
				infoFrame := GetRoot().cardfile:GetInfoFrame(item, a1.class);
				l3 := call GetRoot().cardfile.kTextDumper with (a1, infoFrame, infoFrame.checkPrefix[0], l3);
				if (if infoFrame.checkPrefix[1] then (l4 := a1.(infoFrame.checkPrefix[1]))) then begin
						(for i := 0 to Length(l4) do begin
								AddArraySlot((copy := Clone(infoFrame.checkPrefix[1])), i);
								l3 := call GetRoot().cardfile.kTextDumper with (a1, infoFrame, copy, l3)
							end)
					end
			end);
		l3
	end,
	// The key commands: + adds a card (_addKeyScript).
	allKeyCommands: [|Array|:
		[|Array|:
