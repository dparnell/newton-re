// part, and what only it reaches

part := array(nil, {
	installScript: compile(
		constants: {
			kFunction_720809: func(a1, a2, a3, a4) begin
				GetRoot().cardfile:NewtSoupChangedNotify(a1, a2, a3, a4)
			end
		},
		func(partFrame) begin
			local namesSoup;
			local theForm, context, copy, frame2;
			theForm := partFrame.partData.theForm;
			(frame2 := {}).(EnsureInternal('theStuff)) := theForm:NewtInstallScript(theForm);
			frame2.(EnsureInternal('appSymbol)) := theForm.appSymbol;
			context := BuildContext(theForm);
			OverrideBuiltinApp('cardfile, context);
			namesSoup := theForm.allSoups.names;
			frame2.(EnsureInternal('soupName)) := namesSoup.soupName;
			if (not GetStores()[0]:HasSoup(namesSoup.soupName)) then begin
					copy := Clone(namesSoup);
					copy:MakeSoup(theForm.appSymbol);
					copy:AddWalletEntries()
				end;
			RegSoupChange(namesSoup.soupName, theForm.appSymbol, kFunction_720809);
			RegSoupRestore(theForm.appSymbol, func(a1) begin
				local cardfile, l2;
				(if BFetch(a1, namesSoup.soupName, '|str<|, nil) then begin
						if (l2 := (cardfile := GetRoot().cardfile).allSoups.names).theSoup then begin
								l2.theSoup := nil
							end;
						cardfile:CheckAllBdays()
					end)
			end);
			frame2
		end),
	removeScript: func(partFrame) begin
		UnRegSoupChange(partFrame.soupName, partFrame.appSymbol);
		UnRegUnionSoup(partFrame.soupName, partFrame.appSymbol);
		call partFrame.theStuff.NewtRemoveScript with (partFrame.theStuff);
		nil
	end,
