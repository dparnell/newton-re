// The status slip shown while cards are being exchanged by beaming (@8198):
// "Exchanging cards" with a barber pole.

export6 := {
	initialSetup: {
		name: 'vBarber,
		values: {statusText: "Exchanging cards", barber: true, closeBox: nil},
		appSymbol: 'cardfile
	},
	// Stop: cancels the beam and closes the slip.
	CancelRequest: func(symbol2) begin
		beamer:Cancel();
		base:Close();
		(GetRoot().cardfile.barber := nil)
	end,
	// Keeps the barber pole turning, every half second.
	viewIdleScript: func() begin
		self:UpdateIndicator(initialSetup);
		500
	end,
	_proto: @protoStatusTemplate
};
