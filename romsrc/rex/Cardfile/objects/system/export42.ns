	viewJustify: vjRightH + vjParentFullH + vjParentBottomV,
	layouts: layouts_4,
	viewFont: tsFancy + tsSize(10),
	phoneLeft: nil,
	AddAllInfoItem: func(a1, checkPrefixItem, shapeArray, hitArray, a5, a6, a7, a8, a9, frame2) begin
		local count, l2;
		if phoneLeft then begin
				frame2.leftInfo := phoneLeft
			end else begin
				if (frame2.justification = 'right) then begin
						(a8 := Clone(a8)).right := (a8.right - 25)
					end
			end;
		l2 := inherited:?AddAllInfoItem(a1, checkPrefixItem, shapeArray, hitArray, a5, a6, a7, a8, a9, frame2);
		if (not phoneLeft) then begin
				if ((count := Length(hitArray)) > 0) then begin
						phoneLeft := hitArray[(count - 1)].misc.bbox.left
					end
			end;
		l2
	end,
	showMultipleData: true,
