// The Bank Account edit view of an owner card (@8197): bank name, account
// number, contact number and routing number, elements of owner.bankAccounts.

bankAccount := {
	type: 'editor,
	symbol: 'bankAccount,
	stepChildren: [|Array|: bank, acct, bankAccountItem],
	name: "Bank Account",
	// Drawn as "Bank: ...\nBank Acct: ..." with the contact phone number below.
	infoFrame: {
		_proto: infoFrameProto_2,
		checkPrefix: [|Array|: nil, [pathExpr: 'owner, 'bankAccounts]],
		checkPaths: [|Array|: 'bankContactNum, 'bankAcctNum, 'bankName],
		formatFunc: func(v20_wwwwwwwwwwvvvvvv) begin
			ParamStr("^?0Bank: ^0\n||^?1Bank Acct: ^1||", [Array: v20_wwwwwwwwwwvvvvvv[2], v20_wwwwwwwwwwvvvvvv[1]])
		end
	},
	protection: 'private,
	fieldOrder: [|Array|: 0, 1, 2],
	_proto: @8240,
	bankName: nil,
	stepAllocateContext: [|Array|:
		'bankName,
		bank,
		'bankAcctNum,
		acct,
		'bankContactNum,
		bankAccountItem,
		'BLZ,
		{
			path: nil,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 40},
			viewLineSpacing: 32,
			flavor: @newtCustomFilter,
			label: "Routing #",
			newRecFlags: vVisible + vClickable + vGesturesAllowed + vNumbersAllowed,
			addPath: 'BLZ,
			_proto: @newtLabelInputLine,
			preAllocatedContext: 'BLZ
		}
	],
	bankAcctNum: nil,
	bankContactNum: nil,
	BLZ: nil
};

bank := {
	path: nil,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 40},
	viewLineSpacing: 32,
	label: "Bank",
	addPath: 'bankName,
	_proto: @newtLabelInputLine,
	preAllocatedContext: 'bankName
};

acct := {
	path: nil,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 40},
	viewLineSpacing: 32,
	flavor: @newtCustomFilter,
	label: "Acct #",
	newRecFlags: vVisible + vClickable + vGesturesAllowed + vNumbersAllowed,
	addPath: 'bankAcctNum,
	_proto: @newtLabelInputLine,
	preAllocatedContext: 'bankAcctNum
};

bankAccountItem := {path: nil, addPath: 'bankContactNum, _proto: defaultProto, preAllocatedContext: 'bankContactNum};
