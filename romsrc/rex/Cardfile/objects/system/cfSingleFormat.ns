// cfSingleFormat, and what only it reaches

cfSingleFormat := {
	routingType: 'Print,
	type: 'printFormat,
	name: singleCard,
	title: singleCard,
	symbol: 'cfSingleFormat,
	viewSetupChildrenScript: func() begin
		self.stepChildren := [Array: GetRoot().cardfile:GetBCLayout(target).layout];
		inherited:viewSetupChildrenScript()
	end,
	SetupItem: func(fields, frame2) begin
		fields.title := nil;
		inherited:SetupItem(fields, frame2)
	end,
	_proto: @protoPrintFormat
};

singleCard := "Single Card";
