// export51, and what only it reaches

export51 := {
	viewSetupChildrenScript: func() begin
		local copy;
		inherited:viewSetupChildrenScript();
		(copy := Clone(viewBounds)).right := ((indent + copy.left) + self:GetMaxTextWidth());
		SetValue(self, 'viewBounds, copy)
	end,
	viewFormat: vfFillWhite + vfPen(1),
	indent: 0,
	_proto: @8242
};
