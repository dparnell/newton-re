// A left-aligned version of the text-lines view @8242 (@8243): sized to its
// widest line, from its left edge plus indent.

export51 := {
	// Once the lines are made, moves the right edge to the widest line's width.
	viewSetupChildrenScript: func() begin
		local copy;
		inherited:viewSetupChildrenScript();
		(copy := Clone(viewBounds)).right := ((indent + copy.left) + self:GetMaxTextWidth());
		SetValue(self, 'viewBounds, copy)
	end,
	viewFormat: vfFillWhite + vfPen(1),
	indent: 0,
	_proto: @8242
};
