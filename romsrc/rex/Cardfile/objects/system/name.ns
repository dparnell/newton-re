// The Name edit view (@8224): first and last name and honorific, and the
// affiliation of a person (Spouse, Child...) or the title of a company's
// contact - for a company card an element of its names array.  The reading
// field is allocated but not among the children (for a localised ROM).

name := {
	stepChildren: [|Array|: nameItem, nameItem_2, nameItem_3],
	name: affiliate,
	symbol: 'name,
	type: 'editor,
	infoFrame: {
		// A card's names: the name frame, or for a company an element of 'names.
		checkPrefix: [|Array|: nil, [pathExpr: 'names]],
		checkPaths: [|Array|: 'honorific, 'first, 'last, 'title],
		format: format
	},
	// Adds the title line for a company card, the affiliation line for others.
	viewSetupChildrenScript: func() begin
		stepChildren := Clone(stepChildren);
		if (target.class = 'company) then begin
				AddArraySlot(stepChildren, title)
			end else begin
				AddArraySlot(stepChildren, affiliate)
			end;
		inherited:?viewSetupChildrenScript()
	end,
	protection: 'private,
	fieldOrder: [|Array|: 0, 1, 2],
	nameByClass: {person: affiliate, company: affiliate},
	_proto: @8240,
	first: nil,
	stepAllocateContext: [|Array|:
		'first,
		nameItem,
		'last,
		nameItem_2,
		'honorific,
		nameItem_3,
		'affiliate,
		{
			path: nil,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 40},
			viewLineSpacing: 32,
			label: "Affiliation",
			labelCommands: [|Array|: "Spouse", "Child", "Relative", "Assistant"],
			addPath: 'title,
			memory: 'affiliation,
			flavor: @newtCustomFilter,
			newRecFlags: vVisible + vClickable + vGesturesAllowed + vCharsAllowed + vPunctuationAllowed + vCapsRequired,
			_proto: @newtLabelInputLine,
			preAllocatedContext: 'affiliate
		},
		'title,
		{addPath: 'title, memory: 'personTitle, _proto: @8248, preAllocatedContext: 'title},
		'reading,
		{
			path: nil,
			flavor: @newtCustomFilter,
			label: label,
			newDictionaries: newDictionaries,
			addPath: 'nameReading,
			// Only the card's own name (not an element of names) creates its slot when
			// written in.
			viewSetupFormScript: func() begin
				if (selectedPath <> true) then begin
						RemoveSlot(self, 'viewChangedScript)
					end;
				inherited:?viewSetupFormScript()
			end,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 67},
			viewLineSpacing: 30,
			_proto: addressItem_5Proto,
			preAllocatedContext: 'reading
		}
	],
	last: nil,
	honorific: nil,
	affiliate: nil,
	title: nil,
	reading: nil
};

// The first name line.
nameItem := {
	path: nil,
	flavor: @newtCustomFilter,
	label: first,
	newDictionaries: newDictionaries,
	addPath: 'first,
	// Only the card's own name (not an element of names) creates its slot when
	// written in.
	viewSetupFormScript: func() begin
		if (selectedPath <> true) then begin
				RemoveSlot(self, 'viewChangedScript)
			end;
		inherited:?viewSetupFormScript()
	end,
	_proto: addressItem_5Proto,
	preAllocatedContext: 'first
};

// The last name line.
nameItem_2 := {
	path: nil,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 40},
	viewLineSpacing: 32,
	flavor: @newtCustomFilter,
	label: last,
	newDictionaries: newDictionaries_2,
	memory: 'lastName,
	addPath: 'last,
	_proto: @newtLabelInputLine,
