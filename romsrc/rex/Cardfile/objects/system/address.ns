country := {
	path: nil,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 32},
	viewLineSpacing: 25,
	flavor: {
		_proto: @newtCountryFilter,
		Picker: func() begin
			if (if (if (not (country := (if StrFilled(target.country) then target.country))) then (addresses := target.addresses)) then ((count := Length(addresses)) > 0)) then begin
					local country;
					local addresses;
					local count;
					local countryEntry;
					(for i := 0 to (count - 1) do begin
							if (if addresses[i] then StrFilled(addresses[i].country)) then begin
									break (country := addresses[i].country)
								end
						end)
				end;
			if (not country) then begin
					country := UserConfiguration.currentCountry
				end;
			@locationPopup:new({default: (if (Length((countryEntry := GetCountryEntry(country))) > 0) then countryEntry[0]), spots: @countrySoupName, result: 'name}, self:GlobalLabelBounds(), self)
		end
	},
	label: "Country",
	addPath: 'country,
	Retarget: func() begin
		inherited:?Retarget();
		addressView:UpdateCountryInfo()
	end,
	_proto: @newtLabelInputLine,
	preAllocatedContext: 'country
};

