// The layout that shows one card at a time (@8247, a newtLayout over the Names
// soup): the card layouts (such as @8210) are made on it.  Scrolling goes to
// the next or previous card.

export55 := {
	viewBounds: {top: 21, left: 0, right: 0, bottom: -18},
	masterSoupSlot: 'names,
	forceNewEntry: nil,
	viewJustify: vjParentFullH + vjParentFullV,
	// Goes to the cursor's card (or the next or previous one when it was deleted,
	// or the first), giving an old card a class; a1 true rebuilds the card's view.
	Retarget: func(a1) begin
		local entry;
		if (((entry := dataCursor:entry()) = 'deleted) or (not entry)) then begin
				if (not (entry := dataCursor:Next())) then begin
						entry := dataCursor:Prev()
					end;
				if (not entry) then begin
						self:SetupCursor();
						entry := dataCursor:entry()
					end
			end;
		if (if entry then (not entry.class)) then begin
				if (ClassOf(entry.sorton) = 'name) then begin
						entry.class := 'person
					end else begin
						entry.class := 'company
					end
			end;
		target := dataCursor:entry();
		inherited:Retarget(nil);
		if a1 then begin
				entryView:?viewQuitScript();
				self:viewSetupChildrenScript();
				entryView:?viewSetupFormScript();
				entryView:RedoChildren();
				entryView:?viewSetupDoneScript()
			end;
		SetKeyView(self, 0)
	end,
	// The next card, with a scrolling effect.
	viewScrollDownScript: func() begin
		entryView:Effect(77725696, true, @flip, 'Scroller, [Array: 1])
	end,
	// The previous card, with a scrolling effect.
	viewScrollUpScript: func() begin
		entryView:Effect(77725696, nil, @flip, 'Scroller, [Array: -1])
	end,
	// Shows the current card.
	viewSetupFormScript: func() begin
		inherited:?viewSetupFormScript();
		self:Retarget(nil)
	end,
	// For owner cards, tells the views that follow the card (retargetChain) once
	// the layout is up.
	viewSetupDoneScript: func() begin
		(if (superSymbol = 'ownerNames) then AddDeferredCall(func() begin
				(if retargetChain then (foreach item in retargetChain do begin
							item:RetargetNotify()
						end))
			end, '[Array: ]))
	end,
	useTypeScrolling: true,
	// Typing goes to the card whose letter (A-Z tab) was typed.
	TypeScrollScript: func(keyString) begin
		local pickLetterScript;
		(if (pickLetterScript := azTabs:PickLetterScript(keyString)) then (if (pickLetterScript.newEntry <> pickLetterScript.currEntry) then self:Effect(133120, nil, @flip, 'Retarget, [Array: true]) else azTabs:RetargetNotify()))
	end,
	_proto: @newtLayout
};
