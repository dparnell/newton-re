// The All Info layout (@8195): every info view's data of the card, one after
// another (a text-lines view, @8242).

allinfo := {
	boldTitle: nil_2,
	layouts: nil,
	showBullet: true,
	showMultipleData: true,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	symbol: 'allinfo,
	type: 'viewer,
	// Works out (once per class) which views a card of the target's class shows;
	// shown at once outside the Names application.
	viewSetupFormScript: func() begin
		local l1, l2;
		(if (if target then target.class) then begin
				if (not layouts) then begin
						layouts := {}
					end;
				if (not layouts.(target.class)) then begin
						layouts.(target.class) := call GetRoot().cardfile.kViewsToDisplay with (target)
					end;
				(if (GetVariable(self, 'newtAppBase) <> GetRoot().cardfile) then (self.viewFlags := vVisible))
			end)
	end,
	protection: 'public,
	canScroll: true,
	name: allInfo_2,
	_proto: @8242
};
