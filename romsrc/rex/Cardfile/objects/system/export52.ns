// export52, and what only it reaches

export52 := {
	type: 'editor,
	viewQuitScript: func() begin
		local l1, l2, l3, l4;
		if (if self.phoneNum then (l2 := target.(path))) then begin
				l4 := ClassOf(l2);
				l2 := ParsePhone(l2).phone
			end;
		if self.areacode then begin
				l1 := (if (if (not StrFilled(l2)) then (not areacode.changed)) then nil else TrimString(areacode.entryLine:GetRichString()))
			end;
		l3 := (if self.extension then TrimString(extension.entryLine:GetRichString()));
		savePhoneNum := MakePhone({areacode: l1, phone: l2, extension: l3});
		if (if l4 then StrFilled(savePhoneNum)) then begin
				SetClass(savePhoneNum, l4)
			end else begin
				savePhoneNum := nil
			end;
		'postQuit
	end,
	viewSetupFormScript: func() begin
		if StrFilled(target.(path)) then begin
				l1 := ParsePhone(target.(path));
				if self.areacode then begin
						areacode.text := l1.areacode
					end;
				if self.phoneNum then begin
						phoneNum.text := l1.phone
					end;
				if self.extension then begin
						extension.text := l1.extension
					end
			end else begin
				if self.areacode then begin
						if (if (l5 := target.phones) then ((l4 := Length(l5)) > 0)) then begin
								local l1;
								local l2;
								local l3;
								local l4;
								local l5;
								(for l3 := 0 to (l4 - 1) do begin
										if (if (if l5[l3] then (l1 := ParsePhone(l5[l3]))) then l1.areacode) then begin
												break (l2 := l1.areacode)
											end
									end)
							end;
						if (not l2) then begin
								l2 := UserConfiguration.currentAreaCode
							end;
						if l2 then begin
								areacode.text := Clone(l2)
							end;
						hiliteAreaCode := true
					end
			end;
		inherited:?viewSetupFormScript()
	end,
	viewFlags: vVisible,
	viewFormat: nil,
	viewJustify: vjParentFullH + vjParentFullV,
	path: nil,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	protection: 'private,
	hiliteAreaCode: nil,
	usePhoneKeys: true,
	viewPostQuitScript: func() begin
		target.(path) := savePhoneNum;
		targetView:StartFlush()
	end,
	savePhoneNum: nil,
	viewClass: clView
};
