// export4, and what only it reaches

export4 := {
	name: allInfo_2,
	stepChildren: [stepChildren:
		export4Item,
		{
			viewBounds: {top: -2, left: 0, right: 0, bottom: 0},
			viewJustify: vjParentFullH + vjParentBottomV + vjSiblingBottomV,
			_proto: @protoBorder
		},
		export4Item_2,
		export4Item_3
	],
	allinfoHeight: 0,
	childBottom: 0,
	childToScroll: nil,
	ViewScroll2DScript: func(arrowDirection, a2) begin
		local viewOriginY, l2, most;
		viewOriginY := childToScroll.viewOriginY;
		l2 := (max(a2.count, 1) * 16);
		if (if (arrowDirection = 'up) then (viewOriginY > 0)) then begin
				most := max(0, (viewOriginY - l2))
			end else begin
				if ((viewOriginY + allinfoHeight) < childBottom) then begin
						most := min((childBottom - allinfoHeight), (viewOriginY + l2))
					end
			end;
		(if most then begin
				childToScroll:SetOrigin(0, most);
				scrollArrows.yPos := most;
				scrollArrows:AdjustArrows();
				RefreshViews()
			end)
	end,
	viewSetupFormScript: func() begin
		if (superSymbol = 'ownerNames) then begin
				if IsReadOnly(stepChildren) then begin
						stepChildren := Clone(stepChildren)
					end;
				ArrayMunger(stepChildren, 0, 2, nil, 0, 0)
			end;
		inherited:?viewSetupFormScript()
	end,
	_proto: @8247,
	azTabs: nil,
	stepAllocateContext: [|Array|: 'azTabs, export4Item, 'scrollArrows, export4Item_2, 'entryView, export4Item_3],
	scrollArrows: nil,
	entryView: nil
};

export4Item := {_proto: @8235, preAllocatedContext: 'azTabs};

export4Item_2 := {viewClass: clView, _proto: @protoUpDownScroller, preAllocatedContext: 'scrollArrows};

export4Item_3 := {
	viewBounds: {top: 20, left: 0, right: -20, bottom: 0},
	viewSetupChildrenScript: func() begin
		local viewDefs;
		if (if (if (if target then IsSoupEntry(target)) then (viewDefs := GetViewDefs(target.class))) then viewDefs.allinfo) then begin
				self.stepChildren := [Array: viewDefs.allinfo]
			end;
		inherited:?viewSetupChildrenScript()
	end,
	viewJustify: vjParentFullH + vjParentFullV,
	viewSetupFormScript: func() begin
		if (superSymbol = 'ownerNames) then begin
				if IsReadOnly(viewBounds) then begin
						viewBounds := Clone(viewBounds)
					end;
				viewBounds.top := 0
			end;
		inherited:?viewSetupFormScript()
	end,
	viewFlags: vVisible + vClipping,
	viewSetupDoneScript: func() begin
		local l1, childViewFrames;
		inherited:?viewSetupDoneScript();
		if (if (childViewFrames := self:ChildViewFrames()) then (Length(childViewFrames) > 0)) then begin
				allinfoHeight := ((l1 := (childToScroll := childViewFrames[0]):GlobalBox()).bottom - l1.top);
				childBottom := childToScroll:GetBottom()
			end;
		(if (childBottom <= allinfoHeight) then (if scrollArrows.viewCObject then scrollArrows:Hide()) else begin
				scrollArrows.scrollRect := (scrollArrows.dataRect := SetBounds(0, 0, 0, childBottom));
				scrollArrows.viewRect := SetBounds(0, 0, 0, allinfoHeight);
				scrollArrows.yPos := 0;
				if scrollArrows.viewCObject then begin
						scrollArrows:Show()
					end else begin
						scrollArrows:Open()
					end;
				scrollArrows:AdjustArrows()
			end)
	end,
	_proto: @newtEntryView,
	preAllocatedContext: 'entryView
};
