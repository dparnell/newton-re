	],
	allinfoHeight: 0,
	childBottom: 0,
	childToScroll: nil,
	ViewScroll2DScript: func(a1, a2) begin
		local l1, l2, l3;
		l1 := childToScroll.viewOriginY;
		l2 := (max(a2.count, 1) * 16);
		if (if (a1 = 'up) then (l1 > 0)) then begin
				l3 := max(0, (l1 - l2))
			end else begin
				if ((l1 + allinfoHeight) < childBottom) then begin
						l3 := min((childBottom - allinfoHeight), (l1 + l2))
					end
			end;
		(if l3 then begin
				childToScroll:SetOrigin(0, l3);
				scrollArrows.yPos := l3;
				scrollArrows:AdjustArrows();
				RefreshViews()
			end)
	end,
	viewSetupFormScript: func() begin
		if (superSymbol = 'ownerNames) then begin
				if IsReadOnly(stepChildren) then begin
						stepChildren := Clone(stepChildren)
					end;
				ArrayMunger(stepChildren, 0, 2, nil, 0, 0)
			end;
