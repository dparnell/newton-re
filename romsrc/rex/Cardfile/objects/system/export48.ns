// export48, and what only it reaches

export48 := {
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	viewSetupChildrenScript: func() begin
		(if selectedPath then begin
				l3 := (Length(stepAllocateContext) - 1);
				local l1;
				local l2;
				local l3;
				(for i := 0 to l3 by 2 do begin
						(l1 := self.(stepAllocateContext[i])).path := self:MakeDataPaths(selectedPath, [Array: l1.addPath], nil)[0]
					end)
			end)
	end,
	viewFlags: vVisible,
	viewFormat: nil,
	fieldOrder: nil,
	viewClass: clView
};
