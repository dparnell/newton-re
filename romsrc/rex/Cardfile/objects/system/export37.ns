// The slip that sets a password kept in a card (@8229), such as an email
// password: a passwordSlip that stores what is written into the card's path.

export37 := {
	// Keeps the password in the card.
	SetPassword: func(realText) begin
		(if target then begin
				target.(path) := realText;
				EntryChange(target)
			end)
	end,
	VerifyPassword: nil,
	requirePassword: true,
	viewJustify: vjParentCenterH + vjParentCenterV,
	// Positions the slip at the top of its parent.
	viewSetupFormScript: func() begin
		local viewBounds;
		inherited:viewSetupFormScript();
		viewBounds := self.viewBounds;
		(self.viewBounds := SetBounds(viewBounds.left, 0, viewBounds.right, (viewBounds.bottom - viewBounds.top)))
	end,
	_proto: @passwordSlip
};
