aboutViewText := "";

internetSetups := "Internet Setups";

start := {data: "Get Started\u000d", layout: 2080, name: "start"};

listItem := {data: "Determine how to connect", viewFont: viewFont, layout: 32, name: determine};

viewFont := {family: 'espy, face: 1, size: 10};

determine := "determine";

blocksItem := {
	data: "Choose one of the following:\u000d• Ethernet to connect to an Ethernet network for Internet access\u000d• LocalTalk to use a LocalTalk cable to connect to an AppleTalk network bridged to a TCP/IP network and a MacIP server\u000d• Modem to use a Newton-compatible modem to connect to the Internet\u000d• Serial to use a serial cable to connect to a computer that’s connected to the Internet\u000d",
	styles: [|Array|:
		31,
		viewFont_2,
		8,
		viewFont,
		57,
		viewFont_2,
		9,
		viewFont,
		110,
		viewFont_2,
		5,
		viewFont,
		63,
		viewFont_2,
		6,
		viewFont,
		82,
		viewFont_2
	]
};

viewFont_2 := {family: 'espy, face: 0, size: 10};

know := {data: "Know what I need", viewFont: viewFont, layout: 32, name: "know"};

blocksItem_2 := {
	data: "You can connect to the Internet using Ethernet, LocalTalk, modem, or serial connections.\u000dYou’ll need:\u000d• an account with an Internet Service Provider (ISP) or one set up through work or school, or access to a private company intranet\u000d• one or more Internet applications for your Newton device\u000d",
	viewFont: viewFont_2
};

gse := {data: "Get started using Ethernet", viewFont: viewFont, layout: 32, name: "gse"};

blocksItem_3 := {
	data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• an Ethernet PC card compatible with your Newton device\u000d• an Ethernet network\u000d",
	viewFont: viewFont_2
};

gsat := {data: "Get started using AppleTalk", viewFont: viewFont, layout: 32, name: "gsat"};

blocksItem_4 := {
	data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• a LocalTalk cable connected to an AppleTalk network bridged to a TCP/IP network and a Mac IP server\u000dOR\u000d•an Ethernet PC card connected to an EtherTalk network bridged to a TCP/IP network and a Mac IP server\u000d",
	viewFont: viewFont_2
};

gsm := {data: "Get started using a modem", viewFont: viewFont, layout: 32, name: "gsm"};

blocksItem_5 := {
	data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• an analog phone line or cellular telephone\u000d• an external modem or PC card modem compatible with your Newton device\u000d• a setup file for your modem \u000dSetups for some modems are included with your Newton device. Check with your modem manufacturer for more information.\u000d",
	viewFont: viewFont_2
};

gss := {data: "Get started using a serial connection", viewFont: viewFont, layout: 32, name: "gss"};

blocksItem_6 := {
	data: "For the basic requirements, see the subtopic “Know What I Need.”\u000d\u000dYou’ll also need\u000d• a serial cable to connect your Newton device to a computer connected to the Internet\u000d",
	viewFont: viewFont_2
};

gather := {data: "Gather information", viewFont: viewFont, layout: 32, name: "gather"};

blocksItem_7 := {
	data: "Get the necessary information from your ISP or network administrator: \u000d• IP addresses for your Newton device and your gateway, or router\u000d• a domain name\u000dYou may also need:\u000d• the subnet mask\u000d• your user ID and password\u000d• access telephone numbers\u000d• which link protocol to use—PPP or SLIP\u000d• an ISP template\u000d• steps in the login or logout script\u000d",
	viewFont: viewFont_2
};

create := {data: "Create an Internet Setup\u000d", layout: 2080, name: "create"};

new := {data: "Create a new Internet setup", viewFont: viewFont, layout: 32, name: "new"};

blocksItem_8 := {
	data: "An Internet setup is a collection of information you need to connect to the Internet via a network or an ISP. To create an Internet setup, you use a template—Generic Setup, SecurID, UNIX, or your ISP.\u000d1. Tap New.\u000d2. In the pop-up list, tap the desired template.\u000d",
	viewFont: viewFont_2
};

ethernet := {data: "Using Ethernet\u000d", layout: 2080, name: "ethernet"};

ethernet1 := {data: enterInformationOnSlip, viewFont: viewFont, layout: 32, name: "ethernet1"};

enterInformationOnSlip := "Enter Information on Slip 1";

blocksItem_9 := {
	data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Configuration—Manual or DHCP Server\u000d• Card—the type of Ethernet PC card you’re using\u000d",
	viewFont: viewFont_2
};

ethernet2 := {data: enterInformationOnSlip_2, viewFont: viewFont, layout: 32, name: "ethernet2"};

enterInformationOnSlip_2 := "Enter Information on Slip 2";

blocksItem_10 := {
	data: "• Local IP Address—a numeric address for your Newton device\u000d• Subnet Mask—identifies the subnetwork\u000d• Gateway/Router Address—a numeric address for the gateway that directs information to/from your Newton device\u000d• Primary DNS/Name Server Address— identifies the computer that contains a list of IP addresses and their associated names\u000d• Domain Name—an alphabetic address for the network you’re connected to\u000d",
	viewFont: viewFont_2
};

atalk := {data: "Using LocalTalk\u000d ", layout: 2080, name: "atalk"};

atalk1 := {data: enterInformationOnSlip, viewFont: viewFont, layout: 32, name: "atalk1"};

blocksItem_11 := {
	data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Configuration—Manual or MacIP Server\u000d• Zone—the AppleTalk zone that contains the MacIP server (or router) you are connecting to\u000d",
	viewFont: viewFont_2
};

listItem_2 := {data: enterInformationOnSlip_2, viewFont: viewFont, layout: 32, name: enterinfo};

enterinfo := "enterinfo";

blocksItem_12 := {
	data: "• Local IP Address—a numeric address for your Newton device \u000d• Gateway/Router Address—a numeric address for the gateway that directs information to/from your Newton device\u000d• Primary DNS/Name Server Address— identifies the computer that contains a list of IP addresses and associated names\u000d• Domain Name—an alphabetic address for the network you’re connected to\u000d",
	viewFont: viewFont_2
};

modem := {data: "Using a modem", layout: 2080, name: "modem"};

modem1 := {data: enterInformationOnSlip, viewFont: viewFont, layout: 32, name: "modem1"};

blocksItem_13 := {
	data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Protocol—Point-to-Point or Serial Line Interface Protocol\u000d• Configuration—Manual or Server\u000d• Access Number—the telephone number you use to connect\u000d• User ID—your user or login name\u000d• Set/Edit Password—your user password\u000d• When closing, disconnect—the time until the connection is dropped after you close an Internet application\u000d ",
	viewFont: viewFont_2
};

listItem_3 := {data: enterInformationOnSlip_2, viewFont: viewFont, layout: 32, name: enterinfo};

blocksItem_14 := {data: localIPAddressA, viewFont: viewFont_2};

localIPAddressA := "• Local IP Address—a numeric address for your Newton device\u000d• Gateway/Router Address—a numeric address for the gateway that directs information to/from your Newton device\u000d• Primary DNS/Name Server Address— identifies the computer that contains a list of IP addresses and associated names\u000d• Domain Name—an alphabetic address for the network you’re connected to\u000d";

listItem_4 := {data: "Add or edit modem settings", viewFont: viewFont, layout: 32, name: modemsettings};

modemsettings := "modemsettings";

blocksItem_15 := {
	data: "1. Go to the desired setup.\u000d2. Do one of the following:\u000d• Tap Add, then tap Modem Settings.\u000d• Tap Modem Settings.\u000d3. Enter settings for your modem. See the documentation that came with your modem or contact your modem manufacturer.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

serial := {data: "Using a serial connection\u000d", layout: 2080, name: "serial"};

serial1 := {data: enterInformationOnSlip, viewFont: viewFont, layout: 32, name: "serial1"};

blocksItem_16 := {
	data: "• Setup Name—name for this setup, such as Work, Home, School, Field Office\u000d• Protocol—Point-to-Point or Serial Line Interface Protocol\u000d• Configuration—Manual or Server\u000d• User ID—your user or login name\u000d• Set/Edit Password—your user password\u000d• When closing, disconnect—the time until the connection is dropped after you close an Internet application\u000d",
	viewFont: viewFont_2
};

listItem_5 := {data: enterInformationOnSlip_2, viewFont: viewFont, layout: 32, name: enterinfo};

blocksItem_17 := {data: localIPAddressA, viewFont: viewFont_2};

add := {data: "Add Information to a Setup\u000d", layout: 2080, name: "add"};

addinfo := {data: "Add information", viewFont: viewFont, layout: 32, name: "addinfo"};

blocksItem_18 := {
	data: "You can add information to an existing setup. \u000d1. Go to the desired setup.\u000d2. Tap Add and in the pop-up list, tap your choice.\u000d3. In the slip, enter the new information.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

accessno := {data: "Add alternate access numbers", viewFont: viewFont, layout: 32, name: "accessno"};

blocksItem_19 := {
	data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Alternate Access Number.\u000d3. Enter the number.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

listItem_6 := {data: "Add DNS/Name server addresses", viewFont: viewFont, layout: 32, name: dns};

dns := "dns";

blocksItem_20 := {
	data: "1. Go to the desired setup.\u000d2. Tap Add, then tap DNS/Name Server Address.\u000d3. Enter the address.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

script := {
	data: "Add a login/logout script\u000d",
	styles: [|Array|: 26, viewFont, 1, viewFont_2],
	layout: 32,
	name: "script"
};

steps := {data: "Determine the script steps", viewFont: viewFont, layout: 32, name: "steps"};

blocksItem_21 := {
	data: "If your ISP doesn’t use PAP or CHAP authentication, you need to enter a login script. You may also need a logout script.\u000d\u000dTo determine the steps for scripts, contact your ISP. Or, use a terminal emulator program on your Newton device or your computer to log into the host, noting the steps you take to log in and log out. \u000d",
	viewFont: viewFont_2
};

addscript := {data: "Create a login/logout script", viewFont: viewFont, layout: 32, name: "addscript"};

blocksItem_22 := {
	data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Login Script or Logout Script.\u000d3. Tap Done, then tap the first command. \u000d4. Continue choosing commands until the script is completed. Leave the final “Done.”\u000d5. Tap Timeout, then tap your choice.\u000d6. If you want, tap the checkbox next to “Display script activity.”\u000d",
	viewFont: viewFont_2
};

listItem_7 := {data: "Add modem settings", viewFont: viewFont, layout: 32, name: modemsettings};

blocksItem_23 := {
	data: "You can add modem settings to a particular Internet setup. When you use this setup, it overrides the modem settings in Prefs.\u000d1. Go to the desired setup.\u000d2. Tap Add, then tap Modem Settings.\u000d3. Enter the appropriate settings. \u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

discodelay := {data: "Add a disconnect delay", viewFont: viewFont, layout: 32, name: "discodelay"};

blocksItem_24 := {
	data: "You can set a disconnect delay if you want to wait a specified time before disconnecting from the Internet, after you close Internet applications.\u000d1. Go to the desired setup.\u000d2. Tap Add, then tap Disconnect Delay.\u000d3. Tap “When closing, disconnect,” then tap your choice.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

advanced := {data: "Add advanced serial settings", viewFont: viewFont, layout: 32, name: "advanced"};

blocksItem_25 := {
	data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Advanced Settings.\u000d3. Enter settings, then tap X.\u000d• Port—the port or card slot you’re using \u000d• Data Rate—speed of data transfer\u000d• Parity—error detection that appends a bit to each data byte\u000d• Stop Bits—one or more bits that signal the end of a byte\u000d• Use Hardware Flow Control—hardware signals that control data flow\u000d",
	viewFont: viewFont_2
};

redial := {data: "Add redial settings", viewFont: viewFont, layout: 32, name: "redial"};

blocksItem_26 := {
	data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Redial Settings.\u000d3. Enter your settings, then tap X.\u000d• Redial—specifies access numbers to redial\u000d• Try to redial—sets the number of times you want to redial \u000d• Wait before redialing—specifies the time before redialing\u000d",
	viewFont: viewFont_2
};

country := {data: "Add the country of my ISP", viewFont: viewFont, layout: 32, name: "country"};

blocksItem_27 := {
	data: "1. Go to the desired setup.\u000d2. Tap Add, then tap Country.\u000d3. Do one of the following:\u000d• Enter the country.\u000d• Tap Country, then tap the scroll arrows or tap a lettered tab to move through the list. Tap your country, then tap X. \u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

edit := {data: "Change Information\u000d", layout: 2080, name: "edit"};

editing := {data: "Change information in a setup ", viewFont: viewFont, layout: 32, name: "editing"};

blocksItem_28 := {
	data: "1. Go to the setup you want to change.\u000d2. Tap the item you want to edit.\u000d3. In the slip, enter the information.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

configuration := {data: "Change my configuration ", viewFont: viewFont, layout: 32, name: "configuration"};

blocksItem_29 := {
	data: "The configuration tells your Newton device how you are going to connect—manually, using information you enter, or via a server, which allows the server to send the settings.\u000d1. Go to the setup you want to change.\u000d2. Tap Configuration.\u000d3. Tap Configuration again, then tap your choice.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

subnet := {data: "Change the subnet mask", viewFont: viewFont, layout: 32, name: "subnet"};

blocksItem_30 := {
	data: "The subnet mask is a numeric address that identifies the subnetwork your device is connected to.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap Subnet Mask.\u000d3. Enter the new subnet mask.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

ipaddress := {data: "Change the local IP address", viewFont: viewFont, layout: 32, name: "ipaddress"};

blocksItem_31 := {
	data: "The local IP address is a numeric address that identifies your Newton device.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap Local IP Address.\u000d3. Enter the new address.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

gateway := {data: "Change the gateway/router address ", viewFont: viewFont, layout: 32, name: "gateway"};

blocksItem_32 := {
	data: "The gateway, or router, address is a numeric address that identifies the gateway that directs information to and from your Newton device.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap Gateway/Router Address.\u000d3. Enter the new address.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

listItem_8 := {data: "Change the name server addresses", viewFont: viewFont, layout: 32, name: dns};

blocksItem_33 := {
	data: "The DNS (Domain Name System)/Name server address identifies the computer that contains a list of IP addresses and names associated with those numeric addresses.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap the address you want to edit.\u000d3. Enter the new address.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

domain := {data: "Change the domain name", viewFont: viewFont, layout: 32, name: "domain"};

blocksItem_34 := {
	data: "The domain name is an alphabetic Internet address for the network you’re connected to.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap the domain name you want to edit.\u000d3. Enter the address.\u000d4. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

idpassword := {data: "Change my user ID or password", viewFont: viewFont, layout: 32, name: "idpassword"};

blocksItem_35 := {
	data: "Your user ID, also called your login name, and your password are provided by your ISP or network administrator.\u000d\u000d1. Go to the setup you want to change.\u000d2. Tap User ID.\u000d3. If necessary, enter your new user ID.\u000d4. If necessary, tap Set/Edit Password. Enter your password, press or tap the Tab key, then enter the password again. When you’re ready, tap Set.\u000d5. Tap X to close the slip.\u000d",
	viewFont: viewFont_2
};

use := {data: "Working with Internet Setups\u000d", layout: 2080, name: "use"};

view := {data: "View Internet setups ", viewFont: viewFont, layout: 32, name: "view"};

blocksItem_36 := {
	data: "From the Overview:\u000d1. Tap the name of the setup you want to view.\u000d2. Tap X to return to the Overview.\u000d\u000dFrom an Internet setup:\u000d• To view the summary slip, tap or press the Scroll Up/Scroll Down arrows or keys.\u000d• To see a list of all your setups, tap or press Overview.\u000d",
	viewFont: viewFont_2
};

worksite := {data: "Add an Internet setup to a worksite", viewFont: viewFont, layout: 32, name: "worksite"};

blocksItem_37 := {
	data: "1. Tap or press Extras, tap the folder tab, then tap All Icons.\u000d2. Tap Owner Info, then tap a worksite.\u000d3. Tap Add, then tap Internet Access.\u000d4. Tap Internet Setup, then tap a setup. \u000d5. Tap X to close the slip.\u000d6. Tap Show, then tap All Info. The selected setup should appear.\u000d7. When you’re finished, tap X.\u000d",
	viewFont: viewFont_2
};

store := {data: "Store an Internet setup on a PC card", viewFont: viewFont, layout: 32, name: "store"};

blocksItem_38 := {
	data: "Before you create your Internet setup:\u000d1. Tap the i button in the lower-left corner, then tap Prefs.\u000d2. Make sure the checkbox “Always store new setups internally” is not checked. \u000d3. Insert a PC storage card, then create your Internet setup.\u000d",
	viewFont: viewFont_2
};

move := {data: "Move an Internet setup", viewFont: viewFont, layout: 32, name: "move"};

blocksItem_39 := {
	data: "1. Go to the desired setup.\u000d2. Tap the Folder button. \u000d3. Do one of the following:\u000d•To store the setup in the internal memory, tap Internal.\u000d• To store the setup on a card, tap the card’s name.\u000d4. Tap File.\u000d",
	viewFont: viewFont_2
};

send := {data: "Send an Internet setup", viewFont: viewFont, layout: 32, name: "send"};

blocksItem_40 := {
	data: "You can fax, beam, or mail Internet setups to other Newton devices.\u000d1. Go to the desired setup.\u000d2. Tap the Routing button.\u000d3. In the pop-up list, tap your choice.\u000d• If you’re beaming, make sure the infrared windows of the two Newton devices are aligned and within three feet or each other.\u000d• If you’re printing or mailing, enter information in the routing slip, then tap Fax or Mail. In the pop-up list, tap Now or Later.\u000d",
	viewFont: viewFont_2
};

delete := {data: "Delete an Internet setup", viewFont: viewFont, layout: 32, name: "delete"};

blocksItem_41 := {
	data: "From the Overview:\u000d1. Tap the checkbox next to each setup you want to delete.\u000d2. Tap the Routing button, then tap Delete.\u000d3. When the message appears asking if you want to delete, tap OK.\u000d\u000dFrom an Internet setup:\u000d1. Tap the Routing button, then tap Delete.\u000d2. When the message appears asking if you want to delete, tap OK.\u000d",
	viewFont: viewFont_2
};

connect := {data: "Connect and Disconnect\u000d", layout: 2080, name: "connect"};

connectinternet := {data: "Connect to the Internet", viewFont: viewFont, layout: 32, name: "connectinternet"};

blocksItem_42 := {
	data: "1. Create an Internet setup.\u000d2. Start your Internet application. \u000dA connection slip appears. You can\u000d• use the default Internet setup \u000d• select a different Internet setup\u000d• switch to a different worksite\u000d3. Choose the settings you want, then tap Connect.\u000d",
	viewFont: viewFont_2
};

disconnect := {data: "Disconnect from the Internet", viewFont: viewFont, layout: 32, name: "disconnect"};

blocksItem_43 := {
	data: "• Close any Internet applications that are open.\u000d\u000dIf you want to set a time delay, see the subtopic “Add a Disconnect Delay” under the topic “Add Information to a Setup.”\u000d\u000dIf you set a time delay and want to disconnect before this time, see the subtopic “Override the Disconnect Delay.”\u000d",
	viewFont: viewFont_2
};

override := {data: "Override the disconnect delay", viewFont: viewFont, layout: 32, name: "override"};

blocksItem_44 := {
	data: "If you specified a time delay before disconnecting and closed all Internet application before this time, a blinking star appears at the top of the screen.  \u000d\u000dTo disconnect sooner than the time delay:\u000d1. Tap the blinking star, then tap Internet.\u000d2. In the slip that appears, tap OK.\u000d",
	viewFont: viewFont_2
};

