none := "None";

reminderPicker := {
	debug: 671900,
	viewFont: tsSystem + tsSize(9) + tsBold,
	viewJustify: 8396848,
	viewBounds: {left: 0, top: 3, right: 2, bottom: 21},
	text: "Reminder",
	reminderLabels: [|Array|:
		none,
		"1 day notice",
		"2 days notice",
		"3 days notice",
		"4 days notice",
		"5 days notice",
		"6 days notice",
		"7 days notice"
	],
	viewLineSpacing: 12,
	viewClickScript: compile(
		options: "names",
		func(unit) begin
			(if savedDone then self:NotifyCompleted() else inherited:viewClickScript(unit))
		end),
	viewSetupFormScript: compile(
		options: "names",
		func() begin
			self:SetupRange();
			inherited:?viewSetupFormScript()
		end),
	SetupRange: compile(
		options: "names",
		func() begin
			local remindRange;
			self.labelCommands := reminderLabels;
			(if (not HasPath(task, 'remindForDate)) then (if ((remindRange := ((remindRange := (newMtgDate - ((Time() div 1440) * 1440))) div 1440)) < 8) then begin
						if (remindRange < 0) then begin
								remindRange := 0
							end;
						if (if savedFrequencyIndex then (savedFrequencyIndex > 0)) then begin
								remindRange := 7
							end;
						self.labelCommands := Clone(reminderLabels);
						setlength(labelCommands, (remindRange + 1));
						index := 0;
						savedReminderIndex := 0;
						SetValue(entryLine, 'text, labelCommands[0])
					end))
		end),
	TextSetup: compile(
		options: "names",
		func() begin
			local index, date;
			if relayoutInProgress then begin
					return labelCommands[savedReminderIndex]
				end;
			if (if HasPath(task, 'repeatInfo) then task.repeatInfo.reminderInterval) then begin
					index := Min(7, (task.repeatInfo.reminderInterval div 1440))
				end else begin
					if (not HasPath(task, 'remindForDate)) then begin
							index := 0
						end else begin
							if (newMtgDate <> originalMtgDate) then begin
									date := newMtgDate
								end else begin
									if nominalDate then begin
											date := nominalDate
										end else begin
											date := originalMtgDate
										end
								end;
							index := Min(7, Max(0, ((task.remindForDate - date) div 1440)))
						end
				end;
			savedReminderIndex := index;
			labelCommands[index]
		end),
	LabelActionScript: compile(
		options: "names",
		func(index) begin
			dirtyFlag := true;
			(savedReminderIndex := index)
		end),
	preallocatedContext: 'reminderPicker,
	_proto: @protoLabelPicker
};

