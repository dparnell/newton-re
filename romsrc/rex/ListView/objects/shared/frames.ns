		func(aEntry) begin
			local whatStore, name;
			if (whatStore := EntryStore(aEntry)):IsReadOnly() then begin
					name := whatStore:GetName();
					self:Notify(3, "To Do", ParamStr("To Do changes could not be saved (\u201C\u^0\u201D\u is write-protected)", [Array: name]));
					return true
				end;
			nil
		end),
	DeleteTopics: compile(
		options: "names",
		func(aList) begin
			self:EndFlush();
			if ((nItems := Length(aList)) > 1) then begin
					Sort(aList, '|>|, nil)
				end;
			local nItems;
			local task;
			local i;
			local theIndex;
			local entries;
			local Entry;
			local index;
			(for i := 0 to (nItems - 1) do begin
					theIndex := aList[i];
					if HasPath((task := topics[theIndex]), 'repeatInfo) then begin
							if (result := ModalConfirm(Stringer([Array: (textPart1 := SubStr(MakeRichString(task.text, task.styles), 0, 24)), "\u2026\u", " ", "is a recurring task. Delete all occurrences?"]), 'yesNo)) then begin
									self:DeleteTask(0, task, true)
								end else begin
									return nil
								end
						end else begin
							if ((if HasPath(task, 'source) then (task.source = nil)) or (ClassOf(task.source) = 'symbol)) then begin
									self:Notify(3, "To Do", "Can\u2019\ut delete a 1.x formatted To Do item");
									return nil
								end;
							local textPart1;
							local result;
							(foreach Entry in (entries := self:GetToDoEntry(selectedDates[0], nil)) do begin
									if (index := SetContains(Entry.topics, task)) then begin
											if self:CheckReadOnly(Entry) then begin
													return nil
												end;
											ArrayRemoveCount(Entry.topics, index, 1);
											EntryChangeXmit(Entry, 'todo)
										end
								end)
						end
				end);
			curTopic := nil;
			if viewCObject then begin
					self:RedoTopics()
				end;
			true
		end),
	SortToDoItems: compile(
		options: "names",
		func(anEntry) begin
			if EntryStore(anEntry):IsReadOnly() then begin
					return nil
				end;
			StableSort(anEntry.topics, '|<|, func(t) begin
				(t.mtgPriority + (if t.mtgDone then 10 else 0))
			end);
			anEntry.needsSort := nil;
			EntryChangeXmit(anEntry, 'todo)
		end),
	debug: 699,
	topicDragInfo: {types: [|Array|: 'task, 'text], dragRef: nil, label: task},
	viewFont: tsHWFont + tsSize(12),
	topicFont: tsHWFont + tsSize(12),
	viewSetupChildrenScript: compile(
		options: "names",
		func() begin
			inherited:viewSetupChildrenScript();
			self:CalculateScrollRects()
		end),
	GetToDoItemsForRange: compile(
		options: "names",
		func(aDate1, aDate2) begin
			theList := [Array: ];
			local day;
			local theList;
			local dayTopics;
			(for day := (aDate1 := ((aDate1 div 1440) * 1440)) to aDate2 by 1440 do begin
					if (if ((dayTopics := self:GetToDoItemsForThisDate(day)) <> nil) then (Length(dayTopics) > 0)) then begin
							AddArraySlot(theList, {date: day, topics: dayTopics})
						end
				end);
			theList
		end),
	GetToDoItemsForThisDate: compile(
		options: "names",
		func(aDate) begin
			store := 0;
			self:GetToDoSoup();
			if (entries := self:GetToDoEntry(aDate, nil)) then begin
					nDayTopics := 0;
					local entries;
					local Entry;
					local dayTopics;
					local nDayTopics;
					local t;
					local i;
					local store;
					local hasOtherTasks;
					(foreach Entry in entries do begin
							nDayTopics := (nDayTopics + Length(Entry.topics))
						end);
					dayTopics := Array(nDayTopics, nil);
					i := 0;
					store := 0;
					(foreach Entry in entries do begin
							(foreach t in Entry.topics do begin
									t.source := store;
									dayTopics[i] := t;
									i := (i + 1)
								end);
							store := (store + 1);
							if Entry.needsSort then begin
									hasOtherTasks := true
								end
						end)
				end else begin
					dayTopics := [Array: ]
				end;
			if oldTodoSoup then begin
					hasOtherTasks := (self:AddOldSoupTasks(dayTopics, aDate) or hasOtherTasks)
				end;
			if (repeatTargets := self:GetToDoEntry(0, nil)) then begin
					hasOtherTasks := (self:AddRepeatingTasks(dayTopics, aDate) or hasOtherTasks)
				end else begin
					repeatTargets := [Array: ]
				end;
			if (if ((store > 1) or hasOtherTasks) then (Length(dayTopics) > 1)) then begin
					StableSort(dayTopics, '|<|, func(t) begin
						(t.mtgPriority + (if t.mtgDone then 10 else 0))
					end)
				end;
			dayTopics
		end),
	MoveTask: compile(
		constants: {
			kLiteral_791bbd: "To Do"
		},
		options: "names",
		func(aTask, aTarget, aDestStore) begin
			i := 0;
			if ((if HasPath(aTask, 'source) then (aTask.source = nil)) or (ClassOf(aTask.source) = 'symbol)) then begin
					self:Notify(3, kLiteral_791bbd, "Can\u2019\ut move a 1.x formatted To Do item");
					return nil
				end;
			if HasPath(aTask, 'repeatInfo) then begin
					if ((result := ModalConfirm(Stringer([Array: (textPart1 := SubStr(MakeRichString(aTask.text, aTask.styles), 0, 24)), "\u2026\u", " ", "is a recurring task. Move all instances?"]), 'yesNo)) = nil) then begin
							return nil
						end
				end;
			try begin
					aDestStore:CheckWriteProtect();
					if HasPath(aTask, 'repeatInfo) then begin
							local originalEntry;
							local Entry;
							local i;
							local destSoup;
							local possibleTargets;
							local textPart1;
							local result;
							(foreach Entry in repeatTargets do begin
									if SetContains(Entry.topics, aTask) then begin
											originalEntry := Entry;
											break
										end
								end);
							if (EntryStore(originalEntry) = aDestStore) then begin
									return originalEntry
								end;
							self:UpdateMultipleStores('now);
							SetRemove(originalEntry.topics, aTask);
							EntryChangeXmit(originalEntry, 'todo);
							(foreach Entry in repeatTargets do begin
									if (EntryStore(Entry) = aDestStore) then begin
											aTask.source := i;
											AddArraySlot(Entry.topics, aTask);
											Entry.needsSort := true;
											EntryChangeXmit(Entry, 'todo);
											self:RedoTopics();
											return Entry
										end;
									i := (i + 1)
								end)
						end else begin
							(foreach Entry in targets do begin
									if (EntryStore(Entry) = aDestStore) then begin
											aTask.source := i;
											self:UpdateMultipleStores(nil);
											self:RedoTopics();
											return Entry
										end;
									i := (i + 1)
								end)
						end;
					if ((destSoup := aDestStore:GetSoup(masterSoup.soupName)) = nil) then begin
							destSoup := CreateUSoupMember(masterSoup.soupName, aDestStore)
						end;
					Entry := masterSoup:CreateBlankEntry();
					if HasPath(aTask, 'repeatInfo) then begin
							Entry.date := 0;
							Entry.lastRollover := ((Time() div 1440) * 1440)
						end else begin
							Entry.date := aTarget.date
						end;
					destSoup:AddXmit(Entry, nil)
				end onexception |evt.ex.fr.store| do begin
					error := CurrentException().error;
					where := aDestStore:GetName();
					if (error = kSError_WriteProtected) then begin
							msg := "To Do changes could not be saved (\u201C\u^0\u201D\u is write-protected)"
						end else begin
							if (error = kSError_StoreFull) then begin
									msg := "To Do changes could not be saved (\u201C\u^0\u201D\u is full)"
								end
						end;
					if msg then begin
							self:Notify(3, kLiteral_791bbd, ParamStr(msg, [Array: where]))
						end else begin
							Rethrow()
						end;
					return nil
				end;
			if HasPath(aTask, 'repeatInfo) then begin
					SetAdd(repeatTargets, Entry, true);
					possibleTargets := repeatTargets
				end else begin
					SetAdd(targets, Entry, true);
					possibleTargets := targets
				end;
			i := 0;
			(foreach Entry in possibleTargets do begin
					local error, msg, where;
					if (EntryStore(Entry) <> aDestStore) then begin
							i := (i + 1)
						end
				end);
			aTask.source := i;
			if HasPath(aTask, 'repeatInfo) then begin
					Entry.topics := [Array: aTask];
					EntryChangeXmit(Entry, 'todo)
				end else begin
					self:UpdateMultipleStores(nil)
				end;
			self:RedoTopics();
			return Entry
		end),
	UndoNewTask: compile(
		options: "names",
		func(aDate, aTask) begin
			(if Visible(self) then self:DeleteTask(aDate, aTask, true) else self:DeleteTask(aDate, aTask, nil))
		end),
	AddRepeatingTasks: compile(
		options: "names",
		func(aTopicList, aDate) begin
			store := 0;
			curWidth := GetRoot():GlobalBox().right;
			today := ((Time() div 1440) * 1440);
			if (aDate < today) then begin
					return nil
				end;
			local Entry;
			local t;
			local addedTasks;
			local date;
			local today;
			local store;
			local curWidth;
			(foreach Entry in repeatTargets do begin
					(foreach t in Entry.topics do begin
							local nextDate;
							date := NextMeeting(aDate, t.repeatInfo);
							if t.repeatInfo.reminderInterval then begin
									date := (date - t.repeatInfo.reminderInterval)
								end;
							if (date < aDate) then begin
									nextDate := aDate;
									(while (date < aDate) do begin
											if ((date := NextMeeting((nextDate := (nextDate + 1440)), t.repeatInfo)) = 0) then begin
													break
												end;
											(date := (date - t.repeatInfo.reminderInterval))
										end)
								end;
							if (date = aDate) then begin
									if ArrayPos(t.repeatDone, date, 0, nil) then begin
											t.mtgDone := true
										end else begin
											t.mtgDone := nil
										end;
									t.source := store;
									AddArraySlot(aTopicList, t);
									addedTasks := true
								end
						end);
					store := (store + 1)
				end);
			addedTasks
		end),
	AddTask: compile(
		options: "names",
		func(aRichString, aDate, aPriority, aComplete, aReminder) begin
			local topicFrame, Entry, top, nDayTopics, gtdeds;
			if ((nDayTopics := Length((Entry := (gtdeds := self:GetToDoEntryDefaultStore(aDate, nil)).Entry).topics)) > 0) then begin
					top := self:TopicBottom(Entry.topics[(nDayTopics - 1)])
				end else begin
					top := 0
				end;
			(topicFrame := self:StringToTopic(aRichString, top)).source := gtdeds.storeIndex;
			topicFrame.mtgPriority := Min(aPriority, 3);
			topicFrame.mtgDone := aComplete;
			if aReminder then begin
					topicFrame.remindForDate := aReminder
				end;
			if (if (aDate <> 0) then (aDate < ((Time() div 1440) * 1440))) then begin
					topicFrame.mtgDone := true
				end;
			if (nDayTopics > 0) then begin
					if ((Entry.topics[(nDayTopics - 1)].mtgDone <> topicFrame.mtgDone) or (topicFrame.mtgPriority <> 3)) then begin
							Entry.needsSort := true
						end
				end;
			AddArraySlot(Entry.topics, topicFrame);
			if (StrLen(aRichString) > 0) then begin
					Entry.lastWidth := 0
				end;
			EntryChangeXmit(Entry, 'todo);
			{index: (Length(Entry.topics) - 1), topic: topicFrame, Entry: Entry}
		end),
	DeleteRolledTopics: compile(
		options: "names",
		func(anEntry, aList) begin
			if ((nItems := Length(aList)) > 1) then begin
					Sort(aList, '|>|, nil)
				end;
			local nItems;
			(foreach theIndex in aList do begin
					ArrayRemoveCount(anEntry.topics, theIndex, 1)
				end);
			EntryChangeXmit(anEntry, 'todo)
		end),
	DuplicateTask: compile(
		options: "names",
		func(aDate, aTask) begin
			local newTask, oldLen, text, reminder;
			reminder := nil;
			self:GetToDoSoup();
			if aTask.remindForDate then begin
					reminder := aTask.remindForDate
				end;
			if (if HasPath(aTask, 'repeatInfo) then (aDate <> 0)) then begin
					aDate := 0
				end;
			if ((oldLen := StrLen(aTask.text)) > 0) then begin
					text := ParamStr("copy of ^0", [Array: MakeRichString(aTask.text, aTask.styles)])
				end else begin
					text := "copy of blank task"
				end;
			newTask := self:AddTask(text, aDate, aTask.mtgPriority, aTask.mtgDone, reminder);
			if HasPath(aTask, 'repeatInfo) then begin
					newTask.topic.repeatInfo := Clone(aTask.repeatInfo);
					newTask.topic.repeatDone := Clone(aTask.repeatDone);
					EntryChangeXmit(newTask.Entry, nil)
				end;
			AddUndoAction('DeleteTask, [Array: aDate, newTask.topic, true]);
			newTask
		end),
	whoAmI: 'toDoListView,
	repeatTargets: [|Array|: ],
	DateFind: compile(
		options: "names",
		func(aWhat, aFindType, aSoupFinders, aMasterFinder, aContext) begin
			aContext:SetStatus("Searching in To Do\u2026\u");
			self:GetToDoSoup();
			self:EndFlush();
			if (aFindType = 'dateBefore) then begin
					singleTest := func(item) begin
						(if (item.date < aWhat) then (item.date > 0))
					end;
					repeatTest := func(item) begin
						local date;
						date := NextMeeting(0, item);
						if item.reminderInterval then begin
								date := (date - item.reminderInterval)
							end;
						(date < aWhat)
					end;
					startKey := 1
				end else begin
					if (aFindType = 'dateAfter) then begin
							singleTest := func(item) begin
								(item.date > aWhat)
							end;
							repeatTest := func(item) begin
								local date;
								date := NextMeeting((aWhat + 1), item);
								if item.reminderInterval then begin
										date := (date - item.reminderInterval)
									end;
								(date > 0)
							end;
							startKey := aWhat
						end else begin
							singleTest := func(item) begin
								(item.date = aWhat)
							end;
							repeatTest := func(item) begin
								local date;
								date := NextMeeting(aWhat, item);
								if item.reminderInterval then begin
										date := (date - item.reminderInterval)
									end;
								(date = aWhat)
							end;
							startKey := aWhat
						end
				end;
			if (cursor := dataSoup:Query({type: 'index, indexPath: 'date, startKey: startKey, validTest: singleTest})):Entry() then begin
					AddArraySlot(aSoupFinders, {_proto: protoToDoFinder, masterFinder: aMasterFinder, owner: GetRoot().calendar, findType: aFindType, findWords: aWhat, cursor: cursor})
				end;
			local cursor;
			local Entry;
			local task;
			local repeatTargets;
			(if (repeatTargets := MapCursor((cursor := dataSoup:Query({type: 'index, startKey: 0, indexPath: 'date, endTest: func(e) begin
				(e.date > 0)
			end})), nil)) then (foreach Entry in repeatTargets do begin
						(foreach task in Entry.topics do begin
								if call repeatTest with (task.repeatInfo) then begin
										AddArraySlot(aSoupFinders, {_proto: protoToDoFinder, masterFinder: aMasterFinder, owner: GetRoot().calendar, findType: aFindType, findWords: aWhat, cursor: cursor});
										break
									end
							end)
					end))
		end),
	Find: compile(
		options: "names",
		func(aFindWords, aSoupFinders, aMasterFinder, aContext) begin
			local cursor;
			aContext:SetStatus("Searching in To Do\u2026\u");
			self:GetToDoSoup();
			self:EndFlush();
			(if (cursor := dataSoup:Query({type: 'words, words: aFindWords, indexPath: 'date})):Entry() then AddArraySlot(aSoupFinders, {_proto: protoToDoFinder, masterFinder: aMasterFinder, owner: GetRoot().calendar, findType: 'text, findWords: aFindWords, cursor: cursor}))
		end),
	protoToDoFinder: {
		ForEachSelected: compile(
			options: "names",
			func(callback) begin
				(if selected then begin
						c := Query(cursor:soup(), '{type: index});
						local c;
						(foreach alias in selected do begin
								local e;
								e := c:gotokey(alias._uniqueID);
								(loop begin
										if (e._uniqueID <> alias._uniqueID) then begin
												break (e := nil)
											end;
										(if (EntryStore(e):GetSignature() <> alias._storeID) then (e := c:Next()) else break)
									end);
								if e then begin
										call callback with (e, alias.topicIndex)
									end else nil
							end)
					end)
			end),
		IsThisItemSelected: compile(
			options: "names",
			func(item) begin
				local alias;
				(if item.realFinder:IsSelected((alias := {_uniqueID: item.entryID, _storeID: item.storeID, instanceTime: item.instanceTime, topicIndex: item.topicIndex})) then true)
			end),
		SelectItem: compile(
			options: "names",
			func(item) begin
				local alias, index;
				alias := {_uniqueID: item.entryID, _storeID: item.storeID, instanceTime: item.instanceTime, topicIndex: item.topicIndex};
				(if selected then (if (index := ArrayPos(selected, alias, 0, func(e, t) begin
						(if (if (if (e._uniqueID = t._uniqueID) then (e._storeID = t._storeID)) then (e.instanceTime = t.instanceTime)) then (e.topicIndex = t.topicIndex))
					end)) then RemoveSlot(selected, index) else AddArraySlot(selected, alias)) else (selected := [Array: alias]))
			end),
		Reset: compile(
			options: "names",
			func() begin
				cursor:Reset()
			end),
		ReSync: compile(
			options: "names",
			func() begin
				cacheEntryCount := nil;
				currentItem := 0;
				self:Reset();
				(zeroOneOrMoreResult := nil)
			end),
		TaskMatches: compile(
			options: "names",
			func(aTask) begin
				local date, match;
				if (findType = 'dateBefore) then begin
						date := NextMeeting(0, aTask.repeatInfo)
					end else begin
						if (findType = 'dateAfter) then begin
								date := NextMeeting((findWords + 1), aTask.repeatInfo)
							end else begin
								date := NextMeeting(findWords, aTask.repeatInfo)
							end
					end;
				if aTask.repeatInfo.reminderInterval then begin
						date := (date - aTask.repeatInfo.reminderInterval)
					end;
				if (findType = 'dateBefore) then begin
						match := (date < findWords)
					end else begin
						if (findType = 'dateAfter) then begin
								match := (date > 0)
							end else begin
								match := (date = findWords)
							end
					end;
				(if match then date)
			end),
		currentItem: 0,
		GetEntryIndexForInstanceIndex: compile(
			options: "names",
			func(instanceIndex) begin
				(if (cacheInstanceArrayCount = nil) then instanceIndex else begin
						totalInstances := 0;
						i := 0;
						local totalInstances;
						(foreach instanceCount in cacheInstanceArrayCount do begin
								if ((totalInstances := (totalInstances + instanceCount)) > instanceIndex) then begin
										break
									end else begin
										i := (i + 1)
									end
							end);
						i
					end)
			end),
		FileAs: compile(
			options: "names",
			func(labels) begin
				return nil
			end),
		cacheEntryCount: nil,
		AddTasksForEntry: compile(
			options: "names",
			func(anEntry, aResults, anOffset, aPrevCount, aMaxCount) begin
				found := [Array: ];
				i := 0;
				if (findType = 'text) then begin
						local excerpt;
						local newFindItem;
						local found;
						local i;
						local f;
						local value;
						local path;
						local date;
						local ti;
						local t;
						local r;
						(for ti := 0 to (Length(anEntry.topics) - 1) do begin
								if (r := FindStringInFrame((t := anEntry.topics[ti]), findWords, true)) then begin
										AddArraySlot(found, r[0]);
										AddArraySlot(found, [Array: ti]);
										AddArraySlot(found, r[2])
									end
							end)
					end else begin
						if (anEntry.date <> 0) then begin
								found := Array((Length(anEntry.topics) * 3), nil);
								(for ti := 0 to (Length(anEntry.topics) - 1) do begin
										f := (ti * 3);
										found[f] := anEntry.topics[ti].text;
										found[(f + 1)] := [Array: ti]
									end)
							end else begin
								Write(Stringer([Array: "repeating task may match, anOffset=", anOffset, " ", "aPrevCount=", aPrevCount, " ", "findType="]));
								Print(findType);
								found := [Array: ];
								(for ti := 0 to (Length(anEntry.topics) - 1) do begin
										if self:TaskMatches((t := anEntry.topics[ti])) then begin
												AddArraySlot(found, t.text);
												AddArraySlot(found, [Array: ti]);
												AddArraySlot(found, nil)
											end
									end)
							end
					end;
				(for f := 0 to (Length(found) - 1) by 3 do begin
						value := found[f];
						path := found[(f + 1)];
						if ((i + aPrevCount) > aMaxCount) then begin
								break
							end;
						if (anEntry.date = 0) then begin
								t := anEntry.topics[path[0]];
								date := NextMeeting(((Time() div 1440) * 1440), t.repeatInfo);
								if t.repeatInfo.reminderInterval then begin
										date := (date - t.repeatInfo.reminderInterval)
									end
							end else begin
								date := anEntry.date
							end;
						if (date(date).year = date(Time()).year) then begin
								excerpt := Stringer([Array: LongDateStr(date, 74985), " ", value])
							end else begin
								excerpt := Stringer([Array: LongDateStr(date, 4799084), " ", value])
							end;
						if (StrLen(excerpt) > 50) then begin
								excerpt := SubStr(excerpt, 0, 50)
							end;
						(newFindItem := {_proto: @protoFindItem, finder: (if self.masterFinder then masterFinder else self), realFinder: self, entryID: anEntry._uniqueID, soup: EntrySoup(anEntry), storeID: EntryStore(anEntry):GetSignature(), selected: nil, itemIndex: ((anOffset + aPrevCount) + i), title: excerpt, topicIndex: path[0], offset: found[(f + 2)], instanceTime: date}).selected := self:IsSelected({_uniqueID: newFindItem.entryID, _storeID: newFindItem.storeID, instanceTime: newFindItem.instanceTime, topicIndex: newFindItem.topicIndex});
						AddArraySlot(aResults, newFindItem);
						i := (i + 1)
					end);
				i
			end),
		ShowFoundItem: compile(
			options: "names",
			func(item) begin
				local c, Entry;
				currentItem := item.itemIndex;
				(if (Entry := (c := Query(item.soup, {type: 'index, indexPath: '_uniqueID, startKey: item.entryID})):Entry()) then begin
						cursor:Goto(Entry);
