	AddOldSoupTasks: compile(
		options: "names",
		func(aTopicList, aStart) begin
			local tomorrow, itemDate;
			local today, querySpec, spec, cursor, pastTest, presentTest, futureTest, Entry, task, result;
			querySpec := '{type: index, indexPath: mtgStartDate, startKey: 0, validTest: nil};
			today := ((today := Time()) - (today mod 1440));
			pastTest := func(item) begin
				itemDate := item.mtgStartDate;
				item.mtgDone
			end;
			presentTest := func(item) begin
				itemDate := item.mtgStartDate;
				((not item.mtgDone) or (itemDate >= aStart))
			end;
			futureTest := func(item) begin
				true
			end;
			endTest := func(item) begin
				itemDate := item.mtgStartDate;
				(item.mtgStartDate >= tomorrow)
			end;
			(spec := Clone(querySpec)).endTest := endTest;
			if (today = aStart) then begin
					spec.validTest := presentTest;
					spec.startKey := 0
				end else begin
					if (today < aStart) then begin
							spec.validTest := futureTest;
							spec.startKey := aStart
						end else begin
							spec.validTest := pastTest;
							spec.startKey := aStart
						end
				end;
			tomorrow := (aStart + 1440);
			if ((cursor := oldTodoSoup:Query(spec)):CountEntries() > 0) then begin
					Entry := cursor:Entry();
					(while Entry do begin
							if HasPath(Entry, 'converted) then begin
									AddArraySlot(aTopicList, self:MoveConvertedEntry(Entry));
									result := true
								end else begin
									if (task := GetDataDefs('convertTodo):ConvertOldEntry(Entry)) then begin
											AddArraySlot(aTopicList, task);
											result := true
										end
								end;
							(Entry := cursor:Next())
						end)
				end;
			return result
		end),
	RollEntryOver: compile(
		options: "names",
		func(anEntry, aNewDate) begin
			deleteList := [Array: ];
			if EntryStore(anEntry):IsReadOnly() then begin
					EntryUndoChanges(anEntry);
					return nil
				end;
			if (Length(anEntry.topics) = 0) then begin
					EntryRemoveFromSoupXmit(anEntry, 'todo);
					return true
				end;
			local topic;
			local doneItems;
			local notDoneItems;
			local newEntry;
			local newTopics;
			local ti;
			local ki;
			local nToDelete;
			local deleteList;
			(foreach topic in anEntry.topics do begin
					if ((topic.level = nil) or (topic.level = 1)) then begin
							if topic.mtgDone then begin
									doneItems := true
								end else begin
									notDoneItems := true
								end
						end
				end);
			if (if doneItems then notDoneItems) then begin
					newTopics := (newEntry := self:GetToDoEntryDefaultStore(aNewDate, nil).Entry).topics;
					(for ti := 0 to (Length(anEntry.topics) - 1) do begin
							if (((topic := anEntry.topics[ti]).level = nil) or (topic.level = 1)) then begin
									if (topic.mtgDone = nil) then begin
											AddArraySlot(deleteList, ti);
											AddArraySlot(newTopics, topic)
										end
								end
						end);
					if ((nToDelete := Length(deleteList)) > 0) then begin
							self:DeleteRolledTopics(anEntry, deleteList)
						end;
					newEntry.needsSort := true;
					EntryChangeXmit(newEntry, 'todo)
				end else begin
					if notDoneItems then begin
							anEntry.date := aNewDate;
							EntryChangeXmit(anEntry, 'todo)
						end else begin
							EntryUndoChanges(anEntry)
						end
				end;
			true
		end),
	target: nil,
	RollRepeatOver: compile(
		options: "names",
		func(anEntry, aNewDate, aPrevDate) begin
			changed := nil;
			rollDate := aPrevDate;
			if EntryStore(anEntry):IsReadOnly() then begin
					return nil
				end;
			newTopics := (newEntry := self:GetToDoEntryDefaultStore(aNewDate, nil).Entry).topics;
			if anEntry.lastRollover then begin
					rollDate := anEntry.lastRollover
				end;
			local date;
			local topic;
			local newEntry;
			local newTopics;
			local checkedEntry;
			local doneIndex;
			local changed;
			local rollDate;
			(foreach topic in anEntry.topics do begin
					date := NextMeeting(rollDate, topic.repeatInfo);
					if topic.repeatInfo.reminderInterval then begin
							date := (date - topic.repeatInfo.reminderInterval)
						end;
					if (if (doneIndex := ArrayPos(topic.repeatDone, date, 0, nil)) then (date < aNewDate)) then begin
							ArrayRemoveCount(topic.repeatDone, doneIndex, 1);
							changed := true;
							checkedEntry := self:GetToDoEntryDefaultStore(date, nil).Entry;
							RemoveSlot((topic := DeepClone(topic)), 'repeatInfo);
							RemoveSlot(topic, 'repeatDone);
							topic.mtgDone := true;
							AddArraySlot(checkedEntry.topics, topic);
							EntryChangeXmit(checkedEntry, 'todo)
						end else begin
							if (date < aNewDate) then begin
									RemoveSlot((topic := DeepClone(topic)), 'repeatInfo);
									RemoveSlot(topic, 'repeatDone);
									topic.mtgDone := nil;
									AddArraySlot(newEntry.topics, topic);
									changed := true
								end
						end
				end);
			anEntry.lastRollover := aNewDate;
			EntryChangeXmit(anEntry, 'todo);
			if changed then begin
					newEntry.needsSort := true;
					EntryChangeXmit(newEntry, 'todo)
				end;
			true
		end),
