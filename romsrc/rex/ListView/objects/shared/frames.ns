	NextToDoDate: compile(
		options: "names",
		func(aDate) begin
			earliestDate := 536870911;
			self:GetToDoSoup();
			aDate := ((aDate div 1440) * 1440);
			Entry := (cursor := dataSoup:Query({type: 'index, indexPath: 'date, startKey: 0, endTest: func(e) begin
				(e.date > 0)
			end})):Entry();
			(while Entry do begin
					local cursor;
					local Entry;
					local earliestDate;
					local date;
					(foreach t in Entry.topics do begin
							date := NextMeeting(aDate, t.repeatInfo);
							if t.repeatInfo.reminderInterval then begin
									date := (date - t.repeatInfo.reminderInterval)
								end;
							if (if (date = aDate) then (date > 0)) then begin
