		selected: nil,
		items: nil,
		AddFoundItems: compile(
			options: "names",
			func(results, offset, maxCount) begin
				local c, Entry, i;
				(c := cursor:clone()):Reset();
				indexFirstItem := Length(results);
				Entry := c:Entry();
				i := 0;
				(loop begin
						if ((Entry = nil) or (i >= maxCount)) then begin
								break
							end;
						(try begin
								i := (i + self:AddTasksForEntry(Entry, results, offset, i, maxCount));
								(Entry := c:Next())
							end onexception |evt.ex| do begin
								breakloop();
								(Entry := nil)
							end)
					end);
				items := results;
				i
			end),
		ShowOrdinalItem: compile(
			options: "names",
			func(ordinal) begin
				local results, oldItem, currentEntryIndex, oldEntryIndex;
				if (items = nil) then begin
						self:AddFoundItems((results := [Array: ]), 0, 1)
					end;
				(if (ordinal = 'first) then begin
						currentItem := 0;
						self:ShowItem(items[indexFirstItem], cursor:Reset())
					end else begin
						oldItem := currentItem;
						if (ordinal = 'Prev) then begin
								currentItem := (currentItem - 1)
							end else begin
								if (ordinal = 'Next) then begin
										currentItem := (currentItem + 1)
									end else begin
										currentItem := ordinal
									end
							end;
						currentEntryIndex := self:GetEntryIndexForInstanceIndex((currentItem := Min(Max(currentItem, 0), (self:Count() - 1))));
						oldEntryIndex := self:GetEntryIndexForInstanceIndex(oldItem);
						self:ShowItem(items[(indexFirstItem + currentItem)], cursor:Move((currentEntryIndex - oldEntryIndex)))
					end)
			end),
		ShowItem: compile(
			options: "names",
			func(anItem, anEntry) begin
				if ((anEntry = 'deleted) or (anEntry = nil)) then begin
						self:ReSync();
						anEntry := nil
					end else begin
						cursor:Goto(anEntry)
					end;
				if (not Visible(owner)) then begin
						if (anEntry <> nil) then begin
								owner:?viewPreOpenScript(anEntry)
							end;
						owner:Open()
					end;
				owner:ShowToDoList(anItem.instanceTime);
				owner.toDoListView:ShowFoundItem(anEntry, anItem.instanceTime, self)
			end),
