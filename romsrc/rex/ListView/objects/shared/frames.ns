					if (not Entry.deleteList) then begin
							Entry.deleteList := [Array: ]
						end;
					AddArraySlot(Entry.deleteList, topicIndex)
				end);
				self:ForEachSelected(func(Entry, topicIndex) begin
					(if Entry.deleteList then begin
							delList := Entry.deleteList;
							RemoveSlot(Entry, 'deleteList);
							GetRoot().calendar:GetToDo():DeleteRolledTopics(Entry, delList)
						end)
				end);
				selected := nil;
				self.zeroOneOrMoreResult := nil;
				masterFinder.zeroOneOrMoreResult := nil;
				self.cacheCount := nil;
				masterFinder.cacheCount := nil;
				GetRoot().calendar:GetToDo():ShowChanges()
			end),
		debug: 1444552,
		Count: compile(
			options: "names",
			func() begin
				local c, i, Entry, instanceCount;
				(if cacheEntryCount then cacheEntryCount else begin
						cacheInstanceArrayCount := nil;
						(c := cursor:clone()):Reset();
						i := 0;
						Entry := c:Entry();
						(loop begin
								if (Entry = nil) then begin
										break
									end;
								if (cacheInstanceArrayCount = nil) then begin
										cacheInstanceArrayCount := [Array: ]
									end;
								if ((instanceCount := self:CountTasks(Entry)) = 0) then begin
										Print("**** entry has 0 instances! ****")
									end;
								AddArraySlot(cacheInstanceArrayCount, instanceCount);
								i := (i + instanceCount);
								(Entry := c:Next())
							end);
						(cacheEntryCount := i)
					end)
			end),
		indexFirstItem: 0,
		CountTasks: compile(
			options: "names",
			func(anEntry) begin
				(if (findType = 'text) then begin
						if (found := FindStringInFrame(anEntry.topics, findWords, 'first)) then begin
								return (Length(found) / 3)
							end;
						return 0
					end else (if (anEntry.date = 0) then begin
							Print("gotta count repeating");
							Count := 0;
							local found;
							local topic;
							local Count;
							(foreach topic in anEntry.topics do begin
									if self:TaskMatches(topic) then begin
											Count := (Count + 1)
										end
								end);
							Count
						end else Length(anEntry.topics)))
			end),
		MoveTo: compile(
			options: "names",
			func(toStore) begin
				local toSoup;
				local soupName;
				toSoup := toStore:GetSoup((soupName := cursor:soup():GetName()));
				self:ForEachSelected(func(e, topicIndex) begin
					(if (EntryStore(e) <> toStore) then EntryMove(e, toSoup))
				end);
				selected := nil;
				XmitSoupChange("To Do List", 'todo, 'whatThe, nil)
			end),
		IsSelected: compile(
			options: "names",
