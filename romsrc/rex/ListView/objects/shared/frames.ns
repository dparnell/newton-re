			Entry := (dataCursor := dataSoup:Query({type: 'index, startKey: aDate, indexPath: 'date, endTest: func(e) begin
				(e.date > aDate)
			end})):Entry();
			(while (if (Entry <> nil) then (EntryStore(Entry) <> aSeedStore)) do begin
					Entry := dataCursor:Next();
					(storeIndex := (storeIndex + 1))
				end);
			if (Entry = nil) then begin
					(Entry := masterSoup:CreateBlankEntry()).date := aDate;
					if (aDate = 0) then begin
