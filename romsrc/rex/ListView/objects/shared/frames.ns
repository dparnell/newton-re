				(if selected then ArrayPos(selected, itemAlias, 0, func(e, test) begin
						(if (if (if (e._uniqueID = test._uniqueID) then (e._storeID = test._storeID)) then (e.instanceTime = test.instanceTime)) then (e.topicIndex = test.topicIndex))
					end))
			end)
	},
	GetToDoShapes: compile(
		options: "names",
		func(aDate, aYOffset, aWidth, aFont) begin
			shapes := [Array: {font: aFont, justification: 'left}];
			lineHt := (GetFontSize(aFont) + 2);
			local task;
			local iconShape;
			local shapes;
			local lineHt;
			local result;
			(foreach task in self:GetToDoItemsForThisDate(aDate) do begin
					result := self:GetTaskShapes(shapes, task, aYOffset, aWidth, aFont);
					aYOffset := ((aYOffset + result.height) + 5)
				end);
			(if (Length(shapes) = 1) then nil else shapes)
		end),
	GetTaskShapes: compile(
		options: "names",
		func(aShapes, aTask, aYOffset, aWidth, aFont) begin
			local box, left, shapes, iconShape, height, textShapes;
			if (aShapes = nil) then begin
					shapes := [Array: {font: aFont, justification: 'left}]
				end else begin
					shapes := aShapes
				end;
			iconShape := OffsetShape(MakeShape(checkBitmaps[(if aTask.mtgDone then 1 else 0)]), 20, (aYOffset + 1));
			AddArraySlot(shapes, iconShape);
			iconShape := OffsetShape(MakeShape(priorityItems[aTask.mtgPriority]), 35, (aYOffset + 1));
			AddArraySlot(shapes, iconShape);
			box := SetBounds(55, (aYOffset + 1), aWidth, 9999);
			textShapes := MakeTextLines(MakeRichString(aTask.text, aTask.styles), box, nil, aFont);
			AddArraySlot(shapes, textShapes);
			height := Max(((box := ShapeBounds(textShapes)).bottom - box.top), GetFontSize(aFont));
			{shapes: shapes, height: height}
		end),
	_proto: @8313
