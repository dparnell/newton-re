	CreateToDoItemAll: compile(
		options: "names",
		func(aDate, aRichString, aReminder, aFrequency, aPriority, aComplete) begin
			local todoTask, newView, ti, isVisible;
			if (isVisible := Visible(self)) then begin
					self:EndFlush()
				end;
			self:GetToDoSoup();
			aDate := ((aDate div 1440) * 1440);
			if aFrequency then begin
					todoTask := self:AddTask(aRichString, 0, aPriority, aComplete, nil);
					if (not HasPath((aFrequency := Clone(aFrequency)), 'mtgStartDate)) then begin
							aFrequency.mtgStartDate := aDate
						end else begin
							aFrequency.mtgStartDate := ((aFrequency.mtgStartDate div 1440) * 1440)
						end;
					if isVisible then begin
							aDate := selectedDates[0]
						end;
					if (if aReminder then (aReminder <> 0)) then begin
							aFrequency.reminderInterval := (aReminder * 1440)
						end;
					todoTask.topic.repeatInfo := aFrequency;
					todoTask.topic.repeatDone := [Array: ];
					EntryChangeXmit(todoTask.Entry, nil)
				end else begin
					if (if aReminder then (aReminder <> 0)) then begin
							todoTask := self:AddTask(aRichString, (aDate - (Abs(aReminder) * 1440)), aPriority, aComplete, aDate);
							aDate := (aDate - (Abs(aReminder) * 1440))
						end else begin
							todoTask := self:AddTask(aRichString, aDate, aPriority, aComplete, nil)
						end
				end;
			if (if (if isVisible then (selectedDates <> nil)) then (aDate = selectedDates[0])) then begin
					self:RedoChildren();
					if (ti := ArrayPos(topics, todoTask.topic, 0, nil)) then begin
							if (mainDisplay <> agendaView) then begin
									if (ti < firstTopic) then begin
											firstTopic := Max(0, (ti - 1));
											self:RedoChildren()
										end else begin
											if (ti > lastTopic) then begin
													firstTopic := ((firstTopic + ti) - lastTopic);
													self:RedoChildren()
												end
										end
								end
						end else begin
							Write("Couldn't find ");
							Print(todoTask)
						end;
					self:CalculateScrollRects()
				end else begin
					ti := todoTask.index
				end;
			if Visible(self) then begin
					self:AddUndoAction('UndoNewTask, [Array: aDate, todoTask.topic])
				end;
			ti
		end),
	EndFlush: compile(
		options: "names",
		func() begin
			(if entryChanged then begin
					originalLen := Length(targets);
					local t;
					local counts;
					local i;
					local whichTarget;
					local originalLen;
					(foreach index, target in targets do begin
							if (not EntryValid(target)) then begin
									self:Notify(3, title, "The storage card was ejected so the last few changes have been lost.");
									return nil
								end
						end);
					counts := Array(Length(targets), 0);
					(foreach t in targets do begin
							t.topics := Array(nTopics, nil)
						end);
					(foreach t in topics do begin
							if (not HasPath(t, 'repeatInfo)) then begin
									if (if ((whichTarget := t.source) <> nil) then (ClassOf(whichTarget) <> 'symbol)) then begin
											targets[whichTarget].topics[counts[whichTarget]] := t;
											counts[whichTarget] := (counts[whichTarget] + 1)
										end
								end
						end);
					(for i := 0 to (Length(targets) - 1) do begin
							setlength(targets[i].topics, counts[i])
						end);
					(foreach t in topics do begin
							if HasPath(t, 'repeatInfo) then begin
									if t.mtgDone then begin
											SetAdd(t.repeatDone, flushDate, true)
										end else begin
											SetRemove(t.repeatDone, flushDate)
										end
								end
						end);
					(foreach t in targets do begin
							if (if EntryValid(t) then (not EntryStore(t):IsReadOnly())) then begin
									self:FlushEntry(t)
								end
						end);
					(foreach t in repeatTargets do begin
							if (if EntryValid(t) then (not EntryStore(t):IsReadOnly())) then begin
									self:FlushEntry(t)
								end
						end);
					(entryChanged := nil)
				end)
		end),
	MoveTaskToDate: compile(
		options: "names",
		func(aTask, aTarget, anOldDate, aDate) begin
			local Entry;
			if ((if HasPath(aTask, 'source) then (aTask.source = nil)) or (ClassOf(aTask.source) = 'symbol)) then begin
					self:Notify(3, title, "Can\u2019\ut move a 1.x formatted To Do item");
					return nil
				end;
			self:DeleteTask(anOldDate, aTask, 'noUndoOrDraw);
			AddArraySlot((Entry := self:GetToDoEntryDefaultStore(aDate, nil).Entry).topics, aTask);
			Entry.needsSort := true;
			EntryChangeXmit(Entry, 'todo);
			self:GetTarget(nil);
			(if Visible(self) then self:AddUndoAction('UndoMoveTaskToDate, [Array: aTask, aTarget, aDate, anOldDate]))
		end),
