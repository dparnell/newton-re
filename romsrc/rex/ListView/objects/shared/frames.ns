export145Proto := {
	PutAway: compile(
		options: "names",
		func(anItem) begin
			local beamedEntry, task, added, today, date, text, reminder;
			reminder := nil;
			self:GetToDoSoup();
			if ((beamedEntry := anItem.body).viewStationery = 'TodoItem) then begin
					if beamedEntry.data then begin
							text := ExtractData(beamedEntry.data, "...", 256)
						end else begin
							text := ""
						end;
					date := beamedEntry.mtgStartDate
				end else begin
					text := MakeRichString(beamedEntry.text, beamedEntry.styles);
					date := beamedEntry.date;
					if beamedEntry.remindForDate then begin
							reminder := beamedEntry.remindForDate
						end
				end;
			date := (date - (date mod 1440));
			today := ((today := Time()) - (today mod 1440));
			if (if (date < today) then (beamedEntry.mtgDone = nil)) then begin
					date := today
				end;
			task := (added := self:AddTask(text, date, beamedEntry.mtgPriority, beamedEntry.mtgDone, reminder)).topic;
			added.Entry.needsSort := true;
			EntryChangeXmit(added.Entry, 'todo);
			measureTopics := true;
			self:RedoTopics()
		end),
	FlushEntry: compile(
		options: "names",
		func(Entry) begin
			local where, error, msg;
			(if EntryValid(Entry) then (try begin
						EntryChangeXmit(Entry, 'todo)
					end onexception |evt.ex.fr.store| do begin
						error := CurrentException().error;
						where := EntryStore(Entry):GetName();
						if (error = kSError_WriteProtected) then begin
								msg := "To Do changes could not be saved (\u201C\u^0\u201D\u is write-protected)"
							end else begin
								if (error = kSError_StoreFull) then begin
										msg := "To Do changes could not be saved (\u201C\u^0\u201D\u is full)"
									end
							end;
						if msg then begin
								self:Notify(3, "To Do", ParamStr(msg, [Array: where]))
							end else begin
								Rethrow()
							end;
						EntryUndoChanges(Entry)
					end))
		end),
	UndoMoveTaskToDate: compile(
