			curTopic := nil;
			true
		end),
	// SetTopicData(index, text, styles): replaces a topic's text.
	SetTopicData: compile(
		options: "names",
		func(anIndex, aText, aStyles) begin
			local topic;
			if (((anIndex = nil) or (anIndex >= nTopics)) or (anIndex < 0)) then begin
					return nil
				end;
			if ((aText = nil) or (aStyles = nil)) then begin
					return nil
				end;
			(topic := topics[anIndex]).text := aText;
			topic.styles := aStyles;
			self:StartFlush();
			self:RedoChildren();
			true
		end),
	// ChildChanged(view): a topic's paragraph changed - its bounds kept, the topics below adjusted later.
	ChildChanged: compile(
		options: "names",
		func(aView) begin
			local theIndex, topic;
			theIndex := aView.index;
			(topic := topics[theIndex]).styles := aView.styles;
			topic.viewBounds := aView.viewBounds;
			if (adjusting or (if (duringScroll exists) then duringScroll)) then begin
					return nil
				end;
			topicChanged := Min(topicChanged, theIndex);
			if (theIndex = curTopic) then begin
					curTopicChanged := true
				end;
