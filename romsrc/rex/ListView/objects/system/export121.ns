// export121: ListView's outline list proto (on protoListView) - a list of topics (items)
// with levels (indented by 20 pixels a level), optional checkboxes and priorities, that the
// To Do List and the checklist/outline stationery build on. topics is the array of topic
// frames ({level, text, styles, viewBounds, mtgDone, mtgPriority, hideCount, source});
// nTopics, firstTopic, lastTopic and curTopic index it. listViewFlags' bit 2 shows the
// checkboxes, bits 4 and 8 the priorities (by how the code tests them). Sisters share a level
// under one mother; drag and drop, scrub, undo and the keyboard commands work on them. The
// file holds it and what only it reaches.

export121 := {
	// IsEmpty(index): whether the topic has no text.
	IsEmpty: compile(
		options: "names",
		func(anIndex) begin
			if (StrLen(topics[anIndex].text) = 0) then begin
					return true
				end;
			nil
		end),
	// GetTopicCount(): the number of topics.
	GetTopicCount: compile(
		options: "names",
		func() begin
			nTopics
		end),
	// viewDropRemoveScript(dragRef): topics dragged out to another view are removed here (undoable).
	viewDropRemoveScript: compile(
		options: "names",
		func(aDragRef) begin
			local undoDragTo;
			(if (if IsFrame(aDragRef) then HasPath(aDragRef, 'viewCObject)) then nil else begin
					undoDragTo := {index: (aDragRef.index[0] - 1), level: topics[aDragRef.index[0]].level};
					self:RemoveTopicDragDrop(aDragRef, nil);
					self:RedoTopics();
					self.dragTo := nil;
					aDragRef.dragTo := undoDragTo;
					AddUndoAction('UndoDropRemove, [Array: aDragRef]);
					true
				end)
		end),
	// AddKidsToList(list, index, level): adds the topic's descendants' indexes to list.
	AddKidsToList: compile(
		options: "names",
		func(aList, anIndex, aLevel) begin
			if (aLevel = nil) then begin
					aLevel := 1
				end;
			(for ti := (anIndex + 1) to (nTopics - 1) do begin
					if ((topics[ti].level = nil) or (topics[ti].level <= aLevel)) then begin
							break
						end;
					SetAdd(aList, ti, true)
				end)
		end),
	// viewSetupDoneScript: the right margin, and a symbol unique to this view for procrastinated sends.
	viewSetupDoneScript: compile(
		options: "names",
		func() begin
			rightMargin := (self:LocalBox().right + rightIndent);
			(self.uniqueSymbol := Intern(Stringer([Array: "ListView", viewCObject])))
		end),
	// OlderSister(index): the previous topic at the same level under the same mother, or nil.
	OlderSister: compile(
		options: "names",
		func(anIndex) begin
			if (anIndex = 0) then begin
					return nil
				end;
			if ((level := topics[anIndex].level) = nil) then begin
					level := 1
				end;
			local ti;
			local level;
			local topicLevel;
			(for ti := (anIndex - 1) to 0 by -1 do begin
					if ((topicLevel := topics[ti].level) = nil) then begin
							topicLevel := 1
						end;
					if (topicLevel = level) then begin
							return ti
						end else begin
							if (topicLevel < level) then begin
									return nil
								end
						end
				end);
			nil
		end),
	// UndoDropRemove(dragRef): puts topics dragged away back (undo).
	UndoDropRemove: compile(
		options: "names",
		func(aDragRef) begin
			self:AddTopicDragDrop(aDragRef, true, nil);
			self:RedoChildren();
			self.offset := nil;
			indexList := Array(Length(aDragRef.topics), nil);
			local indexList;
			(for i := 0 to (Length(indexList) - 1) do begin
					indexList[i] := ((aDragRef.dragTo.index + 1) + i)
				end);
			AddUndoAction('UndoDropTopic, [Array: indexList])
		end),
	// DeletingTopic(topic): a hook before a topic is deleted (nothing).
	DeletingTopic: compile(
		options: "names",
		func(anIndex) begin
			nil
		end),
	// ActiveTopic(index): makes the topic current, the caret at its end.
	ActiveTopic: compile(
		options: "names",
		func(anIndex) begin
			curTopic := anIndex;
			(if (anIndex <> nil) then SetKeyView(self:TopicIndexToView(anIndex), 99999))
		end),
	// _keyCheckItemScript(keyView): Command-Return - ticks the current topic (with checkboxes).
	_keyCheckItemScript: compile(
		options: "names",
		func(keyView) begin
			local theIndex, theTopic;
			(if (BAnd(listViewFlags, 2) <> 0) then (if curTopic then begin
						theIndex := curTopic;
						theTopic := topics[curTopic];
						self:HandleCheck(theIndex, theTopic)
					end))
		end),
	// Mother(index): the topic's parent (the nearest earlier topic of a lower level), or nil.
	Mother: compile(
		options: "names",
		func(anIndex) begin
			if (anIndex >= nTopics) then begin
					return nil
				end;
			if (((level := topics[anIndex].level) = nil) or (level <= 1)) then begin
					return nil
				end;
			local level;
			(for ti := (anIndex - 1) to 0 by -1 do begin
					if ((topics[ti].level = nil) or (topics[ti].level < level)) then begin
							return ti
						end
				end);
			nil
		end),
	// ReflowTopics(options): the views for the topics from reflowStart that fit the view, each
	// measured as a paragraph (for printing); hidden topics left out when options are given.
	ReflowTopics: compile(
		options: "names",
		func(anOptions) begin
			kids := Array(nTopics, nil);
			ki := 0;
			top := 0;
			image := self:LocalBox();
			lastTopic := reflowStart;
			topics := DeepClone(topics);
			self:LockScreen(true);
			local kids;
			local ti;
			local ki;
			local top;
			local height;
			local template;
			local topic;
			local view;
			local image;
			(for ti := reflowStart to (nTopics - 1) do begin
					topic := topics[ti];
					if (((anOptions = nil) or (topic.hideCount = 0)) or (topic.hideCount = nil)) then begin
							template := (kids[ki] := self:ChildTemplateFromTopic(topic));
							height := (topic.viewBounds.bottom - topic.viewBounds.top);
							template.viewBounds.top := top;
							template.viewBounds.bottom := (top + height);
							template.viewBounds.right := image.right;
							template.viewFlags := vVisible + vCalculateBounds;
							template.styles := self:MungeStyles(template.styles, 12289);
							if (view := AddStepView(self, template)) then begin
									height := view:LocalBox().bottom;
									RemoveStepView(self, view);
									self:SetTopAndLevel(topic, top, 0)
								end;
							if (if ((top := (top + height)) > image.bottom) then (ki <> 0)) then begin
									break
								end;
							lastTopic := ti;
							ki := (ki + 1)
						end
				end);
			self:LockScreen(nil);
			setlength(kids, ki);
			self.stepChildren := nil;
			kids
		end),
	curTopicChanged: nil,
	// RedoTopics(): rebuilds the views, if visible.
	RedoTopics: compile(
		options: "names",
		func() begin
			(if Visible(self) then self:RedoChildren())
		end),
	// HandleScrub(bounds, unit): a scrub over topics' markers deletes them and their descendants
	// (undoable); 'noPoof when nothing may be deleted.
	HandleScrub: compile(
		options: "names",
		func(aBounds, aUnit) begin
			deleteList := [Array: ];
			oldCurTopic := curTopic;
			local topic;
			local ti;
			local MarkerBounds;
			local deleteList;
			local deletedTopics;
			local nToDelete;
			local i;
			local oldCurTopic;
			(for ti := firstTopic to (nTopics - 1) do begin
					if (((topic := topics[ti]).hideCount = nil) or (topic.hideCount = 0)) then begin
							if ((MarkerBounds := InsetRect(self:MarkerBounds(topic), 2, 6)).top > aBounds.bottom) then begin
									break
								end;
							if (BAnd(listViewFlags, 2) <> 0) then begin
									MarkerBounds.left := ((MarkerBounds.left - 13) - 2)
								end;
							if RectsOverlap(aBounds, MarkerBounds) then begin
									if ((not HasPath(topic, 'hideCount)) or (topic.hideCount = 0)) then begin
											SetAdd(deleteList, ti, true);
											self:AddKidsToList(deleteList, ti, topic.level)
										end
								end
						end
				end);
			if ((nToDelete := Length(deleteList)) > 0) then begin
					InkOff(aUnit);
					curTopic := nil;
					deletedTopics := Array(nToDelete, nil);
					(for i := 0 to (nToDelete - 1) do begin
							local result;
							if ((if HasPath((topic := topics[deleteList[i]]), 'source) then (topic.source = nil)) or (ClassOf(topic.source) = 'symbol)) then begin
									self:Notify(3, title, "Can\u2019\ut delete a 1.x formatted To Do item");
									return 'noPoof
								end;
							deletedTopics[i] := topic
						end);
					if ((result := self:DeleteTopics(deleteList)) = nil) then begin
							return 'noPoof
						end;
					if (nTopics = 0) then begin
							curTopic := nil
						end;
					AddUndoAction('UndoScrub, [Array: deleteList, deletedTopics, oldCurTopic]);
					return true
				end;
			nil
		end),
	// viewGetDropDataScript(type, dragRef): dragged topics - as themselves, or as text (bullets, tabs for levels).
	viewGetDropDataScript: compile(
		options: "names",
		func(aDragType, aDragRef) begin
			(if ((aDragType = 'topic) or (aDragType = 'task)) then aDragRef else (if (if (aDragType = 'text) then (not (if IsFrame(aDragRef) then HasPath(aDragRef, 'viewCObject)))) then begin
						local theText;
						local notFirst;
						(foreach topic in aDragRef.topics do begin
								if notFirst then begin
										theText := Stringer([Array: theText, "\n"]);
										if topic.level then begin
												(for t := 1 to (topic.level - aDragRef.level) do begin
														theText := Stringer([Array: theText, "\t"])
													end)
											end;
										theText := Stringer([Array: theText, "\u2022\u", " ", MakeRichString(topic.text, topic.styles)])
									end else begin
										theText := Stringer([Array: "\u2022\u", " ", MakeRichString(topic.text, topic.styles)]);
										notFirst := true
									end
							end);
						{text: theText, viewBounds: RelBounds(0, 0, rightMargin, aDragRef.height)}
					end))
		end),
	// viewGetDropTypesScript(point): what can be dropped there - over a topic, everything; in the
	// marker column, tasks only.
	viewGetDropTypesScript: compile(
		options: "names",
		func(aDropPoint) begin
			box := self:GlobalBox();
			x := (aDropPoint.x - box.left);
			if ((y := (aDropPoint.y - box.top)) <= self:ListBottom()) then begin
					local x;
					local y;
					local box;
					local topic;
					local topicBounds;
					(foreach topic in topics do begin
							(topicBounds := Clone(topic.viewBounds)).left := (topicBounds.left - ((20 + leftMarkGap) + rightMarkGap));
							if (if ((topic.hideCount = 0) or (topic.hideCount = nil)) then IsPtInRect(x, y, topicBounds)) then begin
									return allDropTypes
								end
						end);
					return markerDropTypes
				end;
			allDropTypes
		end),
	// TopicHeight(topic): its height.
	TopicHeight: compile(
		options: "names",
		func(aTopic) begin
			(self:TopicBottom(aTopic) - aTopic.viewBounds.top)
		end),
	// UndoDropTopic(indexes): removes dropped topics (undo), redoable.
	UndoDropTopic: compile(
		options: "names",
		func(aList) begin
			oldCurTopic := curTopic;
			deletedTopics := Array((nToDelete := Length(aList)), nil);
			local oldCurTopic;
			local deletedTopics;
			local nToDelete;
			local topic;
			(for i := 0 to (nToDelete - 1) do begin
					topic := topics[aList[i]];
					deletedTopics[i] := topic
				end);
			self:DeleteTopics(aList);
			AddUndoAction('UndoScrub, [Array: aList, deletedTopics, oldCurTopic])
		end),
	// UndoScrub(indexes, topics, oldCurTopic): puts scrubbed topics back (undo).
	UndoScrub: compile(
		options: "names",
		func(aList, aDeletedTopics, anOldCurTopic) begin
			if ((nItems := Length(aList)) > 1) then begin
					Sort(aList, '|<|, nil)
				end;
			local nItems;
			local i;
			local top;
			local newIndex;
			local theTopic;
			local height;
			(for i := 0 to (nItems - 1) do begin
					newIndex := aList[i];
					height := self:TopicHeight((theTopic := aDeletedTopics[i]));
					if (newIndex < nTopics) then begin
							top := topics[newIndex].viewBounds.top
						end else begin
							top := self:ListBottom()
						end;
					self:AppendTopic(theTopic, newIndex, top, 0);
					self:SetDone(newIndex, topics[newIndex], topics[newIndex].mtgDone, true, nil)
				end);
			self:UpdateMultipleStores(true);
			self:RedoChildren();
			(if (curTopic := anOldCurTopic) then SetKeyView(self:TopicIndexToView(curTopic), 99999))
		end),
	// NewTopic(level, text): a new topic after the current one (and its children) at that level,
	// or at the end; made current and visible (undoable).
	NewTopic: compile(
		options: "names",
		func(aLevel, aText) begin
			local level, theIndex, height, newTopicFont, theTopic, oldCurTopic, curTopicLevel;
			oldCurTopic := curTopic;
			if curTopic then begin
					curTopicLevel := 1;
					if topics[curTopic].level then begin
							curTopicLevel := topics[curTopic].level
						end;
					if (if self:IsCollapsed(curTopic) then (aLevel > curTopicLevel)) then begin
							self:ExpandTopic(curTopic, true)
						end;
					theIndex := (curTopic + 1);
					level := aLevel;
					(while (if (if (theIndex < nTopics) then (topics[theIndex].level <> nil)) then (topics[theIndex].level > level)) do (theIndex := (theIndex + 1)))
				end else begin
					theIndex := nTopics;
					level := 1
				end;
			if self.topicFont then begin
					newTopicFont := topicFont
				end else begin
					newTopicFont := GetInsertionStyle()
				end;
			if (if ((height := FontHeight(newTopicFont)) < viewLineSpacing) then ((height + 6) >= viewLineSpacing)) then begin
					height := viewLineSpacing
				end;
			(theTopic := self:AddEmptyTopic(theIndex, level)).text := Clone(aText);
			theTopic.styles := [Array: StrLen(aText), Clone(newTopicFont)];
			theTopic.viewBounds := RelBounds((((leftMarkGap + ((level - 1) * 20)) + 20) + rightMarkGap), 0, rightMargin, height);
			self:UpdateMultipleStores(true);
			self:RedoTopics();
			AddProcrastinatedSend(uniqueSymbol, self, 'EnsureVisibleTopic, [Array: theIndex], 0);
			self:ActiveTopic(theIndex);
			AddUndoAction('UndoAddTopic, [Array: theIndex, oldCurTopic])
		end),
	// CalcLevel(x): the level a point's x indents to (at most one deeper than the last topic).
	CalcLevel: compile(
		options: "names",
		func(anX) begin
			local theLevel, topicLevel;
			if (nTopics = 0) then begin
					return 1
				end;
			theLevel := Max(1, ((((((anX - 20) - leftMarkGap) - rightMarkGap) + 20) - 1) div 20));
			if (nTopics > 0) then begin
					if ((topicLevel := topics[(nTopics - 1)].level) = nil) then begin
							topicLevel := 1
						end;
					theLevel := Min(theLevel, (topicLevel + 1))
				end;
			return theLevel
		end),
	// the paragraph's viewChangedScript(slot, view): text and style edits go into the topic; a
	// new size makes the list adjust the topics below.
	viewChangedScript: compile(
		options: "names",
		func(aSlot, aView) begin
			local theList, topic;
			if reflow then begin
					return nil
				end;
			if (index = -1) then begin
					return nil
				end;
			(if Visible((theList := list)) then (if ((aSlot = 'text) or (aSlot = 'styles)) then begin
						theList.curTopic := aView.index;
						(topic := theList.topics[aView.index]).text := text;
						topic.styles := styles;
						theList:StartFlush()
					end else (if (aSlot = 'viewBounds) then (if doingScrub then AddDeferredSend(theList, 'ChildChanged, [Array: aView]) else theList:ChildChanged(aView)))))
		end),
	// SetReadOnly(index, status): marks a topic as read-only (no source) or not.
	SetReadOnly: compile(
		options: "names",
		func(anIndex, aStatus) begin
			(if aStatus then (topics[anIndex].source := nil) else RemoveSlot(topics[anIndex], 'source))
		end),
	// _keyAuntScript(keyView): Command-[ - a new topic one level out.
	_keyAuntScript: compile(
		options: "names",
		func(keyView) begin
			(if (maxLevel > 1) then self:NewRelative('aunt))
		end),
	// ShoveBelow(index, delta): moves the first visible topic from index down by delta.
	ShoveBelow: compile(
		options: "names",
		func(anIndex, aDelta) begin
			local topic, kid;
			topic := topics[anIndex];
			(while (if (topic.hideCount <> nil) then (topic.hideCount > 0)) do begin
					if ((anIndex := (anIndex + 1)) >= nTopics) then begin
							return nil
						end;
					(topic := topics[anIndex])
				end);
			if ((kid := self:TopicIndexToView(anIndex)) = nil) then begin
					return nil
				end;
			kid.realData.viewBounds := OffsetRect(kid.viewBounds, 0, aDelta);
			SetValue(kid, 'viewBounds, kid.realData.viewBounds)
		end),
	// GetTopicData(index): the topic's text, styles and level, or nil.
	GetTopicData: compile(
		options: "names",
		func(anIndex) begin
			local topic;
			(if (((anIndex = nil) or (anIndex >= nTopics)) or (anIndex < 0)) then nil else {text: (topic := topics[anIndex]).text, styles: topic.styles})
		end),
	// ResolveClick(x, y): {topicIndex, where: 'marker or 'topic} for a tap, where nil when between topics.
	ResolveClick: compile(
		options: "names",
		func(anX, y) begin
			if ((y > self:ListBottom()) or (nTopics = 0)) then begin
					return {topicIndex: nil}
				end;
			local bounds;
			(for ti := firstTopic to (nTopics - 1) do begin
					bounds := self:ClickBounds(ti);
					if (if (y >= bounds.top) then (y <= bounds.bottom)) then begin
							if (anX > bounds.right) then begin
									return {topicIndex: ti, where: 'topic}
								end;
							return {topicIndex: ti, where: 'marker}
						end
				end);
			(for ti := 0 to (nTopics - 1) do begin
					if (y < (self:MarkerBounds(topics[ti]).top + 4)) then begin
							return {topicIndex: ti, where: nil}
						end
				end);
			{topicIndex: (nTopics - 1), where: nil}
		end),
	// AdjustKids(): lays the topic views out again from the first changed one (topicChanged);
	// keeps the current topic in view.
	AdjustKids: compile(
		options: "names",
		func() begin
			if (not Visible(self)) then begin
					return nil
				end;
			if ((lastKid := (Length((kids := self:ChildViewFrames())) - 1)) = -1) then begin
					adjusting := nil;
					curTopicChanged := nil;
					topicChanged := 999999;
					return nil
				end;
			adjusting := true;
			self:Dirty();
			(try begin
					if ((vi := self:VisibleTopicIndex(topicChanged)) > 0) then begin
							lastView := kids[(vi - 1)]
						end else begin
							lastView := nil
						end;
					local adjustView;
					local lastView;
					local kids;
					local lastKid;
					local vi;
					local topic;
					(for vi := vi to lastKid do begin
							adjustView := kids[vi];
							topic := topics[adjustView.index];
							self:AdjustParagraph(lastView, adjustView, nil, nil);
							topic.viewBounds := adjustView.viewBounds;
							lastView := adjustView
						end);
					if (if curTopicChanged then curTopic) then begin
							self:EnsureVisibleTopic(curTopic)
						end;
					adjusting := nil;
					curTopicChanged := nil;
					(topicChanged := 999999)
				end onexception |evt.ex| do begin
					adjusting := nil;
					curTopicChanged := nil;
					topicChanged := 999999;
					Rethrow()
				end)
		end),
	// UndoAddWriting(index): removes a topic just written (undo).
	UndoAddWriting: compile(
		options: "names",
		func(anIndex) begin
			self:DeleteTopics([Array: anIndex])
		end),
	// ShowFoundItem(entry, finder): shows the topic Find found.
	ShowFoundItem: compile(
		options: "names",
		func(anEntry, aFinder) begin
			local found, ti;
			(if (aFinder.findType = 'text) then (if (found := FindStringInFrame(anEntry.topics, aFinder.findWords, 'first)) then begin
						self:ShowFoundTopic((ti := found[1][0]), found[2], aFinder);
						self:EnsureVisibleTopic(ti)
					end))
		end),
	// viewDropScript(type, data, point): topics dropped in from elsewhere are inserted where they fall (undoable).
	viewDropScript: compile(
		options: "names",
		func(aDropType, aDropData, aDropPt) begin
			(if ((aDropType = 'topic) or (aDropType = 'task)) then begin
					indexList := Array(Length(aDropData.topics), nil);
					local indexList;
					(for i := 0 to (Length(indexList) - 1) do begin
							indexList[i] := ((dragTo.index + 1) + i)
						end);
					self:AddTopicDragDrop(aDropData, nil, true);
					self:RedoTopics();
					AddUndoAction('UndoDropTopic, [Array: indexList]);
					true
				end)
		end),
	// _keySisterScript(keyView): Command-= - a new topic at the same level.
	_keySisterScript: compile(
		options: "names",
		func(keyView) begin
			(if (maxLevel > 1) then self:NewRelative('sister))
		end),
	// UndoAddTopic(index, oldCurTopic): removes a topic just added (undo), redoable by NewTopic.
	UndoAddTopic: compile(
		options: "names",
		func(anIndex, anOldCurTopic) begin
			local topic;
			topic := topics[anIndex];
			self:DeleteTopics([Array: anIndex]);
			if (curTopic := anOldCurTopic) then begin
					SetKeyView(self:TopicIndexToView(curTopic), 99999)
				end;
			AddUndoAction('NewTopic, [Array: topic.level, topic.text])
		end),
	// AddEmptyTopic(index, level): inserts an empty topic; a subtopic starts unticked, and takes
	// its older sister's priority.
	AddEmptyTopic: compile(
		options: "names",
		func(anIndex, aLevel) begin
			local topicFrame, sis;
			topicFrame := self:MakeTopicFrame(aLevel);
			ArrayInsert(topics, topicFrame, anIndex);
			nTopics := (nTopics + 1);
			if (if (aLevel <> 1) then (BAnd(listViewFlags, 2) <> 0)) then begin
					self:SetDone(anIndex, topicFrame, nil, true, true)
				end;
			if (BAnd(listViewFlags, 12) <> 0) then begin
					if (anIndex <> 0) then begin
							if (sis := self:OlderSister(anIndex)) then begin
									topicFrame.mtgPriority := topics[sis].mtgPriority
								end
						end
				end;
			self:StartFlush();
			topicFrame
		end),
	// 999999: no topic changed (topicChanged is the first changed index)
	topicChanged: 999999,
	// SetDone(index, topic, done, up, down): ticks or unticks a topic; down: its descendants
	// too; up: its mother is ticked when all her children are.
	SetDone: compile(
		options: "names",
		func(anIndex, aTopic, aDone, aPropagateUp, aPropagateDown) begin
			if ((level := aTopic.level) = nil) then begin
					level := 1
				end;
			aTopic.mtgDone := aDone;
			if aPropagateDown then begin
					local ti;
					local mom;
