		{char: $[, modifiers: kCommandModifier, keymessage: '_keyAuntScript, name: "New Left", category: nil},
		{char: $], modifiers: kCommandModifier, keymessage: '_keyDaughterScript, name: "New Right", category: nil},
		{char: $=, modifiers: kCommandModifier, keymessage: '_keySisterScript, name: "New Topic", category: nil}
	],
	_proto: @protoListView
};

