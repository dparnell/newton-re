	HandleScrub: compile(
		options: "names",
		func(aBounds, aUnit) begin
			deleteList := [Array: ];
			oldCurTopic := curTopic;
			local topic;
			local ti;
			local MarkerBounds;
			local deleteList;
			local deletedTopics;
			local nToDelete;
			local i;
			local oldCurTopic;
			(for ti := firstTopic to (nTopics - 1) do begin
					if (((topic := topics[ti]).hideCount = nil) or (topic.hideCount = 0)) then begin
							if ((MarkerBounds := InsetRect(self:MarkerBounds(topic), 2, 6)).top > aBounds.bottom) then begin
									break
