		end),
	adjusting: nil,
	// CheckFlags(): vLettersAllowed when the letter-by-letter cursive option is on.
	CheckFlags: compile(
		options: "names",
		func() begin
			(if (GetUserConfig('lettersCursiveOption) <> nil) then vLettersAllowed else 0)
		end),
	// UndoCheck(doneList): puts the ticks back as they were (undo).
	UndoCheck: compile(
		options: "names",
		func(aList) begin
			(for ti := 0 to (nTopics - 1) do begin
					topics[ti].mtgDone := aList[ti]
				end);
			self:StartFlush();
			self:Dirty()
		end),
	// NewRelative(relation): a new 'sister, 'aunt (one level out) or 'daughter (one level in) of the current topic.
	NewRelative: compile(
		options: "names",
		func(aRelation) begin
			local level, theIndex;
			if curTopic then begin
					theIndex := (curTopic + 1);
					level := topics[curTopic].level;
					if (aRelation = 'aunt) then begin
							level := Max(1, (level - 1))
						end else begin
							if (aRelation = 'daughter) then begin
									level := Min(maxLevel, (level + 1))
								end
						end
				end else begin
					theIndex := nTopics;
					if (nTopics = 0) then begin
							level := 1
						end else begin
							level := topics[(theIndex - 1)].level;
							if (aRelation = 'aunt) then begin
									level := Max(1, (level - 1))
								end else begin
