					level := Max(1, ((((aNewOne.viewBounds.left - 20) - leftMarkGap) - rightMarkGap) div 20));
					if HasPath((prevTopic := topics[(theIndex - 1)]), 'level) then begin
							prevLevel := prevTopic.level
						end else begin
							prevLevel := 1
						end;
					if (level > prevLevel) then begin
							level := (prevLevel + 1)
						end;
