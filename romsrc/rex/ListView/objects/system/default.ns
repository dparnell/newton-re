// default: the Outline stationery's editor view def - the outline list (@8338) and a floating
// bar with the new-topic buttons. The file holds it and what only it reaches.

default := {
	viewClass: clView,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewFlags: vVisible + vClickable + vStrokesAllowed + vGesturesAllowed,
	viewJustify: vjParentFullH + vjParentFullV,
	version: 1,
	type: 'editor,
	symbol: 'default,
	name: outline,
	appAll: "All Outlines",
	appObject: [|Array|: outline, "Outlines"],
	path: 'topics,
	realData: nil,
	viewDefHeight: 36,
	rollScrolling: true,
	// MinimalBounds(entry): the note's height - down to the last visible topic (16 at least).
	MinimalBounds: compile(
		options: "names",
		func(anEntry) begin
			local top, n, theTopic, ti;
			if ((n := Length(anEntry.topics)) > 0) then begin
					ti := (n - 1);
					theTopic := anEntry.topics[ti];
					(while (if (if (ti >= 0) then (theTopic.hideCount <> nil)) then (theTopic.hideCount > 0)) do begin
							ti := (ti - 1);
							(theTopic := anEntry.topics[ti])
						end);
					top := Max(theTopic.viewBounds.bottom, (theTopic.viewBounds.top + 16))
				end else begin
					top := 16
				end;
			SetBounds(0, 0, 240, top)
		end),
	// ShowFoundItem(entry, finder): shows what Find found.
	ShowFoundItem: compile(
		options: "names",
		func(anEntry, aFinder) begin
			editor:ShowFoundItem(anEntry, aFinder)
		end),
	debug: 1100,
	stepChildren: [stepChildren: @8338, menuButtons],
	editor: nil,
	stepallocatecontext: [|Array|: 'editor, @8338, 'menuButtons, menuButtons],
	menuButtons: nil
};

// the floating bar: the new left, new topic and new right buttons
menuButtons := {
	debug: "Yo",
	menuButtons: [|Array|: @8315, @8316, @8314],
	preallocatedContext: 'menuButtons,
	_proto: @newtFloatingBar
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

MinimalBounds_code := same("default.MinimalBounds.instructions");

ShowFoundItem_code := same("default.ShowFoundItem.instructions");
