@@ 0x78d11d names
func(anIndex) begin
	local ourBox, layoutBox, starts, ends, amt;
	if (not Visible(self)) then begin
			return nil
		end;
	ourBox := self:GlobalBox();
	layoutBox := targetView:parent():GlobalBox();
	starts := (topics[anIndex].viewBounds.top + ourBox.top);
	ends := (self:TopicBottom(topics[anIndex]) + ourBox.top);
	if (starts < layoutBox.top) then begin
			amt := (starts - layoutBox.top)
		end else begin
			if (ends > ((layoutBox.bottom - 20) - 8)) then begin
					amt := (((ends - layoutBox.bottom) + 20) + 8)
				end
		end;
	if (if amt then (Abs(amt) > 4)) then begin
			AddDeferredSend(layout, 'PixelScrollBy, [Array: 0, amt])
		end;
	ourBox.bottom := self:ListBottom();
	self:StartFlushWithChild({viewBounds: ourBox})
end
@@end
