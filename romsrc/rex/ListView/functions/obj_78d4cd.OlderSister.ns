@@ 0x78cab5 names
func(anIndex) begin
	if (anIndex = 0) then begin
			return nil
		end;
	if ((level := topics[anIndex].level) = nil) then begin
			level := 1
		end;
	local ti;
	local level;
	local topicLevel;
	(for ti := (anIndex - 1) to 0 by -1 do begin
			if ((topicLevel := topics[ti].level) = nil) then begin
					topicLevel := 1
				end;
			if (topicLevel = level) then begin
					return ti
				end else begin
					if (topicLevel < level) then begin
							return nil
						end
				end
		end);
	nil
end
@@end
