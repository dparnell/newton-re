// The FaxViewer package's frames part: the viewer for received faxes (and other
// 'ImageView entries - pages of bitmaps with ink annotations) that the In Box
// and Out Box open, with its print format and its route format.  The part frame
// registers the data definition 'ImageView and three data views for it; the
// viewer itself (ImageViewerDef) is a full-page editor holding a protoImageView
// per page, a floating bar (scrollers, Tools popup, "Page n of m" popup), a
// thumbnail floater and a page-navigator palette of thumbnails.

part := array(nil, {
	// The package's installScript: makes the removeScript frame (an EnsureInternal
	// copy, so it outlives the package's frames) and has devInstallScript register.
	installScript: func(partFrame) begin
		local ensureInternal2;
		ensureInternal2 := EnsureInternal({removeScript: partFrame.devRemoveScript});
		partFrame:devInstallScript(partFrame, ensureInternal2);
		ensureInternal2
	end,
	// Registers the 'ImageView data definition and its viewer, print format and
	// route format with the system (RegDataDef/RegDataView).
	devInstallScript: func(partFrame, removeFrame) begin
		RegDataDef('ImageView, partFrame.partData.ImageDataDef);
		RegDataView('ImageView, partFrame.partData.ImageViewerDef);
		RegDataView('ImageView, partFrame.partData.ImagePrintFormat);
		RegDataView('ImageView, partFrame.partData.faxViewerRouteFormat)
	end,
	// Undoes devInstallScript: the data definition and its three views by symbol.
	devRemoveScript: func(partFrame) begin
		UnRegDataDef('ImageView);
		UnRegDataView('ImageView, 'default);
		UnRegDataView('ImageView, 'ImagePrintFormatSym);
		UnRegDataView('ImageView, 'imageRouteFormat)
	end,
	// The data definitions and views the install script registers.
	partData: {
		// Lets the entry be routed as a frame (beamed, mailed): 'imageRouteFormat.
		faxViewerRouteFormat: {
			_proto: @targetFrameFormat,
			symbol: 'imageRouteFormat,
			storeAlias: true,
			sizeLimit: nil,
			dataTypes: [|Array|: 'frame]
		},
		ImageDataDef: {
			symbol: 'ImageView,
			name: image,
			superSymbol: 'imagery,
			description: "Picture",
			icon: nil,
			version: 1,
			metadata: nil,
			// A data definition's SetupForm: nothing to set up.
			SetupForm: func(entry, a2) begin
				nil
			end,
			// The text the In Box and Find show for an entry: its title, or "Untitled fax".
			StringExtract: func(entry, nLines) begin
				(if (if entry.title then (Length(entry.title) > 0)) then entry.title else "Untitled fax")
			end,
			viewClass: clView
		},
		// The print format: prints the entry's pages one per printed page, fitted to the
		// page; "Data unavailable" when there is no target.
		ImagePrintFormat: {
			viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
			name: image,
			symbol: 'ImagePrintFormatSym,
			title: image,
			version: 1,
			stepChildren: [stepChildren: partItem, partItem_2],
			// Called by the print loop for each page after the first: advances fPageIndex
			// and lays the next page into ImageTarget; nil (no more pages) past the last.
			printNextPageScript: func() begin
				if (not target) then begin
						return nil
					end;
				ImageTarget:PrepareToPrint((fPageIndex := (fPageIndex + 1)))
			end,
			fPageIndex: 0,
			margins: {left: 0, top: 0, right: 0, bottom: 0},
			// The number of pages the print job has: one per page of the entry.
			CountPages: func(fields, target) begin
				Length(target.pages)
			end,
			declareSelf: 'printBase,
			// With no entry to print, shows the "Data unavailable" text and hides the image.
			viewSetupFormScript: func() begin
				inherited:?viewSetupFormScript();
				(if (not target) then begin
						nodata.viewFlags := BOr(nodata.viewFlags, vVisible);
						(ImageTarget.viewFlags := 0)
					end)
			end,
			PrintType: 'ReceivedFax,
			storeAlias: true,
			sizeLimit: nil,
			_proto: @protoPrintFormat,
			nodata: nil,
			stepAllocateContext: [|Array|: 'nodata, partItem, 'ImageTarget, partItem_2],
			ImageTarget: nil
		},
		// The viewer (the 'default data view of 'ImageView).
		ImageViewerDef: {
			type: 'editor,
			fEntryStore: nil,
			viewFormat: nil,
			viewFlags: vVisible,
			nodata: nil,
			PageButton: nil,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
			vPageNavigator: nil,
			symbol: 'default,
			// Find's hook: for a text find, goes to the first page whose annotations hold
			// one of the found words, at full size, and scrolls that annotation to the
			// middle of the view.
			ShowFoundItem: func(a1, a2) begin
				(if (a2.findType = 'text) then (for i := 0 to (Length(a1.pages) - 1) do begin
							if (annotations := a1.pages[i].annotations) then begin
									local annotations;
									(foreach item in annotations do begin
											local viewBounds, l8, l9, box, l11, l12;
											if FindStringInFrame(item, a2.findWords, 'text) then begin
													imageContainer:GotoPage((i + 1));
													ImageTarget:ZoomTo('fullSize);
													l8 := (((viewBounds := item.viewBounds).right - viewBounds.left) div 2);
													l9 := ((viewBounds.bottom - viewBounds.top) div 2);
													l11 := (((box := self:LocalBox()).right - box.left) div 2);
													l12 := ((box.bottom - box.top) div 2);
													ImageTarget:ScrollTo(((viewBounds.left + l8) - l11), ((viewBounds.top + l9) - l12));
													return nil
												end
										end)
								end
						end))
			end,
			viewJustify: vjParentFullH + vjParentFullV,
			imageContainer: nil,
			ImageTarget: nil,
			name: image,
			stepAllocateContext: [|Array|:
				'nodata,
				partItem_3,
				'vScrollers,
				partItem_4,
				'PageButton,
				pageOf,
				'floatingBar,
				partItem_5,
				'ImageTarget,
				partItem_6,
				'pagePalette,
				partItem_7,
				'vPageNavigator,
				partItem_8,
				'imageContainer,
				partItem_9
			],
			// With no entry, shows "Data unavailable" and hides the bar and the image.
			viewSetupFormScript: func() begin
				(if (not target) then begin
						nodata.viewFlags := BOr(nodata.viewFlags, vVisible);
						floatingBar.viewFlags := 0;
						(imageContainer.viewFlags := 0)
					end)
			end,
			viewClass: clView,
			pagePalette: nil,
			stepChildren: [stepChildren: partItem_3, partItem_5, partItem_9],
			vScrollers: nil,
			floatingBar: nil
		}
	}
});

image := "Image";

// The "Data unavailable" text of the print format (nodata).
partItem := {
	text: dataUnavailable,
	viewBounds: {left: 0, top: 90, right: 250, bottom: 120},
	viewFlags: vReadOnly,
	viewFont: tsSystem + tsSize(24) + tsBold,
	viewJustify: vjCenterH + vjCenterV + vjParentCenterH + oneLineOnly,
	_proto: @protoStaticText,
	preAllocatedContext: 'nodata
};

dataUnavailable := "Data unavailable";

// The print format's image: a protoImageView fitted to the page.
partItem_2 := {
	annotations: nil,
	image: nil,
	// Lays page a1 (0-based) of the entry into the view, fitted to the window;
	// true if there is such a page, nil past the last.
	PrepareToPrint: func(a1) begin
		local page;
		(if (a1 < target.info.pageCount) then begin
				ImageTarget:setup((page := target.pages[a1]).image, page.annotations, nil);
				ImageTarget:ZoomTo('fitInWindow);
				true
			end)
	end,
	scalingInfo: nil,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewFormat: vfFillWhite,
	viewJustify: vjCenterH + vjCenterV + vjParentFullH + vjParentFullV,
	// Lays the first page in once the view is set up.
	viewSetupDoneScript: func() begin
		self:PrepareToPrint((fPageIndex := 0))
	end,
	fImage: nil,
	fAnnotations: nil,
	imageFormat: 1,
	_proto: @protoImageView,
	preAllocatedContext: 'ImageTarget
};

// The viewer's "Data unavailable" text (nodata).
partItem_3 := {
	text: dataUnavailable,
	viewBounds: {left: 0, top: 90, right: 180, bottom: 120},
	viewFlags: vReadOnly,
	viewFont: tsSystem + tsSize(10) + tsBold,
	viewJustify: vjCenterH + vjCenterV + vjParentCenterH + oneLineOnly,
	_proto: @protoStaticText,
	preAllocatedContext: 'nodata
};

// The viewer's 2D scroller (vScrollers), scrolling imageContainer.
partItem_4 := {
	// Scrolls imageContainer.
	viewSetupFormScript: func() begin
		inherited:?viewSetupFormScript();
		(self.scrollView := imageContainer)
	end,
	// Called with ImageTarget's scaling info when it changes: hides the scrollers
	// when the image is fitted to the window, otherwise sets their extent, the
	// visible box and the offsets and redraws the arrows.
	Update: func(scalingInfo) begin
		(if (scalingInfo.zoomedTo = 'fitInWindow) then begin
				hidden := true;
				self:Hide();
				return nil
			end else begin
				if hidden then begin
						self:Open()
					end;
				scrollRect := scalingInfo.extent;
				dataRect := scalingInfo.extent;
				viewRect := scalingInfo.viewBox;
				xPos := scalingInfo.OffsetX;
				yPos := scalingInfo.OffsetY;
				self:AdjustArrows()
			end)
	end,
	// After a scroll, follows ImageTarget's new scaling info.
	ViewScrollDoneScript: func() begin
		self:Update(ImageTarget:GetScalingInfo())
	end,
	viewBounds: {top: -19, left: 0, right: 65, bottom: -1},
	viewFlags: 0,
	hidden: true,
	_proto: @protoHorizontal2Dscroller,
	preAllocatedContext: 'vScrollers
};

// The "Page n of m" button on the floating bar (PageButton): a popup of the
// first nine pages and, for more than one, "Show/Hide Page View".
pageOf := {
	viewBounds: {left: 0, top: 0, right: 74, bottom: 17},
	viewJustify: vjCenterH + vjCenterV + vjParentCenterV + oneLineOnly,
	// Called by imageContainer:Update with the current page number (the argument
	// is the page, though named scalingInfo); its first piece, ﰁ, is the popup diamond.
	Update: func(scalingInfo) begin
		SetValue(self, 'text, ParamStr("^0 ^1 of ^2", [Array: "\uFC01\u", scalingInfo, Length(target.pages)]))
	end,
	popup: [|Array|: ],
	viewFlags: vVisible + vReadOnly + vClickable,
	viewFormat: vfFillWhite + vfRound(4),
	// Builds the popup: an item for each of the first nine pages, then a separator
	// and the page-view item.
	viewSetupFormScript: func() begin
		self.numVisiblePages := min(9, Length(target.pages));
		l1 := (numVisiblePages + (if (numVisiblePages > 1) then 2 else 0));
		self.popup := Array(l1, nil);
		local l1;
		(for i := 1 to numVisiblePages do begin
				local text;
				text := ParamStr("Page ^0", [Array: i]);
				popup[(i - 1)] := {item: text}
			end);
		(if (numVisiblePages > 1) then begin
				popup[numVisiblePages] := 'pickSeparator;
				(popup[(numVisiblePages + 1)] := "Show Previewer")
			end)
	end,
	// A page item goes to that page; the last item toggles the page navigator.
	pickActionScript: func(index) begin
		if ((index + 1) <= numVisiblePages) then begin
				imageContainer:GotoPage((index + 1))
			end else begin
				vPageNavigator:ToggleNavigator(imageContainer:GetCurrentPage())
			end;
		self:hilite(nil)
	end,
	// Shows the popup with the current page checked (ﰋ, the check mark) and
	// the last item's text matching whether the page view is open.
	buttonClickScript: func() begin
		local currentPage;
		if markedPage then begin
				popup[markedPage].mark := $ 
			end;
		markedPage := nil;
		if ((currentPage := imageContainer:GetCurrentPage()) <= numVisiblePages) then begin
				markedPage := (currentPage - 1);
				popup[markedPage].mark := $\uFC0B
			end;
		if (numVisiblePages > 1) then begin
				popup[(Length(popup) - 1)] := (if Visible(vPageNavigator) then "Hide Page View" else "Show Page View")
			end;
		DoPopup(popup, self:LocalBox().right, 2, self)
	end,
	// Looks unused: a template for a page item, which buttonClickScript does not use.
	fPageProto: {
		item: "1",
		mark: $\u0020,
		page: 1,
		doit: func() begin
			imageContainer:GotoPage(page)
		end
	},
	markedPage: nil,
	numVisiblePages: nil,
	text: "ﰁPage 9 of 9",
	// Pops the menu up when the pen is lifted inside the button.
	viewClickScript: func(unit) begin
		if self:TrackHilite(unit) then begin
				self:buttonClickScript()
			end;
		true
	end,
	// Unhilites the button when the popup is dismissed.
	pickCancelledScript: func() begin
		self:hilite(nil)
	end,
	_proto: @protoStaticText,
	preAllocatedContext: 'PageButton
};

// The floating bar at the foot of the viewer: scrollers, Tools and the page button.
partItem_5 := {
	viewBounds: {left: 0, top: -20, right: 0, bottom: 0},
	viewFlags: vVisible,
	viewFormat: nil,
	stepChildren: [stepChildren: partItem_4, tools, pageOf],
	viewJustify: vjParentFullH + vjParentBottomV,
	_proto: @newtFloatingBar,
	FaxTools: nil,
	stepAllocateContext: [|Array|: 'FaxTools, tools],
	preAllocatedContext: 'floatingBar
};

// The Tools popup button (FaxTools): zoom stops, enlarge/reduce, annotate or
// drag, and the three rotations.  Each item's doit is sent with imageContainer.
tools := {
	popItem_FitInWindow: {
		mark: $\u0020,
		item: "Fit In Window",
		zoomStop: 'fitInWindow,
		// Fits the page to the window (unless it already is) and leaves annotation mode.
		doit: func(imageContainer) begin
			local value;
			(if ((value := GetVariable(imageContainer, 'ImageTarget)):GetScalingInfo().zoomedTo <> 'fitInWindow) then begin
					value:SetAnnotationMode('Show);
					value:ZoomTo('fitInWindow)
				end)
		end
	},
	popItem_FullRes: {
		mark: $\u0020,
		item: "Full Resolution",
		zoomStop: 'fullResolution,
		// Shows the page at the device's full resolution and leaves annotation mode.
		doit: func(imageContainer) begin
			local value;
			(if ((value := GetVariable(imageContainer, 'ImageTarget)):GetScalingInfo().zoomedTo <> 'fullResolution) then begin
					value:SetAnnotationMode('Show);
					value:ZoomTo('fullResolution)
				end)
		end
	},
	popItem_FullSize: {
		mark: $\u0020,
		item: "Original Size",
		zoomStop: 'fullSize,
		// Shows the page at its original size and leaves annotation mode.
		doit: func(imageContainer) begin
			local value;
			(if ((value := GetVariable(imageContainer, 'ImageTarget)):GetScalingInfo().zoomedTo <> 'fullSize) then begin
					value:SetAnnotationMode('Show);
					value:ZoomTo('fullSize)
				end)
		end
	},
	preAllocatedContext: 'FaxTools,
	viewFlags: vVisible + vReadOnly + vClickable,
	// Builds the Tools popup afresh each time: the thumbnail item, the zoom stops
	// ImageTarget offers (the current one checked), enlarge/reduce where possible,
	// the annotation-mode pair when the entry may be changed (EntryCool), and the
	// rotations when the entry's store is writable.
	buttonClickScript: func() begin
		popup := [Array: (frame2 := {_proto: popItem_ShowThumb, item: (if Visible(imageContainer.vThumbFloater) then "Hide Thumbnail" else "Show Thumbnail")}), 'pickSeparator];
		zoomStops := ImageTarget.zoomStops;
		zoomedTo := ImageTarget:GetScalingInfo().zoomedTo;
		local frame2;
		local zoomStops;
		local zoomedTo;
		local l4;
		local l5;
		(foreach item in popSizeItems do begin
				local l8, popItem_Drag2;
				frame2 := self.(item);
				if ArrayPos(zoomStops, frame2.zoomStop, 0, nil) then begin
						if (frame2.zoomStop = zoomedTo) then begin
								frame2 := {_proto: frame2, item: frame2.item, mark: $\uFC0B}
							end;
						AddArraySlot(popup, frame2)
					end
			end);
		AddArraySlot(popup, 'pickSeparator);
		l8 := nil;
		if ImageTarget:CanZoomBy(1) then begin
				AddArraySlot(popup, popItem_Enlarge);
				l8 := true
			end;
		if ImageTarget:CanZoomBy(-1) then begin
				AddArraySlot(popup, popItem_Reduce);
				l8 := true
			end;
		if self:?EntryCool(nil) then begin
				if l8 then begin
						AddArraySlot(popup, 'pickSeparator)
					end;
				frame2 := popItem_Annotate;
				popItem_Drag2 := popItem_Drag;
				if (ImageTarget:GetAnnotationMode() = 'edit) then begin
						(frame2 := Clone(frame2)).mark := $\uFC0B
					end else begin
						(popItem_Drag2 := Clone(popItem_Drag2)).mark := $\uFC0B
					end;
				AddArraySlot(popup, frame2);
				AddArraySlot(popup, popItem_Drag2)
			end;
		if (not fEntryStore:IsReadOnly()) then begin
				AddArraySlot(popup, 'pickSeparator);
				AddArraySlot(popup, popItem_RotateRight);
				AddArraySlot(popup, popItem_Rotate180);
				AddArraySlot(popup, popItem_RotateLeft)
			end;
		inherited:?buttonClickScript()
	end,
	viewBounds: {left: -43, top: 0, right: -6, bottom: 13},
	popItem_Rotate180: {
		item: "Rotate 180°",
		mark: $\u0020,
		// Rotates the page half a turn (DoMunge asks first when it has annotations).
		doit: func(imageContainer) begin
			imageContainer:DoMunge('rotate180)
		end
	},
	_proto: @protoPopupButton,
	popItem_ShowThumb: {
		item: "",
		// Shows or hides the thumbnail floater with the current page's thumbnail.
		doit: func(imageContainer) begin
			GetVariable(imageContainer, 'vThumbFloater):ToggleThumbnail(imageContainer:MakeAndStashThumbnail(imageContainer:GetCurrentPage()))
		end
	},
	popItem_Drag: {
		item: "Drag with Stylus",
		mark: $\u0020,
		// Leaves annotation mode: a stroke drags (scrolls) the page.
		doit: func(imageContainer) begin
			GetVariable(imageContainer, 'ImageTarget):SetAnnotationMode('Show)
		end
	},
	viewJustify: vjCenterH + vjCenterV + vjParentRightH + vjParentCenterV + oneLineOnly,
	popItem_Reduce: {
		item: "Reduce Fax",
		// Zooms out one step.
		doit: func(imageContainer) begin
			GetVariable(imageContainer, 'ImageTarget):SetAnnotationMode('Show);
			GetVariable(imageContainer, 'ImageTarget):ZoomBy(-1)
		end
	},
	popItem_RotateLeft: {
		item: "Rotate left",
		mark: $\u0020,
		// Rotates the page a quarter turn anticlockwise.
		doit: func(imageContainer) begin
			imageContainer:DoMunge('rotateLeft)
		end
	},
	popup: [|Array|: ],
	popItem_Annotate: {
		item: "Write with Stylus",
		mark: $\u0020,
		// Zooms to the original size and enters annotation mode: strokes become ink.
		doit: func(imageContainer) begin
			local value;
			if ((value := GetVariable(imageContainer, 'ImageTarget)):GetScalingInfo().zoomedTo <> 'fullSize) then begin
					value:ZoomTo('fullSize)
				end;
			value:SetAnnotationMode('edit)
		end
	},
	// Runs the chosen item's doit with imageContainer.
	pickActionScript: func(index) begin
		local popupItem;
		if (if IsFrame((popupItem := popup[index])) then popupItem.doit) then begin
				popupItem:doit(imageContainer)
			end;
		inherited:?pickActionScript(index)
	end,
	text: "  Tools",
	popItem_Enlarge: {
		item: "Enlarge Fax",
		// Zooms in one step.
		doit: func(imageContainer) begin
			GetVariable(imageContainer, 'ImageTarget):SetAnnotationMode('Show);
			GetVariable(imageContainer, 'ImageTarget):ZoomBy(1)
		end
	},
	popItem_RotateRight: {
		item: "Rotate right",
		mark: $\u0020,
		// Rotates the page a quarter turn clockwise.
		doit: func(imageContainer) begin
			imageContainer:DoMunge('rotateRight)
		end
	},
	popSizeItems: [|Array|: 'popItem_FitInWindow, 'popItem_FullSize, 'popItem_FullRes]
};

// The page itself (ImageTarget): a protoImageView inside imageContainer.
partItem_6 := {
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	// protoImageView's notification that the zoom or scroll changed: updates the
	// thumbnail's grey box and shows, updates or closes the scrollers.
	ScalingInfoChanged: func(a1) begin
		if Visible(vThumbFloater) then begin
				vThumbFloater:Update()
			end;
		if ImageTarget:CanScroll() then begin
				if (not Visible(vScrollers)) then begin
						vScrollers:Open()
					end;
				vScrollers:Update(ImageTarget:GetScalingInfo())
			end else begin
				vScrollers:Close()
			end;
		ImageTarget:dirty()
	end,
	viewFlags: vVisible + vClipping + vClickable,
	viewFormat: vfFillWhite + vfPen(1),
	viewJustify: vjCenterH + vjCenterV + vjParentFullH + vjParentFullV,
	cacheScaledImage: true,
	dragCorridor: 15,
	dragAcceleration: 50,
	// ZoomTo, with a "Changing magnification" status slip (the ROM's usual
	// status-slip helper, kLiteral_766fc5) while it works - except while the
	// viewer is still being set up (initializing).
	ZoomTo: compile(
		constants: {
			// The status slip's OpenDlog(kind, status, title): kind nil a barber pole, a
			// non-symbol a gauge, else the named template; 'default title means none.
			kFunction_7670a5: func(a1, a2, a3) begin
				local frame2;
				warningName := (if (not a1) then 'vBarber else (if (ClassOf(a1) <> 'symbol) then 'vGauge else a1));
				if (a3 = 'default) then begin
						a3 := nil
					end;
				if (not a2) then begin
						a2 := fTitle
					end;
				fTitle := a2;
				self:viewset((frame2 := {name: warningName, values: {icon: @routeFaxBitmap, statusText: a2, titleText: a3, barber: (warningName = 'vBarber), gauge: (if (warningName = 'vGauge) then 1), closeBox: nil, primary: nil}}));
				self:Open();
				(if (warningName = 'vBarber) then self:SetupIdle(300) else self:SetupIdle(0))
			end,
			// Moves the gauge (a1[0]) or spins the barber pole.
			kFunction_7672d5: func(a1) begin
				(if ((warningName = 'vGauge) or (warningName = 'vBarber)) then self:UpdateIndicator({name: warningName, values: {gauge: (if (warningName = 'vGauge) then a1[0]), barber: (warningName = 'vBarber)}}))
			end,
			// Keeps a barber pole turning: an idle every 300 ms.
			kFunction_76738d: func() begin
				self:Update(nil);
				300
			end,
			kLiteral_766fc5: {OpenDlog: kFunction_7670a5, Update: kFunction_7672d5, viewIdleScript: kFunction_76738d, fTitle: nil, warningName: nil, viewEffect: 236577, _proto: @protoStatusTemplate}
		},
		func(a1) begin
			if (not initializing) then begin
					if (WarningDialog = nil) then begin
							WarningDialog := BuildContext(kLiteral_766fc5)
						end;
					WarningDialog:OpenDlog('vStatus, "Changing magnification", nil)
				end;
			inherited:ZoomTo(a1);
			(if (if (not initializing) then WarningDialog) then begin
					WarningDialog:Close();
					(WarningDialog := nil)
				end)
		end),
	// ZoomBy (a step in or out), with the same status slip.
	ZoomBy: compile(
		constants: {
			kFunction_7670a5: func(a1, a2, a3) begin
				local frame2;
				warningName := (if (not a1) then 'vBarber else (if (ClassOf(a1) <> 'symbol) then 'vGauge else a1));
				if (a3 = 'default) then begin
