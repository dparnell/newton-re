@@ 0x599405
func() begin
	local l1, l2;
	l2 := (if fields.appSymbol then GetVariable(self, fields.appSymbol));
	l1 := activeFormat.TextScript;
	fields.text := " ";
	(if l1 then (if (if IsSymbol(l1) then l2) then (fields.text := Perform(l2, l1, [Array: fields, target])) else (if IsFunction(l1) then (fields.text := call l1 with (fields, target)))))
end
@@end
