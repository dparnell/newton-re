@@ 0x521901
func() begin
	local l1, l2;
	contentArea := self;
	CuPage := self;
	self:TurnToPage(pageNum);
	(if showMarks then (if (l2 := (if (l1 := fields.body.printMarks) then LSearch(l1, pageNum, 0, '|=|, nil))) then begin
				printMarks.viewChildren := l1[(l2 + 1)];
				printMarks:Open()
			end))
end
@@end
