			PostCommand(HiliteOwner(), 48)
		end;
	l1 := self:LocalBox();
	if (a1 > 0) then begin
			l3 := (if ((l2 := dataCursor:entry()).height = nil) then 0 else (l2.height + (l1.bottom div 3)));
			if (if (l2 <> lastItem) then ((l3 - viewOriginY) < l1.bottom)) then begin
					viewOriginY := 0;
