@@ 0x549749
func(a1) begin
	if a1 then begin
			if self.justHilited then begin
					RemoveSlot(self, 'justHilited)
				end else begin
					self.hilitedShape := self:GetIconShapeHilited();
					self.justHilited := true;
					self:Dirty()
				end
		end else begin
			RemoveSlot(self, 'hilitedShape);
			self:Dirty()
		end;
	true
end
@@end
