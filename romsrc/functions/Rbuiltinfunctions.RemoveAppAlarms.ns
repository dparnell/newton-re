@@ 0x4221c9
func(alarmKeySuffix) begin
	local l1, l2, l3;
	l1 := 0;
	l3 := (l2 := GetStores()[0]:GetSoup("SystemAlarmSoup"):Query({indexPath: 'key, IndexValidTest: func(a1) begin
		EndsWith(a1, alarmKeySuffix)
	end})):entry();
	(while l3 do begin
			l1 := (l1 + 1);
			EntryRemoveFromSoup(l3);
			(l3 := l2:Next())
		end);
	if (l1 > 0) then begin
			SetNextAlarm()
		end;
	l1
end
