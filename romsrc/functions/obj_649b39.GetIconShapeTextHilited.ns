@@ 0x549245
func() begin
	if shape then begin
			l1 := shape[(Length(shape) - 1)]
		end else begin
			l1 := self:GetIconShapeText()
		end;
	l2 := iconStyle.font;
	l3 := 0;
	local l1;
	local l2;
	local l3;
	(foreach l4 in l1 do begin
			local l6;
			l3 := max(l3, StrFontWidth(l4.data, l2))
		end);
	l6 := RelBounds(((hSpacing - l3) div 2), iconBottom, (l3 + 1), (3 + (Length(l1) * (FontAscent(l2) - 1))));
	[Array: l1, '{transferMode: 2, penPattern: 0, fillPattern: 5}, MakeShape(l6)]
end
@@end
