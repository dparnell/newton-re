@@ 0x4b9711
func(a1) begin
	local l1, l2, l3;
	(if ((not StrFilled(a1)) or IsRichString(a1)) then a1 else begin
			validDate := IsValidDate((l1 := StringToDateFrame(a1)));
			if (l1.year = nil) then begin
					l1.year := 2920
				end;
			l2 := TotalMinutes(l1);
			l3 := target.(path);
			(if l2 then (if (if l3 then IsImmediate(l3)) then ((l2 - (l2 mod 1440)) + (l3 mod 1440)) else (l2 - (l2 mod 1440))))
		end)
end
