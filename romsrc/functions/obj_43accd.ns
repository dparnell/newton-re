						self:DrawShape(OffsetShape((shapes := (if l3 then MakeShape(CheckOn) else MakeShape(CheckOff))), (l1.left + checkBoxHorzOffset), ((l1.top + checkBoxVertOffset) + (a2 * lineHeight))), {transferMode: 0, penPattern: 0, fillPattern: 1})
