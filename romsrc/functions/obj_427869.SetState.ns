@@ 0x427849
func(a1, a2, a3) begin
	local l1;
	l1 := nil;
	if (a2 = 1) then begin
			if (GetUserConfig('inputDevice) <> nil) then begin
					if a3 then begin
							l1 := "Ready to play or record."
						end else begin
							l1 := "Ready to record."
						end
				end else begin
