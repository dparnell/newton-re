@@ 0x4f1b69
func(a1) begin
	local l1, l2, l3;
	(l1 := repeatPickers).DayPicker:Hide();
	l1.datepicker:Hide();
	l1.DateAndMonthPicker:Hide();
	l1.WeekPicker:Hide();
	l1.LastWeekPicker:Hide();
	repeatType := a1;
