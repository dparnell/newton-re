@@ 0x51f8dd
func() begin
	if (not stepChildren) then begin
			stepChildren := [Array: ]
		end else begin
			self.stepChildren := [Array: ]
		end;
	if (not copperfield.panelOpen) then begin
			self.viewChildren := Clone(collapsedKids);
			SetValue(self, 'viewBounds, RelBounds(-30, -14, 30, 14))
		end else begin
			extraWidth := 0;
			if leftButtons then begin
					(foreach l1, l2 in leftButtons do begin
							if (if HasPath(l2, 'text) then HasPath(l2, 'viewFont)) then begin
									l4 := (StrFontWidth(l2.text, l2.viewFont) + 6)
								end else begin
									l4 := (l2.viewBounds.right - l2.viewBounds.left)
								end;
							extraWidth := ((extraWidth + l4) + 6);
							AddArraySlot(stepChildren, (if (l1 > 0) then {_proto: l2, viewBounds: RelBounds(6, 0, l4, 13), viewJustify: 17414} else {_proto: l2, viewBounds: RelBounds(46, 2, l4, 13), viewJustify: 6}))
						end)
				end;
			if rightButtons then begin
					(foreach l1, l2 in rightButtons do begin
							local l4;
							if (if HasPath(l2, 'text) then HasPath(l2, 'viewFont)) then begin
									l4 := (StrFontWidth(l2.text, l2.viewFont) + 6)
								end else begin
									l4 := (l2.viewBounds.right - l2.viewBounds.left)
								end;
							extraWidth := ((extraWidth + l4) + 6);
							AddArraySlot(stepChildren, (if (l1 > 0) then {_proto: l2, viewBounds: RelBounds(((-l4) - 6), 0, l4, 13), viewJustify: 18438} else {_proto: l2, viewBounds: RelBounds(((-l4) - 67), 2, l4, 13), viewJustify: 38}))
						end)
				end;
			self.viewChildren := Clone(expandedKids);
			SetValue(self, 'viewBounds, RelBounds(((-128 - pgButWidth) - extraWidth), -17, ((128 + pgButWidth) + extraWidth), 17))
		end;
	self:Parent():Dirty()
end
@@end
