			l1 := GetVariable(self, 'targetApp)
		end;
	if (l1 = nil) then begin
			l1 := GetVariable(self, 'targetView)
		end;
	{target: l2, targetView: l1, targetStore: (if (if l2 then IsSoupEntry(l2)) then EntryStore(l2)), appSymbol: (if (if l2 then l2.appSymbol) then l2.appSymbol)}
end
