					Zero2Nine.curIndex := (Zero2Nine.numIndices - 1)
				end else begin
					if (Zero2Nine.curIndex > 0) then begin
							Zero2Nine.curIndex := (Zero2Nine.curIndex - 1)
						end else begin
							if (Zero2Nine.curIndex = 0) then begin
									Zero2Nine.curIndex := -1;
									A2Z.curIndex := (A2Z.numIndices - 1)
								end
						end
				end
		end;
