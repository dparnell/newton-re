@@ 0x5b9efd
func() begin
	if ((l1 := self:FillFromEntry(0, bufferSize)) = 0) then begin
			cursorLoc := -1
		end;
	local l1;
	(for l2 := l1 to (bufferSize - 1) do begin
			buffer[l2] := nil
		end);
	if (not cursor:entry()) then begin
			self:MoveCursor(-1)
		end;
	(dipStick := (cursorLoc + 1))
end
