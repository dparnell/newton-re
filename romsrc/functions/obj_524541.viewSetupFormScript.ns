@@ 0x5217a5
func() begin
	inherited:viewSetupFormScript();
	printForm := self;
	self.isbn := fields.body.isbn;
	if (l1 := copperfield:WhereIsBook(isbn)) then begin
			self.bookRef := l1.bookSoup.Book
		end;
	if (bookRef = nil) then begin
			self:Notify(3, "Book", "Book not available.")
		end;
	self.curRendering := fields.body.curRendering;
	l2 := bookRef.rendering[curRendering].PageSize;
	self.cuPageSize := {width: l2.right, height: l2.bottom};
	if (bookRef.version = 1) then begin
			self.cuPageSize.height := 318
		end;
	if (l3 := bookRef.scripts) then begin
			local l1;
			local l2;
			local l3;
			(for l4 := 0 to (Length(l3) - 1) by 2 do begin
					if ((bookRef.version > 1) or (not hasVariable(self, l3[l4]))) then begin
							self.(l3[l4]) := l3[(l4 + 1)]
						end
				end)
		end;
	printFrom := fields.body.fromPage;
	(if ((fields.currentFormat = 'pageScreenFormat) or (fields.currentFormat = 'pageScreenMarkFormat)) then begin
			printTo := fields.body.CurrentPage;
			(bookPage := fields.body.CurrentPage)
		end else begin
			printTo := fields.body.toPage;
			(bookPage := fields.body.fromPage)
		end)
end
@@end
