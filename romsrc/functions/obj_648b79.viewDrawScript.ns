@@ 0x429a05
func() begin
	local l1, l2, l3, l4, l5, l6;
	if (not pix) then begin
			l1 := self:LocalBox();
			l2 := ((StrFontWidth(text, viewFont) + 2) + icon.bounds.right);
			l3 := ((l1.right - l2) div 2);
			l4 := FontAscent(viewFont);
			l5 := FontHeight(viewFont);
			l6 := ((l1.bottom - l5) div 2);
			pix := [Array: OffsetShape(MakeShape(icon), l3, ((l1.bottom - icon.bounds.bottom) div 2)), MakeText(text, ((l3 + 2) + icon.bounds.right), l6, l1.right, (l6 + l4))]
		end;
	self:DrawShape(pix, {font: viewFont})
end
@@end
