@@ 0x5b6ba9
func() begin
	local l1, l2;
	l1 := GetUserConfig('passwordFrequency);
	if ((l2 := Time()) < lastPWCheckTime) then begin
			RemoveSlot(self, 'lastPWCheckTime)
		end;
	(if (if (if GetUserConfig('usepassword) then GetUserConfig('passwordkey)) then (if l1 then (l2 >= (lastPWCheckTime + l1)))) then begin
			self:FilterDialog();
			true
		end else begin
			CallFrameBasedRegistryFns(loginRegistry, nil);
			nil
		end)
end
