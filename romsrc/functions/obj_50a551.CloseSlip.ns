@@ 0x509a71
func() begin
	isNewMeeting := nil;
	if (mainDisplay = ToDoListView) then begin
			self:changeViewTo(scheduleView)
		end else begin
			self:changeViewTo(mainDisplay)
		end;
	(if selectedMeeting then begin
