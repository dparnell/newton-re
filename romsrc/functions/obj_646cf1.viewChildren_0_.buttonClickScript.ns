@@ 0x4a0191
func() begin
	local l1;
	local l2;
	(foreach l3 in base:ChildViewFrames() do begin
			if (l2 := l3.path) then begin
					if l3.HasData then begin
							l1 := call l3.HasData with (target)
						end else begin
							l1 := (if IsInstance(target.(l2), 'string) then StrFilled(target.(l2)) else target.(l2))
						end;
					if (not l1) then begin
							break
						end
				end
		end);
	base:Close();
	(if compMsg then Perform(compView, compMsg, [Array: l1]))
end
@@end
