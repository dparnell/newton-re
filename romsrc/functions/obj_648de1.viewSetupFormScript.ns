@@ 0x4c6515
func() begin
	local l1, l2, l3, l4, l5;
	(l1 := Clone(self:Parent():LocalBox())).bottom := (l1.bottom - margin);
	l1.right := (l1.right - margin);
	l3 := ((l2 := fields.printerPageBounds).bottom / l2.right);
	l4 := floor((l1.bottom / l3));
	l5 := floor((l1.right * l3));
	if (l4 < l1.right) then begin
			l1.right := l4;
			l1.bottom := floor((l4 * l3))
		end else begin
			l1.bottom := l5;
			l1.right := floor((l5 / l3))
		end;
	self.viewBounds := l1;
	SetKeyView(self, 0)
end
@@end
