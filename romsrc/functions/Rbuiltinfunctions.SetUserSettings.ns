@@ 0x5af199
func(a1) begin
	userConfiguration.letterSetSelection := 0;
	ReadCursiveOptions();
	SetLetterWeights(a1.letterWeights);
	(foreach l1 in '[Array: letterSetSelection, lineAtATime, letterSpaceCursiveOption, speedCursiveOption, timeoutCursiveOption, wordsCursiveOption, lettersCursiveOption, lettersInFieldsOption, numbersCursiveOption, punctuationcursiveoption, remoteWriting, inkWordScaling, doAutoAdd, learningEnabledOption] do begin
			if HasSlot(a1, l1) then begin
					userConfiguration.(l1) := a1.(l1)
				end
		end);
	ReadCursiveOptions()
end
@@end
