@@ 0x46dc49
func(a1) begin
	l1 := (StrLen(a1) - 1);
	local l1;
	(for l2 := 0 to l1 do begin
			local l5;
			if ((l5 := a1[l2]) = $\uF714) then begin
					a1[l2] := $0
				end else begin
					if (l5 = $\uF715) then begin
							a1[l2] := $I
						end else begin
							if (l5 = $\uF716) then begin
									a1[l2] := $l
								end
						end
				end
		end)
end
