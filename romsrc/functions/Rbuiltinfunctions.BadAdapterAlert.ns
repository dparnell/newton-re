@@ 0x563c5d
func() begin
	local l1, l2, l3;
	if (if (l1 := GetRoot():?GetBatteryMessages()) then l1.badAdapter) then begin
			l2 := l1.badAdapter
		end else begin
			l2 := "The adapter is providing too much power.  The battery cannot be charged with this adapter."
		end;
	((l3 := GetRoot():Notify(3, "Power", l2)).batteryAlert := true)
end
@@end
