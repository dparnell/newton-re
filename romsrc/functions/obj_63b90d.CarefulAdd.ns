@@ 0x4f7f35
@@const kFunction_4f780d
func(a1, a2) begin
	(a2:GetSignature() = a1)
end
@@main
func(a1, a2, a3) begin
	local l1, l2, l3;
	try begin
			l1 := (if a3 then 'calendar else 'calendarAPI);
			if a2.storeSig then begin
					l3 := LFetch(GetStores(), a2.storeSig, 0, kFunction_4f780d, nil);
					RemoveSlot(a2, 'storeSig)
				end;
			if (ClassOf(a1) <> 'UnionSoup) then begin
