			ArrayRemoveCount(AuxButtonRegistry, l2, 1)
		end;
	if a2.destApp then begin
			l1 := {appSymbol: EnsureInternal(a1), butt: a2, destApp: EnsureInternal(a2.destApp)};
			if (not (l3 := LSearch(AuxButtonRegistry, nil, 0, '|=|, 'destApp))) then begin
					l3 := 0
				end;
			ArrayInsert(AuxButtonRegistry, l1, l3);
			if (l4 := GetRoot().(a2.destApp)) then begin
					l4:?AddAuxButton(l1)
				end
		end else begin
			l1 := {appSymbol: EnsureInternal(a1), butt: a2};
			AddArraySlot(AuxButtonRegistry, l1);
			if (l6 := (if (l5 := GetUserConfig('blessedapp)) then GetRoot().(l5))) then begin
