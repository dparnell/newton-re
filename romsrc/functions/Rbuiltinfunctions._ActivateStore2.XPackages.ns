@@main
func(a1) begin
	local dupList, errList, miscErrorCount, packageList, cursor, entry;
	local l1, l2;
	dupList := nil;
	errList := nil;
	miscErrorCount := 0;
	if (l1 := a1:GetSoup("Packages")) then begin
			packageList := GetPackages();
			entry := (cursor := l1:Query('{indexPath: packageName, tagspec: {none: _frozen, all: _package}})):entry();
			l2 := (GetRoot().SleepScreen.viewCObject or (a1 = GetStores()[0]));
			if entry then begin
					DoProgress('vBarber, {barber: true, statusText: ParamStr("Activating packages on the store \u201C\u^0\u201D\u.", [Array: a1:GetName()]), icon: kLiteral_484299, primary: nil, closeBox: nil, screenRelativeH: l2}, func(a1) begin
						local l1, l2, l3;
						(while entry do (try begin
									l1 := entry.packageName;
									if (l2 := LFetch(packageList, l1, 0, '|str=|, 'title)) then begin
											l3 := (if l2.store then l2.store:GetName() else "Built-In");
											dupList := StrConcatDelimited(dupList, ", ", ParamStr("\u201C\u^0\u201D\u on \u201C\u^1\u201D\u", [Array: l1, l3]))
										end else begin
											try begin
													a1:?SetStatus('vBarber, {titleText: Stringer([Array: $\u201C, l1, $\u201D]), barber: true});
													ActivatePackage(entry.pkgRef)
												end onexception |evt.ex| do begin
													errList := StrConcatDelimited(errList, ", ", Stringer([Array: $\u201C, l1, $\u201D]))
												end
										end;
									(entry := cursor:Next())
