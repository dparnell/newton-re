@@ 0x470f55
func() begin
	local l1, l2;
	l2 := 0;
	if formOpen then begin
			if ((timeoutCounter := (timeoutCounter - idleFrequency)) < 0) then begin
					l1 := self:timesUpScript()
				end else begin
					l1 := true
				end;
			if l1 then begin
					if (if formOpen then (not HaveZones())) then begin
							self:CloseAndNotify("The network connection was lost, check your cables.")
						end;
					return idleFrequency
				end
		end;
	return l2
end
@@end
