@@ 0x426f75
@@const kBinaryFromHex
func(hex, cls) begin
	local b := MakeBinary(StrLen(hex) div 2, cls);
	for i := 0 to Length(b) - 1 do begin
		local h := Ord(hex[2 * i]);
		local l := Ord(hex[2 * i + 1]);
		StuffByte(b, i, (if h >= 97 then h - 87 else h - 48) * 16 + (if l >= 97 then l - 87 else l - 48))
	end;
	b
end
@@const kLiteral_423e59
{bits: call kBinaryFromHex with ("000000000004003500350084004c009f7fffffc0ffffffe0c0000060c0000060c0000060c0000060c071c060c071c060c071c060c071c060c071c060c071c060c071c060c071c060c071c060c071c060c071c060c0000060c0000060c0000060c0000060ffffffe07fffffc0", 'bits), bounds: '{left: 0, top: 0, right: 27, bottom: 23}}
@@main
func(a1, a2, a3) begin
	if (a2 = 2) then begin
			if (recButIcon.icon <> kLiteral_423e59) then begin
					SetValue(recButIcon, 'icon, kLiteral_423e59);
					SetValue(recButText, 'text, "Pause")
				end
		end else begin
			if (recButIcon.icon <> self:GetIcon()) then begin
					SetValue(recButIcon, 'icon, self:GetIcon());
					SetValue(recButText, 'text, "Rec")
				end
		end;
	(if (a2 = 32) then (if (RecordEngine.fEngineError <> 0) then (if (RecordEngine.fEngineError = 1) then self:Notify(3, notifyTitle, "Sorry, the recording was stopped because the internal memory or storage card is almost full.") else self:Notify(3, notifyTitle, "Sorry, the recording was stopped due to an internal error."))))
end
@@end
