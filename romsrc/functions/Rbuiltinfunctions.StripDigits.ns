@@ 0x4d27d5
func(a1, a2, a3) begin
	local l1, l2, l3;
	l1 := "";
	l2 := 0;
	l3 := StrLen(a1);
	(while (if (a2 > 0) then (l2 < l3)) do begin
			if (if (a1[l2] >= $0) then (a1[l2] <= $9)) then begin
					a2 := (a2 - 1)
				end else begin
					l1 := Stringer([Array: l1, a1[l2]])
				end;
			(l2 := (l2 + 1))
		end);
	l1 := Stringer([Array: l1, Substr(a1, l2, nil)]);
	if a3 then begin
			l2 := 0;
			(while (l2 < l3) do begin
					if (if (l1[l2] >= $0) then (l1[l2] <= $9)) then begin
							if (if (l2 > 0) then (l1[(l2 - 1)] = $()) then begin
									l2 := (l2 - 1)
								end;
							break
						end;
					(l2 := (l2 + 1))
				end);
			l1 := Substr(l1, l2, nil)
		end;
	l1
end
