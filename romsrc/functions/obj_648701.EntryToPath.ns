@@ 0x4b9d19
func(a1) begin
	target.(path) := nil;
	country := nil;
	l1 := nil;
	if (if a1 then a1.phones) then begin
			l2 := 0;
			local l1;
			local l2;
			(foreach l3, l4 in a1.phones do begin
					local l6, l7;
					if StrFilled(l4) then begin
							l6 := ClassOf(l4);
							l7 := {item: ParamStr("^0 ^?1(^1)||", [Array: MakeDisplayPhone(l4), PhoneTypes.phoneText.(l6)]), value: l4, country: a1.country};
							if IsSubclass(l6, kind) then begin
									l2 := l3;
									l7.mark := $\uFC0B
								end;
							if (not l1) then begin
									l1 := [Array: ]
								end;
							AddArraySlot(l1, l7)
						end
				end);
			if (Length(a1.phones) > l2) then begin
					target.(path) := a1.phones[l2];
					country := a1.country
				end
		end;
	if (if l1 then (Length(l1) = 1)) then begin
			l1 := nil
		end;
	self:SetLabelCommands(l1)
end
@@end
