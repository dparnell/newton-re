			l5 := ((2 * hSpacing) div 3);
			l3 := StyledStrTruncate(l3, (hSpacing - l5), 9216);
			SetClass((shape := [Array: (if (target.fentry.class = 'FrozenEntry) then '{font: 10240} else (if target.notActive then '{font: 2107392} else '{font: 1058816})), MakeText(target.fentry.text, 20, 0, (hSpacing div 2), 11), '{font: 9216, justification: right}, MakeText(l2, (hSpacing div 2), 0, (l5 - 8), 11), '{font: 9216, justification: left}, MakeText((if l3 then l3 else ""), l5, 0, hSpacing, 11), OffsetShape(MakeShape((if checked then kLiteral_3c8abd else kLiteral_3c8b41)), 5, 0)])[1].data, 'string);
