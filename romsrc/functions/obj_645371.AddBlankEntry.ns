@@ 0x4af121
func() begin
	local l1, l2, l3;
	l1 := masterSoup:AdoptEntry(nil, nil);
	try begin
			if (l3 := self:GetAppPreferences().internalStore) then begin
					l2 := GetStores()[0]
				end else begin
					l2 := GetDefaultStore()
				end
		end onexception |evt.ex| do begin
			l2 := nil
		end;
	masterSoup:AddEntry(l1, l2);
