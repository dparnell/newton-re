			self:DrawShape(MakeRect(-10000, -10000, 10000, 10000), {fillPattern: 5});
			l4:BotherScreenCentered("Rebuilding display, please wait a few seconds\u2026\u");
			SetVolume(0);
			StableSort(l1, kFunction_44998d, nil);
