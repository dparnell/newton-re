@@ 0x449c39
@@const kFunction_44998d
func(a1, a2) begin
	(if (if a1.appSymbol then (not a2.appSymbol)) then -1 else (if (if (not a1.appSymbol) then a2.appSymbol) then 1 else 0))
end
@@main
func() begin
	l1 := GetRoot():ChildViewFrames();
	local l1;
	(foreach l2 in GetStores() do begin
			l2:MarkBusy('_newt, nil)
		end);
	try begin
			l4 := GetRoot().MsgBox;
