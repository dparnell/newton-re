@@ 0x44b825
func(a1, a2) begin
	local l1, l2;
	l1 := Ticks();
	(if (not a1) then begin
			if self._curTypeSelect then begin
					self._curTypeSelect := nil
				end;
			nil
		end else (if (a1 = $\00) then nil else (if IsCommandKeystroke(a1, a2) then begin
					if self._curTypeSelect then begin
							self._curTypeSelect := nil
						end;
					nil
				end else begin
					if ((not (l2 := self._curTypeSelect)) or ((l1 - l2.Time) > l2.timeOut)) then begin
							l2 := {Time: l1, timeOut: (if self._typeSelectTimeOut then self.typeSelectTimeOut else GetUserConfig('typeSelectTimeOut)), string: SPrintObject(a1)};
							self._curTypeSelect := l2
						end else begin
							l2.Time := l1;
							l2.string := Stringer([Array: l2.string, a1])
						end;
					l2.string
				end)))
end
@@end
