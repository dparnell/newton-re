@@ 0x62d7c1
func(a1, a2, a3) begin
	local l1, l2, l3, l4;
	l2 := (l1 := EntrySoup(a1)):GetName();
	l3 := EntryMove(a1, a2);
	if a3 then begin
			XmitSoupChange(l2, a3, 'entryMoved, {oldSoup: l1, entry: a1});
			l4 := a2:GetName();
			if (not StrEqual(l2, l4)) then begin
					XmitSoupChange(l4, a3, 'entryAdded, a1)
				end
		end;
	l3
end
