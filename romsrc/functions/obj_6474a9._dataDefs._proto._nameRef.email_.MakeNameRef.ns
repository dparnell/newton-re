func(a1, a2) begin
	local l1, l2, l3, l4;
	l1 := inherited:MakeNameRef(a1, a2);
	l2 := EntryFromObj(a1);
	l1.email := (if IsInstance(l2, 'group) then l2.members else (if (if IsFrame(a1) then a1.email) then a1.email else (if l2 then (if (if (l3 := GetRoot().cardfile:bcEMailAddress(l2, preferredRouting)) then (Length(l3) > 0)) then begin
						SortByClass(l3, preferredRouting, 'email);
						(if IsFrame((l4 := l3[0])) then l4.email else l4)
					end))));
	l1
end
