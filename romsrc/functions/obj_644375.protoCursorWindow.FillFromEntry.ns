@@ 0x5ba001
func(a1, a2) begin
	local l1, l2, l3;
	l1 := a1;
	l2 := (a1 + a2);
	if (if (l3 := cursor:entry()) then (l1 < l2)) then begin
			(loop begin
					if (not l3) then begin
							break
						end else begin
							buffer[l1] := l3
						end;
					(if ((l1 := (l1 + 1)) = l2) then break else begin
							cursorLoc := l1;
							if (not cursor:Next()) then begin
									break
								end;
							(l3 := cursor:entry())
						end)
				end)
		end;
	return (l1 - a1)
end
@@end
