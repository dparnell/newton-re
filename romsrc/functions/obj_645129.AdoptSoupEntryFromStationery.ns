@@ 0x4ac20d
func(a1, a2, a3, a4) begin
	local l1, l2, l3;
	l1 := nil;
	if (a2 = nil) then begin
			a2 := a1.class
		end;
	if a2 then begin
			l2 := self:GetAppPreferences().internalStore;
			if (not a3) then begin
					if l2 then begin
							a3 := GetStores()[0]
						end else begin
							a3 := GetDefaultStore()
						end
				end;
			if ((not a3) or a3:IsReadOnly()) then begin
					self:Notify(3, title, "New entries cannot be added to a read-only store.")
				end else begin
					if (a4 = nil) then begin
							if layout then begin
									a4 := layout.masterSoup
								end else begin
									a4 := allLayouts.(currentLayout).mastersoupSlot
								end
						end;
					if (ClassOf(a4) = 'symbol) then begin
							if (l3 := allSoups.(a4)) then begin
									if (l3.theSoup = nil) then begin
											l3 := Clone(l3);
											l3:MakeSoup(appSymbol)
										end;
									a4 := l3
								end else begin
									a4 := nil
								end
						end;
					if (a4 = nil) then begin
							Throw('|evt.ex.msg|, "Soup not found")
						end;
					l1 := a4:AdoptEntry(a1, a2);
					if (if layout then (a4 = layout.masterSoup)) then begin
							self:AddEntryDirect(l1, a3)
						end else begin
							a4:AddEntry(l1, a3)
						end
				end
		end else begin
			self:Notify(3, title, "Couldn't find stationery.")
		end;
