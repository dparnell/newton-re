@@main
func(store) begin
	local dupList, errList, miscErrorCount, entry, packageList;
	local l1, l2;
	dupList := nil;
	errList := nil;
	miscErrorCount := 0;
	if (l1 := store:GetSoup(@276)) then begin
			if (entry := l1:Query('{indexPath: tag, beginKey: "Packages", endKey: "Packages"}):entry()) then begin
					packageList := GetPackages();
					l2 := GetRoot().SleepScreen.viewCObject;
					if (Length(entry.pssids) > 0) then begin
							DoProgress('vBarber, {barber: true, statusText: ParamStr("Activating packages on the store \u201C\u^0\u201D\u.", [Array: store:GetName()]), icon: kLiteral_484299, primary: nil, closeBox: nil, screenRelativeH: l2}, func(a1) begin
								(foreach l1 in entry.pssids do begin
										local l3, l4, l5, l6;
										try begin
												if (not IsSirNotAppearingInThisROM((l4 := (l3 := GetPkgInfoFromPssid(l1, store)).title), l3.version, 'activate)) then begin
														if (l5 := LFetch(packageList, l4, 0, '|str=|, 'title)) then begin
																l6 := (if l5.store then l5.store:GetName() else "Built-In");
																dupList := StrConcatDelimited(dupList, ", ", ParamStr("\u201C\u^0\u201D\u on \u201C\u^1\u201D\u", [Array: l4, l6]))
															end else begin
																try begin
																		a1:?SetStatus('vBarber, {titleText: Stringer([Array: $\u201C, l4, $\u201D]), barber: true});
																		|Activate1.XPackage|(l1, store)
																	end onexception |evt.ex| do begin
																		errList := StrConcatDelimited(errList, ", ", Stringer([Array: $\u201C, l4, $\u201D]))
																	end
															end
													end
											end onexception |evt.ex| do begin
												miscErrorCount := (miscErrorCount + 1)
											end
									end)
							end)
						end
				end
		end;
	if (miscErrorCount > 0) then begin
			errList := StrConcatDelimited(errList, ", ", ParamStr("^0 unknown package^?1s||", [Array: miscErrorCount, (miscErrorCount > 1)]))
		end;
	{dupList: dupList, errList: errList}
end
