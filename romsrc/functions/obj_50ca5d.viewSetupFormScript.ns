@@ 0x50c6ad
func() begin
	local l1, l2, l3;
	self.viewBounds := RelBounds(90, (dpSlip.alarmFieldTop - 7), 150, 26);
	if savedAlarmUnitsValue then begin
			unitsValue := savedAlarmUnitsValue;
			unitsIndex := savedAlarmUnitsIndex;
			alarmOn := true;
			return nil
		end;
	if (selectedMeeting.viewStationery = 'cribNote) then begin
			unitsValue := -1;
			unitsIndex := 2
		end;
	(if ((l1 := self:GetMeetingSlot(selectedMeeting, 'mtgAlarm)) <> nil) then begin
			alarmOn := true;
			if selectedMeeting.repeatTemplate then begin
					l2 := l1
				end else begin
					l2 := (selectedMeeting.mtgStartDate - l1)
				end;
			(if (selectedMeeting.viewStationery = 'cribNote) then begin
					unitsValue := (((l2 + 1440) - 1) div 1440);
					(unitsIndex := 2)
				end else (if (unitsValue <> -1) then (if ((l2 = 0) or ((l2 mod 60) <> 0)) then begin
							if (unitsValue <> -1) then begin
									unitsValue := l2
								end;
							(unitsIndex := 0)
						end else (if ((l2 mod 1440) <> 0) then begin
								unitsValue := (l2 div 60);
								(unitsIndex := 1)
							end else begin
								unitsValue := (l2 div 1440);
								(unitsIndex := 2)
							end))))
		end)
end
@@end
