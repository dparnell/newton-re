func(a1, a2, a3) begin
	local l1, l2, l3, l4;
	l2 := (l1 := cursor:entry());
	if (not self.isReset) then begin
			l2 := cursor:Reset()
		end;
	if (a2 > 0) then begin
			l2 := cursor:move(a2)
		end;
	l3 := 0;
	try begin
			(while (if (l2 <> nil) then (l3 < a3)) do begin
					(l4 := self:MakeFoundItem(l2, owner)).itemIndex := (l3 + a2);
					l4.selected := self:isSelected({_uniqueID: l4.entryID, _storeID: l4.storeID});
					AddArraySlot(a1, l4);
					l3 := (l3 + 1);
