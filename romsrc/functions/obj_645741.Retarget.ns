@@ 0x4bdc3d
func() begin
	(foreach l1 in self:ChildViewFrames() do begin
			if HasPath(l1, 'Retarget) then begin
					l1:Retarget()
				end else begin
					(foreach l3 in l1:ChildViewFrames() do begin
							if HasPath(l3, 'Retarget) then begin
									l3:Retarget()
								end
						end)
				end
		end)
end
@@end
