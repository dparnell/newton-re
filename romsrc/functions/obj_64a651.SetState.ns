@@ 0x4261a9
func(a1) begin
	local l1, l2;
	l1 := fSoundState;
	l2 := self:HasSoundFrames();
	inherited:SetState(a1);
	if (recordButton exists) then begin
			recordButton:SetState(l1, a1, l2)
		end;
	if (playButton exists) then begin
			playButton:SetState(l1, a1, l2)
		end;
	(if (statusText exists) then statusText:SetState(l1, a1, l2))
end
@@end
