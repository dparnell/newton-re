@@ 0x4b1f2d
func(a1) begin
	local l1, l2, l3, l4, l5;
	l2 := (l1 := GetTargetCursor(a1, nil)):entry();
	l3 := nil;
	if (l1:CountEntries() = 1) then begin
			l3 := l2;
			l4 := EntryStore(l2)
		end;
	(while l2 do begin
			if (l5 := GetItemTransport(l2)) then begin
					l5:?ItemDeleted(l2)
				end;
			masterSoup:DeleteEntry(l2);
			(l2 := l1:Next())
		end);
	if (currentLayout = 'overview) then begin
			selected := nil;
			layout:Retarget('sync)
		end else begin
			layout:Retarget(nil);
			newtAppBase:ShowLayout('overview)
		end;
	(if l3 then AddUndoSend(layout, 'NewEntry, [Array: l3, true, l4]))
end
@@end
