					l3 := (if (if (l2 := (if a1.category then GetRoot().(a1.category))) then (l2:GetConfig('dontAutoPutAway) = 'never)) then true);
					(if (if (if l1 then l1.AutoPutaway) then (not l3)) then (if l1:AutoPutaway(a1) then begin
