@@ 0x526bf5
func(a1, a2) begin
	l1 := 0;
	local l1;
	local l2;
	local l3;
	(foreach l4, l5 in a1 do begin
			if ((not IsSubclass((l2 := ObjEntryClass((l3 := ResolveEntryAlias(l5.alias)))), 'group)) or IsInstance(l3.members, a2)) then begin
					if (l1 <> l4) then begin
							a1[l1] := a1[l4]
						end;
					l1 := (l1 + 1)
				end
		end);
	SetLength(a1, l1)
end
@@end
