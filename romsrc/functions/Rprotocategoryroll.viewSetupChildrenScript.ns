@@ 0x430ce5
func() begin
	scrollAmount := ((maxItems := (self:LocalBox().bottom div 14)) - 2);
	self.items := nil;
	self.viewChildren := nil;
	self.moreBelow := nil;
	l1 := [Array: ];
	l2 := maxItems;
	l3 := scrollOrigin;
	local l1;
	local l2;
	local l3;
	(foreach l4 in categoryFrames do begin
			local l6, l7, l8;
			l6 := self:MakeCategoryItem(l4);
			if (l7 := (allCollapsed or l4.collapsed)) then begin
					l8 := 0
				end else begin
					l8 := l6.count
				end;
			if (l3 > 0) then begin
					if l7 then begin
							l8 := 0
						end;
					if (l8 > l3) then begin
							l3 := (-l3)
						end else begin
							l3 := (l3 - l8)
						end;
					if (l3 = 0) then begin
							l3 := 1
						end
				end;
			if (l3 <= 0) then begin
					l3 := (-l3);
					l6.skip := l3;
					AddArraySlot(l1, l6);
					l2 := (l2 - 1);
					if (not l7) then begin
							l2 := (l2 - self:AddCategory(l1, l6, l3, l2))
						end;
					if (l2 <= 0) then begin
							break
						end;
					l3 := 0
				end else begin
					l3 := (l3 - 1)
				end
		end);
	self.moreBelow := (l2 <= 0);
	self.items := l1;
	(self.viewChildren := self:LayoutColumn(l1, index))
end
@@end
