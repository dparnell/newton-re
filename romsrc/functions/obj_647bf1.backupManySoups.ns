func(a1, a2, a3) begin
	l1 := progressSlip;
	local l1;
	(foreach l2 in a3 do begin
			if IsFrame(l2) then begin
					l4 := l2.name;
					l5 := l2.soups
				end else begin
					l4 := l2;
					l5 := [Array: l2]
				end;
			if self:|soupWillFit?|(a1, a2, l2, true) then begin
					local l4;
