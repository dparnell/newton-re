			l11 := (l11 + l1.locFieldHt)
		end else begin
			if (not hideDateField) then begin
					l11 := (l11 + 2)
				end
		end;
	l1.alarmFieldTop := l11;
	l11 := (l11 + l1.alarmFieldHt);
