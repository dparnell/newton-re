	l1.titleFieldHt := 70;
	l1.dateFieldHt := 21;
	l1.timeFieldHt := 21;
	l1.peopleFieldHt := 21;
	l1.locFieldHt := 21;
	l1.alarmFieldHt := 21;
	l1.freqFieldHt := 21;
