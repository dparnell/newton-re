	l1.dateFieldTop := 0;
	l1.timeFieldTop := 0;
	l1.peopleFieldTop := 0;
	l1.locFieldTop := 0;
	l1.seriesMsgHeaderTop := 0;
	l1.dateRangeTop := 0;
