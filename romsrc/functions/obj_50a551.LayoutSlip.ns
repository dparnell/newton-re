	l8 := (if (not l5) then a1);
	l9 := 12;
	l10 := 2;
	l11 := l1.slipTitleHt;
	l1.titleFieldTop := l11;
	l11 := (l11 + l1.titleFieldHt);
	if (if (if l5 then (not l3)) then a1) then begin
			hideMtgMsgHeader := nil;
			l1.currentHt := (l11 + l10);
			l1.mtgMsgHeaderTop := l11;
			l11 := (l11 + l9)
		end;
	if (if (not (if l3 then l7)) then (not l8)) then begin
			hideDateField := nil;
			l1.dateFieldTop := l11;
			l11 := (l11 + l1.dateFieldHt)
		end;
	if (not l4) then begin
