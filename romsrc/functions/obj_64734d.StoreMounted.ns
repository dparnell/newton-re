@@ 0x56b325
@@const kBinaryFromHex
func(hex, cls) begin
	local b := MakeBinary(StrLen(hex) div 2, cls);
	for i := 0 to Length(b) - 1 do begin
		local h := Ord(hex[2 * i]);
		local l := Ord(hex[2 * i + 1]);
		StuffByte(b, i, (if h >= 97 then h - 87 else h - 48) * 16 + (if l >= 97 then l - 87 else l - 48))
	end;
	b
end
@@const kLiteral_56a7e9
call kBinaryFromHex with ("6e5db133590fab4f", 'deskey)
@@const kLiteral_56a7fd
call kBinaryFromHex with ("a975975bb33737cb", 'deskey)
