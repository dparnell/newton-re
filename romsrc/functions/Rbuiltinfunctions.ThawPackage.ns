@@ 0x559bf9
func(a1) begin
	local entry;
	local l1, l2;
	if (not (entry := PackageEntryFromThingy(a1))) then begin
			return nil
		end;
	l1 := EntryStore(entry);
	l1:AtomicAction(func() begin
		SetRemove(entry._tagList, '_frozen);
		EntryChange(entry);
		UnsafeXmitSoupChangeNow("Packages", '|Mr.Freeze|, 'entryChanged, entry)
	end);
	if (not IsPackageActive((l2 := entry.pkgRef))) then begin
			SafeActivatePackageQT(l2, entry.packageName, EntryStore(entry))
		end;
	XmitPackageOp('ThawPackage);
	true
end
@@end
