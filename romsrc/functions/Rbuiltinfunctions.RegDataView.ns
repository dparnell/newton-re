@@ 0x4a8c1d
func(a1, a2) begin
	local l1, l2;
	l1 := EnsureInternal(a2.symbol);
	a1 := EnsureInternal(a1);
	if (not (l2 := _viewdefs.(a1))) then begin
			l2 := (_viewdefs.(a1) := {})
		end else begin
			if IsReadOnly(l2) then begin
					_viewdefs.(a1) := (l2 := Clone(_viewdefs.(a1)))
				end
		end;
	if HasPath(l2, l1) then begin
			return nil
		end;
	l2.(l1) := a2;
	CallFrameBasedRegistryFns(StationeryChangeRegistry, [Array: 'install, 'viewDef, a1, l1])
end
@@end
