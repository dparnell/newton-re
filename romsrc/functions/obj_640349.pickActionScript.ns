@@ 0x429421
func(a1) begin
	local l1, l2, l3;
	if IsFrame((l1 := labelCommands[a1])) then begin
			l2 := l1.icon;
			if (if (not (l3 := l1.item)) then l1.keyMessage) then begin
					l3 := MatchKeyMessage(self, l1.keyMessage).name
				end
		end else begin
			l2 := nil;
			l3 := l1
		end;
	self:UpdateText(l3);
	if iconBounds then begin
			self:UpdateIcon(l2)
		end;
	self:LabelActionScript(a1);
	base:hilite(nil)
end
@@end
