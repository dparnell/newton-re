@@ 0x503a61
func() begin
	local l1, l2, l3;
	l1 := selectedMeeting;
	if ((l2 := Header.WarningView:getWarningTime()) = nil) then begin
			l3 := nil
		end else begin
			if (not l1.repeatTemplate) then begin
					l3 := l2
				end else begin
					l3 := (l1.mtgStartDate - l2)
				end
		end;
	(if (self:GetMeetingSlot(l1, 'mtgAlarm) <> l3) then begin
			self:ChangeMeeting(l1, 'mtgAlarm, l2);
			'initializeAlarms
		end)
end
@@end
