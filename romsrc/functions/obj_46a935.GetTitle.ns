@@ 0x46a645
func() begin
	local l1, l2, l3;
	if (if (l3 := (l2 := refCon.form)._parent.label) then IsString(l3)) then begin
			l1 := Clone(l3)
		end else begin
			if (not (l3 := l2.labelLine)) then begin
					l3 := l2._parent.labelLine
				end;
			if (if (if l3 then l3.text) then IsString(l3.text)) then begin
					l1 := Clone(l3.text)
				end
		end;
	if l1 then begin
			StrReplace(l1, "\uFC01\u", "", 1);
			StrReplace(l1, "\uFC02\u", "", 1)
		end else begin
			l1 := defaultTitle
		end;
	return l1
end
@@end
