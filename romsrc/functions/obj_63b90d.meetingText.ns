@@ 0x515fb9
func(a1, a2) begin
	local l1, l2, l3, l4, l5;
	l4 := self:GetMeetingSlot(a1, 'mtgDuration);
	l5 := self:GetMeetingText(a1);
	if (l4 > 0) then begin
