@@ 0x4fdb5d
func(a1) begin
	local l1, l2, l3, l4;
	l1 := GetPoint(0, a1);
	l2 := GetPoint(1, a1);
	l4 := ((l3 := self:GlobalBox()).left + SliderWidth);
	(if (if (if (if (l1 >= l4) then (l1 <= (l4 + ShapeBounds(iconShape).right))) then (l2 >= l3.top)) then (l2 <= (l3.top + 16))) then begin
			calendar.selectedMeeting := realData;
			isNewMeeting := nil;
			self:OpenMeetingSlip(selectedMeeting, nil, nil);
			true
		end)
end
@@end
