@@ 0x43e5f1
func(a1, a2) begin
	local l1, l2, l3;
	l1 := nil;
	if (a1 = 0) then begin
			l1 := 15
		end else begin
			if (a2 = 0) then begin
					l1 := 0
				end else begin
					l2 := ((a2 * 10000) div a1);
					l3 := 0;
					(loop begin
							if (l2 < atanTable[l3]) then begin
									break
								end;
							(if ((l3 := (l3 + 1)) > 14) then begin
									l3 := 15;
									break
								end)
						end);
					l1 := l3
				end
		end;
	return l1
end
@@end
