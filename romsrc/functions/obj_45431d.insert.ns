@@const kFunction_450079
func(a1) begin
	local l1;
	if (not a1) then begin
			return nil
		end;
	(if IsInstance(a1, 'alias) then ResolveEntryAlias(a1) else (if (if IsFrame(a1) then a1._alias) then (if (l1 := ResolveEntryAlias(a1._alias)) then l1 else a1) else a1))
end
@@main
func(a1, a2) begin
	if (a2 = 'select) then begin
			self:DoSelectObj(a1, nil)
