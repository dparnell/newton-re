@@main
func(store, a2) begin
	local storeName;
	storeName := store:GetName();
	DoProgress('vBarber, {barber: true, icon: kLiteral_484299, primary: nil, closeBox: nil}, func(a1) begin
		a1:SetStatus('vBarber, {statusText: ParamStr("Converting packages on the store \u201C\u^0\u201D\u", [Array: storeName]), barber: true});
		try begin
				|Convert1.XPackages|(store, a1)
			end onexception |evt.ex| do begin
				GetRoot():Notify(3, "Newton", ParamStr("Errors occurred converting packages on the store \u201C\u^0\u201D\u.", [Array: storeName]));
				return nil
			end;
		a1:SetStatus('vBarber, {statusText: ParamStr("Converting soups on the store \u201C\u^0\u201D\u", [Array: storeName]), barber: true});
		(try begin
				|Convert1.XStoreData|(store, a1)
			end onexception |evt.ex| do begin
				GetRoot():Notify(3, "Newton", ParamStr("Errors occurred converting soups on the store \u201C\u^0\u201D\u.", [Array: storeName]));
				return nil
			end)
	end)
end
