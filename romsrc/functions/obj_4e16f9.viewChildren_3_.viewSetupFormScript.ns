@@ 0x4df4b1
func() begin
	local l1, l2, l3;
	label := Stringer([Array: $\uFC01, country.regionName]);
	place := nil;
	if (if (l1 := GetLocationSoup(country.regions)) then target.region) then begin
			if (l3 := (l2 := l1:Query({type: 'index, indexPath: 'name, beginKey: target.region, endKey: target.region})):entry()) then begin
					place := (fullName := l3.name)
				end else begin
					if (l3 := (l2 := l1:Query({type: 'index, indexPath: 'abbrev, beginKey: target.region, endKey: target.region})):entry()) then begin
							place := l3.abbrev;
							fullName := l3.name
						end
				end
		end;
	inherited:?viewSetupFormScript()
end
@@end
