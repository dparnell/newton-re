							AddArraySlot(l1, Clone(l4))
						end
				end)
		end;
	local l6;
	l6 := (foreach l7 in l1 collect StringFilter(strtophone(l7.mailPhone), "0123456789", 'passAll));
	(foreach l11 in a2 do begin
