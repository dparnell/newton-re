				end;
			if l2 then begin
					l3 := ResolveEntryAlias(l2.cityAlias)
				end else begin
					if IsEntryAlias((l3 := GetUserConfig('location))) then begin
							l3 := ResolveEntryAlias(l3)
						end
				end
		end;
	if (not IsArray(a2)) then begin
			a2 := [Array: a2]
		end;
	if (if l2 then l2.mailAccess) then begin
			local l1;
			local l2;
			local l3;
			(foreach l4 in l2.mailAccess do begin
