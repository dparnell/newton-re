							if ((l6 = 'right) or (l6 = 'left)) then begin
									l1 := {buttonBarPosition: l6, buttonBarThickness: l5.buttonBarVThickness, buttonBarControlsPosition: l7, bellyButtonPosition: l8}
								end else begin
									if ((l6 = 'top) or (l6 = 'bottom)) then begin
											l1 := {buttonBarPosition: l6, buttonBarThickness: l5.buttonBarHThickness, buttonBarControlsPosition: l7, bellyButtonPosition: l8}
										end
								end
						end
				end
		end;
	l1
end
