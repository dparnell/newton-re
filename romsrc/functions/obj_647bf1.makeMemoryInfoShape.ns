@@ 0x4960d9
func(a1) begin
	local l1, l2, l3, l4, l5;
	l1 := a1:UsedSize();
	l2 := max(1, (l1 div 1024));
	l3 := ((a1:TotalSize() - l1) div 1024);
	l4 := max(1, l3);
	l5 := Stringer([Array: NumberStr(l2), "K in use, ", " ", NumberStr(l4), "K free\n"]);
	(infoShapes[1] := MakeText(StrTruncate(l5, 170), 15, 73, 185, 86))
end
@@end
