@@ 0x54efe5
func(a1) begin
	local l1, l2, l3, l4;
	l2 := (l1 := GetPoint(6, a1)).x;
	l3 := l1.y;
	l4 := self:GlobalBox();
	(if ((((l2 < l4.left) or (l2 > l4.right)) or (l3 < l4.top)) or (l3 > l4.bottom)) then begin
			InkOff(a1);
			true
		end else begin
			SetKeyView(self, 0);
			inherited:?viewClickScript(a1)
		end)
end
@@end
