@@ 0x4a8a61
func(a1, a2) begin
	local l1, l2;
	(if (if (if (l1 := (if a1 then _viewdefs.(a1))) then a2) then l1.(a2)) then l1.(a2) else (if (if l1 then l1.default) then l1.default else begin
				l1 := Clone(@590);
