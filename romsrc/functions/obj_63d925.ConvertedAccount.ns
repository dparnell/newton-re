@@ 0x5a4161
func(a1, a2, a3) begin
	local l1, l2;
	(if a1 then begin
			if IsRichString((l1 := GetUserConfig('mailAccount))) then begin
					SetUserConfig('mailAccount, a2);
					if (l2 := ResolveEntryAlias(userConfiguration.currentPersona)) then begin
							GetRoot().cardfile:ReplaceInkData(l2, 'email, l1, 'email, a2)
						end
				end;
			self:ConvertInkText(GetUserConfig('mailPassword), 'alpha, nil, "Converting e-mail password", "Please verify that the ink text was converted correctly.", 'InkConvert, 'ConvertedPassword, nil)
		end else (eworld := nil))
end
