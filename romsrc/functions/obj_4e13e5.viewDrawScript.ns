func() begin
	local l1;
	if (not pix) then begin
			l1 := self:LocalBox();
			pix := [Array: '{font: 1060864, justification: center}, MakeText(place.name, l1.left, l1.top, l1.right, (l1.top + 14)), '{font: 1058816, justification: center}, MakeText(GetCountryEntry(place.country)[0].name, l1.left, (l1.top + 18), l1.right, (l1.top + 28)), MakeText(ShortDate(Time), l1.left, (l1.bottom - 30), l1.right, (l1.bottom - 17)), '{font: 10240, justification: center}, MakeText(HourMinute(Time), l1.left, (l1.bottom - 17), l1.right, (l1.bottom - 4))]
		end;
	self:DrawShape(pix, nil)
end
