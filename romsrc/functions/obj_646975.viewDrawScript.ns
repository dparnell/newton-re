@@ 0x4cbb75
func() begin
	l1 := StrLen(text);
	l2 := self:LocalBox();
	l3 := Clone(" ");
	l4 := (((FontAscent(viewFont) + l2.bottom) - FontDescent(viewFont)) div 2);
	l5 := Array((l1 + 2), nil);
