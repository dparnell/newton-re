@@ 0x503b3d
func() begin
	local l1, l2, l3, l4, l5, l6, l7;
	if self:IsNonExceptionRepeatingMeeting(selectedMeeting) then begin
			l1 := newtMtgStartTime;
			l2 := newtMtgStopTime;
			if (if l1 then l2) then begin
					l4 := ((l3 := selectedMeeting.mtgStartDate) - (l3 mod 1440));
					l6 := ((l5 := (newMtgDate - (newMtgDate mod 1440))) + l1);
					l7 := (l2 - l1);
					if (l5 <> l4) then begin
							needToChangeThisOrFutureOccurrences := 'ThisOneOnly;
							return nil
						end;
					if ((((l6 <> selectedMeeting.mtgStartDate) or (l7 <> self:GetMeetingSlot(selectedMeeting, 'mtgDuration))) or (not self:IsSameAlias(locationAlias, self:GetMeetingSlot(selectedMeeting, 'mtgLocation)))) or (not self:IsSameListOfAliases(inviteesAliases, self:GetMeetingSlot(selectedMeeting, 'mtgInvitees)))) then begin
							return true
						end
				end
		end;
	nil
end
@@end
