@@ 0x460125
func(a1) begin
	local l1, l2, l3, l4;
	l1 := "Sorry, a problem has occurred.";
	if ((l2 := ((a1 div 1000) * 1000)) = -10000) then begin
			if ((l3 := ((a1 div 100) * 100)) = -10500) then begin
					l1 := "There is a problem with the card."
				end else begin
					if (l3 = -10600) then begin
							l1 := "There is a problem with the internal memory or storage card."
						end
				end
		end;
	if (l4 := TableLookup(@79, a1)) then begin
			l1 := l4
		end else begin
			l1 := Stringer([Array: l1, "\n(", a1, $)])
		end;
	l1
end
@@end
