@@ 0x4ef67d
func(a1, a2) begin
	l1 := ((l1 := a2) - (l1 mod 1440));
	if (meetingType = 'RepeatingMeeting) then begin
			if (a1 = 'cribNote) then begin
					l2 := l1
				end else begin
					l2 := a2
				end
		end else begin
			if (a1 = 'cribNote) then begin
					l2 := l1
				end else begin
					l2 := (l1 + 1440)
				end
		end;
	local l1;
	local l2;
	(foreach l3 in repeatingEntryFinders do begin
			l3.currentInstance := BSearchLeft(l3.instancesDates, l2, '|<|, nil)
		end);
	self:ChooseEarliestInstance()
end
@@end
