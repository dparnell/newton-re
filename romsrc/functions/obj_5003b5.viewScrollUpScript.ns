@@ 0x5002fd
func() begin
	local l1;
	(if cursor.atBeginningOfCursor then begin
			Sleep(30);
			clicker()
		end else (if (if (maxLines <> 0) then cursor.items) then begin
				l1 := cursor.baseIndex;
				BusyBoxControl(1);
				self:Scroller((-maxLines));
				if (l1 = cursor.baseIndex) then begin
						clicker()
					end;
				RefreshViews()
			end))
end
@@end
