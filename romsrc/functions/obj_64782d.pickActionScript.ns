@@ 0x4bb019
func(a1) begin
	local l1;
	(if HasPath(labelCommands[a1], 'id) then begin
			filter:ResolveItem(labelCommands[a1]);
			self:hilite(nil)
		end else (if (if filter.picker then (a1 = (Length(labelCommands) - 1))) then filter:picker() else (if (not filter:?ChooseItem(a1)) then begin
					if IsFrame((l1 := labelCommands[a1])) then begin
							l1 := (if l1.value then l1.value else l1.item)
						end;
					lastPicked := l1;
					self:UpdateText(Clone(l1));
					self:hilite(nil)
				end)))
end
