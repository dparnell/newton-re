@@ 0x569ba1
func(a1, a2) begin
	local l1, l2;
	l2 := (if (l1 := BFind(SoupChangeRegistry, a1, '|str<|, 'soupName)) then SoupChangeRegistry[l1]);
	if a2 then begin
			if l2 then begin
					if IsReadOnly(l2) then begin
							(l2 := Clone(l2)).callBacks := Clone(l2.callBacks);
							SoupChangeRegistry[l1] := l2
						end
				end else begin
					l2 := {soupName: TotalClone(a1), callBacks: {}};
					BInsert(SoupChangeRegistry, l2, '|str<|, 'soupName, true)
				end
		end;
	l2
end
@@end
