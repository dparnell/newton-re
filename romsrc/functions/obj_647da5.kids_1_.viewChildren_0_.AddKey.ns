@@ 0x532f01
func(a1, a2) begin
	local l1, l2;
	l1 := "";
	if (firstTime or a2) then begin
			l1 := a1;
			firstTime := a2
		end else begin
			l2 := self:Parent():LocalBox().right;
			l1 := Stringer([Array: keyedDigits.text, a1]);
			(while (StrWidth(l1) > l2) do (l1 := Substr(l1, 1, (StrLen(l1) - 1))))
		end;
	SetValue(keyedDigits, 'text, l1)
end
@@end
