@@ 0x465e81
func() begin
	local l1, l2, l3;
	self:SetNewWord(text, nil);
	l1 := template;
	template := nil;
	self:SetNewTemplate(l1);
	template:?Init(self:CurrentWord());
	if self._proto.viewBounds then begin
			maxChars := (((l2 := self:LocalBox()).right - l2.left) div cellWidth)
		end else begin
			maxChars := self._proto.maxChars
		end;
	if (l3 := self:FixedWordLength()) then begin
			maxChars := min(maxChars, l3)
		end;
	self:UseNewTemplate(true)
end
@@end
