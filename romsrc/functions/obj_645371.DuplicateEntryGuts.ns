@@ 0x4afa7d
func(a1, a2) begin
	local l1, l2, l3;
	(if TargetIsCursor(a1) then begin
			l2 := (l1 := GetTargetCursor(a1, nil)):entry();
			(while l2 do begin
					masterSoup:DuplicateEntry(l2, a2);
					(l2 := l1:Next())
				end);
			selected := nil;
			layout:NewTarget()
		end else begin
			dataCursor:Goto((l3 := masterSoup:DuplicateEntry(a1, a2)));
			AddUndoSend(layout, 'KillEntry, [Array: l3]);
			layout:NewTarget()
		end)
end
@@end
