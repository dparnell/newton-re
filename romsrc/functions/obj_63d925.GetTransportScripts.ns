	local l1, l2, l3;
	if ((a1.state = 'pending) or (a1.state = 'ready)) then begin
			return nil
		end;
	l1 := [Array: ];
	if a1.account then begin
			AddArraySlot(l1, {GetTitle: kFunction_5a3471, routeScript: doReply, icon: kROM_756});
			if (((if IsArray(a1.toRef) then (Length(a1.toRef) > 1)) or (if IsArray(a1.cc) then (Length(a1.cc) > 0))) or (if IsArray(a1.bcc) then (Length(a1.bcc) > 0))) then begin
