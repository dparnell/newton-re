@@ 0x5aa9e1
@@const kBinaryFromHex
func(hex, cls) begin
	local b := MakeBinary(StrLen(hex) div 2, cls);
	for i := 0 to Length(b) - 1 do begin
		local h := Ord(hex[2 * i]);
		local l := Ord(hex[2 * i + 1]);
		StuffByte(b, i, (if h >= 97 then h - 87 else h - 48) * 16 + (if l >= 97 then l - 87 else l - 48))
	end;
	b
end
@@const kLiteral_3d69c9
{bits: call kBinaryFromHex with ("", 'bits), bounds: '{left: 0, top: 0, right: 203, bottom: 9}}
@@main
func() begin
	(if (GetLocale().enabledlanguage = 'Swedish) then begin
			icon := kLiteral_3d69c9;
			iconBBox := '{left: 0, top: 0, right: 203, bottom: 9};
			letters := " bcdefghijklmnopqrstuvwxyz\u00E5\u\u00E4\u\u00F6\u";
			(numIndices := 29)
		end)
end
@@end
