@@ 0x563b15
func() begin
	local l1, l2, l3;
	if (if (l1 := GetRoot():?GetBatteryMessages()) then l1.badBattery) then begin
			l2 := l1.badBattery
		end else begin
			l2 := "The main battery is unable to maintain a charge. It needs to be replaced."
		end;
	((l3 := GetRoot():Notify(3, "Battery", l2)).batteryAlert := true)
end
@@end
