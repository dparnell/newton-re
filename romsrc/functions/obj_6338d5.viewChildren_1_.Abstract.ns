	[Array: MakeText(a1.overview, (a2.left + 25), a2.top, a2.right, (a2.top + 11)), (if a1.icon then OffsetShape(MakeShape(a1.icon), (a2.left + ((25 - a1.icon.bounds.right) div 2)), (a2.top + 2)) else ScaleShape(MakeShape(kLiteral_5b49f5), nil, RelBounds((a2.left + 10), a2.top, 16, 16)))]
end
