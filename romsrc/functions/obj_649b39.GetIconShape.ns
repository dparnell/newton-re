@@ 0x549441
func() begin
	local l1, l2, l3;
	if IsInteger((l1 := target.fentry).iconPro) then begin
			l1 := @233[l1.iconPro]
		end else begin
			if IsInteger(l1.icon) then begin
					l1 := @233[l1.icon]
				end
		end;
	if l1.iconPro then begin
			l2 := MakeShape(l1.iconPro.unhilited)
		end else begin
			l2 := [Array: '{transferMode: 1}, MakeShape(l1.icon)]
		end;
	l3 := [Array: l2];
	if target.notActive then begin
			AddArraySlot(l3, MakeShape(@233[10].icon))
		end;
	self:CenterIconShape(l3);
	AddArraySlot(l3, self:GetIconShapeText());
	if IsSoupEntry(target.fentry) then begin
			EntryUndoChanges(target.fentry)
		end;
	l3
end
@@end
