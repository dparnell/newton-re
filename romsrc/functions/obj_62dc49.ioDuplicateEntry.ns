@@ 0x4b207d
func(a1) begin
	local l1, l2, l3, l4;
	l2 := (l1 := GetTargetCursor(a1, '{})):entry();
	try begin
			(while l2 do begin
					l3 := masterSoup:DuplicateEntry(l2, nil);
					if (l4 := GetItemTransport(l2)) then begin
							l4:?ItemDuplicated(l3)
						end;
					(l2 := l1:Next())
				end)
		end onexception |evt.ex| do begin
			selected := nil;
			layout:Retarget('sync);
			Rethrow()
		end;
	if (l1:CountEntries() = 1) then begin
			AddUndoSend(layout, 'KillEntry, [Array: l3])
		end;
	selected := nil;
	layout:Retarget('sync)
end
@@end
