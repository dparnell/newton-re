@@ 0x5b13c5
func() begin
	if (not (l1 := GetUserConfig('outputDevice))) then begin
			l1 := 0
		end;
	l1 := BAnd(l1, 9);
	local l1;
	local l2;
	l2 := (foreach l3 in labelCommands do begin
			if (l3.value = l1) then begin
					break l3
				end
		end);
	if (not l2) then begin
			l2 := labelCommands[0];
			SetUserConfig('outputDevice, l2.value)
		end;
	return l2.item
end
@@end
