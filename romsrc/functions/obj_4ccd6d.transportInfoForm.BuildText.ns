@@ 0x4c8921
func() begin
	local l1, l2;
	l1 := nil;
	if target.printerUsed then begin
			l1 := target.printerUsed
		end else begin
			l1 := GetUserConfig('currentPrinter)
		end;
	l2 := (if StrFilled(l1.printerName) then GetNames(l1.printerName) else GetNames(l1.name));
	(if (if l1 then StrFilled(l1.name)) then self:addText(ParamStr("Printer: ^0", [Array: l2])))
end
@@end
