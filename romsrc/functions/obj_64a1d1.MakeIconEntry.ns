@@ 0x54a0a1
func(a1, a2) begin
	(if @589.(a1) then begin
			l1 := @589.(a1):New();
			if HasSlot(a2, 'labels) then begin
					l1._tagList := Clone(l1._tagList);
					self:ChangeTagListAndLabels(l1, a2.labels)
				end;
			local l1;
			(foreach l2, l3 in a2 do begin
					if l3 then begin
							l1.(l2) := l3
						end
				end);
			l1
		end)
end
@@end
