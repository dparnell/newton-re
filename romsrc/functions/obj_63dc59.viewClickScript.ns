@@ 0x42cc31
func(a1) begin
	local l1, l2, l3;
	(if (if (self = base) then (BAnd(viewFormat, 240) = 208)) then begin
			l1 := GetPoint(0, a1);
			l2 := GetPoint(1, a1);
			l3 := self:GlobalBox();
			(if (if ((l2 - l3.top) < 10) then (abs((l1 - ((l3.left + l3.right) >> 1))) < 10)) then begin
					base:DragWindow(a1);
					true
				end)
		end)
end
