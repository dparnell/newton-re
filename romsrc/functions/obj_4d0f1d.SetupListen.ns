					RegCommConfigChange(appSymbol, func(a1, a2) begin
						(if (a1 = "mods") then self:RedoTheBind())
					end);
					l1 := configOptions;
					if (self:AnySet(manualReceive) or self:GetConfig('hideAutoPref)) then begin
							SetLength((l1 := Clone(configOptions)), configOffsets.serviceSpecific)
						end;
					ep:Instantiate(ep, l1);
					self:ChangeState('preparing);
					ep:Bind(nil, bindSpec)
				end)
		end onexception |evt.ex| do begin
