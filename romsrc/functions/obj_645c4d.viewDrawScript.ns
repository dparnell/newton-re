@@ 0x4be375
func() begin
	local l1, l2;
	l1 := BAnd(viewJustify, 3);
	l2 := 'left;
	if (l1 = 1) then begin
			l2 := 'right
		end else begin
			if (l1 = 2) then begin
					l2 := 'center
				end else begin
					if (l1 = 3) then begin
							l2 := 'full
						end
				end
		end;
	(if shape then self:DrawShape(shape, {font: viewFont, penPattern: BAnd(viewFormat, 15), justification: l2}))
end
@@end
