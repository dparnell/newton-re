@@ 0x500145
@@const kROM_256
@256
@@main
func(a1) begin
	local l1, l2, l3, l4;
	if ((l1 := a1.viewStationery) = 'cribNote) then begin
			l2 := nil
		end else begin
			l2 := HourMinute(a1.mtgStartDate)
		end;
	if (l3 := Clone(self:GetMeetingText(a1))) then begin
			if l2 then begin
					l3 := ParamStr("^0  ^1", [Array: l2, l3])
				end
		end else begin
			l3 := ""
		end;
	if (if (l4 := self:GetNotesData(a1)[1]) then (Length(l4) > 0)) then begin
			l3 := ParamStr("^0 \u2022\u ^1", [Array: l3, ExtractData(l4, kROM_256, 50)])
		end;
	l3
end
@@end
