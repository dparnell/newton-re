			l4 := 1440
		end;
	l5 := nil;
	if (l2.left >= 60) then begin
			l5 := {left: (l6 := max(0, min((DayTable.tabWidths - 100), l2.left))), top: TimeToPosition(dayView, l3), right: DayTable.tabWidths, bottom: TimeToPosition(dayView, l4)}
		end;
