@@ 0x4fc945
func(a1, a2) begin
	local l1, l2, l3, l4, l5, l6, l7;
	l1 := a1;
	l2 := a2;
	if (if GetRemoteWriting() then (GetKeyView() = dayView)) then begin
			l2 := a1.viewBounds
		end;
	l3 := PositionToTime(dayView, l2.top);
	l4 := PositionToTime(dayView, l2.bottom);
	if ((l3 mod 30) = 15) then begin
			l3 := (l3 + 15)
		end;
	l3 := max(startTime, l3);
	if ((l4 - l3) < 60) then begin
			l4 := (l3 + 60)
		end;
