// register4: the certificate (number and password, with a backup password)
register4 := {
	_proto: register1Proto,
	debug: 20916,
	preallocatedContext: 'register4,
	viewChildren: [viewChildren:
		{
			viewBounds: {left: 0, top: 1, right: 0, bottom: 16},
			viewJustify: vjCenterH + vjCenterV + vjParentFullH + vjOneLineOnly,
