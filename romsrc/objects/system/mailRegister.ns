// cardfirstProtoProto: a labelled field showing and setting info's
// configPath slot.
cardfirstProtoProto := {
	viewJustify: vjSiblingBottomV,
	viewLineSpacing: 32,
	deferRec: nil,
	viewBounds: {left: 0, top: 0, right: 614, bottom: 37},
	// TextSetup: the field's text; rich text (ink) with deferRec is put in
	// afterwards by Recognize
	TextSetup: func() begin
		(if (if IsRichString(info.(configPath)) then deferRec) then begin
				AddDeferredSend(self, 'Recognize, nil);
				""
			end else info.(configPath))
	end,
	// textChanged: keeps the text in info
	textChanged: func() begin
		(info.(configPath) := text)
	end,
	// Recognize: puts info's (rich) text in the entry line
	Recognize: func() begin
		SetValue(entryLine, 'text, info.(configPath))
	end,
	_proto: @protoLabelInputLine
};

