// cardAction, and what only it reaches

cardAction := {
	GetTitle: func(a1) begin
		(if (if a1 then (Length(GetStores()) > 1)) then (if (EntryStore(a1) = GetStores()[0]) then "Move to card" else (if EntryStore(a1):IsReadOnly() then "Copy from card" else "Move from card")))
	end,
	routeScript: 'cardActionScript
};
