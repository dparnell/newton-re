// cardAction: magic pointer @363, the root's cardAction - the routing action
// (an item of the Action button's menu) that moves an entry to or from a
// storage card, or copies it from a locked card.  routeScript names the method
// the application is sent to carry it out.

cardAction := {
	// the item's title for target, or nil (the item is left out) when there is no
	// target or no card: "Move to card" for an entry on the internal store, "Copy
	// from card" for one on a read-only card, else "Move from card"
	GetTitle: func(target) begin
		(if (if target then (Length(GetStores()) > 1)) then (if (EntryStore(target) = GetStores()[0]) then "Move to card" else (if EntryStore(target):IsReadOnly() then "Copy from card" else "Move from card")))
	end,
	routeScript: 'cardActionScript
};
