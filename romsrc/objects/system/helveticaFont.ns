// helveticaFont (@109): the printing font family for Helvetica - the faces'
// PostScript names and their sfnt data (metrics for printing), found through
// the printing fonts table (psFonts.helvetica, globalHeapvarwannabes); plus the
// shared "Helvetica" string.

helveticaFont := {
	name: helvetica,
	encoding: 0,
	macFontID: 21,
	psSym: 'helveticaFont,
	normal: helvetica,
	bold: "Helvetica-Bold",
	italic: "Helvetica-Oblique",
	bolditalic: "Helvetica-BoldOblique",
	plainData: sfnt('sfnt, "resources/sfnt/412165"),
	boldData: sfnt('sfnt, "resources/sfnt/412991"),
	italicData: sfnt('sfnt, "resources/sfnt/4131bd"),
	boldItalicData: sfnt('sfnt, "resources/sfnt/4139e9")
};

helvetica := "Helvetica";
