// extraProtos: the Extras Drawer's icon kinds.  Each entry of the extras soup
// has a class (FormEntry, BookEntry, SoupEntry, ROMScriptEntry, ...), and the
// drawer and the button bar wrap the entry (fentry) in a frame whose _proto is
// this frame's slot of that name.  Each kind gives New (a fresh entry, a clone
// of iconEntry), TapAction (what tapping the icon does), Preflight (whether an
// action - 'Filing, 'move, 'delete, 'route, 'freeze, 'Backdrop - may be done,
// 'OK or the reason it may not), and file, move, delete, size, where and
// store.  The ROM... kinds are the built-in icons, which cannot be moved or
// deleted.  In iconEntry, icon indexes the drawer's built-in icons.

extraProtos := {
	|1.XFormEntry|: proto1_2Exformentry,
	// a book from a 1.x package (it cannot be filed or moved)
	|1.XBookEntry|: {
		_proto: proto1_2Exformentry,
		iconEntry: {class: '|1.XBookEntry|, text: uCardPositionAlertButton, icon: 0, packageId: nil, isbn: nil},
		Preflight: func(a1, kids) begin
			"locked"
		end,
		New: func() begin
			Clone(iconEntry)
		end,
		TapAction: TapAction_3
	},
	// the kind of an icon from a package whose kind is not known
	|????Entry|: AutoEntryProto,
	FormEntry: proto1_2ExformentryProto,
	ROMFormEntry: ROMHelpBookEntryProto,
	AutoEntry: AutoEntry,
	FontEntry: {
		_proto: AutoEntryProto,
		iconEntry: {
			class: 'FontEntry,
			text: uCardPositionAlertButton,
			icon: 7,
			sequence: nil,
			labels: '_extensions,
			_tagList: [|Array|: '_icon, '_extensions],
			packageName: nil
		}
	},
	DictEntry: {
		_proto: AutoEntryProto,
		iconEntry: {
			class: 'DictEntry,
			text: uCardPositionAlertButton,
			icon: 8,
			sequence: nil,
			labels: '_extensions,
			_tagList: [|Array|: '_icon, '_extensions],
			packageName: nil
		}
	},
	BookEntry: {
		_proto: proto1_2ExformentryProto,
		iconEntry: {
			class: 'BookEntry,
			text: uCardPositionAlertButton,
			icon: 0,
			sequence: nil,
			labels: nil,
			_tagList: [|Array|: '_icon],
			packageName: nil,
			isbn: nil
		},
		Preflight: Preflight,
		TapAction: TapAction_3
	},
	HelpBookEntry: {
		_proto: proto1_2ExformentryProto,
		iconEntry: {
			class: 'HelpBookEntry,
			text: uCardPositionAlertButton,
			icon: 1,
			sequence: nil,
			labels: '_help,
			_tagList: [|Array|: '_icon, '_help],
			packageName: nil,
			isbn: nil
		},
		Preflight: Preflight,
		TapAction: TapAction_4
	},
	ROMHelpBookEntry: {
		_proto: ROMHelpBookEntryProto,
		iconEntry: {
			class: 'ROMHelpBookEntry,
			text: uCardPositionAlertButton,
			icon: 1,
			sequence: nil,
			labels: '_help,
			_tagList: [|Array|: '_icon, '_help, '_noBackup],
			isbn: nil,
			app: nil,
			packageId: nil,
			type: nil
		},
		Preflight: func(a1, kids) begin
			(if (a1 = 'Filing) then 'OK else "built-in")
		end,
		file: func(labels) begin
			fentry.labels := labels;
			true
		end,
		TapAction: TapAction_4
	},
	FrozenEntry: {
		_proto: proto1_2ExformentryProto,
		iconEntry: {
			class: 'FrozenEntry,
			text: uCardPositionAlertButton,
			icon: 9,
			sequence: nil,
			labels: nil,
			_tagList: [|Array|: '_icon, '_snowflake],
			packageName: nil
		},
		// a frozen package's icon: tapping it thaws the package
		Preflight: compile(
			constants: {
				kLiteral_536a15: "locked"
			},
			func(a1, kids) begin
				(if ((a1 = 'Filing) or (a1 = 'delete)) then (if (not EntryStore(fentry):IsReadOnly()) then 'OK else kLiteral_536a15) else (if (a1 = 'move) then (if self:copyprotected() then "copy protected" else (if EntryStore(fentry):IsReadOnly() then kLiteral_536a15 else 'OK)) else (if (a1 = 'route) then 'OK else (if (a1 = 'freeze) then "already frozen" else "frozen"))))
			end),
		TapAction: func() begin
			ThawPackage(self:LookupSoupPackage());
			nil
		end
	},
	// the icon of a soup in the Storage folder: tapping it opens the soupervisor
	// (storage manager) on the soup; deleting it deletes the soup's data
	SoupEntry: {
		_proto: proto1_2ExformentryProto,
		iconEntry: {
			class: 'SoupEntry,
			text: uCardPositionAlertButton,
			icon: 4,
			sequence: nil,
			labels: '_soups,
			_tagList: [|Array|: '_icon, '_soups],
			soupNames: nil,
			closeControl: 'leaveOpen
		},
		size: size_2,
		store: delete_3,
		where: where,
		Preflight: Preflight_2,
		delete: delete_4,
		TapAction: TapAction_2
	},
	ROMSoupEntry: {
		_proto: ROMHelpBookEntryProto,
		iconEntry: {
			class: 'ROMSoupEntry,
			text: uCardPositionAlertButton,
			icon: 4,
			sequence: nil,
			labels: '_soups,
			_tagList: [|Array|: '_icon, '_soups, '_noBackup],
			soupNames: nil,
			closeControl: 'leaveOpen
		},
		Preflight: Preflight_2,
		TapAction: TapAction_2,
		delete: delete_4,
		where: where
	},
	// an action icon of a package: tapping it runs the entry's TapAction
	ScriptEntry: {
		_proto: proto1_2ExformentryProto,
		iconEntry: {
			class: 'ScriptEntry,
			text: uCardPositionAlertButton,
			icon: 5,
			sequence: nil,
			labels: nil,
			_tagList: [|Array|: '_icon, '_scriptIcon],
			packageName: nil,
			TapAction: nil
		},
		Preflight: func(a1, kids) begin
			(if (((a1 = 'Filing) or (a1 = 'move)) or (a1 = 'delete)) then (if (not EntryStore(fentry):IsReadOnly()) then 'OK else "locked") else (if (a1 = 'route) then 'OK else (if (if self:LookupSoupPackage() then (a1 = 'freeze)) then 'OK else "the wrong kind")))
		end,
		// the entry's size in K
		size: func() begin
			Stringer([Array: max(1, (EntrySize(fentry) div 1024)), "K"])
		end,
		delete: func() begin
			(if self:LookupSoupPackage() then inherited:delete() else EntryRemoveFromSoup(fentry))
		end,
		move: func(maxLines) begin
			local name, soup;
			(if self:LookupSoupPackage() then inherited:move(maxLines) else begin
					soup := maxLines:GetSoup((name := EntrySoup(fentry):GetName()));
					if EntryStore(fentry):IsReadOnly() then begin
							EntryCopyXmit(fentry, soup, '_newt)
						end else begin
							EntryMoveXmit(fentry, soup, '_newt)
						end;
					true
				end)
		end,
		TapAction: TapAction
	},
	ROMScriptEntry: {
		_proto: ROMHelpBookEntryProto,
		iconEntry: {
			class: 'ROMScriptEntry,
			text: uCardPositionAlertButton,
			icon: 5,
			sequence: nil,
			labels: nil,
			_tagList: [|Array|: '_icon, '_noBackup],
			TapAction: nil
		},
		Preflight: func(a1, kids) begin
			(if ((a1 = 'Filing) or (a1 = 'route)) then 'OK else (if ((a1 = 'delete) or (a1 = 'move)) then "built-in" else "the wrong kind"))
		end,
		file: file_2,
		move: move,
		TapAction: TapAction
	},
	PackageEntry: proto1_2ExformentryProto,
	ROMPackageEntry: ROMHelpBookEntryProto,
	AutoPackageEntry: AutoEntry
};

// the size of a built-in item: not shown
size_2 := func() begin
	"--"
end;

// the built-in applications' icons (and the base of the other ROM... kinds)
ROMHelpBookEntryProto := {
	_proto: proto1_2Exformentry,
	iconEntry: {
		class: 'ROMFormEntry,
		text: uCardPositionAlertButton,
		icon: 2,
		sequence: nil,
		labels: nil,
		_tagList: _tagList,
		app: nil
	},
	New: func() begin
		Clone(iconEntry)
	end,
	where: func() begin
		"Built-in"
	end,
	size: size_2,
	store: func() begin
		GetStores()[0]
	end,
	move: move,
	// may be filed or routed, or made the backdrop when the application allows
	// it and fits the screen as it is; nothing else
	Preflight: func(a1, kids) begin
		local l1;
		(if ((a1 = 'Filing) or (a1 = 'route)) then 'OK else (if (if (a1 = 'Backdrop) then (Length(kids) = 1)) then begin
					if (l1 := GetRoot().(fentry.app)).noBackdrop then begin
							return "the wrong kind"
						end;
					if (if (displayParams.appAreaHeight < 320) then (not l1.ReOrientToScreen)) then begin
							return "not designed for this orientation"
						end;
					'OK
				end else "built-in"))
	end,
	// files the icon in folder labels: the folder tag goes in the entry's tag list
	file: func(labels) begin
		if IsReadOnly(fentry._tagList) then begin
				fentry._tagList := Clone(fentry._tagList)
			end;
		if fentry.labels then begin
				SetRemove(fentry._tagList, fentry.labels)
			end;
		if labels then begin
				SetAdd(fentry._tagList, labels, true);
				fentry.labels := labels
			end else begin
				fentry.labels := nil
			end;
		EntryChange(fentry);
		true
	end,
	delete: func() begin
		EntryRemoveFromSoup(fentry)
	end
};

// the Preflight of a package's icon: filing, deleting and freezing need the
// entry's store to be writable, a copy-protected package cannot be moved
Preflight := compile(
	constants: {
		kLiteral_536a15: "locked",
		kLiteral_536afd: "copy protected"
	},
	func(a1, a2) begin
		(if (((a1 = 'Filing) or (a1 = 'delete)) or (a1 = 'freeze)) then (if (not EntryStore(fentry):IsReadOnly()) then 'OK else kLiteral_536a15) else (if (a1 = 'route) then 'OK else (if (a1 = 'move) then (if self:copyprotected() then kLiteral_536afd else (if EntryStore(fentry):IsReadOnly() then kLiteral_536a15 else 'OK)) else (if (a1 = 'send) then (if self:copyprotected() then kLiteral_536afd else 'OK) else "the wrong kind"))))
	end);

// the base of the icons of packages: tapping one activates its package (if
// frozen) and runs the entry's TapAction; one that has none says so
AutoEntryProto := {
	_proto: proto1_2ExformentryProto,
	iconEntry: {
		class: '|????Entry|,
		text: uCardPositionAlertButton,
		icon: 6,
		sequence: nil,
		labels: '_extensions,
		_tagList: [|Array|: '_icon, '_extensions],
		packageName: nil
	},
	Preflight: Preflight,
	TapAction: func() begin
		local soupPackageAndActivate;
		(if (soupPackageAndActivate := self:LookupSoupPackageAndActivate()) then (if fentry.TapAction then fentry:TapAction() else (if (soupPackageAndActivate <> 'justActivated) then begin
						// 3: an alert, shown at once
						GetRoot():Notify(3, "Packages", "Tapping this does nothing.");
						nil
					end)))
	end
};

AutoEntry := {
	_proto: AutoEntryProto,
	iconEntry: {
		class: 'AutoEntry,
		text: uCardPositionAlertButton,
		icon: 3,
		sequence: nil,
		labels: '_extensions,
		_tagList: [|Array|: '_icon, '_extensions],
		packageName: nil
	}
};

// tapping an action icon: runs its TapAction once its package is active
TapAction := func() begin
	(if (if fentry.TapAction then self:LookupSoupPackageAndActivate()) then fentry:TapAction())
end;

// the names of the stores that hold any of the entry's soups, as a list
where := func() begin
	local validStores;
	local text;
	(foreach item in (validStores := GetValidStores()) do begin
			(foreach item2 in fentry.soupNames do begin
					if item:HasSoup(item2) then begin
							text := Stringer([Array: (if text then Stringer([Array: text, $,])), " ", item:GetName()]);
							break
						end
				end)
		end);
	(if (not text) then "" else text)
end;

// a soup's icon may be routed or deleted unless it is one the internal store
// must keep (emptyInternal)
Preflight_2 := func(a1, a2) begin
	(if (if (not fentry.emptyInternal) then ((a1 = 'route) or (a1 = 'delete))) then 'OK else "the wrong kind")
end;

// deletes the entry's soups on every writable store (or on the store the
// drawer is showing), telling the owner application (or the drawer)
delete_4 := func() begin
	local storesFilter;
	local l2;
	(foreach item in (l2 := (if (storesFilter := GetRoot().ExtrasDrawer.storesFilter) then [Array: storesFilter] else GetStores())) do begin
			if (not item:IsReadOnly()) then begin
					if (not (extrasDrawer := (if fentry.ownerApp then GetRoot().(fentry.ownerApp)))) then begin
							extrasDrawer := GetRoot().ExtrasDrawer
						end;
					local extrasDrawer;
					(foreach item2 in fentry.soupNames do begin
							local soup;
							if (soup := item:GetSoup(item2)) then begin
									try begin
											soup:RemoveFromStoreXmit(extrasDrawer.appSymbol)
										end onexception |evt.ex| do begin
											self:Notify(3, "Packages", ParamStr("Unable to delete the data from ^0", [Array: item:GetName()]))
										end
								end
						end)
				end
		end)
end;

// the return value says whether the drawer closes afterwards
TapAction_2 := func() begin
	local soupervisor;
	(if (soupervisor := GetRoot().soupervisor) then begin
			soupervisor:OpenTo(fentry);
			(if fentry.closeControl then (fentry.closeControl = 'alwaysClose) else GetUserConfig('ExtraAlwaysClose))
		end)
end;

// a book's icon: opens it in the book reader (copperfield), closing a different
// book first
TapAction_3 := func() begin
	local copperfield, l2;
	(if self:LookupSoupPackageAndActivate() then begin
			if (l2 := (copperfield := GetRoot().copperfield):CurrentBook()) then begin
					if (not StrEqual(l2.isbn, fentry.isbn)) then begin
							copperfield:Close();
							copperfield:viewPreOpenScript(fentry.isbn)
						end
				end else begin
					copperfield:PrepBook(fentry.isbn)
				end;
			self:_Open(copperfield)
		end)
end;

// a help book's icon: opens it in the help reader (TinyTim), or closes the
// reader when it already shows this book
TapAction_4 := func() begin
	local tinyTim;
	(if self:LookupSoupPackageAndActivate() then begin
			if (if (tinyTim := GetRoot().TinyTim).viewCObject then StrEqual(tinyTim.isbn, fentry.isbn)) then begin
					tinyTim:Close();
					return nil
				end;
			AddDeferredSend(tinyTim, 'OpenHelpBook, [Array: fentry.isbn]);
			(if fentry.closeControl then (fentry.closeControl = 'alwaysClose) else GetUserConfig('ExtraAlwaysClose))
		end)
end;

// what the functions above hold and share with other objects (same(): romsrc/README.md)

store_code := same("ROMHelpBookEntryProto.store.instructions");

Preflight_literal13 := same("ROMHelpBookEntryProto.Preflight.literals[13]");

delete_4_literal14 := same("delete_4.literals[14]");
