// ioTransportheader (@818): the header at the top of an In/Out Box item: the
// transport's icon (a button opening the transport's info slip,
// transportInfoForm) and the title the transport draws for the item
// (GetTitleInfoShape).

ioTransportheader := {
	viewClass: clView,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 32},
	viewJustify: vjCenterV + vjParentFullH,
	viewFlags: vVisible + vClipping + vClickable,
	viewFont: tsSystem + tsSize(10) + tsBold,
	viewFormat: 0,
	infoSlip: nil,
	routeSlip: nil,
	debug: "TransportTitle",
	// viewQuitScript: closes the info slip and routing slip if open.
	viewQuitScript: func() begin
		if (infoSlip <> nil) then begin
				infoSlip:Close();
				infoSlip := nil
			end;
		(if (routeSlip <> nil) then begin
				routeSlip:Close();
				(routeSlip := nil)
			end)
	end,
	// InfoChanged(changed): called by the info slip when it closes; if the
	// item was changed, saves it and redraws the title.
	InfoChanged: func(changed) begin
		if changed then begin
				layout:FlushData();
				title:viewUpdateFormScript()
			end;
		(infoSlip := nil)
	end,
	preallocatedContext: 'transportheader,
	viewChildren: [viewChildren:
		{
			viewBounds: {left: 0, top: 0, right: 32, bottom: 20},
			viewFormat: 0,
			icon: nil,
			// the icon button: the transport's icon
			viewSetupFormScript: func() begin
				icon := transport.icon;
				(_titleKeyButton := self)
			end,
			// toggles the transport's info slip; a transport without one says so
			buttonClickScript: func() begin
				(if infoSlip then begin
						infoSlip:Close();
						(infoSlip := nil)
					end else (if (if transport then transport.transportInfoForm) then begin
							layout:FlushData();
							(infoSlip := transport.transportInfoForm:New(target, transport, self:GlobalBox(), self))
						end else self:Notify(kNotifyAlert, "InOut Box", "No Information Available")))
			end,
			// forgets the _titleKeyButton
			viewQuitScript: func() begin
				(_titleKeyButton := nil)
			end,
			debug: 381876,
			_proto: @protoPictureButton
		},
		title_3
	],
	title: nil,
	allocateContext: [|Array|: 'title, title_3]
};

// title_3: the header's title view, drawing the shape the item's transport
// makes for it (GetTitleInfoShape) in the view's box.
title_3 := {
	viewClass: clView,
	viewBounds: {left: 37, top: 0, right: 0, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	viewFont: tsSystem + tsSize(10) + tsBold,
	viewFlags: vVisible + vClipping,
	bits: nil,
	// viewSetupFormScript / viewUpdateFormScript: (re)make the title shape
	viewSetupFormScript: func() begin
		(if target then (bits := transport:GetTitleInfoShape(target, self:LocalBox())))
	end,
	// (viewUpdateFormScript: sent by InfoChanged after the item changed)
	viewUpdateFormScript: func() begin
		(if target then SetValue(self, 'bits, transport:GetTitleInfoShape(target, self:LocalBox())))
	end,
	// viewDrawScript: draws the title shape
	viewDrawScript: func() begin
		(if bits then self:DrawShape(bits, '{transferMode: 0, penPattern: 0, fillPattern: 1}))
	end,
	preallocatedContext: 'title
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewDrawScript_literal1_2 := same("title_3.viewDrawScript.literals[1]");
