// pageFooter (@140): the "Page n" footer at the bottom of a printed page;
// protoPrintForm sends it TurnPage (as _pageTurner) when a new page starts.

pageFooter := {
	viewBounds: {left: 0, top: -20, right: 0, bottom: 0},
	viewJustify: vjCenterH + vjParentFullH + vjParentBottomV,
	viewFont: tsFancy + tsSize(9),
	// TurnPage(): sets the text to "Page" and fields.pageNumber.
	TurnPage: func() begin
		(self.text := Stringer([Array: "Page", " ", fields.pageNumber]))
	end,
	// viewSetupFormScript: registers itself as the print form's _pageTurner and
	// shows the first page number.
	viewSetupFormScript: func() begin
		_pageTurner := self;
		self:TurnPage()
	end,
	_proto: @protoStaticText
};
