			},
			{
				class: 'ROMSoupEntry,
				text: @paperrollSoupName,
				icon: 4,
				sequence: 29,
				labels: '_soups,
				_tagList: [|Array|: '_icon, '_soups, '_noBackup],
				soupNames: [|Array|: @paperrollSoupName],
