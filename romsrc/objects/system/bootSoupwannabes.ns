					GetUserConfig('ExtraAlwaysClose)
				end,
				iconPro: 27,
				app: 'assistant
			}
		],
		soupDef: @extrasSoupDef
	},
	{
		// the Notepad soup starts empty
		initialEntries: func() begin
			[Array: ]
		end,
		soupDef: @paperrollSoupDef
	},
	{initialEntries: nil, soupDef: @calendarSoupDef},
	{initialEntries: nil, soupDef: @repeatMeetingSoupDef},
	{initialEntries: nil, soupDef: @calendarNotesSoupDef},
	{initialEntries: nil, soupDef: @repeatNotesSoupDef},
	{initialEntries: nil, soupDef: @todoSoupDef},
	{initialEntries: nil, soupDef: @todo2SoupDef},
	{
		// the system directory ("meta") soup: an entry per built-in application's data
		// saying the application provides its own description of its soups
		// (builtInMetaData)
		initialEntries: [|Array|:
			{soup: uCardPositionAlertButton, app: 'calendar, builtInMetaData: true},
			{soup: uCardPositionAlertButton, app: 'cardfile, builtInMetaData: true},
			{soup: uCardPositionAlertButton, app: 'paperroll, builtInMetaData: true},
			{soup: uCardPositionAlertButton, app: 'iobox, builtInMetaData: true},
			{soup: uCardPositionAlertButton, app: 'ExtrasDrawer, builtInMetaData: true},
			{soup: uCardPositionAlertButton, app: 'system, builtInMetaData: true},
			{soup: uCardPositionAlertButton, app: 'systemDirectory, builtInMetaData: true}
		],
		soupDef: {
			name: @metaSoupName,
			userName: @metaSoupName,
			ownerApp: 'systemDirectory,
			userDescr: private,
			indexes: [|Array|:
				{structure: 'slot, path: 'soup, type: '|string|},
				{structure: 'slot, path: 'app, type: 'symbol}
			]
		}
	}
];

alarms := "Alarms";

// the alarms soup (soupDef: the first of the array above)
soupDef := {
	name: systemAlarmSoup,
	userName: alarms,
	ownerApp: 'alarms,
	ownerAppName: alarms,
	userDescr: "alarm data",
	indexes: [|Array|:
		{structure: 'slot, type: 'int, path: 'TimeInSeconds},
		{structure: 'slot, type: 'int, path: 'Time},
		{structure: 'slot, type: '|string|, path: 'key}
	]
};

clock_3 := "Clock";

