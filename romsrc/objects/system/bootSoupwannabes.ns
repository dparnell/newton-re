				icon: 24,
				sequence: -1,
				labels: '_buttonBar,
				_tagList: [|Array|: '_icon, '_noBackup, '_buttonBar],
				app: 'ExtrasDrawer,
				iconPro: 24
			},
			{
				class: 'ROMScriptEntry,
				text: undo,
				icon: 25,
				sequence: 34,
				labels: '_buttonBar,
				_tagList: [|Array|: '_icon, '_noBackup, '_buttonBar],
				TapAction: func() begin
					// 114 is the undo command's code (as the Undo button posts it)
					PostCommand('application, 114);
					GetUserConfig('ExtraAlwaysClose)
				end,
				iconPro: 25,
				app: 'undo
			},
			{
				class: 'ROMScriptEntry,
				text: find,
				icon: 26,
				sequence: 35,
				labels: '_buttonBar,
				_tagList: [|Array|: '_icon, '_noBackup, '_buttonBar],
				TapAction: func() begin
					GetRoot().findDrawer:PrimeAndOpen();
					GetUserConfig('ExtraAlwaysClose)
				end,
				iconPro: 26,
				app: 'findDrawer
			},
			{
				class: 'ROMScriptEntry,
				text: assist,
				icon: 27,
				sequence: 36,
				labels: '_buttonBar,
				_tagList: [|Array|: '_icon, '_noBackup, '_buttonBar],
				TapAction: func() begin
