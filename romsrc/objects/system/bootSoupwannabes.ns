			{
				class: 'ROMScriptEntry,
				text: "Owner\u000dInfo",
				icon: 19,
				sequence: 21,
				labels: nil,
				_tagList: [|Array|: '_icon, '_noBackup],
				TapAction: func() begin
					AddDeferredSend(GetRoot().cardfile, 'OpenAsOwner, '[Array: true]);
					GetUserConfig('ExtraAlwaysClose)
				end,
				iconPro: 19,
				app: 'OwnerInfo
			},
			{
				class: 'ROMFormEntry,
				text: "Writing\u000dPractice",
				icon: 20,
				sequence: 23,
				labels: '_setup,
				_tagList: [|Array|: '_icon, '_noBackup, '_setup],
