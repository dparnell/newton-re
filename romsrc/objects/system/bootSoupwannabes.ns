				app: 'iobox,
				iconPro: 21
			},
			{
				class: 'ROMFormEntry,
				text: @cardfileSoupName,
				icon: 22,
				sequence: 31,
				labels: '_buttonBar,
				_tagList: [|Array|: '_icon, '_noBackup, '_buttonBar],
