// ioProtoReceiveButton, and what only it reaches

ioProtoReceiveButton := {
	width: nil,
	viewBounds: {left: -57, top: 14, right: -7, bottom: 30},
	viewJustify: vjCenterH + vjParentRightH,
	text: receive,
	items: nil,
	viewSetupFormScript: func() begin
		if (currentSoupSymbol = 'outbox) then begin
				self.text := "  Send";
				self.checkSlot := 'SendRequest
			end else begin
				self.text := "  Receive";
				self.checkSlot := 'ReceiveRequest
			end;
		width := StdButtonWidth(text);
		(viewBounds := Clone(viewBounds)).left := (viewBounds.right - width);
		(_sendKeyButton := self)
	end,
	buttonClickScript: func() begin
		items := [Array: ];
		(foreach l1 in transports do begin
				local l3;
				if (if (if (l3 := GetRoot().(l1)) then l3.(checkSlot)) then (l3.owner = appSymbol)) then begin
						AddArraySlot(items, {item: l3.title, icon: l3.icon, indent: 28, transport: l3})
					end
			end);
		(connectPopup := GetView(DoPopup(items, (width + 2), 0, self)))
	end,
	pickActionScript: func(a1) begin
		local l1, l2, l3;
		l1 := items[a1].transport;
		items := nil;
		if ((l2 := self:GetTargetInfo('Routing)).target = nil) then begin
				if (self.checkSlot = 'ReceiveRequest) then begin
						if labelsFilter then begin
								l3 := labelsFilter;
								labelsFilter := nil;
								self:FilterChanged();
								if filterBar then begin
										filterBar:UpdateFilter(l3, nil)
									end
							end;
						self:TransportCall(l1, 'ReceiveRequest, [Array: {cause: 'user}])
					end else begin
						self:StartSend(l1, 'user, nil, nil)
					end
			end else begin
				self:ScriptRequest(l1, self.checkSlot, l2.target)
			end;
		inherited:pickActionScript(a1)
	end,
	viewQuitScript: func() begin
		(_sendKeyButton := nil)
	end,
	_proto: @protoPopupButton
};

receive := "  Receive";
