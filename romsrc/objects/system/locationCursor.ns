// locationCursor, and what only it reaches

locationCursor := {
	move: func(a1) begin
		if romOnly then begin
				return realCurs:move(a1)
			end;
		if (a1 <> 0) then begin
				if (a1 < 0) then begin
						(for l1 := 1 to abs(a1) do begin
								self:prev()
							end)
					end else begin
						(for l1 := 1 to a1 do begin
								self:Next()
							end)
					end
			end;
		self:entry()
	end,
	Goto: func(a1) begin
		realCurs:Goto(a1)
	end,
	GotoKey: func(a1) begin
		local l1;
		if (if (l1 := realCurs:GotoKey(a1)) then (l1.kind = 'delete)) then begin
				l1 := self:Next()
			end;
		l1
	end,
	Next: func() begin
		local l1;
		if romOnly then begin
				return realCurs:Next()
			end;
		if (((not (l1 := self:entry())) or (not l1.kind)) or (l1.kind = 'Add)) then begin
				l1 := realCurs:Next()
			end else begin
				l1 := realCurs:move(2)
			end;
		(while (if l1 then (l1.kind = 'delete)) do (l1 := realCurs:move(2)));
		l1
	end,
	prev: func() begin
		local l1, l2;
		if romOnly then begin
				return realCurs:prev()
			end;
		(while true do begin
				if ((not (l1 := realCurs:prev())) or (l1.kind = 'Add)) then begin
						return l1
					end;
				if (not (l2 := realCurs:prev())) then begin
						realCurs:Reset();
						return l1
					end;
				if ((not l2.kind) or (l2.kind = 'Add)) then begin
						return realCurs:Next()
					end;
				(if (l2.kind = 'Replace) then return l2)
			end)
	end,
	Reset: func() begin
		local l1;
		l1 := realCurs:Reset();
		self:entry()
	end,
	ResetToEnd: func() begin
		local l1, l2;
		l1 := realCurs:ResetToEnd();
		if romOnly then begin
				return l1
			end;
		if (not (l2 := realCurs:move(-1))) then begin
				return realCurs:ResetToEnd()
			end;
		if (l2.kind = 'delete) then begin
				return self:prev()
			end;
		if (l2.kind = 'Replace) then begin
				return l2
			end;
		realCurs:move(1)
	end,
	entry: func() begin
		local l1;
		l1 := realCurs:entry();
		if (not romOnly) then begin
				(while (if l1 then ((l1 = 'deleted) or (l1.kind = 'delete))) do (if (l1 = 'deleted) then (l1 := realCurs:Next()) else (l1 := realCurs:move(2))))
			end;
		l1
	end,
	clone: func() begin
		local l1;
		(l1 := Clone(self)).realCurs := realCurs:clone();
		l1
	end,
	|map|: func(a1) begin
		local l1, l2;
		l1 := [Array: ];
		l2 := self:entry();
		(while l2 do begin
				if ((not a1) or (if a1 then call a1 with (l2))) then begin
						AddArraySlot(l1, l2)
					end;
				(l2 := self:Next())
			end);
		l1
	end,
	mapadd: func(a1, a2) begin
		local l1, l2;
		(l1 := self:clone()):Reset();
		l2 := l1:entry();
		(while l2 do begin
				if ((not a1) or (if a1 then call a1 with (l2))) then begin
						AddArraySlot(a2, l2)
					end;
				(l2 := l1:Next())
			end);
		a2
	end,
	CountEntries: func() begin
		local l1, l2, l3, l4;
		if romOnly then begin
				return realCurs:CountEntries()
			end;
		l1 := realCurs:CountEntries();
		l2 := realCurs:indexPath();
		l3 := GetStores()[0]:GetSoup(realCurs:soup():GetName());
		l4 := l3:Query({type: 'index, indexPath: 'kind, beginKey: 'delete, endKey: 'Replace});
		(l1 - l4:CountEntries())
	end,
	SlowCountEntries: func() begin
		local l1, l2;
		if romOnly then begin
				return realCurs:CountEntries()
			end;
		l1 := 1;
		(l2 := self:clone()):Reset();
		(while l2:Next() do (l1 := (l1 + 1)));
		l1
	end,
	WhichEnd: func() begin
		realCurs:WhichEnd()
	end,
	soup: func() begin
		realCurs:soup()
	end,
	indexPath: func() begin
		realCurs:indexPath()
	end
};
