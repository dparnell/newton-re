		_proto: nil,
		viewCObject: nil,
		roll: nil,
		viewclipper: nil,
		base: nil,
		gyreCount: nil,
		viewFlags: vApplication + vFloating
	}
};

roll := {
	viewFlags: vVisible + vApplication + vClipping,
	viewJustify: vjParentFullH + vjParentFullV,
	viewFormat: 0,
	viewBounds: {left: 15, top: 15, right: -15, bottom: -25},
	viewSetupFormScript: func() begin
		(self.items := Notifications)
	end,
	viewScrollUpScript: func() begin
		if (not allCollapsed) then begin
				self:MarkItemSeen(index, nil)
			end;
		inherited:?viewScrollUpScript()
	end,
	viewScrollDownScript: func() begin
		if (not allCollapsed) then begin
				self:MarkItemSeen(index, nil)
			end;
		inherited:?viewScrollDownScript()
	end,
	viewOverviewScript: func() begin
