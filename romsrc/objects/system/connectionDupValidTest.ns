// connectionDupValidTest: the validTest of the query TDocker::IsDuplicateEntry
// makes when restoring selectively: whether a soup entry equals the entry being
// restored, slot by slot (the native ConnEntriesEqual; src/comms/Docker.cpp).

connectionDupValidTest := func(a1) begin
	ConnEntriesEqual(a1)
end;

// what the functions above hold and share with other objects (same(): romsrc/README.md)

connectionDupValidTest_code := same("connectionDupValidTest.instructions");
