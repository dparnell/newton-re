// validSlots, and what only it reaches

validSlots := {
	location: {
		place: {
			inputProto: {
				_proto: @newtLabelInputLine,
				viewQuitScript: func() begin
					target.sorton := target.(path);
					self:StartFlush()
				end
			},
			theText: "Worksite",
			type: 'text
		},
		areacode: {inputProto: @newtAreacodeLine, theText: areaCode_2, type: 'number},
		country: {
			inputProto: {
				_proto: @protoLabelPicker,
				viewBounds: {left: 0, top: 4, right: 0, bottom: 20},
				viewJustify: vjParentFullH + vjSiblingBottomV,
				text: country,
				pickerSetup: func() begin
					local box;
					(box := self:GlobalBox()).right := ((box.left + indent) - 2);
					@locationPopup:New({default: GetCountryEntry(GetUserConfig('currentCountry))[0], spots: @countrySoupName, result: 'symbol}, box, self);
					nil
				end,
				pickActionScript: func(index) begin
					local name;
					name := GetCountryEntry(index)[0].name;
					if (target = GetUserConfig('location)) then begin
							target.country := index
						end else begin
							target.countrySymbol := index;
							target.country := name
						end;
					self:UpdateText(name);
					self:hilite(nil);
					self:StartFlush()
				end
			},
			type: 'symbol
		},
		closestcity: {
			inputProto: {
				_proto: @protoCitiesTextPicker,
				viewBounds: {left: 0, top: 4, right: 0, bottom: 20},
				viewJustify: vjParentFullH + vjSiblingBottomV,
				viewLineSpacing: 14,
				viewSetupFormScript: func() begin
					params := {spots: @citySoupName, result: nil};
					inherited:?viewSetupFormScript()
				end,
				pickActionScript: func(index) begin
					target.cityAlias := [Array: index.name, index.longitude, index.latitude];
					if (not target.countrySymbol) then begin
							target.countrySymbol := index.country
						end;
					if (not target.areacode) then begin
							target.areacode := index.areacode
						end;
					if (not StrFilled(target.country)) then begin
							target.country := GetCountryEntry(index.country)[0].name
						end;
					self:StartFlush();
					inherited:pickActionScript(index.name)
				end
			},
			HasData: func(key) begin
				(if (if (if key.cityAlias then key.countrySymbol) then key.areacode) then StrFilled(key.country))
			end,
			theText: closestCity,
			type: 'symbol
		},
		mailPhone: {
			inputProto: {
				viewClass: clView,
				viewFlags: vVisible + vClickable,
				viewFormat: 0,
				viewBounds: {left: 0, top: 0, right: 0, bottom: 50},
				viewJustify: vjParentFullH + vjSiblingBottomV,
				DataChangeNotify: func(a1, id) begin
					local cityFromAlias, bcEmailNetwork;
					(if (a1 = 'mailNetwork) then (if (if (cityFromAlias := GetCityFromAlias(target.cityAlias)) then (bcEmailNetwork := GetRoot().cardfile:bcEmailNetwork(cityFromAlias, id))) then mailPhone:UpdateText(ConvertIntToPhone(bcEmailNetwork[0].mailPhone))))
				end,
				viewQuitScript: func() begin
					(if (not target.(mailPhone.path)) then begin
							target.(mailNetwork.path) := nil;
							self:StartFlush()
						end)
				end,
				viewChildren: [viewChildren: mailPhone, mailNetwork],
				mailPhone: nil,
				allocateContext: [|Array|: 'mailPhone, mailPhone, 'mailNetwork, mailNetwork],
				mailNetwork: nil
			},
			getPath: func(a1, a2) begin
				if ((not a1.mailAccess) or (Length(a1.mailAccess) < 1)) then begin
						a1.mailAccess := [Array: {}]
					end;
				'[pathExpr: mailAccess, 0]
			end,
			HasData: func(key) begin
				local convertIntToPhone2;
				convertIntToPhone2 := ConvertIntToPhone(key.mailAccess[0].mailPhone);
				(if key.mailAccess[0].mailNetwork then StrFilled(convertIntToPhone2))
			end,
			type: 'number
		},
		connectionPhone: {inputProto: @newtLabelPhoneInputLine, theText: phone, type: 'number},
		connectionNetwork: {inputProto: @newtNetChooser, type: 'symbol},
		KServerNetwork: {inputProto: {memory: 'KServer, NBPLookupType: "DockerK", _proto: @newtNetChooser}, type: 'symbol}
	},
	owner: {
		email: {
			inputProto: {
				_proto: @newtPopupEdit,
				viewBounds: {left: 0, top: 0, right: 0, bottom: 32},
				viewLineSpacing: 25,
				newRecFlags: 64001,
				newRecTextFlags: 10,
				emailclass: nil,
				viewSetupFormScript: func() begin
					local value;
					if (Length((value := GetVariable(context, 'addressSymbols))) > 0) then begin
							emailclass := value[0]
						end;
					inherited:viewSetupFormScript()
				end,
				viewQuitScript: func() begin
					inherited:?viewQuitScript();
					(if (if emailclass then target.(path)) then begin
							SetClass(target.(path), emailclass);
							self:StartFlush()
						end)
				end
			},
			theText: "E-Mail Acct",
			getPath: func(a1, a2) begin
				value2 := GetVariable(a2, 'addressSymbols);
				(if (if (if a1.email then (Length(value2) > 0)) then IsInstance(a1.email, value2[0])) then return 'email else begin
						local list;
						local value2;
						(foreach key, value in a1.emailAddrs do begin
								if (not value.email) then begin
										list := [pathExpr: 'emailAddrs, key, 'email]
									end else begin
										if (if (Length(value2) > 0) then IsInstance(value.email, value2[0])) then begin
												return [pathExpr: 'emailAddrs, key, 'email]
											end
									end
							end);
						(if (not a1.email) then return 'email else (if list then return list else begin
									AddArraySlot(a1.emailAddrs, {});
									return [pathExpr: 'emailAddrs, (Length(a1.emailAddrs) - 1), 'email]
								end))
					end)
			end,
			type: 'text
		},
		emailPassword: {
			inputProto: @newtLabelInputLine,
			theText: "E-Mail Password",
			getPath: func(a1, a2) begin
				value2 := GetVariable(a2, 'addressSymbols);
				(if (if (if a1.email then (Length(value2) > 0)) then IsInstance(a1.email, value2[0])) then return 'emailPassword else begin
						local list;
						local value2;
						(foreach key, value in a1.emailAddrs do begin
								if (not value.email) then begin
										list := [pathExpr: 'emailAddrs, key, 'emailPassword]
									end else begin
										if (if (Length(value2) > 0) then IsInstance(value.email, value2[0])) then begin
												return [pathExpr: 'emailAddrs, key, 'emailPassword]
											end
									end
							end);
						(if (not a1.email) then return 'emailPassword else return list)
					end)
			end,
			type: 'text
		}
	}
};

mailPhone := {
	label: "E-Mail Access #",
	path: [pathExpr: 'mailAccess, 0, 'mailPhone],
	preallocatedContext: 'mailPhone,
	_proto: @newtLabelPhoneInputLine
};

mailNetwork := {
	GetSymArray: func() begin
		GetVariable(context, 'networkSymbols)
	end,
	path: [pathExpr: 'mailAccess, 0, 'mailNetwork],
	preallocatedContext: 'mailNetwork,
	_proto: @newtMailNetChooser
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

GetSymArray_code := same("mailNetwork.GetSymArray.instructions");
