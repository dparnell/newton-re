// vPhoneKeypad, and what only it reaches
//
// The call transport's keypad slip (magic pointer 586), a status slip
// layout ('vPhoneKeypad) shown during a call: an "LCD" showing the digits
// keyed, a touch-tone keypad that sends each digit down the call, a Quick
// Entry popup of the owner's and the current item's numbers, a speaker
// toggle, and Hang Up. Its values (valueData.values) are by the views'
// names.

vPhoneKeypad := {
	height: 200,
	name: 'vPhoneKeypad,
	kids: [|Array|:
		@protoStatusText,
		{
			viewClass: clView,
			viewFlags: vVisible,
			viewFormat: vfFrameBlack + vfPen(2),
			viewBounds: {top: 10, left: 10, right: -10, bottom: 33},
			viewJustify: vjParentFullH + vjSiblingBottomV,
			name: 'LCD_Screen,
			debug: 35824,
			viewChildren: [viewChildren:
				{
					viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
					viewJustify: vjCenterV + vjParentFullH + vjParentFullV + vjOneLineOnly,
					viewFont: tsSystem + tsSize(14) + tsBold,
					firstTime: true,
					// Called as the view is set up: becomes base.keyedDigits, showing the
					// digits the slip's values hold for it.
					viewSetupFormScript: func() begin
						base.keyedDigits := self;
						(text := self:path().(name))
					end,
					// Called as the view closes: forgets it.
					viewQuitScript: func() begin
						(base.keyedDigits := nil)
					end,
					// Shows text2: replacing what is shown when it is the first key or a2 is
					// true (a number picked from Quick Entry, after which the next key starts
					// afresh), else appended, losing digits from the front until it fits.
					AddKey: func(text2, a2) begin
						local text, right;
						text := "";
						if (firstTime or a2) then begin
								text := text2;
								firstTime := a2
							end else begin
								right := self:Parent():LocalBox().right;
								text := Stringer([Array: keyedDigits.text, text2]);
								(while (StrWidth(text) > right) do (text := Substr(text, 1, (StrLen(text) - 1))))
							end;
						SetValue(keyedDigits, 'text, text)
					end,
					name: 'keyedDigits,
					debug: 81047,
					_proto: @protoStatusText
				}
			]
		},
		{
			viewBounds: {left: 50, top: 13, right: -50, bottom: 110},
			viewJustify: vjParentFullH + vjParentFullV + vjSiblingBottomV,
			// A key pressed: shows the digit and sends it as a tone down the call.
			keyPressScript: func(char2) begin
				keyedDigits:AddKey(Stringer([Array: "", char2]), nil);
				GetRoot().(appSymbol).callEndpoint:SendDigit(char2, true);
				true
			end,
			name: 'phonePad,
			debug: 11086,
			_proto: @touchtonePad
		},
		{
			viewBounds: {left: 5, top: -18, right: 75, bottom: -5},
			viewJustify: vjCenterH + vjCenterV + vjParentBottomV,
			popup: nil,
			text: "  Quick Entry",
			// Called as the popup is set up: its items are the owner card's phone
			// numbers, the owner's credit card numbers and the custom fields of the
			// card the call is to (the current item's first toRef), a separator
			// between the groups.
			viewSetupFormScript: func() begin
				popup := [Array: ];
				if (l1 := ResolveEntryAlias(GetUserConfig('currentPersona))) then begin
						if (if IsArray((l2 := GetRoot().cardfile:bcPhoneNumber(l1, 'phone))) then (Length(l2) > 0)) then begin
								local l1;
								local l2;
								(foreach l3 in l2 do begin
										self:addCmds(ParamStr("^0 ^1", [Array: PhoneTypes.phoneText.(ClassOf(l3)), "Phone"]), MakeDisplayPhone(l3), nil)
									end)
							end;
						// note: the separator is added before the first credit card even when no
						// phone numbers came before it
						l5 := true;
						if (if IsArray((l6 := GetRoot().cardfile:bcCreditCards(l1, '|string.card|))) then (Length(l6) > 0)) then begin
								local l5;
								local l6;
								(foreach l7 in l6 do begin
										l5 := self:addCmds(l7.creditCardName, l7.creditCardNum, l5)
									end)
							end
					end;
				l5 := true;
				l9 := GetRoot().(appSymbol).currentItem;
				l10 := nil;
				l11 := nil;
				if (if (if (if (if l9 then (l10 := l9.toRef)) then (Length(l10) > 0)) then l10[0]) then (l11 := EntryFromObj(l10[0]))) then begin
						local l9;
						local l10;
						local l11;
						local l12;
						(foreach l13 in (l12 := GetRoot().cardfile:bcCustomFields(l11, nil)) do begin
								l5 := self:addCmds(l13.label, l13.value, l5)
							end)
					end;
				inherited:?viewSetupFormScript()
			end,
			// Adds item a1 with value a2 unless a2 is empty or not a string, or the
			// popup holds 25 already; a3 true puts a separator before it. Answers nil
			// once it has added the item (no separator before the next), else a3.
			addCmds: func(a1, a2, a3) begin
				if (if (if (if a2 then (not IsImmediate(a2))) then StrFilled(a2)) then (Length(popup) < 25)) then begin
						if a3 then begin
								AddArraySlot(popup, 'pickseparator)
							end;
						AddArraySlot(popup, {item: a1, value: a2});
						a3 := nil
					end;
				a3
			end,
			// Called once set up: hides the popup if it has nothing to offer.
			viewSetupDoneScript: func() begin
				(if (if popup then (Length(popup) > 0)) then inherited:?viewSetupDoneScript() else self:Hide())
			end,
			// A number picked: shows it and dials it.
			pickActionScript: func(index) begin
				local value;
				inherited:pickActionScript(index);
				(if StrFilled((value := popup[index].value)) then begin
						keyedDigits:AddKey((value := strtophone(value)), true);
						GetRoot().(appSymbol).callEndpoint:MakeOutgoing(value, true)
					end)
			end,
			name: 'QuickDial,
			debug: 22842,
			_proto: @protoPopupButton
		},
		{
			viewBounds: {left: 7, top: -18, right: 23, bottom: -5},
			viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingRightH,
			viewFlags: vVisible + vReadOnly + vClickable,
			// The slip's values, by the views' names.
			path: func() begin
				valueData.values
			end,
			SpeakerIsOn: true,
			icon: kidsIcon,
			speakerOnIcon: kidsIcon,
			speakerOffIcon: {
				bits: bitmap('bits, "resources/bits/53380d.png", "00000000000400ac00ac003d00b70044", 1),
				bounds: {left: 0, top: 0, right: 7, bottom: 11}
			},
			viewAction: nil,
			// Turns the speaker off or on, changing the icon.
			buttonClickScript: func() begin
				(if SpeakerIsOn then begin
						GetRoot().(appSymbol):SetSpeaker(nil);
						SetValue(self, 'icon, speakerOffIcon);
						(SpeakerIsOn := nil)
					end else begin
						GetRoot().(appSymbol):SetSpeaker(true);
						SetValue(self, 'icon, speakerOnIcon);
						(SpeakerIsOn := true)
					end)
			end,
			// Called once set up: shown only when the slip's values have a
			// SpeakerToggle value.
			viewSetupDoneScript: func() begin
				local path;
				(if (path := self:path()).(name) then self:Show() else self:Hide())
			end,
			name: 'SpeakerToggle,
			debug: 371049,
			_proto: @protoPictureButton
		},
		{
			viewBounds: {left: -72, top: -18, right: -25, bottom: -5},
			constViewBounds: {left: -72, top: -18, right: -25, bottom: -5},
			text: hangUp,
			// Hang up: cancels the call.
			buttonClickScript: func() begin
				GetRoot().(appSymbol):CancelRequest(0)
			end,
			debug: 2406,
			_proto: @protoDefaultStatusButton
		}
	]
};

kidsIcon := {
	bits: bitmap('bits, "resources/bits/533795.png", "00000000000400240024003e002f004a", 1),
	bounds: {left: 0, top: 0, right: 12, bottom: 11}
};
