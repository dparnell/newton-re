// ioItemLayout (@819): the In/Out Box's item layout - the page that shows one
// In Box or Out Box item (a newtPageLayout, "IOList"), with the item drawn by
// the data view its class registers (the entry's dataView, or the transport's
// IOBoxExtensions choice), scrolled a screen at a time and flipped to the
// next or previous item at either end. Also holds entryview, the embedded
// view the data view's children go in.

ioItemLayout := {
	// viewSetupDoneScript: does nothing (overrides the proto's)
	viewSetupDoneScript: func() begin
		nil
	end,
	// the one child: the item's entry view (ioEntrybase), holding entryview
	viewChildren: [viewChildren:
		{
			viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
			viewJustify: vjParentFullH + vjParentFullV,
			viewFlags: vVisible + vClipping,
			transport: nil,
			declareSelf: 'ioEntrybase,
			firstTime: true,
			checkCaret: checkCaret,
			// viewSetupFormScript: sizes the entry view - for a roll-scrolling data
			// view as tall as the item's height (a third of a screen more in the Out
			// Box, and at least a screen), else the parent's height. The first time
			// it also reports the item's last error (unless the transport ignores
			// it) and asks the transport to fetch a remote item's body. Registers
			// itself as newtAppBase.ioEntryView.
			viewSetupFormScript: func() begin
				local target2, box, l3, l4, translateError;
				if firstTime then begin
						inherited:?viewSetupFormScript();
						viewBounds := Clone(viewBounds)
					end;
				if target then begin
						target2 := target;
						if (if (if targetViewDef then targetViewDef.rollScrolling) then target2.height) then begin
								viewJustify := vjParentFullH;
								viewBounds.bottom := target2.height;
								// l3: the parent's height
								l3 := ((box := self:Parent():LocalBox()).bottom - box.top);
								if (currentSoupSymbol = 'outbox) then begin
										l4 := (l3 div 3);
										viewBounds.bottom := (viewBounds.bottom + l4)
									end;
								if (viewBounds.bottom < (viewOriginY + l3)) then begin
										viewBounds.bottom := (viewOriginY + l3)
									end
							end else begin
								viewJustify := vjParentFullH + vjParentFullV;
								viewBounds.bottom := 0
							end;
						if firstTime then begin
								transport := GetItemTransport(target);
								if (if (if target then transport) then (not transport:ignoreError(target.error))) then begin
										translateError := transport:TranslateError(target.error);
										self:Notify(kNotifyAlert, "Last error detected:", translateError);
										target.error := nil;
										EntryChange(target)
									end;
								// a remote item: only its header is here, so have the
								// transport receive the rest
								if target.Remote then begin
										self:DoRequest(transport, 'ReceiveRequest, 'Remote, target)
									end;
								firstTime := nil
							end
					end;
				(newtAppBase.ioEntryView := self)
			end,
			// viewQuitScript: marks the item read, unless the view is only closing
			// for a scroll within the same item.
			viewQuitScript: func() begin
				transport := nil;
				if (not scrolling) then begin
						self:?MarkRead(target)
					end;
				inherited:?viewQuitScript()
			end,
			// SetViewDef(symbol): switches the item to the data view of that
			// symbol (the Show button's choice), remembers it in the entry's
			// dataView and rebuilds the view.
			SetViewDef: func(symbol2) begin
				local l1;
				l1 := viewDefFrame.(symbol2);
				(if (targetViewDef <> l1) then begin
						targetViewDef := l1;
						layout.entryViewDefs := [Array: targetViewDef];
						target.dataView := symbol2;
						EntryChange(target);
						self:SyncView();
						self:RedoChildren()
					end)
			end,
			// StartFlushWithChild(view): an edited child (a1) is to be saved. Checks
			// the caret half a second later, grows the item's height to hold the
			// child (5 pixels below it), then starts the flush.
			StartFlushWithChild: func(a1) begin
				local caretInfo, bottom;
				if (if (caretInfo := GetCaretInfo()) then (caretInfo.view = a1)) then begin
						AddProcrastinatedSend('checkCaret, targetView, 'checkCaret, nil, 500)
					end;
				bottom := a1.viewBounds.bottom;
				if (if target.height then (bottom > target.height)) then begin
						target.height := (bottom + 5);
						// 0: re-sync after the flush (FlushEntry below)
						nextEntry := 0
					end;
				self:StartFlush()
			end,
			// FlushEntry(entry): saves as inherited, then re-syncs the view if the
			// item grew.
			FlushEntry: func(a1) begin
				inherited:?FlushEntry(a1);
				(if (nextEntry = 0) then self:SyncView())
			end,
			// EntryCool(entry): whether the entry may be edited - never in the
			// In Box; in the Out Box as inherited.
			EntryCool: func(a1) begin
				if (currentSoupSymbol = 'inbox) then begin
						return nil
					end;
				inherited:EntryCool(a1)
			end,
			// FilingChangedX: the item was filed; refiles it in its soup.
			FilingChangedX: func() begin
				self:Fileit(target);
				inherited:FilingChangedX()
			end,
			debug: 81529,
			viewChildren: [viewChildren: entryview],
			entryview: nil,
			allocateContext: [|Array|: 'entryview, entryview],
			_proto: @newtEntryView
		}
	],
	// SetupCursor: remakes the master soup's cursor (after a filter change)
	// keeping it on the current entry if that is still a soup entry.
	SetupCursor: func() begin
		local entry;
		entry := masterSoup.theCursor:entry();
		masterSoup:SetupCursor();
		if IsSoupEntry(entry) then begin
				masterSoup.theCursor:Goto(entry)
			end;
		inherited:?SetupCursor()
	end,
	scrolling: nil,
	viewBounds: {left: 0, top: 32, right: 0, bottom: -25},
	_proto: @newtPageLayout,
	mastersoupSlot: nil,
	// FilterChanged: the folder or sort changed; new cursor, view and target.
	FilterChanged: func() begin
		self:SetupCursor();
		self:SyncView();
		self:NewTarget()
	end,
	// Scroller: called back by the page-flip Effect (PrepScroller) to move to
	// the new item; clears any selection first.
	Scroller: func(maxLines) begin
		if HiliteOwner() then begin
				// 48: aeRemoveAllHilites (src/views/Commands.h), the selection cleared
				PostCommand(HiliteOwner(), 48)
			end;
		self:Retarget(true)
	end,
	// ShowFoundItem(entry, finder): Find's "show this item" - passed to the
	// entry view's data view with the entry's target.
	ShowFoundItem: func(a1, a2) begin
		(if (if ioEntryView then ioEntryView.entryview) then ioEntryView.entryview:?ShowFoundItem(self:GetTargetFromEntry(a1), a2))
	end,
	theEntry: nil,
	// the scroll arrows: a screen down or up, or the next/previous item
	viewScrollDownScript: func() begin
		self:PrepScroller(true)
	end,
	prevScrollEntry: nil,
	// Retarget(redo): moves the cursor off a deleted or missing entry (to the
	// next, else the previous, else a new cursor); with redo, shows the item
	// or goes back to the overview when there is none. Then tells the views
	// in retargetChain.
	Retarget: func(a1) begin
		if (((entry := dataCursor:entry()) = 'deleted) or (entry = nil)) then begin
				dataCursor:Next();
				if (dataCursor:entry() = nil) then begin
						dataCursor:prev()
					end;
				if (dataCursor:entry() = nil) then begin
						self:SetupCursor()
					end
			end;
		if a1 then begin
				if (not dataCursor:entry()) then begin
						newtAppBase:ShowLayout('overview)
					end else begin
						self:RedoChildren()
					end
			end;
		// the decompiler's placement: entry is this function's local throughout
		local entry;
		(if retargetChain then (foreach item in retargetChain do begin
					item:RetargetNotify()
				end))
	end,
	viewJustify: vjParentFullH + vjParentFullV,
	name: "IOList",
	saveviewBounds: {left: 0, top: 32, right: 0, bottom: -25},
	// (scroll up: see viewScrollDownScript)
	viewScrollUpScript: func() begin
		self:PrepScroller(nil)
	end,
	// DuplicateEntry and KillEntry: the In/Out Box's own versions (ioDuplicateEntry,
	// ioKillEntry, in the application base).
	DuplicateEntry: func(a1) begin
		self:ioDuplicateEntry(a1)
	end,
	// PrepScroller(down): a scroll arrow. Scrolls the item a screen (less 16
	// pixels) within a roll-scrolling item, else flips to the next (down) or
	// previous item with a page-turning Effect that calls Scroller; with no
	// item to go to, back to the overview.
	PrepScroller: func(a1) begin
		local l1, nextScrollEntry2, box, l4, entry, l6;
		scrolling := nil;
		l1 := nil;
		nextScrollEntry2 := nil;
		l4 := ((box := self:LocalBox()).bottom - 16);
		entry := dataCursor:entry();
		if (((not entryViewDefs) or (not entry)) or (entry = 'deleted)) then begin
				l1 := true
			end else begin
				if a1 then begin
						if (((l6 := (if (if entryViewDefs[0].rollScrolling then entry.height) then (entry.height + (box.bottom div 3)) else 0)) - viewOriginY) <= box.bottom) then begin
								nextScrollEntry2 := nextScrollEntry
							end else begin
								scrolling := true;
								viewOriginY := (viewOriginY + l4)
							end
					end else begin
						if (viewOriginY > 0) then begin
								scrolling := true;
								viewOriginY := max(0, (viewOriginY - l4))
							end else begin
								nextScrollEntry2 := prevScrollEntry
							end
					end
			end;
		if nextScrollEntry2 then begin
				viewOriginY := 0;
				dataCursor:Goto(nextScrollEntry2);
				nextScrollEntry := dataCursor:Next();
				dataCursor:Goto(nextScrollEntry2);
				prevScrollEntry := dataCursor:prev();
				dataCursor:Goto(nextScrollEntry2)
			end;
		(if (l1 or (if (not nextScrollEntry2) then (not scrolling))) then begin
				self:Retarget(nil);
				newtAppBase:ShowLayout('overview)
			// 77725696: the flip effect's fx flags (0x04A20000)
			end else (if a1 then self:Effect(77725696, true, @flip, 'Scroller, [Array: 1]) else self:Effect(77725696, nil, @flip, 'Scroller, [Array: -1])))
	end,
	declareSelf: 'base,
	// viewSetupFormScript: picks the In Box's or Out Box's soup and remembers
	// the current item's transport, format and its neighbours for the flips.
	viewSetupFormScript: func() begin
		mastersoupSlot := currentSoupSymbol;
		masterSoup := allSoups.(mastersoupSlot);
		inherited:?viewSetupFormScript();
		transport := GetItemTransport((fields := dataCursor:entry()));
		activeFormat := GetCurrentFormat(fields);
		theEntry := nil;
		nextScrollEntry := dataCursor:Next();
		dataCursor:Goto(fields);
		prevScrollEntry := dataCursor:prev();
		dataCursor:Goto(fields)
	end,
	routeScripts: [|Array|: ],
	nextScrollEntry: nil,
	// KillEntry(entry): deletes the item (ioKillEntry)
	KillEntry: func(target) begin
		self:ioKillEntry(target)
	end,
	_closeBox: nil,
	debug: 160442,
	forceNewEntry: nil,
	// viewSetupChildrenScript: (unless only scrolling) makes the current item
	// the target and chooses its data view - the entry's dataView, or what the
	// transport's IOBoxExtensions says, else the first public editor or
	// viewer registered for its class; rebuilds the header and status bar.
	// With no item, goes back to the overview.
	viewSetupChildrenScript: func() begin
		nextEntry := 0;
		if scrolling then begin
				scrolling := nil;
				return nil
			end;
		target := (theEntry := (entry := dataCursor:entry()));
		transport := GetItemTransport((fields := theEntry));
		activeFormat := GetCurrentFormat(fields);
		entryViewDefs := nil;
		routeScripts := Clone(base.routeScripts);
		entries := (if entry then [Array: entry] else [Array: ]);
		if (if (key := DataClassOf(entry)) then (copy := Clone(GetDataViews(key)))) then begin
				dataView := 'default;
				if (if entry then entry.dataView) then begin
						dataView := entry.dataView
					end;
				if transport then begin
						if (iOBoxExtensions := transport:?IOBoxExtensions(entry, self:GetTargetFromEntry(entry), copy, routeScripts)) then begin
								dataView := iOBoxExtensions
							end
					end;
				currentViewSymbol := nil;
				// a private view is the transport's own, not to be chosen by default
				if (if (value := copy.(dataView)) then (value.protection <> 'private)) then begin
						currentViewSymbol := dataView
					end else begin
						// (the decompiler's placement of the function's locals)
						local entry;
						local copy;
						local key;
						local dataView;
						local iOBoxExtensions;
						(foreach key, value in copy do begin
								if (if ((value.type = 'editor) or (value.type = 'viewer)) then ((value.protection = 'public) or (value.protection = nil))) then begin
										currentViewSymbol := key;
										break
									end
							end)
					end;
				if currentViewSymbol then begin
						entryViewDefs := [Array: copy.(currentViewSymbol)]
					end
			end else begin
				entryViewDefs := nil
			end;
		viewDefFrame := copy;
		if transportheader.viewCObject then begin
				transportheader:RedoChildren()
			end;
		if itemStatus.viewCObject then begin
				itemStatus:RedoChildren()
			end;
		(if (entry = nil) then AddDeferredSend(newtAppBase, 'ShowLayout, [Array: 'overview]))
	end,
	viewDefFrame: nil
};

// entryview: the embedded entry view the item's data view is built in;
// write-protected unless the parent says the entry may be edited.
entryview := {
	viewFlags: vVisible + vClipping + vWriteProtected,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	viewChildren: nil,
	viewDef: nil,
	path: 'body,
	// viewSetupFormScript: an editable entry drops vWriteProtected.
	viewSetupFormScript: func() begin
		(if self:Parent():EntryCool(nil) then (viewFlags := vVisible + vClipping))
	end,
	// viewSetupChildrenScript: as inherited, then shows the parent's target.
	viewSetupChildrenScript: func() begin
		inherited:viewSetupChildrenScript();
		(self.fields := parentTarget)
	end,
	// GetTargetFromEntry(entry): the global function of that name (the item's
	// body, for a data view).
	GetTargetFromEntry: func(a1) begin
		GetTargetFromEntry(a1)
	end,
	debug: 642633,
	preallocatedContext: 'entryview,
	_proto: @newtEmbeddedEntryView
};
