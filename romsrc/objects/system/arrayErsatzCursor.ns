// arrayErsatzCursor, and what only it reaches

arrayErsatzCursor := {
	things: nil,
	index: nil,
	validTest: nil,
	New: func(a1, a2) begin
		local frame2;
		frame2 := {_parent: self, things: a2, index: 0, validTest: nil};
		if a1 then begin
				frame2.validTest := a1.validTest
			end;
		frame2:GotoKey(0);
		frame2
	end,
	move: func(maxLines) begin
		local entry, l2;
		if ((index := (index + maxLines)) < -1) then begin
				index := -1
			end else begin
				if (index > Length(things)) then begin
						index := Length(things)
					end
			end;
		entry := self:entry();
		l2 := (if (maxLines < 0) then -1 else 1);
		(loop begin
				if (not (entry = 'deleted)) then begin
						if ((not entry) or (not validTest)) then begin
								break entry
							end;
						if call validTest with (entry) then begin
								break entry
							end
					end;
				(entry := self:move(l2))
			end)
	end,
	Goto: func(a1) begin
		if (not (index := ArrayPos(things, a1, 0, nil))) then begin
				index := -1
			end;
		self:entry()
	end,
	GotoKey: func(a1) begin
		local entry;
		if (ClassOf(a1) = 'int) then begin
				index := a1
			end else begin
				index := -1
			end;
		entry := self:entry();
		(loop begin
				if (not (entry = 'deleted)) then begin
						if ((not entry) or (not validTest)) then begin
								break entry
							end;
						if call validTest with (entry) then begin
								break entry
							end
					end;
				(entry := self:move(1))
			end)
	end,
	Next: func() begin
		local move;
		(loop (if (not ((move := self:move(1)) = 'deleted)) then begin
					if ((not move) or (not validTest)) then begin
							break move
						end;
					(if call validTest with (move) then break move)
				end))
	end,
	prev: func() begin
		local move;
		(loop (if (not ((move := self:move(-1)) = 'deleted)) then begin
					if ((not move) or (not validTest)) then begin
							break move
						end;
					(if call validTest with (move) then break move)
				end))
	end,
	Reset: func() begin
		self:GotoKey(0)
	end,
	ResetToEnd: func() begin
		local thing;
		index := (Length(things) - 1);
		thing := things[index];
		(loop begin
				if (not (thing = 'deleted)) then begin
						if ((not thing) or (not validTest)) then begin
								break thing
							end;
						if call validTest with (thing) then begin
								break thing
							end
					end;
				(thing := self:move(-1))
			end)
	end,
	entry: func() begin
		(if (if (index >= 0) then (index < Length(things))) then things[index])
	end,
	clone: func() begin
		Clone(self)
	end,
	CountEntries: func() begin
		(if (not validTest) then Length(things) else begin
				l1 := 0;
				local l1;
				(foreach item in things do begin
						if call validTest with (item) then begin
								l1 := (l1 + 1)
							end
					end);
				l1
			end)
	end
};
