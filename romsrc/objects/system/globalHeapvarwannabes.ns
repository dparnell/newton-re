								viewJustify: vjRightH + vjSiblingFullH + vjSiblingTopV,
								viewBounds: {left: 0, top: 0, right: 0, bottom: 24},
								text: "fast, less\u000daccurately",
								_proto: @protoStaticText
							},
							transformMyHandwriting,
							TimeoutOptionSlider,
							immediately,
							afterADelay
						],
						SpeedOptionSlider: nil,
						stepallocatecontext: [|Array|: 'SpeedOptionSlider, SpeedOptionSlider, 'TimeoutOptionSlider, TimeoutOptionSlider],
						TimeoutOptionSlider: nil,
						_proto: @protoPrefsRollItem
					}
				],
				// closes the sub-panel the Options popup opened
				CloseOpenPanel: func() begin
					if openPanel then begin
							openPanel:Close()
						end;
					(openPanel := nil)
				end,
				// the settings are saved when the panel closes
				viewQuitScript: func() begin
					EntryChange(userConfiguration)
				end,
				// "Use default settings": removes the user's recognition settings from the
				// user configuration, reads the defaults back, and offers to turn off guest
				// access if it was on
				UseDefault: func() begin
					self:CloseOpenPanel();
					(foreach item in '[Array: letterSetSelection, lineAtATime, letterSpaceCursiveOption, speedCursiveOption, timeoutCursiveOption, wordsCursiveOption, lettersCursiveOption, lettersInFieldsOption, numbersCursiveOption, punctuationcursiveoption, remoteWriting, inkWordScaling, doAutoAdd, learningEnabledOption] do begin
							RemoveSlot(userConfiguration, item)
						end);
					ReadCursiveOptions();
					SetRemoteWriting(GetRemoteWriting());
					(if userConfiguration.guestAccessOption then (if ModalConfirm("The guest user settings have been reset.  Would you like to turn off guest user and reset the main settings as well?", 'yesNoDefaultNo) then begin
								userConfiguration.guestAccessOption := nil;
								(userConfiguration.savedWritingStyleOptions := nil)
							end))
				end,
				debug: 37393237,
				stepChildren: [stepChildren:
					{
						_proto: @protoRecognitionCluster,
						viewBounds: {left: 0, top: 5, right: 0, bottom: 105},
