							label,
							LetterSetCluster,
							wordExample,
							LetterSpaceSlider,
							{
								viewJustify: vjSiblingFullH + vjSiblingBottomV + oneLineOnly,
								viewBounds: {left: 0, top: -1, right: 0, bottom: 11},
								text: "closely spaced",
								_proto: @protoStaticText
							},
							{
								viewJustify: vjRightH + vjSiblingFullH + vjSiblingTopV + oneLineOnly,
								viewBounds: {left: 0, top: 0, right: 0, bottom: 12},
								text: "widely spaced",
								_proto: @protoStaticText
							}
						],
						LetterSpaceSlider: nil,
						allocateContext: [|Array|:
							'label,
							label,
							'LetterSetCluster,
							LetterSetCluster,
							'wordExample,
							wordExample,
							'LetterSpaceSlider,
							LetterSpaceSlider
						]
					},
					GuestAccessBox,
					{
						text: options,
						viewBounds: {left: 7, top: -18, right: 58, bottom: -5},
						viewJustify: vjCenterH + vjCenterV + vjParentBottomV,
						useList: nil,
						// the Options popup: the sub-panels of the current recogniser (rosForms for
						// the printing recogniser "WREC", paraForms for cursive), then "Use default
						// settings"
						buttonClickScript: func() begin
							local l1;
							popup := (foreach item in (l1 := (useList := (if StrEqual("WREC", userConfiguration.currentwordrecognizer) then rosForms else paraForms))) collect item.overview);
							AddArraySlot(popup, 'pickseparator);
							AddArraySlot(popup, "Use default settings");
							inherited:buttonClickScript()
						end,
						pickActionScript: func(index) begin
							if (index = (Length(popup) - 1)) then begin
									self:UseDefault();
									panel:RedoChildren();
									if openPanel then begin
											openPanel:RedoChildren()
										end
								end else begin
									self:CloseOpenPanel();
									openPanel := OpenPrefsTo(useList[index])
								end;
							inherited:pickActionScript(index)
						end,
						_proto: @protoPopupButton
					},
					{
						viewBounds: {left: 7, top: -18, right: 60, bottom: -5},
						viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingRightH,
						text: "Align Pen",
						// Align Pen: the tablet calibration
						buttonClickScript: func() begin
							self:hilite(nil);
							CalibrateTablet()
						end,
						_proto: @protoTextButton
					},
					{_proto: @protoCancelButton}
				],
