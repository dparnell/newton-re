// the sound output picker: what the machine has (the Gestalt sound query's
// output bits: 1 the speaker, 8 line out, both together)
outputSourcePicker := {
	viewJustify: vjCenterV + vjParentFullH + vjSiblingBottomV,
	viewBounds: {left: 10, top: 8, right: 10, bottom: 23},
	text: "Play using",
	labelCommands: nil,
	viewSetupFormScript: func() begin
		local gestalt2, l2;
		l2 := (if (gestalt2 := Gestalt('[Array: 33554441, [Array: struct, boolean, boolean, boolean, boolean, Real, long, long], 1])) then gestalt2[6] else 0);
		labelCommands := [Array: ];
		if (BAnd(l2, 1) <> 0) then begin
				AddArraySlot(labelCommands, {item: "Internal Speaker", value: 1})
			end;
		if (BAnd(l2, 8) <> 0) then begin
				AddArraySlot(labelCommands, {item: "Line-out", value: 8})
			end;
		if (BAnd(l2, 9) = 9) then begin
				AddArraySlot(labelCommands, {item: "Speaker & Line-out", value: 9})
			end;
		inherited:?viewSetupFormScript()
	end,
	TextSetup: func() begin
		if (not (outputDevice := GetUserConfig('outputDevice))) then begin
				outputDevice := 0
			end;
		outputDevice := BAnd(outputDevice, 9);
		local outputDevice;
		local labelCommand;
		labelCommand := (foreach item in labelCommands do begin
				if (item.value = outputDevice) then begin
						break item
					end
			end);
		if (not labelCommand) then begin
				labelCommand := labelCommands[0];
				SetUserConfig('outputDevice, labelCommand.value)
			end;
		return labelCommand.item
	end,
	// the new output plays the alert sound once it is set
	LabelActionScript: func(index) begin
		local value;
		value := labelCommands[index].value;
		AddDeferredCall(func() begin
			SetOutputDevice(value);
			PlaySoundSync(GetRegisteredSound(GetUserConfig('beepSound)));
			SetUserConfig('outputDevice, value)
		end, nil)
	end,
	preallocatedContext: 'outputSourcePicker,
	_proto: @protoLabelPicker
};

