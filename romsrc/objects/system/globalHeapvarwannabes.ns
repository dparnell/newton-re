					TimeSpec: 170636,
					GetContent: func() begin
						Stringer([Array: TimeStr(meeting.mtgStartDate, TimeSpec), " ", $-, " ", TimeStr((meeting.mtgStartDate + self:GetMeetingSlot(meeting, 'mtgDuration)), TimeSpec), "\n", LongDateStr(meeting.mtgStartDate, @datetimeStrSpecs.longDateStrSpec)])
					end
