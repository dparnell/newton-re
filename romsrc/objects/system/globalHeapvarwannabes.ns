	_proto: @protoTextButton
};

removePIN := "Remove PIN";

// Remove PIN: only with the PIN
RemovePINButton := {
	viewBounds: {left: 52, top: 27, right: 117, bottom: 42},
	viewJustify: vjCenterH + vjCenterV + vjParentCenterH + oneLineOnly,
	text: removePIN,
	buttonClickScript: func() begin
		AddDeferredCall(func() begin
			(if ModalCheckPIN("Enter PIN", GetUserConfig('passwordkey)) then begin
					SetUserConfig('usepassword, nil);
					SetUserConfig('passwordkey, nil);
					base:RedoChildren()
				end else self:Notify(3, "Remove PIN", "An incorrect PIN has been entered, PIN was not removed."))
		end, nil)
	end,
	preallocatedContext: 'RemovePINButton,
	_proto: @protoTextButton
};

// how often to ask for the PIN: at every power on, hourly or daily (0, 60 or
// 1440 minutes), or never; changing it needs the PIN
PINFreqPicker := {
	text: "Ask For PIN",
	viewBounds: {left: 25, top: 50, right: 0, bottom: 65},
	viewJustify: vjParentFullH,
	viewFlags: vVisible + vReadOnly + vClickable,
	labelCommands: [|Array|: "Every Power On", "Once an Hour", "Once a Day", never],
	TextSetup: func() begin
		local passwordFrequency;
		passwordFrequency := GetUserConfig('passwordFrequency);
		(if ((not GetUserConfig('usepassword)) or (if GetUserConfig('usepassword) then (not passwordFrequency))) then labelCommands[3] else (if (passwordFrequency = 0) then labelCommands[0] else (if (passwordFrequency = 60) then labelCommands[1] else (if (passwordFrequency = 1440) then labelCommands[2]))))
	end,
	LabelActionScript: func(index) begin
		(if (index = 3) then SetUserConfig('usepassword, nil) else begin
				SetUserConfig('usepassword, true);
				SetUserConfig('passwordFrequency, ([Array: 0, 60, 1440, nil])[index])
			end)
	end,
	viewClickScript: func(unit) begin
		if (not self:TrackHilite(unit)) then begin
				return nil
			end;
		if GetUserConfig('passwordkey) then begin
				AddDeferredCall(func() begin
					(if ModalCheckPIN("Enter PIN", GetUserConfig('passwordkey)) then self:Popit((indent - 2)) else self:Notify(3, "PIN Entry", "An incorrect PIN has been entered. Please try again."))
				end, nil)
			end else begin
				self:Popit((indent - 2))
			end;
		self:hilite(nil);
		true
	end,
	preallocatedContext: 'PINFreqPicker,
	_proto: @protoLabelPicker
};

