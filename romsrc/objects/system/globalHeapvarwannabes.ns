			]
		}
	},
	// the parts registered through the 1.x interface
	|Parts1.x|: [|Array|: ],
	// PowerOnRegistry: functions told when the machine wakes (RegPowerOn), with
	// why: an alarm, the serial line, or the user
	PowerOnRegistry: {
		_proto: {
			// remembers when an alarm or the serial port woke the machine (so it can go
			// back to sleep sooner); a user's wake checks daylight saving time
			|WakeUp&GoToSleep|: func(a1) begin
				GetRoot().wokeFromAlarmOrGPI := (if ((a1 = 'alarm) or (a1 = 'serialgpi)) then Ticks());
				(if (a1 = 'user) then DSTVerify(Time()))
			end,
			// the machine restarted because its factory calibration was lost: tells the
			// user (the error's own message)
			FactoryCalibration: func(a1) begin
				(if (Gestalt(16777220).rebootreason = kError_Reboot_Calibration_Missing) then GetRoot():Notify(3, kError_Reboot_Calibration_Missing, nil))
			end
		}
	},
	// _viewdefs: the view definitions (RegisterViewDef) by data class; the
	// built-in ones in the proto
	_viewdefs: {
		_proto: {
			// a recorded note's editor: the sound recorder over the note's text
			|SoundPaper:NSG|: {
				default: {
					viewClass: clView,
					viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
					viewFlags: vVisible,
					viewFormat: vfFillWhite,
					viewJustify: vjParentFullH + vjParentFullV,
					name: "Recording Info",
					symbol: 'default,
					type: 'editor,
					viewDefHeight: 50,
					protection: 'private,
					version: 1,
					// the smallest bounds holding all the note's paragraphs
					MinimalBounds: func(target) begin
						frame2 := {left: 0, top: 0, right: 0, bottom: 0};
						if target.data then begin
								local frame2;
								(foreach item in target.data do begin
										frame2 := UnionRect(frame2, item.viewBounds)
									end)
							end;
						frame2
					end,
					debug: "soundDefaultViewDef",
					viewChildren: [viewChildren:
						{
							// the recorder view (newtSoundView): it keeps the note's sounds and their
							// playing time, in the entry at path
							_proto: {
								viewClass: clView,
								viewFlags: vVisible + vClickable,
								viewJustify: vjSiblingFullH + vjSiblingBottomV,
								viewBounds: {left: 0, top: 8, right: 0, bottom: 50},
								sounds: nil,
								HasSounds: func() begin
									return (if (if sounds then IsArray(sounds)) then (Length(sounds) > 0))
								end,
								// elapsedTime (seconds) as "mm:ss".
								// looks like a ROM bug: the seconds are rounded but the minutes are not, so
								// 59.5 to 59.99 seconds shows as 00:00 rather than 01:00 (text and text2 are
								// made and not used)
								GetTimeString: func(elapsedTime) begin
									local floor2, floor3, text, text2;
									floor2 := floor((elapsedTime + 0.5));
									floor3 := floor((elapsedTime / 60));
									floor2 := (floor2 mod 60);
									text := Stringer([Array: (if (floor3 < 10) then "0"), floor3]);
									text2 := Stringer([Array: (if (floor2 < 10) then "0"), floor2]);
									return Stringer([Array: (if (floor3 < 10) then "0"), floor3, ":", (if (floor2 < 10) then "0"), floor2])
								end,
								// the recording is done: keeps the sounds and shows (and stores) their total
								// playing time
								RecordCompletion: func(sounds) begin
									self.sounds := sounds;
									if self:HasSounds() then begin
											l1 := 0;
											if sounds then begin
													local l1;
													(foreach item in sounds do begin
															l1 := (l1 + item:GetPlayingTime())
														end)
												end;
											target.|SoundPaper:NSG|.soundData.description := self:GetTimeString(l1);
											SetValue(soundDescription, 'text, target.|SoundPaper:NSG|.soundData.description)
										end else begin
											RemoveSlot(soundDescription, 'text)
										end;
									SetValue(self, 'sounds, sounds);
									RefreshViews()
								end,
								path: nil,
								jamSlot: nil,
								defaultValue: nil,
								inRetarget: nil,
								viewQuitScript: func() begin
									if recorder.RecordEngine then begin
											recorder.RecordEngine:StopNow()
										end;
									inherited:?viewQuitScript()
								end,
								viewSetupDoneScript: func() begin
									local targetData;
									targetData := self:TargetData();
									self:Retarget()
								end,
								TargetData: func() begin
									(if (if target then path) then target.(path) else defaultValue)
								end,
								// shows the target entry's sounds (each made a protoSoundFrame) and playing
								// time
								Retarget: func() begin
									inRetarget := true;
									if (l2 := (targetData := self:TargetData()).sounds) then begin
											local targetData;
											local l2;
											(foreach item in l2 do begin
													if (not HasPath(item, '_proto)) then begin
															item._proto := @protoSoundFrame
														end
												end)
										end;
									SetValue(self, 'sounds, l2);
									SetValue(recorder, 'sounds, l2);
									SetValue(soundDescription, 'text, targetData.description);
									(inRetarget := nil)
								end,
								jamFromEntry: func(resolveEntryAlias) begin
									(if jamSlot then begin
											target.(path) := nil;
											(if resolveEntryAlias then (target.(path) := resolveEntryAlias.(jamSlot)))
										end)
								end,
								// the user recorded or changed the sounds: they go into the entry
								viewChangedScript: func(slot, view) begin
									(if (if (not inRetarget) then (slot = 'sounds)) then begin
											target.(path) := {description: soundDescription.text, sounds: self.sounds};
											self:StartFlush()
										end)
								end,
								debug: "newtSoundView",
								viewChildren: [viewChildren: recorder, soundDescription, recorderStatus],
								recorder: nil,
								allocateContext: [|Array|:
									'recorder,
									recorder,
									'soundDescription,
									soundDescription,
									'recorderStatus,
									recorderStatus
								],
								soundDescription: nil,
								recorderStatus: nil
							},
							viewJustify: vjParentFullH + vjSiblingBottomV,
							viewBounds: {left: 8, top: 0, right: -8, bottom: 50},
							path: [pathExpr: '|SoundPaper:NSG|, 'soundData],
							debug: "sound"
						},
						{
							viewBounds: {left: 0, top: 50, right: 0, bottom: 0},
							viewJustify: vjParentFullH + vjParentFullV,
							path: 'data,
							debug: "soundNotes",
							_proto: @newtEditView
						}
					]
				},
				soundFrameFormat: {
					symbol: 'soundFrameFormat,
					title: "Sound Frame Format",
					storeAlias: true,
					_proto: @protoFrameFormat
				},
				prPlainFormat: @prPlainFormat,
				prLetterFormat: @prLetterFormat,
				prMemoFormat: @prMemoFormat
			},
			// the viewer and formats of a plain string (an In/Out Box text item)
			|string|: {
				default: {
					symbol: '|string|,
					name: string_3,
					type: 'viewer,
