						notifyTitle: letterShapes,
						declareSelf: 'LetterShapesPreferencesForm,
						nogo: true,
						viewQuitScript: func() begin
							saveLetterWeights()
						end,
						stepChildren: [stepChildren:
							letterShapes_2,
							letterShapeLabel,
							enableCluster,
							A2Z_2,
							Zero2Nine,
							{
								viewJustify: vjCenterH + vjCenterV + vjParentCenterH + vjSiblingBottomV + oneLineOnly,
								viewBounds: {left: 0, top: 5, right: 112, bottom: 18},
								text: "Use Default Settings",
								confirmTitle: letterShapes,
								revertToDefaults: func() begin
									ResetLetterDefaults();
									letterShapes:Dirty();
									enableCluster:getNewSetting()
								end,
								// asks first: the defaults throw away what the recogniser has learned
								buttonClickScript: func() begin
									AsyncConfirm("Warning: This option erases what Newton has learned about your handwriting. Are you sure you want to do this?", 'yesNoDefaultNo, func(a1) begin
										(if a1 then self:revertToDefaults())
									end)
								end,
								_proto: @protoTextButton
							},
							{
								viewFlags: vVisible + vClickable,
								viewBounds: {left: 32, top: 0, right: 42, bottom: 12},
								viewJustify: vjSiblingCenterV,
								viewFormat: vfNone,
								icon: nil,
								newt_feature: true,
								viewSetupFormScript: func() begin
									(icon := @leftBitmap)
								end,
								// the left arrow: the previous letter (from A back to 9, from 0 back to Z)
								buttonPressedScript: func() begin
									if (A2Z.curIndex > 0) then begin
											A2Z.curIndex := (A2Z.curIndex - 1)
										end else begin
											if (A2Z.curIndex = 0) then begin
													A2Z.curIndex := -1;
													Zero2Nine.curIndex := (Zero2Nine.numIndices - 1)
												end else begin
													if (Zero2Nine.curIndex > 0) then begin
															Zero2Nine.curIndex := (Zero2Nine.curIndex - 1)
														end else begin
															if (Zero2Nine.curIndex = 0) then begin
																	Zero2Nine.curIndex := -1;
																	A2Z.curIndex := (A2Z.numIndices - 1)
																end
														end
												end
										end;
									if (A2Z.curIndex >= 0) then begin
											A2Z:IndexClickScript(A2Z.curIndex)
										end else begin
											Zero2Nine:IndexClickScript(Zero2Nine.curIndex)
										end;
									A2Z:Dirty();
									Zero2Nine:Dirty();
									true
								end,
								_proto: @protoPictureButton
							},
							{
								viewFlags: vVisible + vClickable,
								viewBounds: {left: -44, top: 0, right: -34, bottom: 12},
								viewJustify: vjParentRightH + vjSiblingCenterV,
								viewFormat: vfNone,
								icon: nil,
								newt_feature: true,
								viewSetupFormScript: func() begin
									(icon := @rightBitmap)
								end,
								// the right arrow: the next letter (from Z on to 0, from 9 on to A)
								buttonPressedScript: func() begin
									if (A2Z.curIndex >= 0) then begin
											A2Z.curIndex := (A2Z.curIndex + 1);
											if (A2Z.curIndex >= A2Z.numIndices) then begin
													A2Z.curIndex := -1;
													Zero2Nine.curIndex := 0
												end
										end else begin
											Zero2Nine.curIndex := (Zero2Nine.curIndex + 1);
											if (Zero2Nine.curIndex >= Zero2Nine.numIndices) then begin
													Zero2Nine.curIndex := -1;
													A2Z.curIndex := 0
												end
										end;
									if (A2Z.curIndex >= 0) then begin
											A2Z:IndexClickScript(A2Z.curIndex)
										end else begin
											Zero2Nine:IndexClickScript(Zero2Nine.curIndex)
										end;
									A2Z:Dirty();
									Zero2Nine:Dirty();
									true
								end,
								_proto: @protoPictureButton
							},
							{viewBounds: {left: -18, top: -17, right: -5, bottom: -4}, _proto: @protoCancelButton}
						],
