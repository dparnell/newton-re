// globalHeapvarwannabes: the global variables the system starts with whose
// values are changed while it runs - the registries (Reg... functions add to
// them), the data definitions, the preferences panels, the view definitions
// and the rest.  At boot bootInitNsGlobals sets each slot here as a global (in
// vars) with a clone of its value, so the ROM's copy stays as it is; many are
// a frame whose _proto holds the ROM's built-in entries, so what is registered
// later goes in the clone and the built-in ones are found through the proto.
// The objects after the frame are what only it reaches.

globalHeapvarwannabes := {
	// SoupBackupRegistry: what to do when a soup is backed up, by soup; the
	// Extras Drawer saves the state of its built-in icons
	SoupBackupRegistry: {
		_proto: {
			BuiltInExtrasState: func(a1) begin
				GetRoot().ExtrasDrawer:SaveBuiltInExtrasState(a1)
			end
		}
	},
	// the power-off handlers registered through the 1.x interface
	OldPowerOffHandlers: [|Array|: ],
	// CoverPageRegistry: the fax cover pages there are, by symbol (RegCoverPage).
	// The standard one: a "Fax Delivery" banner, To, From (the owner's name,
	// company and fax and voice numbers), the page count and date, and the
	// comments when there are some.
	CoverPageRegistry: {
		_proto: {
			standard: {
				name: "Standard",
				hasNotes: true,
				form: {
					viewClass: clView,
					viewFlags: vVisible + vReadOnly,
					viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
					viewJustify: vjParentFullH + vjParentFullV,
					viewChildren: [|Array|:
						{
							_proto: @banner,
							viewBounds: {left: 20, top: 40, right: -20, bottom: 100},
							viewJustify: vjParentFullH,
							text: "Fax Delivery"
						},
						{
							viewClass: clPictureView,
							viewBounds: {left: 0, top: -27, right: 95, bottom: -2},
							viewJustify: vjParentCenterH + vjParentBottomV,
							viewFlags: vVisible,
							icon: fineprintIcon,
							// the fine print picture, scaled to half its size
							viewSetupFormScript: func() begin
								local bounds, copy, l3;
								l3 := ((copy := Clone((bounds := icon.bounds))).right div 4);
								copy.right := (copy.right - l3);
								copy.left := (copy.left + l3);
								copy.bottom := (copy.bottom div 2);
								ScaleShape((icon := MakeShape(icon)), bounds, copy)
							end
						},
						{
							_proto: formProtoProto,
							viewBounds: {left: 20, top: 140, right: 115, bottom: 160},
							text: to_2
						},
						{
							_proto: formProto,
							viewBounds: {left: 130, top: 140, right: 470, bottom: 220},
							viewSetupFormScript: func() begin
								// the recipient: name and number, the number up to the ",,," that starts any
								// dialing suffix
								(self.text := Stringer([Array: fields.name, $\n, Substr(fields.displayNumber, 0, StrPos(fields.displayNumber, ",,,", 0))]))
							end
						},
						{
							_proto: formProtoProto,
							viewBounds: {left: 20, top: 220, right: 115, bottom: 240},
							text: "From"
						},
						{
							_proto: formProto,
							viewBounds: {left: 130, top: 220, right: 470, bottom: 300},
							// the sender: name and company, then the owner card's work fax and phone
							// numbers, or failing those the home fax and phone numbers
							viewSetupFormScript: func() begin
								local currentPersona, faxPhone;
								self.text := Stringer([Array: fromFrame.name, $\n, fromFrame.company, $\n]);
								if IsEntryAlias((currentPersona := GetUserConfig('currentPersona))) then begin
										currentPersona := ResolveEntryAlias(currentPersona)
									end;
								if (not currentPersona) then begin
										return nil
									end;
								if (if (faxPhone := GetRoot().cardfile:bcPhoneNumber(currentPersona, 'faxPhone)) then StrFilled(faxPhone[0])) then begin
										self.text := Stringer([Array: self.text, MakeDisplayPhone(faxPhone[0]), " fax\n"]);
										if (if (faxPhone := GetRoot().cardfile:bcPhoneNumber(currentPersona, 'workPhone)) then StrFilled(faxPhone[0])) then begin
												self.text := Stringer([Array: self.text, MakeDisplayPhone(faxPhone[0]), " voice"])
											end;
										return nil
									end;
								(if (if (faxPhone := GetRoot().cardfile:bcPhoneNumber(currentPersona, 'homefaxPhone)) then StrFilled(faxPhone[0])) then begin
										self.text := Stringer([Array: self.text, MakeDisplayPhone(faxPhone[0]), " fax\n"]);
										(if (if (faxPhone := GetRoot().cardfile:bcPhoneNumber(currentPersona, 'homePhone)) then StrFilled(faxPhone[0])) then (self.text := Stringer([Array: self.text, MakeDisplayPhone(faxPhone[0]), " voice"])))
									end)
							end
						},
						{_proto: formProtoProto, viewBounds: {left: 20, top: 300, right: 115, bottom: 320}, text: fax},
						{
							_proto: formProto,
							viewBounds: {left: 130, top: 300, right: 470, bottom: 340},
							viewFormat: vfNone,
							viewSetupFormScript: func() begin
								(self.text := Stringer([Array: fields.pageCount, " ", "pages (including cover)", "\n", DateNTime(Time())]))
							end
						},
						{
							_proto: formProtoProto,
							viewBounds: {left: 20, top: 380, right: 115, bottom: 420},
							text: uCardPositionAlertButton,
							viewSetupFormScript: func() begin
								(if fields.comments then (self.text := "Comments"))
							end
						},
						{
							viewClass: clEditView,
							viewFlags: vVisible + vClipping,
							viewFormat: vfLinesWhite,
							viewBounds: {left: 130, top: 370, right: 330, bottom: 570},
							viewJustify: 0,
							viewLineSpacing: 28,
							viewSetupFormScript: func() begin
								if (if fields.comments then (Length(fields.comments) > 0)) then begin
										// a gray frame round the comments when there are some
										viewFormat := (viewFormat + vfFrameGray)
									end;
								inherited:?viewSetupFormScript()
							end,
							viewSetupChildrenScript: func() begin
								(if (if fields.comments then (Length(fields.comments) > 0)) then (self.viewChildren := fields.comments))
							end
						}
					]
				}
			}
		}
	},
	// SoundRegistry: the system sounds by name (the proto: the ROM's, soundOff)
	SoundRegistry: {_proto: @soundOff},
	// navigator: the navigator (dialing helper) used for each kind of call
	navigator: {
		_proto: {modemNavigator: modemNavigator, voiceNavigator: modemNavigator, faxNavigator: modemNavigator}
	},
	// PagerTypes: the kinds of pager phone numbers and their names
	PagerTypes: {
		_proto: {
			pagerClasses: [|Array|:
				'|string.pager|,
				'|string.pager.skytel|,
				'|string.pager.mobilecomm|,
				'|string.pager.embarc|
			],
			pagerText: {
				|string.pager|: pager,
				|string.pager.skytel|: "SkyTel",
				|string.pager.mobilecomm|: "MobileComm",
				|string.pager.embarc|: "EMBARC"
			}
		}
	},
	// CommConfigChangeRegistry: functions told when the comms configuration changes
	CommConfigChangeRegistry: {},
	// AvailablePrinters: the printer drivers there are (the ROM's in the proto)
	AvailablePrinters: @romAvailablePrinters,
	// international: the locale bundles and keyboards (the ROM's in the proto)
	international: {_proto: @romInternational},
	// Routing: the routing formats registered by applications
	Routing: {_proto: {}},
	// DialinNetworkRegistry: the dial-in networks (packet networks such as
	// SprintNet) whose access numbers the comms setup can look up
	DialinNetworkRegistry: {_proto: {sprint: sprint, concert: {_proto: sprint, title: "ConcertNet", id: 'concert}}},
	// _dataDefs: the data definitions (RegDataDef) by symbol: the stationery for
	// recorded notes, strings and In/Out items, and the nameRef kinds the name
	// pickers work with (people, phone, fax, e-mail, meeting place)
	_dataDefs: {
		_proto: {
			// a recorded note (Notepad stationery from a sound recorder): its text is the
			// playing time or the note's own text
			|SoundPaper:NSG|: {
				symbol: '|SoundPaper:NSG|,
				name: recording,
				description: "Recorded Note",
				icon: {
					mask: bitmap('mask, "resources/mask/4290a1.png", "00000000000401ab01ab00d901ba00e8", 1),
					bits: bitmap('bits, "resources/bits/4290f9.png", "00000000000401ab01ab00d901ba00e8", 1),
					bounds: {left: 0, top: 0, right: 15, bottom: 15}
				},
				superSymbol: 'notes,
				version: 1,
				height: 70,
				// the overview's line for a recorded note: its title and either its text or
				// its playing time
				StringExtract: func(entry, nLines) begin
					local l1, extractData2, text;
					l1 := (if StrEqual((l1 := entry.|SoundPaper:NSG|.soundData.description), "00:00") then "No recording" else Stringer([Array: "Playing time:", " ", l1]));
					if entry.data then begin
							extractData2 := ExtractData(entry.data, "...", 50)
						end;
					if entry.title then begin
							text := Stringer([Array: entry.title, " -- "])
						end;
					(text := (if extractData2 then Stringer([Array: text, extractData2]) else Stringer([Array: text, l1])))
				end,
				TextScript: func(entry, target) begin
					notesText(target.data)
				end,
				// a new recorded note entry: no sound yet, a playing time of 00:00
				FillNewEntry: func(a1) begin
					local frame2;
					frame2 := {soundData: {sounds: nil, description: "00:00"}};
					a1.|SoundPaper:NSG| := frame2;
					a1.class := '|SoundPaper:NSG|;
					a1.viewStationery := 'paperroll;
					a1.height := self.height;
					a1
				end,
				MakeNewEntry: func() begin
					self:FillNewEntry({data: nil})
				end,
				debug: "soundDataDef",
				_proto: @newtStationery
			},
			|nameRef.people|: {_proto: @protoPeopleDataDef, class: '|nameRef.people|},
			|nameRef.phone|: phones,
			// nameRef.fax: names with fax numbers, for the fax routing slip; groups count
			// when they are fax groups
			|nameRef.fax|: {
				_proto: phones,
				class: '|nameRef.fax|,
				name: "Faxes",
				preferredRouting: [|Array|: 'faxPhone, 'homefaxPhone, 'phone],
				superSymbol: 'groupTransport,
				singleSelect: nil,
				querySpec: {
					type: 'index,
					indexPath: 'sorton,
					validTest: func(a1) begin
						local cls;
						((((IsSubclass((cls := ClassOf(a1)), 'person) or IsSubclass(cls, 'company)) or IsSubclass(cls, 'owner)) or (if IsSubclass(cls, 'group) then IsInstance(a1.members, '|nameRef.fax|))) or (cls = 'frame))
					end
				}
			},
			// nameRef.email: names with e-mail addresses, for the mail routing slip
			|nameRef.email|: {
				_proto: @protoPeopleDataDef,
				class: '|nameRef.email|,
				name: "E-Mail addresses",
				preferredRouting: [|Array|: '|string.email|],
				routePath: 'email,
				superSymbol: 'groupTransport,
				columns: [|Array|:
					{fieldPath: 'name, optional: true, tapWidth: 130, noPopup: true},
					{fieldPath: 'email, tapWidth: 0}
				],
				querySpec: {
					type: 'index,
					indexPath: 'sorton,
					validTest: func(a1) begin
						local cls;
						((((IsSubclass((cls := ClassOf(a1)), 'person) or IsSubclass(cls, 'company)) or IsSubclass(cls, 'owner)) or (if IsSubclass(cls, 'group) then IsInstance(a1.members, '|nameRef.email|))) or (cls = 'frame))
					end
				},
				// a name reference with its e-mail address: a group's members, else the
				// address in frame2, else the person's first e-mail address of the preferred
				// kinds
				MakeNameRef: func(frame2, cls) begin
					local l1, entryFromObj2, bcEMailAddress, bcEMailAddres;
					l1 := inherited:MakeNameRef(frame2, cls);
					entryFromObj2 := EntryFromObj(frame2);
					l1.email := (if IsInstance(entryFromObj2, 'group) then entryFromObj2.members else (if (if IsFrame(frame2) then frame2.email) then frame2.email else (if entryFromObj2 then (if (if (bcEMailAddress := GetRoot().cardfile:bcEMailAddress(entryFromObj2, preferredRouting)) then (Length(bcEMailAddress) > 0)) then begin
										SortByClass(bcEMailAddress, preferredRouting, 'email);
										(if IsFrame((bcEMailAddres := bcEMailAddress[0])) then bcEMailAddres.email else bcEMailAddres)
									end))));
					l1
				end,
				// the kind of e-mail system the address is for, in brackets, after the name
				GetSuffix: func(a1) begin
					local email, cls;
					if (email := self:Get(a1, 'email, nil)) then begin
							cls := ClassOf(email);
							if StrFilled((cls := EmailSystems.emailText.(cls))) then begin
									return ParamStr("(^0)", [Array: cls])
								end
						end;
					return nil
				end,
				Get: compile(
					constants: {
						kLiteral_450465: SetClass(Clone("--"), '|string.noData|)
					},
					// Get(nameRef, path, format): the e-mail path reads the entry's address when
					// the reference has none ("--" as text when there is none at all)
					func(a1, a2, a3) begin
						local email, entryFromObj2;
						email := inherited:Get(a1, a2, a3);
						if (a2 = 'email) then begin
								if (if (not (ObjEntryClass(a1) = 'group)) then a1.email) then begin
										email := a1.email
									end;
								if ((not email) or IsInstance(email, '|string.noData|)) then begin
										email := (if (if (email := (if (entryFromObj2 := EntryFromObj(a1)) then GetRoot().cardfile:bcEMailAddress(entryFromObj2, preferredRouting))) then (Length(email) > 0)) then begin
												SortByClass(email, preferredRouting, 'email);
												email[0].email
											end else (if (a3 = 'text) then kLiteral_450465))
									end
							end;
						email
					end),
				GetItemRoutingFrame: func(item) begin
					{name: self:Get(item, 'name, 'text), email: self:Get(item, 'email, nil)}
				end,
				// the title of the slip for editing the address or name
				DefaultOpenEditor: func(a1, trackScrollingItem, a3) begin
					local nameRef, text;
					if (if (text := self:Get((nameRef := a1.nameRef), primaryPath, 'text)) then (not IsInstance(text, '|string.noData|))) then begin
							editTitle := ParamStr("New E-Mail address for ^0", [Array: text])
						end else begin
							if (a1.fieldPath = 'name) then begin
									editTitle := "Add Name"
								end else begin
									if (a1.fieldPath = 'email) then begin
											editTitle := "Add E-Mail address"
										end else begin
											editTitle := defaultEditTitle
										end
								end
						end;
					inherited:DefaultOpenEditor(a1, trackScrollingItem, a3)
				end,
				// the picker of the person's e-mail addresses, with New Address at the end;
				// nil for any other field
				MakePopup: func(a1, fieldPath) begin
					if (fieldPath <> 'email) then begin
							return nil
						end;
					if (if (bcEMailAddress := GetRoot().cardfile:bcEMailAddress(EntryFromObj(a1), preferredRouting)) then ((count := Length(bcEMailAddress)) > 0)) then begin
							SortByClass(bcEMailAddress, preferredRouting, 'email);
							list := Array((count + 2), nil);
							local list;
							local count;
							local bcEMailAddress;
							(for i := 0 to (count - 1) do begin
									local email, text;
									email := bcEMailAddress[i].email;
									text := ParamStr("^0 (^1)", [Array: email, EmailSystems.emailText.(ClassOf(email))]);
									list[i] := {value: email, item: text, pickable: true}
								end);
							list[count] := 'pickseparator;
							list[(count + 1)] := {item: "New Address", value: 'OpenEditor, pickable: true}
						end;
					list
				end,
				// puts edited e-mail addresses back into the person's Names card
				ModifyEntry: func(nameRef, equivalent) begin
					(if (entryFromObj2 := EntryFromObj(nameRef)) then begin
							local entryFromObj2;
							(foreach item in equivalent do begin
									if (item = 'email) then begin
											GetRoot().cardfile:AddCardData(entryFromObj2, 'email, {email: nameRef.email})
										end else begin
											self:ModifyEntryPath(nameRef, entryFromObj2, item)
										end
								end);
							EntryChangeXmit(entryFromObj2, 'entryChanged)
						end)
				end,
				// adds a new Names card for the reference, with its e-mail address
				NewEntry: func(a1, _context) begin
					local cardfile, email, addcard;
					cardfile := GetRoot().cardfile;
					email := a1.email;
					RemoveSlot(a1, 'email);
					cardfile:AddCardData((addcard := cardfile:addcard((addcard := self:PrepareToAdd(a1)).class, addcard)), 'email, {email: email});
					EntryChangeXmit(addcard, 'entryAdded);
					self:FixupPostAdd(a1, addcard);
					a1.email := email;
					addcard
				end
			},
			// nameRef.meetingPlace: companies and worksites, for a meeting's location
			|nameRef.meetingPlace|: {
				_proto: @protoPeopleDataDef,
				class: '|nameRef.meetingPlace|,
				name: "Meeting Place",
				defaultEditTitle: "New Meeting Place",
				singleSelect: true,
				entryType: 'company,
				columns: [|Array|: {fieldPath: 'company, tapWidth: 0}],
				primaryPath: 'company,
				querySpec: {
					type: 'index,
					indexPath: 'sorton,
					validTest: func(a1) begin
						local cls;
						(if ((IsSubclass((cls := ClassOf(a1)), 'company) or IsSubclass(cls, 'worksite)) or (if IsFrame(a1) then IsInstance(a1.sorton, 'company))) then (not IsSubclass(cls, 'group)))
					end
				}
			},
			// plain strings in the In/Out Box
			|string|: {
				symbol: '|string|,
				superSymbol: 'iobox,
				name: string_3,
				version: 1,
				metadata: nil,
				MakeNewEntry: func() begin
					""
				end,
				StringExtract: func(entry, nLines) begin
					Substr(entry, 0, 30)
				end,
				_proto: @newtStationery
			},
			// an In/Out Box item
			ioItem: {
				symbol: 'ioItem,
				superSymbol: 'iobox,
				name: uCardPositionAlertButton,
				description: uCardPositionAlertButton,
				icon: @routeFaxBitmap,
				version: 1,
				metadata: nil,
				MakeNewEntry: func() begin
					GetRoot().iobox:GetDefaultItem()
				end,
				SetupForm: func(entry, a2) begin
					nil
				end,
				StringExtract: func(entry, nLines) begin
					(if entry.title then entry.title else (if entry.appSymbol then Stringer([Array: "Item from:", " ", entry.appSymbol])))
				end,
				_proto: @newtStationery
			},
			paperroll: paperroll,
			calllog: calllog,
			// a mail message's text
			mailText: {
				symbol: 'mailText,
				name: mail_2,
				superSymbol: 'mail,
				description: mail_2,
				icon: nil,
				version: 1,
				metadata: nil,
				SetupForm: func(entry, a2) begin
					nil
				end,
				StringExtract: func(entry, nLines) begin
					(if entry.title then entry.title else (if entry.text then (if (StrLen(entry.text) > 50) then Substr(entry.text, 0, 50) else entry.text) else "Untitled Mail"))
				end,
				TextScript: func(entry, target) begin
					(if target.text then target.text else (if IsFrame(target.body) then target.body.text else ""))
				end
			},
			smartMail: smartMail
		}
	},
	// psFonts: the PostScript fonts that stand in for the Newton's when printing
	psFonts: {_proto: {helvetica: @helveticaFont, timesroman: @timesRomanFont, symbol: @systemSymbolFont}},
	// AutoDockRegistry: functions told about Auto Dock requests (autodockTemplate.ns)
	AutoDockRegistry: {},
	// WeirdCardEventRegistry: functions told when a card that is not storage is
	// inserted or removed (cardEventhandlers.ns)
	WeirdCardEventRegistry: {},
	// CommConfigRegistry: the telephony configurations (TAPI) there are: dialing
	// through the speaker, or through a modem
	CommConfigRegistry: {
		_proto: {
			speaker: {
				type: tAPI,
				name: "Speaker",
				serviceId: nil,
				config: {supportsMakeOutgoing: true, supportsSendDigit: true, outgoingNeededDelay: 3}
			},
			modem: {
				type: tAPI,
				name: modem,
				serviceId: mods,
				config: {
					supportsMakeOutgoing: true,
					supportsSendDigit: true,
					supportsAnswerIncoming: true,
					supportsHangUp: true,
					supportsSpeaker: true,
					supportsEventIncoming: true,
					configOptions: func() begin
						[Array: MakeModemOption()]
					end
				}
			}
		}
	},
	// SetTimeRegistry: functions told when the clock is set (SetTimeInSeconds);
	// the Date Book reschedules its next alarm
	SetTimeRegistry: {
		_proto: {
			calendar: compile(
				constants: {
					kFunction_4f402d: func() begin
						AddProcrastinatedSend('calendarAlarm, GetRoot().calendar, 'nextCalendarAlarm, '[Array: nil], 0)
					end
				},
				func(a1) begin
					(if (if GetRoot() then HasSlot(GetRoot(), 'calendar)) then call (kFunction_4f402d) with ())
				end)
		}
	},
	// AppClassesRegistry: the classes of data each application owns
	AppClassesRegistry: {
		_proto: {
			paperroll: [|Array|: 'paperroll, 'list, 'checkList, 'text],
			calendar: [|Array|: 'meeting],
			ExtrasDrawer: [|Array|: 'packageFrame]
		}
	},
	// CreditCardTypes: the kinds of calling and credit card numbers the Names file
	// knows, their names and the access numbers that dial them
	CreditCardTypes: {
		_proto: {
			creditCardClasses: [|Array|:
				'|string.card|,
				'|string.card.phonecard|,
				'|string.card.creditcard|,
				'|string.card.phonecard.att|,
				'|string.card.phonecard.mci|,
				'|string.card.phonecard.sprint|,
				'|string.card.creditcard.visa|,
				'|string.card.creditcard.mastercard|,
				'|string.card.creditcard.amex|,
				'|string.card.creditcard.discover|
			],
			creditCardText: {
				|string.card|: @freshCardName,
				|string.card.phonecard|: "Phone Card",
				|string.card.creditcard|: creditCard,
				|string.card.phonecard.att|: aTT,
				|string.card.phonecard.mci|: mCI,
				|string.card.phonecard.sprint|: sprint_2,
				|string.card.creditcard.visa|: "Visa",
				|string.card.creditcard.mastercard|: masterCard,
				|string.card.creditcard.amex|: "AmEx",
				|string.card.creditcard.discover|: discover
			},
			creditCardPhoneNums: {
				|string.card.phonecard.att|: "(800)225-5288x",
				|string.card.phonecard.mci|: "(800)888-8000x",
				|string.card.phonecard.sprint|: "(800)877-8000x",
				|string.card.creditcard.visa|: "(800)336-8472x",
				|string.card.creditcard.mastercard|: "(800)826-2181x",
				|string.card.creditcard.amex|: "(800)227-2639x",
				|string.card.creditcard.discover|: "(800)347-2683x"
			}
		}
	},
	// Notifications: the notification log, starting with the welcome message
	Notifications: [|Array|:
		{
			_proto: @messageNotification,
			timestamp: 45124864,
			overview: newton,
			nfText: "Welcome to Newton™",
			nfType: 1,
			seenByUser: true
		}
	],
	// OpenCardViews: the card alerts that are open (cardAlertTemplate.ns)
	OpenCardViews: [|Array|: ],
	// StoreChangeRegistry: functions told when a store comes or goes
	// (RegStoreChange); the Date Book sets its alarms up again
	StoreChangeRegistry: {
		_proto: {
			calendar: func(a1, a2, a3) begin
				(if ((a2 = 'StoreEnters) or (a2 = 'storeLeaves)) then (if (not Visible(GetRoot().calendar)) then GetRoot().calendar:initializeAlarms()))
			end
		}
	},
