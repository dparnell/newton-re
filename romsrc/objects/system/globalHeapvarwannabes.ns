					(if ModalCheckPIN("Enter PIN", GetUserConfig('passwordkey)) then self:Popit((indent - 2)) else self:Notify(3, "PIN Entry", "An incorrect PIN has been entered. Please try again."))
				end, nil)
			end else begin
