						ArrayInsert(list, MakeText(text, 145, a2, pageWidth, (a2 + 1)), 0)
					end;
				if (mtgLocation := self:GetMeetingSlot(exception, 'mtgLocation)) then begin
						a2 := (a2 + LineHt);
						StyledStrTruncate((text := ParamStr("@ ^0", [Array: self:getNameOfLocation(mtgLocation)])), (pageWidth - 145), bodyFont);
						ArrayInsert(list, MakeText(text, 145, a2, pageWidth, (a2 + 1)), 0)
					end;
				if (mtgInvitees := self:GetMeetingSlot(exception, 'mtgInvitees)) then begin
