							(UndoAction := nil)
						end,
						// a country chosen: sets the locale (undoable), takes its default paper size,
						// and if its sort order differs offers to rebuild every soup's string indexes
						// for it and restart
						LabelActionScript: func(index) begin
							local newSortID, currentSortID;
							AddUndoAction('setLabelScript2, [Array: vars.(configPath), userConfiguration.letterSetSelection]);
							vars.(configPath) := items[index].title;
							(if ((setLocale2 := SetLocale(items[index].title)) <> nil) then begin
									ReadCursiveOptions();
									localeChanged := true;
									if (defaultPaperSize := GetLocale().defaultPaperSize) then begin
											local setLocale2;
											local defaultPaperSize;
											(foreach key, value in userConfiguration.paperSizes do begin
													local text;
													if (if (value.id = defaultPaperSize) then (userConfiguration.paperSize <> value)) then begin
															userConfiguration.paperSize := value;
															paper:pickActionScript(key)
														end
												end)
										end;
									newSortID := setLocale2.sortID;
									currentSortID := GetSortID(nil);
									(if (newSortID <> currentSortID) then (if ModalConfirm((text := ParamStr("The selected locale \u201C\u^0\u201D\u uses a different sorting order; you may choose to use it to rearrange your data.  The conversion process may take a few minutes.  Would you like to switch to this sorting order?", [Array: setLocale2.title])), 'yesNo) then begin
												SetSortID(newSortID);
												SetUserConfig('sortID, newSortID);
												DoProgress('vBarber, {primary: nil, statusText: "Changing Sorting Order", barber: true, closeBox: nil}, func(a1) begin
													local soupNames;
													local stores;
													(foreach item in (stores := GetStores()) do begin
															if (not item:IsReadOnly()) then begin
																	(foreach item2 in (soupNames := item:GetSoupNames()) do begin
																			a1:SetStatus('vBarber, {titleText: ParamStr("Building indexes in ^0\u2026\u", [Array: item2]), barber: true});
																			self:RebuildIndexes(item:GetSoup(item2), currentSortID, newSortID, a1)
																		end)
																end else nil
														end)
												end);
												ModalConfirm("Your Newton product needs to be restarted to use the converted indexes.", [Array: "Restart"]);
												AddDeferredCall(functions.ReBoot, nil)
											end))
								end)
						end,
						// rebuilds soup's string indexes whose sort order is not newSortID
						RebuildIndexes: func(soup, currentSortID, newSortID, busybox) begin
							local newIndexSpec, indexSpec;
							(foreach indexSpec in (indexes := soup:GetIndexes()) do begin
									local store;
									if (if (newSortID <> indexSpec.sortID) then (indexSpec.type = 'string)) then begin
											newIndexSpec := Clone(indexSpec);
											if (not newSortID) then begin
													RemoveSlot(newIndexSpec, 'sortID)
												end;
											store := soup:GetStore();
											store:AtomicAction(func() begin
												soup:RemoveIndex(indexSpec.path);
												busybox:SetStatus('vBarber, {barber: true});
												soup:AddIndex(newIndexSpec)
											end)
										end
								end)
						end,
						debug: 16845,
						_proto: @protoPreferencesPopup
					},
