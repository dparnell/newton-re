			(self.viewChildren := [Array: {viewBounds: textBounds2, viewStationery: 'para, text: textOfRoutedMeeting, viewFont: tsHWFont + tsSize(12), recConfig: @rcInkorText}])
		end
	},
	// sending one meeting: the item carries a copy of it (an instance of a
	// repeating meeting made into a meeting of its own)
	singleFrameDef: {
		title: singleMeeting,
		version: 1,
		symbol: 'singleFrameDef,
		// for a repeating meeting the item carries the whole series, its instances'
		// notes resolved into it - or, if that fails, just this occurrence
		SetupSlip: func(a1, a2) begin
			l1 := GetRoot().calendar;
			if (l2 := a1.target).entryAlias then begin
					l3 := ResolveEntryAlias(l2.entryAlias);
					l4 := l2.instanceTime;
					if l3 then begin
							if l3.repeatType then begin
									if (not (l5 := l1:FindException(l4, l3))) then begin
											l5 := l1:MakeInstanceOfRepeatingMeeting(l3, l4)
										end;
									a1.target := l1:ConvertToNonrepeating(l5, true)
								end else begin
									a1.target := l3
								end
						end
				end;
			a2.body := DeepClone(a1.target);
			a2.title := Clone(l1:GetMeetingText(a1.target));
			if (l6 := a2.body.repeatTemplate) then begin
					l1:SetRepeatingMeetingStartDate(l6, a2.body.mtgStartDate, nil);
					if (l7 := l6.InstanceNotesData) then begin
							try begin
									local l1;
									local l2;
									local l3;
									local l4;
									local l5;
									local l6;
									local l7;
									(foreach l8 in l7 do begin
											if (l10 := l8[1]) then begin
													if (l3 := ResolveEntryAlias(l10)) then begin
															l8[1] := l3.notes
														end else begin
															l8[1] := nil
														end
												end
										end)
								end onexception |evt.ex| do begin
									SetLength(l6.InstanceNotesData, 1);
									l6 := (a1.target := l1:ConvertToNonrepeating(a1.target, true));
									GetRoot():Notify(3, "Dates", "Unable to send entire repeating meeting and all its notes.  Just this occurrence will be sent.")
								end
						end;
					a2.body := l6
				end;
			self:PrepareForRouting((l11 := a2.body));
			local l10;
			local l11;
			(if l11.exceptions then (foreach l12 in l11.exceptions do begin
						if l12[1] then begin
								self:PrepareForRouting(l12[1])
							end
					end))
		end,
		TextScript: func(entry, target) begin
			GetRoot().calendar:GetTextOfRoutedMeeting(entry.body)
		end,
		// the invitees' and location's entry aliases do not go with the item
		PrepareForRouting: func(a1) begin
			if a1.mtgInvitees then begin
					(foreach item in a1.mtgInvitees do begin
							item._alias := nil
						end)
				end;
			(if a1.mtgLocation then (a1.mtgLocation._alias := nil))
