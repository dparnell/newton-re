		type: 'viewer,
		symbol: 'default,
		name: date_2,
		// a routed meeting's text, in the handwriting font, as the In Box shows it
		viewSetupChildrenScript: func() begin
			local textOfRoutedMeeting, box, textBounds2;
			textOfRoutedMeeting := GetRoot().calendar:GetTextOfRoutedMeeting(target);
			box := self:LocalBox();
