		type: 'index,
		indexPath: 'sorton,
		validTest: func(a1) begin
			local cls;
			(((IsSubclass((cls := ClassOf(a1)), 'person) or IsSubclass(cls, 'company)) or IsSubclass(cls, 'owner)) or (cls = 'frame))
		end
	},
	// a name reference with its phone number: a group's members, else the number
	// in frame2, else the person's first of the preferred kinds; and the country
	MakeNameRef: func(frame2, cls) begin
		local l1, entryFromObj2, bcPhoneNumber, country;
		l1 := inherited:MakeNameRef(frame2, cls);
		entryFromObj2 := EntryFromObj(frame2);
		l1.phone := (if IsInstance(entryFromObj2, 'group) then entryFromObj2.members else (if (if IsFrame(frame2) then frame2.phone) then frame2.phone else (if entryFromObj2 then (if (if (bcPhoneNumber := GetRoot().cardfile:bcPhoneNumber(entryFromObj2, preferredRouting)) then (Length(bcPhoneNumber) > 0)) then begin
							SortByClass(bcPhoneNumber, preferredRouting, nil);
							bcPhoneNumber[0]
						end))));
		if (if entryFromObj2 then entryFromObj2.country) then begin
				country := entryFromObj2.country
			end else begin
				country := (if IsFrame(frame2) then frame2.country)
			end;
		l1.country := country;
		l1
	end,
	// the kind of the number (or pager), in brackets, after the name
	GetSuffix: func(a1) begin
		local phone, cls;
		if (phone := self:Get(a1, 'phone, nil)) then begin
				if IsSubclass((cls := ClassOf(phone)), '|string.pager|) then begin
						cls := PagerTypes.pagerText.(cls)
					end else begin
						cls := PhoneTypes.phoneText.(cls)
					end;
				if StrFilled(cls) then begin
						return ParamStr("(^0)", [Array: cls])
					end
			end;
		return nil
	end,
	Get: compile(
		constants: {
			kLiteral_450465: SetClass(Clone("--"), '|string.noData|)
		},
		// Get(nameRef, path, format): the phone path reads the entry's number when the
		// reference has none ("--" as text when there is none at all), formatted for
		// display as text
		func(a1, a2, a3) begin
			local l1, entryFromObj2;
			l1 := inherited:Get(a1, a2, a3);
			(if (a2 = 'phone) then begin
					if ((not l1) or IsInstance(l1, '|string.noData|)) then begin
							l1 := (if (if (l1 := (if (entryFromObj2 := EntryFromObj(a1)) then GetRoot().cardfile:bcPhoneNumber(entryFromObj2, preferredRouting))) then (Length(l1) > 0)) then begin
									SortByClass(l1, preferredRouting, nil);
									l1[0]
								end else (if (a3 = 'text) then kLiteral_450465))
						end;
					(if (if (if (a3 = 'text) then l1) then (not IsInstance(l1, '|string.noData|))) then MakeDisplayPhone(l1) else l1)
				end else l1)
		end),
	// what the routing slip needs to dial: the entry, name, country and number
	GetItemRoutingFrame: func(item) begin
		local phone;
		if ((not (phone := self:Get(item, 'phone, nil))) or IsInstance(phone, '|string.noData|)) then begin
				phone := ""
			end;
		{entry: item, name: self:Get(item, primaryPath, 'text), country: item.country, rawNumber: phone, displayNumber: MakeDisplayPhone(phone), phoneNumber: (if item.asIsPhone then item.asIsPhone else GetRoot():MungePhone(phone, item.country))}
	end,
	// puts edited phone numbers back into the person's Names card
	ModifyEntry: func(nameRef, equivalent) begin
		(if (entryFromObj2 := EntryFromObj(nameRef)) then begin
				local entryFromObj2;
				(foreach item in equivalent do begin
						if (item = 'phone) then begin
								GetRoot().cardfile:AddCardData(entryFromObj2, 'phone, nameRef.phone)
							end else begin
								self:ModifyEntryPath(nameRef, entryFromObj2, item)
							end
					end);
				EntryChangeXmit(entryFromObj2, 'entryChanged)
			end)
	end,
	// adds a new Names card for the reference, with its phone number
	NewEntry: func(a1, _context) begin
		local cardfile, phone, addcard;
		cardfile := GetRoot().cardfile;
		phone := a1.phone;
		RemoveSlot(a1, 'phone);
		cardfile:AddCardData((addcard := cardfile:addcard((addcard := self:PrepareToAdd(a1)).class, addcard)), 'phone, phone);
		EntryChangeXmit(addcard, 'entryAdded);
		self:FixupPostAdd(a1, addcard);
		a1.phone := phone;
		addcard
	end,
	// the title of the slip for editing the number or name
	DefaultOpenEditor: func(a1, trackScrollingItem, a3) begin
		local nameRef, text, validityCheck2;
		editTitle := defaultEditTitle;
		if (not (a1.fieldPath = 'New)) then begin
				if (not IsInstance((text := self:Get((nameRef := a1.nameRef), primaryPath, 'text)), '|string.noData|)) then begin
						editTitle := ParamStr("New phone for ^0", [Array: text])
					end else begin
						if (Length((validityCheck2 := ValidityCheck(a1.nameRef, validationFrame, '[Array: phone], nil, nil))) < 1) then begin
								editTitle := "Add Name"
							end else begin
								editTitle := "Add Phone"
							end
					end
			end;
		inherited:DefaultOpenEditor(a1, trackScrollingItem, a3)
	end,
	// the picker of the person's phone numbers (and the reference's own), each
	// with its kind's letter, then New Phone; nil for any other field
	MakePopup: func(a1, fieldPath) begin
		if (fieldPath <> 'phone) then begin
				return nil
			end;
		entryFromObj2 := EntryFromObj(a1);
		preferredRouting2 := preferredRouting;
		cardfile := GetRoot().cardfile;
		if (if a1 then IsString(a1.phone)) then begin
				phone := a1.phone
			end;
		if entryFromObj2 then begin
				bcPhoneNumber := cardfile:bcPhoneNumber(entryFromObj2, preferredRouting2)
			end;
		if phone then begin
				if (if bcPhoneNumber then (not LSearch(bcPhoneNumber, phone, 0, '|str=|, nil))) then begin
						AddArraySlot(bcPhoneNumber, phone)
					end else begin
						if (not bcPhoneNumber) then begin
								bcPhoneNumber := [Array: phone]
							end
					end
			end;
		if (if bcPhoneNumber then ((count := Length(bcPhoneNumber)) > 0)) then begin
				SortByClass(bcPhoneNumber, preferredRouting2, nil);
				list := Array((count + 2), nil);
				local count;
				local entryFromObj2;
				local preferredRouting2;
				local cardfile;
				local phone;
				local bcPhoneNumber;
				local list;
				(for i := 0 to (count - 1) do begin
						local bcPhoneNumberItem, l12, text;
						bcPhoneNumberItem := bcPhoneNumber[i];
						l12 := PhoneTypes.phoneLabels.(ClassOf(bcPhoneNumberItem));
						text := ParamStr("^0 ^1", [Array: MakeDisplayPhone(bcPhoneNumberItem), l12]);
						list[i] := {value: bcPhoneNumberItem, item: text, pickable: true}
					end);
				list[count] := 'pickseparator;
				list[(count + 1)] := {item: "New Phone", value: 'OpenEditor, pickable: true}
			end;
		list
	end
};

