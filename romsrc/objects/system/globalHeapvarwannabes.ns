	cardFilePrefs: {
		_proto: {
			mode: 1,
			filter: nil,
			defaultCardType: 0,
			cardSize: 1,
			PhoneTypes: [|Array|:
				[|Array|: phone, $\u0020, 'phone_number],
				[|Array|: home, $H, 'home_phone],
				[|Array|: work, $W, 'work_phone],
				[|Array|: fax, $F, 'fax_phone],
				[|Array|: otherCategoryName, $O, 'other_phone],
				[|Array|: car, $A, 'car_phone],
