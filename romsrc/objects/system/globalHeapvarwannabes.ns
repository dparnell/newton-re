		_proto: @coverPageFormat
	}
};

// the base of the Date Book's print formats: the day view's layout (dpCal),
// the styles, and the Date Book's functions they need to draw meetings
mainFormatProtoProto := {
	dpCal: {
		dayViewHeight: 624,
		schLineSpacing: 13,
		schLeft: 0,
		schTop: 0,
		schWidth: 0,
		schHeight: 0,
