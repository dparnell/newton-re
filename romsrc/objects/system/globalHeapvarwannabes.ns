recording := "Recording";

// the sound recorder of a recorded note (a protoRecorderView); its statusText
// frame shows the recorder's state in recorderStatus
recorder := {
	viewBounds: {left: 0, top: 7, right: 191, bottom: 30},
	viewSetupFormScript: func() begin
		// SetState(oldState, newState, hasSounds): the states as the text shows them -
		// 1 and 32 ready, 2 recording, 4 playing, 8 and 16 paused; going to 64 the
		// recorder is given the note's store to record onto.  From 32 to 1 a
		// recording has just finished: the note takes the sounds
		(self.statusText := {_parent: self, SetState: func(fSoundState, fSoundState2, hasSoundFrames) begin
			local text, parent;
			if (fSoundState2 = 64) then begin
					RecordEngine.fStore := EntryStore(target)
				end else begin
					if (fSoundState = 64) then begin
							text := nil
						end else begin
							if ((fSoundState2 = 1) or (fSoundState2 = 32)) then begin
									if (GetUserConfig('inputDevice) <> nil) then begin
											if hasSoundFrames then begin
													text := "Ready to play or record."
												end else begin
													text := "Ready to record."
												end
										end else begin
											if hasSoundFrames then begin
													text := "Ready to play."
												end else begin
													text := "No recording source set."
												end
										end
								end else begin
									if (fSoundState2 = 4) then begin
											text := "Playing..."
										end else begin
											if (fSoundState2 = 2) then begin
													text := "Recording..."
												end else begin
													if (fSoundState2 = 8) then begin
															text := "Paused..."
														end else begin
															if (fSoundState2 = 16) then begin
																	text := "Paused..."
																end
														end
												end
										end
								end
						end
				end;
			if text then begin
					SetValue(recorderStatus, 'text, text)
				end;
			(if (if (fSoundState = 32) then (fSoundState2 = 1)) then begin
					parent := recorder:Parent();
					parent:RecordCompletion(recorder:GetSounds())
				end)
		end})
	end,
	// while recording, the elapsed time is shown as mm:ss
	viewChangedScript: func(slot, view) begin
		local timeString;
		(if (slot = 'elapsedTime) then begin
				timeString := self:GetTimeString(self.elapsedTime);
				SetValue(soundDescription, 'text, timeString)
			end else (if (slot = 'sounds) then inherited:?viewChangedScript(slot, view)))
	end,
	debug: "soundRecorder",
	preallocatedContext: 'recorder,
	_proto: @protoRecorderView
};

// the note's playing time, "00:00" at first
soundDescription := {
	viewJustify: vjCenterV + vjSiblingRightH + vjSiblingCenterV + oneLineOnly,
	viewBounds: {left: 7, top: 0, right: 297, bottom: 23},
	viewFont: tsSimple + tsSize(14) + tsBold,
	text: soundDescriptionText,
	debug: "soundDescription",
	preallocatedContext: 'soundDescription,
	_proto: @protoStaticText
};

recorderStatus := {
	viewJustify: vjCenterV + vjSiblingBottomV + oneLineOnly,
	viewBounds: {left: 0, top: 5, right: 300, bottom: 20},
	text: readyToRecord,
	debug: "recordStatus",
	preallocatedContext: 'recorderStatus,
	_proto: @protoStaticText
};

recordingSource := "Recording source";

// the recording source picker: none, or what the machine has (the Gestalt
// sound query's input bits: 4 the microphone, 16 line in)
inputSourcePicker := {
	viewJustify: vjCenterV + vjParentFullH + vjSiblingBottomV,
	viewBounds: {left: 10, top: 8, right: 10, bottom: 23},
	text: recordingSource,
	labelCommands: nil,
	viewSetupFormScript: func() begin
		local gestalt2, l2;
		l2 := (if (gestalt2 := Gestalt('[Array: 33554441, [Array: struct, boolean, boolean, boolean, boolean, Real, long, long], 1])) then gestalt2[6] else 0);
		AddArraySlot((labelCommands := [Array: ]), {item: "None", value: nil});
		if (BAnd(l2, 4) <> 0) then begin
				AddArraySlot(labelCommands, {item: "Microphone", value: 4})
			end;
		if (BAnd(l2, 16) <> 0) then begin
				AddArraySlot(labelCommands, {item: "Line-in", value: 16})
			end;
		inherited:?viewSetupFormScript()
	end,
	TextSetup: func() begin
		inputDevice := GetUserConfig('inputDevice);
		local inputDevice;
		local labelCommand;
		labelCommand := (foreach item in labelCommands do begin
				if (item.value = inputDevice) then begin
						break item
					end
			end);
		if (not labelCommand) then begin
				labelCommand := labelCommands[0];
				SetUserConfig('inputDevice, labelCommand.value)
			end;
		return labelCommand.item
	end,
	// line in warns that without an external microphone nothing will be recorded
	LabelActionScript: func(index) begin
		local value;
		value := labelCommands[index].value;
		SetUserConfig('inputDevice, value);
		(if (value = 16) then self:Notify(3, "Recording source", "If you don't have an external microphone connected, you should change this setting back to \u201C\uNone\u201D\u or \u201C\uMicrophone\u201D\u."))
	end,
	preallocatedContext: 'inputSourcePicker,
	_proto: @protoLabelPicker
};

// the recording quality picker: the codecs offered depend on the processor
// (on a StrongARM, GSM at 2K a second as well as IMA)
qualityPicker := {
	viewJustify: vjCenterV + vjParentFullH + vjSiblingBottomV,
	viewBounds: {left: 10, top: 6, right: 10, bottom: 21},
	text: "Recording quality",
	labelCommands: nil,
	viewSetupFormScript: func() begin
		if (Gestalt(16777219).cputype = 'strongarm) then begin
				labelCommands := [Array: {item: "Voice (2K/sec)", symbol: 'GSM8K16Codec}, {item: "Voice (4K/sec)", symbol: 'IMA8K16Codec}, {item: "Music (5K/sec)", symbol: 'IMA10K16Codec}]
			end else begin
				labelCommands := [Array: {item: "Low (4K/sec)", symbol: 'IMA8K16Codec}, {item: "High (5K/sec)", symbol: 'IMA10K16Codec}]
			end;
		inherited:?viewSetupFormScript()
	end,
	// the quality the user chose, else the processor's default; a choice that is
	// not offered falls back to the first
	TextSetup: func() begin
		if (not (recordingQuality := GetUserConfig('recordingQuality))) then begin
				recordingQuality := (if (Gestalt(16777219).cputype = 'strongarm) then 'GSM8K16Codec else 'IMA8K16Codec)
			end;
		local recordingQuality;
		local labelCommand;
		labelCommand := (foreach item in labelCommands do begin
				if (item.symbol = recordingQuality) then begin
						break item
					end
			end);
		if (not labelCommand) then begin
				labelCommand := labelCommands[0];
				SetUserConfig('recordingQuality, labelCommand.symbol)
			end;
		return labelCommand.item
	end,
	LabelActionScript: func(index) begin
		SetUserConfig('recordingQuality, labelCommands[index].symbol)
	end,
	preallocatedContext: 'qualityPicker,
	_proto: @protoLabelPicker
};

