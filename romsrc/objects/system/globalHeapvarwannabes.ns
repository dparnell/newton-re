						StyledStrTruncate((text := ParamStr("with ^0", [Array: self:GetNamesOfInvitees(mtgInvitees, nil)])), (pageWidth - 145), bodyFont);
						ArrayInsert(list, MakeText(text, 145, a2, pageWidth, (a2 + 1)), 0)
					end
			end;
