					end)
			end,
			viewChildren: [viewChildren:
				{
					_proto: mainFormatProto_2,
					viewJustify: vjParentFullH,
					viewBounds: {left: 10, top: 20, right: -10, bottom: 45},
					height: 25,
					labelText: meeting_3,
					GetContent: func() begin
