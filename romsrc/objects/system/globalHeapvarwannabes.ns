					local gestalt2, gestalt3;
					gestalt2 := Gestalt('[Array: 33554441, [Array: struct, boolean, boolean, boolean, boolean, Real, long, long], 1]);
					gestalt3 := Gestalt('[Array: 33554444, [Array: struct, boolean], 1]);
					(not ((if gestalt2 then gestalt2[0]) or (if gestalt3 then gestalt3[0])))
				end,
