				local b := MakeBinary(StrLen(hex) div 2, cls);
				for i := 0 to Length(b) - 1 do begin
					local h := Ord(hex[2 * i]);
					local l := Ord(hex[2 * i + 1]);
					StuffByte(b, i, (if h >= 97 then h - 87 else h - 48) * 16 + (if l >= 97 then l - 87 else l - 48))
				end;
				b
			end,
			kLiteral_3d69c9: {bits: call kBinaryFromHex with ("", 'bits), bounds: '{left: 0, top: 0, right: 203, bottom: 9}}
		},
		// Swedish has three more letters: A ring, A and O diaeresis
		func() begin
