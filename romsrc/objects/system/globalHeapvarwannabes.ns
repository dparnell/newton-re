		crbTop: 16,
		crbWidth: 0,
		crbHeight: 80
	},
	TimeSpec: 170636,
	headerHt: nil,
	MeetingSoup: nil,
	// an event as shapes: its icon, its text, and the first line of its notes
	GetSingleEventShape: func(a1, yOffset, pageWidth) begin
		local list, offsetShape2, l3, meetingText, copy, l6, notesDataItem;
		list := [Array: ];
		offsetShape2 := OffsetShape(MakeShape(GetMeetingIcon(a1)), 20, (yOffset + 1));
		ArrayInsert(list, offsetShape2, 0);
		l3 := (yOffset + LineHt);
		if (if (meetingText := self:GetMeetingText(a1)) then (StrLen(meetingText) > 0)) then begin
				copy := Clone(meetingText);
				l6 := 98;
				StyledStrTruncate(copy, l6, bodyFont);
				ArrayInsert(list, MakeText(copy, 42, l3, pageWidth, (l3 + 1)), 0)
			end;
		if (if (notesDataItem := self:GetNotesData(a1)[1]) then (Length(notesDataItem) > 0)) then begin
				yOffset := (yOffset + LineHt);
				copy := ExtractData(notesDataItem, " ", 100);
				StyledStrTruncate((copy := ParamStr("\u2022\u ^0", [Array: copy])), (pageWidth - 145), bodyFont);
				ArrayInsert(list, MakeText(copy, 145, yOffset, pageWidth, (yOffset + 1)), 0)
			end;
		list
	end,
	FindException: FindException,
	meetingTypeRegistry: nil,
	GetNameOfPerson: GetNameOfPerson,
	ShowCribNotes: nil,
	GetMeetingText: GetMeetingText,
	LineHt: nil,
	RepeatNotes: nil,
	_proto: @protoPrintFormat,
	protoInstanceOfRepeatingMeeting: protoInstanceOfRepeatingMeeting,
	GetMeetingSlot: GetMeetingSlot,
	bodyStyle: {font: tsSimple + tsSize(9), justification: 'left},
	headerStyle: {font: tsSimple + tsSize(12) + tsBold, justification: 'left},
	GetNamesOfInvitees: GetNamesOfInvitees,
	getNameOfLocation: getNameOfLocation,
	RepeatSoup: nil,
	selectedDates: nil,
	// a meeting as shapes: its icon, its times, its text, the first line of its
	// notes, its place (@ ...) and invitees (with ...), each a line of LineHt
	GetSingleMeetingShape: func(exception, a2, pageWidth) begin
		local list, offsetShape2, l3, text, meetingText, notesDataItem, mtgLocation, mtgInvitees;
		list := [Array: ];
		if ((ClassOf(exception) = 'meeting) or exception.mtgText) then begin
				offsetShape2 := OffsetShape(MakeShape(GetMeetingIcon(exception)), 20, (a2 + 1));
				ArrayInsert(list, offsetShape2, 0);
				a2 := (a2 + LineHt);
				l3 := (exception.mtgStartDate + self:GetMeetingSlot(exception, 'mtgDuration));
				text := Stringer([Array: TimeStr(exception.mtgStartDate, TimeSpec), " ", $-, " ", TimeStr(l3, TimeSpec)]);
				ArrayInsert(list, MakeText(text, 42, a2, 145, (a2 + 1)), 0);
				if (if (meetingText := self:GetMeetingText(exception)) then (StrLen(meetingText) > 0)) then begin
						StyledStrTruncate((meetingText := Clone(meetingText)), (pageWidth - 145), bodyFont);
						ArrayInsert(list, MakeText(meetingText, 145, a2, pageWidth, (a2 + 1)), 0)
					end;
				if (if (notesDataItem := self:GetNotesData(exception)[1]) then (Length(notesDataItem) > 0)) then begin
						a2 := (a2 + LineHt);
						text := ExtractData(notesDataItem, " ", 100);
