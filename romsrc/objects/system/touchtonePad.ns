// touchtonePad, and what only it reaches
//
// The 3x4 touch-tone keypad (1-9, *, 0, #): pressing a key plays its DTMF
// tone (touchtonePadProto). The phone pad and the call transport's
// keypad slip (vPhoneKeypad) use it.

touchtonePad := {
	_proto: touchtonePadProto,
	_noRepeat: true,
	viewBounds: {left: 0, top: 0, right: 75, bottom: 100},
	keyDefinitions: [|Array|:
		// four rows of three keys: each row two dimension values, then for each
		// key its legend (here the key's DTMF sound), its result character and its
		// key descriptor
		touchtonePadProtoItem,
		touchtonePadProtoItem_2,
		touchtonePadProtoItem_3,
		touchtonePadProtoItem_4
	]
};
