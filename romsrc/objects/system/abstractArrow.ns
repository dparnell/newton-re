// abstractArrow: the template of one scroll arrow of the system scrollers
// (protoUpDownScroller, protoLeftRightScroller and the 2D ones build theirs
// from it, as children of an abstractScroller).  It draws its state from the
// scroller's Arrows bitmap and, while the pen is down on it, scrolls the
// scroller's scrollView repeatedly through viewScroll2DScript.

abstractArrow := {
	viewClass: clView,
	viewFlags: vVisible + vClickable,
	viewFormat: vfNone,
	lastTap: 0,
	extras: nil,
	// the extras frame sent with each viewScroll2DScript: single or double tap, how
	// many steps so far, the pen unit (SetupExtras adds axis and amount)
	baseFrame: {tap: 'single, count: 0, unit: nil},
	arrowIndex: nil,
	arrowDirection: nil,
	hilite: nil,
	// draws the arrow's bitmap: StateMap.hilite while pressed, else its current
	// state from the scroller's scrollerState (normal or more), offset by arrowIndex
	viewDrawScript: func() begin
		local l1;
		l1 := (if hilite then (StateMap.hilite + arrowIndex) else (scrollerState[arrowIndex] + arrowIndex));
		DrawXBitmap(self:LocalBox(), Arrows, l1, 0)
	end,
	// true when the view cannot scroll any further in arrowDirection ('up, 'down,
	// 'left, 'right) - then plays the scroller's stop sound
	EndOfTheLine: func(arrowDirection) begin
		(if (if ScrollRect then ViewRect) then (if ((((if (arrowDirection = 'up) then (yPos <= ScrollRect.top)) or (if (arrowDirection = 'down) then (yPos >= (ScrollRect.bottom - (ViewRect.bottom - ViewRect.top))))) or (if (arrowDirection = 'left) then (xPos <= ScrollRect.left))) or (if (arrowDirection = 'right) then (xPos >= (ScrollRect.right - (ViewRect.right - ViewRect.left))))) then begin
					self:PlayStopSound();
					Sleep(10);
					true
				end))
	end,
	// the pen on the arrow: highlight it, then scroll a step at a time until the
	// pen lifts or the end is reached, and send viewScrollDoneScript at the end
	viewClickScript: func(unit) begin
		local arrow;
		InkOff(unit);
		arrow := self:GetArrow(arrowDirection);
		hilite := true;
		self:DoDrawing('viewDrawScript, [Array: ]);
		if self:EndOfTheLine(arrowDirection) then begin
				hilite := nil;
				self:DoDrawing('viewDrawScript, [Array: ]);
				return true
			end;
		clicker();
		(extras := Clone(baseFrame)).unit := unit;
		// a tap less than 60 ticks (a second) after the last is a double tap, which
		// SetupExtras turns into its largest scroll amount
		if ((Ticks() - lastTap) < 60) then begin
				extras.tap := 'double
			end;
		lastTap := Ticks();
		(loop begin
				if self:EndOfTheLine(arrowDirection) then begin
						break
					end;
				self:SetupExtras(arrowDirection, extras);
				scrollView:?viewScroll2DScript(arrowDirection, extras);
				self:AdjustArrows();
				arrow := self:GetArrow(arrowDirection);
				extras.count := (extras.count + 1);
				// DEVIATION: the repeat paced - a first step, then after a
				//  third of a second one every tenth while the pen stays down.
				//  The ROM's loop has no pacing of its own: each step (the
				//  list's abstracts set up again from the soup, redrawn) took
				//  the SA-110 long enough that a tap scrolled once; the host
				//  does a step in half a millisecond, so one tap ran through
				//  the whole list (Time Zones' cities went to the last).
				local pace := if extras.count = 1 then 20 else 6;
				local started := Ticks();
				while not StrokeDone(unit) and (Ticks() - started) < pace do Sleep(1);
				(if StrokeDone(unit) then break)
			end);
		scrollView:?viewScrollDoneScript();
		hilite := nil;
		self:DoDrawing('viewDrawScript, [Array: ]);
		true
	end
};
