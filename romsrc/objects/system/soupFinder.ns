// soupFinder, and what only it reaches

soupFinder := {
	cacheCount: nil,
	currentItem: 0,
	masterFinder: nil,
	selected: nil,
	count: func() begin
		(if self.cacheCount then cacheCount else (self.cacheCount := cursor:CountEntries()))
	end,
	Reset: func() begin
		(if self.isReset then cursor:entry() else begin
				self.isReset := true;
				cursor:Reset()
			end)
	end,
	ZeroOneOrMore: func() begin
		local l1, l2, l3;
		(if self.cacheCount then cacheCount else begin
				if self.zeroOneOrMoreResult then begin
						return self.zeroOneOrMoreResult
					end;
				l1 := cursor:entry();
				if self.isReset then begin
						l2 := l1
					end else begin
						l2 := cursor:Reset()
					end;
				l3 := 0;
				(while (l2 <> nil) do begin
						if ((l3 := (l3 + 1)) >= 2) then begin
								break
							end;
						(l2 := cursor:Next())
					end);
				if l1 then begin
						cursor:Goto(l1)
					end;
				(self.zeroOneOrMoreResult := l3)
			end)
	end,
	ReSync: func() begin
		cacheCount := nil;
		currentItem := 0;
		self:Reset();
		(zeroOneOrMoreResult := nil)
	end,
	ShowEntry: func(a1) begin
		if ((a1 = 'deleted) or (a1 = nil)) then begin
				currentItem := 0;
				cacheCount := nil;
				self.isReset := nil;
				a1 := self:Reset();
				self.zeroOneOrMoreResult := nil
			end else begin
				cursor:Goto(a1);
				self.isReset := nil
			end;
		(if (a1 <> nil) then (if owner.OpenTo then owner:OpenTo(a1, self) else begin
					if (owner.viewCObject = nil) then begin
							owner:?viewPreOpenScript(a1);
							owner:Open()
						end;
					(if owner.viewCObject then owner:ShowFoundItem(a1, self))
				end))
	end,
	ShowFoundItem: func(a1) begin
		local l1;
		currentItem := a1.itemIndex;
		self:ShowEntry((l1 := Query(a1.soup, {type: 'index, indexPath: '_uniqueID, beginKey: a1.entryID})):entry())
	end,
	ShowOrdinalItem: func(a1) begin
		local l1;
		(if (a1 = 'first) then begin
				currentItem := 0;
				self:ShowEntry(self:Reset())
			end else begin
				l1 := currentItem;
				if (a1 = 'prev) then begin
						currentItem := (currentItem - 1)
					end else begin
						if (a1 = 'Next) then begin
								currentItem := (currentItem + 1)
							end else begin
								currentItem := a1
							end
					end;
				currentItem := min(max(currentItem, 0), (self:count() - 1));
				self.isReset := nil;
				self:ShowEntry(cursor:move((currentItem - l1)))
			end)
	end,
	MakeFoundItem: func(a1, a2) begin
		local l1;
		if a2 then begin
				if (StrLen((l1 := a2:FindSoupExcerpt(a1, self))) > 50) then begin
						l1 := Substr(l1, 0, 80)
					end
			end;
		{_proto: @protoFindItem, finder: (if self.masterFinder then masterFinder else self), realFinder: self, entryID: EntryUniqueID(a1), soup: EntrySoup(a1), storeID: EntryStore(a1):GetSignature(), selected: nil, itemIndex: nil, title: l1}
	end,
	AddFoundItems: func(a1, a2, a3) begin
		local l1, l2, l3, l4;
		l2 := (l1 := cursor:entry());
		if (not self.isReset) then begin
				l2 := cursor:Reset()
			end;
		if (a2 > 0) then begin
				l2 := cursor:move(a2)
			end;
		l3 := 0;
		try begin
				(while (if (l2 <> nil) then (l3 < a3)) do begin
						(l4 := self:MakeFoundItem(l2, owner)).itemIndex := (l3 + a2);
						l4.selected := self:isSelected({_uniqueID: l4.entryID, _storeID: l4.storeID});
						AddArraySlot(a1, l4);
						l3 := (l3 + 1);
						(l2 := cursor:Next())
					end)
			end onexception |evt.ex| do begin
				cursor:Goto(l1);
				l1 := nil;
				l2 := nil
			end;
		if (l1 = 'deleted) then begin
				cursor:Reset()
			end else begin
				if l1 then begin
						cursor:Goto(l1)
					end
			end;
		l3
	end,
	SelectItem: SelectItem_2,
	isSelected: isSelected_2,
	ForEachSelected: ForEachSelected_2,
	FileAndMove: FileAndMove,
	FileAs: FileAs,
	MoveTo: MoveTo,
	delete: delete_5,
	GetTarget: GetTarget
};
