// soupFinder, and what only it reaches

soupFinder := {
	cacheCount: nil,
	currentItem: 0,
	masterFinder: nil,
	selected: nil,
	count: func() begin
		(if self.cacheCount then cacheCount else (self.cacheCount := cursor:CountEntries()))
	end,
	Reset: func() begin
		(if self.isReset then cursor:entry() else begin
				self.isReset := true;
				cursor:Reset()
			end)
	end,
	ZeroOneOrMore: func() begin
		local entry, reset, l3;
		(if self.cacheCount then cacheCount else begin
				if self.zeroOneOrMoreResult then begin
						return self.zeroOneOrMoreResult
					end;
				entry := cursor:entry();
				if self.isReset then begin
						reset := entry
					end else begin
						reset := cursor:Reset()
					end;
				l3 := 0;
				(while (reset <> nil) do begin
						if ((l3 := (l3 + 1)) >= 2) then begin
								break
							end;
						(reset := cursor:Next())
					end);
				if entry then begin
						cursor:Goto(entry)
					end;
				(self.zeroOneOrMoreResult := l3)
			end)
	end,
	ReSync: func() begin
		cacheCount := nil;
		currentItem := 0;
		self:Reset();
		(zeroOneOrMoreResult := nil)
	end,
	ShowEntry: func(a1) begin
		if ((a1 = 'deleted) or (a1 = nil)) then begin
				currentItem := 0;
				cacheCount := nil;
				self.isReset := nil;
				a1 := self:Reset();
				self.zeroOneOrMoreResult := nil
			end else begin
				cursor:Goto(a1);
				self.isReset := nil
			end;
		(if (a1 <> nil) then (if owner.OpenTo then owner:OpenTo(a1, self) else begin
					if (owner.viewCObject = nil) then begin
							owner:?viewPreOpenScript(a1);
							owner:Open()
						end;
					(if owner.viewCObject then owner:ShowFoundItem(a1, self))
				end))
	end,
	ShowFoundItem: func(a1) begin
		local cursor;
		currentItem := a1.itemIndex;
		self:ShowEntry((cursor := Query(a1.soup, {type: 'index, indexPath: '_uniqueID, beginKey: a1.entryID})):entry())
	end,
	ShowOrdinalItem: func(a1) begin
		local currentItem2;
		(if (a1 = 'first) then begin
				currentItem := 0;
				self:ShowEntry(self:Reset())
			end else begin
				currentItem2 := currentItem;
				if (a1 = 'prev) then begin
						currentItem := (currentItem - 1)
					end else begin
						if (a1 = 'Next) then begin
								currentItem := (currentItem + 1)
							end else begin
								currentItem := a1
							end
					end;
				currentItem := min(max(currentItem, 0), (self:count() - 1));
				self.isReset := nil;
				self:ShowEntry(cursor:move((currentItem - currentItem2)))
			end)
	end,
	MakeFoundItem: func(a1, owner) begin
		local soupExcerpt;
		if owner then begin
				if (StrLen((soupExcerpt := owner:FindSoupExcerpt(a1, self))) > 50) then begin
						soupExcerpt := Substr(soupExcerpt, 0, 80)
					end
			end;
		{_proto: @protoFindItem, finder: (if self.masterFinder then masterFinder else self), realFinder: self, entryID: EntryUniqueID(a1), soup: EntrySoup(a1), storeID: EntryStore(a1):GetSignature(), selected: nil, itemIndex: nil, title: soupExcerpt}
	end,
	AddFoundItems: func(a1, a2, a3) begin
		local entry, reset, l3, foundItem;
		reset := (entry := cursor:entry());
		if (not self.isReset) then begin
				reset := cursor:Reset()
			end;
		if (a2 > 0) then begin
				reset := cursor:move(a2)
			end;
		l3 := 0;
		try begin
				(while (if (reset <> nil) then (l3 < a3)) do begin
						(foundItem := self:MakeFoundItem(reset, owner)).itemIndex := (l3 + a2);
						foundItem.selected := self:isSelected({_uniqueID: foundItem.entryID, _storeID: foundItem.storeID});
						AddArraySlot(a1, foundItem);
						l3 := (l3 + 1);
						(reset := cursor:Next())
					end)
			end onexception |evt.ex| do begin
				cursor:Goto(entry);
				entry := nil;
				reset := nil
			end;
		if (entry = 'deleted) then begin
				cursor:Reset()
			end else begin
				if entry then begin
						cursor:Goto(entry)
					end
			end;
		l3
	end,
	SelectItem: SelectItem_2,
	isSelected: isSelected_2,
	ForEachSelected: ForEachSelected_2,
	FileAndMove: FileAndMove,
	FileAs: FileAs,
	MoveTo: MoveTo,
	delete: delete_5,
	GetTarget: GetTarget
};
