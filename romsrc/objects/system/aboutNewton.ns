// aboutNewton: the Assistant's "about Newton" Easter egg.  Asking the Assistant
// about Newton opens it with "What about Newton?" and then, every second, shows
// "What about <name>?" for each of 186 names of the people who made it (the
// literal array in the function), until all have been shown or the Assistant
// closes; then it closes the Assistant.

aboutNewton := compile(
	constants: {
		// whether a1 is prime (for the stride through the names; see below)
		kFunction_637e69: func(a1) begin
			// an odd-divisor primality test: true when a1 is prime
			(if (a1 = 1) then true else (if ((a1 mod 2) = 0) then (a1 = 2) else begin
						(for i := 3 to floor(sqrt(a1)) by 2 do begin
								if ((a1 mod i) = 0) then begin
										return nil
									end
							end);
						return true
					end))
		end
	},
	// called with no arguments (the Assistant's "about" action); sets up the
	// delayed calls that step through the names and returns at once
	func() begin
		local assistSlip, prime, start, count, ShowNextPersonFn;
		local l1;
		(if (assistSlip := GetRoot().assistant).assistLine.entryLine then begin
				SetValue(assistSlip.assistLine.entryLine, 'text, ParamStr("What about ^0?", [Array: "Newton"]));
				RefreshViews();
				l1 := kFunction_637e69;
				// a random prime above 186 as the stride: it shares no factor with 186
				// (2 * 3 * 31), so stepping by it modulo 186 visits every name exactly once
				if (((prime := Random(187, 23167)) mod 2) = 0) then begin
						prime := (prime + 1)
					end;
				(while (not call l1 with (prime)) do (prime := (prime + 2)));
				// the first name shown, then one each 1000 ms (3000 ms before the first)
				start := Random(0, 185);
				count := 0;
				AddDelayedCall((ShowNextPersonFn := func() begin
					// stops when the Assistant's entry line has gone (the slip was closed)
					(if assistSlip.assistLine.entryLine then (if (count < 186) then begin
								SetValue(assistSlip.assistLine.entryLine, 'text, ParamStr("What about ^0?", [Array: '[Array: "#25", "Adrian", "Alfred", "Amy", "Andreas", "Arash", "Avi", "Barney", "Bentley", "Beth", "Bill", "Bob", "Breman", "Bruce", "Bubenheim", "Cami", "Capener", "Chadburn", "Chiavetta", "Chip", "Christina", "Christine", "Christopher", "Conrad", "Corbett", "Crane", "Culbert-san", "DK", "DanC", "Danielle", "DaveP", "Diane", "Dick", "Dooney", "Dottie", "Duret", "Ed", "Erfert", "Ernie", "Fedor", "Flash", "GMills", "Gabriel", "Garth", "GaryH", "Gen", "Gene", "George", "Gerry", "Gicqu\u00E8\u", "Giulia", "Glen", "Greg", "HSJennings3", "Henry", "Huynh", "ISpammie", "Ilia", "Ingrid", "Ivan", "J.Tate", "JCanepa", "JOROZE", "JTang", "James", "Jane", "JasonT", "Jeff", "JeffB", "Jen", "Jodie", "JohnA", "Jonathan", "Julie", "Kelly", "Kondrk", "Leeski", "Les", "Lieh-Wuu", "Linda", "Lon", "Lucien", "Lundgren", "Lysa", "Marge", "Margo", "Marie", "Marino", "Matt", "Maurice", "McEntee", "Michelle", "Mike", "MikeSam", "Mimi", "Minnie", "MonkeyMan", "Mori-san", "Mr Mike", "Nave", "Norberg", "Noroyan", "Patti", "Patty", "Paul", "Perry", "Pete", "Phantom", "Ping", "Polina", "Q", "RSirota", "RWFII", "Raff", "Raphael", "Rea", "Rendon", "Ric", "Rich", "Richard", "Rob", "Robin", "Rubeen", "Ryan", "Sandy", "Sasha", "Scheuer", "Schoeny", "Schroder", "Scott", "Storey", "Stuart", "Sue", "SusanP.", "Sylvia", "Szeto", "T.B.Roberts", "Ted", "Tom", "Ton-Yun", "Tony", "Tracy", "Tricia", "Tripp", "Uncle-Jay", "Vernon", "Vivian", "Vroman", "Wayne", "Wendy", "Yannick", "Yatsuzuka-san", "Yoyodyne", "Yun", "Zhou", "beaver", "cate3", "charlie", "christie", "cmE", "curiousg", "cy", "dg", "dld", "dotson", "engber", "hjcr", "hlee", "h\u00E9\ul\u00E8\une", "jXopher", "jerk", "jghiii", "jood", "kenyon", "korey", "krusty", "larryy", "mon.cherie", "rarick", "rkl3", "roger", "scott", "temkin", "timbus", "william", "wyld"][((start + (count * prime)) mod 186)]]));
								count := (count + 1);
								AddDelayedCall(ShowNextPersonFn, nil, 1000)
							end else assistSlip:Close()))
				end), nil, 3000)
			end)
	end);

// what the functions above hold and share with other objects (same(): romsrc/README.md)

aboutNewton_literal6 := same("aboutNewton.literals[6]");
