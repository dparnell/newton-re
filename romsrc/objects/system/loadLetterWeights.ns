// loadLetterWeights (@119): gives the cursive recogniser its saved letter
// weights and learning data from the "LetterWeights2.0" and
// "LearningData2.0" tagged entries of the system soup.

// Called with no arguments (from the boot script). Does nothing when
// letterSetSelection is 2 (presumably the printed recogniser, which has no
// letter weights). Returns true if letter weights were set, else nil.
loadLetterWeights := func() begin
	local l1, taggedEntry;
	if (userConfiguration.letterSetSelection <> 2) then begin
			if (if (taggedEntry := GetTaggedEntry("LetterWeights2.0")) then taggedEntry.data) then begin
					SetLetterWeights(taggedEntry.data);
					l1 := true
				end;
			if userConfiguration.bigLearningEnabled then begin
					if (if (taggedEntry := GetTaggedEntry("LearningData2.0")) then taggedEntry.data) then begin
							SetLearningData(taggedEntry.data)
						end
				end
		end;
	l1
end;

// what the functions above hold and share with other objects (same(): romsrc/README.md)

loadLetterWeights_literal7 := same("loadLetterWeights.literals[7]");
