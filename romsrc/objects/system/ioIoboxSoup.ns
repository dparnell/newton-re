// ioIoboxSoup (@824): the In/Out Box's soup definition - its indexes, the
// query its cursor uses and the methods (shared with other soup definitions)
// that make and file its entries.

ioIoboxSoup := {
	soupIndices: @ioIndices,
	soupQuery: soupQuery,
	defaultDataType: 'paperroll,
	CreateBlankEntry: CreateBlankEntry,
	UseNilLabelsAsUnfiled: true,
	FillNewSoup: FillNewSoup,
	AddTagSlot: AddTagSlot,
	FolderTag: FolderTag,
	SetupCursor: SetupCursor,
	AddEntry: AddEntry
};
