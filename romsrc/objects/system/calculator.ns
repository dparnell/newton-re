// calculator: the Calculator (Extras), a four-function adding machine floater:
// a tape (paperDisplay, the last 30 lines of which maxLines show), the entry
// display, and a keypad (keys).  The keys' results are the codes the code
// works with: 1-9 the digits, 117 the digit 0, 100 the decimal point, 101 %,
// 102 MR, 108 =, 111 C (clear all), 112 CE (clear entry), 113 +, 114 -,
// 115 x, 116 divide, 152 square root, 153 M+, 154 M-.  value is the number
// being entered or the result, stack the running total, pendingOp the
// operation waiting for its second operand.  The keyboard works too (lookup).

calculator := {
	isUnary: nil,
	Display: nil,
	stack: stack,
	_cacheContext: {
		isUnary: nil,
		Display: nil,
		stack: stack,
		keyFactor: keyFactor,
		viewFlags: vApplication + vClickable,
		keys: nil,
		memory: nil,
		lastKey: -1,
		index: 24,
		paper: nil,
		viewclipper: nil,
		_proto: nil,
		viewCObject: nil,
		paperDisplay: nil,
		value: stack,
		inputKeys: uCardPositionAlertButton,
		unary: nil,
		valueFactor: valueFactor,
		_parent: nil,
		pendingOp: 108,
		Clear: true,
		base: nil,
		digitCount: 0
	},
	preallocatedContext: 'calculator,
	rotated: nil,
	// the rounded frame round the tape and display (a narrower one when rotated)
	viewDrawScript: func() begin
		(if rotated then self:DrawShape(MakeRoundRect(1, 1, 138, (((1 + (15 * maxLines)) + 18) + 4), 5), '{pensize: 2, fillPattern: 0}) else self:DrawShape(MakeRoundRect(1, 1, 169, (((1 + (15 * maxLines)) + 18) + 4), 5), '{pensize: 2, fillPattern: 0}))
	end,
	viewChildren: [viewChildren: {_proto: @protoClosebox}, paperDisplay, Display, keys],
	keyFactor: keyFactor,
	viewFlags: vApplication + vClickable,
	keys: nil,
	// a number as the display and tape show it: eight significant digits
	// (%.8G), the exponent (if any) as %.8g writes it
	CalcFormattedNumberStr: compile(
		constants: {
			kLiteral_4e1865: "%.8G"
		},
		func(value) begin
			local text, pos, formattedNumberStr2;
			if (value < 0) then begin
					text := Stringer([Array: "-", FormattedNumberStr((-value), kLiteral_4e1865)])
				end else begin
					text := FormattedNumberStr(value, kLiteral_4e1865)
				end;
			if (pos := StrPos(text, "e", 0)) then begin
					text := Substr(text, 0, pos);
					pos := StrPos((formattedNumberStr2 := FormattedNumberStr(value, "%.8g")), "e", 0);
					formattedNumberStr2 := Substr(formattedNumberStr2, pos, 9999);
					text := Stringer([Array: text, formattedNumberStr2])
				end;
			text
		end),
	ReOrientToScreen: @defRotateFunc,
	memory: nil,
	lastKey: -1,
	viewBounds: {left: 0, top: 0, right: 170, bottom: 257},
	// a key typed on a keyboard: the key code of the calculator key lookup gives
	// for the character
	viewKeyDownScript: func(char2, flags) begin
		if (if (char2 <> $\00) then (not IsCommandKeystroke(char2, flags))) then begin
				(foreach item in lookup do begin
						if (char2 = item[0]) then begin
								keys:keyPressScript(item[1]);
								RefreshViews()
							end
					end)
			end;
		nil
	end,
	// shows maxLines of the tape from line index
	calcPaperDisplay: func() begin
		smartStart2 := SmartStart(120);
		l2 := (maxLines - 1);
		smartConcat2 := 0;
		local smartStart2;
		local l2;
		local smartConcat2;
		(for i := 0 to l2 do begin
				smartConcat2 := SmartConcat(smartStart2, smartConcat2, paper[(index + i)]);
				if (i <> l2) then begin
						smartConcat2 := SmartConcat(smartStart2, smartConcat2, $\n)
					end
			end);
		SmartStop(smartStart2, smartConcat2);
		SetValue(paperDisplay, 'text, smartStart2)
	end,
	allocateContext: [|Array|: 'paperDisplay, paperDisplay, 'Display, Display, 'keys, keys],
	index: 24,
	paper: nil,
	maxLines: 6,
	_proto: @protoFloater,
	paperDisplay: nil,
	textFlags: 1024,
	value: stack,
	// adds a line at the end of the tape (the tape scrolls up one line) and shows
	// the end
	printToPaper: func(text) begin
		(for i := 1 to 29 do begin
				paper[(i - 1)] := paper[i]
			end);
		paper[29] := text;
		index := (30 - maxLines);
		self:calcPaperDisplay();
		paperDisplay:Dirty()
	end,
	inputKeys: uCardPositionAlertButton,
	viewScrollDownScript: func() begin
		(if (index < (30 - maxLines)) then begin
				index := (index + 1);
				self:calcPaperDisplay()
			end)
	end,
	viewJustify: vjParentCenterH + vjParentCenterV,
	unary: nil,
	viewScrollUpScript: func() begin
		(if (index > 1) then begin
				index := (index - 1);
				self:calcPaperDisplay()
			end)
	end,
	declareSelf: 'base,
	// a short application area (the screen rotated to landscape) gets the wide
	// layout, with the keypad beside the tape
	viewSetupFormScript: func() begin
		if (not paper) then begin
				paper := Clone(initPaper)
			end;
		if (GetAppParams().appAreaHeight < 257) then begin
				self.rotated := true;
				viewBounds := SetBounds(0, 0, 304, 144);
				maxLines := 8;
				index := (30 - maxLines)
			end else begin
				if (if self.rotated then (GetAppParams().appAreaHeight > 257)) then begin
						self.rotated := nil;
						viewBounds := SetBounds(0, 0, 170, 257);
						maxLines := 6;
						index := 24
					end
			end;
		SetKeyView(self, 0);
		self:calcPaperDisplay()
	end,
	valueFactor: valueFactor,
	// the empty tape: 30 lines
	initPaper: [|Array|:
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020,
		$\u0020
	],
	pendingOp: 108,
	KClassroomAware: true,
	Clear: true,
	digitCount: 0,
	viewHelpTopic: learn,
	// the keyboard's characters and the calculator key codes they press
	lookup: [|Array|:
		[|Array|: $., 100],
		[|Array|: $0, 117],
		[|Array|: $1, 1],
		[|Array|: $2, 2],
		[|Array|: $3, 3],
		[|Array|: $4, 4],
		[|Array|: $5, 5],
		[|Array|: $6, 6],
		[|Array|: $7, 7],
		[|Array|: $8, 8],
		[|Array|: $9, 9],
		[|Array|: $C, 111],
		[|Array|: $c, 111],
		[|Array|: $e, 112],
		[|Array|: $E, 112],
		[|Array|: $\u0008, 112],
		[|Array|: $/, 116],
		[|Array|: $\u221a, 152],
		[|Array|: $*, 115],
		[|Array|: $x, 115],
		[|Array|: $X, 115],
		[|Array|: $%, 101],
		[|Array|: $-, 114],
		[|Array|: $=, 108],
		[|Array|: $\u000d, 108],
		[|Array|: $\u0003, 108],
		[|Array|: $+, 113]
	]
};

valueFactor := real('|Real|, 10.0);

paperDisplay := {
	viewBounds: {left: 3, top: 3, right: 167, bottom: 93},
	viewFlags: vVisible + vReadOnly + vClickable + vGesturesAllowed,
	viewJustify: vjRightH,
	viewFont: tsSimple + tsSize(12),
	viewLineSpacing: 15,
	pix: nil,
	viewSetupFormScript: func() begin
		(if rotated then (viewBounds := RelBounds(3, 3, 133, (15 * maxLines))))
	end,
	viewSetupDoneScript: func() begin
		(if rotated then SetValue(self, 'viewJustify, vjRightH))
	end,
	viewDrawScript: func() begin
		(if memory then begin
