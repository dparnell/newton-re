// cribNote: magic pointer @61, the view of an event in the Date Book's day view
// - a meeting entry whose viewStationery is 'cribNote, an untimed note for the
// day shown above the meetings.  It is a line with the event's icon (the slider
// child) and its editable text (textView); a change to the text is saved back
// into the meeting after a short delay.

cribNote := {
	debug: 9281,
	_proto: cribNoteProto,
	viewBounds: nil,
	viewJustify: vjParentFullH + vjSiblingBottomV,
	viewFormat: vfNone,
	target: nil,
	targetView: nil,
	SliderWidth: 0,
	transformStyle: {transform: [|Array|: 1, 1]},
	// brings a 1.x event (version not 2) up to date in its soup first, when the
	// store can be written, and remakes the instance of a repeating one
	viewSetupFormScript: func() begin
		local realData2;
		if (realData2 := realData).repeatTemplate then begin
				realData2 := realData2.repeatTemplate
			end;
		if (realData2.version <> 2) then begin
				if (not EntryStore(realData2):IsReadOnly()) then begin
						self:Convert10to20(realData2, nil);
						EntryChangeXmit(realData2, 'calendar);
						if realData.repeatTemplate then begin
								realData := self:MakeInstanceOfRepeatingMeeting(realData2, realData.mtgStartDate)
							end
					end
			end;
		target := self.realData;
		targetView := self;
		viewBounds := SetBounds(2, 0, 0, cribLineSpacing);
		inherited:viewSetupFormScript()
	end,
	// drops onto the event of something that is a meeting go to the day view
	// (cribView), anything else to the event itself
	viewFindTargetScript: func(a1) begin
		(foreach item in a1 do begin
				if SetContains(item.types, 'meeting) then begin
						return cribView
					end
			end);
		self
	end,
	// Drops are not taken.
	viewDropScript: func(dragInfo, dropPt, a3) begin
		nil
	end,
	viewChildren: [viewChildren:
		{
			debug: "Slider",
			viewClass: clSliderView,
			viewFlags: vVisible + vClickable,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 12},
			viewJustify: 0,
			viewFormat: vfNone
		},
		textView_2
	],
	textView: nil,
	allocateContext: [|Array|: 'textView, textView_2],
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		realData: nil,
		viewBounds: nil,
		target: nil,
		targetView: nil,
		iconShape: nil,
		textView: nil
	}
};

textView_2ViewBounds := {left: 26, top: 0, right: 0, bottom: 0};

textView_2 := {
	debug: 9392,
	viewClass: clParagraphView,
	viewBounds: textView_2ViewBounds,
	viewFlags: vVisible,
	viewJustify: vjParentFullH + vjParentFullV + oneLineOnly,
	textFlags: 24,
	text: nil,
	// The event's text, in the event font and spacing.
	viewSetupFormScript: func() begin
		text := self:GetMeetingText(realData);
		self.viewFont := cribFont;
		(self.viewLineSpacing := cribLineSpacing)
	end,
	// the text was edited: the change goes to the calendar half a second after the
	// last edit (a procrastinated send), as the meeting's mtgText
	viewChangedScript: func(slot, view) begin
		local richString;
		(if (slot = 'text) then begin
				richString := MakeRichString(view.text, view.styles);
				AddProcrastinatedSend('calendar, cribView, 'changeNote, [Array: realData, 'mtgText, richString], 500)
			end)
	end,
	preallocatedContext: 'textView,
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		text: nil,
		viewFont: nil,
		viewLineSpacing: nil,
		viewBounds: textView_2ViewBounds
	}
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewFindTargetScript_code := same("cribNote.viewFindTargetScript.instructions");
