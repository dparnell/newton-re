// loadGlobals, and what only it reaches

loadGlobals := func() begin
	local l1, l2, l3;
	l1 := GetStores()[0];
	if (l2 := l1:GetSoup(@systemSoupName)) then begin
			l3 := l2:Query({indexPath: 'tag, beginKey: "userConfiguration", endKey: "userConfiguration"}):entry()
		end;
	if (not l3) then begin
			DefGlobalVar('userConfiguration, {_proto: @userConfiguration, tag: "userConfiguration", lcdContrast: GetLCDContrast()});
			SetSortID(GetUserConfig('sortID))
		end else begin
			l3._proto := @userConfiguration;
			DefGlobalVar('userConfiguration, l3)
		end;
	if (not l2) then begin
			l2 := l1:CreateSoup(@systemSoupName, @systemSoupIndexes)
		end;
	if (not l3) then begin
			l2:Add(userConfiguration)
		end;
	SetLCDContrast(GetUserConfig('lcdContrast));
	SetSystemVolume(GetUserConfig('soundVolumeDb));
	nil
end;

// what the functions above hold and share with other objects (same(): romsrc/README.md)

loadGlobals_literal3 := same("loadGlobals.literals[3]");
