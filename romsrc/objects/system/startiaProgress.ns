// startiaProgress, and what only it reaches
//
// Opens the Intelligent Assistant's "Interpreting" progress slip (a
// vBarber status slip with the Assistant's icon and no close box) and does
// the work under it; tickleiaProgress keeps it turning.

startiaProgress := compile(
	constants: {
		kNativeFuncClass: call func(f) if IsFrame(f) then f.class else f[0] with (GetGlobalFn('StrLen)),
		// run when this function is built: a binary of class cls from the hex
		// string hex, for the literals below
		kBinaryFromHex: func(hex, cls) begin
			local b := MakeBinary(StrLen(hex) div 2, cls);
			for i := 0 to Length(b) - 1 do begin
				local h := Ord(hex[2 * i]);
				local l := Ord(hex[2 * i + 1]);
				StuffByte(b, i, (if h >= 97 then h - 87 else h - 48) * 16 + (if l >= 97 then l - 87 else l - 48))
			end;
			b
		end,
		kLiteral_52b639: {bits: call kBinaryFromHex with ("00000000000400f500f5025f010f027a00000000000c0000000c0000000c000000080300180007001e1f0e00067fc00000f1e00001c0700001c07000038e3800038e38007b8e3bc0718431c001c0600000e1c0000071800000380000001c0000001c000000380000003c0000000e0000001e0000001c0000", 'bits), bounds: '{left: 0, top: 0, right: 27, bottom: 26}},
		kLiteral_52b64d: {class: kNativeFuncClass, funcPtr: 7018690, numArgs: 1}
	},
	func() begin
		// DoProgress opens the slip and calls the work function (a native, one
		// argument: the slip's context view), answering what that returns.
		local vBarber;
		return (vBarber := DoProgress('vBarber, {statusText: "Interpreting", barber: true, icon: kLiteral_52b639, closeBox: nil}, kLiteral_52b64d))
	end);
