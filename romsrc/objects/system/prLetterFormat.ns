// prLetterFormat (@870): the "Letter" print format - the letterhead, the
// addressee, the item's data reflowed and a closing on the first page, the rest
// of the data on the following pages; its auxiliary slip (addresseeSlip) asks
// for the addressee.

prLetterFormat := {
	symbol: 'prLetterFormat,
	title: "Letter",
	addAddressee: true,
	addSender: true,
	auxForm: @addresseeSlip,
	margins: {left: 60, top: 0, right: 60, bottom: 0},
	data: nil,
	kids: nil,
	reflowStart: 0,
	// the first page's body: addressee, reflowed data and (with a signature)
	// closing
	page1guts: {
		viewClass: clView,
		viewBounds: nil,
		viewFlags: vVisible + vReadOnly,
		viewFormat: 0,
		viewJustify: vjParentCenterH + vjParentCenterV + vjChildrenLasso + vjReflow,
		// viewSetupFormScript: as high as the page less the letterhead and margins.
		viewSetupFormScript: func() begin
			(self.viewBounds := RelBounds(0, 20, pageWidth, ((pageHeight - 120) - 60)))
		end,
		// viewSetupChildrenScript: makes kids once - the addressee, the data reflowed
		// into page-sized pieces (in one font when the data uses only one family) and
		// the closing when there is a signature - then shows them from reflowStart on.
		viewSetupChildrenScript: func() begin
			local reflowPreflight2, box, insetRect2;
			if (if (not kids) then data) then begin
					if (Length((reflowPreflight2 := ReflowPreflight(data)).family) = 1) then begin
							self.viewFont := {family: reflowPreflight2.family[0], face: 0, size: 12}
						end;
					kids := (if fields.fromSignature then [Array: @stdAddressee, @stdClosing] else [Array: @stdAddressee]);
					(box := self:LocalBox()).top := (box.top + 100);
					box.bottom := (box.bottom - 60);
					(insetRect2 := InsetRect(fields.printerPageBounds, 60, 0)).bottom := (insetRect2.bottom - 60);
					ArrayMunger(kids, 1, 0, ReFlow(data, {reflowFont: tsFancy + tsSize(12), unistyle: 'font, graphicsGutter: 16, textGutter: -16, viewLineSpacing: 28, pageBounds: insetRect2}, fields.targetBox, box), 0, nil)
				end;
			(if kids then (self.stepChildren := ArrayMunger([Array: ], 0, 0, kids, reflowStart, nil)))
		end,
		// viewSetupDoneScript: the next page starts after the pieces shown here.
		viewSetupDoneScript: func() begin
			(if self.stepChildren then (reflowStart := (reflowStart + Length(self.stepChildren))))
		end
	},
	// the body of the following pages
	page2Guts: {
		viewClass: clView,
		viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
		viewFlags: vVisible + vReadOnly,
		viewJustify: vjParentFullH + vjParentFullV,
		viewFormat: 0,
		// viewSetupFormScript: keeps the body at least 60 pixels from the page's
		// top and left edges.
		viewSetupFormScript: func() begin
			local box;
			box := self:GlobalBox();
			(viewBounds := SetBounds(max((60 - box.left), 0), max((60 - box.top), 0), 0, 0))
		end,
		viewChildren: page2GutsViewChildren
	},
	// viewSetupFormScript: the data to print, from the first piece on.
	viewSetupFormScript: func() begin
		inherited:viewSetupFormScript();
		self.data := target.data;
		(self.reflowStart := 0)
	end,
	// viewSetupChildrenScript: the letterhead and first body on the first page,
	// the following pages' body after it.
	viewSetupChildrenScript: func() begin
		if (self.reflowStart = 0) then begin
				self.stepChildren := [Array: GetUserConfig('letterheadForm), page1guts]
			end else begin
				self.stepChildren := [Array: page2Guts]
			end;
		inherited:viewSetupChildrenScript()
	end,
	// printNextPageScript: lays out another page while reflowed pieces are left;
	// nil after the last.
	printNextPageScript: func() begin
		(if (if kids then (reflowStart < Length(kids))) then self:RedoChildren())
	end,
	_proto: @coverPageFormat
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewSetupFormScript_code_16 := same("prLetterFormat.viewSetupFormScript.instructions");
