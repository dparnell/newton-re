// defaultInfoPrefs, and what only it reaches

defaultInfoPrefs := {
	DoInfoHelp: func() begin
		local l1, l2;
		l1 := GetRoot().(appSymbol);
		(if (if (l2 := GetRoot().TinyTim) then l2.viewCObject) then l2:Close() else OpenHelpTo("Route"))
	end,
	GetTitle: func() begin
		GetRoot().(appSymbol).title
	end,
	RememberedClose: func(a1) begin
		self:viewQuitScript()
	end
};
