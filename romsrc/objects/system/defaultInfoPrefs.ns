// defaultInfoPrefs, and what only it reaches

defaultInfoPrefs := {
	DoInfoHelp: func() begin
		local l1, tinyTim;
		l1 := GetRoot().(appSymbol);
		(if (if (tinyTim := GetRoot().TinyTim) then tinyTim.viewCObject) then tinyTim:Close() else OpenHelpTo("Route"))
	end,
	GetTitle: func() begin
		GetRoot().(appSymbol).title
	end,
	RememberedClose: func(a1) begin
		self:viewQuitScript()
	end
};
