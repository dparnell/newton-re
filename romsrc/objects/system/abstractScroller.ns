// abstractScroller: what the system scroller protos (protoUpDownScroller,
// protoLeftRightScroller, protoHorizontal2DScroller, ...) are built on.  It keeps
// the arrows' states (scrollerState, indexed through DirMap), works out how far
// each step scrolls (SetupExtras) from ScrollAmounts and the units, and keeps
// xPos/yPos within ScrollRect when the scroller tracks positions itself.  The
// protos give it DirMap, StateMap, Arrows and ArrowCount; its children are
// abstractArrows.

abstractScroller := {
	ArrowCount: nil,
	DirMap: nil,
	// sets each arrow the scroller has to 'more or 'normal by whether there is more
	// of DataRect beyond the view's position (ViewRect) in its direction
	AdjustArrows: func() begin
		local l1;
		(if ScrollRect then begin
				if DirMap.left then begin
						l1 := (if (if DataRect then (xPos > DataRect.left)) then 'more else 'normal);
						self:SetArrow('left, l1)
					end;
				if DirMap.right then begin
						l1 := (if ((xPos + (ViewRect.right - ViewRect.left)) < DataRect.right) then 'more else 'normal);
						self:SetArrow('right, l1)
					end;
				if DirMap.up then begin
						// a DataRect bottom of 9999 means the extent is unknown: the vertical arrows
						// are then left normal
						l1 := (if (DataRect.bottom = 9999) then 'normal else (if (yPos > DataRect.top) then 'more else 'normal));
						self:SetArrow('up, l1)
					end;
				(if DirMap.down then begin
						l1 := (if (DataRect.bottom = 9999) then 'normal else (if ((yPos + (ViewRect.bottom - ViewRect.top)) < DataRect.bottom) then 'more else 'normal));
						self:SetArrow('down, l1)
					end)
			end)
	end,
	viewFormat: vfFillWhite,
	// swallows a scrub gesture over the scroller; nothing else
	viewgesturescript: func(unit, gesture) begin
		(gesture = aeScrub)
	end,
	StateMap: nil,
	scrollYUnits: 1,
	viewFlags: vVisible + vReadOnly,
	ViewRect: nil,
	viewBounds: nil,
	scrollerState: nil,
	Arrows: nil,
	PageThreshold: 5,
	viewJustify: nil,
	// the state name ('normal, 'more, ...) of arrowDirection's arrow: the StateMap
	// slot whose value is its scrollerState entry
	GetArrow: func(arrowDirection) begin
		scrollerStateItem := scrollerState[DirMap.(arrowDirection)];
		local scrollerStateItem;
		(foreach key, value in StateMap do begin
				if (value = scrollerStateItem) then begin
						break key
					end
			end)
	end,
	yPos: 0,
	scrollXUnits: 1,
	// step sizes: [a single step, a step once the pen has been held for PageThreshold
	// steps, a double tap], times scrollXUnits/scrollYUnits
	ScrollAmounts: [|Array|: 1, 1, 1],
	declareSelf: 'Scroller,
	// makes the arrows' state array; the scroller scrolls itself unless the template
	// gave it a scrollView
	viewSetupFormScript: func() begin
		scrollerState := Array(ArrowCount, 0);
		if (not scrollView) then begin
				scrollView := self
			end;
		self:AdjustArrows()
	end,
	ScrollRect: nil,
	viewClass: clView,
	scrollView: nil,
	// fills in an abstractArrow's extras frame a2 for a step in arrowDirection: the
	// axis and the signed amount, clipped so xPos/yPos stay inside ScrollRect
	SetupExtras: func(arrowDirection, a2) begin
		local l1, l2;
		a2.axis := (if ((arrowDirection = 'left) or (arrowDirection = 'right)) then 'horizontal else 'vertical);
		l1 := (if (a2.tap = 'double) then ScrollAmounts[2] else (if (a2.count >= PageThreshold) then ScrollAmounts[1] else ScrollAmounts[0]));
		l2 := (if (a2.axis = 'horizontal) then scrollXUnits else scrollYUnits);
		a2.amount := (if ((arrowDirection = 'left) or (arrowDirection = 'up)) then ((-l1) * l2) else (l1 * l2));
		(if ScrollRect then (if (a2.axis = 'horizontal) then begin
					if ((xPos + a2.amount) < 0) then begin
							a2.amount := (-xPos)
						end else begin
							if ((xPos + a2.amount) >= (ScrollRect.right - (ViewRect.right - ViewRect.left))) then begin
									a2.amount := ((ScrollRect.right - (ViewRect.right - ViewRect.left)) - xPos)
								end
						end;
					(xPos := (xPos + a2.amount))
				end else begin
					if ((yPos + a2.amount) < 0) then begin
							a2.amount := (-yPos)
						end else begin
							if ((yPos + a2.amount) > (ScrollRect.bottom - (ViewRect.bottom - ViewRect.top))) then begin
									a2.amount := ((ScrollRect.bottom - (ViewRect.bottom - ViewRect.top)) - yPos)
								end
						end;
					(yPos := (yPos + a2.amount))
				end))
	end,
	DataRect: nil,
	xPos: 0,
	// The sound of an arrow that cannot go further.
	PlayStopSound: func() begin
		playsound(@tockSound)
	end,
	// sets arrowDirection's arrow to the StateMap state a2 and redraws the scroller
	SetArrow: func(arrowDirection, a2) begin
		scrollerState[DirMap.(arrowDirection)] := StateMap.(a2);
		(if (if (Scroller exists) then Visible(Scroller)) then Scroller:Dirty())
	end,
	// scrolls one step in direction a1 as if its arrow were tapped (for keys and
	// other code): finds the child arrow for a1 and does what its click would
	DoScroll: func(a1) begin
		local childViewFrames;
		(foreach item in (childViewFrames := self:ChildViewFrames()) do begin
				local copy;
				if (a1 = item.arrowDirection) then begin
						if (not item:EndOfTheLine(a1)) then begin
								copy := Clone(item.baseFrame);
								self:SetupExtras(a1, copy);
								scrollView:?viewScroll2DScript(a1, copy);
								self:AdjustArrows();
								item:DoDrawing('viewDrawScript, [Array: ])
							end;
						break
					end
			end)
	end
};
