// defaultItemStateMsgs: protoTransport's default itemStateMsgs, the words the
// In/Out Box shows for an item's state (ready, sent, received, read, logged,
// pending, remote, error).

defaultItemStateMsgs := {
	ready: ready,
	Sent: sent,
	Received: new_2,
	Read: read,
	InLog: logged,
	OutLog: logged,
	pending: pending,
	Remote: "Remote",
	error: "Error"
};
