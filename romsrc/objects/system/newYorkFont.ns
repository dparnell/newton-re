// newYorkFont (@131): the Fancy screen font family (New York; family number
// 1, tsFancy): its sfnt data, sizes offered to the user and the PostScript font
// printed for it (Times Roman).

newYorkFont := {
	name: "Fancy",
	encoding: 0,
	macFontID: 2,
	screenSym: 'newYorkFont,
	psName: 'timesroman,
	// 16.16 fixed point: about 1.15
	psScale: 75366,
	badFontMap: 1,
	plainData: sfnt('sfnt, "resources/sfnt/3e9319"),
	boldData: nil,
	italicData: nil,
	boldItalicData: nil,
	userSizes: [|Array|: 9, 10, 12, 18],
	usable: true,
	tsID: 1
};
