// soundOff, and what only it reaches
//
// The system's alert sounds by symbol (magic pointer 263): the prototype of
// the global SoundRegistry, where GetRegisteredSound looks a sound up and
// whose userName strings are the choices the Sound preferences offer (the
// user's choice is userConfiguration.beepSound / alarmSound). The first
// four are sampled sounds; the rest are synthesised on the fly by the
// touch-tone codec (TDTMFCodec, src/sound/DTMFCodec.cpp) from a score of
// tones, so they take almost no room in the ROM.

soundOff := {
	simpleBeep: @alarmWakeup,
	wakeupBeep: @bootSound,
	plinkBeep: @plinkBeep,
	funBeep: @funBeep,
	// A codec sound frame: the samples are produced by the codec named in
	// codecName from the score in `samples`. dataType 16: 16-bit samples;
	// compressionType 6: the codec-generated kind (no names in constants.tsv);
	// samplingRate in samples a second. The score (tonescore): the header's
	// algorithm says how the tones combine (0 each tone a sine voice, 1 in
	// pairs, 2 and 3 in threes, 4 in fours, the others modulating the first,
	// in 3 and 4 as a chain - frequency modulation), repeats how many times the score plays again;
	// each tone has a frequency (Hz, with a fraction), a peak level, a delay
	// before it starts and attack, decay, hold and release times in
	// milliseconds, and the sustain level.
	bizarreBeep: {
		sndFrameType: 'codec,
		codecName: tDTMFCodec,
		dataType: 16,
		bufferSize: 6400,
		bufferCount: 4,
		compressionType: 6,
		samplingRate: 21600,
		samples: tonescore('samples, {version: 1, algorithm: 3, reserved: 0, repeats: 0}, [tones:
			{
				frequency: 300,
				fraction: 0,
				peak: 10000,
				delay: 0,
				attack: 10,
				decay: 200,
				hold: 1000,
				release: 1000,
				sustain: 32000,
				tail: 0
			},
			{
				frequency: 15,
				fraction: 0,
				peak: 500,
				delay: 0,
				attack: 0,
				decay: 0,
				hold: 100,
				release: 0,
				sustain: 0,
				tail: 0
			},
			{
				frequency: 2,
				fraction: 0,
				peak: 10000,
				delay: 0,
				attack: 0,
				decay: 0,
				hold: 100,
				release: 0,
				sustain: 0,
				tail: 0
			}
		]),
		userName: "Echo" // the sound's name, presumably the one the preferences show
	},
	whackyBeep: {
		sndFrameType: 'codec,
		codecName: tDTMFCodec,
		dataType: 16,
		bufferSize: 6400,
