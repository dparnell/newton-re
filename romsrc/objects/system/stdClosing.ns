// stdClosing, and what only it reaches

stdClosing := {
	viewClass: clEditView,
	viewBounds: nil,
	viewFlags: vVisible,
	viewFormat: 0,
	viewJustify: vjSiblingBottomV,
	viewChildren: nil,
	viewSetupFormScript: func() begin
		self.viewBounds := RelBounds(0, 20, pageWidth, 80);
		viewChildren := nil;
		(if (viewChildren := (if (resolveEntryAlias2 := ResolveEntryAlias(userConfiguration.currentPersona)) then resolveEntryAlias2.owner.signature)) then begin
				least := 9999;
				least2 := 9999;
				local resolveEntryAlias2;
				local least;
				local least2;
				(foreach item in viewChildren do begin
						least := min(least, item.viewBounds.left);
						least2 := min(least2, item.viewBounds.top)
					end);
				(foreach item in viewChildren do begin
						item.viewBounds := OffsetRect(item.viewBounds, (-least), (-least2))
					end)
			end)
	end
};
