// meeting, and what only it reaches

meeting := {
	debug: 78425,
	_proto: cribNoteProto,
	viewBounds: nil,
	target: nil,
	targetView: nil,
	declareSelf: 'meetingview,
	viewSetupFormScript: func() begin
		local kidBound, pos, realData2, l4;
		if (viewBounds = nil) then begin
				if kidBounds then begin
						if (pos := LSearch(dayView.viewChildren, realData, 0, '|=|, nil)) then begin
								kidBound := kidBounds[pos]
							end
					end;
				self.viewBounds := (if kidBound then kidBound else LayoutMeeting(realData, viewHeight, tabWidths, nil))
			end;
		if (realData2 := realData).repeatTemplate then begin
				realData2 := realData2.repeatTemplate
			end;
		if (realData2.version <> 2) then begin
				if EntryStore(realData2):IsReadOnly() then begin
						if realData.viewBounds then begin
								l4 := (realData.mtgStartDate mod 1440);
								self.viewBounds := {left: viewBounds.left, top: TimeToPosition(dayView, l4), right: viewBounds.right, bottom: TimeToPosition(dayView, (l4 + self:GetMeetingSlot(realData, 'mtgDuration)))}
							end
					end else begin
						self:Convert10to20(realData2, nil);
						EntryChangeXmit(realData2, 'calendar);
						if realData.repeatTemplate then begin
								realData := self:MakeInstanceOfRepeatingMeeting(realData2, realData.mtgStartDate)
							end
					end
			end;
		target := self.realData;
		targetView := self;
		inherited:viewSetupFormScript()
	end,
	viewFindTargetScript: func(a1) begin
		(foreach item in a1 do begin
				if SetContains(item.types, 'meeting) then begin
						return dayView
					end
			end);
		self
	end,
	viewDropScript: func(dragInfo, dropPt, a3) begin
		nil
	end,
	SetMeetingBounds: func(a1, a2) begin
		local l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13, l14, l15;
		l1 := self.realData.mtgStartDate;
		l2 := a1;
		l3 := PositionToTime(dayView, l2.top);
		if ((l4 := PositionToTime(dayView, l2.bottom)) <= l3) then begin
				l4 := (l3 + 30)
			end;
		if (if (((l5 := self:GetMeetingSlot(self.realData, 'mtgDuration)) mod 30) = 0) then (((l4 - l3) mod 30) = 15)) then begin
				l4 := (l4 + 15)
			end;
		l4 := min(1440, l4);
		if (if (if (not self:GetMeetingSlot(self.realData, 'viewBounds)) then ((l1 mod 1440) = l3)) then (l5 <> (l4 - l3))) then begin
				l6 := nil
			end else begin
				if (l2.left >= 30) then begin
						l7 := l2.left;
						l6 := {left: l2.left, top: TimeToPosition(dayView, l3), right: DayTable.tabWidths, bottom: TimeToPosition(dayView, l4)}
					end else begin
						l6 := nil
					end
			end;
		l9 := (l8 := self.realData).repeatTemplate;
		if ((l10 := l8.viewStationery) = 'RepeatingMeeting) then begin
				if (if (if l6 then (l6.top = l2.top)) then (l6.bottom = l2.bottom)) then begin
						if (l6.left < 60) then begin
								RemoveSlot(l9, 'viewBounds)
							end else begin
								l9.viewBounds := l6
							end
					end else begin
						l11 := self:MakeNewExceptionFrame(l9, l1, (displaydate + l3), (l4 - l3));
						if l6 then begin
								l11.viewBounds := l6
							end;
						self.realData := l11
					end;
				self:CarefulChange(RepeatSoup, l9, true)
			end else begin
				if (l10 = 'exceptionMeeting) then begin
						if ((l12 := self:searchExceptionList(l9, l8.originDate)) >= 0) then begin
								(l14 := (l13 := l9.exceptions[l12])[1]).mtgStartDate := (displaydate + l3);
								l14.mtgDuration := (l4 - l3);
								l14.viewBounds := l6;
								l14.repeatTemplate := l9;
								self.realData := l14
							end;
						self:UpdateInstanceNotesDataTime(l9, l1, (displaydate + l3));
						self:CarefulChange(RepeatSoup, l9, true)
					end else begin
						if l8.mtgAlarm then begin
								l15 := (l8.mtgStartDate - l8.mtgAlarm);
								l8.mtgAlarm := ((displaydate + l3) - l15)
							end;
						l8.mtgStartDate := (displaydate + l3);
						l8.mtgDuration := (l4 - l3);
						l8.viewBounds := l6;
						self:CarefulChange(MeetingSoup, l8, true)
					end
			end;
		if l6 then begin
				self.viewBounds := l6
			end else begin
				self.viewBounds := LayoutMeeting(self.realData, viewHeight, tabWidths, nil)
			end;
		dayView:ReArrangeMeetings();
		AddUndoAction('SetMeetingBounds, [Array: a2, a1])
	end,
	viewChildren: [viewChildren:
		{
			debug: 2752,
			viewClass: clSliderView,
			viewFlags: vVisible + vClickable,
			viewBounds: {left: 0, top: 0, right: 12, bottom: 0},
			viewJustify: vjParentFullV,
			viewFormat: 0,
			viewRawInkScript: func(a1) begin
				true
			end
		},
		textView
	],
	textView: nil,
	allocateContext: [|Array|: 'textView, textView],
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		realData: nil,
		viewBounds: nil,
		target: nil,
		targetView: nil,
		iconShape: nil,
		meetingview: nil,
		textView: nil
	}
};

textViewViewBounds := {left: 38, top: 0, right: 0, bottom: 0};

textView := {
	debug: 78400,
	viewClass: clParagraphView,
	viewBounds: textViewViewBounds,
	viewFlags: vVisible,
	viewJustify: vjParentFullH + vjParentFullV,
	viewFont: tsHWFont + tsSize(12),
	viewLineSpacing: nil,
	textFlags: 24,
	text: nil,
	unsavedContext: nil,
	viewSetupFormScript: func() begin
		text := self:GetMeetingText(realData);
		self.viewFont := dayView.viewFont;
		(self.viewLineSpacing := dayView.viewLineSpacing)
	end,
	updateAndSave: func(unsavedContext) begin
		local richString, repeatTemplate, soup;
		richString := MakeRichString(unsavedContext.text, unsavedContext.styles);
		self:ChangeMeeting(realData, 'mtgText, richString);
		(if (repeatTemplate := realData.repeatTemplate) then self:CarefulChange((soup := EntrySoup(repeatTemplate)), repeatTemplate, true) else self:CarefulChange(EntrySoup(realData), realData, true))
	end,
	iAmKey: nil,
	viewChangedScript: func(slot, view) begin
		(if (slot = 'text) then begin
				self.unsavedContext := view;
				self:SetupIdle(500)
			end)
	end,
	viewIdleScript: func() begin
		if unsavedContext then begin
				self:updateAndSave(unsavedContext);
				self.unsavedContext := nil
			end;
		nil
	end,
	viewQuitScript: func() begin
		(if unsavedContext then self:viewIdleScript())
	end,
	preallocatedContext: 'textView,
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		text: nil,
		viewFont: tsHWFont + tsSize(12),
		viewLineSpacing: nil,
		viewBounds: textViewViewBounds
	}
};
