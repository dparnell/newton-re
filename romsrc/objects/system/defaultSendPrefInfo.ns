// defaultSendPrefInfo: the proto of protoTransportPrefs' sendPrefs - the "When
// Sending" choice of a transport's preferences: send now, later, or ask each
// time (the noworlater configuration slot; routeActions the matching actions).

defaultSendPrefInfo := {
	routeText: "When Sending",
	routeChoices: [|Array|: "Send now", "Send later", "Specify when"],
	routeVerb: send,
	routeConfig: 'noworlater,
	routeActions: [|Array|: 'Now, 'Later, nil],
	transport: nil,
	testMethod: 'SendRequest
};
