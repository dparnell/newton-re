// The topic markers (the bullets of a list) protoListView draws. A 1-bit bitmap frame
// (bits, bounds), 42 x 12 pixels. Magic pointer @766. Used by protoListView.

topicMarkers := {
	bits: bitmap('bits, "resources/bits/3db2a9.png", "00000000000800f400f4010801000132", 1),
	bounds: {left: 0, top: 0, right: 42, bottom: 12}
};
