// The small pen tip of the pen-size menu. A 1-bit bitmap frame (bits, bounds), 3 x 3
// pixels. Magic pointer @708. Used by protoPensizeMenu.

smallpentip := {
	bits: bitmap('bits, "resources/bits/3d6379.png", "000000000004001f001f02180022021b", 1),
	bounds: {left: 0, top: 0, right: 3, bottom: 3}
};
