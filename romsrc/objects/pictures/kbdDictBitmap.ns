// The dictionary key of the keyboard. A 1-bit bitmap frame (bits, bounds) with a mask, 19 x
// 15 pixels. Magic pointer @751. Used by viewRoot.

kbdDictBitmap := {
	mask: bitmap('mask, "resources/mask/3d7785.png", "000000000004024f024f010d025e0120", 1),
	bits: bitmap('bits, "resources/bits/3d77dd.png", "000000000004024f024f010d025e0120", 1),
	bounds: {left: 0, top: 0, right: 19, bottom: 15}
};
