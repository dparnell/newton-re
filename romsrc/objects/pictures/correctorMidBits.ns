// The middle-punctuation picker of the character editor (protoCharEdit). A picker image:
// bits and bounds, a grid of width x height cells, and the text each cell enters (words).
// Magic pointer @798. Used by protoCharEdit.

correctorMidBits := {
	bits: midpunctBitmapBits,
	bounds: midpunctBitmapBounds,
	width: 2,
	height: 2,
	words: [|Array|: minusPrefix, correctorMidBitsItem, decimalpoint, correctorleadBitsItem_2]
};
