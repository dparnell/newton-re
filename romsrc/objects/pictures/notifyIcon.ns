// notifyIcon, and what only it reaches

notifyIcon := {
	KillAction: func(a1) begin
		SetRemove(messageList, a1);
		(if (Length(messageList) = 0) then AddDeferredSend(self, 'Close, nil))
	end,
	blinkDelay: nil,
	viewFlags: vReadOnly + vFloating + vClickable,
	viewIdleScript: func() begin
		local count;
		count := Length(blinkList);
		SetValue(self, 'icon, blinkList[(blinkCount mod count)]);
		(if (blinkCount < (blinkReps * count)) then begin
				blinkCount := (blinkCount + 1);
				blinkRate
			end else begin
				blinkCount := 0;
				(blinkDelay := min((blinkDelay * 2), maxDelay))
			end)
	end,
	blinkCount: nil,
	viewBounds: {left: 0, top: -1, right: 15, bottom: 13},
	blinkReps: 4,
	poppedView: nil,
	viewJustify: vjCenterH + vjCenterV + vjParentCenterH,
	icon: @filledStarBitmap,
	ExecMessage: func(index) begin
		local messageListItem;
		messageListItem := messageList[index];
		RemoveSlot(messageList, index);
		if (Length(messageList) = 0) then begin
				AddDeferredSend(self, 'Close, nil)
			end;
		(if (ClassOf(messageListItem) = 'NotifyAction) then Apply(messageListItem.fn, messageListItem.args) else notification:ShowItem(messageListItem, nil))
	end,
	StartBlinking: func() begin
		SetValue(self, 'icon, blinkList[0]);
		blinkCount := 1;
		blinkDelay := minDelay;
		self:SetupIdle(blinkRate)
	end,
	pickCancelledScript: func() begin
		poppedView := nil;
		self:hilite(nil)
	end,
	minDelay: 5000,
	blinkList: [|Array|: @filledStarBitmap, @hollowstarBitmap],
	AddMessage: func(frame2) begin
		if (if poppedView then (poppedView = GetPopup())) then begin
				poppedView:Close();
				poppedView := nil
			end;
		if (not messageList) then begin
				messageList := [Array: ]
			end;
		ArrayInsert(messageList, frame2, 0);
		AddDeferredSend(self, func() begin
			self:Open();
			self:StartBlinking()
		end, nil);
		frame2
	end,
	viewClickScript: func(unit) begin
		(if self:TrackHilite(unit) then (if ((not messageList) or (Length(messageList) = 0)) then begin
					self:hilite(nil);
					AddDeferredSend(self, 'Close, nil)
				end else (if (if (Length(messageList) = 1) then (ClassOf(messageList[0]) <> 'NotifyAction)) then begin
						self:hilite(nil);
						AddDeferredSend(self, 'Close, nil);
						self:ExecMessage(0)
					end else begin
						local l1;
						l1 := (foreach item in messageList collect item.overview);
						(poppedView := self:PopupMenu(l1, nil))
					end)))
	end,
	pickActionScript: func(index) begin
		poppedView := nil;
		self:hilite(nil);
		self:ExecMessage(index)
	end,
	messageList: nil,
	viewClass: clPictureView,
	blinkRate: 500,
	AddAction: func(text, a2, list) begin
		self:AddMessage({class: 'NotifyAction, fn: a2, args: list, overview: text})
	end,
	maxDelay: 300000,
	preallocatedContext: 'notifyIcon,
	ReOrientToScreen: @defRotateFunc,
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		messageList: nil,
		viewclipper: nil,
		viewFlags: vReadOnly + vFloating + vClickable,
		icon: @filledStarBitmap,
		blinkCount: nil,
		blinkDelay: nil,
		poppedView: nil
	}
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

AddMessage_code := same("notifyIcon.AddMessage.literals[6].instructions");
