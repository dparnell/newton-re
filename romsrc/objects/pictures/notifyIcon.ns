// notifyIcon, and what only it reaches

notifyIcon := {
	KillAction: func(a1) begin
		SetRemove(messageList, a1);
		(if (Length(messageList) = 0) then AddDeferredSend(self, 'Close, nil))
	end,
	blinkDelay: nil,
	viewFlags: vReadOnly + vFloating + vClickable,
	viewIdleScript: func() begin
		local l1;
		l1 := Length(blinkList);
		SetValue(self, 'icon, blinkList[(blinkCount mod l1)]);
		(if (blinkCount < (blinkReps * l1)) then begin
				blinkCount := (blinkCount + 1);
				blinkRate
			end else begin
				blinkCount := 0;
				(blinkDelay := min((blinkDelay * 2), maxDelay))
			end)
	end,
	blinkCount: nil,
	viewBounds: {left: 0, top: -1, right: 15, bottom: 13},
	blinkReps: 4,
	poppedView: nil,
	viewJustify: vjCenterH + vjCenterV + vjParentCenterH,
	icon: @filledStarBitmap,
	ExecMessage: func(a1) begin
		local l1;
		l1 := messageList[a1];
		RemoveSlot(messageList, a1);
		if (Length(messageList) = 0) then begin
				AddDeferredSend(self, 'Close, nil)
			end;
		(if (ClassOf(l1) = 'NotifyAction) then Apply(l1.fn, l1.args) else notification:ShowItem(l1, nil))
	end,
	StartBlinking: func() begin
		SetValue(self, 'icon, blinkList[0]);
		blinkCount := 1;
		blinkDelay := minDelay;
		self:SetupIdle(blinkRate)
	end,
	pickCancelledScript: func() begin
		poppedView := nil;
		self:hilite(nil)
	end,
	minDelay: 5000,
	blinkList: [|Array|: @filledStarBitmap, @hollowstarBitmap],
	AddMessage: func(a1) begin
		if (if poppedView then (poppedView = GetPopup())) then begin
				poppedView:Close();
				poppedView := nil
			end;
		if (not messageList) then begin
				messageList := [Array: ]
			end;
		ArrayInsert(messageList, a1, 0);
		AddDeferredSend(self, func() begin
			self:Open();
			self:StartBlinking()
		end, nil);
		a1
	end,
	viewClickScript: func(a1) begin
		(if self:TrackHilite(a1) then (if ((not messageList) or (Length(messageList) = 0)) then begin
					self:hilite(nil);
					AddDeferredSend(self, 'Close, nil)
				end else (if (if (Length(messageList) = 1) then (ClassOf(messageList[0]) <> 'NotifyAction)) then begin
						self:hilite(nil);
						AddDeferredSend(self, 'Close, nil);
						self:ExecMessage(0)
					end else begin
						local l1;
						l1 := (foreach l2 in messageList collect l2.overview);
						(poppedView := self:PopupMenu(l1, nil))
					end)))
	end,
	pickActionScript: func(a1) begin
		poppedView := nil;
		self:hilite(nil);
		self:ExecMessage(a1)
	end,
	messageList: nil,
	viewClass: clPictureView,
	blinkRate: 500,
	AddAction: func(a1, a2, a3) begin
		self:AddMessage({class: 'NotifyAction, fn: a2, args: a3, overview: a1})
	end,
	maxDelay: 300000,
	preallocatedContext: 'notifyIcon,
	ReOrientToScreen: @defRotateFunc,
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		messageList: nil,
		viewclipper: nil,
		viewFlags: vReadOnly + vFloating + vClickable,
		icon: @filledStarBitmap,
		blinkCount: nil,
		blinkDelay: nil,
		poppedView: nil
	}
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

AddMessage_code := same("notifyIcon.AddMessage.literals[6].instructions");
