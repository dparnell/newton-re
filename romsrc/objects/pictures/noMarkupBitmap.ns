// The "markup" toggle's icon, off. A 1-bit bitmap frame (bits, bounds) with a mask, 17 x 17
// pixels. Magic pointer @343. Used by copperfield.

noMarkupBitmap := {
	mask: onWithMask,
	bits: bitmap('bits, "resources/bits/3d6675.png", "0000000000040058005800a2006900b3", 1),
	bounds: {left: 0, top: 0, right: 17, bottom: 17}
};
