// The N/S toggle of the latitude picker. A 1-bit bitmap frame (bits, bounds), 30 x 18
// pixels. Magic pointer @689. Used by protoLatitudePicker.

northSouthBitmap := {
	bits: bitmap('bits, "resources/bits/3da985.png", "00000000000400de00de014200f00160", 1),
	bounds: {left: 0, top: 0, right: 30, bottom: 18}
};
