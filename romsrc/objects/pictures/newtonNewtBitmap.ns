// The Newton figure (Sir Isaac Newton under the apple tree). A 1-bit bitmap frame (bits,
// bounds), 79 x 39 pixels. Magic pointer @778. Used by copperfield.

newtonNewtBitmap := {
	bits: bitmap('bits, "resources/bits/3db5a9.png", "00000000000c008e008e002700b50076", 1),
	bounds: {left: 0, top: 0, right: 79, bottom: 39}
};
