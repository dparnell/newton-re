// The leading-punctuation picker of the character editor (protoCharEdit). A picker image:
// bits and bounds, a grid of width x height cells, and the text each cell enters (words).
// Magic pointer @797. Used by protoCharEdit.

correctorleadBits := {
	bits: leadingpunctBitmapBits,
	bounds: leadingpunctBitmapBounds,
	width: 3,
	height: 1,
	words: [|Array|: correctorleadBitsItem_2, correctorleadBitsItem_3, correctorleadBitsItem]
};
