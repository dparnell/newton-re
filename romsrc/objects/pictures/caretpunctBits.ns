// The caret's punctuation picker, the grid of punctuation marks the caret pops up. A picker
// image: bits and bounds, a grid of width x height cells, and the text each cell enters
// (words). Magic pointer @802. Used by data, viewRoot.

caretpunctBits := {
	bits: caretpunctBitmapBits,
	bounds: caretpunctBitmapBounds,
	width: 2,
	height: 8,
	words: [|Array|:
		caretpunctBitsItem_2,
		"\u0008",
		decimalpoint,
		groupSepStr_2,
		correctortrailBitsItem,
		correctortrailBitsItem_2,
		timeSepStr1,
		salutationSuffixItem,
		correctorleadBitsItem_2,
		correctorleadBitsItem_3,
		correctorleadBitsItem,
		correctortrailBitsItem_3,
		correctorMidBitsItem,
		minusPrefix,
		caretpunctBitsItem,
		currentZone
	]
};

caretpunctBitsItem := "•";

caretpunctBitsItem_2 := "\u000d";
