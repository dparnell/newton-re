// The square root key of the Calculator. A 1-bit bitmap frame (bits, bounds), 12 x 9
// pixels. Magic pointer @743. Used by calculator.

keyradicalBitmap := {
	bits: bitmap('bits, "resources/bits/3d91d5.png", "0000000000040175017501c9017e01d5", 1),
	bounds: {left: 0, top: 0, right: 12, bottom: 9}
};
