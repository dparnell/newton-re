// The right-arrow key of the keyboards. A 1-bit bitmap frame (bits, bounds), 11 x 6 pixels.
// Magic pointer @750. Used by alphaKeys, frames, numericKeys, phonePad, viewRoot.

kbdRightBitmap := {
	bits: bitmap('bits, "resources/bits/3d7735.png", "00000000000400c700c700d400cd00df", 1),
	bounds: {left: 0, top: 0, right: 11, bottom: 6}
};
