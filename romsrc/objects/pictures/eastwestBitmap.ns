// The E/W toggle of the longitude picker. A 1-bit bitmap frame (bits, bounds), 30 x 18
// pixels. Magic pointer @690. Used by protoLongitudePicker.

eastwestBitmap := {
	bits: bitmap('bits, "resources/bits/3daa05.png", "00000000000400de00de016f00f0018d", 1),
	bounds: {left: 0, top: 0, right: 30, bottom: 18}
};
