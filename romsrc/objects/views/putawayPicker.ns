// putawayPicker, and what only it reaches

putawayPicker := {
	viewBounds: {left: 0, top: 0, right: 200, bottom: 85},
	viewJustify: vjParentCenterH + vjParentCenterV,
	theApps: nil,
	theItem: nil,
	theAppToRun: nil,
	labels: nil,
	viewSetupFormScript: func() begin
		SetKeyView(self, 0);
		inherited:?viewSetupFormScript()
	end,
	viewChildren: [viewChildren:
		{
			buttonClickScript: func() begin
				(if GetRoot().iobox.viewCObject then AddDeferredSend(GetRoot().iobox, 'RememberedClose, [Array: base]) else base:Close())
			end,
			_proto: @protoCancelButton
		},
		_defaultButton_11,
		{
			viewBounds: {left: 10, top: 22, right: 10, bottom: 38},
			viewJustify: 8388608,
			text: nil,
			viewSetupFormScript: func() begin
				if TargetIsCursor(theItem) then begin
						text := "Put away all selected items"
					end else begin
						text := "Put Away item to:"
					end;
				((viewBounds := Clone(viewBounds)).right := (viewBounds.left + StrFontWidth(text, viewFont)))
			end,
			_proto: @protoStaticText
		},
		{
			viewBounds: {left: 0, top: 21, right: 0, bottom: 37},
			viewFormat: 0,
			viewJustify: vjCenterH + vjParentFullH + vjSiblingRightH,
			text: nil,
			showit: nil,
			viewSetupFormScript: func() begin
				showit := nil;
				if TargetIsCursor(theItem) then begin
						text := ""
					end else begin
						text := (if IsFrame(theAppToRun) then theAppToRun.appName else GetAppName(theAppToRun))
					end;
				popup := Array((l1 := (if theApps then Length(theApps) else 0)), nil);
				if theApps then begin
						local l1;
						(foreach key, value in theApps do begin
								local fontHeight2;
								popup[key] := (if IsFrame(value) then value.appName else GetAppName(value))
							end)
					end;
				if (showit := (l1 > 1)) then begin
						text := Stringer([Array: $\uFC01, text])
					end;
				fontHeight2 := FontHeight(viewFont);
				viewBounds := RelBounds(viewBounds.left, viewBounds.top, viewBounds.right, fontHeight2);
				inherited:?viewSetupFormScript()
			end,
			PadText: func(text) begin
				text
			end,
			viewDrawScript: func() begin
				nil
			end,
			viewClickScript: func(unit) begin
				(if showit then inherited:viewClickScript(unit))
			end,
			pickActionScript: func(index) begin
				theAppToRun := theApps[index];
				inherited:pickActionScript(index)
			end,
			_proto: @protoPopInPlace
		},
		{
			viewJustify: vjCenterV + vjParentFullH + vjSiblingBottomV,
			viewBounds: {left: 10, top: 6, right: 10, bottom: 22},
			text: "Delete from inbox",
			viewSetupFormScript: func() begin
				(viewValue := GetRoot().iobox.deleteAfterPutaway)
			end,
			valueChanged: func() begin
				(GetRoot().iobox.deleteAfterPutaway := viewValue)
			end,
			_proto: @protoCheckbox
		},
		{title: putAway, _proto: @protoTitle}
	],
	_defaultButton: nil,
	allocateContext: [|Array|: '_defaultButton, _defaultButton_11],
	ReOrientToScreen: @defRotateFunc,
	_proto: @protoFloater
};

_defaultButton_11 := {
	viewBounds: {left: -63, top: 0, right: -7, bottom: 13},
	viewJustify: 8407046,
	text: putAway,
	buttonClickScript: func() begin
		local putAway;
		putAway := GetRoot().iobox:DoPutAway((if IsFrame(theAppToRun) then theAppToRun.appSymbol else theAppToRun), theItem, targetView);
		AddDeferredSend(GetRoot().iobox.pap, 'Close, nil)
	end,
	preallocatedContext: '_defaultButton,
	_proto: @protoTextButton
};

putAway := "Put Away";
