// usTimeFilter, and what only it reaches

usTimeFilter := {
	item: time,
	|string|: "        ",
	format: format,
	filters: [|Array|: digits, usStdDateFilterItem, "012", "012345", "aApP"],
	SetupString: func(currentWord) begin
		local stringToTime2;
		if (not (stringToTime2 := StringToTime(currentWord))) then begin
				stringToTime2 := Time()
			end;
		if ((currentWord := HourMinute(stringToTime2))[1] = $:) then begin
				StrMunger(currentWord, 0, 0, "0", 0, 1)
			end;
		return currentWord
	end,
	CleanupString: func(currentWord) begin
		local stringToTime2;
		(currentWord := (if (stringToTime2 := StringToTime(currentWord)) then HourMinute(stringToTime2) else ""))
	end
};
