_defaultButton_4 := {
	buttonClickScript: func() begin
		if (notifyOnClose exists) then begin
				notifyOnClose:ChooserDone(currentSelection, currentSelection, 'serialSym)
			end;
		base:Close()
	end,
	preallocatedContext: '_defaultButton,
	_proto: @protoCancelButton
};

serialPrinterList := {
	viewJustify: vjCenterH,
	viewBounds: {left: 10, top: 25, right: 170, bottom: 25},
	useScrollers: true,
	viewLines: 7,
	ListItems: nil,
	PowerOffScript: func(a1) begin
		(if (a1 = 'okToPowerOff) then true else (if (a1 = 'PowerOff) then base:Close()))
	end,
	viewSetupFormScript: func() begin
		AddPowerOffHandler(self);
		ListItems := [Array: ];
		(foreach l1 in AvailablePrinters do begin
				if (l1.type = 'serialSym) then begin
						AddArraySlot(ListItems, l1.name)
					end
			end);
		self:SetupList();
		(if (if (currentSelection <> nil) then (not StrEqual(currentSelection, ""))) then begin
				Selection := (temp := FindStringInArray(ListItems, currentSelection));
				self:HiliteLine(temp)
			end)
	end,
	buttonClickScript: func(a1) begin
		(currentSelection := ListItems[a1])
	end,
	viewQuitScript: func() begin
		RemovePowerOffHandler(self)
	end,
	preallocatedContext: 'serialPrinterList,
	_proto: @protoTextList
};

