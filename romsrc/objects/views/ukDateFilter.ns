// ukDateFilter: the UK locale's date template for the protoCharEdit
// corrector (GetLocale().dateFilter): the fixed dd/mm/yy comb
// (ukstdDateFilter) or any format (usDefaultDateFilter).

ukDateFilter := {
	item: "ukDateFilter",
	templateArray: [|Array|: @ukstdDateFilter, @usDefaultDateFilter],
	// Starts on the format the word is in.
	Init: func(currentWord) begin
		local parse;
		self:SetTemplate((parse := self:Parse(currentWord)))
	end,
	// The fixed format if currentWord is empty or is exactly a short date the
	// system reads back the same; else any format.
	Parse: func(currentWord) begin
		local l1, stringToDate2, shortDateStr2;
		l1 := @usDefaultDateFilter;
		if (stringToDate2 := StringToDate(currentWord)) then begin
				shortDateStr2 := ShortDateStr(stringToDate2, 0)
			end;
		if ((if (if currentWord then shortDateStr2) then StrEqual(currentWord, shortDateStr2)) or (StrLen(currentWord) = 0)) then begin
				l1 := @ukstdDateFilter
			end;
		return l1
	end,
	// The user chose format index: the fixed one only if the word fits it.
	switch: func(index, wordForDisplay) begin
		local templateArrayItem;
		if (if ((templateArrayItem := templateArray[index]) = @ukstdDateFilter) then (self:Parse(wordForDisplay) <> @ukstdDateFilter)) then begin
				self:Notify(kNotifyAlert, "Corrector", "Sorry, unable to switch to the requested format");
				return nil
			end;
		self:SetTemplate(templateArray[index])
	end,
	// SetupString, CleanupString: the current format's, if it has them.
	SetupString: func(currentWord) begin
		(if HasPath(curTemplate, 'SetupString) then curTemplate:SetupString(currentWord) else currentWord)
	end,
	// The template's CleanupString, if it has one.
	CleanupString: func(currentWord) begin
		(if HasPath(curTemplate, 'CleanupString) then curTemplate:CleanupString(currentWord) else currentWord)
	end,
	// Makes a format current, copying its comb slots.
	SetTemplate: func(templateArrayItem) begin
		self.format := templateArrayItem.format;
		self.string := templateArrayItem.string;
		self.filters := templateArrayItem.filters;
		self.bias := templateArrayItem.bias;
		self.offsets := templateArrayItem.offsets;
		(self.curTemplate := templateArrayItem)
	end
};
