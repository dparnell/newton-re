// usStdDateFilter, and what only it reaches

usStdDateFilter := {
	item: "mm/dd/yy",
	format: "10_20_00",
	|string|: string,
	filters: [|Array|: digits, usStdDateFilterItem, "0123"],
	offsets: [|Array|: 0, 3, 6],
	SetupString: func(a1) begin
		local l1, l2;
		l1 := Clone("  /  /  ");
		StrReplace(a1, " ", "", nil);
		if (if (if (l2 := StringToDateFrame(a1)) then (l2.status >= 0)) then ((l2.month or l2.Date) or l2.year)) then begin
				DateMunger(l1, l2.month, offsets[0]);
				DateMunger(l1, l2.Date, offsets[1]);
				if (l2.year < 2920) then begin
						DateMunger(l1, l2.year, offsets[2])
					end
			end;
		return l1
	end,
	CleanupString: func(a1) begin
		if (a1[3] = $0) then begin
				a1[3] := $ ;
				if (a1[3] = $0) then begin
						a1[3] := $ 
					end
			end;
		if (a1[0] = $0) then begin
				a1[0] := $ ;
				if (a1[0] = $0) then begin
						a1[0] := $ 
					end
			end;
		StrReplace(a1, "  /", "", nil);
		StrReplace(a1, "/  ", "", nil);
		return (a1 := StringFilter(a1, " ", 'rejectAll))
	end,
	IsValid: func(a1) begin
		local l1, l2, l3;
		StrReplace((l1 := Clone(a1)), " ", "", nil);
		if (if (l2 := StringToDateFrame(l1)) then (l2.status >= 0)) then begin
				l3 := 0;
				if l2.month then begin
						l3 := (l3 + 1)
					end;
				if l2.Date then begin
						l3 := (l3 + 1)
					end;
				if l2.year then begin
						l3 := (l3 + 1)
					end;
				return (l3 > 1)
			end;
		return nil
	end
};

string := "  /  /  ";
