// usStdDateFilter: the US fixed date format "mm/dd/yy" for the protoCharEdit
// corrector. format gives each cell's filter (an index into filters, "_"
// for a fixed cell); offsets says where in the comb month, day and year go.

usStdDateFilter := {
	item: "mm/dd/yy",
	format: "10_20_00",
	|string|: string,
	filters: [|Array|: digits, usStdDateFilterItem, "0123"],
	offsets: [|Array|: 0, 3, 6],
	// Lays the date currentWord reads as into the comb (a year of kYearMissing,
	// meaning none, is left blank).
	SetupString: func(currentWord) begin
		local copy, stringToDateFrame2;
		copy := Clone("  /  /  ");
		StrReplace(currentWord, " ", "", nil);
		if (if (if (stringToDateFrame2 := StringToDateFrame(currentWord)) then (stringToDateFrame2.status >= 0)) then ((stringToDateFrame2.month or stringToDateFrame2.Date) or stringToDateFrame2.year)) then begin
				DateMunger(copy, stringToDateFrame2.month, offsets[0]);
				DateMunger(copy, stringToDateFrame2.Date, offsets[1]);
				if (stringToDateFrame2.year < kYearMissing) then begin
						DateMunger(copy, stringToDateFrame2.year, offsets[2])
					end
			end;
		return copy
	end,
	// Turns the comb's text back into a date string: leading zeros of the
	// month and day go, as do empty parts and the padding.
	CleanupString: func(currentWord) begin
		if (currentWord[3] = $0) then begin
				currentWord[3] := $ ;
				if (currentWord[3] = $0) then begin
						currentWord[3] := $ 
					end
			end;
		if (currentWord[0] = $0) then begin
				currentWord[0] := $ ;
				if (currentWord[0] = $0) then begin
						currentWord[0] := $ 
					end
			end;
		StrReplace(currentWord, "  /", "", nil);
		StrReplace(currentWord, "/  ", "", nil);
		return (currentWord := StringFilter(currentWord, " ", 'rejectAll))
	end,
	// Whether _proto (the word) reads as a date with at least two of month, day
	// and year.
	IsValid: func(_proto) begin
		local copy, stringToDateFrame2, l3;
		StrReplace((copy := Clone(_proto)), " ", "", nil);
		if (if (stringToDateFrame2 := StringToDateFrame(copy)) then (stringToDateFrame2.status >= 0)) then begin
				l3 := 0;
				if stringToDateFrame2.month then begin
						l3 := (l3 + 1)
					end;
				if stringToDateFrame2.Date then begin
						l3 := (l3 + 1)
					end;
				if stringToDateFrame2.year then begin
						l3 := (l3 + 1)
					end;
				return (l3 > 1)
			end;
		return nil
	end
};

string := "  /  /  ";
