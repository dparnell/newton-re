// worldPicker: a map of the world (or of a continent, zoomer) that the user
// taps to choose a place: it pops up the places of the location soup
// (spots) closest to the tap and calls PickWorld(place) with the one picked.
// countryPicker, statePicker, provincePicker and mapPopup are made from it.

worldPicker := {
	// the most places offered, and how far from the tap (in map units) they may
	// be
	listLimit: 10,
	slot: nil,
	srcRect: srcRect,
	shape: nil,
	mapPict: @worldMapBitmap,
	shift: 0,
	// a continent of continents (or 'srcRect for the srcRect given) to zoom the
	// map to, nil for the whole world
	zoomer: nil,
	viewFlags: vVisible + vClipping + vClickable,
	list: nil,
	viewBounds: nil,
	// shortCircuit: pick at once when only one place is near; autoClose: close
	// the base view after a pick; PickWorld: the method a pick is sent to
	shortCircuit: nil,
	pictRect: srcRect,
	filter: nil,
	autoClose: nil,
	PickWorld: nil,
	continents: @continents,
	spots: @countrySoupName,
	radius: 2000,
	viewClass: clView,
	dstRect: nil,
	worldRect: srcRect,
	// Makes the map shape: the source rectangle (the continent's longitudes and
	// latitudes in map coordinates, wrapped round when it crosses the date line)
	// widened to the view's proportions and scaled to the view.
	viewSetupChildrenScript: func() begin
		local l1, l2, l3, l4, l5, l6, l7, l8, l9, shape2;
		dstRect := self:LocalBox();
		if (if zoomer then ((zoomer = 'srcRect) or continents.(zoomer))) then begin
				if (zoomer <> 'srcRect) then begin
						srcRect := SetBounds(LongitudeToCoordinate((l2 := continents.(zoomer)).leftLongitude, worldRect.right), LatitudeToCoordinate(l2.topLatitude, worldRect.bottom), LongitudeToCoordinate(l2.rightLongitude, worldRect.right), LatitudeToCoordinate(l2.bottomLatitude, worldRect.bottom))
					end;
				if (l1 := (srcRect.right < srcRect.left)) then begin
						srcRect.right := (srcRect.right + worldRect.right)
					end else begin
						srcRect := SectRect(srcRect, pictRect)
					end;
				l3 := (srcRect.right - srcRect.left);
				l4 := (srcRect.bottom - srcRect.top);
				l5 := (dstRect.right - dstRect.left);
				l6 := (dstRect.bottom - dstRect.top);
				l7 := (l3 / l4);
				l8 := (l5 / l6);
				if (l7 > l8) then begin
						l9 := (floor((((l4 * l7) / l8) - l4)) div 2);
						srcRect.top := (srcRect.top - l9);
						srcRect.bottom := (srcRect.bottom + l9)
					end else begin
						l9 := (floor((((l3 * l8) / l7) - l3)) div 2);
						srcRect.left := (srcRect.left - l9);
						srcRect.right := (srcRect.right + l9)
					end;
				l3 := (srcRect.right - srcRect.left);
				l4 := (srcRect.bottom - srcRect.top);
				l7 := (l3 / l4)
			end else begin
				srcRect := GraphicSize(@worldMapBitmap)
			end;
		shape2 := MakeShape(mapPict);
		(shape := OffsetShape(ScaleShape((if l1 then [Array: shape2, OffsetShape(MakeShape(mapPict), worldRect.right, 0)] else shape2), srcRect, dstRect), 0, 0))
	end,
	// A tap: after the pen lifts, finds the places nearest the point in map
	// coordinates (each with its region added) and pops them up (or picks the
	// only one).
	viewClickScript: func(unit) begin
		InkOff(unit);
		playsound(@click);
		box := self:GlobalBox();
		(loop (if StrokeDone(unit) then break));
		least := (GetPoint(4, unit) - box.left);
		least2 := (GetPoint(5, unit) - box.top);
		least := min(max(least, 0), dstRect.right);
		least2 := min(max(least2, 0), dstRect.bottom);
		mapPtX2 := MapPtX(least, dstRect, srcRect);
		mapPtY2 := MapPtY(least2, dstRect, srcRect);
		if ((count := Length((list := ClosestLocations(GetLocationSoup(spots), listLimit, radius, mapPtX2, mapPtY2, (if filter then {width: worldRect.right, height: worldRect.bottom, slot: slot, filter: filter} else {width: worldRect.right, height: worldRect.bottom}))))) > 0) then begin
				local mapPtX2;
				local mapPtY2;
				local box;
				local least;
				local least2;
				local count;
				(foreach item in list do begin
						local region;
						if (region := item.place.region) then begin
								item.item := Stringer([Array: item.item, " ", region])
							end
					end)
			end else begin
				// nothing near: an item with no place, which picks nothing
				AddArraySlot(list, {item: "Middle of Nowhere"})
			end;
		if (if shortCircuit then (count = 1)) then begin
				self:pickActionScript(0)
			end else begin
				DoPopup(list, least, least2, self)
			end;
		true
	end,
	// Draws the map.
	viewDrawScript: func() begin
		self:DrawShape(shape, '{font: tsSystem + tsSize(9) + tsBold, fillPattern: 5, transferMode: 0, penPattern: 0})
	end,
	// A place was picked from the popup: tell PickWorld.
	pickActionScript: func(index) begin
		if list[index].place then begin
				self:?PickWorld(list[index].place)
			end;
		list := nil;
		(if autoClose then base:Close())
	end
};

// the map's coordinates: 360 by 179, a unit a degree
srcRect := {left: 0, top: 0, right: 360, bottom: 179};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewDrawScript_code := same("worldPicker.viewDrawScript.instructions");
