// worldPicker, and what only it reaches

worldPicker := {
	listLimit: 10,
	slot: nil,
	srcRect: srcRect,
	shape: nil,
	mapPict: @worldMapBitmap,
	shift: 0,
	zoomer: nil,
	viewFlags: vVisible + vClipping + vClickable,
	list: nil,
	viewBounds: nil,
	shortCircuit: nil,
	pictRect: srcRect,
	filter: nil,
	autoClose: nil,
	PickWorld: nil,
	continents: @continents,
	spots: @countrySoupName,
	radius: 2000,
	viewClass: clView,
	dstRect: nil,
	worldRect: srcRect,
	viewSetupChildrenScript: func() begin
		local l1, l2, l3, l4, l5, l6, l7, l8, l9, l10;
		dstRect := self:LocalBox();
		if (if zoomer then ((zoomer = 'srcRect) or continents.(zoomer))) then begin
				if (zoomer <> 'srcRect) then begin
						srcRect := SetBounds(LongitudeToCoordinate((l2 := continents.(zoomer)).leftLongitude, worldRect.right), LatitudeToCoordinate(l2.topLatitude, worldRect.bottom), LongitudeToCoordinate(l2.rightLongitude, worldRect.right), LatitudeToCoordinate(l2.bottomLatitude, worldRect.bottom))
					end;
				if (l1 := (srcRect.right < srcRect.left)) then begin
						srcRect.right := (srcRect.right + worldRect.right)
					end else begin
						srcRect := SectRect(srcRect, pictRect)
					end;
				l3 := (srcRect.right - srcRect.left);
				l4 := (srcRect.bottom - srcRect.top);
				l5 := (dstRect.right - dstRect.left);
				l6 := (dstRect.bottom - dstRect.top);
				l7 := (l3 / l4);
				l8 := (l5 / l6);
				if (l7 > l8) then begin
						l9 := (floor((((l4 * l7) / l8) - l4)) div 2);
						srcRect.top := (srcRect.top - l9);
						srcRect.bottom := (srcRect.bottom + l9)
					end else begin
						l9 := (floor((((l3 * l8) / l7) - l3)) div 2);
						srcRect.left := (srcRect.left - l9);
						srcRect.right := (srcRect.right + l9)
					end;
				l3 := (srcRect.right - srcRect.left);
				l4 := (srcRect.bottom - srcRect.top);
				l7 := (l3 / l4)
			end else begin
				srcRect := GraphicSize(@worldMapBitmap)
			end;
		l10 := MakeShape(mapPict);
		(shape := OffsetShape(ScaleShape((if l1 then [Array: l10, OffsetShape(MakeShape(mapPict), worldRect.right, 0)] else l10), srcRect, dstRect), 0, 0))
	end,
	viewClickScript: func(a1) begin
		InkOff(a1);
		playsound(@click);
		l3 := self:GlobalBox();
		(loop (if StrokeDone(a1) then break));
		l4 := (GetPoint(4, a1) - l3.left);
		l5 := (GetPoint(5, a1) - l3.top);
		l4 := min(max(l4, 0), dstRect.right);
		l5 := min(max(l5, 0), dstRect.bottom);
		l1 := MapPtX(l4, dstRect, srcRect);
		l2 := MapPtY(l5, dstRect, srcRect);
		if ((l6 := Length((list := ClosestLocations(GetLocationSoup(spots), listLimit, radius, l1, l2, (if filter then {width: worldRect.right, height: worldRect.bottom, slot: slot, filter: filter} else {width: worldRect.right, height: worldRect.bottom}))))) > 0) then begin
				local l1;
				local l2;
				local l3;
				local l4;
				local l5;
				local l6;
				(foreach l7 in list do begin
						local l9;
						if (l9 := l7.place.region) then begin
								l7.item := Stringer([Array: l7.item, " ", l9])
							end
					end)
			end else begin
				AddArraySlot(list, {item: "Middle of Nowhere"})
			end;
		if (if shortCircuit then (l6 = 1)) then begin
				self:pickActionScript(0)
			end else begin
				DoPopup(list, l4, l5, self)
			end;
		true
	end,
	viewDrawScript: func() begin
		self:DrawShape(shape, '{font: 1057792, fillPattern: 5, transferMode: 0, penPattern: 0})
	end,
	pickActionScript: func(a1) begin
		if list[a1].place then begin
				self:?PickWorld(list[a1].place)
			end;
		list := nil;
		(if autoClose then base:Close())
	end
};

srcRect := {left: 0, top: 0, right: 360, bottom: 179};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewDrawScript_code := same("worldPicker.viewDrawScript.instructions");
