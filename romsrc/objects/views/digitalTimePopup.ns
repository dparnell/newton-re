// digitalTimePopup: protoTimePopup, a pop-up that sets a time on a digital
// clock (protoDigitalClock). Opened by :New(time, increment, bbox, context);
// it tells the context NewTime(time) and pickActionScript(time) when closed.

digitalTimePopup := {
	viewBounds: {left: 0, top: 0, right: 135, bottom: 32},
	New: New,
	// The clock changed: tell the context.
	TimeChanged: func() begin
		context:?NewTime(Time)
	end,
	// The close box: hands the time to the context.
	Affirmative: func() begin
		context:?pickActionScript(Time)
	end,
	stepChildren: [stepChildren:
		{
			viewBounds: {left: 2, top: 2, right: 121, bottom: 30},
			viewFormat: 0,
			// The pop-up's increment.
			viewSetupFormScript: func() begin
				(increment := self:Parent().increment)
			end,
			_proto: @protoDigitalClock
		}
	],
	_proto: @protoGeneralPopup
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

TimeChanged_code := same("digitalTimePopup.TimeChanged.instructions");
