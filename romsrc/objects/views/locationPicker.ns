// locationPicker: the list of places of a location soup (spots: cities,
// countries, states) with A-Z tabs and scroll arrows, used by locationPopup
// and countryLocPicker. When countryAndName is set it lists one country's
// cities (with their regions) and has a button at the top to choose the
// country. The picked entry goes to SetResult; Affirmative hands it (or its
// returnSlot) to context:pickActionScript.

locationPicker := {
	viewClass: clView,
	viewFlags: vVisible + vClickable,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	viewFormat: vfFillWhite + vfRound(8),
	currentCountry: nil,
	// A rounded frame around the picker.
	viewDrawScript: func() begin
		local box;
		box := self:LocalBox();
		self:DrawShape(MakeRoundRect(0, 0, box.right, box.bottom, 8), '{penPattern: 5, pensize: 2, fillPattern: 0})
	end,
	// The scroll arrow keys scroll the list.
	viewScroll2DScript: func(arrowDirection, a2) begin
		(if (arrowDirection = 'up) then cityList:viewScrollUpScript() else (if (arrowDirection = 'down) then cityList:viewScrollDownScript()))
	end,
	// The entry picked.
	SetResult: func(entry) begin
		(result := entry)
	end,
	Affirmative: func() begin
		(if result then context:?pickActionScript((if returnSlot then result.(returnSlot) else result)) else context:?pickCancelledScript())
	end,
	viewChildren: [viewChildren:
		cityList,
		tabs,
		upDown,
		// the country button (shown only when listing a country's cities): it pops up
		// a locationPopup of countries and then shows that country's cities
		{
			viewBounds: {left: 3, top: 3, right: -26, bottom: 18},
			viewJustify: 8388662,
			viewFlags: vVisible + vClickable,
			viewFont: tsSystem + tsSize(10) + tsBold,
			viewFormat: vfFillWhite,
			text: nil,
			viewSetupFormScript: func() begin
				(if countryAndName then (text := Stringer([Array: $\uFC01, GetCountryEntry(currentCountry)[0].name])) else (viewBounds := SetBounds(3, -300, 4, -290)))
			end,
			buttonClickScript: func() begin
				local offsetRect2;
				offsetRect2 := OffsetRect(self:GlobalBox(), 15, 15);
				@locationPopup:New({spots: @countrySoupName, result: 'symbol, default: GetCountryEntry(currentCountry)[0]}, offsetRect2, self);
				self:hilite(nil)
			end,
			// A country was chosen (index2 is its symbol): query its cities, sorted by
			// name and region, and select the first.
			pickActionScript: func(index2) begin
				local locationSoup, copy;
				locationSoup := GetLocationSoup(spots);
				(copy := DeepClone('{type: index, indexPath: [Array: country, name, region]})).beginKey := [Array: index2, "\u0000\u"];
				copy.endKey := [Array: index2, "\u7FFF\u"];
				cityList.cursor := locationSoup:Query(copy);
				currentCountry := index2;
				cityList.hilitedIndex := 0;
				self:SetResult(cityList.cursor:entry());
				cityList:RedoChildren();
				SetValue(self, 'text, Stringer([Array: $\uFC01, GetCountryEntry(index2)[0].name]))
			end,
			_proto: @protoTextButton
		}
	],
	cityList: nil,
	allocateContext: [|Array|: 'cityList, cityList, 'tabs, tabs, 'upDown, upDown],
	tabs: nil,
	upDown: nil
};

// the list of places: a protoSoupOverview on a query of the location soup
cityList := {
	viewFormat: vfFillWhite,
	preallocatedContext: 'cityList,
	viewFlags: vVisible + vApplication + vClickable,
	// One line: the place's name (and its region when countryAndName). While
	// hiliteHack counts the lines being made, the line of the current result is
	// highlighted.
	Abstract: func(items2Item, copy) begin
		if hiliteHack then begin
				if (items2Item = result) then begin
						hilitedIndex := hiliteHack
					end;
				hiliteHack := (hiliteHack + 1)
			end;
		MakeText(Stringer([Array: items2Item.name, (if countryAndName then Stringer([Array: $ , " ", items2Item.region]))]), 2, copy.top, copy.right, (copy.top + 10))
	end,
	viewBounds: {left: 3, top: 3, right: -26, bottom: -2},
	_proto: @protoSoupOverview,
	cursor: nil,
	// Updates the scroll arrows after the lines are made.
	SetupAbstracts: func(copy) begin
		inherited:SetupAbstracts(copy);
		(if Visible(upDown) then upDown:FiddleWithArrows())
	end,
	prevCountry: nil,
	lineHeight: 12,
	nothingCheckable: true,
	viewJustify: vjParentFullH + vjParentFullV,
	checkScrollability: true,
	hiliteHack: nil,
	// Queries the location soup: by country and then name for a country's
	// cities, else by name; goes to initialSpot (an entry or a key) or the
	// user's country.
	viewSetupFormScript: compile(
		constants: {
			kLiteral_435a99: '{type: index, indexPath: [Array: country, name, region]}
		},
		func() begin
			local locationSoup, l2, entry, copy;
			if countryAndName then begin
					viewBounds := SetBounds(3, 20, -26, -2)
				end;
			locationSoup := GetLocationSoup(spots);
			if countryAndName then begin
					l2 := kLiteral_435a99
				end else begin
					if (not StrEqual(spots, @citySoupName)) then begin
							l2 := '{type: index, indexPath: name}
						end else begin
							l2 := '{type: index, indexPath: [Array: name, country, region]}
						end
				end;
			cursor := locationSoup:Query(l2);
			if initialSpot then begin
					if IsFrame(initialSpot) then begin
							cursor:Goto(initialSpot)
						end else begin
							cursor:GotoKey(initialSpot)
						end;
					self:SetResult(cursor:entry());
					hilitedIndex := 0
				end else begin
					if countryAndName then begin
							cursor:GotoKey([Array: userConfiguration.countrySlot])
						end
				end;
			(if countryAndName then begin
					currentCountry := (entry := cursor:entry()).country;
					(copy := DeepClone(kLiteral_435a99)).beginKey := [Array: currentCountry, "\u0000\u"];
					copy.endKey := [Array: currentCountry, "\u7FFF\u"];
					cursor := locationSoup:Query(copy);
					cursor:Goto(entry)
				end)
		end),
	canScrollDown: nil,
	// A tap on line a1 picks its entry.
	HitItem: func(a1, trackScrollingItem, trackScrollingItem2) begin
		(if (a1 >= 0) then self:SetResult(cursor:clone():move(a1)))
	end,
	viewEffect: 165920,
	viewFont: tsSystem + tsSize(10) + tsBold,
	canScrollUp: nil,
	// Makes the lines, highlighting the result, and sets the tabs to the first
	// entry's letter.
	viewSetupChildrenScript: func() begin
		local entry, l2;
		hiliteHack := 0;
		inherited:viewSetupChildrenScript();
		hiliteHack := nil;
		prevCountry := nil;
		tabs:setLetter((l2 := (if (if (entry := cursor:entry()) then StrFilled(entry.name)) then entry.name[0] else $A)), nil)
	end,
	autoDeselect: nil,
	selectIndent: 0
};

// the A-Z tabs at the right: a tap moves the list to that letter (within the
// country when countryAndName)
tabs := {
	viewBounds: {left: -25, top: 0, right: 0, bottom: 137},
	viewJustify: vjParentRightH,
	PickLetterScript: func(part) begin
		cityList.hilitedIndex := nil;
		cityList.cursor:GotoKey((if countryAndName then [Array: currentCountry, part] else part));
		cityList:RedoChildren()
	end,
	preallocatedContext: 'tabs,
	_proto: @azverttabs
};

// the scroll arrows, showing 'more when the list can scroll that way
upDown := {
	viewBounds: {left: -22, top: 3, right: -4, bottom: 35},
	viewJustify: vjParentRightH + vjSiblingBottomV,
	FiddleWithArrows: func() begin
		self:SetArrow('up, (if cityList.canScrollUp then 'more else 'normal));
		self:SetArrow('down, (if cityList.canScrollDown then 'more else 'normal))
	end,
	viewSetupDoneScript: func() begin
		self:FiddleWithArrows();
		inherited:?viewSetupDoneScript()
	end,
	preallocatedContext: 'upDown,
	_proto: @protoUpDownScroller
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewSetupFormScript_literal8_2 := same("cityList.viewSetupFormScript.literals[8]");

viewSetupFormScript_literal5 := same("cityList.viewSetupFormScript.literals[5]");

viewSetupFormScript_literal7_2 := same("cityList.viewSetupFormScript.literals[7]");

viewSetupFormScript_literal25 := same("cityList.viewSetupFormScript.literals[25]");

viewSetupFormScript_literal27 := same("cityList.viewSetupFormScript.literals[27]");
