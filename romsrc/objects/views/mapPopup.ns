// mapPopup, and what only it reaches

mapPopup := {
	viewBounds: {left: 0, top: 0, right: 200, bottom: 100},
	viewJustify: 0,
	result: 'name,
	params: nil,
	New: func(a1, a2, a3) begin
		local init;
		(init := self:Init()).params := a1;
		init.context := a3;
		init:popup(a2)
	end,
	stepChildren: [stepChildren:
		{
			viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
			viewJustify: vjParentFullH + vjParentFullV,
			viewSetupFormScript: func() begin
				(if params then (foreach key, value in params do begin
							self.(key) := value
						end))
			end,
			PickWorld: func(place) begin
				context:?pickActionScript((if result then place.(result) else place))
			end,
			_proto: @worldPicker
		}
	],
	_proto: @protoGeneralPopup
};
