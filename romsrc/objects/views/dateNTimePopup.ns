// dateNTimePopup, and what only it reaches

dateNTimePopup := {
	viewBounds: {left: 0, top: 0, right: 139, bottom: 168},
	selectedDates: nil,
	Time: nil,
	increment: 5,
	New: func(a1, a2, a3, a4) begin
		local l1, l2;
		l1 := self:Init();
		if (not a1) then begin
				a1 := Time()
			end;
		l2 := (a1 + (a2 div 2));
		l1.Time := (l2 - (l2 mod a2));
		l1.selectedDates := [Array: l1.Time];
		l1.increment := a2;
		l1.context := a4;
		l1:popup(a3)
	end,
	viewSetupFormScript: func() begin
		(clock.increment := increment)
	end,
	DateChanged: func(a1) begin
		selectedDates[0] := (Time := (((Time mod 1440) + a1[0]) - (a1[0] mod 1440)));
		context:?NewTime(Time)
	end,
	TimeChanged: func() begin
		selectedDates[0] := Time;
		context:?NewTime(Time)
	end,
	Affirmative: func() begin
		context:?pickActionScript(selectedDates[0])
	end,
	stepChildren: [stepChildren:
		{
			viewBounds: {left: 0, top: 5, right: 135, bottom: 115},
			viewJustify: vjParentCenterH,
			labelFont: @fontSystem9Bold,
			titleFont: @fontSystem12,
			datesFont: @fontSystem12,
			_proto: @protoDatepicker
		},
		clock
	],
	clock: nil,
	stepallocatecontext: [|Array|: 'clock, clock],
	_proto: @protoGeneralPopup
};

clock := {
	viewBounds: {left: 10, top: 125, right: 129, bottom: 153},
	viewFormat: 0,
	preallocatedContext: 'clock,
	_proto: @protoDigitalClock
};
