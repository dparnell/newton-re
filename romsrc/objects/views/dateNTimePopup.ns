// dateNTimePopup: protoDateNTimePopup, a pop-up with a date picker and a
// digital clock. Opened by :New(time, increment, bbox, context): the time is
// rounded to the increment (minutes). It tells the context NewTime(time) as
// it changes and pickActionScript(time) when closed.

dateNTimePopup := {
	viewBounds: {left: 0, top: 0, right: 139, bottom: 168},
	selectedDates: nil,
	Time: nil,
	increment: 5,
	// Opens it at time a1 (now if nil) rounded to the nearest a2 minutes, over
	// box a3, for context a4.
	New: func(a1, a2, a3, a4) begin
		local init, l2;
		init := self:Init();
		if (not a1) then begin
				a1 := Time()
			end;
		l2 := (a1 + (a2 div 2));
		init.Time := (l2 - (l2 mod a2));
		init.selectedDates := [Array: init.Time];
		init.increment := a2;
		init.context := a4;
		init:popup(a3)
	end,
	// The clock steps by the popup's increment.
	viewSetupFormScript: func() begin
		(clock.increment := increment)
	end,
	// A new date keeps the time of day (minutes past midnight, 1440 a day).
	DateChanged: func(selectedDates2) begin
		selectedDates[0] := (Time := (((Time mod 1440) + selectedDates2[0]) - (selectedDates2[0] mod 1440)));
		context:?NewTime(Time)
	end,
	// The clock changed.
	TimeChanged: func() begin
		selectedDates[0] := Time;
		context:?NewTime(Time)
	end,
	// The close box: hands the chosen time to the context.
	Affirmative: func() begin
		context:?pickActionScript(selectedDates[0])
	end,
	stepChildren: [stepChildren:
		{
			viewBounds: {left: 0, top: 5, right: 135, bottom: 115},
			viewJustify: vjParentCenterH,
			labelFont: @fontSystem9Bold,
			titleFont: @fontSystem12,
			datesFont: @fontSystem12,
			_proto: @protoDatepicker
		},
		clock
	],
	clock: nil,
	stepallocatecontext: [|Array|: 'clock, clock],
	_proto: @protoGeneralPopup
};

clock := {
	viewBounds: {left: 10, top: 125, right: 129, bottom: 153},
	viewFormat: 0,
	preallocatedContext: 'clock,
	_proto: @protoDigitalClock
};
