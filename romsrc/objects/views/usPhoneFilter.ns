// usPhoneFilter, and what only it reaches

usPhoneFilter := {
	item: "usPhoneFilter",
	templateArray: [|Array|: @usStdPhoneFilter, @usDefaultPhoneFilter],
	digits: digits,
	Init: func(currentWord) begin
		local parse;
		self:SetTemplate((parse := self:Parse(currentWord)))
	end,
	Parse: func(currentWord) begin
		local l1, len, l3, scanNextWord2, scanWordEnd2, len2, len3, len4;
		l1 := @usDefaultPhoneFilter;
		StrReplace(currentWord, "(", " ", nil);
		StrReplace(currentWord, ")", " ", nil);
		StrReplace(currentWord, "-", " ", nil);
		len := StrLen(currentWord);
		l3 := true;
		if (StrLen(StringFilter(currentWord, Stringer([Array: digits, " "]), 'passAll)) <> len) then begin
				l3 := nil
			end;
		self.code := nil;
		self.num1 := nil;
		self.num2 := nil;
		scanNextWord2 := ScanNextWord(currentWord, 0, len);
		if (if l3 then scanNextWord2) then begin
				scanWordEnd2 := ScanWordEnd(currentWord, scanNextWord2, len);
				code := Substr(currentWord, scanNextWord2, (scanWordEnd2 - scanNextWord2));
				if (scanWordEnd2 < len) then begin
						if (scanNextWord2 := ScanNextWord(currentWord, scanWordEnd2, len)) then begin
								scanWordEnd2 := ScanWordEnd(currentWord, scanNextWord2, len);
								num1 := Substr(currentWord, scanNextWord2, (scanWordEnd2 - scanNextWord2));
								if (scanWordEnd2 < len) then begin
										if (scanNextWord2 := ScanNextWord(currentWord, scanWordEnd2, len)) then begin
												scanWordEnd2 := ScanWordEnd(currentWord, scanNextWord2, len);
												num2 := Substr(currentWord, scanNextWord2, (scanWordEnd2 - scanNextWord2));
												l3 := (not (scanNextWord2 := ScanNextWord(currentWord, scanWordEnd2, len)))
											end
									end
							end
					end
			end;
		if l3 then begin
				if (not num2) then begin
						num2 := num1;
						num1 := code;
						code := nil
					end;
				if (not num2) then begin
						num2 := num1;
						num1 := code;
						code := nil
					end;
				if code then begin
						len2 := StrLen(code)
					end;
				if num1 then begin
						len3 := StrLen(num1)
					end;
				if num2 then begin
						len4 := StrLen(num2)
					end;
				if ((((if code then (len2 > 3)) or (if len3 then (len3 > 3))) or (if (if num2 then (not num1)) then (not code))) or (if len4 then (len4 > 4))) then begin
						l3 := nil
					end
			end;
		if l3 then begin
				l1 := @usStdPhoneFilter
			end;
		return l1
	end,
	switch: func(index, wordForDisplay) begin
		local templateArrayItem;
		if (if ((templateArrayItem := templateArray[index]) = @usStdPhoneFilter) then (self:Parse(wordForDisplay) <> @usStdPhoneFilter)) then begin
				self:Notify(3, "Corrector", "Sorry, unable to switch to the requested format");
				return nil
			end;
		self:SetTemplate(templateArrayItem)
	end,
	SetupString: func(currentWord) begin
		(if HasPath(curTemplate, 'SetupString) then curTemplate:SetupString(self, currentWord) else currentWord)
	end,
	CleanupString: func(currentWord) begin
		(if HasPath(curTemplate, 'CleanupString) then curTemplate:CleanupString(currentWord) else currentWord)
	end,
	SetTemplate: func(templateArrayItem) begin
		self.format := templateArrayItem.format;
		self.string := templateArrayItem.string;
		self.filters := templateArrayItem.filters;
		(self.curTemplate := templateArrayItem)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

SetupString_code_2 := same("usPhoneFilter.SetupString.instructions");

SetTemplate_code_2 := same("usPhoneFilter.SetTemplate.instructions");
