// usPhoneFilter, and what only it reaches

usPhoneFilter := {
	item: "usPhoneFilter",
	templateArray: [|Array|: @usStdPhoneFilter, @usDefaultPhoneFilter],
	digits: digits,
	Init: func(a1) begin
		local l1;
		self:SetTemplate((l1 := self:Parse(a1)))
	end,
	Parse: func(a1) begin
		local l1, l2, l3, l4, l5, l6, l7, l8;
		l1 := @usDefaultPhoneFilter;
		StrReplace(a1, "(", " ", nil);
		StrReplace(a1, ")", " ", nil);
		StrReplace(a1, "-", " ", nil);
		l2 := StrLen(a1);
		l3 := true;
		if (StrLen(StringFilter(a1, Stringer([Array: digits, " "]), 'passAll)) <> l2) then begin
				l3 := nil
			end;
		self.code := nil;
		self.num1 := nil;
		self.num2 := nil;
		l4 := ScanNextWord(a1, 0, l2);
		if (if l3 then l4) then begin
				l5 := ScanWordEnd(a1, l4, l2);
				code := Substr(a1, l4, (l5 - l4));
				if (l5 < l2) then begin
						if (l4 := ScanNextWord(a1, l5, l2)) then begin
								l5 := ScanWordEnd(a1, l4, l2);
								num1 := Substr(a1, l4, (l5 - l4));
								if (l5 < l2) then begin
										if (l4 := ScanNextWord(a1, l5, l2)) then begin
												l5 := ScanWordEnd(a1, l4, l2);
												num2 := Substr(a1, l4, (l5 - l4));
												l3 := (not (l4 := ScanNextWord(a1, l5, l2)))
											end
									end
							end
					end
			end;
		if l3 then begin
				if (not num2) then begin
						num2 := num1;
						num1 := code;
						code := nil
					end;
				if (not num2) then begin
						num2 := num1;
						num1 := code;
						code := nil
					end;
				if code then begin
						l6 := StrLen(code)
					end;
				if num1 then begin
						l7 := StrLen(num1)
					end;
				if num2 then begin
						l8 := StrLen(num2)
					end;
				if ((((if code then (l6 > 3)) or (if l7 then (l7 > 3))) or (if (if num2 then (not num1)) then (not code))) or (if l8 then (l8 > 4))) then begin
						l3 := nil
					end
			end;
		if l3 then begin
				l1 := @usStdPhoneFilter
			end;
		return l1
	end,
	switch: func(a1, a2) begin
		local l1;
		if (if ((l1 := templateArray[a1]) = @usStdPhoneFilter) then (self:Parse(a2) <> @usStdPhoneFilter)) then begin
				self:Notify(3, "Corrector", "Sorry, unable to switch to the requested format");
				return nil
			end;
		self:SetTemplate(l1)
	end,
	SetupString: func(a1) begin
		(if HasPath(curTemplate, 'SetupString) then curTemplate:SetupString(self, a1) else a1)
	end,
	CleanupString: func(a1) begin
		(if HasPath(curTemplate, 'CleanupString) then curTemplate:CleanupString(a1) else a1)
	end,
	SetTemplate: func(a1) begin
		self.format := a1.format;
		self.string := a1.string;
		self.filters := a1.filters;
		(self.curTemplate := a1)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

SetupString_code_2 := same("usPhoneFilter.SetupString.instructions");

