// The plunk sound. A 'codec sound frame whose samples the tIMACodec codec decompresses (IMA
// ADPCM) when it is played. Magic pointer @313. Used by mailSlip.

plunk := {
	sndFrameType: 'codec,
	samplingRate: samplingRate_2,
	codecName: tIMACodec,
	dataType: 16,
	bufferSize: 10240,
	bufferCount: 4,
	compressionType: 6,
	compressionRatio: compressionRatio,
	samples: imasound('samples, "resources/samples/3ceb19.wav")
};
