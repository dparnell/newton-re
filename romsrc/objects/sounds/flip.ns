// The page-flip sound. A 'codec sound frame whose samples the tIMACodec codec decompresses
// (IMA ADPCM) when it is played. Magic pointer @85. Used by cardfile, copperfield,
// export43, export55, ioItemLayout, newTrollLayout and others.

flip := {
	sndFrameType: 'codec,
	samplingRate: samplingRate_2,
	codecName: tIMACodec,
	dataType: 16,
	bufferSize: 10240,
	bufferCount: 4,
	compressionType: 6,
	compressionRatio: compressionRatio,
	samples: imasound('samples, "resources/samples/3d149d.wav")
};
