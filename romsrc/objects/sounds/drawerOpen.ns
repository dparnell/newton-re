// The sound of a drawer opening. A 'codec sound frame whose samples the tIMACodec codec
// decompresses (IMA ADPCM) when it is played. Magic pointer @77. Used by calendar,
// cardfile, globalHeapvarwannabes, protoDrawer.

drawerOpen := {
	sndFrameType: 'codec,
	samplingRate: samplingRate_2,
	codecName: tIMACodec,
	dataType: 16,
	bufferSize: 10240,
	bufferCount: 4,
	compressionType: 6,
	compressionRatio: compressionRatio,
	samples: imasound('samples, "resources/samples/3cd49d.wav")
};
