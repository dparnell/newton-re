// The adding-machine sound the Calculator plays. A 'codec sound frame whose samples the
// tIMACodec codec decompresses (IMA ADPCM) when it is played. Magic pointer @372. Used by
// calculator, globalHeapvarwannabes.

addingMachine := {
	sndFrameType: 'codec,
	samplingRate: samplingRate_2,
	codecName: tIMACodec,
	dataType: 16,
	bufferSize: 10240,
	bufferCount: 4,
	compressionType: 6,
	compressionRatio: compressionRatio,
	samples: imasound('samples, "resources/samples/3d1bf9.wav")
};
