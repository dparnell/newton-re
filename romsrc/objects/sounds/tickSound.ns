// The tick of a clock. A 'codec sound frame whose samples the tIMACodec codec decompresses
// (IMA ADPCM) when it is played. Magic pointer @299. Used by protoDisplayClock,
// protoNewSetClock, viewRoot.

tickSound := {
	sndFrameType: 'codec,
	samplingRate: samplingRate_2,
	codecName: tIMACodec,
	dataType: 16,
	bufferSize: 10240,
	bufferCount: 4,
	compressionType: 6,
	compressionRatio: compressionRatio,
	samples: imasound('samples, "resources/samples/3d4059.wav")
};
