// recorderEngine, and what only it reaches

recorderEngine := {
	fSoundChannel: nil,
	fSoundArray: nil,
	fCallBack: nil,
	fCompletionCount: 0,
	fSoundState: 1,
	fEngineError: 0,
	fPauseResult: nil,
	fSetLengthInProgress: nil,
	fSoundFrameSlots: nil,
	fRecordQuality: nil,
	fInputGain: nil,
	fInputDevice: nil,
	fOutputDevice: nil,
	fTrimAmount: nil,
	fDirection: 'record,
	fStore: nil,
	fQualitySettings: {
		defaults: {sndFrameType: 'simpleSound, samplingRate: 10800, compressionType: 1, dataType: 8},
		GSM8K16Codec: {
			sndFrameType: 'codec,
			codecName: "TGSMCodec",
			bufferSize: 6400,
			bufferCount: 4,
			samplingRate: 8000,
			compressionType: 6,
			compressionRatio: real('|Real|, 4.848484848484849),
			dataType: 16
		},
		IMA8K16Codec: {
			sndFrameType: 'codec,
			codecName: tIMACodec,
			bufferSize: 10240,
			bufferCount: 4,
			samplingRate: 8000,
			compressionType: 6,
			compressionRatio: compressionRatio,
			dataType: 16
		},
		IMA10K16Codec: {
			sndFrameType: 'codec,
			codecName: tIMACodec,
			bufferSize: 10240,
			bufferCount: 4,
			samplingRate: 10800,
			compressionType: 6,
			compressionRatio: compressionRatio,
			dataType: 16
		}
	},
	FastForward: func() begin
		nil
	end,
	pause: func() begin
		local l1;
		fPauseResult := nil;
		try begin
				if (not self:TestState(1)) then begin
						if self:TestState(2) then begin
								l1 := 16
							end else begin
								if self:TestState(4) then begin
										l1 := 8
									end else begin
										if self:TestState(16) then begin
												l1 := 2
											end else begin
												if self:TestState(8) then begin
														l1 := 4
													end
											end
									end
							end;
						if l1 then begin
								fPauseResult := fSoundChannel:pause();
								self:SetState(l1)
							end
					end
			end onexception |evt.ex| do begin
				self:CleanUpAfterError()
			end;
		return fPauseResult
	end,
	SetRecordingQuality: func() begin
		fSoundFrameSlots := Clone(fQualitySettings.defaults);
		if (not (l1 := fRecordQuality)) then begin
				l1 := GetUserConfig('recordingQuality)
			end;
		if (not l1) then begin
				l1 := (if (Gestalt(16777219).cputype = 'strongarm) then 'GSM8K16Codec else 'IMA8K16Codec)
			end;
		local l1;
		local l2;
		(if (l2 := fQualitySettings.(l1)) then (foreach l3, l4 in l2 do begin
					fSoundFrameSlots.(l3) := l4
				end))
	end,
	DoRecord: func() begin
		local l1;
		fEngineError := 0;
		fCompletionCount := 0;
		self:SetState(2);
		try begin
				if fSoundChannel:isPaused() then begin
						fSoundChannel:pause();
						l1 := true
					end else begin
						self:SetRecordingQuality();
						fCompletionCount := 0;
						fSoundArray := [Array: ];
						fSoundChannel:Close();
						(fSoundChannel := @protoSoundChannel:newRecording()).inputDevice := fInputDevice;
						fSoundChannel.outputDevice := fOutputDevice;
						fSoundChannel.inputGain := fInputGain;
						fSoundChannel:Open();
						if (if (self:TestStore() = 0) then self:ScheduleInputBlock()) then begin
								fSoundChannel:start(true);
								if (self:TestStore() = 0) then begin
										AddDeferredSend(self, 'ScheduleInputBlock, nil)
									end;
								l1 := true
							end
					end
			end onexception |evt.ex| do begin
				self:CleanUpAfterError()
			end;
		if (not l1) then begin
				self:SetState(32);
				self:SetState(1)
			end;
		l1
	end,
	TestStore: func() begin
		local l1, l2, l3;
		if (if (l1 := self:GetStore()) then l1:IsReadOnly()) then begin
				return 3
			end;
		l2 := (l1:TotalSize() - l1:UsedSize());
		(if ((l3 := (fSoundChannel.inputBlockSize * 2.5)) < l2) then 0 else 1)
	end,
	RecordCompletion: func(a1, a2) begin
		if (if (a2 <> 0) then (a2 <> -30011)) then begin
				fEngineError := 2;
				return nil
			end;
		(if self:TestState(2) then (if ((fCompletionCount := (fCompletionCount + 1)) >= Length(fSoundArray)) then begin
					if (fEngineError = 0) then begin
							fEngineError := 2
						end;
					if fSoundChannel:isActive() then begin
							fSoundChannel:stop()
						end;
					self:SetState(32);
					self:SetState(1)
				end else (if (self:TestStore() = 0) then self:ScheduleInputBlock() else (fEngineError := self:TestStore()))))
	end,
	record: func() begin
		(if (if fSetLengthInProgress then (fSetLengthInProgress <> 'doItNow)) then (fSetLengthInProgress := 'record) else self:DoRecord())
	end,
	StopNow: func() begin
		fSetLengthInProgress := 'doItNow;
		self:stop();
		(fSetLengthInProgress := nil)
	end,
	Init: func() begin
		if (if (fDirection = 'record) then (GetUserConfig('inputDevice) = nil)) then begin
				fDirection := 'play;
				fSoundArray := [Array: ]
			end;
		if (fDirection = 'record) then begin
				fSoundChannel := @protoSoundChannel:newRecording();
				fSoundArray := [Array: ]
			end else begin
				if (not IsArray(fSoundArray)) then begin
						fSoundArray := [Array: fSoundArray]
					end;
				fSoundArray := (foreach l1 in fSoundArray collect begin
					l5 := Clone(@protoSoundFrame);
					local l5;
					(foreach l6, l7 in l1 do begin
							l5.(l6) := l7
						end);
					l5
				end);
				fSoundChannel := {_proto: @protoSoundChannel, direction: 'play}
			end;
		self:SetRecordingQuality();
		fEngineError := 0;
		fSoundChannel.inputDevice := fInputDevice;
		fSoundChannel.outputDevice := fOutputDevice;
		fSoundChannel.inputGain := fInputGain;
		fSoundChannel:Open();
		self:SetState(1);
		AddPowerOffHandler(self)
	end,
	DoPlay: func() begin
		local engine;
		fEngineError := 0;
		fCompletionCount := 0;
		if self:HasSoundFrames() then begin
				self:SetState(4);
				try begin
						if fSoundChannel:isPaused() then begin
								fSoundChannel:pause()
							end else begin
								fCompletionCount := 0;
								fSoundChannel:Close();
								fSoundChannel.direction := 'play;
								fSoundChannel.inputDevice := fInputDevice;
								fSoundChannel.outputDevice := fOutputDevice;
								fSoundChannel.inputGain := fInputGain;
								fSoundChannel:Open();
								engine := self;
								l2 := func(a1, a2) begin
									engine:PlayCompletion(a1, a2)
								end;
								local l1;
								local l2;
								(foreach l3 in fSoundArray do begin
										local l5, l6;
										l5 := (if (if HasPath(l3, 'volume) then l3.volume) then l3.volume else GetUserConfig('soundVolumeDb));
										fSoundChannel:schedule((l6 := {_proto: l3, callback: l2, volume: l5}))
									end);
								fSoundChannel:start(true)
							end;
						l1 := true
					end onexception |evt.ex| do begin
						self:CleanUpAfterError()
					end
			end;
		l1
	end,
	Rewind: func() begin
		nil
	end,
	stop: func() begin
		local engine;
		local l1, l2, l3, l4, l5, l6, l7, l8;
		if (not self:TestState(1)) then begin
				l2 := self:TestState(18);
				l3 := self:TestState(24);
				self:SetState(32);
				l1 := fSoundChannel:stop();
				if l3 then begin
						l1 := fPauseResult
					end;
				if (if l2 then l1) then begin
						l4 := l1.sound;
						l5 := l1.index;
						if (if fTrimAmount then (fTrimAmount > 0)) then begin
								l6 := floor((fTrimAmount * fSoundFrameSlots.samplingRate));
								if ((l5 := (l5 - l6)) < 0) then begin
										l5 := 0
									end
							end;
						if (fSetLengthInProgress = 'doItNow) then begin
								l4:SetRecordingLengthNow(l5);
								fSetLengthInProgress := nil
							end else begin
								fSetLengthInProgress := true;
								engine := self;
								l7 := func() begin
									engine:SetLengthDone()
								end;
								l4:SetRecordingLength(l5, l7)
							end;
						l8 := (Length(fSoundArray) - 1);
						(while (if (l8 > 0) then (fSoundArray[l8] <> l4)) do begin
								RemoveSlot(fSoundArray, l8);
								(l8 := (l8 - 1))
							end)
					end;
				self:SetState(1)
			end;
		return l1
	end,
	GetPlayingTime: func() begin
		l1 := 0;
		local l1;
		(foreach l2 in fSoundArray do begin
				l1 := (l1 + l2:GetPlayingTime())
			end);
		return l1
	end,
	HasSoundFrames: func() begin
		(if (if fSoundArray then (Length(fSoundArray) > 0)) then (not (foreach l1 in fSoundArray do begin
					if (l1:GetSampleCount() = 0) then begin
							break true
						end
				end)))
	end,
	PlayCompletion: func(a1, a2) begin
		(if ((fCompletionCount := (fCompletionCount + 1)) >= Length(fSoundArray)) then self:SetState(1))
	end,
	CleanUpAfterError: func() begin
		try begin
				fSoundChannel:Close()
			end onexception |evt.ex| do begin end;
		try begin
				fSoundChannel:Open()
			end onexception |evt.ex| do begin end;
		self:SetState(1)
	end,
	PowerOffScript: func(a1) begin
		(if (a1 = 'okToPowerOff) then true else (if (a1 = 'PowerOff) then self:StopNow()))
	end,
	ScheduleInputBlock: func() begin
		local engine;
		try begin
				engine := self;
				l1 := func(a1, a2) begin
					engine:RecordCompletion(a1, a2)
				end;
				fSoundChannel.recordingStore := self:GetStore();
				l2 := fSoundChannel:newInputBlock(l1);
				local l1;
				local l2;
				(foreach l3, l4 in fSoundFrameSlots do begin
						l2.(l3) := l4
					end);
				AddArraySlot(fSoundArray, l2);
				fSoundChannel:schedule(l2)
			end onexception |evt.ex| do begin
				l2 := nil
			end;
		l2
	end,
	play: func() begin
		(if (if fSetLengthInProgress then (fSetLengthInProgress <> 'doItNow)) then (fSetLengthInProgress := 'play) else self:DoPlay())
	end,
	New: func(a1) begin
		l1 := Clone(self);
		if a1 then begin
				local l1;
				(foreach l2, l3 in a1 do begin
						l1.(l2) := l3
					end)
			end;
		l1:Init();
		return l1
	end,
	SetLengthDone: func() begin
		if (fSetLengthInProgress = 'play) then begin
				self:DoPlay()
			end;
		if (fSetLengthInProgress = 'record) then begin
				self:DoRecord()
			end;
		(fSetLengthInProgress := nil)
	end,
	Done: func() begin
		self:StopNow();
		if (if fSoundChannel then fSoundChannel:IsOpen()) then begin
				fSoundChannel:Close()
			end;
		fSoundState := 1;
		fSoundChannel := nil;
		fPauseResult := nil;
		if fCallBack then begin
				(foreach l1 in fSoundArray do begin
						l1.callback := nil
					end);
				call fCallBack with (fSoundArray)
			end;
		fCallBack := nil;
		RemovePowerOffHandler(self);
		return true
	end,
	TestState: func(a1) begin
		return (BAnd(fSoundState, a1) <> 0)
	end,
	GetStore: func() begin
		(if fStore then fStore else GetDefaultStore())
	end,
	SetState: func(a1) begin
		(fSoundState := a1)
	end
};

