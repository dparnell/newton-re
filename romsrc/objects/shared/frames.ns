										end;
									if (not list) then begin
											list := [Array: ]
										end;
									AddArraySlot(list, frame2)
								end
						end);
					if (Length(resolveEntryAlias.phones) > key2) then begin
							target.(path) := resolveEntryAlias.phones[key2];
							currPhoneType := ClassOf(resolveEntryAlias.phones[key2]);
							country := resolveEntryAlias.country
						end
				end;
			if (if list then (Length(list) = 1)) then begin
					list := nil
				end;
			self:SetLabelCommands(list)
		end,
		_proto: @newtPhoneFilter
	},
	// a label item picked: a name reference resolved (it has an id); the
	// last item opens the picker; else the number put in the line, checked,
	// and its class (the phone type, else 'phone) set on the line's value
	pickActionScript: func(index) begin
		local labelCommand;
		if HasPath(labelCommands[index], 'id) then begin
				filter:ResolveItem(labelCommands[index]);
				self:hilite(nil)
			end else begin
				if (if filter.picker then (index = (Length(labelCommands) - 1))) then begin
						filter:picker()
					end else begin
						if (not filter:?ChooseItem(index)) then begin
								if lastPicked then begin
										labelCommands[lastPicked].mark := nil
									end;
								if IsFrame((labelCommand := labelCommands[index])) then begin
										labelCommand.mark := $\uFC0B;
										labelCommand := (if labelCommand.value then labelCommand.value else labelCommand.item)
									end;
								lastPicked := index;
								self:UpdateText(Clone(labelCommand));
								self:hilite(nil)
							end
					end
			end;
		(if (currPhoneType := labelCommands[index].class) then begin
				if target.(path) then begin
						SetClass(target.(path), currPhoneType)
					end;
				self:StartFlush()
			end else SetClass(target.(path), 'phone))
	end,
	_proto: @newtAreacodePhoneLine
};

