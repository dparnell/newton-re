	viewJustify: 0,
	entryFlags: vVisible + vClickable + vGesturesAllowed + vNumbersAllowed,
	entryTextFlags: vNoSpaces,
	viewLineSpacing: 38,
	label: "Turn to page",
	text: nil,
	// the entry line's text centred; the BAnd with bnot(0) keeps every bit,
	// so it clears nothing before vjCenterH is added
	viewSetupChildrenScript: func() begin
		inherited:viewSetupChildrenScript();
		(entryLine.viewJustify := BOr(BAnd(entryLine.viewJustify, bnot(0)), vjCenterH))
	end,
	// (after BadText's wait) the line cleared; 0 stops the idling
	viewIdleScript: func() begin
		SetValue(entryLine, 'text, "");
		return 0
	end,
	// the caret into the line
	viewSetupDoneScript: func() begin
		SetKeyView(entryLine, 999)
	end,
	// a bad page: a beep, and the line cleared after 1800 ms
	BadText: func() begin
		self:SysBeep();
		self:SetupIdle(1800)
	end,
	// a page number from 1 to maxValue passed to NumberEntered (the
	// fraction dropped)
	textChanged: func() begin
		local floor2, number;
		(if (not StrEqual(text, "")) then begin
				floor2 := 0;
				if (number := StringToNumber(text)) then begin
						floor2 := floor(number)
					end;
				(if (if (floor2 > 0) then (floor2 <= maxValue)) then self:NumberEntered(floor2) else self:Parent():BadText())
			end)
	end,
	debug: 6040,
	_proto: @protoLabelInputLine
};

