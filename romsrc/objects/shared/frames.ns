// the Extras drawer's entry for a package's icon (proto1_2Exformentry): the
// icon's soup entry (fentry) and what the drawer asks of it - its name,
// store, size, whether it may be filed, moved, sent, deleted or used as the
// backdrop, and what a tap does (activate the package if need be, then open
// the application)
proto1_2ExformentryProto := {
	// the template of a new icon entry
	iconEntry: {
		class: 'FormEntry,
		text: uCardPositionAlertButton,
		icon: 2,
		sequence: nil,
		labels: nil,
		_tagList: [|Array|: '_icon],
		packageName: nil,
		app: nil
	},
	// a new icon entry: a copy of the template
	New: func() begin
		Clone(iconEntry)
	end,
	// the icon's text, in curly quotes
	name: func() begin
		ParamStr("\u201C\u^0\u201D\u", [Array: fentry.text])
	end,
	// the name of the store it is on, "" for none
	where: func() begin
		local store;
		(if (store := self:store()) then store:GetName() else "")
	end,
	// the package's size in K (1024 bytes, rounded down)
	size: func() begin
		Stringer([Array: (EntrySize(self:LookupSoupPackage()) div 1024), "K"])
	end,
	// the package's copy protection
	copyprotected: func() begin
		GetPkgRefInfo(self:LookupSoupPackage().pkgRef).copyprotection
	end,
	// the store of the icon's entry (nil if it is not a soup entry)
	store: func() begin
		(if IsSoupEntry(fentry) then EntryStore(fentry))
	end,
	// the package's entry on that store, by the icon's packageName
	LookupSoupPackage: func() begin
		local store, packageName;
		store := self:store();
		packageName := fentry.packageName;
		(if (if store then packageName) then GetPackageEntry(packageName, store))
	end,
	// 'noSoupPackage, 'alreadyActive, 'justActivated - or nil when the
	// package would not activate
	LookupSoupPackageAndActivate: func() begin
		local soupPackage;
		(if (not (soupPackage := self:LookupSoupPackage())) then 'noSoupPackage else (if SetContains(ActivePackageList, soupPackage.pkgRef) then 'alreadyActive else (if SafeActivatePackage(soupPackage.pkgRef, soupPackage.packageName, EntryStore(soupPackage)) then 'justActivated)))
	end,
	// (its comment is above its function, below)
	Preflight: compile(
		constants: {
			kLiteral_536a15: "locked",
			kLiteral_536afd: "copy protected"
		},
		// may the action a1 be done to the icon (kids: all the icons it is
		// done to)?  'OK, or a string saying why not: the backdrop takes one
		// icon, of an application that allows it (no noBackdrop), that can
		// rotate (ReOrientToScreen) when the screen is under 320 high, and on
		// the internal store; filing, deleting and
		// freezing need an unlocked store; moving and sending an unprotected
		// package
		func(a1, kids) begin
			local l1;
			(if (a1 = 'Backdrop) then (if (Length(kids) = 1) then begin
						if (l1 := GetRoot().(fentry.app)).noBackdrop then begin
								return "the wrong kind"
							end;
						if (if (displayParams.appAreaHeight < 320) then (not l1.ReOrientToScreen)) then begin
								return "not designed for this orientation"
							end;
						(if (EntryStore(fentry) = GetStores()[0]) then 'OK else "not stored internally")
					end) else (if (((a1 = 'Filing) or (a1 = 'delete)) or (a1 = 'freeze)) then (if (not EntryStore(fentry):IsReadOnly()) then 'OK else kLiteral_536a15) else (if (a1 = 'move) then (if self:copyprotected() then kLiteral_536afd else (if EntryStore(fentry):IsReadOnly() then kLiteral_536a15 else 'OK)) else (if (a1 = 'send) then (if self:copyprotected() then kLiteral_536afd else 'OK) else 'OK))))
		end),
	// the package removed
	delete: func() begin
		local soupPackage;
		(if (soupPackage := self:LookupSoupPackage()) then SafeRemovePackageQT(soupPackage))
	end,
	// the package moved to the store given (the argument named maxLines)
	move: func(maxLines) begin
		SafeMovePackageQT(self:LookupSoupPackage(), maxLines)
	end,
	file: file_2,
	// a tap: the package found and activated, then the entry's own
	// TapAction; when that answers non-nil, the result is whether the drawer
	// closes (closeControl 'alwaysClose, or the user's ExtraAlwaysClose),
	// else (no TapAction, or nil) the application is opened (_Open)
	TapAction: func() begin
		(if self:LookupSoupPackageAndActivate() then (if fentry:?TapAction() then (if fentry.closeControl then (fentry.closeControl = 'alwaysClose) else GetUserConfig('ExtraAlwaysClose)) else self:_Open(GetRoot().(fentry.app))))
	end,
	// the application (the argument, named copperfield after one caller)
	// toggled open; when it was not showing and the drawer is to close, the
	// toggle waits until after the tap.  Returns whether the drawer closes
	_Open: func(copperfield) begin
		local l1;
		(if copperfield then begin
				if (l1 := (if (not (if copperfield.viewCObject then Visible(copperfield))) then (if fentry.closeControl then (fentry.closeControl = 'alwaysClose) else GetUserConfig('ExtraAlwaysClose)))) then begin
						AddDeferredSend(copperfield, 'ButtonToggle, nil)
					end else begin
						copperfield:ButtonToggle()
					end;
				l1
			end)
	end
};

