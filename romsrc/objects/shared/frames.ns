// the touch-tone keypad (touchtonePad): a protoKeypad whose keys play their
// DTMF tones - with a tab and two arrow keys on the bottom row
touchtonePadProto := {
	keySound: nil,
	typewriter: @typewriter,
	newt_feature: true,
	// a key pressed: for 0-9, * (10) and # (11) its tone from dialTones, at
	// volume 4, when the sound is on and the locale does not say the device
	// has no speaker; any other key, or no tone allowed, the typewriter click
	keyPressScript: func(char2) begin
		local oRD2;
		if (char2 = $*) then begin
				oRD2 := 10
			end else begin
				if (char2 = $#) then begin
						oRD2 := 11
					end else begin
						if (if ((oRD2 := ORD(char2)) >= 48) then (oRD2 <= 57)) then begin
								oRD2 := (oRD2 - 48)
							end else begin
								oRD2 := nil
							end
					end
			end;
		if (if oRD2 then (not GetLocale().speakerless)) then begin
				if (GetVolume() > 0) then begin
						PlaySoundAtVolume(@dialTones[oRD2], 4)
