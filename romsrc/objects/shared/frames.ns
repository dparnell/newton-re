// the digits of the latitude, longitude and time-delta pickers
// (protoDigit flaps; the value is in minutes, signed): this one shows the
// hemisphere (the compass letters: index 0 for a value >= 0, 1 below), and
// tapping it negates the value
protoLatitudePickerItem := {
	viewBounds: {left: -23, top: 0, right: 0, bottom: 28},
	icon: @digitflaploWord,
	totalFrames: 2,
	// any tap flips the sign: the value moved by -2 times itself
	Advance: func(a1) begin
		inherited:Advance((-2 * value))
	end,
	increment: 0,
	// the flap to show: 0 for a value >= 0, else 1
	GetIndex: func(value) begin
		(if (value >= 0) then 0 else 1)
	end,
	// the flaps are the compass letters
	viewSetupFormScript: func() begin
		(digits := compass)
	end,
	_proto: @protoDigit
};

// the minutes' units digit; this and the digits after it count away from
// zero, so a step of a1 is taken the other way for a negative value
protoLatitudePickerItem_2 := {
	viewBounds: {left: -29, top: 0, right: -6, bottom: 28},
	icon: @digitflaploWord,
	// a step taken away from zero
	Advance: func(a1) begin
		inherited:Advance((if (value < 0) then (-a1) else a1))
	end,
	increment: 1,
	// the minutes' units
	GetIndex: func(value) begin
		(abs(value) mod 10)
	end,
	nextDigit: 'minutes10,
	_proto: @protoDigit
};

// the minutes' tens digit (0-5)
minutes10 := {
	viewBounds: {left: -22, top: 0, right: 0, bottom: 28},
	icon: @digitflap,
	// a step taken away from zero
	Advance: func(a1) begin
		inherited:Advance((if (value < 0) then (-a1) else a1))
	end,
	increment: 10,
	// the minutes' tens
	GetIndex: func(value) begin
		((abs(value) mod 60) div 10)
	end,
	nextDigit: 'hours1,
	preallocatedContext: 'minutes10,
	_proto: @protoDigit
};

// the hours' (or degrees') units digit: a step is 60 minutes
hours1 := {
	viewBounds: {left: -29, top: 0, right: -6, bottom: 28},
	icon: @digitflaploWord,
	// a step taken away from zero
	Advance: func(a1) begin
		inherited:Advance((if (value < 0) then (-a1) else a1))
	end,
	increment: 60,
	// the hours' units
	GetIndex: func(value) begin
		((abs(value) div 60) mod 10)
	end,
	nextDigit: 'hours10,
	preallocatedContext: 'hours1,
	_proto: @protoDigit
};

// the hours' (or degrees') tens digit: a step is 600 minutes
hours10 := {
	viewBounds: {left: -22, top: 0, right: 0, bottom: 28},
	icon: @digitflap,
	// a step taken away from zero
	Advance: func(a1) begin
		inherited:Advance((if (value < 0) then (-a1) else a1))
	end,
	increment: 600,
	// the hours' tens
	GetIndex: func(value) begin
		((abs(value) div 600) mod 10)
	end,
	preallocatedContext: 'hours10,
	_proto: @protoDigit
