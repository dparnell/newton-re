LetterSetCluster := {
	viewBounds: {left: 30, top: 2, right: 0, bottom: 28},
	viewJustify: vjParentFullH + vjSiblingBottomV,
	viewSetupFormScript: func() begin
		// (an addition: the host's handwriting engines, recognition/WordEngines.h
		//  - one chosen shows as its button, and the cluster is a row taller for
		//  each; the ROM's letter set as before otherwise)
		local engines := if GlobalFnExists('HostWordEngines) then HostWordEngines() else [];
		if Length(engines) > 0 then begin
			local below := viewChildren[1];
			local row := below.viewBounds.bottom - below.viewBounds.top;
			self.viewBounds := {left: viewBounds.left, top: viewBounds.top, right: viewBounds.right,
								bottom: viewBounds.bottom + row * Length(engines)};
		end;
		local chosen := userConfiguration.hostWordEngine;
		if IsInteger(chosen) then
			foreach e in engines do
				if e.value = chosen then
					return clusterValue := chosen;
		(if (((ClassOf((clusterValue := userConfiguration.letterSetSelection)) <> 'int) or (clusterValue < 0)) or (clusterValue > 4)) then begin
				clusterValue := 2;
				self:ClusterChanged()
			end)
	end,
	viewSetupChildrenScript: func() begin
		// (an addition: a button for each of the host's handwriting engines,
		//  recognition/WordEngines.h, under "Printing" and "Cursive" - each
		//  made from the "Cursive" button, the one drawn under another)
		local engines := if GlobalFnExists('HostWordEngines) then HostWordEngines() else [];
		if Length(engines) > 0 then begin
			local below := viewChildren[1];
			local buttons := Clone(viewChildren);
			foreach e in engines do
				AddArraySlot(buttons, {_proto: below, text: e.text, buttonValue: e.value});
			self.viewChildren := buttons;
		end;
	end,
	ClusterChanged: func() begin
		if (clusterValue = nil) then begin
				clusterValue := 2;
				self:SetClusterValue(2);
				self:SysBeep()
			end;
		// (an addition: one of the host's handwriting engines chosen - its
		//  number kept in hostWordEngine, the letter set left at printing,
		//  which ParaGraph's code needs to be one of its own; any other button
		//  is the ROM's letter set, and the engine is forgotten)
		if clusterValue >= 8 then begin
				userConfiguration.hostWordEngine := clusterValue;
				userConfiguration.letterSetSelection := 2
			end else begin
				RemoveSlot(userConfiguration, 'hostWordEngine);
				userConfiguration.letterSetSelection := clusterValue
			end;
		wordExample:Dirty();
		ReadCursiveOptions()
	end,
	preallocatedContext: 'LetterSetCluster,
	viewChildren: [viewChildren:
		{
			viewJustify: vjParentFullH,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 13},
			viewFont: @fontSystem9Bold,
			text: "Printing (separate letters)",
			buttonValue: 2,
			debug: 17209715,
			_proto: @protoRadioButton
		},
		{
			viewJustify: vjParentFullH + vjSiblingBottomV,
			viewBounds: {left: 0, top: 0, right: 0, bottom: 13},
			viewFont: @fontSystem9Bold,
			text: "Cursive (connected letters)",
			buttonValue: 0,
			debug: 37368179,
			_proto: @protoRadioButton
		}
	],
	_proto: @protoRadioCluster
};

wordExample := {
	viewClass: clView,
	viewFlags: vVisible,
	viewJustify: vjParentCenterH + vjSiblingBottomV,
	viewBounds: {left: 0, top: 2, right: 210, bottom: 37},
	cursiveCharSpace: [|Array|: 9, 8, 7, 6, 5, 4, 3, 2, 1, 0],
	cursiveWordSpace: [|Array|: 27, 24, 21, 18, 15, 12, 9, 6, 3, 0],
	printedCharSpace: [|Array|: 7, 7, 6, 6, 5, 4, 3, 2, 1, 0],
	printedWordSpace: [|Array|: 20, 18, 16, 14, 12, 11, 10, 9, 8, 7],
	charSpace: [|Array|: 9, 8, 7, 6, 5, 4, 3, 2, 1, 0],
	wordSpace: [|Array|: 27, 24, 21, 18, 15, 12, 9, 6, 3, 0],
	wordBits: @handwritingStyleImages,
	textHeight: 23,
	lineStyle: {penPattern: 3, fillPattern: 0, transferMode: 1},
	viewDrawScript: func() begin
		self:drawExampleScript()
	end,
	SelectSpacingOption: func() begin
		local l1;
		(if ((l1 := userConfiguration.letterSetSelection) = 2) then begin
				charSpace := printedCharSpace;
				(wordSpace := printedWordSpace)
			end else begin
				charSpace := cursiveCharSpace;
				(wordSpace := cursiveWordSpace)
			end)
	end,
	drawExampleScript: func() begin
		l1 := 0;
		l2 := 0;
		self:DrawShape((l3 := MakeLine(l1, (l2 + textHeight), viewBounds.right, (l2 + textHeight))), lineStyle);
		self:SelectSpacingOption();
		l4 := charSpace[userConfiguration.letterSpaceCursiveOption];
		l5 := wordSpace[userConfiguration.letterSpaceCursiveOption];
		l6 := userConfiguration.letterSetSelection;
		local l1;
		local l2;
		local l3;
		local l4;
		local l5;
		local l6;
		local l7;
		// (an addition: while one of the host's handwriting engines is chosen,
		//  its own example - recognition/WordEngines.h: words of letters, each a
		//  stroke drawn with a dot where the pen goes down - in place of the
		//  letter set's)
		local engine := nil;
		if IsInteger(userConfiguration.hostWordEngine) and GlobalFnExists('HostWordEngines) then
			foreach e in HostWordEngines() do
				if e.value = userConfiguration.hostWordEngine and e.example then engine := e;
		if engine then begin
			foreach word in engine.example do begin
				foreach letter in word do begin
					local pts := Clone(letter.points);
					for i := 0 to Length(pts) - 2 by 2 do pts[i] := pts[i] + l1;
					self:DrawShape(MakePolygon(pts), {penSize: 2, penPattern: 5, fillPattern: 0, transferMode: 1});
					self:DrawShape(MakeOval(pts[0] - 2, pts[1] - 2, pts[0] + 3, pts[1] + 3),
								   {penPattern: 5, fillPattern: 5, transferMode: 1});
					l1 := ((l1 + letter.width) + l4)
				end;
				l1 := ((l1 - l4) + l5)
			end;
			return nil;
		end;
		(foreach l8 in (l7 := wordBits[l6]) do begin
				(foreach l10 in l8 do begin
						local l12;
						l12 := ShapeBounds((l3 := MakeShape(l10))).right;
						OffsetShape(l3, l1, l2);
						self:DrawShape(l3, '{transferMode: 1});
						l1 := ((l1 + l12) + l4)
					end);
				l1 := ((l1 - l4) + l5)
			end)
	end,
	preallocatedContext: 'wordExample
};
