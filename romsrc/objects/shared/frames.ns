// protoPicker's up and down arrows (hidden until the list is too long)
scrollers := {
	viewJustify: vjParentRightH + vjParentCenterV + vjParentClip,
	viewFlags: vReadOnly,
	ScrollRect: nil,
	DataRect: nil,
	ViewRect: nil,
	// an arrow held: the picker scrolled a line while there is more that
	// way, pausing so that a line takes at least scrollingSleepTime ticks;
	// then the arrows updated
	viewScroll2DScript: func(arrowDirection, a2) begin
		local parent, ticks2;
		parent := self:Parent();
		if (self:GetArrow(arrowDirection) = 'more) then begin
				ticks2 := Ticks();
				parent:Scroll(arrowDirection);
				RefreshViews();
				if ((ticks2 := (Ticks() - ticks2)) < scrollingSleepTime) then begin
						Sleep((scrollingSleepTime - ticks2))
					end
			end;
		parent:SetScrollers()
	end,
	preallocatedContext: 'scrollers,
	_proto: @protoUpDownScroller
};

