// the AppleTalk chooser's base (the zone and network choosers, zoneChooser
// and netChooser): a floater that opens AppleTalk, looks names up with NBP
// in its table (theTable_2Proto), and closes AppleTalk again when it closes
// or the Newton powers off
zoneChooserProto := {
	_proto: @protoFloater,
	viewFlags: vApplication + vFloating + vClickable,
	currentSelection: nil,
	selectedIndex: nil,
	selectedZoneIndex: nil,
	appleTalkOpen: nil,
	chooserNBPTable: nil,
	// true from setup until the chooser starts closing
	formOpen: nil,
	// the power-off handler: powering off is allowed, and closes the chooser
	PowerOffScript: func(a1) begin
		(if (a1 = 'okToPowerOff) then true else (if (a1 = 'PowerOff) then self:CloseAndNotify(nil)))
	end,
	// open, and told of powering off
	viewSetupFormScript: func() begin
		formOpen := true;
		AddPowerOffHandler(self)
	end,
	// after the chooser is up: AppleTalk opened (unless it already is); on
	// failure the chooser closes with an alert saying why.  Returns whether
	// AppleTalk is open
	deferredSetupScript: func() begin
		local openAppleTalk2, text;
		openAppleTalk2 := 0;
		if formOpen then begin
				if (not appleTalkOpen) then begin
						openAppleTalk2 := OpenAppleTalk()
					end;
				if (openAppleTalk2 <> 0) then begin
						// -12014: an AppleTalk error (ERRBASE_APPLETALK - 14) that
						// means it is already in use, by the text it gets
						if (openAppleTalk2 = -12014) then begin
								text := "The chooser can not be opened because AppleTalk is already in use."
							end else begin
								text := ParamStr("There is a problem opening the chooser. (^0)", [Array: self:TranslateError(openAppleTalk2)])
							end;
						self:CloseAndNotify(text)
					end else begin
						appleTalkOpen := true
					end
			end;
		return (if formOpen then appleTalkOpen)
	end,
	// the handler removed and what the chooser was given let go
	viewQuitScript: func() begin
		RemovePowerOffHandler(self);
		notifyOnClose := nil;
		chooserNBPTable := nil;
		startSelection := nil;
		currentSelection := nil;
		currentZone := nil;
		headerText := nil;
		lookForText := nil;
		(nbpLookupName := nil)
	end,
	// the table's cell at selectedIndex (an index among the visible cells)
	// shown selected, when there is one
	selectCellInTable: func() begin
		local childViewFrames;
		(if (selectedIndex <> nil) then (if (if ((childViewFrames := theTable:ChildViewFrames()) <> nil) then (selectedIndex < Length(childViewFrames))) then theTable:selectThisCell(childViewFrames[selectedIndex])))
	end,
	// the chooser closed: the NBP lookup stopped, AppleTalk closed, and text
	// (when not nil) shown in an alert
	CloseAndNotify: func(text) begin
		formOpen := nil;
		if chooserNBPTable then begin
				chooserNBPTable:stopScript()
			end;
		if appleTalkOpen then begin
				CloseAppleTalk();
				appleTalkOpen := nil
			end;
		if (text <> nil) then begin
				self:Notify(kNotifyAlert, "Chooser", text)
			end;
		base:Close()
	end,
	// an error number: the chooser closed with it in the alert
	showError: func(a1) begin
		self:CloseAndNotify(ParamStr("The chooser found a problem...(^0).", [Array: NumberStr(a1)]))
	end,
	// the chooser left open too long: kept on external power, else closed to
	// save the battery (returns whether to go on)
	timesUpScript: func() begin
		(if (BatteryStatus(0).acPower = 'yes) then return true else begin
				self:CloseAndNotify("The chooser has been closed to conserve battery power.");
				return nil
			end)
	end
};

// the chooser's "Looking for <lookForText>..." while no names have come
startupMsg_2Proto := {
	_proto: @protoStaticText,
	viewJustify: vjCenterH + vjCenterV + vjSiblingCenterH + vjSiblingCenterV + oneLineOnly,
	viewBounds: {left: 0, top: 0, right: 115, bottom: 13},
	text: uCardPositionAlertButton,
	// the text, and the view as wide as it, when the chooser has lookForText
	viewSetupFormScript: func() begin
		local strFontWidth2;
		(if (lookForText exists) then begin
				self.text := ParamStr("Looking for ^0...", [Array: lookForText]);
				strFontWidth2 := StrFontWidth(self.text, viewFont);
				(self.viewBounds := RelBounds(0, 0, strFontWidth2, 13))
			end)
	end
};

// the chooser's heading, "Select a <headerText>", as wide as its text
zoneChooserProto_2 := {
	_proto: @protoStaticText,
	text: uCardPositionAlertButton,
	// the text, and the view as wide as it (a pixel taller), when the
	// chooser has headerText
	viewSetupFormScript: func() begin
		local strFontWidth2, viewBounds;
		(if (headerText exists) then begin
				text := ParamStr("Select a ^0", [Array: headerText]);
				viewBounds := self.viewBounds;
				strFontWidth2 := StrFontWidth(self.text, viewFont);
				(self.viewBounds := RelBounds(viewBounds.left, viewBounds.top, strFontWidth2, ((viewBounds.bottom - viewBounds.top) + 1)))
			end)
	end
};

// the chooser's table of the names NBP found (seven lines showing): it
// starts a lookup of nbpLookupName in the current zone ("*" for this one),
// polls for names on an idle that slows down as it goes (200 ms, then 1 s
// after 4 checks, 3 s after 20), and shows them sorted, the previous choice
// selected
theTable_2Proto := {
	_proto: @protoTable,
	viewJustify: vjParentBottomV,
	viewBounds: {left: 10, top: -135, right: 180, bottom: -43},
	visibleItems: 7,
	def: @protoTableDef,
	entryProto: {
		_proto: @protoTableEntry,
		// a name tapped: the chooser's time-out started again (300000) and the
		// line remembered
		viewClickScript: func(unit) begin
			timeoutCounter := 300000;
			inherited:viewClickScript(unit);
			(selectedIndex := (self.vIndex - vOrg))
		end
	},
	currentNames: 0,
	currentChecks: 0,
	nbpCookie: nil,
	idleFrequency: 200,
	// the idle period for a stage (0, 1, 2), in milliseconds
	getIdleFrequency: func(a1) begin
		if (a1 = 0) then begin
				idleFrequency := 200
			end else begin
				if (a1 = 1) then begin
						idleFrequency := 1000
					end else begin
						idleFrequency := 3000
					end
			end;
		return idleFrequency
	end,
	// the names found so far put in the table, sorted; the scroller shown
	// when there are more than seven; the current selection scrolled into
	// view and selected
	CopyNBPNamesToTable: func() begin
		local l1, stringInArray;
		def.tabValues := NBPGetNames(nbpCookie);
		Sort(def.tabValues, '|str<|, nil);
		def.tabDown := (if (def.tabValues <> nil) then Length(def.tabValues) else 0);
		if (def.tabDown > 7) then begin
				nbpScroller.ScrollRect := (nbpScroller.DataRect := SetBounds(0, 0, 0, def.tabDown));
				l1 := true
			end else begin
				nbpScroller:Hide()
			end;
		if (currentSelection <> nil) then begin
				if ((stringInArray := FindStringInArray(def.tabValues, currentSelection)) <> nil) then begin
						if (stringInArray >= visibleItems) then begin
								vOrg := min(stringInArray, (def.tabDown - visibleItems))
							end else begin
								vOrg := 0
							end;
						selectedIndex := (stringInArray - vOrg);
						nbpScroller.yPos := vOrg;
						l1 := true
					end
			end;
		if l1 then begin
				nbpScroller:AdjustArrows();
				nbpScroller:Show()
			end;
		theTable:RedoChildren();
		self:selectCellInTable()
	end,
	// a poll: when more names have come, the "Looking for" message hidden
	// and the table refilled; returns the next idle period (0: stop, when
	// the chooser is closing)
	viewIdleScript: func() begin
		local nBPGetCount2, getIdleFrequency;
		getIdleFrequency := 0;
		nBPGetCount2 := 0;
		if formOpen then begin
				currentChecks := (currentChecks + 1);
				if nbpCookie then begin
						nBPGetCount2 := NBPGetCount(nbpCookie)
					end;
				if (nBPGetCount2 > currentNames) then begin
						if Visible(startupMsg) then begin
								startupMsg:Hide()
							end;
						currentNames := nBPGetCount2;
						self:CopyNBPNamesToTable()
					end;
				if (currentChecks > 20) then begin
						getIdleFrequency := self:getIdleFrequency(2)
					end else begin
						if (currentChecks > 4) then begin
								getIdleFrequency := self:getIdleFrequency(1)
							end else begin
								getIdleFrequency := self:getIdleFrequency(0)
							end
					end
			end;
		return getIdleFrequency
	end,
	// the chooser told of its table; a private copy of the table definition
	// (170 wide, less any indent); the table seven lines high; the starting
	// selection's name
	viewSetupFormScript: func() begin
		currentNames := 0;
		currentChecks := 0;
		chooserNBPTable := self;
		(def := Clone(def)).tabProtos := entryProto;
		def.tabWidths := 170;
		if def.indentX then begin
				def.tabWidths := (def.tabWidths - def.indentX)
			end;
		self.viewBounds := Clone(viewBounds);
		self.viewBounds.bottom := (viewBounds.top + (((7 * FontHeight(viewFont)) - 7) + 1));
		(if (startSelection <> nil) then (currentSelection := GetNames(startSelection)))
	end,
	// a lookup started (the table emptied): NBPStart on "<name><zone>"; the
	// error l2 is -12310 when one is already running and -12000
	// (ERRBASE_APPLETALK, as a generic AppleTalk error) when NBPStart gave no
	// cookie; on an error the chooser closes, else polling starts.  Returns
	// the error (0: none)
	startScript: func() begin
		local text, l2;
		def.tabValues := nil;
		selectedIndex := nil;
		selectedCells := [Array: ];
		vOrg := 0;
		nbpScroller.yPos := 0;
		nbpScroller:AdjustArrows();
		if (currentZone = nil) then begin
				text := "*"
			end else begin
				text := currentZone
			end;
		l2 := 0;
		if (not nbpCookie) then begin
				nbpCookie := NBPStart(Stringer([Array: nbpLookupName, text]))
			end else begin
				l2 := -12310
			end;
		if (not nbpCookie) then begin
				l2 := -12000
			end;
		if (l2 <> 0) then begin
				self:showError(l2)
			end else begin
				if formOpen then begin
						currentChecks := 0;
						currentNames := 0;
						theTable:SetupIdle(self:getIdleFrequency(0));
						self:CopyNBPNamesToTable()
					end
			end;
		return l2
	end,
	// the lookup stopped (and polling); returns NBPStop's error, closing the
	// chooser on one
	stopScript: func() begin
		local nBPStop2;
		nBPStop2 := 0;
		if nbpCookie then begin
				theTable:SetupIdle(0);
				nBPStop2 := NBPStop(nbpCookie);
				nbpCookie := nil
			end;
		if (nBPStop2 <> 0) then begin
				self:showError(nBPStop2)
			end;
		return nBPStop2
	end,
	// scrolling counts as use: the time-out started again
	viewScroll2DScript: func(arrowDirection, a2) begin
		timeoutCounter := 300000;
		inherited:viewScroll2DScript(arrowDirection, a2);
		RefreshViews()
	end
};

// the chooser table's scroll arrows (seven lines a page)
nbpScroller_2Proto := {
	_proto: @protoUpDownScroller,
	viewJustify: vjParentBottomV,
	viewBounds: {left: 185, top: -108, right: 203, bottom: -75},
	ViewRect: {left: 0, top: 0, right: 0, bottom: 7},
	// the arrows scroll the chooser's table
	viewSetupDoneScript: func() begin
		scrollView := theTable;
		inherited:?viewSetupDoneScript()
	end
};

// the folder tab's text (protoShowBar, protoNewShowBar, the NewtApp
// folder tab): the folder (and store) being shown, as a tab with rounded
// ends; tapping it pops up the application's folders - Unfiled, each
// folder, All - and, with more than one store, the stores and All Stores,
// the current ones checked, and picking one changes the filter
showBarText := {
	_proto: {
