// objects several roots reach, none alone (naturalize.py)
//
// The frames of the ROM that are shared: each is reached from more than one
// of the tree's roots (the protos, applications, slips and system objects of
// the other files), so it belongs to none of them and is kept here instead.
// They are a mixed lot - bitmaps and their bounds, view templates that
// several protos use as a child or a _proto (entry and label lines, the
// digits of the latitude and time pickers, the AppleTalk chooser's pieces,
// the backup slips' lists, the folder tab's filing popup), the Notes and Call
// Log stationery, the Assistant's action frames and the Recognition
// preferences' handwriting style - with a comment on each saying what it is.

// the checkbox bitmaps, checked and not (with the shared mask CheckOnMask)
CheckOn := {
	mask: CheckOnMask,
	bits: bitmap('bits, "resources/bits/3c8a6d.png", "00000000000400340034001300410020", 1),
	bounds: {left: 0, top: 0, right: 13, bottom: 13}
};

CheckOff := {
	mask: CheckOnMask,
	bits: bitmap('bits, "resources/bits/3c8af1.png", "00000000000400190019001300260020", 1),
	bounds: {left: 0, top: 0, right: 13, bottom: 13}
};

// the bounds of the punctuation pickers' bitmaps (the caret's popup and the
// corrector's leading, middle and trailing punctuation)
caretpunctBitmapBounds := {left: 0, top: 0, right: 43, bottom: 163};

leadingpunctBitmapBounds := {left: 0, top: 0, right: 63, bottom: 25};

midpunctBitmapBounds := {left: 0, top: 0, right: 43, bottom: 47};

trailingpunctBitmapBounds := {left: 0, top: 0, right: 63, bottom: 69};

// the entry line of the label input lines (protoLabelInputLine and the
// like): one line of handwriting-font text on gray lines
entryLine := {
	_proto: @protoInputLine,
	viewJustify: vjParentFullV + oneLineOnly,
	viewFont: tsHWFont + tsSize(12),
	viewFormat: vfLinesGray,
	// its text changed: the parent's textChanged sent
	viewChangedScript: func(slot, view) begin
		(if (slot = 'text) then self:textChanged())
	end,
	preallocatedContext: 'entryLine
};

// the label of the label input lines: static text that, when the line has
// labelCommands, pops them up when tapped (unless labelClick took the tap)
labelLine := {
	_proto: @protoStaticText,
	viewFlags: vVisible + vReadOnly + vClickable,
	viewFormat: vfRound(3),
	viewJustify: oneLineOnly,
	// a tap: labelClick's first; else, with label commands, the popup after
	// the pen is tracked (true: the tap taken)
	viewClickScript: func(unit) begin
		(if (if (not self:labelClick(unit)) then labelCommands) then begin
				if self:TrackHilite(unit) then begin
						self:Popit()
					end;
				true
			end)
	end,
	preallocatedContext: 'labelLine
};

// the sound recorder's progress gauge: while recording it fills a step a
// second, round again every 60 seconds; while playing it fills in
// proportion to the sound's length (playTime, in seconds)
SoundProgressSlider := {
	viewJustify: vjSiblingBottomV,
	viewBounds: {left: 7, top: 3, right: 127, bottom: 14},
	_sound: nil,
	minValue: 0,
	maxValue: 60,
	viewValue: 0,
	// TimeInSeconds() when the recording or playing (re)started, less what
	// had elapsed before a pause
	startSeconds: nil,
	playTime: nil,
	// the seconds elapsed when paused (0 while running)
	elapsedTime: 0,
	// the clock started
	viewSetupFormScript: func() begin
		(startSeconds := TimeInSeconds())
	end,
	// back to the start, recording
	ResetSlider: func() begin
		elapsedTime := 0;
		self:SetRecordStart()
	end,
	// the gauge full (the sound ended)
	SlideToRight: func() begin
		self:SetAndUpdate(maxValue)
	end,
	// recording (again, after a pause): no length to measure against
	SetRecordStart: func() begin
		playTime := nil;
		startSeconds := (TimeInSeconds() - elapsedTime);
		self:SetCurrentTime()
	end,
	// paused: the time so far kept
	PauseSlider: func() begin
		(elapsedTime := (TimeInSeconds() - startSeconds))
	end,
	// playing (again) a sound of playingTime seconds (at least 1)
	SetPlayStart: func(playingTime) begin
		if ((playTime := playingTime) < 1) then begin
				playTime := 1
			end;
		startSeconds := (TimeInSeconds() - elapsedTime);
		self:SetCurrentTime()
	end,
	// the gauge set for the time now: l1 seconds elapsed, over the range l2 -
	// a share of the sound when playing, else the seconds round the range
	SetCurrentTime: func() begin
		local l1, l2, l3;
		l1 := (TimeInSeconds() - startSeconds);
		l2 := (maxValue - minValue);
		self:SetAndUpdate((l3 := (if playTime then ceiling(((l1 * l2) / playTime)) else (l1 mod l2))))
	end,
	// the seconds recorded or played so far
	getElapsedTime: func() begin
		(if (elapsedTime > 0) then elapsedTime else (TimeInSeconds() - startSeconds))
	end,
	// the gauge set to the value (the argument named maxValue) and drawn at
	// once; elapsedTime cleared, as the gauge is running
	SetAndUpdate: func(maxValue) begin
		viewValue := maxValue;
		self:Dirty();
		RefreshViews();
		(elapsedTime := 0)
	end,
	preallocatedContext: 'SoundProgressSlider,
	_proto: @protoGauge
};

