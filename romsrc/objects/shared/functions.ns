				name := cursor:soup():GetName();
				toSoup := GetUnionSoupAlways(name):GetMember(toStore);
				if (Length(selected) = 1) then begin
						self:ForEachSelected(func(a1) begin
							(if (EntryStore(a1) <> toStore) then EntryMoveXmit(a1, toSoup, 'find))
						end)
					end else begin
						self:ForEachSelected(func(a1) begin
							(if (EntryStore(a1) <> toStore) then EntryMove(a1, toSoup))
						end);
						XmitSoupChange(cursor:soup():GetName(), 'unknown, 'whatThe, nil)
					end;
				selected := nil;
				(waitToUnSelect := nil)
			end))
end;

// The finders' delete: the checked entries removed from their soups
// (those on locked stores kept, and the user told), the cached counts
// forgotten.
delete_5 := func() begin
	local somethingLockedSoNotDeleted, somethingDeleted;
	(if selected then begin
			if (Length(selected) = 1) then begin
					self:ForEachSelected(func(a1) begin
						(if EntryStore(a1):IsReadOnly() then (somethingLockedSoNotDeleted := true) else EntryRemoveFromSoupXmit(a1, 'find))
					end)
				end else begin
					self:ForEachSelected(func(a1) begin
						(if EntryStore(a1):IsReadOnly() then (somethingLockedSoNotDeleted := true) else begin
								somethingDeleted := true;
								EntryRemoveFromSoup(a1)
							end)
					end);
					if somethingDeleted then begin
							XmitSoupChange(cursor:soup():GetName(), 'unknown, 'whatThe, nil)
						end
				end;
			selected := nil;
			self.isReset := nil;
			self.zeroOneOrMoreResult := nil;
			self.cacheCount := nil;
			(if somethingLockedSoNotDeleted then GetRoot():Notify(kNotifyAlert, "Find", "At least one item was not deleted because it is on a write-protected store."))
		end)
end;

// The finders' GetTarget: the checked entries - one entry, or a target
// cursor of their aliases of the owner's overviewTargetClass
// ('newtOverview by default); nil for none.
GetTarget := func() begin
	list := [Array: ];
	if selected then begin
			cursor2 := Query(cursor:soup(), '{type: index});
			local list;
			local cursor2;
			(foreach item in selected do begin
					local gotoKey, value;
					gotoKey := cursor2:GotoKey(item._uniqueID);
					(loop begin
							if (gotoKey._uniqueID <> item._uniqueID) then begin
									break (gotoKey := nil)
								end;
							(if (EntryStore(gotoKey):GetSignature() <> item._storeID) then (gotoKey := cursor2:Next()) else break)
						end);
					if gotoKey then begin
							AddArraySlot(list, MakeEntryAlias(gotoKey))
						end
				end)
		end;
	if (Length(list) = 0) then begin
			return nil
		end;
	if (Length(list) = 1) then begin
			return ResolveEntryAlias(list[0])
		end;
	if owner then begin
			value := GetVariable(owner, 'overviewTargetClass)
		end;
	if (value = nil) then begin
			value := 'newtOverview
		end;
	CreateTargetCursor(value, list)
end;

// protoPrefFrame's and protoPrefFramer's viewSetupDoneScript: grow to the
// bottom of the prefPanelProto child when it reaches further.
viewSetupDoneScript := func() begin
	box := self:LocalBox();
	local box;
	local box2;
	(foreach item in self:ChildViewFrames() do begin
			if (item._proto = prefPanelProto) then begin
					box2 := item:LocalBox()
				end
		end);
	(if (if box2 then (box.bottom < box2.bottom)) then SetValue(self, 'viewBounds, RelBounds(0, 0, box.right, box2.bottom)))
end;

// The soup prototypes' (plain and union soups) ...Xmit methods: the method
// without Xmit, then - when given a changeSym - XmitSoupChange with
// 'soupTagsChanged, 'soupIndexAdded or 'soupIndexRemoved.  AddTagsXmit(tags,
// changeSym).
AddTagsXmit := func(a1, a2) begin
	local addTags;
	addTags := self:AddTags(a1);
	if a2 then begin
			XmitSoupChange(self:GetName(), a2, 'soupTagsChanged, self)
		end;
	addTags
end;

// AddIndexXmit(indexSpec, changeSym)
AddIndexXmit := func(a1, a2) begin
	local addIndex;
	addIndex := self:AddIndex(a1);
	if a2 then begin
			XmitSoupChange(self:GetName(), a2, 'soupIndexAdded, {soup: self, indexPath: a1.path})
		end;
	addIndex
end;

// ModifyTagXmit(oldTag, newTag, changeSym)
ModifyTagXmit := func(a1, a2, a3) begin
	local modifyTag;
	modifyTag := self:ModifyTag(a1, a2);
	if a3 then begin
			XmitSoupChange(self:GetName(), a3, 'soupTagsChanged, self)
		end;
	modifyTag
end;

// RemoveTagsXmit(tags, changeSym)
RemoveTagsXmit := func(a1, a2) begin
	local removeTags;
	removeTags := self:RemoveTags(a1);
	if a2 then begin
			XmitSoupChange(self:GetName(), a2, 'soupTagsChanged, self)
		end;
	removeTags
end;

// RemoveIndexXmit(indexPath, changeSym)
RemoveIndexXmit := func(a1, a2) begin
	local removeIndex;
	removeIndex := self:RemoveIndex(a1);
	if a2 then begin
			XmitSoupChange(self:GetName(), a2, 'soupIndexRemoved, {soup: self, indexPath: a1})
		end;
	removeIndex
end;
