// The cursive recogniser's tables, held by charsetInfoResources and
// paragraphData (docs/recognition/README.md): the Letter Shapes slip's
// pictures of each letter's variants (letterimages) and the four binaries
// of the letter table (DTEHeader, DTEMain, PPDMain, and DTETrigrams, the
// 40-symbol trigrams).  Their layouts: tools/tables/README.md.
letterimages := texttable('letterimages, "resources/letterimages/5c2e69.txt");

DTEHeader := texttable('DTEH, "resources/DTEH/5c72b1.txt");

DTEMain := texttable('DTEM, "resources/DTEM/5c73ad.txt");

PPDMain := texttable('PPDB, "resources/PPDB/60a475.txt");

DTETrigrams := texttable('Trigram, "resources/Trigram/623fc9.txt");
