colordataCbits_18 := bitmap('bits, "resources/bits/540635.png", "000000000004000000000000001a0013", 1);

colordataCbits_19 := bitmap('bits, "resources/bits/540c81.png", "000000000004000000000000001b0015", 1);

colordataCbits_20 := bitmap('bits, "resources/bits/541331.png", "000000000004000000000000001a0020", 1);

colordataCbits_21 := bitmap('bits, "resources/bits/54199d.png", "00000000000400000000000000180015", 1);

