colordataCbits_14 := bitmap('bits, "resources/bits/53ea11.png", "00000000000400000000000000190020", 1);

colordataCbits_15 := bitmap('bits, "resources/bits/53f0ad.png", "000000000004000000000000001b0016", 1);

