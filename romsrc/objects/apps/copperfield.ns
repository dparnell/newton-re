							SetRemove((marks := self:Bookmarks()), contain)
						end;
					self:UpdateBookmarks(marks);
					inherited:pickActionScript(index);
					base:SyncView();
					base:RedoChildren();
					base:Parent():Dirty()
				end})
			end;
		if secondMark then begin
				AddArraySlot(self.viewChildren, {_proto: protoMarkButton, thisPage: secondMark})
			end;
		(if firstMark then AddArraySlot(self.viewChildren, {_proto: protoMarkButton, thisPage: firstMark}))
	end,
	viewShowScript: func() begin
		true
	end,
	// Gets the marks and works out which pages showing could be marked and
	// where Return to goes.
	UpDatePrevs: func() begin
		local pageNumsShowingItem;
		marks := self:Bookmarks();
		secondMark := nil;
		firstMark := nil;
		if (pageNumsShowingItem := pageNumsShowing[0]) then begin
				if (not SetContains(marks, pageNumsShowingItem)) then begin
						firstMark := pageNumsShowingItem
					end
			end;
		if (pageNumsShowingItem := pageNumsShowing[1]) then begin
				if (not SetContains(marks, pageNumsShowingItem)) then begin
						secondMark := pageNumsShowingItem
					end
			end;
		if ((recentPage := self:PreviousPage()) = self:CurrentPage()) then begin
				recentPage := 0
			end;
		(if (theKiosk := self:CurrentKiosk()) then (recentKiosk := theKiosk.page) else (recentKiosk := 0))
	end,
	preallocatedContext: 'pageDialog,
	_proto: @protoFloater
};

// the About card: the book's title, author, publisher, copyright and dates.
// A double tap shows a hidden card ("I only ask for information" -
// Copperfield) with a Newt that closes it.
bookAbout := {
	viewBounds: {left: 0, top: 0, right: 200, bottom: 120},
	viewJustify: vjParentCenterH + vjParentCenterV,
	viewFlags: vReadOnly + vClickable + vGesturesAllowed,
	aboutText: nil,
	secret: nil,
	newtPict: @newtonNewtBitmap,
	newtPictBnds: {left: 0, top: -40, right: 79, bottom: -1},
	// Closes the card.
	HideStoryCard: func() begin
		base:Close()
	end,
	// A tap does nothing (but takes the ink off).
	viewClickScript: func(unit) begin
		InkOff(unit);
		nil
	end,
	// Makes the text, or the hidden card's.
	viewSetupChildrenScript: func() begin
		local currentBook, text;
		(if secret then begin
				self.viewChildren := Clone(viewChildren);
				AddArraySlot(viewChildren, {viewClass: clPictureView, viewBounds: newtPictBnds, icon: newtPict, viewFlags: vVisible + vReadOnly + vClickable, viewJustify: vjParentCenterH + vjParentBottomV, viewClickScript: func(unit) begin
					self:HideStoryCard();
					true
				end});
				(aboutText := [Array: {font: @fontSystem10Bold, justification: 'center}, MakeText("\u201C\uI only ask for information\u201D\u", 10, 6, 180, 18), MakeText("- Copperfield", 10, 22, 180, 36)])
			end else begin
				currentBook := self:CurrentBook();
				self.aboutText := [Array: ];
				AddArraySlot(aboutText, {font: @fontSystem10Bold, justification: 'center});
				text := MakeText(self:BookTitle(), 5, 6, 195, 18);
				AddArraySlot(aboutText, text);
				if (if HasPath(currentBook, 'author) then (StrLen(currentBook.author) > 0)) then begin
						AddArraySlot(aboutText, {font: @fontSystem10, justification: 'center});
						text := MakeText(Stringer([Array: "by ", currentBook.author]), 5, 24, 185, 38);
						AddArraySlot(aboutText, text)
					end;
				if HasPath(currentBook, 'publisher) then begin
						text := MakeText(currentBook.publisher, 5, 40, 180, 54);
						AddArraySlot(aboutText, text)
					end;
				if HasPath(currentBook, 'copyright) then begin
						text := MakeText(currentBook.copyright, 5, 56, 185, 70);
						AddArraySlot(aboutText, text)
					end;
				if HasPath(currentBook, 'publicationDate) then begin
						text := MakeText(LongDateStr(currentBook.publicationDate, dateShort), 5, 72, 185, 86);
						AddArraySlot(aboutText, text)
					end;
				(if HasPath(currentBook, 'expirationDate) then begin
						text := MakeText(Stringer([Array: "Expires: ", LongDateStr(currentBook.expirationDate, dateShort)]), 5, 88, 185, 102);
						AddArraySlot(aboutText, text)
					end)
			end)
	end,
	viewDrawScript: func() begin
		self:DrawShape(aboutText, nil)
	end,
	// A double tap shows the hidden card.
	viewgesturescript: func(unit, gesture) begin
		(if (if (gesture = aeDoubleTap) then (not secret)) then begin
				secret := true;
				self:RedoChildren()
			end)
	end,
	// a LongDateStr format spec for the dates
	dateShort: 80492,
	viewQuitScript: func() begin
		RemoveSlot(self, 'aboutText);
		RemoveSlot(self, 'secret);
		RemoveSlot(self, 'viewChildren)
	end,
	debug: 725250,
	preallocatedContext: 'bookAbout,
	_proto: @protoStoryCard
};

// the Display preferences slip: the book's renderings (page sizes), each
// also as a double page if two fit; Choose reopens the book with it
bookPrefs := {
	viewFlags: vReadOnly + vClipping + vClickable,
	viewJustify: vjParentCenterH + vjParentCenterV,
	viewBounds: {left: 0, top: 0, right: 180, bottom: 126},
	index: nil,
	sizesList: nil,
	declareSelf: 'base,
	debug: 725147,
	viewChildren: [viewChildren:
		{title: "Display", _proto: @protoTitle},
		{_proto: @protoCancelButton},
		{
			viewBounds: {left: -49, top: -18, right: -7, bottom: -5},
			viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingLeftH,
			text: choose,
			// Stores the choice in the library entry (flags bit 1: double page,
			// bit 2: single page) and reopens the book.
			buttonClickScript: func() begin
				local libraryEntry, l2, isbn2;
				if ((libraryEntry := self:GetLibraryEntry(isbn)).curRendering <> sizesList[index].rendering) then begin
						libraryEntry.curpage := 1;
						libraryEntry.prevpage := 1;
						libraryEntry.curRendering := sizesList[index].rendering
					end;
				// -4 clears the two page-layout bits
				libraryEntry.flags := BAnd(libraryEntry.flags, -4);
				l2 := 2;
				if (sizesList[index].spread = true) then begin
						l2 := 1
					end;
				libraryEntry.flags := BOr(libraryEntry.flags, l2);
				EntryChange(libraryEntry);
				isbn2 := isbn;
				base:Close();
				GetRoot().copperfield:Close();
				GetRoot().copperfield:OpenBook(isbn2)
			end,
			_proto: @protoTextButton
		},
		{
			viewJustify: vjCenterH,
			viewBounds: {left: 10, top: 16, right: 170, bottom: 16},
			ListItems: nil,
			viewLines: 6,
			// Lists the sizes and selects the current one.
			viewSetupFormScript: func() begin
				l2 := (l1 := self:CurrentBook()).rendering;
				l7 := displayParams;
				l8 := 0;
				ListItems := [Array: ];
				sizesList := [Array: ];
				index := 0;
				Selection := 0;
				local l1;
				local l2;
				local l3;
				local l4;
				local l5;
				local l6;
				local l7;
				local l8;
				(foreach l3 in l2 do begin
						l4 := {width: l3.PageSize.right, height: l3.PageSize.bottom, spread: nil, rendering: l8};
						if (l1.version = 1) then begin
								l4.height := 318
							end;
						AddArraySlot(sizesList, l4);
						if (if (l7.appAreaWidth >= ((l3.PageSize.right * 2) + 15)) then (l7.appAreaHeight >= l3.PageSize.bottom)) then begin
								(l5 := Clone(l4)).spread := true;
								AddArraySlot(sizesList, l5)
							end;
						l8 := (l8 + 1)
					end);
				// looks like a ROM bug: Selection counts the sizes that are not the current
				// rendering rather than finding its index, so the current one is selected
				// only when it is the last in the list
				(foreach l4 in sizesList do begin
						if (l4.rendering <> curRendering) then begin
								Selection := (Selection + 1)
							end;
						l6 := Stringer([Array: NumberStr(l4.width), " ", "x", " ", NumberStr(l4.height)]);
						if (l4.spread = true) then begin
								if (pagesShowing = 2) then begin
										Selection := (Selection + 1)
									end;
								l6 := Stringer([Array: l6, " ", " Double Page"])
							end;
						AddArraySlot(ListItems, l6)
					end);
				self:SetupList()
			end,
			buttonClickScript: func(a1) begin
				(index := a1)
			end,
			_proto: @protoTextList
		}
	],
	preallocatedContext: 'bookPrefs,
	_proto: @protoFloater
};

