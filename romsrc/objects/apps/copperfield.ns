				end})
			end;
		if (Length(marks) > 0) then begin
				AddArraySlot(self.viewChildren, {_proto: @protoPopupButton, viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingLeftH, viewBounds: RelBounds(((-unmarkWidth) - 6), -16, unmarkWidth, 13), text: " Unmark", popup: nil, contains: nil, viewSetupFormScript: func() begin
					popup := [Array: ];
					contains := [Array: ];
					(foreach item in marks do begin
							AddArraySlot(popup, Stringer([Array: "Page", " ", NumberStr(item)]));
