			base:SyncView();
			base:RedoChildren();
			base:Parent():Dirty();
			RefreshViews()
		end,
		viewQuitScript: func() begin
			RemoveSlot(pageDialog, '_defaultButton);
			inherited:?viewQuitScript()
		end
	},
	declareSelf: 'base,
	returnToWidth: 63,
	// Sizes the slip to its buttons and up to two rows of thumbnails.
	viewSetupFormScript: func() begin
		local most, l2, count, l4;
		self:UpDatePrevs();
		l4 := 24;
		if ((recentPage <> 0) or (recentKiosk <> 0)) then begin
				l4 := ((l4 + returnToWidth) + 7)
			end;
		if ((count := Length(marks)) > 0) then begin
				l4 := ((l4 + unmarkWidth) + 7)
			end;
		if firstMark then begin
				l4 := (((l4 + markWidth) + 7) + StrWidth(NumberStr(firstMark)))
			end;
		if secondMark then begin
				l4 := (((l4 + markWidth) + 7) + StrWidth(NumberStr(secondMark)))
			end;
		l2 := 0;
		if (count > 0) then begin
				l2 := 1
			end;
		if (count > 3) then begin
				l2 := 2
			end;
		count := min(3, count);
		most := max(l4, (count * 66));
		l2 := ((((l2 * 98) + 13) + (l2 + 4)) + 6);
		self.viewBounds := RelBounds(0, 0, most, l2);
		SetKeyView(self, nil)
	end,
	viewEffect: 393216,
	unmarkWidth: 52,
	debug: 2649,
	viewFont: @fontSystem9,
	// The thumbnails and buttons.
	viewSetupChildrenScript: func() begin
		self:UpDatePrevs();
		self.viewChildren := [Array: ];
		l1 := 0;
		l2 := 0;
		local l1;
		local l2;
		(foreach item in marks do begin
				AddArraySlot(self.viewChildren, {_proto: @protoBookmark, viewBounds: RelBounds(((l2 * 66) + 2), ((l1 * 97) + 3), 62, 93), icon: self:PageThumbnail(item), text: Stringer([Array: item]), pageNumber: item});
				if ((l2 := (l2 + 1)) >= 3) then begin
						l2 := 0;
						l1 := (l1 + 1)
					end
			end);
		AddArraySlot(self.viewChildren, {_proto: @protoClosebox});
		if ((recentKiosk <> 0) or (recentPage <> 0)) then begin
				AddArraySlot(self.viewChildren, {_proto: @protoPopupButton, text: " Return to", viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingLeftH, viewBounds: RelBounds(((-returnToWidth) - 6), -16, returnToWidth, 13), contains: nil, popup: nil, viewSetupFormScript: func() begin
					popup := [Array: ];
					contains := [Array: ];
					if (if (recentPage <> 0) then (recentPage <> self:CurrentPage())) then begin
