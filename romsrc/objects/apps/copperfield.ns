// the markup layer: an edit view over each page showing, holding that
// page's ink marks
markupLayer := {
	viewClass: clView,
	viewFlags: vClipping + vClickable + vGesturesAllowed,
	protoEditChild: {
		viewClass: clEditView,
		viewFlags: vVisible + vClipping + vClickable + vGesturesAllowed,
		viewAddChildScript: func(aNewOne) begin
			if (Length(viewChildren) = 0) then begin
					markupButton:SetDynamicMarkIcon(1)
				end;
			nil
		end,
		viewDropChildScript: func(a1) begin
			if (Length(viewChildren) = 1) then begin
					markupButton:SetDynamicMarkIcon(0)
				end;
			nil
		end
	},
	// One edit view per page showing, each with its page's marks.
	viewSetupChildrenScript: func() begin
		local pageSize, currentPage, frame2, frame3;
		self.viewChildren := [Array: ];
		pageSize := self:PageSize(nil);
		currentPage := self:CurrentPage();
		frame2 := {_proto: protoEditChild, page: currentPage};
		(if (pagesShowing = 1) then begin
				frame2.viewBounds := RelBounds(0, 0, pageSize.width, pageSize.height);
				frame2.viewChildren := self:InkMarks(frame2.page);
				AddArraySlot(viewChildren, frame2)
			end else (if (currentPage = 1) then begin
					frame2.viewBounds := RelBounds((pageSize.width + 15), 0, pageSize.width, pageSize.height);
					frame2.viewChildren := self:InkMarks(frame2.page);
					AddArraySlot(viewChildren, frame2)
				// looks like a ROM bug: this compares currentPage with a string, then that
				// result with 0, which is never true, so this branch is never taken
				end else (if ((currentPage = Stringer([Array: self:CountPages(), " ", (currentPage mod 2)])) = 0) then begin
						frame2.viewBounds := RelBounds(0, 0, pageSize.width, pageSize.height);
						frame2.viewChildren := self:InkMarks(frame2.page);
						AddArraySlot(viewChildren, frame2)
					end else begin
						frame2.viewBounds := RelBounds(0, 0, pageSize.width, pageSize.height);
						if ((currentPage mod 2) = 1) then begin
								frame2.page := (currentPage - 1)
							end;
						frame2.viewChildren := self:InkMarks(frame2.page);
						AddArraySlot(viewChildren, frame2);
						frame3 := {_proto: protoEditChild};
						if ((currentPage mod 2) = 0) then begin
								frame3.page := (currentPage + 1)
							end;
						frame3.viewBounds := RelBounds((pageSize.width + 15), 0, pageSize.width, pageSize.height);
						frame3.viewChildren := self:InkMarks(frame3.page);
						AddArraySlot(viewChildren, frame3)
					end)))
	end,
	viewSetupFormScript: func() begin
		local pageSize;
		pageSize := self:PageSize(nil);
		(if (pagesShowing = 1) then (self.viewBounds := RelBounds(0, 0, pageSize.width, pageSize.height)) else (self.viewBounds := RelBounds(0, 0, ((pageSize.width * 2) + 15), pageSize.height)))
	end,
	viewShowScript: func() begin
		true
	end,
	// Saves each page's marks (the native AddInkMarks).
	SaveMarks: func() begin
		(foreach item in viewChildren do begin
				if item.viewChildren then begin
						self:AddInkMarks(item.page, item.viewChildren)
					end
			end)
	end,
	debug: 75348,
	preallocatedContext: 'markupLayer
};

