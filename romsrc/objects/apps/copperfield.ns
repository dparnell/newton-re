							AddArraySlot(contains, 0)
						end;
					(if (recentKiosk <> 0) then begin
							AddArraySlot(popup, self:CurrentKiosk().name);
							AddArraySlot(contains, 1)
						end)
				end, pickActionScript: func(index) begin
					local contain;
					if ((contain := contains[index]) = 0) then begin
							self:TurnToPage(recentPage)
						end else begin
