// copperfield: the Book Reader ('copperfield, after the code name), the
// protoBook view in which a Newton book (a book package, found by its isbn)
// is read. Much of it is native (the {class: #132, funcPtr: ...} slots:
// PrepBookX, ScrollPage, BookTitle, Bookmarks, InkMarks, ...). It keeps a
// "Library" soup on the internal store with an entry per book (current
// page, rendering, flags), shows one or two pages at a time, has a status
// bar (full, or a small one that collapses when the screen is too short),
// a markup layer for ink notes on pages, bookmarks (pageDialog), a
// go-to-page slip, an About card and a Display preferences slip.

copperfield := {
	// Readies book isbn before opening: its library entry's rendering, the
	// native PrepBookX; a help book or one with flag 64 follows screen
	// rotation (reopening itself), others cannot be rotated.
	PrepBook: compile(
		constants: {
			kFunction_51bdf9: func() begin
				true
			end
		},
		func(isbn) begin
			local libraryEntry, currentBook;
			self.isbn := isbn;
			libraryEntry := self:GetLibraryEntry(isbn);
			self.curRendering := libraryEntry.curRendering;
			self:PrepBookX(isbn);
			(if ((if ((currentBook := self:CurrentBook()).version > 1) then (currentBook.help = true)) or (if currentBook.flags then (BAnd(currentBook.flags, 64) <> 0))) then begin
					self.ReOrientToScreen := _ReOrientToScreen;
					(GetRoot().theBrowser.ReOrientToScreen := kFunction_51bdf9)
				end else RemoveSlot(self, 'ReOrientToScreen))
		end),
	// Removes the library entry of the least recently used offline book, once
	// eight offline books are remembered.
	RemoveOldestBook: func() begin
		// later than any entry's modification time
		entryModTime22 := 535999999;
		l2 := 0;
		local entryModTime22;
		local l2;
		local entryModTime2;
		local item2;
		local offlineBooks;
		(foreach item in (offlineBooks := self:GetOfflineBooks()) do begin
				l2 := (l2 + 1);
				if ((entryModTime2 := EntryModTime(item)) < entryModTime22) then begin
						entryModTime22 := entryModTime2;
						item2 := item
					end
			end);
		(if (l2 = 8) then EntryRemoveFromSoup(item2))
	end,
	pageSound: @flip,
	pagesShowing: 1,
	// Saves the ink marks if the markup layer is open.
	SaveMarkup: func() begin
		(if Visible(markupLayer) then markupLayer:SaveMarks())
	end,
	// After a rotation: reopens the book at the first rendering whose page
	// fits the new application area.
	_ReOrientToScreen: func() begin
		(if (currentBook := self:CurrentBook()) then begin
				self:Close();
				self:viewPreOpenScript(currentBook.isbn);
				l3 := (displayParams2 := displayParams).appAreaWidth;
				appAreaHeight := displayParams2.appAreaHeight;
				local currentBook;
				local displayParams2;
				local l3;
				local appAreaHeight;
				local pageSize;
				(for i := 0 to (Length(currentBook.rendering) - 1) do begin
						if (if ((pageSize := self:PageSize(i)).width <= l3) then (pageSize.height <= appAreaHeight)) then begin
								if (i <> curRendering) then begin
										curRendering := i;
										self:ResetCachedPages(currentBook.isbn);
										break
									end
							end
					end);
				self:Open()
			end)
	end,
	// HideMarkup, ShowMarkup: close or open the markup layer.
	HideMarkup: func() begin
		self:SaveMarkup();
		contentArea:HideMarkup();
		markupLayer:Close()
	end,
	// The routing target: the book's title, isbn, pages, current page, print
	// data and ink marks, as a 'copperfield frame.
	GetTargetInfo: func(a1) begin
		local frame2;
		self:SaveMarkup();
		(frame2 := {}).class := 'copperfield;
		frame2.title := self:BookTitle();
		frame2.isbn := isbn;
		frame2.CurrentPage := self:CurrentPage();
		frame2.fromPage := frame2.CurrentPage;
		frame2.nPages := self:CountPages();
		frame2.toPage := frame2.nPages;
		frame2.printData := contentArea:?BookPrint();
		frame2.curRendering := curRendering;
		frame2.printMarks := copperfield:InkMarks(nil);
		{target: frame2, targetView: targetView}
	end,
	// Takes the book's browsers (its contents outlines) and flags and turns to
	// its first page, or redisplays the current one.
	viewSetupDoneScript: func() begin
		local currentBook;
		browserRefnum := (Length((browsers := Clone((currentBook := self:CurrentBook()).browsers))) - 1);
		self.targetView := contentArea;
		if HasPath(currentBook, 'flags) then begin
				self.bookFlags := currentBook.flags
			end;
		(if (self:CurrentPage() = 0) then self:TurnToPage(1) else self:ScrollPage(0))
	end,
	// Gives the status bar new left and right buttons (a book's script asks).
	SetStatusBarButtons: func(a1) begin
		cntrlPanel:SetStatusBarButtons(a1)
	end,
	BookOKClose: func() begin
		contentArea:BookOKClose()
	end,
	// A view that wants the scroll arrows for itself (or nil to give them back).
	ScrollReceiver: func(a1) begin
		(scrollStealer := a1)
	end,
	ShowMarkup: func() begin
		self:HideStoryCard();
		contentArea:ShowMarkup();
		markupLayer:Open()
	end,
	// Closing: saves the marks, tells the book, and forgets the book's state
	// and the slots it added.
	viewQuitScript: func() begin
		self:CloseBrowser();
		contentArea:bookHideScript();
		self:SaveMarkup();
		self:BookClosed();
		isbn := nil;
		browsers := nil;
		targetView := nil;
		bookFlags := 0;
		viewChildren := nil;
		curRendering := 0;
		if (not floating) then begin
				RemoveSlot(self, 'viewFormat);
				RemoveSlot(self, 'viewEffect)
			end;
		if (cntrlPanel exists) then begin
				cntrlPanel := nil
			end;
		if (markupButton exists) then begin
				markupButton := nil
			end;
		if (pageNumber exists) then begin
				pageNumber := nil
			end;
		if (bookAbout exists) then begin
				bookAbout := nil
			end;
		RemoveSlot(self, 'pageNumsShowing);
		RemoveSlot(self, 'title);
		(if HasPath(self, 'routeScripts) then begin
				(foreach item in routeScripts do begin
						RemoveSlot(self, item.routeScript)
					end);
				RemoveSlot(self, 'routeScripts)
			end)
	end,
	// Installs a book's routing actions (a1): each routeScript becomes a method
	// of the base that performs it in the content area.
	AddBookRouting: func(a1) begin
		local scriptSym;
		if HasPath(base, 'routeScripts) then begin
				(foreach item in routeScripts do begin
						RemoveSlot(base, item.routeScript)
					end);
				RemoveSlot(base, 'routeScripts)
			end;
		(if (Length(a1) > 0) then begin
				base.routeScripts := TotalClone(a1);
				(foreach item in base.routeScripts do begin
						scriptSym := item.routeScript;
						base.(scriptSym) := func(a1, a2) begin
							Perform(contentArea, scriptSym, [Array: a1, a2])
						end
					end)
			end)
	end,
	// Two pages: a line between them.
	viewDrawScript: func() begin
		local pageSize, l2;
		(if (pagesShowing = 2) then self:DrawShape(MakeLine((l2 := ((pageSize := self:PageSize(nil)).width + 7)), 0, l2, pageSize.height), nil))
	end,
	SetMarkIcon: func() begin
		(if (panelOpen = true) then markupButton:SetMarkIcon())
	end,
	// Removes the book's browser of refNum a1 (closing it if it is showing).
	RemoveBrowser: func(a1) begin
		(foreach item in browsers do begin
				if (item.refNum = a1) then begin
						if browser.viewCObject then begin
								if (browsers[browser.paneIndex] = item) then begin
										browser:Close()
									end
							end;
						SetRemove(browsers, item)
					end
			end);
		nil
	end,
	viewFlags: vApplication + vClipping + vClickable,
	SetBrowserPosition: func() begin
		(if Visible(browser) then browser.Outline:ScrollToCurrent(browser.Outline))
	end,
	ScrollPage: {class: #132, funcPtr: 6976411, numArgs: 1},
	// The library entry of book isbn.
	GetLibraryEntry: func(isbn) begin
		local cursor, l2;
		l2 := (cursor := self:CreateGetSoup():Query({type: 'text, text: isbn})):entry();
		cursor := nil;
		l2
	end,
	PageCThumbnail: {class: #132, funcPtr: 6976412, numArgs: 1},
	BookTitle: {class: #132, funcPtr: 6957403, numArgs: 0},
	pageNumsShowing: [|Array|: 0, nil],
	viewBounds: copperfieldViewBounds,
	// Matches the library soup against the books installed (packages and 1.x
	// parts): marks each entry present (bookPresent 1) or not, and returns
	// {online, offline}.
	VerifyLibrarySoup: func() begin
		local theISBNs, onlines, offlines;
		theISBNs := [Array: ];
		onlines := [Array: ];
		offlines := [Array: ];
		MapCursor((partCursor := GetRoot().ExtrasDrawer:GetPartCursor(nil, nil, nil)), func(a1) begin
			local l1;
			l1 := (not EntryIsResident(a1));
			if HasSlot(a1, 'isbn) then begin
					if a1.isbn then begin
							AddArraySlot(theISBNs, a1.isbn)
						end
				end;
			if l1 then begin
					EntryUndoChanges(a1)
				end;
			nil
		end);
		local partCursor;
		(foreach item in GetGlobals().|Parts1.x| do begin
				local cursor;
				if HasSlot(item, 'isbn) then begin
						if item.isbn then begin
								AddArraySlot(theISBNs, item.isbn)
							end
					end
			end);
		MapCursor((cursor := self:CreateGetSoup():Query({})), func(a1) begin
			(if LSearch(theISBNs, a1.isbn, 0, '|str=|, nil) then begin
					AddArraySlot(onlines, a1);
					(if (a1.bookPresent = 0) then begin
							a1.bookPresent := 1;
							EntryChange(a1)
						end)
				end else begin
					AddArraySlot(offlines, a1);
					(if (a1.bookPresent = 1) then begin
							a1.bookPresent := 0;
							EntryChange(a1)
						end)
				end)
		end);
		{online: onlines, offline: offlines}
	end,
	appObject: [|Array|: book, "Books"],
	bookFlags: 0,
	PrepBookX: {class: #132, funcPtr: 6978497, numArgs: 1},
	isbn: nil,
	// Before opening: a1 is the book's isbn or a frame with it.
	viewPreOpenScript: func(a1) begin
		(if (ClassOf(a1) = 'frame) then self:PrepBook(a1.isbn) else self:PrepBook(a1))
	end,
	// Records the page numbers showing and shows them on the status bar.
	SetPageNumber: func(a1, a2) begin
		pageNumsShowing := [Array: a1, a2];
		(if (panelOpen = true) then pageNumber:SetPageNumber(a1, a2))
	end,
	scrollStealer: nil,
	GetOnlineBooks: func() begin
		self:VerifyLibrarySoup().online
	end,
	// OpenIndex: no index in this reader.
	OpenIndex: func() begin
		nil
	end,
	// The scroll arrows turn a page (two when two are showing), or go to the
	// view that took them (PostCommand 46 and 45 are the view system's scroll
	// down and scroll up commands).
	viewScrollDownScript: func() begin
		(if (scrollStealer <> nil) then PostCommand(scrollStealer, 46) else begin
				if Visible(pageDialog) then begin
						pageDialog:Close()
					end;
				if Visible(pageNumberDialog) then begin
						pageNumberDialog:Close()
					end;
				if ((pagesShowing = 1) or (self:CurrentPage() = 1)) then begin
						self:ScrollPage(1)
					end else begin
						self:ScrollPage(2)
					end;
				(if Visible(markupLayer) then contentArea:ShowMarkup())
			end)
	end,
	// The overview button: shows or hides the contents browser.
	viewOverviewScript: func() begin
		if Visible(pageDialog) then begin
				pageDialog:Close()
			end;
		if Visible(pageNumberDialog) then begin
				pageNumberDialog:Close()
			end;
		browser:Toggle()
	end,
	appSymbol: 'copperfield,
	panelOpen: true,
	PageContents: {class: #132, funcPtr: 7023995, numArgs: 1},
	browserRefnum: 0,
	UpdateBookmarks: {class: #132, funcPtr: 7025042, numArgs: 1},
	viewScrollUpScript: func() begin
		(if (scrollStealer <> nil) then PostCommand(scrollStealer, 45) else begin
				if Visible(pageDialog) then begin
						pageDialog:Close()
					end;
				if Visible(pageNumberDialog) then begin
						pageNumberDialog:Close()
					end;
				if ((pagesShowing = 1) or (self:CurrentPage() = 2)) then begin
						self:ScrollPage(-1)
					end else begin
						self:ScrollPage(-2)
					end;
				(if Visible(markupLayer) then contentArea:ShowMarkup())
			end)
	end,
	curRendering: 0,
	// Sizes and places the reader (BuildDisplayParams): a page smaller than the
	// screen floats in a frame.
	viewSetupFormScript: func() begin
		self:BuildDisplayParams();
		self.viewBounds := RelBounds(dpCu.left, dpCu.top, dpCu.width, dpCu.height);
		if (floating = 'Partial) then begin
				viewFormat := vfFillWhite + vfFrameBlack + vfPen(2) + vfInset(2);
				viewEffect := 133120
			end else begin
				if (floating = nil) then begin
						viewFormat := vfFillWhite + vfFrameBlack;
						viewEffect := 133120
					end else begin
						RemoveSlot(self, 'viewFormat);
						RemoveSlot(self, 'viewEffect)
					end
			end;
		CuPage := self;
		self.browser := GetRoot().theBrowser;
		self.title := self:BookTitle();
		SetKeyView(self, 0)
	end,
	InkMarks: {class: #132, funcPtr: 6973246, numArgs: 1},
	// Sends book isbn back to its first page (when its rendering changes).
	ResetCachedPages: func(isbn) begin
		local libraryEntry;
		(libraryEntry := self:GetLibraryEntry(isbn)).curpage := 1;
		libraryEntry.prevpage := 1;
		EntryChange(libraryEntry)
	end,
	bookmarking: nil,
	// Opens the contents browser on pane a1.
	OpenBrowser: func(a1) begin
		browser.paneIndex := a1;
		browser.curIndex := 0;
		browser:Open()
	end,
	AddBookmark: {class: #132, funcPtr: 6956332, numArgs: 1},
	// Before routing: the book's title, with its marks saved.
	SetupRoutingSlip: func(fields) begin
		if (isbn = nil) then begin
				self:Notify(kNotifyAlert, "Book", "No book open to print");
				return nil
			end;
		fields.title := self:BookTitle();
		self:SaveMarkup()
	end,
	GetOfflineBooks: func() begin
		self:VerifyLibrarySoup().offline
	end,
	// Works out dpCu, where the reader goes: two pages side by side if there is
	// room (unless the user chose single pages, flag 2), the status bar below
	// (fullBar) if there is room for it, and whether the reader floats.
	BuildDisplayParams: func() begin
		local displayParams2, pageSize, libraryEntry, appAreaHeight;
		displayParams2 := displayParams;
		(pageSize := self:PageSize(nil)).width := min(pageSize.width, displayParams2.appAreaWidth);
		pageSize.height := min(pageSize.height, displayParams2.appAreaHeight);
		libraryEntry := self:GetLibraryEntry(isbn);
		appAreaHeight := (pageSize.height + 18);
		self.dpCu := {};
		if (pagesShowing <> 1) then begin
				pagesShowing := 1
			end;
		if (if (displayParams2.appAreaWidth >= ((pageSize.width * 2) + 15)) then (displayParams2.appAreaHeight >= pageSize.height)) then begin
				if (BAnd(libraryEntry.flags, 2) = 0) then begin
						pagesShowing := 2
					end
			end;
		dpCu.fullBar := true;
		if (displayParams2.appAreaHeight < appAreaHeight) then begin
				dpCu.fullBar := nil;
				appAreaHeight := displayParams2.appAreaHeight
			end;
		(if (if (displayParams2.appAreaWidth >= pageSize.width) then (displayParams2.appAreaHeight >= appAreaHeight)) then begin
				dpCu.left := (((displayParams2.appAreaWidth - pageSize.width) - 6) div 2);
				if (dpCu.fullBar = nil) then begin
						dpCu.top := 0
					end else begin
						dpCu.top := ((((displayParams2.appAreaHeight - pageSize.height) - 18) - 6) - 4);
						dpCu.top := max(0, dpCu.top);
						dpCu.top := (dpCu.top div 2)
					end;
				if (pagesShowing = 2) then begin
						dpCu.left := (((self.dpCu.left - pageSize.width) - 15) - 6);
						dpCu.width := ((pageSize.width * 2) + 15)
					end else begin
						dpCu.width := pageSize.width
					end;
				dpCu.height := appAreaHeight;
				(if (if (displayParams2.appAreaHeight = appAreaHeight) then (displayParams2.appAreaWidth = pageSize.width)) then (self.floating := nil) else (if ((displayParams2.appAreaHeight = appAreaHeight) or (displayParams2.appAreaWidth = pageSize.width)) then (self.floating := 'Partial) else (self.floating := true)))
			end else begin
				dpCu.left := 0;
				if (displayParams2.fullBar = nil) then begin
						dpCu.top := 0
					end else begin
						dpCu.top := ((displayParams2.appAreaHeight - pageSize.height) - 18)
					end;
				self.floating := nil;
				dpCu.width := pageSize.width;
				(dpCu.height := appAreaHeight)
			end)
	end,
	// The page size of rendering i (the current one by default); a version 1
	// book's pages are 318 high.
	PageSize: func(i) begin
		local currentBook, pageSize, frame2;
		currentBook := self:CurrentBook();
		if (not i) then begin
				i := curRendering
			end;
		frame2 := {width: (pageSize := currentBook.rendering[i].PageSize).right, height: pageSize.bottom};
		if (currentBook.version = 1) then begin
				frame2.height := 318
			end;
		frame2
	end,
	CloseBrowser: func() begin
		(if Visible(browser) then browser:Close())
	end,
	PreviousPage: {class: #132, funcPtr: 6978501, numArgs: 0},
	debug: 67840,
	Bookmarks: {class: #132, funcPtr: 6957402, numArgs: 0},
	// Adds a browser a1 to the book and returns its refNum.
	AddBrowser: func(a1) begin
		local copy;
		if (not HasPath((copy := Clone(a1)), 'dynamic)) then begin
				copy.dynamic := true
			end;
		browserRefnum := (browserRefnum + 1);
		copy.refNum := browserRefnum;
		AddArraySlot(browsers, copy);
		browserRefnum
	end,
	// Opens book isbn, closing another book first.
	OpenBook: func(isbn) begin
		if (self.viewCObject = nil) then begin
				self:PrepBook(isbn);
				self:Open()
			end else begin
				if (if (self.isbn <> nil) then (not StrEqual(isbn, self.isbn))) then begin
						self:Close();
						self:PrepBook(isbn);
						self:Open()
					end
			end;
		RefreshViews()
	end,
	// The content area and slips, and the status bar that fits.
	viewSetupChildrenScript: func() begin
		self.viewChildren := Clone(kids);
		(if (dpCu.fullBar = true) then AddArraySlot(viewChildren, fullCtrlPanel) else begin
				AddArraySlot(viewChildren, miniCtrlPanel);
				(panelOpen := nil)
			end)
	end,
	// Shows the content.
	viewShowScript: func() begin
		contentArea:bookShowScript()
	end,
	// A 60 by 80 thumbnail of page item, for a bookmark.
	PageThumbnail: func(item) begin
		local pageCThumbnail, bitmap;
		pageCThumbnail := self:PageCThumbnail(item);
		bitmap := MakeBitmap(60, 80, nil);
		pageCThumbnail:ViewIntoBitmap(nil, nil, bitmap);
		pageCThumbnail:Close();
		bitmap
	end,
	BookClosed: {class: #132, funcPtr: 6957401, numArgs: 0},
	browsers: nil,
	AddInkMarks: {class: #132, funcPtr: 6956344, numArgs: 2},
	// The "Library" soup on the internal store, made if missing.
	CreateGetSoup: func() begin
		local store, soup;
		store := GetStores()[0];
		if ((soup := store:GetSoup("Library")) = nil) then begin
				soup := store:CreateSoup("Library", [Array: {structure: 'slot, path: 'isbn, type: 'string}, {structure: 'slot, path: 'bookPresent, type: 'int}])
			end;
		soup
	end,
	_keyCommands: [|Array|:
		{
			// command-R, -M, -B, -G
			char: $r,
			modifiers: kCommandModifier,
			keyMessage: '_keyButtonRouteScript,
			name: route,
			category: routing
		},
		{
			char: $m,
			modifiers: kCommandModifier,
			keyMessage: '_keyButtonMarkupScript,
			name: "Markup",
			category: editing
		},
		{
			char: $b,
			modifiers: kCommandModifier,
			keyMessage: '_keyButtonBookMarkScript,
			name: "Bookmarks",
			category: viewing
		},
		{
			char: $g,
			modifiers: kCommandModifier,
			keyMessage: '_keyButtonGotoScript,
			name: "Go to",
			category: viewing
		}
	],
	// The command keys' scripts: press the Go to, Bookmarks, Markup and
	// routing buttons.
	_keyButtonGotoScript: func(a1) begin
		PressButton(pageNumber)
	end,
	_keyButtonBookMarkScript: func(a1) begin
		pageDialog:Toggle()
	end,
	_keyButtonMarkupScript: func(a1) begin
		PressButton(markupButton)
	end,
	_keyButtonRouteScript: func(a1) begin
		PressButton(routingButton)
	end,
	routingButton: nil,
	contentArea: nil,
	allocateContext: [|Array|:
		'contentArea,
		protoContentArea,
		'markupLayer,
		markupLayer,
		'pageNumberDialog,
		pageNumberDialog,
		'pageDialog,
		pageDialog,
		'bookAbout,
		bookAbout,
		'bookPrefs,
		bookPrefs
	],
	markupLayer: nil,
	// the full status bar: close box, routing, markup, bookmark, page number and
	// info buttons, and any the book adds (leftButtons, rightButtons)
	fullCtrlPanel: {
		viewSetupChildrenScript: func() begin
			self.viewChildren := Clone(kids);
			if (not stepChildren) then begin
					stepChildren := [Array: ]
				end else begin
					self.stepChildren := [Array: ]
				end;
			if leftButtons then begin
					(foreach key, value in leftButtons do begin
							if (if HasPath(value, 'text) then HasPath(value, 'viewFont)) then begin
									l4 := (StrFontWidth(value.text, value.viewFont) + 6)
								end else begin
									l4 := (value.viewBounds.right - value.viewBounds.left)
								end;
							AddArraySlot(stepChildren, (if (key > 0) then {_proto: value, viewBounds: RelBounds(6, 0, l4, 13), viewJustify: vjCenterH + vjCenterV + vjSiblingRightH + vjSiblingTopV} else {_proto: value, viewBounds: RelBounds(65, 2, l4, 13), viewJustify: vjCenterH + vjCenterV}))
						end)
				end;
			(if rightButtons then (foreach key, value in rightButtons do begin
						local l4;
						if (if HasPath(value, 'text) then HasPath(value, 'viewFont)) then begin
								l4 := (StrFontWidth(value.text, value.viewFont) + 6)
							end else begin
								l4 := (value.viewBounds.right - value.viewBounds.left)
							end;
						AddArraySlot(stepChildren, (if (key > 0) then {_proto: value, viewBounds: RelBounds(((-l4) - 6), 0, l4, 13), viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH + vjSiblingTopV} else {_proto: value, viewBounds: RelBounds(((-l4) - 48), 2, l4, 13), viewJustify: vjCenterH + vjCenterV + vjParentRightH}))
					end))
		end,
		viewShowScript: func() begin
			true
		end,
		viewSetupDoneScript: func() begin
			(copperfield.cntrlPanel := self)
