	off: @noMarkupBitmap,
	offWith: {
		mask: onWithMask,
		bits: bitmap('bits, "resources/bits/51e765.png", "0000000000040036003600a2004700b3", 1),
		bounds: {left: 0, top: 0, right: 17, bottom: 17}
	},
	state: 'off,
	viewSetupFormScript: func() begin
		(if miniBar then begin
