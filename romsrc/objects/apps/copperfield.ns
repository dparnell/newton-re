			buttonClickScript: func() begin
				local l1, l2, l3;
				if ((l1 := self:GetLibraryEntry(isbn)).curRendering <> sizesList[index].rendering) then begin
						l1.curpage := 1;
						l1.prevpage := 1;
						l1.curRendering := sizesList[index].rendering
					end;
				l1.flags := BAnd(l1.flags, -4);
				l2 := 2;
				if (sizesList[index].spread = true) then begin
						l2 := 1
					end;
				l1.flags := BOr(l1.flags, l2);
				EntryChange(l1);
				l3 := isbn;
				base:Close();
				GetRoot().copperfield:Close();
				GetRoot().copperfield:OpenBook(l3)
			end,
			_proto: @protoTextButton
		},
		{
			viewJustify: vjCenterH,
			viewBounds: {left: 10, top: 16, right: 170, bottom: 16},
			ListItems: nil,
			viewLines: 6,
			viewSetupFormScript: func() begin
				l2 := (l1 := self:CurrentBook()).rendering;
				l7 := displayParams;
				l8 := 0;
				ListItems := [Array: ];
				sizesList := [Array: ];
				index := 0;
				Selection := 0;
				local l1;
				local l2;
				local l3;
				local l4;
				local l5;
				local l6;
				local l7;
				local l8;
				(foreach l3 in l2 do begin
						l4 := {width: l3.PageSize.right, height: l3.PageSize.bottom, spread: nil, rendering: l8};
						if (l1.version = 1) then begin
								l4.height := 318
							end;
						AddArraySlot(sizesList, l4);
						if (if (l7.appAreaWidth >= ((l3.PageSize.right * 2) + 15)) then (l7.appAreaHeight >= l3.PageSize.bottom)) then begin
								(l5 := Clone(l4)).spread := true;
								AddArraySlot(sizesList, l5)
							end;
						l8 := (l8 + 1)
					end);
				(foreach l4 in sizesList do begin
						if (l4.rendering <> curRendering) then begin
								Selection := (Selection + 1)
							end;
						l6 := Stringer([Array: NumberStr(l4.width), " ", "x", " ", NumberStr(l4.height)]);
						if (l4.spread = true) then begin
								if (pagesShowing = 2) then begin
										Selection := (Selection + 1)
									end;
								l6 := Stringer([Array: l6, " ", " Double Page"])
							end;
						AddArraySlot(ListItems, l6)
					end);
				self:SetupList()
			end,
			buttonClickScript: func(a1) begin
				(index := a1)
			end,
			_proto: @protoTextList
		}
	],
	preallocatedContext: 'bookPrefs,
	_proto: @protoFloater
};

