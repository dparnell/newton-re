				self:SetMarkIcon()
			end)
	end,
	viewSetupDoneScript: func() begin
		(copperfield.markupButton := self)
	end,
	buttonClickScript: func() begin
		if (state = 'on) then begin
				self:Parent():HideMarkup();
				state := 'off
			end else begin
				self:Parent():ShowMarkup();
				state := 'on
			end;
		self:SetMarkIcon()
	end,
	// Shows the icon for the state and whether count marks are on the page.
	SetDynamicMarkIcon: func(count) begin
		if (state = 'off) then begin
				if (count <> 0) then begin
						self.icon := offWith
					end else begin
						self.icon := off
					end
			end else begin
				if (count <> 0) then begin
						self.icon := onWith
					end else begin
						self.icon := on
					end
			end;
		self:Dirty()
	end,
	// Sets the icon from the marks on the page showing.
	SetMarkIcon: func() begin
		local count;
		if pageNumsShowing[0] then begin
				count := Length(self:InkMarks(pageNumsShowing[0]))
			end else begin
				count := Length(self:InkMarks(pageNumsShowing[1]))
			end;
		self:SetDynamicMarkIcon(count)
	end,
	debug: 18878,
	_proto: @protoPictureButton
};

