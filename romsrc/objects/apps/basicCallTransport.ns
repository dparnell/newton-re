				end,
				DefaultProvider: func() begin
					local currentDialSpeaker2, currentDialSpeaker;
					if ((((not (currentDialSpeaker := GetTAPICommFrame((currentDialSpeaker2 := GetUserConfig('currentDialSpeaker))))) or (not currentDialSpeaker.config)) or (not currentDialSpeaker.config.supportsEventIncoming)) or (not transport:GetConfig('phoneAutoReceive))) then begin
							currentDialSpeaker2 := nil
						end;
					transport:SetConfig('phoneAutoReceive, (currentDialSpeaker2 <> nil));
					currentDialSpeaker2
