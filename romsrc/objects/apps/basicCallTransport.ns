	end,
	speakerNeedsReset: nil,
	lastRing: nil,
	dismissCall: nil,
	GetItemTitle: func(a1) begin
		local title, l2, l3;
		if ((title := a1.title) = nil) then begin
				l2 := (if StrFilled(a1.name) then a1.name else (if StrFilled(a1.phoneNumber) then a1.phoneNumber));
				l3 := (a1.state = 'Received);
				if l2 then begin
						if l3 then begin
								title := ParamStr("Call from ^0", [Array: l2])
							end else begin
								title := ParamStr("Call to ^0", [Array: l2])
							end
					end else begin
						if l3 then begin
								title := "Call received"
							end else begin
								title := "Call placed"
							end
					end
			end;
		title
	end,
	DelayDialing: func(outgoingNeededDelay) begin
		(try begin
				if abortCall then begin
						status := 'cancelling;
						self:CancelRequest('userCancel);
						return nil
					end;
				(if (outgoingNeededDelay > 0) then begin
						self:SetStatus('Connecting, {statusText: (if (outgoingNeededDelay > 1) then ParamStr("^0 seconds to dialing\u2026\u", [Array: NumberStr(outgoingNeededDelay)]) else "1 second to dialing\u2026\u"), primary: {text: "Stop", script: func() begin
							(GetRoot().(appSymbol).abortCall := true)
						end}});
						AddDelayedCall(func(a1) begin
							self:DelayDialing(a1)
						end, [Array: (outgoingNeededDelay - 1)], 1000)
					end else self:FinishDialing())
			end onexception |evt.ex| do begin
				(if self:HandleThrow() then self:Shutdown())
			end)
	end,
	ConnectionDetect: func() begin
		'Now
	end,
	currentItem: nil,
	StopEventIncoming: func() begin
		local l1;
