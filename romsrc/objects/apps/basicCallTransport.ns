	end,
	abortCall: nil,
	callEndpoint: nil,
	preferencesForm: {
		viewBounds: {left: 0, top: 0, right: 215, bottom: 130},
		viewJustify: vjParentCenterH + vjParentCenterV,
		overview: phoneHome,
		appSymbol: '|PhoneHome:Newton|,
		wasAutoReceive: nil,
