phoneHome := "PhoneHome";

logcheck := {
	viewBounds: {left: 0, top: 0, right: 57, bottom: 0},
	viewJustify: 8401924,
	viewValue: nil,
	buttonValue: true,
	viewFlags: vVisible + vClickable,
	text: log,
	prepareThyself: func() begin
		(if fields.fromCallApp then begin
				viewFlags := 0;
				(fields.saveAsLog := true)
