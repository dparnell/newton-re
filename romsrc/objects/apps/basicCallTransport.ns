		GetRoot().(appSymbol):DialingComplete(error)
	end,
	GetStatusString: func() begin
		local text, name;
		text := inherited:?GetStatusString();
		if ((((status = 'DialingTo) or (status = 'DialingDoneTo)) or (status = 'DialingDoneFrom)) or (status = 'RingingFrom)) then begin
				if StrFilled((name := currentItem.name)) then begin
						text := ParamStr(text, [Array: name])
					end else begin
