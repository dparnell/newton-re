			end)
	end,
	DialingComplete: func(error) begin
		local numberToDial, frame2, l3, l4;
		if (currentItem = nil) then begin
				return nil
			end;
		(try begin
				if error then begin
						Throw('|evt.ex.comm|, error)
					end;
				(if (status <> 'DialingDoneTo) then begin
						currentItem.startTime := TimeInSeconds();
						frame2 := {keyedDigits: (numberToDial := currentItem.numberToDial), SpeakerToggle: transportProvider.config.supportsSpeaker, closeBox: func() begin
							GetRoot().(appSymbol):CloseStatusDialog(nil)
						end};
						l3 := nil;
						if currentItem.saveAsLog then begin
								frame2.primary := nil;
								if (StrFilled(numberToDial) or (status <> 'DialingTo)) then begin
										l3 := true
									end
							end;
						l4 := (if (status = 'DialingTo) then 'DialingDoneTo else 'DialingDoneFrom);
						(if l3 then begin
								self:CloseStatusDialog(nil);
								self:UpdateStatusSlots(l4, 'vPhoneKeypad, frame2);
								(userClosedStatus := nil)
							end else self:SetStatusDialog(l4, 'vPhoneKeypad, frame2))
					end)
			end onexception |evt.ex| do begin
				(if self:HandleThrow() then self:Shutdown())
			end)
	end,
	SendRequest: func(request) begin
		local routingInfoItem;
		if (request.cause = 'submit) then begin
				return nil
			end;
		if currentItem then begin
				if (status = 'RingingFrom) then begin
						self:SetStatus(status, nil);
						dismissCall := nil;
						self:EventIncoming();
						return nil
					end else begin
						self:ItemCompleted(currentItem, nil, nil)
					end
			end;
		if ((currentItem := self:ItemRequest(request)).serviceProvider = nil) then begin
				currentItem.startTime := TimeInSeconds();
				status := 'DialingDoneTo;
				return nil
			end;
		routingInfoItem := GetDataDefs('|nameRef.phone|):GetRoutingInfo(currentItem.toRef[0])[0];
		currentItem.numberToDial := routingInfoItem.phoneNumber;
		// DEVIATION (host addition): a provider whose config says dialsAsWritten
		//  - the host's cellular one (comms/host/HostCell.ns) - is given the
		//  number as the card has it, not as the worksite's dialling rules make
		//  it: a mobile network takes "0412 345 678" or "+61 412 345 678" as
		//  they are, and the rules - a landline's area code and a card's
		//  country - turned an Australian mobile number into a local call
		//  stripped of its "04", or an international call to the US
		//  (docs/host-tdeck-pro-phone.md).  Other providers dial as the ROM does.
		local dialProvider := GetTAPICommFrame(currentItem.serviceProvider);
		if dialProvider and dialProvider.config and dialProvider.config.dialsAsWritten then
			currentItem.numberToDial := routingInfoItem.rawNumber;
		manualStatus := currentItem.saveAsLog;
		(try begin
				self:SetTransportProvider(currentItem.serviceProvider);
				if (not callEndpoint) then begin
						self:InstallEndpoint(transportProvider, true)
					end;
				(if (if transportProvider.config.outgoingNeededDelay then StrFilled(currentItem.numberToDial)) then begin
						abortCall := nil;
						self:DelayDialing(transportProvider.config.outgoingNeededDelay)
					end else self:FinishDialing())
			end onexception |evt.ex| do begin
				(if self:HandleThrow() then self:Shutdown())
			end)
	end,
	routingSlip: {
		callPhoneLine: nil,
		willDial: nil,
		validateDialog: nil,
		viewChildren: [viewChildren:
			{
				_proto: @protoTapiPicker,
