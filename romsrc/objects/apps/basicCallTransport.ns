					if (if (if (routingInfoItem := GetDataDefs('|nameRef.phone|):GetRoutingInfo(fields.toRef[0])[0]) then routingInfoItem.phoneNumber) then (StrCompare(routingInfoItem.phoneNumber, callOptionsSlip.outNumber.text) <> 0)) then begin
							fields.toRef[0].asIsPhone := callOptionsSlip.outNumber.text
						end
				end;
			self:Retarget()
		end,
		viewBounds: {left: 0, top: 0, right: 230, bottom: 120},
		OwnerInfoChanged: func() begin
			self:UpdatePhone()
		end,
		allocateContext: [|Array|:
			'logcheck,
			logcheck,
			'fromTransport,
			fromTransport_2,
			'_closeBox,
			_closeBox_3,
			'_defaultButton,
			_defaultButton_22,
			'callassist,
			callassist,
			'callPhoneLine,
			callPhoneLine_2,
			'willDial,
			willDial_2
		],
		_proto: @protoRouteSlip,
		_defaultButton: nil,
		fromTransport: nil,
		Retarget: func() begin
			fields.toRef := callPhoneLine.selected;
			willDial:SetWillDial()
		end,
		appSymbol: '|PhoneHome:Newton|,
		viewJustify: vjParentCenterH + vjParentCenterV,
		callassist: nil,
		declareSelf: 'base,
		viewSetupFormScript: func() begin
			self:ToRefCheck('|nameRef.phone|);
			inherited:?viewSetupFormScript();
			logcheck:prepareThyself()
		end,
		_closeBox: nil,
		debug: 2105737,
		bottomIndent: 50,
		logcheck: nil
	},
	FinishDialing: func() begin
		(try begin
				self:SetStatusDialog('DialingTo, 'vStatusTitle, {primary: nil, titleText: currentItem.numberToDial});
				callEndpoint:MakeOutgoing(currentItem.numberToDial, true)
