				SetProvider: func(slot) begin
					local tAPICommFrame;
					if (((not (tAPICommFrame := GetTAPICommFrame(slot))) or (not tAPICommFrame.config)) or (not tAPICommFrame.config.supportsEventIncoming)) then begin
							slot := nil
