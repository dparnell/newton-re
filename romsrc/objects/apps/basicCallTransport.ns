	end,
	modalStatus: nil,
	ItemCompleted: func(a1, state2, error) begin
		local state;
		// ROM BUG (fixed): the call is hung up only if the status is one of a
		//  call's - but it is read after SetStatusDialog has made it 'HangingUp
		//  (or 'cancelling), so the endpoint is never told: the keypad's Hang
		//  Up (CancelRequest) logs the call and leaves it up.  Unseen on a
		//  MessagePad, whose built-in "Speaker" provider has no endpoint (the
		//  call is the handset's); a provider that holds the call - the host's
		//  cellular one, docs/host-tdeck-pro-phone.md - must be told.  The fix
		//  reads the status from before; with NEWTON_ROM_BUGS=1 (RomBugFixed()
		//  nil) the ROM's code runs.
		local callStatus := status;
		self:SetStatusDialog((if (status = 'cancelling) then 'cancelling else 'HangingUp), 'vStatus, {primary: nil});
		if not RomBugFixed() then
			callStatus := status;
		if (if callEndpoint then ((((((callStatus = 'DialingDone) or (callStatus = 'DialingDoneTo)) or (callStatus = 'DialingDoneFrom)) or (callStatus = 'RingingFrom)) or (callStatus = 'AnswerInProgress)) or (callStatus = 'DialingTo))) then begin
				try begin
						callEndpoint:hangup(nil)
					end onexception |evt.ex| do begin end
			end;
		manualStatus := true;
		if a1 then begin
				state := a1.state;
				if IsInstance(error, 'symbol) then begin
						a1.error := 0;
						a1.hangupreason := error;
						error := nil
					end;
				if ((error = nil) or (error = 0)) then begin
						state := 'log
					end;
				a1.endTime := TimeInSeconds();
				inherited:ItemCompleted(a1, state, error)
			end;
		currentItem := nil;
		self:CloseStatusDialog(nil)
	end,
	manualStatus: true,
	AnswerIncomingDone: func(a1) begin
		GetRoot().(appSymbol):DialingComplete(a1)
	end,
	debug: 8202,
	NewItem: func(viewfrontmostapp) begin
		local l1;
