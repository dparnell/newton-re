	end,
	dialogStatusMsgs: {
		Connecting: "Preparing ^0…",
		DialingTo: "Dialing ^0…",
		DialingDone: "Call in progress…",
		DialingDoneTo: "Call to ^0 in progress…",
		DialingDoneFrom: "Call from ^0 in progress…",
