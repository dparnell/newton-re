					self:StopEventIncoming()
				end, nil, ((480 - l1) * 16))))
	end,
	_proto: @protoTransport,
	EventOffHook: func() begin
		(if (if (status = 'RingingFrom) then currentItem) then GetRoot().(appSymbol):receiveRequestComplete())
	end,
	statusTemplate: {declareSelf: 'base, vPhoneKeypad: @vPhoneKeypad, _proto: @protoStatusTemplate},
	GetFolderName: func(target) begin
