// cardfile: the floater the Names application (Cardfile) is built on in the
// ROM; the application itself is in the Cardfile ROM extension
// (romsrc/rex/Cardfile).

cardfile := {
	viewFlags: vApplication + vClipping + vFloating + vClickable,
	appSymbol: 'cardfile,
	preallocatedContext: 'cardfile,
	_proto: @protoFloater
};
