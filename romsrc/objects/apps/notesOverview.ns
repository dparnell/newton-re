notepad := "Notepad";

ConvertEntryto20 := func(a1, a2, a3) begin
	local l1;
	l1 := (if a2 then DeepClone(a1) else a1);
	if (if a3 then l1.labels) then begin
			l1.labels := |Ensure1.XFolderExists|(l1.labels, 'paperroll)
		end;
	if l1.data then begin
			ConvertChildTemplates(l1.data, 'oneO, 'twoO)
		end;
	l1.class := 'paperroll;
	l1._version := 2;
	l1
end;

ConvertEntryto10 := func(a1, a2) begin
	if (((l2 := (frame22 := (if a2 then DeepClone(a1) else a1)).class) = 'paperroll) or (l2 = 'quadrule)) then begin
			RemoveSlot(frame22, 'class);
			RemoveSlot(frame22, '_version)
		end else begin
			if ((l2 = 'list) or (l2 = 'checkList)) then begin
					if (not frame22.topics) then begin
							return nil
						end;
					try begin
							frame2 := {viewStationery: 'paperroll, height: frame22.height, timestamp: frame22.timestamp, data: [Array: {viewBounds: SetBounds(0, 0, frame22.height, 240), viewStationery: 'para, text: GetDataDefs(l2):TextScript(nil, frame22), _proto: @protoParagraph}]}
						end onexception |evt.ex| do begin
							return nil
						end;
					frame22 := frame2
				end else begin
					return nil
				end
		end;
	if frame22.data then begin
			if (convertChildTemplates2 := ConvertChildTemplates(frame22.data, 'twoO, 'oneO)) then begin
					ArrayMunger(frame22.data, Length(frame22.data), 0, convertChildTemplates2, 0, nil)
				end
		end;
	if frame22.data then begin
			local frame22;
			local l2;
			local frame2;
			local convertChildTemplates2;
			local viewStationery;
			(for i := (Length(frame22.data) - 1) to 0 by -1 do begin
					if (if (viewStationery := frame22.data[i].viewStationery) then (if (viewStationery <> 'para) then (viewStationery <> 'poly))) then begin
							ArrayRemoveCount(frame22.data, i, 1)
						end
				end)
		end;
	frame22
end;

GetCurrentVersion := func(a1) begin
	local l1;
	if IsFrame(a1) then begin
			if a1._version then begin
					if (a1._version = 2) then begin
							l1 := 'twoO
						end
				end else begin
					if a1.class then begin
							l1 := 'twoO
						end else begin
							if (if a1.viewStationery then a1.height) then begin
									l1 := 'oneO
								end
						end
				end
		end;
	l1
end;

