// The Names soup. A soup definition (the soupDef frame RegUnionSoup and RegSoupDef take:
// name, userName, ownerApp, userDescr, indexes). Magic pointer @361. Used by
// globalvarwannabes.

cardfileSoupDef := {
	name: @cardfileSoupName,
	userName: @cardfileSoupName,
	ownerApp: 'cardfile,
	ownerAppName: @cardfileSoupName,
	userDescr: "Soup with Names and Addresses",
	indexes: @cardfileIndices
};
