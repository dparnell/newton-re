// The indexes of the system soup (on tag and modemName). An array of soup index
// specifications (the indexes of a soup definition). Magic pointer @275. Used by
// loadGlobals.

systemSoupIndexes := [|Array|:
	{structure: 'slot, type: '|string|, path: 'tag},
	{structure: 'slot, type: '|string|, path: 'modemName}
];
