// The To Do List's soup of tasks, repeating and not. A soup definition (the soupDef frame
// RegUnionSoup and RegSoupDef take: name, userName, ownerApp, userDescr, indexes). Magic
// pointer @370. Used by bootSoupwannabes, globalvarwannabes.

todo2SoupDef := {
	name: toDoList,
	userName: "To Do tasks",
	ownerApp: 'calendar,
	ownerAppName: dates_2,
	userDescr: "To Do tasks, both non-repeating and repeating",
	indexes: [|Array|: {structure: 'slot, path: 'Date, type: 'int}]
};
