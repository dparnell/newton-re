// The soup of the calendar's non-repeating meetings. A soup definition (the soupDef frame
// RegUnionSoup and RegSoupDef take: name, userName, ownerApp, userDescr, indexes). Magic
// pointer @365. Used by bootSoupwannabes, globalvarwannabes.

calendarSoupDef := {
	name: @calendarSoupName,
	userName: "calendar meetings",
	ownerApp: 'calendar,
	ownerAppName: dates_2,
	userDescr: "non-repeating meetings in the calendar",
	indexes: @dateIndices
};
