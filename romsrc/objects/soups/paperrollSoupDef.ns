// The Notes soup (the paper roll; userName "notepad"). A soup definition (the soupDef frame
// RegUnionSoup and RegSoupDef take: name, userName, ownerApp, userDescr, indexes). Magic
// pointer @364. Used by bootSoupwannabes, globalvarwannabes.

paperrollSoupDef := {
	name: @paperrollSoupName,
	userName: "notepad",
	ownerApp: 'paperroll,
	ownerAppName: @paperrollSoupName,
	userDescr: private,
	indexes: @paperrollIndices
};
