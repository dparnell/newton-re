// The In Box soup. A soup definition (the soupDef frame RegUnionSoup and RegSoupDef take:
// name, userName, ownerApp, userDescr, indexes). Magic pointer @538. Used by
// bootSoupwannabes, globalvarwannabes.

inboxSoupDef := {
	name: inBox_3,
	userName: inBox,
	ownerApp: 'iobox,
	ownerAppName: inOutBox,
	userDescr: "Received data for InBox",
	indexes: @ioIndices,
	initHook: nil
};
