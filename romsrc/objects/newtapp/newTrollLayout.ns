				(l1 := self:GlobalBox()).top := (l1.bottom - 20);
				self:DirtyBox(l1)
			end onexception |evt.ex| do begin
				duringScroll := nil;
				Rethrow()
			end;
		(duringScroll := nil)
	end,
	PixelScroller: func(a1, a2) begin
		local v5_xxxxxxxxxxxxxxxwwwwww, v6_zzzzzzyyyyyyyyyyyyyyyyyyyy, v11_uuuuuuuuttttt, v13_zyyyyyyyyyyy, v14_ppppppp, v16_yxxxxx, v18_ssssss, v19_yyyyyyyyxxx, v20_vvvvvvvvvvuuuuu, v21_kjjj, v23_tttttttttts, v24_xxxxxxxxxwwwwwww, v25_zzzzzzzzzzyyyyyyyyyyy, v26_vvvvvvvvvvuuuuuu, v27_xxxxxxxxxxxxxxxxxxxxx, v28_zzzzyyyyyyyyyyy, v29_wwwwwwwwwwwvvvvvvvvvv;
