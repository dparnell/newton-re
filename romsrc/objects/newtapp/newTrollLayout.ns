						return nil
					end;
				l4 := (if (l5.height > l1.bottom) then (if ((l6 := (l5.height mod l2)) < (l1.bottom - l2)) then (l6 + l2) else l6) else l5.height)
			end;
		self:PixelScrollBy(0, (-l4))
	end,
	viewScrollDownScript: func() begin
		local l1, l2, l3, l4;
		l2 := ((l1 := self:LocalBox()).bottom - (if viewLineSpacing then (4 * viewLineSpacing) else 24));
		l4 := (if ((l3 := Length(entries)) > 1) then (entries[0].height - viewOriginY) else l2);
