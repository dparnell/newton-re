	viewScrollUpScript: func() begin
		local l1, l2, l3, l4, l5, l6;
		l2 := ((l1 := self:LocalBox()).bottom - (if viewLineSpacing then (4 * viewLineSpacing) else 24));
		l3 := Length(entries);
		if (viewOriginY <> 0) then begin
				if (viewOriginY >= l1.bottom) then begin
						l4 := (if ((viewOriginY mod l2) = 0) then l2 else (viewOriginY mod l2))
					end else begin
						l4 := viewOriginY
					end
			end else begin
