// newtTextView: the editable NewtApp slot view for text without a label (NPR 2.0):
// newtroTextView recognising words and ink, and storing what is written.
//
// This file holds newtTextView and what only it reaches.

newtTextView := {
	_proto: @newtroTextView,
	viewFlags: vVisible + vClipping + vClickable + vGesturesAllowed + vCharsAllowed + vNumbersAllowed,
	recConfig: @rcInkorText,
	// the user changed the text: store the text (with any ink) in target.(path) and start the flush timer
	// (not while Retarget sets the text: then the view's hack slot is true)
	viewChangedScript: func(slot, view) begin
		(if (if (not hack) then (slot = 'text)) then begin
				target.(path) := view:GetRichString();
				self:StartFlush()
			end)
	end
};
