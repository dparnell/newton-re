		local l1, l2, l3;
		(if TargetIsCursor(a1) then begin
				l2 := (l1 := GetTargetCursor(a1, nil)):entry();
				(while l2 do begin
						masterSoup:DuplicateEntry(l2, a2);
						(l2 := l1:Next())
