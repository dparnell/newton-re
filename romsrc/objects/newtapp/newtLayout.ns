// newtLayout, and what only it reaches

newtLayout := {
	viewClass: clView,
	viewFlags: vVisible + vClipping + vClickable,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	textFlags: 5120,
	viewChildren: nil,
	masterSoup: nil,
	mastersoupSlot: nil,
	dataSoup: nil,
	dataCursor: nil,
	entries: nil,
	entryViewDefs: nil,
	nextEntry: 0,
	forceNewEntry: true,
	name: "View",
	viewDef: 'default,
	filedChild: nil,
	duringScroll: nil,
	checkAllPrimed: nil,
	TypeScrollScript: func(keyString) begin
		local entry;
		(if ((entry := layout.dataCursor:entry()) <> layout.dataCursor:GotoKey(keyString)) then layout:Effect(133120, nil, @flip, 'Retarget, [Array: true]))
	end,
	NewEntry: func(a1, _context, store) begin
		masterSoup:AddEntry(a1, store);
		if _context then begin
				dataCursor:Goto(a1)
			end;
		AddUndoSend(layout, 'KillEntry, [Array: a1]);
		(if _context then layout:NewTarget() else layout:Retarget(true))
	end,
	viewSetupDoneScript: func() begin
		self:Retarget(nil)
	end,
	keyDownTime: 0,
	BroadcastChange: func(a1, target) begin
		(if (a1 = 'quit) then XmitSoupChangeNow(masterSoup.soupName, appSymbol, 'whatThe, target))
	end,
	keyString: uCardPositionAlertButton,
	viewQuitScript: func() begin
		checkAllPrimed := nil;
		(if newtAppBase.statusBarSlot then begin
				if self.menuLeftButtons then begin
						RemoveSlot(newtAppBase.(statusBarSlot), 'menuLeftButtons)
					end;
				(if self.menuRightButtons then RemoveSlot(newtAppBase.(statusBarSlot), 'menuRightButtons))
			end)
	end,
	AddBlankEntry: func() begin
		local adoptEntry, store, internalStore;
		adoptEntry := masterSoup:AdoptEntry(nil, nil);
		try begin
				if (internalStore := self:GetAppPreferences().internalStore) then begin
						store := GetStores()[0]
					end else begin
						store := GetDefaultStore()
					end
			end onexception |evt.ex| do begin
				store := nil
			end;
		masterSoup:AddEntry(adoptEntry, store);
		adoptEntry
	end,
	viewDrawScript: func() begin
		(if (if (not forceNewEntry) then (not dataCursor:entry())) then self:DrawShape(self:AppEmpty(), '{}))
	end,
	SetupCursor: func() begin
		local entry;
		dataCursor := masterSoup:GetCursor();
		try begin
				entry := dataCursor:entry()
			end onexception |evt.ex| do begin
				entry := nil
			end;
		if entry then begin end else begin
				if forceNewEntry then begin
						self:AddBlankEntry();
						dataCursor:Reset()
					end
			end;
		dataCursor
	end,
	DuplicateEntryGuts: func(a1, store) begin
		local targetCursor, next, duplicateEntry;
		(if TargetIsCursor(a1) then begin
				next := (targetCursor := GetTargetCursor(a1, nil)):entry();
				(while next do begin
						masterSoup:DuplicateEntry(next, store);
						(next := targetCursor:Next())
					end);
				selected := nil;
				layout:NewTarget()
			end else begin
				dataCursor:Goto((duplicateEntry := masterSoup:DuplicateEntry(a1, store)));
				AddUndoSend(layout, 'KillEntry, [Array: duplicateEntry]);
				layout:NewTarget()
			end)
	end,
	viewKeyDownScript: func(char2, flags) begin
		local l1, ticks2;
		if useTypeScrolling then begin
				if (if (if (BAnd(flags, 33554432) = 0) then (char2 >= $ )) then (not (if (char2 >= $\uF721) then (char2 <= $\uF72F)))) then begin
						ticks2 := Ticks();
						if ((not self.keyDownTime) or ((ticks2 - keyDownTime) > 100)) then begin
								self.keyString := nil
							end;
						self.keyString := Stringer([Array: self.keyString, char2]);
						self:TypeScrollScript(keyString);
						self.keyDownTime := ticks2;
						l1 := true
					end
			end;
		l1
	end,
	DoRetarget: func() begin
		layout:Retarget(true)
	end,
	FilterChanged: func() begin
		self:SetupCursor();
		self:NewTarget()
	end,
	PixelScrollTo: func(a1, a2) begin
		duringScroll := 'pixel;
		try begin
				layout:DropHilites();
				layout:SetOrigin(a1, a2);
				layout:?Jogged()
			end onexception |evt.ex| do begin
				duringScroll := nil;
				Rethrow()
			end;
		(duringScroll := nil)
	end,
	Scroller: func(maxLines) begin
		if HiliteOwner() then begin
				PostCommand(HiliteOwner(), 48)
			end;
		layout:ScrollCursor(maxLines);
		layout:NewTarget()
	end,
	PixelScrollBy: func(a1, a2) begin
		duringScroll := 'pixel;
		try begin
				layout:DropHilites();
				layout:SetOrigin(((if HasPath(layout, 'viewOriginX) then layout.viewOriginX else 0) + a1), ((if HasPath(layout, 'viewOriginY) then layout.viewOriginY else 0) + a2));
				layout:?Jogged()
			end onexception |evt.ex| do begin
				duringScroll := nil;
				Rethrow()
			end;
		(duringScroll := nil)
	end,
	ShowFoundItem: func(a1, a2) begin
		dataCursor:Goto(a1);
		layout:NewTarget();
		(foreach item in layout:ChildViewFrames() do begin
				if (item.target = a1) then begin
						item:?ShowFoundItem(a1, a2);
						break
					end
			end)
	end,
	viewScrollDownScript: func() begin
		self:Effect(44171264, true, @flip, 'Scroller, [Array: 1])
	end,
	Retarget: func(a1) begin
		if (((entry := dataCursor:entry()) = 'deleted) or (entry = nil)) then begin
				dataCursor:Next();
				if (dataCursor:entry() = nil) then begin
						dataCursor:prev()
					end;
				if (dataCursor:entry() = nil) then begin
						self:SetupCursor()
					end
			end;
		if a1 then begin
				self:RedoChildren()
			end;
		local entry;
		(if retargetChain then (foreach item in retargetChain do begin
					item:RetargetNotify()
				end))
	end,
	ScrollCursor: func(maxLines) begin
		local l1, dataCursor2;
		l1 := true;
		dataCursor2 := dataCursor;
		if (if (maxLines <> 0) then dataCursor2) then begin
				if (not dataCursor2:move(maxLines)) then begin
						l1 := nil;
						if ((scrollingEndBehavior = 'beepAndWrap) or (scrollingEndBehavior = 'beepAndStop)) then begin
								playsound(@flip);
								Sleep(15);
								playsound(@flip)
							end;
						if ((scrollingEndBehavior = 'stop) or (scrollingEndBehavior = 'beepAndStop)) then begin
								if (maxLines > 0) then begin
										dataCursor2:prev()
									end else begin
										dataCursor2:Next()
									end
							end else begin
								if ((scrollingEndBehavior = 'wrap) or (scrollingEndBehavior = 'beepAndWrap)) then begin
										if (maxLines > 0) then begin
												dataCursor2:Reset()
											end else begin
												dataCursor2:ResetToEnd()
											end
									end
							end
					end
			end;
		l1
	end,
	viewScrollUpScript: func() begin
		self:Effect(44171264, nil, @flip, 'Scroller, [Array: -1])
	end,
	DuplicateEntry: func(a1) begin
		local store, appPreferences;
		if (if (appPreferences := self:GetAppPreferences()) then appPreferences.internalStore) then begin
				store := GetStores()[0]
			end;
		self:DuplicateEntryGuts(a1, store)
	end,
	viewSetupFormScript: func() begin
		layout := self;
		SetKeyView(self, 0);
		viewDef := newtAppBase.preferredViewDef;
		dataSoup := (masterSoup := allSoups.(mastersoupSlot)).theSoup;
		self:SetupCursor();
		(if newtAppBase.statusBarSlot then begin
				if self.menuLeftButtons then begin
						newtAppBase.(statusBarSlot).menuLeftButtons := menuLeftButtons
					end;
				(if self.menuRightButtons then (newtAppBase.(statusBarSlot).menuRightButtons := menuRightButtons))
			end)
	end,
	FilingChangedX: func() begin
		cursorKey := masterSoup:GetCursorKey();
		if filedChild then begin
				if filedChild.FilingChangedX then begin
						filedChild:FilingChangedX()
					end
			end else begin
				local cursorKey;
				(foreach item in self:ChildViewFrames() do begin
						local entry;
						if item.FilingChangedX then begin
								item:FilingChangedX()
							end
					end)
			end;
		entry := dataCursor:entry();
		masterSoup:SetupCursor();
		layout:SetupCursor();
		if IsSoupEntry(entry) then begin
				dataCursor:Goto(entry)
			end else begin
				if cursorKey then begin
						masterSoup:GotoCursorKey(cursorKey);
						layout:SetupCursor()
					end else begin
						layout:SetupCursor();
						dataCursor:ResetToEnd()
					end
			end;
		layout:NewTarget()
	end,
	NewTarget: func() begin
		if HasPath(self, 'viewOriginX) then begin
				viewOriginX := 0
			end;
		if HasPath(self, 'viewOriginY) then begin
				viewOriginY := 0
			end;
		layout:Retarget(true)
	end,
	useTypeScrolling: nil,
	FlushData: func() begin
		(foreach item in self:ChildViewFrames() do begin
				if HasPath(item, 'FlushEntry) then begin
						item:FlushEntry(GetVariable(item, 'target))
					end
			end)
	end,
	KillEntry: func(target) begin
		local targetCursor, next, entryDataDef, store;
		if TargetIsCursor(target) then begin
				next := (targetCursor := GetTargetCursor(target, nil)):entry();
				(while next do begin
						if (entryDataDef := GetEntryDataDef(next)) then begin
								entryDataDef:?AboutToDeleteEntry(next)
							end;
						masterSoup:DeleteEntry(next);
						(next := targetCursor:Next())
					end);
				selected := nil
			end else begin
				if target then begin
						store := EntryStore(target);
						if (entryDataDef := GetEntryDataDef(target)) then begin
								entryDataDef:?AboutToDeleteEntry(target)
							end;
						masterSoup:DeleteEntry(target);
						AddUndoSend(layout, 'NewEntry, [Array: target, true, store])
					end
			end;
		layout:Retarget(true)
	end,
	GetActiveViewX: func() begin
		targetView
	end,
	viewSetupChildrenScript: func() begin
		local entry, l2;
		entries := [Array: (entry := dataCursor:entry())];
		entryViewDefs := [Array: GetEntryDataView(entry, viewDef)];
		(nextEntry := 0)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

TypeScrollScript_code := same("newtLayout.TypeScrollScript.instructions");
