// newtFalseEntryView, and what only it reaches

newtFalseEntryView := {
	FlushEntry: func(a1) begin
		nil
	end,
	soupQuery: nil,
	soupQuerySlot: 'soupQuery,
	target: nil,
	targetSlot: 'target,
	entryViewDefs: nil,
	DoRetarget: func() begin
		entryViewDefs := [Array: GetEntryDataView((target := GetVariable(parentView, targetSlot)), viewDef)];
		targetViewDef := (currentViewDef := nil);
		targetDataDef := (currentDataDef := nil);
		currentStatView := nil;
		targetView:RedoChildren()
	end,
	dataSoup: nil,
	dataSoupSlot: 'dataSoup,
	_proto: @newtEntryView,
	EndFlush: func() begin
		nil
	end,
