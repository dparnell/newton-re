		dataSoup := GetVariable(parentView, dataSoupSlot);
		soupQuery := GetVariable(parentView, soupQuerySlot);
		targetViewDef := (entryViewDefs := [Array: (entryDataView := GetEntryDataView(target, viewDef))]);
		viewDef := entryDataView.symbol;
		(if (dataDefs := GetDataDefs(DataClassOf(target))) then dataDefs:?SetupForm(target, self))
	end,
	parentView: nil,
