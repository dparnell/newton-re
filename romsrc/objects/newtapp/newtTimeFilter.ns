// newtTimeFilter: the NewtApp filter for a time of day (NPR 2.0 Table 3-1).  The slot
// holds a date and time in minutes; a time the user writes replaces only the time of
// day, keeping the date the slot held.  Its picker is the digital time popup, stepping
// by increment minutes.
//
// This file holds newtTimeFilter and what only it reaches.

newtTimeFilter := {
	_proto: @newtTextFilter,
	// recFlags: the entry line's view flags (newtTextFilter)
	recFlags: vVisible + vClickable + vGesturesAllowed + vTimeField,
	increment: 10, // the time popup's step, in minutes
	format: 170636, // shortTimeStrSpec's value (@datetimeStrSpecs), for TimeStr
	PathToText: func() begin
		(if IsString(target.(path)) then Clone(target.(path)) else TimeStr(target.(path), format))
	end,
	// the time written (minutes into its day, mod 1440) on the date the slot held (l2),
	// or on day 0 when the slot was empty.  Looks like a ROM bug: unlike newtDateFilter's
	// it does not check that the old value is a number, so text kept in the slot
	// (PathToText shows a string as it is) makes the mod throw
	TextToPath: func(a1) begin
		local stringToTime2, l2;
		(if ((not StrFilled(a1)) or IsRichString(a1)) then a1 else begin
				stringToTime2 := StringToTime(a1);
				l2 := target.(path);
				(if stringToTime2 then (if l2 then (((stringToTime2 mod 1440) + l2) - (l2 mod 1440)) else (stringToTime2 mod 1440)))
			end)
	end,
	// the digital time popup at the slot's time, stepping by increment
	picker: func() begin
		@digitalTimePopup:New(target.(path), increment, self:GlobalLabelBounds(), self)
	end
};
