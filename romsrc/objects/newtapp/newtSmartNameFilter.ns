// newtSmartNameFilter, and what only it reaches

newtSmartNameFilter := {
	_proto: @newtTextFilter,
	recFlags: 25201153,
	dictionaries: [|Array|: 48, 7, 31, 0],
	PathQuery: func(a1) begin
		Query(GetUnionSoup(@cardfileSoupName), {type: 'words, words: a1})
	end,
	QueryItem: func(entry, preQuery) begin
		(if FindStringInFrame(entry, preQuery, nil) then {item: GetRoot():PrimaryName(entry), id: MakeEntryAlias(entry)})
	end,
	ResolveItem: func(a1) begin
		targetView:jamFromEntry(ResolveEntryAlias(a1.id))
	end,
	EntryToPath: func(resolveEntryAlias) begin
		(target.(path) := GetRoot():PrimaryName(resolveEntryAlias))
	end,
	picker: func() begin
		@protoPeoplePopup:New('|nameRef.people|, nil, self, nil)
	end,
	pickActionScript: func(index) begin
		local l1;
		if (l1 := (if (if index then (Length(index) > 0)) then (if index[0]._alias then ResolveEntryAlias(index[0]._alias) else index[0]))) then begin
				targetView:jamFromEntry(l1)
			end;
		baseLine:hilite(nil)
	end,
	ChooseItem: func(index) begin
		local preQuery, pathQuery, l3;
		if (if (l3 := (pathQuery := self:PathQuery((preQuery := self:PreQuery(labelCommands[index].item)))):entry()) then StrEqual(labelCommands[index].item, GetRoot():PrimaryName(l3))) then begin
				targetView:jamFromEntry(l3)
			end;
		if l3 then begin
				baseLine:hilite(nil)
			end;
		l3
	end
};
