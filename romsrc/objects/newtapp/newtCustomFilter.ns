// newtCustomFilter, and what only it reaches

newtCustomFilter := {
	_proto: @newtTextFilter,
	recFlags: 25201153,
	InitFilter: func() begin
		local parent;
		if (parent := self:Parent()).newRecFlags then begin
				recFlags := newRecFlags
			end;
		if parent.newDictionaries then begin
				dictionaries := newDictionaries
			end;
		if parent.newRecTextFlags then begin
				recTextFlags := newRecTextFlags
			end;
		inherited:?InitFilter()
	end
};
