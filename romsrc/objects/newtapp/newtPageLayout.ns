// newtPageLayout, and what only it reaches

newtPageLayout := {
	_proto: @newtLayout,
	hasOnePage: nil,
	lastItem: nil,
	lastHeight: 0,
	viewOriginY: 0,
	viewSetupChildrenScript: func() begin
		inherited:viewSetupChildrenScript();
		if (not dataCursor:clone():Next()) then begin
				lastItem := entries[0]
			end;
		lastHeight := self:LocalBox().bottom;
		if entries[0] then begin
				self.viewChildren := Array(1, protoChild)
			end else begin
				RemoveSlot(self, 'viewChildren)
			end;
		layout:Retarget(nil)
	end,
	Scroller: func(a1) begin
		local l1, l2, l3;
		if HiliteOwner() then begin
				PostCommand(HiliteOwner(), 48)
			end;
		l1 := self:LocalBox();
		if (a1 > 0) then begin
				l3 := (if ((l2 := dataCursor:entry()).height = nil) then 0 else (l2.height + (l1.bottom div 3)));
				if (if (l2 <> lastItem) then ((l3 - viewOriginY) < l1.bottom)) then begin
						viewOriginY := 0;
						self:ScrollCursor(1)
					end else begin
						viewOriginY := (viewOriginY + l1.bottom)
					end
			end else begin
				if (viewOriginY > 0) then begin
						viewOriginY := max(0, (viewOriginY - l1.bottom))
					end else begin
						if self:ScrollCursor(-1) then begin
								l3 := dataCursor:entry().height;
								if (if (scrollingUpBehavior = 'bottom) then l3) then begin
										viewOriginY := ((l3 div l1.bottom) * l1.bottom)
									end else begin
										viewOriginY := 0
									end
							end
					end
			end;
		layout:Retarget(true)
	end,
	Jogged: Jogged,
	GetActiveViewX: GetActiveViewX
};
