// newtMailNetChooser, and what only it reaches

newtMailNetChooser := {
	viewBounds: {left: 0, top: 6, right: 0, bottom: 30},
	viewJustify: vjParentFullH + vjSiblingBottomV,
	labelCommands: nil,
	text: "E-Mail Network",
	GetSymArray: func() begin
		(foreach item in GetRoot().mailcategory.mailNetworks collect item.id)
	end,
	TextSetup: func() begin
		mailNetworks := GetRoot().mailcategory.mailNetworks;
		symArray := self:GetSymArray();
		labelCommands := [Array: ];
		local mailNetwork;
		local mailNetworks;
		local symArray;
		(foreach item in symArray do begin
				local mailNetwork2;
				if (mailNetwork := FindMailNetwork(mailNetworks, item)) then begin
						AddArraySlot(labelCommands, mailNetwork.title)
					end else begin
						AddArraySlot(labelCommands, "Unknown")
					end
			end);
		if (not target.(path)) then begin
				if (mailNetwork2 := GetUserConfig('mailNetwork)) then begin
						target.(path) := mailNetwork2
					end else begin
						target.(path) := GetRoot().mailcategory.mailNetworks[0].id
					end;
				self:StartFlush()
			end;
		(if (mailNetwork := FindMailNetwork(mailNetworks, target.(path))) then begin
				self:Parent():?DataChangeNotify('mailNetwork, target.(path));
				mailNetwork.title
			end else "")
	end,
	LabelActionScript: func(index) begin
		local mailNetwork, l2;
		(if (mailNetwork := GetRoot().mailcategory.mailNetworks[index]) then begin
				target.(path) := mailNetwork.id;
				self:Parent():?DataChangeNotify('mailNetwork, mailNetwork.id);
				self:StartFlush()
			end)
	end,
	_proto: @protoLabelPicker
};
