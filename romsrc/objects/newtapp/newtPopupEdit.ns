// newtPopupEdit, and what only it reaches

newtPopupEdit := {
	viewSetupFormScript: func() begin
		inherited:viewSetupFormScript();
		(currPhoneNum := filter:PathToText())
	end,
	viewChangedScript: func(a1, a2) begin
		local l1;
		currPhoneNum := a2:GetRichString();
		target.(path) := filter:TextToPath((if StrFilled(currPhoneNum) then currPhoneNum));
		if (if currPhoneType then target.(path)) then begin
				SetClass(target.(path), currPhoneType)
			end;
		self:StartFlush()
	end,
	UpdateText: func(a1) begin
		local l1;
		if (not a1) then begin
				a1 := ""
			end;
		self:AddUndoAction('UpdateText, [Array: Clone(phone:GetRichString())]);
		if IsInteger(a1) then begin
				a1 := SPrintObject(a1)
			end;
		(if phone.viewCObject then SetValue(phone, 'text, a1) else (currPhoneNum := a1))
	end,
	_proto: @newtPhonePopupEdit
};
