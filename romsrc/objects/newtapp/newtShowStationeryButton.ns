// newtShowStationeryButton, and what only it reaches

newtShowStationeryButton := {
	form: 'viewDef,
	keyButton: '_showKeyButton,
	text: show_2,
	types: [|Array|: 'viewer, 'editor],
	statScript: func(a1) begin
		if (newtAppBase.currentLayout = 'overview) then begin
				newtAppBase:ShowLayout(nil)
			end;
		preferredViewDef := a1.symbol;
		layout.viewDef := a1.symbol;
		layout:Retarget(true)
	end,
	BuildPopup: func() begin
		popup := [Array: ];
		statArray := self:SetUpStatArray();
		if sorter then begin
				Sort(statArray, sorter, 'name)
			end;
		l1 := nil;
		local l1;
		(foreach l2 in statArray do begin
				local l4, l5;
				l4 := (if l2.name then l2.name else l2.title);
				l5 := (if l2.icon then begin
						l1 := true;
						{item: l4, icon: l2.icon}
					end else {item: l4});
				if (l2.symbol = layout.viewDef) then begin
						l5.mark := $\uFC0B
					end;
				AddArraySlot(popup, l5)
			end);
		(if l1 then (popup[0].indent := 24))
	end,
	SetUpStatArray: func() begin
		(if targetView.targetDataDef then GetDefs(form, [Array: targetView.targetDataDef.symbol], types) else [Array: ])
	end,
	_proto: @newtStationeryPopupButton
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

statScript_code := same("newtShowStationeryButton.statScript.instructions");
