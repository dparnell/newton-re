// newtTextDateView, and what only it reaches

newtTextDateView := {
	_proto: @newtroTextDateView,
	viewFlags: vVisible + vClickable + vGesturesAllowed + vDateField,
	viewChangedScript: func(a1, a2) begin
		local l1;
		(if (if (not GetVariable(a2, 'hack)) then (a1 = 'text)) then begin
				if StrFilled(a2.(a1)) then begin
						if (l1 := StringToDate(a2.(a1))) then begin
								GetVariable(a2, 'target).(path) := l1
							end
					end else begin
						GetVariable(a2, 'target).(path) := nil
					end;
				self:StartFlush()
			end)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewChangedScript_code_3 := same("newtTextDateView.viewChangedScript.instructions");
