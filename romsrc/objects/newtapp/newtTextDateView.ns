newtTextDateView := {
	_proto: @newtroTextDateView,
	viewFlags: vVisible + vClickable + vGesturesAllowed + vDateField,
	viewChangedScript: func(slot, view) begin
		local stringToDate2;
		(if (if (not GetVariable(view, 'hack)) then (slot = 'text)) then begin
				if StrFilled(view.(slot)) then begin
						if (stringToDate2 := StringToDate(view.(slot))) then begin
