		end),
	// true: each line shows its store's name when more than one store is present
	showStoreName: nil,
	maxLines: 0,
	_proto: @newtLayout,
	cursor: nil,
	// the folder or store changed: keeps only the checked entries still shown
	FilterChanged: func() begin
