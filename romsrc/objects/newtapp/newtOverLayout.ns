	pieces: nil,
	items: nil,
	numLines: 0,
	GetTheRightShape: GetTheRightShape,
	CheckOff: CheckOff,
	viewScrollUpScript: viewScrollUpScript,
	hilitedIndex: nil,
	// the width of the dotted line left of selectIndent (nil: none)
