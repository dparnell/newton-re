	end,
	// a dataDef was registered or removed: redisplay, as icons may have changed
	HandleStationeryChange: func(a1, a2, a3, a4) begin
		(if (if self.viewCObject then (a2 = 'dataDef)) then self:DoRetarget())
	end,
	SelectItem: SelectItem,
	// where the check boxes are drawn in each line
