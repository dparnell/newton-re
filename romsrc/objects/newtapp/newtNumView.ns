// newtNumView, and what only it reaches

newtNumView := {
	_proto: @newtroNumView,
	viewFlags: vVisible + vClickable + vGesturesAllowed + vNumbersAllowed,
	viewChangedScript: func(a1, a2) begin
		local l1;
		(if (if (not GetVariable(a2, 'hack)) then (a1 = 'text)) then begin
				if (not (l1 := StringToNumber(a2.(a1)))) then begin
						if (not (l1 := StringToNumber(StringFilter(a2.(a1), "0123456789.,-", 'passAll)))) then begin
								l1 := 0
							end
					end;
				GetVariable(a2, 'target).(path) := (if integerOnly then floor((l1 + 0.5)) else l1);
				self:StartFlush()
			end)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewChangedScript_literal4 := same("newtNumView.viewChangedScript.literals[4]");

viewChangedScript_literal10 := same("newtNumView.viewChangedScript.literals[10]");
