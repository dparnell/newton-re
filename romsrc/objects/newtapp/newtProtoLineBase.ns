// newtProtoLineBase, and what only it reaches

newtProtoLineBase := {
	flavor: @newtFilter,
	indent: nil,
	viewFormat: 0,
	viewLineSpacing: 25,
	usePopup: true,
	access: 'readWrite,
	viewFlags: vVisible + vClickable + vStrokesAllowed,
	memory: nil,
	lastPicked: nil,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 32},
	hack: nil,
	oldLabelCommands: nil,
	dontResizeLabel: nil,
	viewJustify: vjParentFullH + vjSiblingBottomV,
	label: nil,
	labelBox: nil,
	height: nil,
	filter: nil,
	labelCommands: nil,
	declareSelf: 'baseLine,
	labelFont: tsSystem + tsSize(9) + tsBold,
	viewClass: clView,
	text: uCardPositionAlertButton,
	pix: nil,
	curLabelCommand: nil,
	_keyCommands: [|Array|:
		{char: $\u000d, modifiers: 33554432, keyMessage: '_popKeyScript, name: choose, category: nil}
	],
	SetupCommands: func() begin
		local l1;
		if (access = 'readOnly) then begin
				return nil
			end;
		if (l1 := GetMemoryItems(memory)) then begin
				if (not labelCommands) then begin
						labelCommands := l1
					end else begin
						AddArraySlot((labelCommands := Clone(labelCommands)), 'pickseparator);
						AddArraySlot(labelCommands, l1[0])
					end
			end;
		(if (if labelCommands then filter.picker) then begin
				AddArraySlot((labelCommands := Clone(labelCommands)), 'pickseparator);
				AddArraySlot(labelCommands, "Other")
			end)
	end,
	GlobalLabelBounds: func() begin
		local l1;
		(l1 := OffsetRect(self:GlobalBox(), labelBox.left, labelBox.top)).right := (l1.left + (labelBox.right - labelBox.left));
		l1.bottom := (l1.top + (labelBox.bottom - labelBox.top));
		l1
	end,
	viewSetupFormScript: func() begin
		if (if (if (targetView exists) then targetView) then (BAnd(targetView.viewFlags, 130) <> 0)) then begin
				access := 'readOnly
			end;
		(filter := Clone(flavor))._parent := self;
		filter:?InitFilter();
		self:SetupCommands();
		dontResizeLabel := indent;
		height := FontHeight(labelFont);
		self:SetLabelText(label)
	end,
	viewQuitScript: func() begin
		filter:?QuitFilter()
	end,
	viewDrawScript: func() begin
		(if pix then self:DrawShape(pix, {font: labelFont}))
	end,
	viewHiliteScript: func(a1) begin
		self:DrawShape(MakeRoundRect(labelBox.left, labelBox.top, labelBox.right, (labelBox.top + height), 4), '{transferMode: 2, penPattern: 0, fillPattern: 5});
		true
	end,
	viewStrokeScript: func(a1) begin
		local l1;
		if (if ((((access = 'readWrite) or (access = 'Query)) or (access = 'queryOnly)) or (access = 'pickOnly)) then labelCommands) then begin
				if self:TrackHilite(a1) then begin
						if (curLabelCommand = nil) then begin
								l1 := labelCommands
							end else begin
								(l1 := Clone(labelCommands))[curLabelCommand] := {item: l1[curLabelCommand], mark: $\uFC0B}
							end;
						self:PopupMenu(l1, {bounds: labelBox})
					end
			end else begin
				if (if filter.picker then (access <> 'readOnly)) then begin
						if self:TrackHilite(a1) then begin
								filter:picker()
							end
					end
			end;
		true
	end,
	_popKeyScript: func(a1) begin
		local l1;
		if (if ((((access = 'readWrite) or (access = 'Query)) or (access = 'queryOnly)) or (access = 'pickOnly)) then labelCommands) then begin
				if (curLabelCommand = nil) then begin
						l1 := labelCommands
					end else begin
						(l1 := Clone(labelCommands))[curLabelCommand] := {item: l1[curLabelCommand], mark: $\uFC0B}
					end;
				self:PopupMenu(l1, {bounds: labelBox})
			end else begin
				if (if filter.picker then (access <> 'readOnly)) then begin
						filter:picker()
					end
			end;
		true
	end,
	Retarget: func() begin
		nil
	end,
	jamFromEntry: func(a1) begin
		target.(path) := nil;
		(if a1 then filter:EntryToPath(a1))
	end,
	pickActionScript: func(a1) begin
		local l1;
		(if HasPath(labelCommands[a1], 'id) then begin
				filter:ResolveItem(labelCommands[a1]);
				self:hilite(nil)
			end else (if (if filter.picker then (a1 = (Length(labelCommands) - 1))) then filter:picker() else (if (not filter:?ChooseItem(a1)) then begin
						if IsFrame((l1 := labelCommands[a1])) then begin
								l1 := (if l1.value then l1.value else l1.item)
							end;
						lastPicked := l1;
						self:UpdateText(Clone(l1));
						self:hilite(nil)
					end)))
	end,
	pickCancelledScript: func() begin
		self:hilite(nil)
	end,
	UpdateText: func(a1) begin
		nil
	end,
	TextScript: func() begin
		Stringer([Array: label, " ", (if (if (if target then path) then target.(path)) then filter:PathToText() else "")])
	end,
	SetLabelText: func(a1) begin
		local l1, l2;
		l1 := (if (if (labelCommands or filter.picker) then (access <> 'readOnly)) then Stringer([Array: $\uFC01, a1]) else Stringer([Array: $\uFC02, a1]));
		if ((not dontResizeLabel) or (not indent)) then begin
				indent := (StrFontWidth(l1, labelFont) + 6)
			end;
		if ((not dontResizeLabel) or (not labelBox)) then begin
				l2 := self:LocalBox();
				labelBox := RelBounds(0, ((viewLineSpacing - FontAscent(labelFont)) - 1), indent, height)
			end;
		pix := MakeText(l1, labelBox.left, labelBox.top, labelBox.right, (labelBox.top + FontAscent(labelFont)));
		l1
	end,
	SetLabelCommands: func(a1) begin
		local l1;
		(if (access <> 'readOnly) then begin
				if (if (l1 := GetMemoryItems(memory)) then (not a1)) then begin
						a1 := l1;
						if filter.picker then begin
								AddArraySlot((a1 := Clone(a1)), 'pickseparator);
								AddArraySlot(a1, "Other")
							end
					end;
				(if (a1 <> oldLabelCommands) then begin
						labelCommands := a1;
						self:SetLabelText(label);
						self:Dirty();
						(oldLabelCommands := labelCommands)
					end)
			end)
	end,
	viewIdleScript: func() begin
		local l1, l2, l3, l4, l5, l6;
		(if StrFilled((l1 := filter:PathToText())) then begin
				l3 := filter:PathQuery((l2 := filter:PreQuery(l1)));
				if (if usePopup then l3) then begin
						l4 := nil;
						l5 := l3:entry();
						(loop begin
								if (not l5) then begin
										break
									end;
								if (l6 := filter:QueryItem(l5, l2)) then begin
										if (not l4) then begin
												l4 := [Array: ]
											end;
										self:?ChangePopup(l6, l5);
										AddArraySlot(l4, l6)
									end;
								(l5 := l3:Next())
							end);
						if (if l4 then (access = 'queryOnly)) then begin
								filter:ResolveItem(l4[0])
							end;
						if (if l4 then filter.picker) then begin
								AddArraySlot(l4, 'pickseparator);
								AddArraySlot(l4, "Other")
							end;
						self:SetLabelCommands(l4)
					end else begin
						if l3 then begin
								if (l5 := l3:entry()) then begin
										dataCursor:Goto(l5);
										self:DoRetarget()
									end
							end else begin
								if (access = 'queryOnly) then begin
										self:UpdateText("")
									end
							end
					end;
				nil
			end else (if (access <> 'readOnly) then begin
					labelCommands := nil;
					self:SetupCommands();
					nil
				end))
	end,
	viewChangedScript: func(a1, a2) begin
		local l1;
		(if (a1 = 'text) then begin
				if ((access = 'Query) or (access = 'queryOnly)) then begin
						self:SetupIdle(500)
					end;
				(if (access <> 'queryOnly) then begin
						l1 := filter:TextToPath(a2:GetRichString());
						target.(path) := (if StrFilled(a2.text) then l1);
						self:StartFlush()
					end)
			end)
	end
};
