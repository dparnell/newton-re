// newtStatusBarNoClose, and what only it reaches

newtStatusBarNoClose := {
	_proto: @protoStatus,
	viewBounds: {left: 0, top: -18, right: 0, bottom: 0},
	viewChildren: nil,
	outset: 6,
	spacing: 7,
	firstLeft: 6,
	firstRight: -5,
	height: 13,
	menuLeftButtons: nil,
	menuRightButtons: nil,
	CalcWidth: func(value) begin
		(if (if HasPath(value, 'text) then value.text) then (StrFontWidth(value.text, value.viewFont) + outset) else (value.viewBounds.right - value.viewBounds.left))
	end,
	viewSetupChildrenScript: func() begin
		viewChildren := [Array: ];
		l1 := 0;
		l2 := 0;
		if menuLeftButtons then begin
				SetLength(viewChildren, (l2 + Length(menuLeftButtons)));
				local l1;
				local l2;
				(foreach key, value in menuLeftButtons do begin
						width := self:CalcWidth(value);
						l1 := ((l1 + width) + 8);
						viewChildren[l2] := (if (key > 0) then {_proto: value, viewBounds: RelBounds(spacing, 0, width, height), viewJustify: 8406022} else {_proto: value, viewBounds: RelBounds(firstLeft, 2, width, height), viewJustify: 8388614});
						l2 := (l2 + 1)
					end)
			end;
		l7 := l2;
		(if menuRightButtons then begin
				SetLength(viewChildren, (l2 + Length(menuRightButtons)));
				(foreach key, value in menuRightButtons do begin
						local width, l7, firstRight2;
						width := self:CalcWidth(value);
						l1 := ((l1 + width) + 8);
						viewChildren[l2] := (if (key > 0) then {_proto: value, viewBounds: RelBounds(((-width) - spacing), 0, width, height), viewJustify: 8407046} else begin
								if (not (firstRight2 := firstRight)) then begin
										firstRight2 := -5
									end;
								{_proto: value, viewBounds: RelBounds(((-width) + firstRight2), 2, width, height), viewJustify: 8388646}
							end);
						l2 := (l2 + 1)
					end)
			end)
	end
};
