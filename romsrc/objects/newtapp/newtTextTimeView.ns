// newtTextTimeView, and what only it reaches

newtTextTimeView := {
	_proto: @newtroTextTimeView,
	viewFlags: vVisible + vClickable + vGesturesAllowed + vTimeField,
	viewChangedScript: func(slot, view) begin
		local stringToTime2;
		(if (if (not GetVariable(view, 'hack)) then (slot = 'text)) then begin
				if StrFilled(view.(slot)) then begin
						if (stringToTime2 := StringToTime(view.(slot))) then begin
								GetVariable(view, 'target).(path) := stringToTime2
							end
					end else begin
						GetVariable(view, 'target).(path) := nil
					end;
				self:StartFlush()
			end)
	end
};
