// newtEmbeddedEntryView, and what only it reaches

newtEmbeddedEntryView := {
	FlushEntry: func(a1) begin
		parentView:FlushEntry(a1)
	end,
	path: nil,
	viewSetupDoneScript: func() begin
		(currentStatView := (if (if target then viewChildren) then self:ChildViewFrames()[0]))
	end,
	viewQuitScript: func() begin
		nil
	end,
	target: nil,
	viewChildren: nil,
	parentTarget: nil,
	viewIdleScript: func() begin
		nil
	end,
	jamFromEntry: func(a1) begin
		parentView:jamFromEntry(a1)
	end,
	_proto: @newtEntryView,
	EndFlush: func() begin
		parentView:EndFlush()
	end,
	GetTargetFromEntry: func(a1) begin
		(if (if path then a1.(path)) then a1.(path) else a1)
	end,
	EntryCool: func(a1) begin
		parentView:EntryCool(a1)
	end,
	Retarget: func() begin
		target := self:GetTargetFromEntry(parentTarget);
		targetViewDef := (currentViewDef := nil);
		targetDataDef := (currentDataDef := nil);
		currentStatView := nil;
		(foreach l1 in self:ChildViewFrames() do begin
				if HasPath(l1, 'Retarget) then begin
						l1:Retarget()
					end
			end)
	end,
	StartFlush: func() begin
		parentView:StartFlush()
	end,
	viewDef: 'default,
	viewSetupFormScript: func() begin
		nil
	end,
	parentView: nil,
	FilingChangedX: func() begin
		parentView:FilingChangedX()
	end,
	StartFlushWithChild: func(a1) begin
		parentView:StartFlushWithChild(a1)
	end,
	targetView: nil,
	viewSetupChildrenScript: func() begin
		local l1;
		viewChildren := (target := nil);
		if (parentTarget := GetVariable((parentView := self:Parent()), 'target)) then begin
				targetDataDef := (currentDataDef := GetEntryDataDef((target := self:GetTargetFromEntry(parentTarget))));
				if (viewDef <> nil) then begin
						targetViewDef := (currentViewDef := GetEntryDataView(target, viewDef))
					end else begin
						targetViewDef := parentView.targetViewDef
					end;
				if (l1 := Clone(targetViewDef)) then begin
						l1.realData := target;
						l1:?SetupForm(target, self);
						viewChildren := [Array: l1]
					end
			end;
		(targetView := self)
	end
};
