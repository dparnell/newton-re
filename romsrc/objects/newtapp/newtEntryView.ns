// newtEntryView, and what only it reaches

newtEntryView := {
	viewClass: clView,
	viewFlags: vVisible,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	currentViewDef: nil,
	currentDataDef: nil,
	currentStatView: nil,
	targetViewDef: nil,
	targetDataDef: nil,
	targetStatView: nil,
	entryChanged: nil,
	entryDirtied: nil,
	settingHeight: nil,
	viewDef: 'default,
	_entryViewForFiling: nil,
	viewSetupFormScript: func() begin
		local l1, l2, l3;
		_entryViewForFiling := self;
		(if ((l1 := nextEntry) < Length(entries)) then begin
				l2 := (target := entries[l1]);
				targetView := self;
				viewDef := (if (targetViewDef := (if entryViewDefs then entryViewDefs[l1])) then targetViewDef.symbol);
				if (l3 := GetEntryDataDef(l2)) then begin
						l3:?SetupForm(l2, self)
					end;
				(nextEntry := (l1 + 1))
			end)
	end,
	ShowFoundItem: func(a1, a2) begin
		(if (if targetViewDef then HasPath(targetViewDef, 'ShowFoundItem)) then currentStatView:ShowFoundItem(a1, a2))
	end,
	viewIdleScript: func() begin
		self:EndFlush();
		nil
	end,
	Retarget: func() begin
		targetViewDef := (currentViewDef := nil);
		targetDataDef := (currentDataDef := nil);
		currentStatView := nil;
		(foreach l1 in self:ChildViewFrames() do begin
				if HasPath(l1, 'Retarget) then begin
						l1:Retarget()
					end
			end)
	end,
	jamFromEntry: func(a1) begin
		(foreach l1 in self:ChildViewFrames() do begin
				if HasPath(l1, 'jamFromEntry) then begin
						l1:jamFromEntry(a1)
					end;
				if HasPath(l1, 'Retarget) then begin
						l1:Retarget()
					end
			end);
		self:StartFlush()
	end,
	viewQuitScript: func() begin
		self:EndFlush();
		(if entryDirtied then begin
				entryDirtied := nil;
				self:BroadcastChange('quit, target)
			end)
	end,
	StartFlush: func() begin
		if (if targetView then targetView.viewCObject) then begin
				targetView:SetupIdle(5000)
			end;
		(entryChanged := true)
	end,
	StartFlushWithChild: func(a1) begin
		self:StartFlush()
	end,
	EndFlush: func() begin
		(if entryChanged then begin
				self:FlushEntry(target);
				entryChanged := nil;
				entryDirtied := true;
				self:BroadcastChange('flush, target)
			end)
	end,
	FlushEntry: func(a1) begin
		local l1, l2, l3, l4, l5;
		(if EntryValid(a1) then begin
				try begin
						l1 := EntrySizeWithoutVBOs(a1)
					end onexception |evt.ex| do begin
						l1 := 0
					end;
				try begin
						EntryChange(a1)
					end onexception |evt.ex.fr.store| do begin
						l2 := CurrentException().error;
						l3 := EntryStore(a1):GetName();
						if (l2 = -10605) then begin
								l4 := "^0 changes could not be saved (\u201C\u^1\u201D\u is write-protected)"
							end else begin
								if (l2 = -10617) then begin
										l4 := "^0 changes could not be saved (\u201C\u^1\u201D\u is full)"
									end
							end;
						if l4 then begin
								self:Notify(3, title, ParamStr(l4, [Array: title, l3]))
							end else begin
								Rethrow()
							end;
						EntryUndoChanges(a1);
						self:RedoChildren()
					end;
				(if (self:AppMaxSizeExceeded exists) then (try begin
							l5 := EntrySizeWithoutVBOs(a1);
							(if (if (if (if (not settingHeight) then maxEntrySizeBytes) then (l5 > maxEntrySizeBytes)) then (l5 > l1)) then AddDeferredSend(self, 'AppMaxSizeExceeded, [Array: a1]))
						end onexception |evt.ex| do begin
							nil
						end))
			end else (try begin
					a1._uniqueID
				end onexception |evt.ex| do begin
					self:Notify(3, title, "The storage card was ejected so the last few changes have been lost.")
				end))
	end,
	EntryCool: func(a1) begin
		(if ((not target) or EntryStore(target):IsReadOnly()) then begin
				if a1 then begin
						self:Notify(3, title, "This is on a write protected card and cannot be changed")
					end;
				nil
			end else true)
	end,
	FilingChangedX: func() begin
		entryChanged := true;
		self:EndFlush()
	end
};
