// newtrocomboView, and what only it reaches

newtrocomboView := {
	viewClass: clView,
	viewFlags: vVisible,
	viewChildren: nil,
	viewBounds: nil,
	viewJustify: vjParentCenterH + vjSiblingBottomV,
	paths: [|Array|: ],
	format: uCardPositionAlertButton,
	shape: nil,
	jamSlot: nil,
	autoSize: nil,
	viewSetupFormScript: func() begin
		(if target then begin
				local l1;
				local l2;
				l2 := (foreach item in paths collect begin
					local l7, pos, l9, text;
					(if StrFilled(target.(item)) then begin
							l1 := true;
							target.(item)
						end else "")
				end);
				shape := [Array: ];
				if l1 then begin
						l7 := 0;
						(loop begin
								l9 := (if (pos := StrPos(format, "\n", l7)) then (pos - l7));
								if StrFilled((text := ParamStr(Substr(format, l7, l9), l2))) then begin
										AddArraySlot(shape, text)
									end;
								if (not pos) then begin
										break
									end;
								(l7 := (pos + 1))
							end)
					end;
				(if autoSize then ((viewBounds := Clone(viewBounds)).bottom := (viewBounds.top + (Length(shape) * FontHeight(viewFont)))))
			end else (shape := [Array: ]))
	end,
	jamFromEntry: jamFromEntry,
	viewSetupChildrenScript: func() begin
		box := self:LocalBox();
		fontHeight2 := FontHeight(viewFont);
		fontAscent2 := FontAscent(viewFont);
		local box;
		local fontHeight2;
		local fontAscent2;
		(foreach key, value in shape do begin
				shape[key] := MakeText(value, 0, (fontAscent2 + ((key - 1) * fontHeight2)), box.right, (fontAscent2 + (key * fontHeight2)))
			end)
	end,
	viewDrawScript: func() begin
		local bAnd2, l2;
		bAnd2 := BAnd(viewJustify, 3);
		l2 := 'left;
		if (bAnd2 = 1) then begin
				l2 := 'right
			end else begin
				if (bAnd2 = 2) then begin
						l2 := 'center
					end else begin
						if (bAnd2 = 3) then begin
								l2 := 'full
							end
					end
			end;
		(if shape then self:DrawShape(shape, {font: viewFont, penPattern: BAnd(viewFormat, 15), justification: l2}))
	end,
	TextScript: func() begin
		""
	end
};
