// newtSmartPhoneFilter, and what only it reaches

newtSmartPhoneFilter := {
	_proto: @newtPhoneFilter,
	PathQuery: func(a1) begin
		Query(GetUnionSoup(@cardfileSoupName), {type: 'words, words: a1})
	end,
	QueryItem: func(entry, preQuery) begin
		local stringInFrame, phone;
		(if entry.phones then (if (stringInFrame := FindStringInFrame(entry.phones, preQuery, true)) then begin
					phone := entry.phones[stringInFrame[1]];
					{item: ParamStr("^0 ^?1(^1)||", [Array: MakeDisplayPhone(phone), PhoneTypes.phoneText.(ClassOf(phone))]), id: MakeEntryAlias(entry)}
				end))
	end,
	ResolveItem: func(a1) begin
		targetView:jamFromEntry(ResolveEntryAlias(a1.id))
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

QueryItem_literal9 := same("newtSmartPhoneFilter.QueryItem.literals[9]");

PathQuery_code := same("newtSmartPhoneFilter.PathQuery.instructions");

ResolveItem_code := same("newtSmartPhoneFilter.ResolveItem.instructions");
