// newtFloatingBar, and what only it reaches

newtFloatingBar := {
	viewClass: clView,
	viewFlags: vVisible + vClickable,
	viewFormat: 0,
	viewJustify: vjParentFullH + vjParentBottomV,
	viewBounds: {left: 0, top: -20, right: 0, bottom: 0},
	menuButtons: nil,
	viewChildren: nil,
	outset: 6,
	height: 13,
	left: 0,
	right: 0,
	viewDrawScript: func() begin
		self:DrawShape(MakeRoundRect(left, 6, right, 10, 4), '{fillPattern: 5, penPattern: 0})
	end,
	viewSetupChildrenScript: func() begin
		viewChildren := nil;
		(if menuButtons then begin
				copy := Clone(menuButtons);
				l2 := -7;
				local copy;
				local l2;
				local copyItem;
				(foreach key, value in menuButtons do begin
						if (if HasPath(value, 'text) then value.text) then begin
								copyItem := (StrFontWidth(value.text, value.viewFont) + outset)
							end else begin
								copyItem := (value.viewBounds.right - value.viewBounds.left)
							end;
						copy[key] := copyItem;
						l2 := ((l2 + copyItem) + 7)
					end);
				right := (((left := (((((box := self:Parent():LocalBox()).right - box.left) - l2) - 16) div 2)) + l2) + 14);
				viewChildren := Clone(menuButtons);
				(foreach key, value in menuButtons do begin
						local box;
						copyItem := copy[key];
						viewChildren[key] := (if (key > 0) then {_proto: value, viewBounds: RelBounds(7, 0, copyItem, height), viewJustify: 8406022} else {_proto: value, viewBounds: RelBounds((left + 7), 4, copyItem, height), viewJustify: 8388614})
					end)
			end)
	end
};
