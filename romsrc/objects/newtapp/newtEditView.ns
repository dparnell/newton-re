// newtEditView: the editable NewtApp slot view for notes and ink (NPR 2.0): a
// newtroEditView whose children (the paragraphs, ink and shapes the user adds) are
// the array kept in target.(path).  It is write-protected when the entry cannot be
// changed, and keeps the caret in sight in a scrolling editor.
//
// This file holds newtEditView and what only it reaches.

newtEditView := {
	_proto: @newtroEditView,
	rollScrolling: true,
	// an entry that cannot be changed (EntryCool nil) is shown write-protected
	viewSetupFormScript: func() begin
		inherited:?viewSetupFormScript();
		(if (not self:EntryCool(nil)) then (self.viewFlags := BOr(self.viewFlags, vWriteProtected)))
	end,
	// a child changed: unless this view is the editor itself, flush the entry through
	// the editor and, half a second later, check that the caret is still in sight
	viewChangedScript: func(slot, view) begin
		(if (self <> editor) then begin
				editor:StartFlushWithChild(self);
				(if scrollerView then AddProcrastinatedSend('checkCaret, self, 'checkCaret, nil, 500))
			end)
	end,
	// scroll the editor (a line at a time, as far as it can) until the caret of the
	// paragraph that holds it is inside the editor's box
	checkCaret: func() begin
		local box, caretInfo, caretRelativeToVisibleRect, scrollYAmount2;
		(if Visible(editor) then (loop begin
					// stop unless the caret is in an open paragraph (65535: the class without flag bits
					// such as clDataTemplate)
					if ((((not (caretInfo := GetCaretInfo())) or (not caretInfo.view)) or (not caretInfo.view.viewCObject)) or (BAnd(caretInfo.view.viewClass, 65535) <> clParagraphView)) then begin
							break
						end;
					if (not box) then begin
							(box := editor:GlobalBox()).top := (box.top + 8);
							box.bottom := (box.bottom - viewLineSpacing)
						end;
					if ((not (caretRelativeToVisibleRect := caretInfo.view:CaretRelativeToVisibleRect(box))) or (caretRelativeToVisibleRect = 'inbox)) then begin
							break
						end;
					scrollYAmount2 := 0;
					if (caretRelativeToVisibleRect = 'top) then begin
							scrollYAmount2 := (-scrollYAmount)
						end else begin
							if (caretRelativeToVisibleRect = 'bottom) then begin
									scrollYAmount2 := scrollYAmount
								end
						end;
					if (scrollYAmount2 > 0) then begin
							if scrollerView.ScrollRect then begin
									scrollYAmount2 := min(((scrollerView.ScrollRect.bottom - viewOriginY) - viewHeight), scrollYAmount2)
								end
						end else begin
							scrollYAmount2 := max((-viewOriginY), scrollYAmount2)
						end;
					if (scrollYAmount2 = 0) then begin
							break
						end;
					(if (caretRelativeToVisibleRect = 'top) then scrollerView:DoScroll('up) else (if (caretRelativeToVisibleRect = 'bottom) then scrollerView:DoScroll('down) else break))
				end))
	end,
	// the user added a child: the first one makes the array in the entry, which
	// then is the view's children; flush
	viewAddChildScript: func(aNewOne) begin
		if (target.(path) = nil) then begin
				target.(path) := [Array: ];
				self.viewChildren := target.(path)
			end;
		self:StartFlushWithChild(aNewOne);
		nil
	end,
	// a child was removed: flush
	viewDropChildScript: func(a1) begin
		self:StartFlush();
		nil
	end
};
