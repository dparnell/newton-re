// newtEditView, and what only it reaches

newtEditView := {
	_proto: @newtroEditView,
	rollScrolling: true,
	viewSetupFormScript: func() begin
		inherited:?viewSetupFormScript();
		(if (not self:EntryCool(nil)) then (self.viewFlags := BOr(self.viewFlags, 128)))
	end,
	viewChangedScript: func(slot, view) begin
		(if (self <> editor) then begin
				editor:StartFlushWithChild(self);
				(if scrollerView then AddProcrastinatedSend('checkCaret, self, 'checkCaret, nil, 500))
			end)
	end,
	checkCaret: func() begin
		local box, caretInfo, caretRelativeToVisibleRect, scrollYAmount2;
		(if Visible(editor) then (loop begin
					if ((((not (caretInfo := GetCaretInfo())) or (not caretInfo.view)) or (not caretInfo.view.viewCObject)) or (BAnd(caretInfo.view.viewClass, 65535) <> 81)) then begin
							break
						end;
					if (not box) then begin
							(box := editor:GlobalBox()).top := (box.top + 8);
							box.bottom := (box.bottom - viewLineSpacing)
						end;
					if ((not (caretRelativeToVisibleRect := caretInfo.view:CaretRelativeToVisibleRect(box))) or (caretRelativeToVisibleRect = 'inbox)) then begin
							break
						end;
					scrollYAmount2 := 0;
					if (caretRelativeToVisibleRect = 'top) then begin
							scrollYAmount2 := (-scrollYAmount)
						end else begin
							if (caretRelativeToVisibleRect = 'bottom) then begin
									scrollYAmount2 := scrollYAmount
								end
						end;
					if (scrollYAmount2 > 0) then begin
							if scrollerView.ScrollRect then begin
									scrollYAmount2 := min(((scrollerView.ScrollRect.bottom - viewOriginY) - viewHeight), scrollYAmount2)
								end
						end else begin
							scrollYAmount2 := max((-viewOriginY), scrollYAmount2)
						end;
					if (scrollYAmount2 = 0) then begin
							break
						end;
					(if (caretRelativeToVisibleRect = 'top) then scrollerView:DoScroll('up) else (if (caretRelativeToVisibleRect = 'bottom) then scrollerView:DoScroll('down) else break))
				end))
	end,
	viewAddChildScript: func(aNewOne) begin
		if (target.(path) = nil) then begin
				target.(path) := [Array: ];
				self.viewChildren := target.(path)
			end;
		self:StartFlushWithChild(aNewOne);
		nil
	end,
	viewDropChildScript: func(a1) begin
		self:StartFlush();
		nil
	end
};
