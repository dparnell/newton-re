// newtStatusBar, and what only it reaches

newtStatusBar := {
	_proto: @newtStatusBarNoClose,
	firstRight: -26,
	viewSetupChildrenScript: func() begin
		local l1;
		if (if (l1 := GetUserConfig('blessedapp)) then (GetRoot().(l1) = base)) then begin
				firstRight := @newtStatusBarNoClose.firstRight
			end else begin
				firstRight := -26
			end;
		inherited:viewSetupChildrenScript();
		(if (not (if l1 then (GetRoot().(l1) = base))) then AddArraySlot(viewChildren, '{viewBounds: {left: -19, top: -16, right: -6, bottom: -3}, _proto: @protoCancelButton}))
	end
};
