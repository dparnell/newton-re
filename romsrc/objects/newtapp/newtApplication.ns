// newtApplication, and what only it reaches: the NewtApp framework's application
// base view proto (NPR "newtApplication").  A NewtApp application is a view made
// from it; it holds the soups (allSoups, each a newtSoup), the layouts it can show
// (allLayouts; one of them is the open child, `layout`), the folder (labelsFilter)
// and store (storesFilter) filters, the preferences it keeps in the system soup,
// and the system services' glue: Find, filing, routing (Duplicate/Delete), the
// stationery registration done at install and removal, and the keyboard commands.
// The layouts and entry views reach these slots by inheritance (newtAppBase is the
// application view itself).

newtApplication := {
	// the proto of the Prefs view the "i" button's Prefs item opens
	prefsView: @newtPrefsView,
	// sent (procrastinated) after PutAwayScript filed an item from the In Box: tells
	// every soup's watchers that it changed ('_routing as the changing app)
	putAwayXMit: func() begin
		(foreach item in allSoups do begin
				XmitSoupChange(item.soupName, '_routing, 'whatThe, nil)
			end)
	end,
	allViewDefs: nil,
	additionalButtons: nil,
	// the install-time work for an application's form (theForm, the base view's
	// template): registers the app for Find, its dataDefs and
	// viewDefs with the stationery registry and its classes; returns a frame of
	// what NewtRemoveScript needs to undo that, made internal so it outlives the card
	NewtInstallScript: func(theForm) begin
		frame2 := {appSymbol: (appSymbol := theForm.appSymbol), NewtRemoveScript: GetVariable(theForm, 'NewtRemoveScript), allDataDefs: [Array: ], allViewDefs: '{}};
		RegFindApps(appSymbol);
		if theForm.allDataDefs then begin
				local appSymbol;
				local frame2;
				(foreach item in theForm.allDataDefs do begin
						RegisterDataDef(item);
						AddArraySlot(frame2.allDataDefs, item.symbol)
					end)
			end;
		RegAppClasses(appSymbol, frame2.allDataDefs);
		if theForm.allViewDefs then begin
				frame2.allViewDefs := Clone(theForm.allViewDefs);
				(foreach key, value in theForm.allViewDefs do begin
						frame2.allViewDefs.(key) := (foreach item2 in value collect begin
							RegisterViewDef(item2, key);
							item2.symbol
						end)
					end)
			end;
		EnsureInternal(frame2)
	end,
	// opens a child view (an About or Prefs slip) and remembers it in _kiddos, so
	// RememberedCloseAll closes it when the application quits; a second call while
	// it is open closes it instead (a toggle)
	RememberedOpen: func(context) begin
		(if context.viewCObject then self:RememberedClose(context) else begin
				context:Open();
				if (not newtAppBase._kiddos) then begin
						newtAppBase._kiddos := [Array: ]
					end;
				SetAdd(newtAppBase._kiddos, GetView(context), true)
			end)
	end,
	// the application's preferences entry (GetAppPrefs, made from GetDefaultState
	// the first time), cached in prefsCache
	GetAppPreferences: func() begin
		if (not prefsCache) then begin
				prefsCache := GetAppPrefs(appSymbol, self:GetDefaultState())
			end;
		prefsCache
	end,
	// the system services' (filing, routing) question for the target: a frame with
	// target, targetView and targetStore.  The overview answers for itself; filing
	// targets the application view rather than the entry view.
	GetTargetInfo: func(a1) begin
		local frame2;
		frame2 := {};
		if (currentLayout = 'overview) then begin
				frame2 := layout:GetTargetInfo(a1)
			end else begin
				if (a1 = 'Filing) then begin
						frame2.targetView := targetApp
					end;
				if (not frame2.targetView) then begin
						frame2.targetView := targetView
					end;
				frame2.target := target;
				frame2.targetStore := (if (if target then IsSoupEntry(target)) then EntryStore(target))
			end;
		frame2
	end,
	// NPR AdoptSoupEntryFromStationery(adoptee, stationerySymbol, store, soup):
	// makes a new entry of the stationery's class from adoptee in the soup (a symbol
	// of allSoups, nil: the layout's master soup) on the store (nil: internal or the
	// default store as the "internalStore" preference says) and adds it; returns it
	AdoptSoupEntryFromStationery: func(copy2, class2, a3, a4) begin
		local adoptEntry, internalStore, copy;
		adoptEntry := nil;
		if (class2 = nil) then begin
				class2 := copy2.class
			end;
		if class2 then begin
				internalStore := self:GetAppPreferences().internalStore;
				if (not a3) then begin
						if internalStore then begin
								a3 := GetStores()[0]
							end else begin
								a3 := GetDefaultStore()
							end
					end;
				if ((not a3) or a3:IsReadOnly()) then begin
						self:Notify(kNotifyAlert, title, "New entries cannot be added to a read-only store.")
					end else begin
						if (a4 = nil) then begin
								if layout then begin
										a4 := layout.masterSoup
									end else begin
										a4 := allLayouts.(currentLayout).mastersoupSlot
									end
							end;
						if (ClassOf(a4) = 'symbol) then begin
								if (copy := allSoups.(a4)) then begin
										if (copy.theSoup = nil) then begin
												copy := Clone(copy);
												// a soup the application has not opened (only its master soup is): register
												// a copy for this call
												copy:MakeSoup(appSymbol)
											end;
										a4 := copy
									end else begin
										a4 := nil
									end
							end;
						if (a4 = nil) then begin
								Throw('|evt.ex.msg|, "Soup not found")
							end;
						adoptEntry := a4:AdoptEntry(copy2, class2);
						// the layout shows this soup: let it add and show the entry (with an effect)
						if (if layout then (a4 = layout.masterSoup)) then begin
								self:AddEntryDirect(adoptEntry, a3)
							end else begin
								a4:AddEntry(adoptEntry, a3)
							end
					end
			end else begin
				self:Notify(kNotifyAlert, title, "Couldn't find stationery.")
			end;
		adoptEntry
	end,
	// the stationery superSymbol for the application's dataDefs (the default is
	// the Notes app's)
	superSymbol: 'notes,
	// registers for changes to every soup the application uses
	// (NewtSoupChangedNotify)
	viewSetupDoneScript: func() begin
		(if allSoups then (foreach item in allSoups do begin
					if item.soupName then begin
							RegSoupChange(item.soupName, appSymbol, func(a1, a2, a3, a4) begin
								self:NewtSoupChangedNotify(a1, a2, a3, a4)
							end)
						end
				end))
	end,
	// closes a view opened by RememberedOpen and forgets it
	RememberedClose: func(a1) begin
		if newtAppBase._kiddos then begin
				SetRemove(newtAppBase._kiddos, a1)
			end;
		a1:Close()
	end,
	// what scrolling past the last (or first) entry does: 'wrap, 'stop, 'beepAndWrap
	// or 'beepAndStop (newtLayout's ScrollCursor)
	scrollingEndBehavior: 'beepAndWrap,
	previousLayout: 'default,
	// the keyboard commands (_keyCommands below): each presses the status bar's
	// button registered under that slot, if there is one
	_filingKeyScript: func(a1) begin
		newtAppBase:CommonKeyScript('_filingKeyButton)
	end,
	// Command-E: pops up the picker of the button registered as _titleKeyButton,
	// unless it is open already
	_titleKeyScript: func(a1) begin
		local _titleKeyButton;
		(if (_titleKeyButton := newtAppBase._titleKeyButton) then (if (not _titleKeyButton.info) then begin
					clicker();
					_titleKeyButton:Popit(true)
				end))
	end,
	// closing the application: closes remembered slips, saves the state, drops the
	// cached and view slots, removes the keyboard commands and soup registrations
	viewQuitScript: func() begin
		self:RememberedCloseAll();
		self:SaveAppState();
		ClearUndoStacks();
		prefsCache := nil;
		layout := nil;
		filterBar := nil;
		viewChildren := nil;
		saveWhatView := nil;
		saveWhat := nil;
		if allKeyCommands then begin
				(foreach item in allKeyCommands do begin
						RemoveSlot(newtAppBase, item[0].keyMessage)
					end)
			end;
		RemoveSlot(self, '_keyCommands);
		UnRegFolderChanged(appSymbol);
		if allSoups then begin
				(foreach item2 in allSoups do begin
						item2:DoneWithSoup(appSymbol)
					end);
				RemoveSlot(self, 'allSoups)
			end;
		'postQuit // so that viewPostQuitScript is sent once the children are gone
	end,
	// the folder tab's "All Items" text
	AppAll: allItems,
	// closes every view RememberedOpen opened
	RememberedCloseAll: func() begin
		if newtAppBase._kiddos then begin
				(foreach item in newtAppBase._kiddos do begin
						if item then begin
								item:Close()
							end
					end)
			end;
		(newtAppBase._kiddos := nil)
	end,
	_newKeyScript: func(a1) begin
		newtAppBase:CommonKeyScript('_newKeyButton)
	end,
	scrollingUpBehavior: 'bottom,
	target: nil,
	_actionKeyScript: func(a1) begin
		newtAppBase:CommonKeyScript('_actionKeyButton)
	end,
	// the application's own keyboard commands: [keyCommand frame, its function]
	// pairs, installed into the application view by viewSetupFormScript
	allKeyCommands: [|Array|: ],
	filterBar: nil,
	viewChildren: nil,
	// the routing slip's Delete (routeScripts below; NPR NewtDeleteScript(what,
	// view)): asks first in the overview, where several items may be selected
	newtDeleteScript: func(target, targetView) begin
		saveWhat := target;
		saveWhatView := targetView;
		(if (not target) then self:Notify(kNotifyAlert, title, "There is nothing to delete.") else (if (currentLayout = 'overview) then self:Confirm(title, "Delete all selected items? (Can\u2019\ut Undo)", self, 'newtDeleteActionConfirmCB) else self:newtDeleteActionHelper()))
	end,
	// RegFolderChanged's callback through viewSetupFormScript's closure: a folder
	// was renamed (a2 to a3) or deleted (a3 nil); moves the soup's entries and,
	// if the folder shown was that one, follows it in the folder tab
	FolderChanged: func(soupNotifyItem, a2, a3) begin
		local l1;
		if ((if (labelsFilter = a2) then a2) or (if (not a3) then (not labelsFilter))) then begin
				labelsFilter := a3;
				l1 := true
			end;
		self:FolderChangedX(soupNotifyItem, a2, a3);
		(if l1 then begin
				if filterBar then begin
						filterBar:UpdateFilter(a2, a3)
					end;
				self:FilterChanged()
			end)
	end,
	targetApp: nil,
	// the application is the frontmost view of its own kind (vApplication)
	viewFlags: vApplication + vClickable,
	// saves the folder positions and the filters, layouts and recognition settings
	// in the preferences entry
	SaveAppState: func() begin
		appPreferences := self:GetAppPreferences();
		local appPreferences;
		(foreach key, value in allSoups do begin
				self:SaveFolderPosition(key, value, labelsFilter)
			end);
		if (storesFilter exists) then begin
				appPreferences.storesFilter := (if storesFilter then storesFilter:GetSignature())
			end;
		appPreferences.autoPutawayEnabled := autoPutawayEnabled;
		appPreferences.labelsFilter := labelsFilter;
		appPreferences.currentLayout := currentLayout;
		appPreferences.previousLayout := previousLayout;
		appPreferences._recogSettings := _recogSettings;
		appPreferences.preferredViewDef := preferredViewDef;
		EntryChange(appPreferences)
	end,
	_showKeyButton: nil,
	// NPR: true (the default) lets filing move items to and from cards;
	// 'onlyCardRouting for filing to cards without folders
	doCardRouting: true,
	saveWhatView: nil,
	// presses the button view held in the application's slot a1, if any
	CommonKeyScript: func(a1) begin
		local l1;
		(if (l1 := newtAppBase.(a1)) then PressButton(l1))
	end,
	// the Delete confirmation's answer (a1 true: OK)
	newtDeleteActionConfirmCB: func(a1) begin
		(if a1 then begin
				self:newtDeleteActionHelper();
				ClearUndoStacks()
			end)
	end,
	// the viewDef the layouts show entries with (Show button)
	preferredViewDef: 'default,
	GetTargetView: func() begin
		targetView
	end,
	// NPR DateFind(date, findType, results, scope, findContext): finds the entries
	// of every soup whose dateFindSlot index is on, before or after the date (in
	// minutes since 1904); does nothing unless the application set dateFindSlot
	DateFind: func(a1, filter, findAllResults, a4, a5) begin
		if (not dateFindSlot) then begin
				return nil
			end;
		a5:SetStatus(Stringer([Array: "Searching in", " ", title, $\u2026]));
		if layout then begin
				layout:FlushData()
			end;
		l3 := 0;
		// the largest positive NewtScript integer (2^29 - 1): no upper bound
		l4 := 536870911;
		if (filter = 'dateBefore) then begin
				l4 := a1
			end else begin
				if (filter = 'dateOn) then begin
						l3 := a1;
						l4 := (a1 + 1440) // minutes in a day
					end else begin
						l3 := (a1 + 1) // 'dateAfter: from the next minute on
					end
			end;
		local l1;
		local cursor;
		local l3;
		local l4;
		(foreach item in allSoups do begin
				local soup, frame2;
				if (soup := GetUnionSoup(item.soupName)) then begin
						if (cursor := soup:Query({type: 'index, indexPath: dateFindSlot, beginKey: l3, endKey: l4})):entry() then begin
								frame2 := {_proto: GetVariable(self, 'soupFinder), owner: self, findType: filter, findWords: a1, isReset: true, zeroOneOrMoreResult: nil, cursor: cursor};
								if item.userName then begin
										frame2.title := item.userName
									end;
								AddArraySlot(findAllResults, frame2)
							end
					end
			end)
	end,
	// the singular and plural names of the application's items ("Item", "Items"),
	// used in the About view and the empty-folder message
	appObject: [|Array|: item_2, items_2],
	// the index path DateFind queries on; nil: no date find
	dateFindSlot: nil,
	// sent when filing moved or relabelled the target: the layout refreshes
	filingChanged: func() begin
		(if layout then layout:FilingChangedX())
	end,
	_proto: @protoDragger,
	// remembers the soup's cursor position (an entry alias) and key in the
	// preferences entry, per soup and folder; the entry is written later
	// (procrastinated) so that many changes cost one write
	SaveFolderPosition: func(key, value, a3) begin
		local appPreferences, l2, l3;
		if (not (l2 := (appPreferences := self:GetAppPreferences()).folderPositions)) then begin
				l2 := (appPreferences.folderPositions := {})
			end;
		if (not HasSlot(l2, key)) then begin
				l2.(key) := {}
			end;
		if (not HasSlot(l2, 'environs)) then begin
				l2.environs := {}
			end;
		if (not HasSlot(l2.environs, key)) then begin
				l2.environs.(key) := {}
			end;
		l3 := (if a3 then a3 else 'unfiled);
		l2.(key).(l3) := value:GetCursorPosition();
		l2.environs.(key).(l3) := value:GetCursorKey();
		AddProcrastinatedCall('_EntryChange, functions.EntryChange, [Array: appPreferences], 0)
	end,
	layout: nil,
	_recogSettings: nil,
	// NPR FilterChanged: the folder or store filter changed; saves each soup's
	// position in the old folder, resets its query and moves to the position kept
	// for the new one, then has the layout redisplay
	FilterChanged: func() begin
		(foreach key, value in allSoups do begin
				self:SaveFolderPosition(key, value, value.soupFilter);
				value.soupFilter := labelsFilter;
				if (storesFilter exists) then begin
						if (if storesFilter then (not storesFilter:IsValid())) then begin
								storesFilter := nil
							end;
						value.storesFilter := storesFilter
					end;
				value:SetupCursor();
				self:RestoreFolderPosition(key, value, labelsFilter)
			end);
		layout:FilterChanged()
	end,
	targetDataDef: nil,
	labelsFilter: nil,
	// NPR GetAppState: sets the filters, layouts and recognition settings from the
	// preferences entry and returns it
	GetAppState: func() begin
		if HasPath((appPreferences := self:GetAppPreferences()), 'storesFilter) then begin
				newtAppBase.storesFilter := nil;
				local appPreferences;
				(foreach item in GetStores() do begin
						if (item:GetSignature() = appPreferences.storesFilter) then begin
								// the store is identified by its signature
								newtAppBase.storesFilter := item;
								break
							end
					end)
			end;
		labelsFilter := appPreferences.labelsFilter;
		autoPutawayEnabled := appPreferences.autoPutawayEnabled;
		currentLayout := appPreferences.currentLayout;
		previousLayout := appPreferences.previousLayout;
		_recogSettings := appPreferences._recogSettings;
		if appPreferences.preferredViewDef then begin
				preferredViewDef := appPreferences.preferredViewDef
			end;
		appPreferences
	end,
	_filingKeyButton: nil,
	// the In Box's auto put away: files an arriving item if the user allowed it
	AutoPutaway: func(entry) begin
		(if autoPutawayEnabled then self:PutAwayScript(entry))
	end,
	prefsCache: nil,
	_titleKeyButton: nil,
	// adds an entry (from stationery) through the layout, or the application view
	// in the overview, with an upward slide and the flip sound; then, if this is
	// the blessed (backdrop) application, saves its state 10 seconds later
	AddEntryDirect: func(a1, store) begin
		local blessedapp;
		// 178391040: fxUp + fxSteps(6) + fxStepTime(5)
		(if (currentLayout = 'overview) then newtAppBase else layout):Effect(178391040, nil, @flip, '_HackAddEntryDirect, [Array: a1, store]);
		(if (if (blessedapp := GetUserConfig('blessedapp)) then (GetRoot().(blessedapp) = newtAppBase)) then AddProcrastinatedSend('SaveAppState, self, 'SaveAppState, [Array: ], 10000))
	end,
	// the key in allLayouts of the layout shown
	currentLayout: 'default,
	// the application view (set by viewSetupFormScript), which the layouts and
	// views below it reach by inheritance
	newtAppBase: nil,
	// NPR ShowFoundItem(entry, finder): shows a found entry; if it is in another
	// folder, switches to All Items (and the filter bar with it) first
	ShowFoundItem: func(a1, a2) begin
		if (a1.labels <> labelsFilter) then begin
				labelsFilter2 := labelsFilter;
				labelsFilter := '_all;
				local labelsFilter2;
				(foreach key, value in allSoups do begin
						value.soupFilter := '_all;
						if (storesFilter exists) then begin
								value.storesFilter := nil
							end;
						value:SetupCursor()
					end);
				layout:FilterChanged();
				if filterBar then begin
						filterBar:UpdateFilter(labelsFilter2, '_all)
					end
			end;
		layout:ShowFoundItem(a1, a2)
	end,
	allSoups: nil,
	// the scroll arrows go to the layout; the blessed app saves its position
	viewScrollDownScript: func() begin
		local blessedapp;
		layout:viewScrollDownScript();
		(if (if (blessedapp := GetUserConfig('blessedapp)) then (GetRoot().(blessedapp) = newtAppBase)) then AddProcrastinatedSend('SaveAppState, self, 'SaveAppState, [Array: ], 10000))
	end,
	// the overview button: toggles between the overview and the previous layout
	viewOverviewScript: func() begin
		self:ShowLayout((if (currentLayout = 'overview) then nil else 'overview))
	end,
	_newKeyButton: nil,
	// the view that has the user's attention (the layout's GetActiveViewX)
	GetActiveView: func() begin
		layout:?GetActiveViewX()
	end,
	appSymbol: nil,
	appEmptyStr: nil,
	// the application's name (the shared empty string here; an application sets it)
	title: uCardPositionAlertButton,
	// AddEntryDirect's effect's method: the layout adds and shows the entry
	_HackAddEntryDirect: func(a1, a2) begin
		layout:NewEntry(a1, true, a2)
	end,
	// NPR Find(text, results, scope, findContext): a standard find in every soup,
	// each result titled by the soup's userName if it has one
	find: func(a1, a2, a3, a4) begin
		(foreach item in allSoups do begin
				local count;
				count := Length(a2);
				self:StandardFind(a1, item.soupName, a2, a4, item.soupQuery.indexPath);
				if (if item.userName then (count < Length(a2))) then begin
						a2[count].title := item.userName
					end
			end)
	end,
	saveWhat: nil,
	// the routing slip's Duplicate (NPR NewtDuplicateScript(what, view)): the
	// layout duplicates the target with a slide to the left and the copier sound
	newtDuplicateScript: func(a1, a2) begin
		(if a1 then layout:Effect(178324480, nil, @copier, 'DuplicateEntry, [Array: a1]) else self:Notify(kNotifyAlert, title, "There is nothing to duplicate.")) // 178324480: fxLeft + fxSteps(6) + fxStepTime(5)
	end,
	allDataDefs: nil,
	// FolderChanged's work for one soup: relabels the entries of the old folder on
	// every store but the read-only ones (tags when the soup has them, else each
	// entry's labels slot)
	FolderChangedX: func(soupNotifyItem, oldFolder, a3) begin
		// the internal store has no such soup: the app never made it
		if (not GetStores()[0]:HasSoup(soupNotifyItem)) then begin
				return nil
			end;
		(if (soup := GetUnionSoup(soupNotifyItem)) then begin
				local cursor;
				local l2;
				local next2;
				local next;
				local soup;
				(foreach item in soup:GetSoupList() do begin
						local store;
						if (store := item:GetStore()):IsReadOnly() then begin
								self:Notify(kNotifyAlert, title, ParamStr("Items from the card \u201C\u^0\u201D\u cannot be moved because it is locked.", [Array: store:GetName()]))
							end else begin
								try begin
										if item:HasTags() then begin
												if a3 then begin
														if oldFolder then begin
																item:ModifyTag(oldFolder, a3)
															end else begin
																item:AddTags(a3)
															end
													end else begin
														if oldFolder then begin
																item:RemoveTags([Array: oldFolder])
															end
													end
											end else begin
												next2 := (cursor := item:Query({type: 'index, validTest: func(a1) begin
													(a1.labels = oldFolder)
												end})):entry();
												(while next2 do begin
														next2.labels := a3;
														next := cursor:Next();
														EntryChange(next2);
														(next2 := next)
													end)
											end
									end onexception |evt.ex| do begin
										l2 := true
									end
							end
					end);
				(if l2 then self:Notify(kNotifyAlert, title, "Some items could not be moved to the new folder."))
			end)
	end,
	// forgets the target once the view is gone
	viewPostQuitScript: func() begin
		(self.target := (self.targetView := nil))
	end,
	// what the About view (newtAboutView) shows; an application gives its own
	aboutInfo: {
		tagline: uCardPositionAlertButton,
		version: "NewtApp 1.0v1",
		Date: uCardPositionAlertButton,
		copyright: "©1993-1994 Apple Computer.  All rights reserved.",
		trademarks: uCardPositionAlertButton,
		credits: nil,
		extraInfo: func(theApp) begin
			nil
		end
	},
	GetTarget: func() begin
		target
	end,
	// the shape drawn by an empty layout with forceNewEntry nil: "There are no
	// Items in this folder.", kept in appEmptyStr
	AppEmpty: func() begin
		local box;
		box := self:LocalBox();
		(appEmptyStr := [Array: '{font: tsSystem + tsSize(10) + tsBold, justification: center}, MakeText(ParamStr("There are no ^0 in this folder.", [Array: appObject[1]]), box.left, box.top, box.right, (box.top + 40))])
	end,
	// true while the overview is open (newtOverLayout sets and clears it)
	dontStartWithFolder: nil,
	viewScrollUpScript: func() begin
		local blessedapp;
		layout:viewScrollUpScript();
		(if (if (blessedapp := GetUserConfig('blessedapp)) then (GetRoot().(blessedapp) = newtAppBase)) then AddProcrastinatedSend('SaveAppState, self, 'SaveAppState, [Array: ], 10000))
	end,
	// adds a copy of an entry, of its own class, to the master soup
	AddEntry: func(adoptEntry) begin
		self:AdoptEntryFromStationery(adoptEntry, nil, nil)
	end,
