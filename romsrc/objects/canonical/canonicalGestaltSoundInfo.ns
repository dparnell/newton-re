// canonicalGestaltSoundInfo, and what only it reaches
//
// Gestalt's frame for the sound hardware: sampling rate (the real 0.0
// here), sample size, compression, channels, and whether there
// is sound input and output.

canonicalGestaltSoundInfo := {
	// `stack` is the real 0.0 (shared/data.ns)
	samplingRate: stack,
	sampleSize: 0,
	compressionType: 0,
	numChannels: 0,
	hasInput: nil,
	hasOutput: true
};
