// canonicalScroller, and what only it reaches

canonicalScroller := {
	viewClass: clView,
	viewFlags: vVisible + vClipping + vClickable,
	declareSelf: 'base,
	ShowScroller: func() begin
		local l1;
		(l1 := self:ChildViewFrames())[1]:Show()
	end,
	HideScroller: func() begin
		local l1;
		(l1 := self:ChildViewFrames())[1]:Hide()
	end,
	scrolledView: nil,
	Scroller: nil,
	debug: 269208
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

ShowScroller_code := same("canonicalScroller.ShowScroller.instructions");
