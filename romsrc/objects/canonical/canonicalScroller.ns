// canonicalScroller, and what only it reaches
//
// The view of a book page's picture block whose picture is larger than the
// block (src/books/Pages.cpp, MakeBlockView): it clips the scrolled picture
// (canonicalScrollee) and holds the compass that scrolls it.

canonicalScroller := {
	viewClass: clView,
	viewFlags: vVisible + vClipping + vClickable,
	declareSelf: 'base,
	ShowScroller: func() begin
		local childViewFrames;
		(childViewFrames := self:ChildViewFrames())[1]:Show()
	end,
	HideScroller: func() begin
		local childViewFrames;
		(childViewFrames := self:ChildViewFrames())[1]:Hide()
	end,
	scrolledView: nil,
	Scroller: nil,
	debug: 269208
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

ShowScroller_code := same("canonicalScroller.ShowScroller.instructions");
