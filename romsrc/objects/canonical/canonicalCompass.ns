// canonicalCompass, and what only it reaches

canonicalCompass := {
	viewClass: clPictureView,
	viewBounds: {left: 1, top: -32, right: 31, bottom: -2},
	viewFlags: vVisible + vReadOnly + vClickable,
	viewFormat: 0,
	viewJustify: vjParentBottomV,
	viewTransferMode: 8,
	icon: {
		mask: bitmap('mask, "resources/mask/5224e9.png", "0000000000040174017400dd019200fb", 1),
		bits: bitmap('bits, "resources/bits/52257d.png", "0000000000040174017400dd019200fb", 1),
		bounds: {left: 0, top: 0, right: 30, bottom: 30}
	},
	viewSetupDoneScript: func() begin
		(self:Parent().Scroller := self)
	end,
	viewClickScript: func(unit) begin
		local l1, l2, box;
		InkOff(unit);
		playsound(@click);
		box := self:GlobalBox();
		l1 := (GetPoint(0, unit) - box.left);
		l2 := (GetPoint(1, unit) - box.top);
		self:TrackCompass(box, l1, l2);
		(loop begin
				if StrokeDone(unit) then begin
						break
					end;
				l1 := (GetPoint(4, unit) - box.left);
				l2 := (GetPoint(5, unit) - box.top);
				self:TrackCompass(box, l1, l2)
			end);
		true
	end,
	TrackCompass: func(box, a2, a3) begin
		local l1;
		l1 := ((viewBounds.right - viewBounds.left) - a2);
		if (a2 < a3) then begin
				if (l1 < a3) then begin
						self:ChangeScrolledOrigin(0, (-scrollDelta))
					end else begin
						self:ChangeScrolledOrigin(scrollDelta, 0)
					end
			end else begin
				if (l1 < a3) then begin
						self:ChangeScrolledOrigin((-scrollDelta), 0)
					end else begin
						self:ChangeScrolledOrigin(0, scrollDelta)
					end
			end;
		true
	end,
	ChangeScrolledOrigin: func(scrollDelta, scrollDelta2) begin
		local l1, l2, dataBounds, most, viewOriginX, viewOriginY;
		l1 := ((dataBounds := scrolledView.dataBounds).right - dataBounds.left);
		l2 := (dataBounds.bottom - dataBounds.top);
		viewOriginX := scrolledView.viewOriginX;
		viewOriginY := scrolledView.viewOriginY;
		if (scrollDelta <> 0) then begin
				most := max(0, (l1 - (base.viewBounds.right - base.viewBounds.left)));
				SetValue(scrolledView, 'viewOriginX, max((-most), min(0, (scrolledView.viewOriginX + scrollDelta))))
			end;
		if (scrollDelta2 <> 0) then begin
				most := max(0, (l2 - (base.viewBounds.bottom - base.viewBounds.top)));
				SetValue(scrolledView, 'viewOriginY, max((-most), min(0, (scrolledView.viewOriginY + scrollDelta2))))
			end;
		(if ((scrolledView.viewOriginX <> viewOriginX) or (scrolledView.viewOriginY <> viewOriginY)) then begin
				(dataBounds := {}).left := scrolledView.viewOriginX;
				dataBounds.top := scrolledView.viewOriginY;
				dataBounds.right := (dataBounds.left + l1);
				dataBounds.bottom := (dataBounds.top + l2);
				SetValue(scrolledView, 'viewBounds, SetBounds(0, 0, 10, 10));
				SetValue(scrolledView, 'viewBounds, dataBounds);
				RefreshViews()
			end)
	end,
	scrollDelta: 16,
	debug: 133473
};
