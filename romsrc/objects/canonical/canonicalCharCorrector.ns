// canonicalCharCorrector, and what only it reaches
//
// The correction picker (@canonicalCharCorrector, the root's preallocated
// 'correct view): the floating keyboard-like slip that opens on a word that
// is double-tapped.  It shows the word letter by letter (cText) or as ink
// (cInk, with a recognize button), the recogniser's alternatives
// (alternates), a format picker for fields with templates (templatePicker),
// arrows to move to the previous and next word, and a keyboard button.
// refCon says which word it corrects: {form: the view, wordOffset,
// wordLength}.  Its pieces - saveBounds, templatePicker, alternates, cText,
// cInk, recognizeButton - follow it.

canonicalCharCorrector := {
	// {form: the view, wordOffset, wordLength}: the word being corrected
	refCon: nil,
	// After setup: tie the ink view to the letters' view (cInk follows cText's
	// bounds) and, when setup found the word at the caret (refConChanged),
	// widen it to the whole word and show it as if the caret had moved there.
	viewSetupDoneScript: func() begin
		local refCon2, l2, wordOffset, l4, dynamicValue, scanWordEnd2;
		TieViews(cText, cInk, 'TieChangedScript);
		(if refConChanged then begin
				l2 := (refCon2 := refCon).form;
				wordOffset := refCon2.wordOffset;
				l4 := 0;
				if l2.text then begin
						dynamicValue := GetDynamicValue(l2, 'text, 'string);
						if (if (wordOffset > 0) then (not IsWhiteSpace(dynamicValue[(wordOffset - 1)]))) then begin
								wordOffset := (wordOffset - 1)
							end;
						wordOffset := ScanWordStart(dynamicValue, wordOffset, 0);
						l4 := ((scanWordEnd2 := ScanWordEnd(dynamicValue, wordOffset, StrLen(dynamicValue))) - wordOffset)
					end;
				refCon2.form := nil;
				self:ViewCaretChangedScript(l2, wordOffset, l4);
				(refConChanged := nil)
			end)
	end,
	cInk: nil,
	// Select the word in its view (the corrected word stays hilited there).
	SetHilite: func() begin
		local refCon2;
		(if (refCon2 := refCon).form.text then refCon2.form:SetHiliteNoUpdate(refCon2.wordOffset, (refCon2.wordOffset + refCon2.wordLength), true))
	end,
	viewFormat: vfFillWhite + vfFrameDragShadow + vfPen(2) + vfInset(1) + vfRound(5),
	// the context frame kept ready for the view (preallocatedContext), its
	// slots made in advance
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		refCon: nil,
		pickItems: nil,
		wordInfo: nil,
		templatePicker: nil,
		saveBounds: saveBounds,
		firstTime: true,
		viewclipper: nil,
		base: nil,
		alternates: nil,
		cText: nil,
		cInk: nil,
		recognizeButton: nil
	},
	// On closing: finish a pending update, put the caret after the word unless
	// the keyboard button closed it, and take away what this use added (the
	// children's slots, the bounds, the saved alternatives).
	viewQuitScript: func() begin
		if (refCon2 := refCon).form then begin
				cText:DoPendingUpdate()
			end;
		if (not self.gotoKeyboard) then begin
				if (if refCon2.form then refCon2.form.text) then begin
						hiliteBusy := true;
						self:SetCaret(StrLen((dynamicValue := GetDynamicValue(refCon2.form, 'text, 'string))));
						self:SetHilite();
						hiliteBusy := nil
					end
			end;
		self:UnregisterOpenKeyboard();
		inherited:viewQuitScript();
		local refCon2;
		local dynamicValue;
		(foreach item in [Array: 'alternates, 'cText, 'cInk, 'recognizeButton, 'Keyboard, 'viewBounds, 'viewFlags, 'hiliteBusy, 'savedPickItems, 'hiliteParms] do begin
				RemoveSlot(self, item)
			end);
		self.refCon := nil;
		self.pickItems := nil;
		self.wordInfo := nil;
		ClearTryString()
	end,
	preallocatedContext: 'correct,
	savedPickItems: nil,
	// The caret or selection moved (hiliteParms: [view, offset, length]): a
	// caret alone stands for the word around it; when that is another word,
	// show it - with a new template when the view needs another.  Answers 0
	// (nil when the template changed).
	doViewCaretChanged: func() begin
		local dynamicValue, len2, off2, len3, refCon2, l6, templateChanged;
		view := hiliteParms[0];
		off := hiliteParms[1];
		len := hiliteParms[2];
		hiliteParms := nil;
		if view.text then begin
				len2 := StrLen((dynamicValue := GetDynamicValue(view, 'text, 'string)))
			end;
		if (if dynamicValue then (off > len2)) then begin
				off := min(1, len2)
			end;
		off2 := off;
		len3 := len;
		if (if dynamicValue then (len = 0)) then begin
				if (if (off2 > 0) then (not IsWhiteSpace(dynamicValue[(off2 - 1)]))) then begin
						off2 := (off2 - 1);
						off2 := ScanWordStart(dynamicValue, off2, 0)
					end;
				len3 := (ScanWordEnd(dynamicValue, off2, len2) - off2)
			end;
		refCon2 := refCon;
		if (((l6 := (view <> refCon2.form)) or (off <> refCon2.wordOffset)) or (len <> refCon2.wordLength)) then begin
				refCon2.form := view;
				refCon2.wordOffset := off2;
				if (templateChanged := cText:TemplateChanged()) then begin
						refCon2.wordLength := len3;
						cText:SetNewWord(self:GetExternalWord(), 'external);
						cText:SetNewTemplate(templateChanged);
						cText:SyncView();
						len3 := refCon2.wordLength;
						hiliteBusy := nil;
						return nil
					end;
				if ((refCon2.wordLength <> 0) or (len3 <> 0)) then begin
						refCon2.wordLength := len3;
						self:UseExternalWord()
					end else begin
						if l6 then begin
								cText.wordSource := 'none;
								cText:DisplayExternal(nil)
							end
					end
			end;
		hiliteBusy := nil;
		0
	end,
	// The system's viewCaretChangedScript: no view any more closes the picker;
	// otherwise the move is handled now, unless an update is in progress.
	ViewCaretChangedScript: func(view, offset, length) begin
		hiliteParms := [Array: view, offset, length];
		if (not view) then begin
				cText.updatePending := nil;
				refCon.form := nil;
				self:Close();
				return nil
			end;
		(if (if (not hiliteBusy) then (not cText.updatePending)) then begin
				hiliteBusy := true;
				self:doViewCaretChanged()
			end)
	end,
	recognizeButton: nil,
	// the format picker, the alternatives, the letters, the left and right
	// arrows (previous and next word), the ink, the recognize button, the
	// close box, and the keyboard button
	viewChildren: [viewChildren:
		templatePicker,
		alternates,
		cText,
		{
			viewFlags: vVisible + vClickable,
			viewBounds: {left: 2, top: 20, right: 12, bottom: 32},
			viewJustify: vjSiblingTopV,
			viewFormat: 0,
			icon: @leftBitmap,
			// previous word; held down, at most one step every 20 ticks
			buttonPressedScript: func() begin
				local ticks2;
				ticks2 := Ticks();
				cText:Scroll(-1);
				(if ((ticks2 := (Ticks() - ticks2)) < 20) then Sleep((20 - ticks2)))
			end,
			_proto: @protoPictureButton
		},
		{
			viewFlags: vVisible + vClickable,
			viewBounds: {left: -12, top: 0, right: -2, bottom: 12},
			viewJustify: vjParentRightH + vjSiblingTopV,
			viewFormat: 0,
			icon: @rightBitmap,
			// next word
			buttonPressedScript: func() begin
				local ticks2;
				ticks2 := Ticks();
				cText:Scroll(1);
				(if ((ticks2 := (Ticks() - ticks2)) < 20) then Sleep((20 - ticks2)))
			end,
			_proto: @protoPictureButton
		},
		cInk,
		recognizeButton,
		{viewBounds: {left: -16, top: -16, right: -3, bottom: -3}, _proto: @protoCancelButton},
		{
			viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH + vjSiblingTopV,
			viewBounds: {left: -30, top: 0, right: -7, bottom: 13},
			icon: @keyButtonBitmap,
			// the keyboard button: close and open a keyboard for the view instead
			buttonClickScript: func() begin
				correct.gotoKeyboard := true;
				OpenKeypadFor(refCon.form)
			end,
			_proto: @protoPictureButton
		}
	],
	// strokes written on the picker itself do nothing
	viewStrokeScript: func(unit) begin
		nil
	end,
	viewFlags: vFloating + vClickable + vStrokesAllowed,
	cText: nil,
	// GetCaretRefCon: the refCon for where the caret or the first selection
	// is ({form, wordOffset, wordLength}), or nil.
	GetCaretRefCon: func() begin
		local frame2, caretBox, view, hiliteOffsets;
		if (caretBox := GetCaretBox()) then begin
				frame2 := {form: (view := caretBox.view), wordOffset: 0, wordLength: 0};
				if (if HasPath(view, 'text) then (caretBox.offset >= 0)) then begin
						frame2.wordOffset := caretBox.offset
					end
			end;
		if (not frame2) then begin
				if (hiliteOffsets := GetHiliteOffsets()) then begin
						frame2 := {form: (hiliteOffsets := hiliteOffsets[0])[0], wordOffset: hiliteOffsets[1], wordLength: (hiliteOffsets[2] - hiliteOffsets[1])}
					end
			end;
		frame2
	end,
	// RestoreAlternates(pickItems): an undo of UsePickItems.
	RestoreAlternates: func(a1) begin
		(pickItems := a1)
	end,
	// SetStartStop(start, stop): the word is the text from start to stop.
	SetStartStop: func(scanWordEnd, scanWordEnd2) begin
		local refCon2;
		(refCon2 := refCon).wordOffset := scanWordEnd;
		(refCon2.wordLength := (scanWordEnd2 - scanWordEnd))
	end,
	// The screen rotated: just close.
	ReOrientToScreen: func() begin
		self:Close()
	end,
	// The alternatives changed (SetPickItems): undo can bring the old ones
	// back; an ink word has none; the alternatives line is redrawn.
	UsePickItems: func() begin
		local wordForDisplay, len;
		AddUndoAction('RestoreAlternates, [Array: savedPickItems]);
		len := StrLen((wordForDisplay := cText:GetWordForDisplay()));
		if cText:IsInkWord() then begin
				pickItems := nil
			end;
		alternates:SyncView();
		(savedPickItems := nil)
	end,
	// The alternatives for a word in the view: the recogniser's, from the
	// correction info kept for it.
	SetExternalPickItems: func() begin
		local refCon2, new;
		new := correctInfo:FindNew((refCon2 := refCon).form, refCon2.wordOffset, refCon2.wordLength);
		pickItems := nil;
		(if new then (pickItems := new:GetWords()))
	end,
	// GetExternalWord: the word as it is in the view (a plain string), or an
	// empty string for a view with no text.
	GetExternalWord: func() begin
		local part, refCon2;
		if HasPath((refCon2 := refCon), 'form.text) then begin
				SetClass((part := Substr((part := GetDynamicValue(refCon2.form, 'text, 'string)), refCon2.wordOffset, refCon2.wordLength)), 'string)
			end else begin
				part := SPrintObject("")
			end;
		part
	end,
	// the children's slot names and templates, made once for the view
	allocateContext: [|Array|:
		'templatePicker,
		templatePicker,
		'alternates,
		alternates,
		'cText,
		cText,
		'cInk,
		cInk,
		'recognizeButton,
		recognizeButton
	],
	// Show the word that is in the view (an empty word for a view without
	// text), then redraw the ink.
	UseExternalWord: func() begin
		if refCon.form.text then begin
				cText:SetupAll(self:GetExternalWord(), 'external, cText.template, nil)
			end else begin
				cText:SetupAll(SPrintObject(""), 'none, nil, nil)
			end;
		cInk:Dirty()
	end,
	_proto: @protoKeyboard,
	// CheckMergeInk: two ink words side by side at the word's start (a space
	// between them deleted) merged into one ink word.
	CheckMergeInk: func() begin
		local refCon2, l2, dynamicValue, wordOffset, inkAt, inkAt2, mergeInk2;
		dynamicValue := GetDynamicValue((l2 := (refCon2 := refCon).form), 'text, 'string);
		wordOffset := refCon2.wordOffset;
		(if (if IsInk(dynamicValue[wordOffset]) then IsInk(dynamicValue[(wordOffset + 1)])) then begin
				inkAt := GetInkAt(l2, wordOffset);
				inkAt2 := GetInkAt(l2, (wordOffset + 1));
				mergeInk2 := MergeInk(inkAt, inkAt2);
				// \uF701 is the character that stands for an ink word in a rich string
				InsertStyledText(l2, wordOffset, 2, "\uF701\u", [styles: 1, mergeInk2.ink]);
				(refCon2.wordLength := (refCon2.wordLength - 1))
			end)
	end,
	// [view, offset, length] of the last caret move, until it is handled;
	// hiliteBusy: set while the picker itself moves the selection
	hiliteParms: nil,
	viewJustify: vjParentCenterH,
	savedRemote: nil,
	alternates: nil,
	// The alternatives while a letter is being edited: the word with each of
	// that letter's alternative characters (altChars) in its place; else the
	// word itself, unless it is ink.
	SetInternalPickItems: func() begin
		lastChar := cText.lastChar;
		template := cText.template;
		if (if (not cText:FixedWord()) then lastChar) then begin
				altChar := cText.altChars[lastChar];
				l5 := (lastChar - cText.wordLeft);
				if altChar then begin
						currentWord := cText:CurrentWord();
						list := Array(((l7 := (StrLen(altChar) - 1)) + 1), nil);
						local lastChar;
						local template;
						local list;
						local altChar;
						local l5;
						local currentWord;
						local l7;
						(for i := 0 to l7 do begin
								local wordForDisplay;
								currentWord[l5] := altChar[i];
								list[i] := Clone(currentWord)
							end)
					end
			end;
		if (not list) then begin
				if ((StrLen((wordForDisplay := cText:GetWordForDisplay())) = 0) or (not IsInk(wordForDisplay[0]))) then begin
						list := [Array: wordForDisplay]
					end else begin
						list := [Array: ]
					end
			end;
		pickItems := nil;
		(if (Length(list) > 0) then (pickItems := list))
	end,
	// SetStartLen(offset, length) and SetCaret(offset): set the word's range.
	SetStartLen: func(offset, len) begin
		local refCon2;
		(refCon2 := refCon).wordOffset := offset;
		(refCon2.wordLength := len)
	end,
	SetCaret: func(wordOffset) begin
		local refCon2;
		(refCon2 := refCon).wordOffset := wordOffset;
		(refCon2.wordLength := 0)
	end,
	// ShowHide: an ink word shows the ink and the recognize button, a text word
	// the letters.
	ShowHide: func() begin
		(if IsInk(cText.text[cText.wordLeft]) then begin
				cInk:ShowView(true);
				cInk:Dirty();
				recognizeButton:ShowView(true);
				cText:ShowView(nil)
			end else begin
				cText:ShowView(true);
				cInk:ShowView(nil);
				recognizeButton:ShowView(nil)
			end)
	end,
	bounds: nil,
	wordInfo: nil,
	// Setup: a picker 10 letter cells wide (8 when that is wider than the
	// screen), kept above the bottom of the screen; registered as an open
	// keyboard; the first alternative (or nothing) as the word; the refCon
	// found from the caret when it was opened without one.
	viewSetupFormScript: func() begin
		local viewBounds, copy, l3, l4, viewTemplate;
		viewBounds := self:Parent().viewBounds;
		copy := Clone(saveBounds);
		l3 := 10;
		if ((l4 := (28 + (10 * cText.cellWidth))) > (viewBounds.right - viewBounds.left)) then begin
				l3 := 8;
				l4 := (28 + (8 * cText.cellWidth))
			end;
		copy.left := 0;
		copy.right := l4;
		if (copy.bottom > viewBounds.bottom) then begin
				copy.bottom := (viewBounds.bottom - 29);
				copy.top := (copy.bottom - 64)
			end;
		self.saveBounds := copy;
		inherited:viewSetupFormScript();
		self:RegisterOpenKeyboard(6);
		cText.maxChars := l3;
		if wordInfo then begin
				cText:SetNewWord(pickItems[0], 'external);
				wordInfo := nil
			end else begin
				if (if pickItems then (Length(pickItems) > 0)) then begin
						cText:SetNewWord(pickItems[0], 'pickItems)
					end else begin
						cText:SetNewWord(SPrintObject(""), 'none)
					end
			end;
		if (not self.refCon) then begin
				self.refCon := self:GetCaretRefCon();
				refConChanged := true
			end;
		cText:SetNewTemplate((viewTemplate := cText:GetViewTemplate()))
	end,
	// SetPickItems: the alternatives for where the word came from (cText's
	// wordSource): one word as it is, the view's, the letter being edited, the
	// recogniser's list, or none.
	SetPickItems: func() begin
		local wordSource;
		wordSource := cText.wordSource;
		savedPickItems := Clone(pickItems);
		(if (wordSource = 'single) then self:SetSinglePickItems() else (if (wordSource = 'external) then self:SetExternalPickItems() else (if (wordSource = 'Editing) then self:SetInternalPickItems() else (if (wordSource = 'pickItems) then (pickItems := pickItems) else (if (wordSource = 'none) then (pickItems := nil))))))
	end,
	// A tap on the tab at the top centre is the keyboard's (it drags the
	// picker); the letters are set up again after it.
	viewClickScript: func(unit) begin
		local pt, pt2, box;
		pt := GetPoint(firstX, unit);
		pt2 := GetPoint(firstY, unit);
		box := self:GlobalBox();
		(if (if (if ((pt2 - box.top) < 6) then (abs((pt - ((box.left + box.right) >> 1))) < 7)) then inherited:viewClickScript(unit)) then begin
				cText:viewSetupDoneScript();
				true
			end)
	end,
	viewEffect: nil,
	// The word itself as the only alternative.
	SetSinglePickItems: func() begin
		local wordForDisplay;
		(pickItems := [Array: (wordForDisplay := cText:GetWordForDisplay())])
	end,
	// CorrectWord(text, asWordInfo): put text in place of the word in the view
	// (in the font there) - with asWordInfo a protoWordInfo of all the
	// alternatives, so the view keeps them.
	CorrectWord: func(text, a2) begin
		local refCon2, copy, styleAtOffset, frame2;
		refCon2 := refCon;
		copy := text;
		if a2 then begin
				copy := Clone(@protoWordInfo);
				copy:SetWords(pickItems)
			end;
		styleAtOffset := refCon2.form:GetStyleAtOffset(refCon2.wordOffset);
		refCon2.form:HandleInsertItems((frame2 := {insertItems: copy, insertOffset: refCon2.wordOffset, replaceChars: refCon2.wordLength, defaultFontSpec: styleAtOffset, addspace: nil, moveCaret: nil}))
	end,
	refConChanged: nil,
	pickItems: nil,
	hiliteBusy: nil,
	templatePicker: nil,
	saveBounds: saveBounds,
	// ReplaceSelection(text, refCon, asWordInfo): replace the word with text
	// and hilite it; a view without text (a comb view) gets the text typed
	// into it as keys, and the word is found from the caret after.  Nothing
	// for a view the comb corrector cannot work with.
	ReplaceSelection: func(text, refCon, a3) begin
		local refCon2, len, caretInfo;
		if (not ViewWorksWithCombCorrector((refCon2 := refCon).form)) then begin
				return nil
			end;
		len := StrLen(text);
		if (not refCon2.form.text) then begin
				PostKeyString(GetKeyView(), text);
				refCon2.form := GetKeyView();
				if (if (if (if (if (caretInfo := (if (if (caretInfo := GetCaretInfo()) then (caretInfo.view = refCon2.form)) then caretInfo.info)) then (ClassOf(caretInfo) = 'paraCaret)) then caretInfo.offset) then (caretInfo.offset > 0)) then (caretInfo.length = 0)) then begin
						self:SetStartLen((caretInfo.offset - len), len)
					end else begin
						self:SetStartLen(0, len)
					end
			end;
		self:CorrectWord(text, a3);
		refCon2.wordLength := len;
		self:SetHilite()
	end
};

// Where the picker opens: its bounds as protoKeyboard keeps them (its width
// is set in viewSetupFormScript).
saveBounds := {left: 0, top: 387, right: 224, bottom: 451};

// The format picker ("Format "): shown only for a template with several
// formats (templateArray); a choice switches the word to that format.
templatePicker := {
	viewFlags: vVisible + vClickable,
	viewJustify: vjParentBottomV + oneLineOnly,
	viewFormat: vfInset(1),
	viewBounds: {left: 8, top: -10, right: 68, bottom: 0},
	text: "Format ",
	labelCommands: nil,
	checkCurrentItem: nil,
	preallocatedContext: 'templatePicker,
	// shown only when the template has formats; they are its choices
	viewSetupFormScript: func() begin
		self:ShowView((labelCommands := cText.template.templateArray));
		inherited:viewSetupFormScript()
	end,
	// LabelActionScript(index): the word put into that format
	LabelActionScript: func(index) begin
		local template, wordForDisplay;
		template := cText.template;
		wordForDisplay := cText:GetWordForDisplay();
		template:switch(index, wordForDisplay);
		cText:SetupAll(wordForDisplay, 'single, template, true);
		cText:InvalDrawCache('all)
	end,
	_proto: @protoLabelPicker
};

// The line of alternative words, after the field's label (or none): a tap
// on one makes it the word.
alternates := {
	viewFlags: vVisible,
	viewBounds: {left: 4, top: 0, right: 4, bottom: 16},
	viewJustify: vjParentFullH + oneLineOnly,
	title: uCardPositionAlertButton,
	defaultTitle: uCardPositionAlertButton,
	text: nil,
	separator: separator,
	altItems: nil,
	numChoices: nil,
	firstTime: true,
	preallocatedContext: 'alternates,
	// the text built anew each time but the first
	viewSetupFormScript: func() begin
		if (not firstTime) then begin
				SetValue(self, 'text, self:Build())
			end;
		(firstTime := nil)
	end,
	// GetTitle: the view's label (its parent's label, or the labelLine's text)
	// without the U+FC01/U+FC02 marker characters, else defaultTitle.
	GetTitle: func() begin
		local copy, form, labelLine;
		if (if (labelLine := (form := refCon.form)._parent.label) then IsString(labelLine)) then begin
				copy := Clone(labelLine)
			end else begin
				if (not (labelLine := form.labelLine)) then begin
						labelLine := form._parent.labelLine
					end;
				if (if (if labelLine then labelLine.text) then IsString(labelLine.text)) then begin
						copy := Clone(labelLine.text)
					end
			end;
		if copy then begin
				StrReplace(copy, "\uFC01\u", "", 1);
				StrReplace(copy, "\uFC02\u", "", 1)
			end else begin
				copy := defaultTitle
			end;
		return copy
	end,
	// Build: sets the title and answers it - nothing more, although it
	// declares nine more locals that its code never uses.
	Build: func() begin
		local pickItems2, l2, l3, l4, l5, l6, l7, l8, l9, l10;
		pickItems2 := pickItems;
		(l4 := (title := self:GetTitle()))
	end,
	// Track the pen along the alternatives (separated by `separator`),
	// inverting the one under it; the one it is lifted on moves to the front
	// of pickItems and becomes the word.
	viewClickScript: func(unit) begin
		InkOff(unit);
		playsound(@click);
		strWidth2 := StrWidth(separator);
		if ((strWidth3 := StrWidth(title)) > 0) then begin
				strWidth3 := strWidth3
			end;
		(loop begin
				pt := GetPoint(finalX, unit);
				pt2 := GetPoint(finalY, unit);
				(box := self:GlobalBox()).left := (box.left + strWidth3);
				local strWidth2;
				local strWidth3;
				local pt;
				local pt2;
				local box;
