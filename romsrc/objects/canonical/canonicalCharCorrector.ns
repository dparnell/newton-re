// The word as ink, for an ink word: drawn as written; a tap pops up
// Recognize, Delete and, next to other ink words, Join Left/Join Right; a
// scrub deletes the word, a caret gesture splits it.
cInk := {
	viewClass: clView,
	viewFlags: vVisible + vClickable + vStrokesAllowed + vGesturesAllowed + vCharsAllowed,
	viewBounds: nil,
	viewJustify: vjParentCenterH,
	popChars: nil,
	unit: nil,
	itemBox: nil,
	preallocatedContext: 'cInk,
	// as wide as the letters, 45 pixels high
	viewSetupFormScript: func() begin
		local copy;
		(copy := Clone(cText.viewBounds)).bottom := (copy.top + 45);
		(self.viewBounds := copy)
	end,
	// clicks are not used: taps come as gestures
	viewClickScript: func(unit) begin
		nil
	end,
	// the word's ink as strokes, or nil
	GetInkStrokes: func() begin
		local inkAt, expandInk2;
		if (inkAt := GetInkAt(refCon.form, refCon.wordOffset)) then begin
				CalcBundleBounds((expandInk2 := ExpandInk(inkAt, 0)))
			end;
		return expandInk2
	end,
	// the ink drawn as written, inset in the view; itemBox is where it went
	viewDrawScript: func() begin
		local inkStrokes, insetRect2;
		(if (inkStrokes := self:GetInkStrokes()) then begin
				insetRect2 := InsetRect(self:GlobalBox(), 10, 8);
				(itemBox := DrawOriginal(inkStrokes, insetRect2))
			end)
	end,
	// cText's bounds changed: follow them
	TieChangedScript: func(a1, a2) begin
		(if (a2 = 'viewBounds) then (self.viewBounds := a1.viewBounds))
	end,
	viewStrokeScript: func(unit) begin
		nil
	end,
	// words written on the ink are used up
	viewWordScript: func(unit) begin
		true
	end,
	// the gestures on the ink: tap, scrub and caret
	viewgesturescript: func(unit, gesture) begin
		local handleTap;
		handleTap := nil;
		if (gesture = aeTap) then begin
				handleTap := self:HandleTap(unit)
			end else begin
				if (gesture = aeScrub) then begin
						handleTap := self:HandleScrub(unit)
					end else begin
						if (gesture = aeCaret) then begin
								handleTap := self:HandleCaret(unit)
							end
					end
			end;
		return handleTap
	end,
	// HandleCaret: split the ink word where the caret gesture was, with a
	// space between the two halves.
	HandleCaret: func(unit) begin
		local l1, refCon2, inkAt, gesturePoint2, scaleX2, splitInkAt2, sPrintObject2, list, wordOffset;
		l1 := nil;
		CalcInkBounds((inkAt := GetInkAt((refCon2 := refCon).form, refCon2.wordOffset)));
		scaleX2 := ScaleX((gesturePoint2 := GesturePoint(1, unit)).x, itemBox, inkAt.viewBounds);
		if (splitInkAt2 := SplitInkAt(inkAt, scaleX2, 10)) then begin
				(sPrintObject2 := SPrintObject("   "))[0] := $\uF701;
				sPrintObject2[2] := $\uF701;
				list := [styles: 2, splitInkAt2[0].ink, 1, splitInkAt2[1].ink];
				wordOffset := refCon2.wordOffset;
				InsertStyledText(refCon2.form, wordOffset, refCon2.wordLength, sPrintObject2, list);
				SetKeyView(refCon2.form, wordOffset);
				l1 := true
			end;
		return l1
	end,
	// HandleScrub(unit): delete the word (with the scrub's effect) and go on
	// to the next one.
	HandleScrub: func(unit) begin
		local l1;
		l1 := nil;
		if cText:DeleteText(cText.wordLeft, cText.wordRight) then begin
				if unit then begin
						DoScrubEffect(unit)
					end;
				correct:Dirty();
				cText:Scroll(1);
				l1 := true
			end;
		return l1
	end,
	// HandleTap: the popup of what can be done with the ink word.
	HandleTap: func(unit) begin
		local strokeBounds2, box, dynamicValue, wordOffset, scanPrevWordEnd2, l6;
		strokeBounds2 := StrokeBounds(unit);
		box := self:GlobalBox();
		AddArraySlot((popChars := [Array: ]), {item: "Recognize", code: 0});
		AddArraySlot(popChars, {item: "Delete", code: 1, unit: unit});
		// rc is no local either: it is set in the context
		if (dynamicValue := GetDynamicValue((rc := correct.refCon).form, 'text, 'string)) then begin
				if ((wordOffset := rc.wordOffset) > 0) then begin
						if (if (if (scanPrevWordEnd2 := ScanPrevWordEnd(dynamicValue, (wordOffset - 1), 0)) then (scanPrevWordEnd2 > 0)) then IsInk(dynamicValue[(scanPrevWordEnd2 - 1)])) then begin
								l6 := (wordOffset - scanPrevWordEnd2);
								AddArraySlot(popChars, {item: "Join Left", code: 3, left: (cText.wordLeft - l6), right: cText.wordLeft})
							end
					end;
				wordOffset := (rc.wordOffset + rc.wordLength);
				if (if (scanPrevWordEnd2 := ScanNextWord(dynamicValue, wordOffset, StrLen(dynamicValue))) then IsInk(dynamicValue[scanPrevWordEnd2])) then begin
						l6 := (scanPrevWordEnd2 - wordOffset);
						AddArraySlot(popChars, {item: "Join Right", code: 2, left: cText.wordRight, right: (cText.wordRight + l6)})
					end
			end;
		DoPopup(popChars, (strokeBounds2.right - box.left), (strokeBounds2.top - box.top), self);
		true
	end,
	// the popup's choice, by its code: 0 Recognize, 1 Delete, 2 and 3 join
	pickActionScript: func(index) begin
		local popChar;
		if popChars then begin
				if ((popChar := popChars[index]).code = 0) then begin
						recognizeButton:Recognize()
					end else begin
						if (popChar.code = 1) then begin
								self:HandleScrub(nil)
							end else begin
								if ((popChar.code = 2) or (popChar.code = 3)) then begin
										self:HandleJoin(popChar)
									end
							end
					end
			end;
		(popChars := nil)
	end,
	// HandleJoin: delete what lies between this word and the next ink word.
	HandleJoin: func(popChar) begin
		cText:DeleteText(popChar.left, popChar.right)
	end
};

recognize := "Recognize";

// The Recognize button under an ink word: the word recognised as text in
// its view, then shown.
recognizeButton := {
	viewBounds: {left: 0, top: -16, right: 55, bottom: -3},
	viewFlags: vVisible + vReadOnly + vClickable,
	viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingCenterH + oneLineOnly,
	text: recognize,
	buttonClickScript: func() begin
		self:Recognize()
	end,
	preallocatedContext: 'recognizeButton,
	// Recognize: the ink word read as text in its view (RecognizePara), the
	// word's length set to what it became, the result hilited and shown
	Recognize: func() begin
		local hiliteBusy, refCon, recognizePara2;
		cText:SaveUndoState('external);
		hiliteBusy := correct.hiliteBusy;
		correct.hiliteBusy := true;
		correctInfo:offset((refCon := correct.refCon).form, refCon.wordOffset, refCon.wordLength, 0);
		recognizePara2 := RecognizePara(refCon.form, refCon.wordOffset, (refCon.wordOffset + refCon.wordLength), 1, nil);
		refCon.wordLength := (recognizePara2 - refCon.wordOffset);
		correct.hiliteBusy := hiliteBusy;
		self:SetHilite();
		self:UseExternalWord()
	end,
	_proto: @protoTextButton
};

separator := " • ";

