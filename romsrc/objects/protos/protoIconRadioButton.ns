// protoIconRadioButton: a radio button whose label is a picture (labelIcon)
// with text (labelText) below it, both centred to the right of the button; its
// _proto, a protoCheckboxIcon with that label layout, is unnamed.

protoIconRadioButton := {
	// the radio button's pictures, off and on
	icon: @radioOffBitmap,
	onBitmap: @radioOnBitmap,
	offBitmap: @radioOffBitmap,
	// a radio button's click and radioClickScript, shared with protoRadioButton
	viewClickScript: viewClickScript_2,
	radioClickScript: radioClickScript,
	// (this frame's debug number, and its _proto's below, are the ROM's own)
	debug: 46622864,
	_proto: {
		// the gap between the picture and the text, and the label's text and picture
		spacing: 4,
		labelText: nil,
		labelIcon: nil,
		// viewSetupChildrenScript: centres the picture and the text below it in the
		// view (right of the 16-pixel button), each centred on the wider of the two;
		// copies of the two step children get those bounds
		viewSetupChildrenScript: func() begin
			local bounds, bounds2, copy, copy2, l5, l6, strFontWidth2, l8, most, box, l11;
			bounds := SetBounds(0, 0, 0, 0);
			bounds2 := SetBounds(0, 0, 0, 0);
			copy := Clone(stepChildren[0]);
			copy2 := Clone(stepChildren[1]);
			l5 := (labelIcon.bounds.right - labelIcon.bounds.left);
			l6 := (labelIcon.bounds.bottom - labelIcon.bounds.top);
			strFontWidth2 := StrFontWidth(labelText, viewFont);
			l8 := (FontAscent(viewFont) + FontDescent(viewFont));
			most := max(l5, strFontWidth2);
			bounds.left := (16 + ((most - l5) div 2));
			bounds.right := (bounds.left + l5);
			bounds2.left := (16 + ((most - strFontWidth2) div 2));
			bounds2.right := (bounds2.left + strFontWidth2);
			l11 := ((((box := self:LocalBox()).bottom - box.top) - ((l6 + spacing) + l8)) div 2);
			bounds.top := l11;
			bounds.bottom := (bounds.top + l6);
			bounds2.top := (bounds.bottom + spacing);
			bounds2.bottom := (bounds2.top + l8);
			copy.viewBounds := bounds;
			copy2.viewBounds := bounds2;
			(self.stepChildren := [Array: copy, copy2])
		end,
		debug: 5826406,
		stepChildren: [stepChildren:
			{
				viewClass: clPictureView,
				viewFlags: vVisible + vReadOnly,
				// shows labelIcon
				viewSetupFormScript: func() begin
					(self.icon := labelIcon)
				end
			},
			{
				viewClass: clTextView,
				viewFlags: vVisible + vReadOnly,
				viewJustify: oneLineOnly,
				// shows labelText
				viewSetupFormScript: func() begin
					(self.text := labelText)
				end
			}
		],
		_proto: @protoCheckboxIcon
	}
};

