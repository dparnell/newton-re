// protoCancelButton, and what only it reaches

protoCancelButton := {
	_proto: @protoPictureButton,
	viewBounds: {left: -18, top: -18, right: -5, bottom: -5},
	viewJustify: vjCenterH + vjCenterV + vjParentRightH + vjParentBottomV,
	icon: @cancelBitmap,
	_closeBox: 'closeBox,
	cool: nil,
	viewSetupFormScript: func() begin
		local l1;
		(if (if (if (l1 := userConfiguration.blessedapp) then (GetRoot().(l1) = GetVariable(self, 'base))) then ((self.buttonClickScript = @protoCancelButton.buttonClickScript) or cool)) then begin
				icon := nil;
				viewBounds := Clone(viewBounds);
				if (BAnd(viewJustify, 32) <> 0) then begin
						viewBounds.left := (viewBounds.right := 0)
					end else begin
						viewBounds.left := viewBounds.right
					end;
				(viewFormat := 0)
			end else (if (icon = nil) then begin
					RemoveSlot(self, 'icon);
					RemoveSlot(self, 'viewBounds);
					RemoveSlot(self, 'viewFormat)
				end))
	end,
	buttonClickScript: func() begin
		(if icon then base:Close())
	end
};
