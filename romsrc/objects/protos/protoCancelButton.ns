// protoCancelButton: the close ("X") button in the corner of a view; tapping
// it closes base.  In the blessed application (the one the user made the
// backdrop, userConfiguration.blessedapp), which cannot be closed, the
// button shrinks to nothing.

protoCancelButton := {
	_proto: @protoPictureButton,
	viewBounds: {left: -18, top: -18, right: -5, bottom: -5},
	viewJustify: vjCenterH + vjCenterV + vjParentRightH + vjParentBottomV,
	icon: @cancelBitmap,
	_closeBox: 'closeBox,
	// set to keep the button hidden in the backdrop app even when its
	// buttonClickScript was overridden
	cool: nil,
	// at setup: in the backdrop application, with the standard click script
	// (or cool set), the icon goes and the bounds are made zero wide (at the
	// right edge for a right-justified button) with no frame.  A button whose
	// icon was set to nil instead gets its picture-button slots back from the
	// proto chain by removing the overrides.
	viewSetupFormScript: func() begin
		local blessedapp;
		(if (if (if (blessedapp := userConfiguration.blessedapp) then (GetRoot().(blessedapp) = GetVariable(self, 'base))) then ((self.buttonClickScript = @protoCancelButton.buttonClickScript) or cool)) then begin
				icon := nil;
				viewBounds := Clone(viewBounds);
				if (BAnd(viewJustify, vjParentRightH) <> 0) then begin
						viewBounds.left := (viewBounds.right := 0)
					end else begin
						viewBounds.left := viewBounds.right
					end;
				(viewFormat := 0)
			end else (if (icon = nil) then begin
					RemoveSlot(self, 'icon);
					RemoveSlot(self, 'viewBounds);
					RemoveSlot(self, 'viewFormat)
				end))
	end,
	// on a tap: closes base, unless the button was hidden (no icon)
	buttonClickScript: func() begin
		(if icon then base:Close())
	end
};
