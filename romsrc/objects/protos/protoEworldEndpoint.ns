			self:SendSlot(9, 'homePhone);
			self:SendSlot(15, 'dayphone);
			self:SendSlot(10, 'creditcard);
			self:SendSlot(11, 'creditexper);
			self:SendSlot(12, 'creditnumber);
			self:SendSlot(13, 'cardfirst);
			self:SendSlot(14, 'cardlast);
			self:SendSlot(25, 'backuppassword);
			self:SendStream()
		end,
		// SendName(): sends the chosen account name and password
		SendName: func() begin
			Busy := true;
			if (not self:StartTransaction(120)) then begin
					return nil
				end;
			self:StartStream("D3");
			self:SendSlot(22, 'mailAccount);
			self:SendSlot(21, 'mailPassword);
			self:SendStream()
		end,
		// SendSlot(field, slot): sends info.(slot), when not empty, as that field
		SendSlot: func(a1, a2) begin
			local l1;
			(if (if (l1 := info.(a2)) then (StrLen(l1) > 0)) then begin
					self:atom(18, 1, a1, nil);
					self:atom(0, 14, l1, nil)
				end)
		end,
		// Atom18(state, stream, atom, length, data): the registration atoms - 1 says
		// which answer is pending, 2 that an error is, 3 that registration is done
		// (RegDone), 4 that the host is ready for the information
		Atom18: func(a1, a2, a3, a4, a5) begin
			if (a3 = 1) then begin
					a1.pending := self:getdata(a5, 0, a4, 'integer)
				end;
			if (a3 = 2) then begin
					a1.pending := 2
				end;
			if (a3 = 3) then begin
					self:EndTransaction();
					self:RegDone()
				end;
			(if (a3 = 4) then begin
					eworld.connected := true;
					self:SendInfo()
				end)
		end,
		// Atom00: during registration, atom 14 carries the pending answer - an error
		// (pending 2: RegError with its code and text) or the account name (pending
		// 22: RegName); other atoms go to protoEworldEndpoint's
		Atom00: func(a1, lastStream, a3, a4, a5) begin
			local integer2, string2;
			(if (a3 = 14) then begin
					if (a1.pending = 2) then begin
							Busy := nil;
							integer2 := self:getdata(a5, 0, 1, 'integer);
							string2 := self:getdata(a5, 1, (a4 - 1), 'string);
							self:EndTransaction();
							self:RegError(integer2, string2);
							transport:?SetStatus('idle, nil);
							transport:?CloseStatusDialog(nil)
						end;
					(if (a1.pending = 22) then begin
							Busy := nil;
							info.mailAccount := self:getdata(a5, 0, a4, 'string);
							self:EndTransaction();
							self:RegName();
							transport:?SetStatus('idle, nil);
							transport:?CloseStatusDialog(nil)
						end)
				end else inherited:Atom00(a1, lastStream, a3, a4, a5))
		end
	},
	_proto: @protoBasicEndpoint
};

