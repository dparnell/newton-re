// protoEworldEndpoint: the endpoint of the built-in mail client for Apple's
// eWorld / America Online service (protoBasicEndpoint): it logs in through a
// mail network's navigator script, lists, reads and sends mail and down- and
// uploads enclosures in the service's protocol of two-letter tokens and
// numbered atoms. Much of the protocol is native (the frames of class #132);
// the state of a session is in the global eworld (apparently the endpoint
// itself). The clients (the mail transport) get its results through
// optional scripts:
// LoginDoneScript, ListItem, ListDone, Mail_Message, Mail_SendDone and so on.
// And protoEWorldReg, the endpoint that registers a new account.

protoEworldEndpoint := {
	// HandleError(error): reports an error from the service - not for a cancelled
	// request; -1 means the message string kept in lastErrMsg (HandleThrow); an
	// error code is translated (TranslateError) and shown, and the connection
	// dropped; a string is shown as it is
	HandleError: func(error) begin
		local translateError;
		lastError := error;
		(if (error <> kCommErrRequestCanceled) then begin
				if (error = -1) then begin
						error := lastErrMsg
					end;
				(if IsInteger(error) then begin
						if (translateError := self:TranslateError(error)) then begin
								self:Notify(kNotifyAlert, serviceName, translateError)
							end;
						self:ConnectionAbort()
					end else GetRoot():Notify(kNotifyAlert, serviceName, error))
			end)
	end,
	// Token<xx>: the handler of the host's two-letter token xx, called from the
	// native receive code with the state (the global eworld), the packet and an
	// offset or length (arguments named by the decompiler). Tokenta answers with
	// an "eJ" token.
	Tokenta: func(a1, a2, a3) begin
		self:output("eJ", nil, true);
		self:output(0, 'byte, nil)
	end,
	// Token_X_S: the host sent a message to show - shows it and drops the line
	Token_X_S: func(a1, a2, a3) begin
		self:Notify(kNotifyAlert, serviceName, self:getdata(a2, 2, a3, 'string));
		self:ConnectionAbort()
	end,
	// GetOptions(): the options the endpoint is instantiated with - the service
	// and modem options the eWorld/AOL connection needs (MNP error correction
	// and so on); the typelist numbers are the option data's layout
	GetOptions: func() begin
		local modemOption;
		modemOption := MakeModemOption();
		[Array: {label: "p3  ", type: 'service, opCode: opSetRequired}, {label: "mods", type: 'service, opCode: opSetRequired}, {label: "mecp", type: 'option, opCode: opSetRequired, data: {arglist: [Array: 1], typelist: [Array: 10, 1]}}, {label: "mnpa", type: 'option, opCode: opSetRequired, data: {arglist: [Array: 0], typelist: [Array: 10, 1]}}, {label: "mnpc", type: 'option, opCode: opSetRequired, data: {arglist: [Array: 1], typelist: [Array: 10, 1]}}, modemOption, {label: "p3no", type: 'option, opCode: opSetRequired, data: {arglist: [Array: 1, 0, 0, 0], typelist: [Array: 10, 4, 4, 4, 4]}}]
	end,
	// the frames of class #132 here are native (C) methods of the eWorld
	// endpoint; numArgs is their argument count
	filetoframe: {class: #132, funcPtr: 7012339, numArgs: 2},
	frametofile: {class: #132, funcPtr: 7012340, numArgs: 1},
	// Mail_Read(id, transport): asks for the message with that id ("m6"); the
	// reply arrives as mail atoms (atom17). StartTransaction(120) fails (nil
	// returned) while another request is outstanding or when not connected;
	// 120 is the time-out in seconds
	Mail_Read: func(id, transport) begin
		if (not self:StartTransaction(120)) then begin
				return nil
			end;
		eworld.cancelling := nil;
		eworld.statusView := transport;
		self:output("m6", nil, true);
		self:output(id, nil, true);
		self:send(true);
		eworld.mail_state := 'Read;
		(eworld.lastMailID := id)
	end,
	// Mail_DownloadDone(file), the doneScript of a Mail_Download: a package
	// enclosure becomes the message's package; a Newton ("newt") enclosure is
	// unpacked into a frame which takes the message's header and replaces it;
	// then the client's Mail_DownloadDoneScript gets the message
	Mail_DownloadDone: func(a1) begin
		local filetoframe, text;
		if a1.data then begin
				if ((if a1.type then StrEqual(a1.type, "pkg ")) or EndsWith(a1.filename, ".pkg")) then begin
						mailmessage.package := a1.data
					end;
				if (if a1.type then StrEqual(a1.type, "newt")) then begin
						if (not (filetoframe := self:filetoframe(a1.data, a1.filesize))) then begin
								// looks like a ROM bug: the message goes into the local `text`, but msg.text
								// is shown (`msg` is no variable here)
								text := "Not enough free space in the default soup to unpack the enclosure.";
								GetRoot():Notify(kNotifyAlert, serviceName, msg.text);
								return nil
							end;
						if (not filetoframe.text) then begin
								filetoframe.text := mailmessage.text
							end;
						filetoframe.toRef := mailmessage.toRef;
						if mailmessage.fromName then begin
								filetoframe.fromName := mailmessage.fromName
							end;
						filetoframe.fromRef := mailmessage.fromRef;
						filetoframe.subject := mailmessage.subject;
						filetoframe.id := mailmessage.id;
						filetoframe.dateStr := mailmessage.dateStr;
						filetoframe.cc := mailmessage.cc;
						filetoframe.bcc := mailmessage.bcc;
						filetoframe.account := mailmessage.account;
						mailmessage := filetoframe
					end
			end;
		self:?Mail_DownloadDoneScript(mailmessage);
		(mailmessage := nil)
	end,
	// Tokentf: the host's answer to a file transfer request - its reply token
	// (when the byte before is 144) is kept for the transfer; a download is
	// started with "xG", an upload begins sending
	Tokentf: func(a1, a2, a3) begin
		local string2;
		if (self:getdata(a2, (a3 - 1), 1, 'integer) = 144) then begin
				string2 := self:getdata(a2, a3, 2, 'string)
			end;
		(if a1.file_in then begin
				a1.file_in.reply := string2;
				self:output("xG", nil, nil)
			end else (if a1.file_out then begin
					a1.file_out.reply := string2;
					self:File_UploadStart(a1.file_out);
					(a1.file_out := nil)
				end))
	end,
	// Mail_ListUnread(): asks for the list of unread mail ("m7")
	Mail_ListUnread: func() begin
		if (not self:StartTransaction(120)) then begin
				return nil
			end;
		self:output("m7", nil, nil);
		(eworld.mail_state := 'list)
	end,
	// ConnectionAbort(): drops the connection - during a file upload it flags the
	// native code (SetEWError) and tries again later; tells the client
	// (connectionAbortedScript), logs out when logged in or finishes the logout
	ConnectionAbort: func() begin
		if uploadingfile then begin
				self:SetEWError(1);
				AddDeferredSend(self, 'ConnectionAbort, nil);
				return nil
			end;
		self:?connectionAbortedScript(0);
		if activetimeout then begin
				self:EndTransaction()
			end;
		(if (connectState = 'Login) then begin
				self:Logout();
				(connectState := 'Connect)
			end else self:LogoutDone())
	end,
	// Token_F9: the last part of a downloaded file - stores it, sends the reply
	// token and finishes the download
	Token_F9: func(a1, a2, a3) begin
		self:FIle_DownloadPart(a1, a2, a3);
		if a1.file_in.reply then begin
				self:output(a1.file_in.reply, nil, true);
				self:output(0, 'byte, nil)
			end;
		self:File_DownloadDone(a1.file_in);
		(a1.file_in := nil)
	end,
	BufferStart: {class: #132, funcPtr: 7012335, numArgs: 2},
	output: {class: #132, funcPtr: 7012345, numArgs: 3},
	// set while the native uploadfile is sending a file
	uploadingfile: nil,
	send: {class: #132, funcPtr: 7012347, numArgs: 1},
	// PrefsSet(account, password, phone, network, ...): true when the owner's
	// e-mail account and password and the worksite's phone number and mail
	// network are set; otherwise tells the user what is missing and returns nil
	PrefsSet: func(text, text2, a3, a4, a5, a6) begin
		local l1;
		l1 := true;
		if ((((not text) or (StrLen(text) < 1)) or (not text2)) or (StrLen(text2) < 1)) then begin
				self:Notify(kNotifyAlert, serviceName, msgOwner);
				l1 := nil
			end;
		if (if a3 then IsInteger(a3)) then begin
				a3 := SPrintObject(a3)
			end;
		if (((not a3) or (StrLen(a3) < 1)) or (not a4)) then begin
				self:Notify(kNotifyAlert, serviceName, msgWorksite);
				l1 := nil
			end;
		l1
	end,
	// Token_D3: the host accepted the login
	Token_D3: func(a1, a2, a3) begin
		self:LoginDone()
	end,
	// HandleThrow(), in an onexception handler: takes the error out of the current
	// exception (a message string becomes -1 with the string in lastErrMsg) and,
	// unless ignoreError says it does not matter, completes the current item with
	// it or reports it; returns true when the error was not ignored
	HandleThrow: func() begin
		local error, ex, l3, l4;
		error := 0;
		if HasSlot((ex := CurrentException()), 'message) then begin
				error := -1;
				self.lastErrMsg := ex.message
			end else begin
				if HasSlot(ex, 'error) then begin
						error := ex.error
					end else begin
						if HasSlot(ex.data, 'errorCode) then begin
								error := ex.data.errorCode
							end else begin
								GetRoot():Notify(kNotifyAlert, serviceName, "Unexpected error")
							end
					end
			end;
		if (l3 := (not self:ignoreError(error))) then begin
				if (l4 := (if (connectState = 'Login) then GetVariable(self, 'currentItem) else (if (if request then (self:ItemRequest exists)) then self:ItemRequest(request)))) then begin
						self:ItemCompleted(l4, l4.state, error)
					end else begin
						self:HandleError(error)
					end
			end;
		l3
	end,
	// File_DownloadDone(file): ends the transaction and calls the file's
	// doneScript with it
	File_DownloadDone: func(file_in) begin
		self:EndTransaction();
		ClearVBOCache(file_in.data);
		(if file_in.doneScript then Perform(self, file_in.doneScript, [Array: file_in]))
	end,
	// Mail_SendMessage(), when the host accepted the header (atom17 3): sends the
	// body of eworld.mail_out ("m5") - an attachment (a frame flattened to a Newton
	// file, its password, labels and, unless mailSendText, text left out; or a
	// package's body) announced by mail atoms, then the text
	Mail_SendMessage: func() begin
		local mail_out, text, labels, emailPassword;
		(if (mail_out := eworld.mail_out) then begin
				self:StartStream("m5");
				if mail_out.attachment then begin
						if (not mail_out.IsPackage) then begin
								text := mail_out.text;
								labels := mail_out.labels;
								if (emailPassword := mail_out.fromRef.emailPassword) then begin
										mail_out.fromRef.emailPassword := nil
									end;
								if (not userConfiguration.mailSendText) then begin
										mail_out.text := nil
									end;
								if mail_out.labels then begin
										mail_out.labels := nil
									end;
								try begin
										eworld.file_out := self:frametofile(mail_out)
									end onexception |evt.ex| do begin
										self:HandleThrow()
									end;
								// a flattened frame travels as the file "newton" of type 'newt', creator
								// 'DOCK'
								eworld.file_out.filename := "newton";
								eworld.file_out.type := "newt";
								eworld.file_out.creator := "DOCK";
								mail_out.text := text;
								if emailPassword then begin
										mail_out.fromRef.emailPassword := emailPassword
									end;
								if labels then begin
										mail_out.labels := labels
									end
							end else begin
								eworld.file_out := mail_out.body
							end;
						// atom(protocol, atom, data, encoding): a native method adding one atom to
						// the stream; 17 is the mail protocol (whose atom numbers atom17 decodes)
						self:atom(17, 7, nil, nil);
						self:atom(17, 20, 1, nil);
						self:atom(17, 21, eworld.file_out.filename, nil);
						self:atom(17, 23, 247, nil);
						self:atom(17, 22, eworld.file_out.filesize, nil);
						self:atom(17, 8, nil, nil)
					end;
				if mail_out.receipt then begin
						self:atom(17, 26, 1, nil)
					end;
				if ((not mail_out.text) or (StrLen(mail_out.text) = 0)) then begin
						self:atom(17, 11, " ", 'encoded)
					end else begin
						self:atom(17, 11, mail_out.text, 'encoded)
					end;
				self:atom(17, 2, nil, nil);
				self:SendStream()
			end)
	end,
	stopCCL: {class: #132, funcPtr: 6959508, numArgs: 0},
	getmacheader: {class: #132, funcPtr: 7012342, numArgs: 2},
	// LoginToHost(..., account, password, network, phone): connects and logs in -
	// the account, password and phone number default to the user configuration's
	// mail settings, the network to the worksite's; instantiates the endpoint,
	// dials (the address option "rout" carries the phone number), runs the
	// network's navigator script (connectToHost) and sends the login. Progress
	// goes to the transport's status dialog or the loginStatus script. Returns
	// true, or nil after reporting a failure.
	LoginToHost: func(a1, a2, text, text2, a5, a6) begin
		local list;
		connected := nil;
		connectState := nil;
		if (not text) then begin
				text := userConfiguration.mailAccount
			end;
		eworld.account := text;
		if (not text2) then begin
				text2 := userConfiguration.mailPassword
			end;
		if (not a6) then begin
				if (if (a6 := userConfiguration.mailPhoneFull) then IsInteger(a6)) then begin
						a6 := SPrintObject(a6)
					end
			end;
		if (if a6 then IsInteger(a6)) then begin
				a6 := SPrintObject(a6)
			end;
		eworld.phone := a6;
		if (not a5) then begin
				self:GetNetwork(a1);
				a5 := mailnavigator
			end;
		if (not self:PrefsSet(text, text2, a6, a5, a2, a1)) then begin
				return nil
			end;
		if (transport exists) then begin
				transport:?SetStatusDialog('Initializing, 'vStatus, {primary: nil})
			end;
		try begin
				self:Instantiate(self, self:GetOptions())
			end onexception |evt.ex| do begin
				transport:?CloseStatusDialog(nil);
				self:HandleThrow();
				return nil
			end;
		list := [Array: {type: 'address, label: "rout", opCode: opSetRequired, data: {arglist: [Array: 3, StrLen(a6), a6], typelist: [Array: 10, 1, 2, [Array: 11, 13, 0]]}}];
		if (not (transport exists)) then begin
				self:?loginStatus(1)
			end;
		try begin
				self:Bind(nil, nil);
				connectState := 'Bind;
				if (transport exists) then begin
						transport:?SetStatusDialog('dialing, 'vStatusTitle, {titleText: a6})
					end;
				self:Connect(list, nil);
				connectState := 'Connect;
				connected := true
			end onexception |evt.ex| do begin
				transport:?CloseStatusDialog(nil);
				self:HandleThrow();
				return nil
			end;
		if (transport exists) then begin
				transport:?SetStatusDialog('Connecting, 'vStatusTitle, {titleText: a5.title})
			end else begin
				self:?loginStatus(2)
			end;
		eworld.navigator := a5;
		navigator._parent := self;
		err := self:connectToHost(navigator);
		navigator._parent := nil;
		if err then begin
				transport:?CloseStatusDialog(nil);
				if (err = kCommErrRequestCanceled) then begin
						self:ConnectionAbort()
					end else begin
						self:HandleError(err)
					end;
				return nil
			end;
		eworld.navigator := nil;
		if (transport exists) then begin
				transport:?SetStatusDialog('Login, 'vStatusTitle, {titleText: text})
			end else begin
				self:?loginStatus(3)
			end;
		self:Login(text, text2);
		return true
	end,
	// StartStream(token): starts a new outgoing stream (numbered by
	// eworld.streamid) with that two-letter token; SendStream ends and sends it
	StartStream: func(text) begin
		if (eworld.streamid = nil) then begin
				eworld.streamid := 1
			end else begin
				eworld.streamid := (eworld.streamid + 1)
			end;
		self:BufferStart(text, eworld.streamid)
	end,
	connected: nil,
	// TransactionAbort(): gives up the current request and tells the client
	TransactionAbort: func() begin
		self:EndTransaction();
		self:?transactionAbortedScript(0)
	end,
	// Collection_List(host): asks for the list of items in a folder or form
	// folder on the service (the answers come as atom09)
	Collection_List: func(a1) begin
		self.newCollection := [Array: ];
		self.collectionHostID := a1;
		self:StartTransaction(120);
		(if (a1.subType = 'formFolder) then begin
				self:StartStream("K1");
				self:atom(0, 14, a1.idNumber, nil);
				self:SendStream()
			end else begin
				self:StartStream("eB");
				self:atom(1, ATOM_MAN_SET_RESPONSE_ID, 7, nil);
				self:atom(3, 1, a1.idNumber, nil);
				self:SendStream()
			end)
	end,
	// Tokenf_X: a download finished
	Tokenf_X: func(a1, a2, a3) begin
		if a1.file_in then begin
				self:File_DownloadDone(a1.file_in)
			end;
		(a1.file_in := nil)
	end,
	activeTransaction: nil,
	// TimeoutTick(), every 5 seconds while connected: counts the current request's
	// time-out down; when it runs out, ends a list (atom09) or retries the mail
	// being read (atom17), or else aborts the request
	TimeoutTick: func() begin
		if (not connected) then begin
				timerStarted := nil;
				return nil
			end;
		if activetimeout then begin
				if ((activetimeout := (activetimeout - 5)) <= 0) then begin
						if lastAtom then begin
								if (lastAtom = 'atom09) then begin
										self:atom09(self, lastStream, 4, 0, 0)
									end else begin
										if (lastAtom = 'atom17) then begin
												self.retry := true;
												self:atom17(self, lastStream, 2, 0, 0);
												self.retry := nil;
												self.mail_in := nil;
												self:EndTransaction();
												self:Atom00(self, lastStream, 2, 0, 0);
												self:Mail_Read(lastMailID, transport)
											end
									end
							end else begin
								self:EndTransaction();
								self:?transactionAbortedScript(nil)
							end
					end
			end;
		timerStarted := true;
		AddDelayedSend(self, 'TimeoutTick, [Array: ], 5000)
	end,
	lastMailID: nil,
	unescape: {class: #132, funcPtr: 7012348, numArgs: 2},
	defaultAtom00: {class: #132, funcPtr: 7012349, numArgs: 5},
	GetEWError: {class: #132, funcPtr: 7052533, numArgs: 0},
	msgWorksite: "You need to set your worksite E-Mail information before you can connect to America Online.",
	// Mail_Download(message, transport): asks for a message's enclosure ("eD");
	// the file arrives through the Token_F* handlers into eworld.file_in and
	// Mail_DownloadDone is called at the end
	Mail_Download: func(message, transport) begin
		self.mailmessage := message;
		if (not self:StartTransaction(120)) then begin
				return nil
			end;
		eworld.file_in := {id: message.id, filetype: message.filetype, filesize: message.filesize, filename: message.filename, statusView: transport, doneScript: 'Mail_DownloadDone};
		self:StartStream("eD");
		self:atom(1, 7, 0, nil);
		self:atom(3, 1, message.id, nil);
		self:SendStream()
	end,
	// Mail_ListRead(): asks for the list of mail already read ("m9")
	Mail_ListRead: func() begin
		if (not self:StartTransaction(120)) then begin
				return nil
			end;
		self:output("m9", nil, nil);
		(eworld.mail_state := 'list)
	end,
	// atom09(state, stream, atom, length, data): decodes a list atom - 3 starts a
	// list (its entries in a string VBO), 4 ends it (the client's ListDone), 5
	// starts an entry (its text after three longs: length and two values), 6 adds
	// it (the client's ListItem), 7 and 8 the list's type and form, 9 and 10 the
	// entry's values. Running out of store or memory stops the list.
	atom09: func(a1, lastStream, a3, a4, a5) begin
		local count;
		a1.lastAtom := 'atom09;
		a1.lastStream := lastStream;
		if a1.outofmem then begin
				if (a3 = 4) then begin
						self:EndTransaction();
						self:?ListDone(a1.list);
						a1.list := nil
					end;
				return nil
			end;
		(try begin
				if (a3 = 3) then begin
						a1.list := {items: self:GetDefaultOwnerStore():NewVBO('string, 0), nextClear: 10240}
					end;
				if (a3 = 4) then begin
						self:EndTransaction();
						if a1.list.items then begin
								ClearVBOCache(a1.list.items)
							end;
						self:?ListDone(a1.list);
						a1.list := nil
					end;
				if (a3 = 5) then begin
						a1.listentry := Stringer([Array: "      ", self:getdata(a5, 0, a4, 'string)]);
						StuffLong(a1.listentry, 0, Length(a1.listentry));
						StuffLong(a1.listentry, 4, 0);
						StuffLong(a1.listentry, 8, 0)
					end;
				if (if (a3 = 6) then a1.listentry) then begin
						count := Length(a1.list.items);
						try begin
								BinaryMunger(a1.list.items, count, 0, a1.listentry, 0, Length(a1.listentry))
							end onexception |evt.ex.fr.store| do begin
								a1.outofmem := true;
								a1.list.items := nil;
								self:Logout();
								GetRoot():Notify(kNotifyAlert, serviceName, "There is not enough storage available to save the list of items.");
								return nil
							end;
						self:?ListItem(a1.listentry);
						a1.listentry := nil;
						// the VBO's cache is cleared every 10K, so as not to fill the heap
						if (count > a1.list.nextClear) then begin
								a1.list.nextClear := (a1.list.nextClear + 10240);
								ClearVBOCache(a1.list.items)
							end
					end;
				if (a3 = 7) then begin
						a1.list.type := self:getdata(a5, 0, a4, 'integer)
					end;
				if (a3 = 8) then begin
						a1.list.form := self:getdata(a5, 0, a4, 'integer)
					end;
				if (if (a3 = 9) then a1.listentry) then begin
						StuffLong(a1.listentry, 8, self:getdata(a5, 0, a4, 'integer))
					end;
				(if (if (a3 = 10) then a1.listentry) then StuffLong(a1.listentry, 4, self:getdata(a5, 0, a4, 'integer)))
			end onexception |evt.ex.outofmem| do begin
				a1.outofmem := true;
				a1.list.items := nil;
				GetRoot():Notify(kNotifyAlert, serviceName, "There is not enough memory available to list all items.");
				return nil
			end)
	end,
	// Mail_SendHeader(), from Mail_Send: sends the header of eworld.mail_out
	// ("m4") - the To, Cc and Bcc addresses (atom 19's 0, 1, 2 select the list)
	// and the subject; the `local` line after the use is the decompiler's layout
	Mail_SendHeader: func() begin
		(if (mail_out := eworld.mail_out) then begin
				self:StartStream("m4");
				self:atom(17, 0, nil, nil);
				if (if mail_out.toRef then (Length(mail_out.toRef) > 0)) then begin
