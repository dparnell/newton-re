// protoExtrasListItem: an item of the Extras Drawer shown as a row of a list
// rather than as an icon (protoExtrasIcon) - a check box, the name, the size
// and where the item is.

protoExtrasListItem := {
	_proto: @protoExtrasIcon,
	// whether the item's check box (its left 20 pixels) is ticked
	checked: nil,
	// viewDrawScript: draws the row, its shapes made once - the item's name (plain
	// for a frozen entry, italic when not active, bold otherwise), its size
	// right-aligned, where it is (with its folder when all folders are shown)
	// truncated to the last third, and the check box (the two bitmaps below)
	viewDrawScript: compile(
		constants: {
			kBinaryFromHex: func(hex, cls) begin
				local b := MakeBinary(StrLen(hex) div 2, cls);
				for i := 0 to Length(b) - 1 do begin
					local h := Ord(hex[2 * i]);
					local l := Ord(hex[2 * i + 1]);
					StuffByte(b, i, (if h >= 97 then h - 87 else h - 48) * 16 + (if l >= 97 then l - 87 else l - 48))
				end;
				b
			end,
			kLiteral_3c8abd: {mask: call kBinaryFromHex with ("0000000000040019001900360026004300080000003000000000000000c00000198000003b8000000f0000000f0000000600000004000000000000000000000000000000", 'mask), bits: call kBinaryFromHex with ("000000000004003400340013004100200008000000300000db60000000c0000099a00000bba000000f0000008f2000008620000004000000db6000000000000000000000", 'bits), bounds: '{left: 0, top: 0, right: 13, bottom: 13}},
			kLiteral_3c8b41: {mask: call kBinaryFromHex with ("0000000000040019001900360026004300080000003000000000000000c00000198000003b8000000f0000000f0000000600000004000000000000000000000000000000", 'mask), bits: call kBinaryFromHex with ("000000000004001900190013002600200000000000000000db60000000000000802000008020000000000000802000008020000000000000db6000000000000000000000", 'bits), bounds: '{left: 0, top: 0, right: 13, bottom: 13}}
		},
		func() begin
			local where, size, styledStrTruncate2, l4, l5;
			if (not shape) then begin
					where := target:where();
					size := target:size();
					styledStrTruncate2 := (if (labelsFilter = '_all) then ParamStr("^0 ^?1(^1)||", [Array: where, (if target.fentry.labels then (if (l4 := userConfiguration.userFolders.(target.fentry.labels)) then StringFilter(l4, "_", 'rejectBeginning)) else "Unfiled")]) else where);
					l5 := ((2 * hSpacing) div 3);
					styledStrTruncate2 := StyledStrTruncate(styledStrTruncate2, (hSpacing - l5), tsSystem + tsSize(9));
					SetClass((shape := [Array: (if (target.fentry.class = 'FrozenEntry) then '{font: tsSystem + tsSize(10)} else (if target.notActive then '{font: tsSystem + tsSize(10) + tsItalic} else '{font: tsSystem + tsSize(10) + tsBold})), MakeText(target.fentry.text, 20, 0, (hSpacing div 2), 11), '{font: tsSystem + tsSize(9), justification: right}, MakeText(size, (hSpacing div 2), 0, (l5 - 8), 11), '{font: tsSystem + tsSize(9), justification: left}, MakeText((if styledStrTruncate2 then styledStrTruncate2 else ""), l5, 0, hSpacing, 11), OffsetShape(MakeShape((if checked then kLiteral_3c8abd else kLiteral_3c8b41)), 5, 0)])[1].data, 'string);
					if IsSoupEntry(target.fentry) then begin
							EntryUndoChanges(target.fentry)
						end
				end;
			(if shape then self:DrawShape(shape, nil))
		end),
	// viewHiliteScript(on): inverts the row right of the check box (modeXor);
	// not while checked; returns true
	viewHiliteScript: func(on) begin
		if (not checked) then begin
				self:DrawShape(MakeRect(20, 0, hSpacing, vSpacing), '{transferMode: modeXor, penPattern: 0, fillPattern: 5})
			end;
		true
	end,
	// Checkit(checked): ticks or unticks the item - remakes the shapes and toggles
	// vSelected in the view's flags, so that a checked item counts as selected
	Checkit: func(a1) begin
		(if (checked <> a1) then begin
				checked := a1;
				shape := nil;
				SetValue(self, 'viewFlags, bxor(GetViewFlags(self), vSelected));
				self:Dirty()
			end)
	end,
	// viewClickScript(unit): a tap in the check box toggles it; a tap elsewhere
	// on the row unticks it and, if the pen is lifted on the row, launches the
	// item; returns true when the row was hit
	viewClickScript: func(unit) begin
		local box, l2, l3;
		InkOff(unit);
		box := self:GlobalBox();
		l2 := (GetPoint(finalX, unit) - box.left);
		l3 := (GetPoint(finalY, unit) - box.top);
		(if (if shape then HitShape(shape, l2, l3)) then begin
				self:?HandleChildClick();
				if (l2 < 20) then begin
						clicker();
						self:Checkit((not checked))
					end else begin
						self:Checkit(nil);
						RefreshViews();
						if self:TrackHilite(unit) then begin
								self:hilite(nil);
								self:Launch()
							end
					end;
				true
			end)
	end
};
