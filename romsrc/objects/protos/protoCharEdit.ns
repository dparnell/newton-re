// protoCharEdit: the comb-style character editor (Newton Programmer's
// Reference "protoCharEdit"), as the corrector uses: a word shown one
// character per cell, each cell written in separately (single-character
// recognition), with gestures to delete (scrub), insert (caret) and pick
// alternatives (tap: a popup of other characters and Delete / Insert / Add
// Word).  A template can fix the word's format: format is a string with a
// filter number per position ("_" a locked cell), filters the strings of
// characters each position takes.
//   text          the characters, padded with blanks around the word
//   wordLeft, wordRight   where the word is in text (wordRight exclusive)
//   trailers      how many blanks follow the word
//   dispLeft      the first character shown; dispIndent the left indent
//   maxChars      how many cells are shown; cellWidth, cellGap, cellHeight
//   altChars      per position, a string of alternative characters
//   lastChar      the position last written or tapped
//   lines, chars, frames   the shapes drawn, cached until invalidated
//   wordSource    where the word came from ('none, 'single, 'Editing ...)

protoCharEdit := {
	chars: nil,
	wordLeft: 1,
	altChars: nil,
	lastChar: nil,
	viewLineSpacing: 30,
	top: 0,
	maxChars: 8,
	lines: nil,
	viewFlags: vVisible + vClickable + vStrokesAllowed + vGesturesAllowed + vCharsAllowed,
	template: nil,
	cellWidth: 24,
	blankText: nil,
	viewTie: nil,
	viewBounds: nil,
	wordRight: nil,
	recConfig: @rcSingleCharacterConfig,
	trailers: nil,
	cellGap: 6,
	viewJustify: 0,
	cellHeight: 50,
	frames: nil,
	dispLeft: nil,
	wordSource: 'none,
	popChars: nil,
	left: 0,
	viewClass: clView,
	text: nil,
	dispIndent: nil,
	// GetFilter(pos): the template's string of characters allowed at pos -
	// by the digit in format at that position, or filters[0] for a template
	// without a format; nil when anything goes
	GetFilter: func(lastChar) begin
		local formatItem;
		result := nil;
		if template then begin
				if template.format then begin
						if (if (if (lastChar >= wordLeft) then (lastChar < wordRight)) then (template.format[(lastChar - wordLeft)] <> $_)) then begin
								formatItem := (ORD((formatItem := template.format[(lastChar - wordLeft)])) - ORD($0));
								result := template.filters[formatItem]
							end
					end else begin
						if template.filters then begin
								result := template.filters[0]
							end
					end
			end;
		return result
	end,
	// starts editing the text and template slots afresh: the template
	// reinstalled and initialized with the word, maxChars recomputed from
	// the bounds (or the proto's) and limited to the format's length
	UseTextAndTemplate: func() begin
		local template2, box, fixedWordLength;
		self:SetNewWord(text, nil);
		template2 := template;
		template := nil;
		self:SetNewTemplate(template2);
		template:?Init(self:CurrentWord());
		if self._proto.viewBounds then begin
				maxChars := (((box := self:LocalBox()).right - box.left) div cellWidth)
			end else begin
				maxChars := self._proto.maxChars
			end;
		if (fixedWordLength := self:FixedWordLength()) then begin
				maxChars := min(maxChars, fixedWordLength)
			end;
		self:UseNewTemplate(true)
	end,
	uppers: ucLetters,
	// HandleTap(unit): a tap on an unlocked cell pops up its alternatives,
	// or for a free-form word a picture of what can be written before, in
	// or after it, followed by Clear (fixed format) or Delete, Insert and
	// Add Word (before or after the word, when the owner has AddNewWord).
	// Answers true if it popped up (or a popup is already up).
	HandleTap: func(unit) begin
		local l1, strokeBounds2, l3, cell, hit, bounds, box, frame2, frame3;
		l1 := nil;
		if popChars then begin
				return true
			end;
		if (cell := self:FindCell((l3 := (((strokeBounds2 := StrokeBounds(unit)).left + strokeBounds2.right) div 2)))).hit then begin
				hit := cell.hit;
				bounds := cell.bounds;
				box := self:GlobalBox();
				if (not self:CellLocked((hit := (hit + dispLeft)))) then begin
						lastChar := hit;
						if (if (not (popChars := self:GetAlternates())) then (not self:FixedWord())) then begin
								if (hit = wordRight) then begin
										AddArraySlot((popChars := [Array: ]), @correctortrailBits)
									end else begin
										if (hit = (wordLeft - 1)) then begin
												AddArraySlot((popChars := [Array: ]), @correctorleadBits)
											end else begin
												if (if (hit >= wordLeft) then (hit < wordRight)) then begin
														AddArraySlot((popChars := [Array: ]), @correctorMidBits)
													end
											end
									end
							end;
						if popChars then begin
								AddArraySlot(popChars, 'pickseparator);
								if self:FixedWord() then begin
										AddArraySlot(popChars, {item: "Clear", action: 'deleteItem})
									end else begin
										AddArraySlot(popChars, {item: "Delete", action: 'deleteItem});
										AddArraySlot(popChars, {item: "Insert", action: 'insertItem});
										if (AddNewWord exists) then begin
												if (hit = wordRight) then begin
														frame2 := {item: "Add Word", action: 'appendWord}
													end else begin
														if (hit = (wordLeft - 1)) then begin
																frame3 := {item: "Add Word", action: 'insertWord}
															end
													end;
												if (frame2 or frame3) then begin
														AddArraySlot(popChars, 'pickseparator)
													end;
												if frame2 then begin
														AddArraySlot(popChars, frame2)
													end;
												if frame3 then begin
														AddArraySlot(popChars, frame3)
													end
											end
									end;
								DoPopup(popChars, (bounds.right - box.left), (((bounds.top - box.top) + viewLineSpacing) - 30), self);
								l1 := true
							end
					end
			end;
		return l1
	end,
	// answers the alternatives at lastChar as an array of one-character
	// strings mapped for display: the position's filter if it is short (10
	// or fewer), else its altChars; nil if none.  The decompiler places the
	// locals after their uses.
	GetAlternates: func() begin
		currentWord := self:CurrentWord();
		l3 := (lastChar - wordLeft);
		if (if (filter := self:GetFilter(lastChar)) then (StrLen(filter) <= 10)) then begin
				wordArray := self:MakeWordArray(filter)
			end else begin
				if altChars[lastChar] then begin
						wordArray := self:MakeWordArray(altChars[lastChar])
					end
			end;
		if wordArray then begin
				local wordArray;
				local currentWord;
				local l3;
				local filter;
				(foreach key, value in wordArray do begin
						MapAmbiguousCharacters((value := Clone(value)));
						wordArray[key] := value
					end)
			end;
		(wordArray := Clone(wordArray))
	end,
	// after setup: prepares the single-character recognition: its input mask
	// and the grid of cells (each cellWidth wide) and baseline it writes on
	viewSetupDoneScript: func() begin
		local box, l2;
		(recConfig := PrepRecConfig(recConfig)).inputmask := vClickable + vGesturesAllowed + vCustomDictionaries;
		l2 := ((box := self:GlobalBox()).left + dispIndent);
		recConfig.rcBaseInfo := {base: (box.top + viewLineSpacing), smallHeight: 11};
		recConfig.rcGridInfo := {boxLeft: l2, boxRight: (l2 + cellWidth), xSpace: cellWidth};
		PurgeAreaCache()
	end,
	// for a free-form word: drops the leading blanks scrolled off the left
	// (not into the word), shifting every position by the count
	TrimLeft: func() begin
		local text, dispLeft2, wordLeft2;
		text := self.text;
		dispLeft2 := self.dispLeft;
		(if (not self:FixedWord()) then begin
				wordLeft2 := 0;
				(while (if (wordLeft2 < dispLeft2) then (text[wordLeft2] = $ )) do (wordLeft2 := (wordLeft2 + 1)));
				if (wordLeft < wordLeft2) then begin
						wordLeft2 := wordLeft
					end;
				(if (wordLeft2 > 0) then begin
						StrMunger(text, 0, wordLeft2, nil, 0, 0);
						ArrayMunger(altChars, 0, wordLeft2, nil, 0, 0);
						dispLeft := (dispLeft2 - wordLeft2);
						wordLeft := (wordLeft - wordLeft2);
						wordRight := (wordRight - wordLeft2);
						(if lastChar then (lastChar := (lastChar - wordLeft2)))
					end)
			end)
	end,
	// the system's gesture script: tap and double tap pop up choices, a
	// caret inserts a space, a scrub deletes; answers whether it was handled
	viewgesturescript: func(unit, gesture) begin
		local handleTap;
		handleTap := nil;
		if (gesture = aeTap) then begin
				handleTap := self:HandleTap(unit)
			end else begin
				if (gesture = aeDoubleTap) then begin
						handleTap := self:HandleTap(unit)
					end else begin
						if (gesture = aeCaret) then begin
								handleTap := self:HandleCaret(unit)
							end else begin
								if (gesture = aeScrub) then begin
										handleTap := self:HandleScrub(unit)
									end
							end
					end
			end;
		return handleTap
	end,
	// Scroll(direction): forward, by a page when the word runs past the
	// cells shown (keeping the last few - 3 for a free-form word - in view);
	// back, to the start.  Answers whether it scrolled.
	Scroll: func(arrowDirection) begin
		local l1, dispLeft2, wordRight2, maxChars2;
		l1 := nil;
		dispLeft2 := dispLeft;
		if (arrowDirection > 0) then begin
				if self:FixedWord() then begin
						wordRight2 := wordRight;
						maxChars2 := maxChars
					end else begin
						wordRight2 := (wordRight + 1);
						maxChars2 := 3
					end;
				if (wordRight2 > (dispLeft2 + maxChars)) then begin
						dispLeft := (dispLeft2 := min((dispLeft2 := (dispLeft2 + maxChars)), (wordRight - maxChars2)));
						self:TrimLeft();
						self:PadRight();
						l1 := true
					end
			end else begin
				if (arrowDirection < 0) then begin
						if (dispLeft2 > 0) then begin
								dispLeft := 0;
								l1 := true
							end
					end
			end;
		if l1 then begin
				self:InvalDrawCache('chars);
				if self:FixedWord() then begin
						self:InvalDrawCache('lines)
					end;
				self:Dirty()
			end;
		return l1
	end,
	lowers: abcdefghijklmnopqrstuvwxyz,
	// draws the cells, building the cached shapes as needed: a character
	// (ink shown as a placeholder character) above each cell's base line;
	// a locked cell's line is grey (the style frame in the array changes the
	// style of what follows) and its sides a grey pattern instead of lines.
	//   l3 the next cell's left, l4 the base line; l5/l6/l7 which caches are
	//   being rebuilt; l8 the next cell edge; l9 the cell number
	viewDrawScript: compile(
		constants: {
			// run when this function is built: a binary of class cls from the hex
			// string hex, for the literals below
			kBinaryFromHex: func(hex, cls) begin
				local b := MakeBinary(StrLen(hex) div 2, cls);
				for i := 0 to Length(b) - 1 do begin
					local h := Ord(hex[2 * i]);
					local l := Ord(hex[2 * i + 1]);
					StuffByte(b, i, (if h >= 97 then h - 87 else h - 48) * 16 + (if l >= 97 then l - 87 else l - 48))
				end;
				b
			end,
			kLiteral_44f3ad: '{penPattern: 3, fillPattern: 0, transferMode: modeOr},
			kLiteral_44be59: {penPattern: call kBinaryFromHex with ("aa55aa55aa55aa550000", 'pattern), fillPattern: 0, transferMode: modeOr}
		},
		func() begin
			local box, maxChars, l3, l4, l5, l6, l7, l8, l9, copy, copyItem;
			box := self:LocalBox();
			maxChars := self.maxChars;
			l3 := ((box.left + dispIndent) + (cellGap div 2));
			l4 := (box.top + viewLineSpacing);
			if (not lines) then begin
					l5 := true;
					lines := Array(maxChars, nil)
				end;
			if (not chars) then begin
					l6 := true;
					chars := Array(maxChars, nil)
				end;
			if (not frames) then begin
					l7 := true;
					l8 := (box.left + dispIndent);
					frames := Array((2 * maxChars), nil)
				end;
			l9 := 0;
			MapAmbiguousCharacters((copy := Clone(text)));
			(while (l9 < maxChars) do begin
					if l5 then begin
							if (not self:CellLocked((dispLeft + l9))) then begin
									lines[l9] := MakeLine(l3, (l4 + 1), ((l3 + cellWidth) - cellGap), (l4 + 1))
								end else begin
									lines[l9] := kLiteral_44f3ad
								end
						end;
					if l6 then begin
							if IsInk((copyItem := copy[(dispLeft + l9)])) then begin
									copyItem := $\uF7FF
								end;
							chars[l9] := MakeText(SPrintObject(copyItem), l3, box.top, ((l3 + cellWidth) - cellGap), l4)
						end;
					if l7 then begin
							if (not self:CellLocked((dispLeft + l9))) then begin
									frames[(2 * l9)] := MakeLine(l8, (l4 - 11), l8, (l4 + 8));
									frames[((2 * l9) + 1)] := MakeLine((l8 + cellWidth), (l4 - 11), (l8 + cellWidth), (l4 + 8))
								end else begin
									frames[(2 * l9)] := kLiteral_44be59;
									frames[((2 * l9) + 1)] := kLiteral_44be59
								end;
							l8 := (l8 + cellWidth)
						end;
					l3 := (l3 + cellWidth);
					(l9 := (l9 + 1))
				end);
			self:DrawShape(chars, '{font: tsHWFont + tsSize(18), justification: center, transferMode: modeCopy});
			self:DrawShape(lines, kLiteral_44f3ad);
			if frames then begin
					self:DrawShape(frames, kLiteral_44be59)
				end;
			0
		end),
	// the undo action: puts back the word, template and alternatives a
	// SaveUndoState frame holds
	RestoreUndoState: func(a1) begin
		self:SetNewWord(a1.word, a1.wordSource);
		self:SetNewTemplate(a1.template);
		self:UseNewTemplate(nil);
		(altChars := a1.alts)
	end,
	// CellLocked(pos): with a format, true for a position outside the word or
	// marked "_"
	CellLocked: func(lastChar) begin
		local template2;
		(if (if (template2 := template) then template2.format) then (if (((lastChar < wordLeft) or (lastChar >= wordRight)) or (template2.format[(lastChar - wordLeft)] = $_)) then true))
	end,
	// HandleScrub(unit): a scrub wider than a cell deletes the cells between
	// the edges nearest its ends (the left edge moved in if the scrub starts
	// more than a third into a cell); a narrow scrub with 7 or more points
	// deletes the cell it is on.  Answers whether something was deleted.
	HandleScrub: func(unit) begin
		local l1, strokeBounds2, l3, countGesturePoints2, l5, cell, cell2, edge, edge2;
		l1 := nil;
		strokeBounds2 := StrokeBounds(unit);
		l3 := (cellWidth - cellGap);
		countGesturePoints2 := CountGesturePoints(unit);
		if ((l5 := (strokeBounds2.right - strokeBounds2.left)) > l3) then begin
				cell := self:FindCell(strokeBounds2.left);
				cell2 := self:FindCell(strokeBounds2.right);
				edge := cell.edge;
				edge2 := cell2.edge;
				if (if edge then edge2) then begin
						if ((edge + 1) = edge2) then begin
								if ((strokeBounds2.left - cell.edgeX) > (l3 div 3)) then begin
										edge := (edge + 1)
									end
							end;
						if (edge2 > edge) then begin
								l1 := true
							end
					end
			end else begin
				if (countGesturePoints2 >= 7) then begin
						edge2 := ((edge := (cell := self:FindCell(strokeBounds2.left)).hit) + 1);
						l1 := true
					end
			end;
		if l1 then begin
				l1 := nil;
				if self:DeleteText((edge + dispLeft), (edge2 + dispLeft)) then begin
						DoScrubEffect(unit);
						l1 := true
					end
			end;
		return l1
	end,
	// SortMatches(guesses, unit, bias): for a one-stroke character, reorders
	// the look-alikes among the recognizer's guesses (0/O/o, 1/I/l/i/|,
	// 2/z/Z): a 'numbers bias moves the digits up, otherwise 1, | and 0 move
	// down below their letters
	SortMatches: compile(
		constants: {
			kLiteral_466b49: "0Oo",
			kLiteral_466c65: "1Ili|"
		},
		func(a1, unit, bias) begin
			if (StrLen(a1) <= 1) then begin
					return nil
				end;
			if (CountUnitStrokes(unit) > 1) then begin
					return nil
				end;
			(if (bias = 'numbers) then begin
					self:BubbleUp(a1, $0, kLiteral_466b49);
					self:BubbleUp(a1, $1, kLiteral_466c65);
					self:BubbleUp(a1, $2, "2zZ")
				end else begin
					self:BubbleDown(a1, $1, kLiteral_466c65);
					self:BubbleDown(a1, $|, kLiteral_466c65);
					self:BubbleDown(a1, $0, kLiteral_466b49)
				end)
		end),
	// strokes are left to recognition (viewWordScript)
	viewStrokeScript: func(unit) begin
		nil
	end,
	// CharPos(string, char): the index of char in string, or nil.  The
	// decompiler places the local after its use.
	CharPos: func(delimiters, strItem) begin
		l1 := (StrLen(delimiters) - 1);
		local l1;
		(for i := 0 to l1 do begin
				if (delimiters[i] = strItem) then begin
						break i
					end
			end)
	end,
	// HandleCaret(unit): a caret drawn at the base line (from 4 above to 8
	// below it) inserts a space at the cell edge it points to
	HandleCaret: func(unit) begin
		local l1, gesturePoint2, box, l4, cell;
		l1 := nil;
		gesturePoint2 := GesturePoint(1, unit);
		box := self:GlobalBox();
		l4 := (gesturePoint2.y - (box.top + viewLineSpacing));
		if (if (if (gesturePoint2.line = 0) then (l4 < 8)) then (l4 > -4)) then begin
				self:InsertSpace((lastChar := ((cell := self:FindCell(gesturePoint2.x)).edge + dispLeft)));
				l1 := true
			end;
		return l1
	end,
	// BubbleDown(guesses, char, group): moves char later in the guesses
	// string past the characters of group that follow it.  The decompiler
	// places the locals after their uses.
	BubbleDown: func(a1, a2, text) begin
		sPrintObject2 := SPrintObject(a2);
		(if (pos := StrPos(a1, sPrintObject2, 0)) then begin
				l3 := (StrLen(a1) - 1);
				local sPrintObject2;
				local pos;
				local l3;
				(for i := (pos + 1) to l3 do begin
						sPrintObject2[0] := a1[i];
						if (not StrPos(text, sPrintObject2, 0)) then begin
								break
							end;
						a1[(i - 1)] := sPrintObject2[0];
						a1[i] := a2
					end)
			end)
	end,
	digits: digits,
	// answers the word without its padding
	CurrentWord: func() begin
		local wordLeft, wordRight;
		wordLeft := self.wordLeft;
		wordRight := self.wordRight;
		(if (if wordLeft then wordRight) then return Substr(text, wordLeft, (wordRight - wordLeft)) else return text)
	end,
	// sent by SetValue: new text starts a new word with no template; a new
	// template is installed
	viewChangedScript: func(slot, view) begin
		(if (slot = 'text) then begin
				self:SetNewWord(text, 'single);
				self:SetNewTemplate(nil);
				self:UseNewTemplate(true)
			end else (if (slot = 'template) then self:SetNewTemplate(template)))
	end,
	// UseNewTemplate(external): reformats the word through the template's
	// SetupString (if it has one), lays it out and redraws; external is
	// passed on to DisplayExternal
	UseNewTemplate: func(a1) begin
		if HasPath(template, 'SetupString) then begin
				self:SetNewWord(template:?SetupString(self:CurrentWord()), wordSource)
			end else begin
				self:SetNewWord(text, wordSource)
			end;
		self:UseNewWord();
		self:DisplayExternal(a1);
		self:Dirty()
	end,
	// lays out a new word: blanks around a free-form word (one before it if
	// there is room), centred in the view, and each letter's alternative its
	// other case (ASCII letters: 32 apart)
	UseNewWord: func() begin
		local l1, box, len, textItem, cHR2;
		if self:FixedWord() then begin
				wordLeft := 0;
				trailers := 0
			end else begin
				wordLeft := (if (wordRight < maxChars) then 1 else 0);
				self:AddEndCaps()
			end;
		wordRight := (StrLen(text) - trailers);
		dispLeft := 0;
		l1 := (StrLen(text) * cellWidth);
		if ((dispIndent := ((((box := self:LocalBox()).right - box.left) - l1) div 2)) < 0) then begin
				dispIndent := 0
			end;
		lastChar := nil;
		ClearTryString();
		altChars := Array((len := StrLen(text)), nil);
		(while (len > 0) do (if (if ((len := (len - 1)) < wordRight) then (len >= wordLeft)) then (if (not IsWhiteSpace((textItem := text[len]))) then begin
						if IsLower(textItem) then begin
								cHR2 := CHR((ORD(textItem) - 32))
							end else begin
								if IsUpper(textItem) then begin
										cHR2 := CHR((ORD(textItem) + 32))
									end
							end;
						(altChars[len] := Stringer([Array: textItem, cHR2]))
					end)));
		self:Dirty()
	end,
	// InvalDrawCache(what): forgets cached shapes - 'chars, 'lines (lines
	// and cell sides) or 'all
	InvalDrawCache: func(a1) begin
		(if (a1 = 'all) then begin
				lines := nil;
				chars := nil;
				(frames := nil)
			end else (if (a1 = 'chars) then (chars := nil) else (if (a1 = 'lines) then begin
						lines := nil;
						(frames := nil)
					end)))
	end,
	// pads the text: wordLeft blanks before, and blanks after up to maxChars
	AddEndCaps: func() begin
		local text, len;
		text := self.text;
		if (wordLeft > 0) then begin
				StrMunger(text, 0, 0, blankText, 0, wordLeft)
			end;
		len := StrLen(text);
		(if ((trailers := (maxChars - len)) <= 0) then (trailers := 0) else StrMunger(text, len, 0, blankText, 0, trailers))
	end,
	// AddUpperCase(guesses): makes the other case of the first guess, if a
	// letter, the second guess (unless already there)
	AddUpperCase: func(a1) begin
		local l1, sPrintObject2, pos;
		(if (if a1 then (StrLen(a1) > 0)) then (if IsAlpha((l1 := a1[0])) then begin
					sPrintObject2 := SPrintObject((l1 := (if (l1 < $a) then CHR((ORD(l1) + 32)) else CHR((ORD(l1) - 32)))));
					(if (not (pos := StrPos(a1, sPrintObject2, 1))) then StrMunger(a1, 1, 0, sPrintObject2, 0, 1))
				end))
	end,
	// BubbleUp(guesses, char, group): BubbleDown on the reversed string
	BubbleUp: func(a1, a2, text) begin
		StrReverse(a1);
		self:BubbleDown(a1, a2, text);
		StrReverse(a1)
	end,
	// answers the word as the template's CleanupString makes it
	GetWordForDisplay: func() begin
		local currentWord;
		currentWord := self:CurrentWord();
		if (if template then HasPath(template, 'CleanupString)) then begin
				currentWord := template:CleanupString(currentWord)
			end;
		return currentWord
	end,
	// FindCell(x): answers {hit: the cell under global x (nil outside the
	// cells), bounds: its box, edge: the nearest cell edge, edgeX: its x}
	FindCell: func(a1) begin
		local box, cellWidth2, l3, l4, l5, l6, l7;
		cell := Clone('{hit: nil, bounds: nil, edge: nil, edgeX: nil});
		box := self:GlobalBox();
