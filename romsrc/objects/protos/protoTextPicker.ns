// protoTextPicker, and what only it reaches

protoTextPicker := {
	viewClass: clView,
	viewBounds: nil,
	viewFlags: vVisible + vClickable,
	viewJustify: vjParentFullH + vjSiblingBottomV,
	labelFont: tsSystem + tsSize(9) + tsBold,
	entryFont: tsHWFont + tsSize(10),
	indent: nil,
	label: uCardPositionAlertButton,
	pix: nil,
	MakePickLine: func(box, label2, textSetup) begin
		local fontHeight2, l2, l3;
		box := self:LocalBox();
		if (not indent) then begin
				indent := (StrFontWidth(label, labelFont) + 6)
			end;
		fontHeight2 := FontHeight(labelFont);
		l2 := (((box.bottom - fontHeight2) >> 1) + FontAscent(labelFont));
		l3 := (((box.bottom - FontHeight(entryFont)) >> 1) + FontAscent(entryFont));
		(pix := [Array: {font: labelFont}, MakeText(label2, box.left, box.top, (box.left + indent), (box.top + l2)), {font: entryFont}, MakeText(textSetup, (box.left + indent), box.top, box.right, (box.top + l3))])
	end,
	viewSetupChildrenScript: func() begin
		self:MakePickLine(self:LocalBox(), label, self:TextSetup())
	end,
	viewDrawScript: func() begin
		self:DrawShape(pix, nil)
	end,
	viewHiliteScript: func(on) begin
		local box, fontHeight2, l3, l4;
		box := self:LocalBox();
		fontHeight2 := FontHeight(labelFont);
		l4 := (((l3 := (((box.bottom - fontHeight2) >> 1) - 1)) + fontHeight2) + 2);
		self:DrawShape(MakeRoundRect(-2, l3, indent, l4, 8), '{transferMode: 2, penPattern: 0, fillPattern: 5});
		true
	end,
	viewClickScript: func(unit) begin
		(if self:TrackHilite(unit) then self:Popit((indent - 2)))
	end,
	Popit: func(x) begin
		nil
	end,
	pickActionScript: func(index) begin
		self:viewSetupChildrenScript();
		self:hilite(nil);
		self:Dirty()
	end,
	pickCancelledScript: func() begin
		self:hilite(nil)
	end
};
