// protoTwoLinePicker: a two-line picker - a label that pops up a list of
// choices, with the choice shown on the line below it. Picking the last
// choice (an "other" choice) shows a number field and a second picker of
// units beside it (as the Dates application's alarm "advance notice": a
// number of minutes, hours or days).

protoTwoLinePicker := {
	viewClass: clView,
	viewFlags: vVisible + vClipping,
	viewFormat: vfFillWhite,
	viewJustify: vjParentFullH,
	viewBounds: {left: 0, top: 20, right: 0, bottom: 60},
	// the index of the choice of the second picker
	otherSelection: 0,
	label: uCardPositionAlertButton,
	// the first picker's choices (the last is "other") and the second's
	choices: [|Array|: ],
	otherChoices: [|Array|: ],
	// pickActionScript(index): a choice from the first picker - shows it on
	// the second line; the last choice shows the number field and second
	// picker and returns -1, any other hides them and returns its index
	pickActionScript: func(index) begin
		pickChild:hilite(nil);
		SetValue(textDisplay, 'text, choices[index]);
		(if (index = (Length(choices) - 1)) then begin
				otherPicker:Show();
				otherInput:Show();
				-1
			end else begin
				otherPicker:Hide();
				otherInput:Hide();
				index
			end)
	end,
	// chooseOtherScript(index): sent by the second picker; records the
	// choice and shows it (after the pop-up diamond when there is more than
	// one to choose from)
	chooseOtherScript: func(index) begin
		otherPicker:hilite(nil);
		otherSelection := index;
		(if (Length(otherChoices) > 1) then SetValue(otherPicker, 'text, Stringer([Array: "\uFC01\u", " ", otherChoices[index]])) else SetValue(otherPicker, 'text, otherChoices[index]))
	end,
	// currentChoice(): the index of the choice shown (compared as strings,
	// case-insensitively), or nil
	currentChoice: compile(
		constants: {
			kFunction_50ab09: func(a1, a2) begin
				StrEqual(a1, a2)
			end
		},
		func() begin
			ArrayPos(choices, textDisplay.text, 0, kFunction_50ab09)
		end),
	// viewSetupDoneScript(): the "other" parts start hidden
	viewSetupDoneScript: func() begin
		otherPicker:Hide();
		otherInput:Hide()
	end,
	// pickCancelledScript(): a popup closed without a choice; unhilites
	pickCancelledScript: func() begin
		pickChild:hilite(nil);
		otherPicker:hilite(nil)
	end,
	viewChildren: [viewChildren: pickChild, textDisplay, otherPicker, otherInput],
	pickChild: nil,
	allocateContext: [|Array|:
		'pickChild,
		pickChild,
		'textDisplay,
		textDisplay,
		'otherPicker,
		otherPicker,
		'otherInput,
		otherInput
	],
	textDisplay: nil,
	otherPicker: nil,
	otherInput: nil
};

// the label, which pops up the choices
pickChild := {
	viewJustify: vjCenterV + vjParentFullH,
	viewFlags: vVisible + vReadOnly + vClickable,
	viewFormat: vfRound(4),
	viewBounds: {left: 0, top: 0, right: 0, bottom: 15},
	// viewSetupFormScript(): the label after the pop-up diamond (U+FC01);
	// with only one choice, plain and not clickable (vClickable taken out)
	viewSetupFormScript: func() begin
		(if (Length(choices) > 1) then (self.text := Stringer([Array: "\uFC01\u", " ", label])) else begin
				self.text := label;
				(self.viewFlags := (viewFlags - vClickable))
			end)
	end,
	// viewClickScript(unit): pops up the choices, the current one with a
	// check mark (U+FC0B), 15 pixels down
	viewClickScript: func(unit) begin
		local currentChoice, copy;
		(if self:TrackHilite(unit) then begin
				if (currentChoice := self:currentChoice()) then begin
						(copy := Clone(choices))[currentChoice] := {item: copy[currentChoice], mark: $\uFC0B}
					end else begin
						copy := choices
					end;
				DoPopup(copy, 15, 0, self:Parent())
			end)
	end,
	preallocatedContext: 'pickChild,
	_proto: @protoStaticText
};

// the second line: the choice, in the handwriting font
textDisplay := {
	viewFont: tsHWFont + tsSize(10),
	viewJustify: vjCenterV + vjParentFullH + vjParentFullV,
	viewBounds: {left: 14, top: 15, right: 0, bottom: 0},
	text: uCardPositionAlertButton,
	preallocatedContext: 'textDisplay,
	_proto: @protoStaticText
};

// the second picker (the units), at the right of the second line
otherPicker := {
	viewJustify: vjCenterV + vjParentRightH + vjSiblingFullV,
	viewFlags: vVisible + vReadOnly + vClickable,
	viewFormat: vfRound(4),
	viewBounds: {left: -100, top: 0, right: 0, bottom: 0},
	// viewSetupFormScript(): shows the first of otherChoices, after the
	// diamond; with only one, plain and not clickable
	viewSetupFormScript: func() begin
		(if (Length(otherChoices) > 1) then (self.text := Stringer([Array: "\uFC01\u", " ", otherChoices[0]])) else begin
				self.text := otherChoices[0];
				(self.viewFlags := (viewFlags - vClickable))
			end)
	end,
	// viewClickScript(unit): pops up otherChoices, the current one checked
	viewClickScript: func(unit) begin
		local copy;
		(if self:TrackHilite(unit) then begin
				(copy := Clone(otherChoices))[otherSelection] := {item: copy[otherSelection], mark: $\uFC0B};
				DoPopup(copy, 15, 0, self)
			end)
	end,
	// pickActionScript(index): passes the choice to the picker
	pickActionScript: func(index) begin
		self:Parent():chooseOtherScript(index)
	end,
	preallocatedContext: 'otherPicker,
	_proto: @protoTextButton
};

// the number field, at the left of the second picker
otherInput := {
	viewJustify: vjCenterH + vjSiblingLeftH + vjSiblingFullV,
	viewFlags: vVisible + vSingleUnit + vClickable + vGesturesAllowed + vNumbersAllowed,
	textFlags: 10,
	viewBounds: {left: -40, top: 0, right: -10, bottom: 0},
	// the last valid text, put back when an entry is refused
	oldValue: uCardPositionAlertButton,
	// viewChangedScript(slot, view): checks a new text - it must be a whole
	// number from 0 to 999; otherwise an alert says so and the old text is
	// put back
	viewChangedScript: func(slot, view) begin
		local l1, text2, number;
		l1 := nil;
		(if (slot = 'text) then (if (not StrEqual(view.text, "")) then begin
					if ((not (number := StringToNumber(view.text))) or (trunc(number) <> number)) then begin
							l1 := true;
							text2 := "The value for the advance notice must be a whole number."
						end else begin
							if (not LimitInt(number, 0, 999)) then begin
									l1 := true;
									text2 := "The value for the advance notice must be between 0 and 999."
								end
						end;
					(if (not l1) then (oldValue := Clone(view.text)) else begin
							self:Notify(kNotifyAlert, "Alarm", text2);
							text := Clone(oldValue);
							self:Dirty()
						end)
				end))
	end,
	preallocatedContext: 'otherInput,
	_proto: @protoInputLine
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewChangedScript_literal7 := same("otherInput.viewChangedScript.literals[7]");

viewChangedScript_literal5 := same("otherInput.viewChangedScript.literals[5]");
