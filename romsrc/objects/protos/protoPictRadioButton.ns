// protoPictRadioButton, and what only it reaches

protoPictRadioButton := {
	_proto: @protoPictureButton,
	declareSelf: 'base,
	viewValue: nil,
	buttonValue: nil,
	viewDrawScript: func() begin
		(if viewValue then self:DrawShape(MakeRect(1, 1, 14, 14), nil))
	end,
	UpdateBitmap: func() begin
		base:Dirty()
	end,
	viewClickScript: func(unit) begin
		if (viewValue = nil) then begin
				cluster:SetCluster(base)
			end;
		true
	end,
	debug: 46168208
};
