// protoFilingButton, and what only it reaches

protoFilingButton := {
	viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH,
	icon: nil,
	iconInt: @filingBitmap,
	iconExt: @filingExtBitmap,
	PickIcon: func() begin
		local filing;
		(if (((not (filing := self:GetTargetInfo('Filing))) or (not filing.targetStore)) or (filing.targetStore = GetStores()[0])) then iconInt else iconExt)
	end,
	viewSetupFormScript: func() begin
		(icon := self:PickIcon())
	end,
	Update: func() begin
		local pickIcon;
		pickIcon := self:PickIcon();
		(if (icon <> pickIcon) then SetValue(self, 'icon, pickIcon))
	end,
	buttonClickScript: buttonClickScript_2,
	_proto: @protoPictureButton
};
