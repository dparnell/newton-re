// protoTimeButton, and what only it reaches

protoTimeButton := {
	_proto: @protoTextButton,
	declareSelf: 'title,
	lastSeed: nil,
	TimeString: TimeString,
	TimeBox: TimeBox,
	viewSetupFormScript: func() begin
		local l1;
		if (l1 := self:TimeBox((text := self:TimeString()))) then begin
				viewBounds := l1
			end;
		self:SetupIdle(30000)
	end,
	viewIdleScript: viewIdleScript,
	viewDrawScript: viewDrawScript,
	buttonClickScript: buttonClickScript_3
};
