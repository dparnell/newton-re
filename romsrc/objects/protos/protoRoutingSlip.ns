// protoRoutingSlip, and what only it reaches

protoRoutingSlip := {
	_proto: @protoPictureButton,
	icon: @routingBitmap,
	viewJustify: vjCenterH + vjCenterV + vjParentRightH,
	viewBounds: {left: -42, top: 2, right: -25, bottom: 15},
	popupForm: nil,
	actionList: nil,
	targetInfo: nil,
	alwaysCallPickActionScript: true,
	viewClickScript: func(a1) begin
