// protoDrawer: a view that behaves like the Extras Drawer - it slides up from
// the bottom of the screen with the drawer-opening sound and closes with the
// drawer-closing one. It has no contents of its own.

protoDrawer := {
	_proto: @protoContainerView,
	viewEffect: fxDrawerEffect,
	viewFlags: vApplication + vFloating,
	viewFormat: vfFrameBlack + vfPen(3),
	showSound: @drawerOpen,
	hideSound: @drawerClose,
	viewBounds: nil
};
