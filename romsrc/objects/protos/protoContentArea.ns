// protoContentArea, and what only it reaches

protoContentArea := {
	_proto: protoContentAreaProto,
	viewFlags: vVisible + vReadOnly + vClipping + vGesturesAllowed,
	viewSetupFormScript: func() begin
		self.bookScripts := Clone(protoBookScripts);
		if (l3 := (currentBook := self:CurrentBook()).scripts) then begin
				local currentBook;
				local i;
				local l3;
				(for i := 0 to (Length(l3) - 1) by 2 do begin
						local pageSize;
						self.bookScripts.(l3[i]) := l3[(i + 1)]
					end)
			end;
		self._proto := bookScripts;
		pageSize := self:PageSize(nil);
		self.viewBounds := RelBounds(0, 0, pageSize.width, pageSize.height);
		(if (pagesShowing = 2) then (viewBounds.right := ((pageSize.width * 2) + 15)))
	end,
	protoBookScripts: {
		_proto: protoContentAreaProto,
		mungeContentScript: nil,
		HideMarkup: func() begin
			local item;
			local childViewFrames;
			(foreach item in (childViewFrames := self:ChildViewFrames()) do begin
					if item.Scroller then begin
							item:ShowScroller()
						end
				end)
		end,
		ShowMarkup: func() begin
			local item;
			local childViewFrames;
			(foreach item in (childViewFrames := self:ChildViewFrames()) do begin
					if item.Scroller then begin
							item:HideScroller()
						end
				end)
		end,
		edgeWidth: 1,
		viewQuitScript: func() begin
			true
		end,
		viewShowScript: func() begin
			true
		end,
		buttonClickScript: func() begin
			nil
		end,
		viewClickScript: func(unit) begin
			self:buttonClickScript();
			true
		end,
		debug: 71595
	},
	debug: contentArea,
	preallocatedContext: 'contentArea
};

