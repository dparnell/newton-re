			end)
	end,
	validAlways: nil,
	GetCursor: func() begin
		cursor
	end,
	selectedCheckBox: nil,
	// Sets up the picker before its children open: the data definition; the
	// list's bounds grown into the space of the parts suppressed (13 pixels for
	// the folder tabs, 18 for the A-Z tabs, 25 at the bottom when nothing is
	// left there), the parts hidden (viewFlags 0); the border; selected sorted,
	// every item made a name reference of the data def's class, those without
