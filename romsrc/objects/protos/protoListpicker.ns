	AddFake: func(a1, a2) begin
		local nameRef;
		nameRef := a1;
		if (not IsNameRef(a1)) then begin
				(nameRef := pickerDef:MakeNameRef(a1, nil))._fakeID := self:GetUniqueFakeID()
			end;
		nameRef._Unselected := (not a2);
		self:AddToSelected(nameRef);
		listBase:Update()
	end,
	selCountText: nil,
	viewScrollUpScript: func() begin
		listBase:viewScrollUpScript()
	end,
	dividerLine: nil,
	// picker:Refresh() - shows the count and redraws (when open).
	Refresh: func() begin
		if (not viewCObject) then begin
				return nil
			end;
		selCountText:Update(totalSelected);
		pickBase:Dirty()
	end,
	// picker:Update() - remakes the list's lines from the cursor, the arrows
