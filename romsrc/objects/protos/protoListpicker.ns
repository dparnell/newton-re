// protoListpicker: the system's list picker - a scrolling, checkable list
// of items from a soup (or an array), shown in columns, with folder tabs,
// A-Z tabs, a "Selected Only" checkbox, a count of the items selected, New
// and Find buttons and a close box (each can be suppressed). The data
// definition in pickerDef (a protoNameRefDataDef) says how to show and edit
// the items; the selection is the array selected, of name references.
// Items not in the soup (made by New, or given in selected) are "fakes",
// listed from an array cursor (ersatzCursor) merged with the soup's cursor
// (protoMultiCursor). listBase is the list itself (a protoSoupOverview).
// The other definitions in this file are the picker's children.

protoListpicker := {
	// whether any fake items exist (the multi-cursor is then needed)
	anyFakes: nil,
	viewFormat: vfFillWhite + vfRound(2),
	// non-nil: unselected items are kept in selected when the picker closes
	dontPurge: nil,
	AppAll: allItems,
	// the tap being handled: {nameRef, tapIndex, bbox, fieldPath, editPaths,
	// _reqPaths, _sortValue, popup} (listBase's SetTapInfo)
	fTapinfo: nil,
	// options: parts of the picker to leave out
	suppressFolderTabs: nil,
	suppressFind: true,
	// the valid tests the array cursor is given (SetupCursor makes them)
	validIfFake: nil,
	suppressNew: nil,
	viewFlags: vVisible + vApplication + vClickable,
	suppressBorder: nil,
	// the query spec used, with the folder filtering added
	myQuerySpec: nil,
	// non-nil: open showing only the selected items
	reviewSelections: nil,
	// the index text (IndexStr) of the cursor's place, to go back to it
	fCurrentKey: nil,
	// how many items are selected
	totalSelected: 0,
	viewBounds: {left: 2, top: 20, right: -2, bottom: 260},
	// the soup listed (from soupToQuery)
	fSoup: nil,
	validIfSelected: nil,
	appObject: [|Array|: item_2, items_2],
	// the callback id the picker registers for its soup's changes
	soupChangeSymbol: 'listpicker,
	// 'all or 'selected (the "Selected Only" checkbox)
	nowShowing: 'all,
	suppressScrollers: nil,
	// the cursor the list shows: soupCursor, multiCursor or ersatzCursor
	cursor: nil,
	// the folder shown ('_all for all)
	labelsFilter: '_all,
	origListBounds: nil,
	soupCursor: nil,
	// non-nil: items can only be looked at
	readOnly: nil,
	multiCursor: nil,
	viewJustify: vjParentFullH,
	// the last fake id given out (GetUniqueFakeID)
	fakeID: nil,
	// the view the data definition opened for a tap (an editor, a popup), if any
	fOpenEditor: nil,
	suppressAZTabs: nil,
	querySpec: nil,
	declareSelf: 'pickBase,
	// the cursor over the selected array (the fake items, or the selection when
	// showing only it); its context is the picker, and it finds a string key by
	// binary search on the items' sort text
	ersatzCursor: {
		_proto: @arrayErsatzCursor,
		// A new cursor over array a2 whose parent is a1.context (the picker): the
		// one arrayErsatzCursor makes takes its _parent as its proto.
		New: func(a1, a2) begin
			local l1;
			(l1 := inherited:New(a1, a2))._proto := l1._parent;
			l1._parent := a1.context;
			l1
		end,
		// Goes to key a1: a string is looked up (BSearchLeft) among the items'
		// sort text, an item whose text begins with it counting as equal.
		GotoKey: compile(
			constants: {
				kFunction_4503ad: func(a1, a2) begin
					(if BeginsWith(a2, a1) then 0 else StrCompare(a1, a2))
				end
			},
			func(a1) begin
				local l1;
				inherited:GotoKey((l1 := (if IsInstance(a1, 'string) then BSearchLeft(things, a1, kFunction_4503ad, func(a1) begin
						pickerDef:Get(a1, pickerDef._sortPath, 'sortText)
					end) else a1)))
			end)
	},
	soupToQuery: nil,
	canScrollDown: nil,
	suppressCloseBox: nil,
	viewClass: clView,
	suppressCounter: nil,
	suppressSelOnlyCheckbox: nil,
	viewFont: tsSystem + tsSize(10) + tsBold,
	fBorder: nil,
	canScrollUp: nil,
	folderDefault: '_all,
	// For the folder tabs ('Filing): the picker itself is the target, on the
	// default store; any other request goes to the parent.
	GetTargetInfo: func(a1) begin
		(if (a1 = 'Filing) then {target: nil, targetType: nil, targetView: self, targetStore: GetDefaultStore()} else self:Parent():?GetTargetInfo(a1))
	end,
	// After opening: registers for the soup's changes (a change of kind a3 is
	// sent to the picker as message a3, e.g. SoupEnters or SoupLeaves, with
	// the soup's name and the change's data) and shows the count.
	viewSetupDoneScript: func() begin
		local fn;
		fn := func(a1, a2, a3, a4) begin
			ProtoPerformIfDefined(self, a3, [Array: a1, a4])
		end;
		if (if fSoup then soupChangeSymbol) then begin
				RegSoupChange(fSoup:GetName(), soupChangeSymbol, fn)
			end;
		self:Refresh()
	end,
	// A new id for a fake item (0, 1, ...); there are fakes from now on.
	GetUniqueFakeID: func() begin
		anyFakes := true;
		(if (not fakeID) then (fakeID := 0) else (fakeID := (fakeID + 1)))
	end,
	closeBox: nil,
	// Chooses the cursor to show: the selection only (array cursor, selected
	// items), the soup merged with the fakes, the soup alone, or (no soup) the
	// array of items given.
	UpdateCursor: func() begin
		(if (nowShowing = 'selected) then begin
				ersatzCursor.validTest := validIfSelected;
				(cursor := ersatzCursor)
			end else (if soupCursor then (if anyFakes then begin
						ersatzCursor.validTest := validIfFake;
						(cursor := multiCursor)
					end else (cursor := soupCursor)) else begin
					ersatzCursor.validTest := validAlways;
					(cursor := ersatzCursor)
				end))
	end,
	// On closing: closes any editor still open, drops the unselected items from
	// selected (unless the picker or its data def says dontPurge) and stops
	// listening to the soup.
	viewQuitScript: func() begin
		local view, l2;
		if (if IsFrame(fOpenEditor) then (view := GetView(fOpenEditor))) then begin
				view:Close()
			end;
		fTapinfo := nil;
		l2 := (not (pickerDef.dontPurge or dontPurge));
		listBase:CleanupSelected(selected, l2);
		(if (if fSoup then soupChangeSymbol) then UnRegSoupChange(fSoup:GetName(), soupChangeSymbol))
	end,
	// Draws the picker, then its 2-pixel border (unless suppressBorder).
	viewDrawScript: func() begin
		inherited:?viewDrawScript();
		(if fBorder then self:DrawShape(fBorder, {pensize: 2}))
	end,
	listBase: nil,
	viewChildren: [viewChildren:
		folderTabs,
		AZTabs_2,
		listBase,
		closeBox,
		selCountText,
		selectedCheckBox,
		dividerLine,
		upDownScroller,
		findNnewContainer,
		tapMasker
	],
	// While a tap is being handled (an editor or popup open), tapMasker covers
	// the picker so that other taps go nowhere.
	MaskTaps: func(a1) begin
		(if a1 then tapMasker:Open() else tapMasker:Close())
	end,
	// picker:SetNowShowing('all or 'selected) - shows everything or the selection.
	SetNowShowing: func(a1) begin
		nowShowing := a1;
		listBase:RedoCursor()
	end,
	// Sets up the cursors: the soup (soupToQuery, the picker's or its data
	// def's: a union soup's name or a method returning a soup) queried with
	// the query spec plus folder filtering; the array cursor over selected; the
	// valid tests (by folder; the selected; the fakes); and a multi-cursor
	// merging the soup and the array by sort text (or the same entry, for
	// '|=|). Then the cursor goes to selectedItem (single selection) or the
	// start. kFunction_450079 gives an item's entry when it has one.
	SetupCursor: compile(
		constants: {
			kFunction_450079: func(a1) begin
				local resolveEntryAlias2;
				if (not a1) then begin
						return nil
					end;
				(if IsInstance(a1, 'alias) then ResolveEntryAlias(a1) else (if (if IsFrame(a1) then a1._alias) then (if (resolveEntryAlias2 := ResolveEntryAlias(a1._alias)) then resolveEntryAlias2 else a1) else a1))
			end
		},
		func(selectedItem) begin
			local pickerDef2, soupToQuery2, fn, l4;
			pickerDef2 := self;
			if (not (soupToQuery2 := soupToQuery)) then begin
					if pickerDef.soupToQuery then begin
							soupToQuery2 := pickerDef.soupToQuery;
							pickerDef2 := pickerDef
						end
				end;
			self.fSoup := (if soupToQuery2 then (if IsInstance(soupToQuery2, 'string) then GetUnionSoup(soupToQuery2) else pickerDef2:soupToQuery()));
			self.myQuerySpec := (if querySpec then querySpec else (if pickerDef.querySpec then pickerDef.querySpec else '{type: index, indexPath: sorton}));
			self.clientFilter := myQuerySpec.validTest;
			if fSoup then begin
					self.myQuerySpec := self:SetupFiltering(myQuerySpec);
					self.soupCursor := fSoup:Query(myQuerySpec)
				end;
			if (not selected) then begin
					selected := [Array: ]
				end;
			ersatzCursor := ersatzCursor:New({context: self}, selected);
			self.validAlways := func(a1) begin
				((a1.labels = labelsFilter) or (labelsFilter = '_all))
			end;
			self.validIfSelected := func(a1) begin
				(if (not a1._Unselected) then ((a1.labels = labelsFilter) or (labelsFilter = '_all)))
			end;
			self.validIfFake := func(a1) begin
				(if a1._fakeID then ((a1.labels = labelsFilter) or (labelsFilter = '_all)))
			end;
			if fSoup then begin
					fn := func(a1, a2, a3) begin
						local entryFromObj2, entryFromObj3, l3, l4, strCompare2;
						(if (a3 = '|=|) then (if IsNameRef(a1) then ((if a1._fakeID then (a1._fakeID = a2._fakeID)) or (if (if a1._alias then a2._alias) then IsSameEntry(a1._alias, a2._alias))) else begin
									entryFromObj2 := EntryFromObj(a1);
									entryFromObj3 := EntryFromObj(a2);
									(if (if entryFromObj2 then entryFromObj3) then IsSameEntry(entryFromObj2, entryFromObj3))
								end) else begin
								l3 := (if IsNameRef(a1) then pickerDef:Get(a1, pickerDef._sortPath, 'sortText) else a1.sorton);
								l4 := (if IsNameRef(a2) then pickerDef:Get(a2, pickerDef._sortPath, 'sortText) else a2.sorton);
								((if ((strCompare2 := StrCompare(l3, l4)) < 0) then (a3 = '|<|)) or (if (strCompare2 > 0) then (a3 = '|>|)))
							end)
					end;
					self.multiCursor := @protoMultiCursor:New([Array: soupCursor, ersatzCursor], fn)
				end;
			self:UpdateCursor();
			(if (if selectedItem then pickerDef.singleSelect) then cursor:GotoKey((fCurrentKey := self:IndexStr((l4 := call (kFunction_450079) with (selectedItem))))) else begin
					cursor:Reset();
					(fCurrentKey := nil)
				end)
		end),
	tapMasker: nil,
	// The key of an item for the A-Z tabs and GotoKey: its sort text up to the
	// first comma (a surname), " " if empty, nil for no item.
	IndexStr: func(entry) begin
		local sortText, pos;
		(if entry then (if StrFilled((sortText := pickerDef:Get(entry, pickerDef._sortPath, 'sortText))) then (if (pos := StrPos(sortText, ",", 0)) then Substr(sortText, 0, pos) else sortText) else " "))
	end,
	upDownScroller: nil,
	// picker:SetCursor(cursor) and picker:GetCursor() - the cursor shown.
	SetCursor: func(a1) begin
		(self.cursor := a1)
	end,
	allocateContext: [|Array|:
		'folderTabs,
		folderTabs,
		'AZTabs,
		AZTabs_2,
		'listBase,
		listBase,
		'closeBox,
		closeBox,
		'selCountText,
		selCountText,
		'selectedCheckBox,
		selectedCheckBox,
		'dividerLine,
		dividerLine,
		'upDownScroller,
		upDownScroller,
		'findNnewContainer,
		findNnewContainer,
		'tapMasker,
		tapMasker
	],
	// picker:ChangePickerDef(dataDef) - switches to another data definition:
	// columns and title redone, each selected item not of its class remade as
	// one of its name references (unselected if not valid for it), the count
	// and the list redone.
	ChangePickerDef: func(dataDefs) begin
		self:SetupPickerDef(dataDefs);
		listBase:SetupColumns();
		if folderTabs.viewCObject then begin
				SetValue(folderTabs.title, 'text, pickerDef.name)
			end;
		cls := ClassOf(dataDefs);
		l2 := 0;
		local cls;
		local l2;
		(for i := 0 to (Length(selected) - 1) do begin
				local selectedItem, l7;
				if (not IsSubclass((selectedItem := selected[i])._entryClass, cls)) then begin
						(l7 := (selected[i] := pickerDef:MakeNameRef(selectedItem, cls)))._Unselected := (selectedItem._Unselected or (Length(pickerDef:Validate(l7, listBase.fRequiredPaths)) > 0));
						l7._fakeID := selectedItem._fakeID;
						selectedItem := l7
					end;
				if (not selectedItem._Unselected) then begin
						listBase.freshest := {nameRef: selectedItem};
						l2 := (l2 + 1)
					end
			end);
		totalSelected := l2;
		listBase:SetupAbstracts(cursor:clone());
		self:Dirty()
	end,
	// Makes pickerDef2 the data definition, with _sortPath (the primary path, or
	// the first column's): a read-only one (in ROM) gets a writable frame on it.
	SetupPickerDef: func(pickerDef2) begin
		local primaryPath;
		primaryPath := pickerDef2.primaryPath;
		(if IsReadOnly(pickerDef2) then (pickerDef := {_proto: pickerDef2, class: pickerDef2.class, _sortPath: (if primaryPath then primaryPath else pickerDef2.columns[0].fieldPath)}) else ((pickerDef := pickerDef2)._sortPath := (if primaryPath then primaryPath else pickerDef.columns[0].fieldPath)))
	end,
	// Called by the folder tabs when another folder is chosen: the soup is
	// queried again with the new filter and the list redone at the same key.
	FilterChanged: func() begin
		if fSoup then begin
				pickBase.myQuerySpec := self:SetupFiltering(myQuerySpec);
				soupCursor := fSoup:Query(myQuerySpec);
				if multiCursor then begin
						multiCursor:ReplaceCursor(0, soupCursor)
					end
			end;
		self:UpdateCursor();
		if fCurrentKey then begin
				cursor:GotoKey(fCurrentKey)
			end else begin
				cursor:Reset()
			end;
		self:LockScreen(true);
		AZTabs:Update();
		listBase:Update();
		self:LockScreen(nil)
	end,
	// The soup gained a store (a card inserted): fakes whose entries can now be
	// found are fakes no more; the list is redone.
	SoupEnters: func(a1, a2) begin
		if selected then begin
				(foreach item in selected do begin
						if (if (if item._fakeID then item._alias) then ResolveEntryAlias(item._alias)) then begin
								item._fakeID := nil
							end
					end)
			end;
		self:RedoCursor()
	end,
	// Inserts nameRef in selected in sort order (keeping the array cursor on
	// its item). Returns selected.
	AddToSelected: func(nameRef) begin
		local entry;
		if selected then begin
				entry := ersatzCursor:entry();
				BInsert(selected, nameRef, '|str<|, func(a1) begin
					pickerDef:Get(a1, pickerDef._sortPath, 'sortText)
				end, nil);
				ersatzCursor:Goto(entry)
			end else begin
