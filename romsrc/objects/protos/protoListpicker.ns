};

// the bar at the top: the data definition's name, and folder tabs
folderTabs := {
	viewJustify: vjCenterV + vjParentFullH,
	viewBounds: {left: 1, top: 0, right: -1, bottom: 20},
	title: uCardPositionAlertButton,
	// taps on the bar itself are not taken
	viewClickScript: func(unit) begin
		nil
	end,
	// shows the data definition's name as the title
	viewSetupDoneScript: func() begin
		SetValue(title, 'text, pickerDef.name)
	end,
	preallocatedContext: 'folderTabs,
	_proto: @protoNewShowBar
};

// the A-Z tabs under the bar (the picker's AZTabs): tapping a letter moves the list there
AZTabs_2 := {
	// the two vertical lines at its sides, continuing the picker's border
	fBars: nil,
	viewJustify: vjCenterH + vjParentFullH + vjSiblingBottomV,
	// Draws the highlighted letter and, unless suppressBorder, the side lines.
	viewDrawScript: func() begin
		local box;
		if (not suppressBorder) then begin
				if (not fBars) then begin
						box := self:LocalBox();
						fBars := [Array: MakeLine(0, 0, 0, box.bottom), MakeLine((box.right - 2), 0, (box.right - 2), box.bottom)]
					end
			end;
		self:hiliter(curIndex);
		(if (not suppressBorder) then self:DrawShape(fBars, {pensize: 2}))
