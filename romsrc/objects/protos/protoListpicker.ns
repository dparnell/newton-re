	viewSetupChildrenScript: func() begin
		self:SetupPickerDef(pickerDef);
		if (not origListBounds) then begin
				origListBounds := listBase.viewBounds
			end;
		listBase.viewFont := viewFont;
		l1 := (listBase.viewBounds := Clone(origListBounds));
		if readOnly then begin
				suppressSelOnlyCheckbox := true;
				suppressNew := true;
