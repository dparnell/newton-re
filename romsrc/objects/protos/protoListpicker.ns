	viewScroll2DScript: func(arrowDirection, a2) begin
		if (arrowDirection = 'up) then begin
				listBase:viewScrollUpScript()
			end else begin
				if (arrowDirection = 'down) then begin
						listBase:viewScrollDownScript()
					end
			end;
		RefreshViews()
	end,
	Update: func() begin
		self:SetArrow('up, (if canScrollUp then 'more else 'normal));
		self:SetArrow('down, (if canScrollDown then 'more else 'normal));
		Scroller:Dirty()
	end,
	_proto: @protoUpDownScroller
};

// the New button: a new item through the data definition
newButton := {
	viewJustify: oneLineOnly + vjSiblingRightH + vjParentCenterH + vjParentFullV + vjCenterV + vjCenterH,
	viewBounds: {left: 6, top: 0, right: 36, bottom: 0},
	text: new_2,
	// tapped: listBase makes the new item
	buttonClickScript: func() begin
		listBase:HitNewbutton()
	end,
	preallocatedContext: 'newButton,
	_proto: @protoTextButton
};

// the Find button: finds in the picker's items (pickBase:FindSelections)
findButton := {
	viewJustify: oneLineOnly + vjParentFullV + vjCenterV + vjCenterH,
	viewBounds: {left: 0, top: 0, right: 30, bottom: 0},
	text: find,
	// With a single choice holding a single item, that item is shown at once;
	// otherwise the Find slip opens (pseudoFinder), titled by the data
	// definition's findTitle.
	buttonClickScript: func() begin
		local context, selections, l3, selection;
		context := BuildContext(pseudoFinder);
		if (Length((selections := pickBase:FindSelections())) = 1) then begin
				if (Length((selection := selections[0]).items) = 1) then begin
						pickBase:ShowItem(@compatibleFinder, selection.items[0]);
						l3 := true
					end
			end;
		(if (not l3) then (fOpenEditor := context:OpenFind(selections, pickerDef.findTitle, pickBase)))
	end,
	preallocatedContext: 'findButton,
	_proto: @protoTextButton
};

// the New and Find buttons, centred at the bottom
findNnewContainer := {
	viewClass: clView,
	viewFlags: vVisible,
	viewFormat: vfFillWhite,
	viewJustify: vjCenterH + vjCenterV + vjParentCenterH + vjParentBottomV,
	viewBounds: {left: 0, top: -19, right: 66, bottom: -6},
	// Before opening: with either button suppressed, the container is one
	// button wide and the suppressed one hidden.
	viewSetupFormScript: func() begin
		(if (suppressNew or suppressFind) then begin
				self.viewBounds := SetBounds(0, -19, 30, -6);
				if suppressNew then begin
						newButton.viewFlags := 0
					end;
				(if suppressFind then (findButton.viewFlags := 0))
			end)
	end,
	// Update(0) closes the Find button, Update(1) opens it (unless suppressed);
	// the New button is reopened either way.
	Update: func(scalingInfo) begin
		if (not Visible(self)) then begin
				return nil
			end;
		(if (scalingInfo = 0) then begin
				if (not suppressFind) then begin
						findButton:Close()
					end;
				newButton:Close();
				newButton:Open()
			end else (if (scalingInfo = 1) then begin
					if (not suppressFind) then begin
							findButton:Open()
						end;
					newButton:Close();
					newButton:Open()
				end))
	end,
	preallocatedContext: 'findNnewContainer,
	viewChildren: [viewChildren: newButton, findButton],
	newButton: nil,
	allocateContext: [|Array|: 'newButton, newButton, 'findButton, findButton],
	findButton: nil
};

// an invisible view over the whole picker, open while the data definition
// handles a tap (MaskTaps)
tapMasker := {
	viewClass: clView,
	viewJustify: vjParentFullH + vjParentFullV,
	viewBounds: {left: 0, top: 0, right: 0, bottom: 0},
	viewFlags: vFloating + vClickable,
	viewFormat: 0,
	// A tap is swallowed while the view opened for the tap is visible; if that
	// view is gone, the masker closes itself (later) and lets the tap through.
	viewClickScript: func(unit) begin
		(if (if fOpenEditor then Visible(fOpenEditor)) then true else begin
				AddDeferredSend(self, 'Close, [Array: ]);
				nil
			end)
	end,
	preallocatedContext: 'tapMasker
};

