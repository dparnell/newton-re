				self.storesFilter := nil;
				folderTabs.viewFlags := 0;
				l1.top := (l1.top - 13)
			end else begin
				if (storesFilter exists) then begin
						self.storesFilter := storesFilter
					end
			end;
		if suppressAZTabs then begin
				AZTabs.viewFlags := 0;
				l1.top := (l1.top - 18)
			end;
		if suppressScrollers then begin
				upDownScroller.viewFlags := 0
			end;
		if suppressSelOnlyCheckbox then begin
				selectedCheckBox.viewFlags := 0
			end;
		if suppressCloseBox then begin
				closeBox.viewFlags := 0
			end;
		if (if suppressNew then suppressFind) then begin
				findNnewContainer.viewFlags := 0
			end;
		if (pickerDef.singleSelect or suppressCounter) then begin
				selCountText.viewFlags := 0
			end;
		if (if (if (if (if suppressSelOnlyCheckbox then suppressCloseBox) then suppressNew) then suppressFind) then (pickerDef.singleSelect or suppressCounter)) then begin
				l1.bottom := (l1.bottom + 25);
				dividerLine.viewFlags := 0
			end;
		if (not suppressBorder) then begin
				box := self:LocalBox();
				fBorder := MakeRect(0, 0, box.right, box.bottom)
			end;
		if selected then begin
				StableSort(selected, '|str<|, func(a1) begin
					pickerDef:Get(a1, pickerDef._sortPath, 'sortText)
				end)
			end else begin
				selected := [Array: ]
			end;
		l3 := 0;
		selectedItem2 := nil;
		if selected then begin
				cls := ClassOf(pickerDef);
				local l1;
				local box;
				local l3;
				local selectedItem2;
				local cls;
				(for i := 0 to (Length(selected) - 1) do begin
						local selectedItem;
						if (not (selectedItem := selected[i])._Unselected) then begin
								selectedItem2 := selectedItem;
								listBase.freshest := {nameRef: selectedItem};
								l3 := (l3 + 1)
							end;
						if (not IsInstance(selectedItem, cls)) then begin
								selectedItem := (selected[i] := pickerDef:MakeNameRef(selectedItem, nil))
							end;
						if ((not selectedItem._alias) or (not ResolveEntryAlias(selectedItem._alias))) then begin
								selectedItem._fakeID := self:GetUniqueFakeID()
							end else begin
								selectedItem._fakeID := nil
							end
					end)
			end;
		totalSelected := l3;
		if (reviewSelections := (if (if reviewSelections then selectedItem2) then (not pickerDef.singleSelect))) then begin
				nowShowing := 'selected
			end;
		self:SetupCursor(selectedItem2);
		AddDeferredSend(AZTabs, 'Update, [Array: ])
	end,
	// Remembers the cursor's key, to come back to it.
	MarkCursorPosition: func() begin
		(fCurrentKey := self:IndexStr(cursor:entry()))
	end,
	AZTabs: nil,
	// The soup lost a store (a card removed): selected items whose entries are
	// gone become fakes; the list is redone.
	SoupLeaves: func(a1, a2) begin
