			end;
		pickBase:UpdateCursor();
		selected
	end,
	// The scroll keys and arrows scroll the list.
	viewScrollDownScript: func() begin
		listBase:viewScrollDownScript()
	end,
	folderTabs: nil,
	// Chooses the cursor again (UpdateCursor), goes back to the same key, and
	// redraws the A-Z tabs and the list.
	RedoCursor: func() begin
		self:UpdateCursor();
		if fCurrentKey then begin
				cursor:GotoKey(fCurrentKey)
			end else begin
				cursor:Reset()
			end;
		self:LockScreen(true);
		AZTabs:Update();
		listBase:Update();
		self:LockScreen(nil)
	end,
	findNnewContainer: nil,
	// A copy of the query spec showing only the folder labelsFilter: by a tag
	// spec when the soup has tags, else by a valid test (the client's own test
	// kept in clientFilter and called first).
	SetupFiltering: func(myQuerySpec) begin
		local copy;
		copy := Clone(myQuerySpec);
		if (if fSoup then fSoup:HasTags()) then begin
				copy.tagspec := (if (labelsFilter <> '_all) then {equal: (if labelsFilter then labelsFilter else [Array: ])});
				copy.validTest := clientFilter
			end else begin
				copy.validTest := (if clientFilter then func(a1) begin
