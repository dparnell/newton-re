// protoSoftButtonBarIcon: an icon of the soft button bar (buttonBar), a
// protoExtrasIcon whose label is the first line of its target's Extras entry
// text, centred under the icon.

protoSoftButtonBarIcon := {
	_proto: @protoExtrasIcon,
	// the icon the button stands for (its fentry is the Extras entry)
	target: nil,
	text: nil,
	// GetIconShapeText(): a text shape of the label's first line, at most
	// hSpacing wide, centred horizontally, 11 pixels above iconSpacingV
	GetIconShapeText: func() begin
		local text, pos, font, least, l5, l6;
		if (pos := StrPos((text := target.fentry.text), "\n", 0)) then begin
				text := Substr(text, 0, pos)
			end;
		font := iconStyle.font;
		least := min(hSpacing, (StrFontWidth(text, font) + 2));
		l5 := ((hSpacing - least) div 2);
		l6 := (iconSpacingV - 11);
		MakeText(text, l5, l6, (l5 + least), ((l6 + FontAscent(font)) - 1))
	end,
	// GetIconShapeTextHilited(): the label hilited - the text, then its box
	// moved down a pixel and inverted (modeXor, black fill)
	GetIconShapeTextHilited: func() begin
		local iconShapeText, offsetRect2;
		offsetRect2 := OffsetRect(ShapeBounds((iconShapeText := self:GetIconShapeText())), 0, 1);
		[Array: iconShapeText, '{transferMode: 2, penPattern: 0, fillPattern: 5}, MakeShape(offsetRect2)]
	end
};
