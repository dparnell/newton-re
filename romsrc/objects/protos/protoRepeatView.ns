// the weeks of the month (kWeekInMonth): a checkbox per week, first to last
WeekPicker := {
	viewClass: clView,
	viewFlags: vVisible + vClickable,
	viewBounds: {left: 25, top: 11, right: 0, bottom: 81},
	viewJustify: vjParentFullH,
	// check the boxes of the setting's weeks; an empty setting becomes the
	// meeting's day in its week of the month (l3, from 0). mtgInfo here is
	// a local copy (declared below, the decompiler's layout); repeatType2 is
	// set but not used
	Initialize: func() begin
		mtgInfo := RepeatingView.mtgInfo;
		repeatType2 := repeatType;
		if (mtgInfo = 0) then begin
				l3 := ((mtgDate.Date - 1) div 7);
				mtgInfo := (weekBit[l3] + (kSunday >> mtgDate.dayOfWeek));
				RepeatingView.mtgInfo := mtgInfo
			end;
		local repeatType2;
		local mtgInfo;
		local l3;
		local childViewFrames;
		local childViewFrame;
		(foreach item in (childViewFrames := WeekPicker:ChildViewFrames()) do begin
				item.viewValue := nil
			end);
		(for i := 0 to 4 do begin
				childViewFrame := childViewFrames[i];
				if (BAnd(weekBit[i], mtgInfo) > 0) then begin
						childViewFrame.viewValue := true
					end else begin
						childViewFrame.viewValue := nil
					end;
				childViewFrame:UpdateBitmap()
			end)
	end,
	// a checkbox was tapped: toggle week bit a1, unless that would leave no
	// week at all (then the boxes are just reset)
	AddWeek: func(a1) begin
		local bxor2;
		(if (BAnd((bxor2 := bxor(mtgInfo, a1)), kEveryWeek) > 0) then begin
				mtgInfo := bxor2;
				self:Initialize();
				self:UpdateText()
			end else self:Initialize())
	end,
	preallocatedContext: 'WeekPicker,
	viewChildren: [viewChildren:
		{
			viewBounds: {left: 0, top: 0, right: 0, bottom: 14},
			viewJustify: vjParentFullH + vjSiblingBottomV,
			text: first_2,
			valueChanged: func() begin
				self:AddWeek(kFirstWeek)
			end,
			_proto: @protoCheckbox
		},
		{
			viewBounds: {left: 0, top: 0, right: 0, bottom: 14},
			viewJustify: vjParentFullH + vjSiblingBottomV,
			viewValue: nil,
			text: second,
			valueChanged: func() begin
				self:AddWeek(kSecondWeek)
			end,
			_proto: @protoCheckbox
		},
		{
			viewBounds: {left: 0, top: 0, right: 0, bottom: 14},
			viewJustify: vjParentFullH + vjSiblingBottomV,
			viewValue: nil,
			text: third,
			valueChanged: func() begin
				self:AddWeek(kThirdWeek)
			end,
			_proto: @protoCheckbox
		},
		{
			viewBounds: {left: 0, top: 0, right: 0, bottom: 14},
			viewJustify: vjParentFullH + vjSiblingBottomV,
			viewValue: nil,
			text: fourth,
			valueChanged: func() begin
				self:AddWeek(kFourthWeek)
			end,
			_proto: @protoCheckbox
		},
		{
			viewBounds: {left: 0, top: 0, right: 0, bottom: 14},
			viewJustify: vjParentFullH + vjSiblingBottomV,
			viewValue: nil,
			text: last,
			valueChanged: func() begin
				self:AddWeek(kLastWeek)
			end,
			_proto: @protoCheckbox
		}
	]
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

valueChanged_code := same("WeekPicker.viewChildren[4].valueChanged.instructions");
