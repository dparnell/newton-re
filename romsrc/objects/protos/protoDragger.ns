// protoDragger, and what only it reaches

protoDragger := {
	_proto: @protoContainerView,
	viewFlags: vClickable,
	viewBounds: protoDraggerViewBounds,
	viewFormat: vfFillWhite + vfFrameDragShadow + vfPen(7) + vfInset(1) + vfRound(5),
	declareSelf: 'base,
	DragWindow: func(unit) begin
		local parent, l2;
		InkOff(unit);
		clicker();
		l2 := (if ((parent := self:Parent()) = GetRoot()) then RelBounds(displayParams.appAreaGlobalLeft, displayParams.appAreaGlobalTop, displayParams.appAreaWidth, displayParams.appAreaHeight) else parent:GlobalBox());
		if (if (if (not ViewContainsCaretView(self)) then CommandKeyboardConnected()) then (not RestoreKeyView(self))) then begin
				if self.defaultKeyViewName then begin
						SetKeyView(self.(defaultKeyViewName), 0)
					end else begin
						if (if self.textFlags then (BAnd(self.textFlags, 16384) <> 0)) then begin
								SetKeyView(self, 0)
							end
					end
			end;
		self:MoveBehind(nil);
		self:Drag(unit, l2);
		self:Dirty()
	end,
	viewClickScript: func(unit) begin
		local pt, pt2, box;
		(if (if (self = base) then (BAnd(viewFormat, 240) = 208)) then begin
				pt := GetPoint(0, unit);
				pt2 := GetPoint(1, unit);
				box := self:GlobalBox();
				(if (if ((pt2 - box.top) < 10) then (abs((pt - ((box.left + box.right) >> 1))) < 10)) then begin
						base:DragWindow(unit);
						true
					end)
			end)
	end,
	noScroll: "This application does not support scrolling",
	noOverview: "This application does not support Overview",
	beenThereDoneThat: nil,
	viewSetupFormScript: func() begin
		local box, displayParams2;
		(if (box := self:?GlobalBox()) then (if ((((((displayParams2 := displayParams).appAreaGlobalLeft + displayParams2.appAreaWidth) < box.right) or ((displayParams2.appAreaGlobalTop + displayParams2.appAreaHeight) < box.bottom)) or (displayParams2.appAreaGlobalLeft > box.left)) or (displayParams2.appAreaGlobalTop > box.top)) then RemoveSlot(self, 'viewBounds)))
	end,
	viewScrollUpScript: func() begin
		(if (not beenThereDoneThat) then begin
				beenThereDoneThat := true;
				self:Notify(3, "Up Arrow", noScroll)
			end)
	end,
	viewScrollDownScript: func() begin
		(if (not beenThereDoneThat) then begin
				beenThereDoneThat := true;
				self:Notify(3, "Down Arrow", noScroll)
			end)
	end,
	viewOverviewScript: func() begin
		self:Notify(3, "Overview", noOverview)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewScrollUpScript_code := same("protoDragger.viewScrollUpScript.instructions");
