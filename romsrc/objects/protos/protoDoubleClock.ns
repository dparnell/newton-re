// protoDoubleClock: an analog setting clock (protoNewSetClock) above a digital
// one (protoDigitalClock), both setting the same inherited `time`; each tells
// the other to Refresh when it changes the time and passes TimeChanged on to
// the client. And its two children.

protoDoubleClock := {
	viewFlags: vVisible,
	viewFormat: nil,
	viewBounds: {left: 2, top: 5, right: 130, bottom: 156},
	viewClass: clView,
	viewChildren: [viewChildren: analogClock_2, DigitalClock],
	analogClock: nil,
	allocateContext: [|Array|: 'analogClock, analogClock_2, 'DigitalClock, DigitalClock],
	DigitalClock: nil
};

analogClock_2 := {
	viewBounds: {left: 0, top: 0, right: 116, bottom: 116},
	viewJustify: vjParentCenterH,
	// TimeChanged: sent by protoNewSetClock after the user set the time - redraws
	// the digital clock and tells the double clock's client
	TimeChanged: func() begin
		DigitalClock:Refresh();
		self:Parent():?TimeChanged()
	end,
	preallocatedContext: 'analogClock,
	_proto: @protoNewSetClock
};

DigitalClock := {
	viewBounds: {left: 0, top: 123, right: 124, bottom: 151},
	viewJustify: vjParentCenterH,
	// TimeChanged: sent by protoDigitalClock after the user set the time - redraws
	// the analog clock and tells the double clock's client
	TimeChanged: func() begin
		analogClock:Refresh();
		self:Parent():?TimeChanged()
	end,
	preallocatedContext: 'DigitalClock,
	_proto: @protoDigitalClock
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

TimeChanged_code_2 := same("analogClock_2.TimeChanged.instructions");
