// protoValidateSlip, and what only it reaches

protoValidateSlip := {
	viewBounds: {left: 0, top: 0, right: 284, bottom: 270},
	viewJustify: vjParentCenterH + vjParentCenterV,
	extraHeight: 20,
	targetView: nil,
	titleText: nil,
	viewSetupChildrenScript: func() begin
		local dataDefs, l2, frame2, titleText2;
		l2 := 'symbol;
		targetView := self;
		if userText then begin
				infoText.text := userText
			end else begin
				infoText.viewFlags := 0
			end;
		if (if (not (titleText2 := titleText)) then (dataDefs := GetDataDefs(target.class))) then begin
				titleText2 := dataDefs:?StringExtract(target, 1)
			end;
		if (not titleText2) then begin
				titleText2 := target.name
			end;
		if titleText2 then begin
				headerText.title := titleText2
			end else begin
				headerText.viewFlags := 0
			end;
		if (kbdType = 'alpha) then begin
				frame2 := '{_proto: @alphaKeys, viewBounds: {left: 1, top: -130, right: 284, bottom: -20}, viewJustify: vjParentCenterH + vjParentBottomV};
				// DEVIATION: a slip made narrower than the keyboard (its
				//  viewSetupFormScript) has a keyboard its width
				if (viewBounds.right < frame2.viewBounds.right) then begin
						frame2 := {_proto: @alphaKeys, viewBounds: {left: 1, top: -130, right: viewBounds.right, bottom: -20}, viewJustify: vjParentCenterH + vjParentBottomV}
					end
			end else begin
				if (kbdType = 'number) then begin
						frame2 := '{_proto: @phonePad, viewBounds: {left: 0, top: -141, right: 151, bottom: -20}, viewJustify: vjParentCenterH + vjParentBottomV}
					end
			end;
		if frame2 then begin
				AddArraySlot(stepChildren, frame2);
				extraHeight := (((extraHeight + 10) + frame2.viewBounds.bottom) - frame2.viewBounds.top);
				AddArraySlot(stepChildren, '{_proto: @recToggle, viewBounds: {left: 2, top: -18, right: 20, bottom: -5}, viewJustify: 8388742, _recogPopup: [Array: recogText, recogInkText, pickseparator, recToggleSettings]})
			end;
		inherited:?viewSetupChildrenScript()
	end,
	viewSetupFormScript: func() begin
		local appAreaWidth;
		// DEVIATION: on a screen narrower than the slip (284: the T-Deck Pro's
		//  240), the slip as wide as the screen, not cut off at both sides - its
		//  header, text and fields are as wide as it is.  A MessagePad's screen
		//  is never so narrow.
		appAreaWidth := GetAppParams().appAreaWidth;
		if (appAreaWidth < (viewBounds.right - viewBounds.left)) then begin
				viewBounds := {left: 0, top: viewBounds.top, right: appAreaWidth, bottom: viewBounds.bottom}
			end;
		nil
	end,
	viewSetupDoneScript: func() begin
		local copy, childViewFrames, nextKeyView2, l4, appAreaHeight, box;
		appAreaHeight := GetAppParams().appAreaHeight;
		box := self:LocalBox();
		l4 := (Length((childViewFrames := self:ChildViewFrames())) - (if kbdType then 3 else 1));
		if (if kbdType then ((box.bottom - box.top) > appAreaHeight)) then begin
				RemoveStepView(self, childViewFrames[(l4 + 1)]);
				extraHeight := 20
			end;
		(copy := Clone(self.viewBounds)).bottom := ((childViewFrames[l4]:GlobalBox().bottom - self:GlobalBox().top) + extraHeight);
		SetValue(self, 'viewBounds, copy);
		inherited:?viewSetupDoneScript();
		(if (nextKeyView2 := NextKeyView(childViewFrames[0], 0, 0)) then SetKeyView(nextKeyView2, 0))
	end,
	StartFlush: func() begin
		(if base.viewCObject then base:SetupIdle(5000))
	end,
	viewIdleScript: func() begin
		self:EndFlush();
		nil
	end,
	viewQuitScript: func() begin
		'postQuit
	end,
	viewPostQuitScript: func() begin
		self:EndFlush()
	end,
	EndFlush: func() begin
		(if IsSoupEntry(target) then begin
				EntryChange(target);
				(if (target.class = 'owner) then UseCurrentPersona() else UseCurrentEmporium())
			end else (if self.isUserConfig then EntryChange(userConfiguration)))
	end,
	ReOrientToScreen: @defRotateFunc,
	viewChildren: [viewChildren:
		{
			buttonClickScript: func() begin
				local l1;
				local path;
				(foreach item in base:ChildViewFrames() do begin
						if (path := item.path) then begin
								if item.HasData then begin
										l1 := call item.HasData with (target)
									end else begin
										l1 := (if IsInstance(target.(path), 'string) then StrFilled(target.(path)) else target.(path))
									end;
								if (not l1) then begin
										break
									end
							end
					end);
				base:Close();
				(if compMsg then Perform(compView, compMsg, [Array: l1]))
			end,
			_proto: @protoCancelButton
		},
		headerText_2,
		infoText_2
	],
	headerText: nil,
	allocateContext: [|Array|: 'headerText, headerText_2, 'infoText, infoText_2],
	infoText: nil,
	_proto: @protoFloater
};

headerText_2 := {preallocatedContext: 'headerText, _proto: @protoTitle};

infoText_2 := {
	viewBounds: {left: 10, top: 5, right: -10, bottom: 30},
	viewJustify: vjParentFullH + vjSiblingBottomV,
	preallocatedContext: 'infoText,
	_proto: @protoStaticText
};
