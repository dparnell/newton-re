	end,
	// CancelRequest(why): asks the transport to stop; this default shows the
	// 'Canceling status
	CancelRequest: func(symbol2) begin
		self:SetStatus('Canceling, nil);
		nil
	end,
	// CheckOutBox(): sends the queued Out Box items, for the user
	CheckOutBox: func() begin
		GetRoot().(owner):StartSend(self, 'user, nil, nil)
	end,
	// the types of data the transport can send
	dataTypes: [|Array|: 'frame],
	// ResurrectStatusDialog(): the notify icon's action: reopens the status
	// slip if the transport is still busy
	ResurrectStatusDialog: func() begin
		self:CancelStatusNotify();
		userClosedStatus := nil;
		(if (if (status <> 'idle) then statusSetup) then self:UpdateStatusDialog(statusSetup))
	end,
	// DeleteRequest(request): deletes the request's item from the In/Out Box
	DeleteRequest: func(a1) begin
		GetRoot().(owner):ioDeleteScript(a1.target, a1.targetView)
	end,
	// GetStatusString(): the current status's message, or ""
	GetStatusString: func() begin
		local text;
		if ((text := dialogStatusMsgs.(status)) = nil) then begin
				text := ""
			end;
		text
	end,
	// the configuration a new user gets
	defaultConfiguration: @defaultConfiguration,
	// DeleteRemoteItems(): removes the In/Out Box's temporary (remote) items
	// of this transport
	DeleteRemoteItems: func() begin
		GetRoot().(owner):?RemoveTempItems(appSymbol)
	end,
	// ItemCommit(item): saves the item's changes in the In/Out Box
	ItemCommit: func(a1) begin
		GetRoot().(owner):Commit(a1)
	end,
	// MissingTarget(item): the routing slip has nothing to send; says so
	MissingTarget: func(a1) begin
		self:Notify(kNotifyAlert, title, "Nothing to Send")
	end,
	// GetItemType(item): what the item is called by its application
	// (appObject's singular), or "item"
	GetItemType: func(copy) begin
		local text, l2;
		text := "item";
		if (if copy then copy.appSymbol) then begin
				if (if (l2 := GetRoot().(copy.appSymbol)) then (l2:appObject exists)) then begin
						text := GetVariable(l2, 'appObject)[0]
