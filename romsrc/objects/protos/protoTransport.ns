			(if (a1 = 'emergencyPowerOn) then GetRoot().(appSym):CancelRequest(a1))
		end;
		RegPowerOn(appSymbol, powerOnCallback);
		powerOffCallback := func(a1, a2) begin
			if (a1 = 'okToPowerOff) then begin
					return GetRoot().(appSym):PowerOffCheck(a2)
