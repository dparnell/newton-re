			end;
		text
	end,
	// non-nil: the status slip is modal
	modalStatus: nil,
	// CheckOutBoxSilently(): sends the queued Out Box items without a status
	// slip
	CheckOutBoxSilently: func() begin
		GetRoot().(owner):StartSend(self, 'silent, nil, nil)
	end,
	// ItemCompleted(item, state, error): the transport is done with an item:
	// sets its state and error, restores a body saved aside, runs the item's
	// application's ItemCompletionScript if it asked for one (which may keep
	// the item from being saved), else reports the error and decides whether
	// to log a sent item (outboxLogging) or reopen the routing slip for an item
