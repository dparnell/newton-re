// protoTransport: the base of a transport - a way of sending and receiving
// In/Out Box items (beam, mail, print, fax, ...), registered with the In/Out
// Box (its owner, 'iobox). It holds the defaults a transport overrides or
// calls: its configuration (GetConfig/SetConfig, kept in the user
// configuration under appSymbol), the status slip (SetStatusDialog,
// protoStatusTemplate), the item queue (ItemRequest, QueueRequest),
// completing items (ItemCompleted), error handling (HandleError,
// TranslateError, ignoreError) and the item's title, info and state text.

protoTransport := {
	// IsInItem(item): whether the item is an In Box item (received, read or
	// logged in)
	IsInItem: func(target) begin
		return (((target.state = 'Received) or (target.state = 'Read)) or (target.state = 'InLog))
	end,
	// PowerOffCheck(why): asked when the Newton is about to be turned off while
	// the transport is busy; unless idle, asks the user to confirm
	PowerOffCheck: func(a1) begin
		(if (a1 = 'idle) then nil else ModalConfirm(ParamStr("Are you sure you want to turn off the power while ^0 is active?", [Array: title]), 'okCancelDefaultCancel))
	end,
	// HandleError(error): remembers the error and shows its message (from
	// TranslateError) in an alert, unless it is one to ignore
	HandleError: func(error) begin
		local translateError;
		lastError := error;
		(if (translateError := self:TranslateError(error)) then self:Notify(kNotifyAlert, title, translateError))
	end,
	// ItemRequest(request): the next item to send for a request - its item,
	// the next entry of its cursor, or, when those are used up, the next of its
	// queued requests (requestQueue). An item with a format is resolved by the
	// format's ResolveItem; one that needs resolving and cannot be is skipped
	// with an alert. Returns the item (also left in currentItem), or nil
	ItemRequest: func(request) begin
		local item, l2, requestQueueItem, currentFormat;
		item := nil;
		(loop begin
				l2 := nil;
				if request.item then begin
						item := request.item;
						request.item := nil
					end else begin
						if request.cursor then begin
								if (item := request.cursor:entry()) then begin
										request.cursor:Next()
									end
							end
					end;
				if (if (if (not item) then request.requestQueue) then (Length(request.requestQueue) > 0)) then begin
						requestQueueItem := request.requestQueue[0];
						request.cause := requestQueueItem.cause;
						if (if ((item := requestQueueItem.item) = nil) then requestQueueItem.cursor) then begin
								request.cursor := requestQueueItem.cursor;
								if (item := request.cursor:entry()) then begin
										request.cursor:Next()
									end
							end;
						SetRemove(request.requestQueue, requestQueueItem);
						l2 := (Length(request.requestQueue) > 0)
					end;
				if (if (if item then IsFrame(item)) then item.currentFormat) then begin
						l2 := true;
						if (if (currentFormat := GetCurrentFormat(item)) then currentFormat.ResolveItem) then begin
								item := currentFormat:ResolveItem(item)
							end else begin
								if (if item.needsResolve then item.body) then begin
										self:Notify(kNotifyAlert, "Routing", "This item cannot be sent because the proper format cannot be found. Please make sure both the format and the original application are installed before sending.");
										item := nil
									end
							end
					end;
				if IsFrame(item) then begin
						break
					end else begin
						if item then begin
								l2 := true
							end
					end;
				(if (not l2) then break)
			end);
		currentItem := item;
		item
	end,
	// the icon shown beside an item with an error
	errorIcon: {
		mask: bitmap('mask, "resources/mask/47f9c1.png", "0000000000040086008602110092021e", 1),
		bits: bitmap('bits, "resources/bits/47fa0d.png", "0000000000040086008602110092021e", 1),
		bounds: {left: 0, top: 0, right: 13, bottom: 12}
	},
	// ItemChanged(item): the item's fields changed; tells the In/Out Box
	itemchanged: func(fields) begin
		GetRoot().(owner):itemchanged(fields, true)
	end,
	// DeleteItem(item): completes the item with no new state, as the In/Out
	// Box's ItemCompleted does
	deleteItem: func(a1) begin
		(if a1 then GetRoot().(owner):?ItemCompleted(a1, nil))
	end,
	// GetItemInfo(item, width, font): the item's second line in the In/Out Box:
	// who it is from (an In Box item) or to (GetFromText/GetToText, the
	// addressing class's routing title, or the item's name), truncated to fit
	// before the item's time, or "Unaddressed"
	GetItemInfo: func(target, a2, a3) begin
		local fromText, itemTime, dataDefs, l4;
		itemTime := self:GetItemTime(target);
		a2 := (a2 - StrFontWidth(Stringer([Array: " ", itemTime]), a3));
		if self:IsInItem(target) then begin
				fromText := self:?GetFromText(target)
			end else begin
				fromText := self:?GetToText(target)
			end;
		if fromText then begin
				fromText := StyledStrTruncate(Clone(fromText), a2, a3)
			end else begin
				if (dataDefs := GetDataDefs(addressingClass)) then begin
						fromText := dataDefs:GetRoutingTitle((l4 := (if self:IsInItem(target) then target.fromRef else target.toRef)), a2, a3)
					end
			end;
		if (not fromText) then begin
				fromText := (if self:IsInItem(target) then target.fromName else target.name)
			end;
		if (not fromText) then begin
				fromText := "Unaddressed"
			end;
		(if StrFilled(fromText) then Stringer([Array: fromText, " ", itemTime]) else itemTime)
	end,
	// the open status slip, if any
	statusDialog: nil,
	// the application that manages the items, the In/Out Box
	owner: 'iobox,
	// the transport's state ('idle when not busy); its message is
	// dialogStatusMsgs.(status)
	status: 'idle,
	// GetConfig(slot): a setting of the transport's configuration, which is
	// made from defaultConfiguration the first time
	GetConfig: func(a1) begin
		local userConfig;
		if ((userConfig := GetUserConfig(appSymbol)) = nil) then begin
				userConfig := SetUserConfig(appSymbol, EnsureInternal(Clone(defaultConfiguration)));
				FlushUserConfig()
			end;
		userConfig.(a1)
	end,
	// ItemCount(request): how many items a request has (1, or its cursor's
	// entries)
	ItemCount: func(a1) begin
		local count;
		count := 0;
		if a1.item then begin
				count := 1
			end else begin
				if a1.cursor then begin
						if IsArray(a1.cursor) then begin
								count := Length(a1.cursor)
							end else begin
								count := a1.cursor:CountEntries()
							end
					end
			end;
		return count
	end,
	// UpdateStatusSlots(status, configuration, values): sets the status
	// (starting I/O with BeginIO when it leaves 'idle and ending it with EndIO
	// when it comes back), and returns the setup frame for the status slip -
	// {name: the configuration (default 'vStatus), appSymbol, values} with a
	// statusText - merging the values into statusSetup
	UpdateStatusSlots: func(status2, a2, frame4) begin
		if (status = nil) then begin
				status := 'idle
			end;
		if (status2 = nil) then begin
				status2 := status
			end;
		if (if (status = 'idle) then (status2 <> 'idle)) then begin
				userClosedStatus := nil;
				self:BeginIO()
			end else begin
				if (if (status <> 'idle) then (status2 = 'idle)) then begin
						self:EndIO();
						userClosedStatus := nil
					end
			end;
		status := EnsureInternal(status2);
		if (frame4 <> nil) then begin
				if IsFrame(frame4) then begin
						frame2 := frame4
					end else begin
						if IsString(frame4) then begin
								frame2 := {statusText: frame4}
							end else begin
								frame2 := {}
							end
					end
			end else begin
				frame2 := {}
			end;
		if (not HasSlot(frame2, 'statusText)) then begin
				frame2.statusText := self:GetStatusString()
			end;
		if (a2 = nil) then begin
				if ((statusSetup = nil) or (statusSetup.name = nil)) then begin
						a2 := 'vStatus
					end else begin
						a2 := statusSetup.name
					end
			end;
		frame3 := {name: a2, appSymbol: appSymbol, values: frame2};
		if (statusSetup = nil) then begin
				statusSetup := frame3
			end else begin
				if (statusSetup.name <> a2) then begin
						statusSetup.values := frame2;
						statusSetup.name := a2
					end else begin
						if frame2 then begin
								// (the decompiler puts these declarations after the uses: only layout)
								local frame2;
								local frame3;
								(foreach key, value in frame2 do begin
										statusSetup.values.(key) := value
									end)
							end
					end
			end;
		return frame3
	end,
	// the status messages, by status symbol
	dialogStatusMsgs: @defaultStatusMsgs,
	// QueueRequest(transport, request): adds a request to a transport's queue
	// (a symbol is a function name to call on this transport); returns it
	QueueRequest: func(request, request2) begin
		if IsSymbol(request) then begin
				request2.function := request;
				request := GetRoot().(appSymbol)
			end;
		if request then begin
				if request.requestQueue then begin
						AddArraySlot(request.requestQueue, request2)
					end else begin
						request.requestQueue := [Array: request2]
					end
			end;
		request2
	end,
	// requests waiting for the transport to be idle (EndIO starts the next)
	requestQueue: nil,
	// the word for what the transport does, shown in the routing slip
	actionTitle: send,
	// HandleThrow(): in an onexception handler: takes the exception's error
	// code (-1 if it has none) and, unless it is one to ignore, completes the
	// current item with it or shows it; returns whether it was not ignored
	HandleThrow: func() begin
		local ex, error, l3;
		ex := CurrentException();
		error := 0;
		if HasSlot(ex, 'error) then begin
				error := ex.error
			end else begin
				if HasSlot(ex.data, 'errorCode) then begin
						error := ex.data.errorCode
					end else begin
						error := -1
					end
			end;
		if (l3 := (not self:ignoreError(error))) then begin
				if self.currentItem then begin
						self:ItemCompleted(currentItem, nil, error)
					end else begin
						self:HandleError(error)
					end
			end;
		l3
	end,
	// NewFromItem(item): a new item copying another's slots, except
	// fromItemSlotsToPunt and the folder; an item for another application is
	// addressed to it
	NewFromItem: func(a1) begin
		item := self:NewItem(nil);
		// (the decompiler puts this declaration after the use: only layout)
		local item;
		(foreach key, value in a1 do begin
				if (not SetContains(fromItemSlotsToPunt, key)) then begin
						item.(key) := value
					end;
				item.labels := nil
			end);
		if a1.destAppSymbol then begin
				item.fromAppSymbol := a1.appSymbol;
				item.appSymbol := a1.destAppSymbol
			end;
		item
	end,
	// the transport is not a view, but has view slots for the routing slip
	viewFlags: 0,
	// CloseStatusDialog(userClosed): closes the status slip, leaving a notify
	// icon action to reopen it while the transport is busy
	CloseStatusDialog: func(a1) begin
		if statusDialog then begin
				statusDialog:Close();
				if (if (status <> 'idle) then (not manualStatus)) then begin
						self:StatusNotify()
					end
			end;
		statusDialog := nil;
		lastError := nil;
		(userClosedStatus := a1)
	end,
	// GetItemTitle(item): the item's title - its title slot, the data def's
	// title of its target, the target's title, "Selected Items" for several,
	// or "Untitled <type>"
	GetItemTitle: func(a1) begin
		local text, l2, targetFromEntry, dataDefs, stringExtract;
		text := "Untitled";
		if a1 then begin
				text := nil;
				if IsString(a1.title) then begin
						text := a1.title
					end else begin
						if (dataDefs := GetDataDefs(DataClassOf((targetFromEntry := GetTargetFromEntry(a1))))) then begin
								if (stringExtract := dataDefs:?StringExtract(targetFromEntry, 1)) then begin
										text := stringExtract
									end
							end;
						if (if (if (not text) then IsFrame(targetFromEntry)) then StrFilled(targetFromEntry.title)) then begin
								text := Clone(targetFromEntry.title)
							end
					end;
				if (text = nil) then begin
						if TargetIsCursor(a1.body) then begin
								text := "Selected Items"
							end else begin
								text := ParamStr("Untitled ^0", [Array: self:GetItemType(a1)])
							end
					end
			end;
		text
	end,
	// CancelStatusNotify(): removes the notify icon's action
	CancelStatusNotify: func() begin
		(if activeNotify then begin
				GetRoot().notifyIcon:KillAction(activeNotify);
				(activeNotify := nil)
			end)
	end,
	// the items' state texts, by state
	itemStateMsgs: @defaultItemStateMsgs,
	// ItemPutAway(item): for a transport that puts away received items
	// itself; this default does nothing
	ItemPutAway: func(a1) begin
		nil
	end,
	// ConnectionDetect(): whether to send now or later (the 'noworlater
	// setting)
	ConnectionDetect: func() begin
		return self:GetConfig('noworlater)
	end,
	// the item being sent or received
	currentItem: nil,
	// IsLogItem(item): whether the item is a log entry
	IsLogItem: func(fields) begin
		return ((fields.state = 'InLog) or (fields.state = 'OutLog))
	end,
	// the status slip's template
	statusTemplate: @protoStatusTemplate,
	// GetDefaultOwnerStore(): the In/Out Box's default store, or the internal
	// store if that is read-only
	GetDefaultOwnerStore: func() begin
		local l1;
		(if (l1 := GetRoot().(owner):GetDefaultAppStore()):IsReadOnly() then GetStores()[0] else l1)
	end,
	// non-nil when the user closed the status slip (it is not reopened)
	userClosedStatus: nil,
	// GetFolderName(item): the folder an item is filed in, from the inbox or
	// outbox filing setting ('same: the item's own labels)
	GetFolderName: func(target) begin
		local config;
		if ((config := self:GetConfig((if self:IsInItem(target) then 'inboxFiling else 'outboxFiling))) = 'same) then begin
				config := target.labels
			end;
		return config
	end,
	// StatusNotify(): adds an action to the notify icon that reopens the status
	// slip (ResurrectStatusDialog), once
	StatusNotify: compile(
		constants: {
			kFunction_47f521: func(a1) begin
				GetRoot().(a1):ResurrectStatusDialog()
			end
		},
		func() begin
			(if (activeNotify = nil) then (activeNotify := GetRoot().notifyIcon:AddAction(title, kFunction_47f521, [Array: appSymbol])))
		end),
	// GetTitleInfoShape(item, box): the shapes of an item's line in the In/Out
	// Box: the title and state in bold 10-point, the info below in 9-point
	GetTitleInfoShape: func(target, box) begin
		local l1, itemTitle, itemInfo, itemStateString, strFontWidth2;
		l1 := ((box.right - box.left) - 10);
		itemTitle := self:GetItemTitle(target);
		itemInfo := self:GetItemInfo(target, l1, tsSystem + tsSize(9));
		strFontWidth2 := StrFontWidth((itemStateString := self:GetItemStateString(target)), tsSystem + tsSize(10) + tsBold);
		itemTitle := StyledStrTruncate(Clone(itemTitle), (l1 - (strFontWidth2 + 10)), tsSystem + tsSize(10) + tsBold);
		(shapes := [Array: {font: tsSystem + tsSize(10) + tsBold}, MakeText(itemTitle, box.left, box.top, (box.right - strFontWidth2), (box.top + 11)), MakeText(itemStateString, (box.right - strFontWidth2), box.top, box.right, (box.top + 11)), {font: tsSystem + tsSize(9)}, MakeText(itemInfo, (box.left + 10), box.top, box.right, (box.bottom - 4))])
	end,
	// TranslateError(error): the message for an error - from errorTable, or
	// "Error <n> encountered"; nil for an error to ignore. (tableLookup2 is set
	// nil just before it is tested for nil: the first test is always true)
	TranslateError: func(error) begin
		local tableLookup2;
		tableLookup2 := nil;
		if (not self:?ignoreError(error)) then begin
				if (tableLookup2 = nil) then begin
						tableLookup2 := TableLookup(@errorTable, error)
					end;
				if (tableLookup2 = nil) then begin
						tableLookup2 := ParamStr("Error ^0 encountered", [Array: NumberStr(error)])
					end
			end;
		tableLookup2
	end,
	// the data class of the transport's addresses
	addressingClass: '|nameRef.email|,
	// ItemSubmit(item): hands a new item to the In/Out Box to send
	ItemSubmit: func(fields) begin
		GetRoot().(owner):submit(fields)
	end,
	// InstallScript(partFrame): called when the transport is installed;
	// nothing by default
	InstallScript: func(partFrame) begin
		nil
	end,
	// the transport's group of items (an item's category is its transport)
	category: nil,
	// the transport's symbol, under which it is registered and configured
	appSymbol: nil,
	// SetConfig(slot, value): changes a setting of the transport's
	// configuration
	SetConfig: func(a1, a2) begin
		local userConfig;
		if ((userConfig := GetUserConfig(appSymbol)) = nil) then begin
				userConfig := EnsureInternal(Clone(defaultConfiguration))
			end;
		userConfig.(EnsureInternal(a1)) := EnsureInternal(a2);
		SetUserConfig(appSymbol, userConfig)
	end,
	// the transport's icon and title
	icon: @routeTransport,
	title: transport,
	// BeginIO(): the transport becomes busy: registers to be told of power on
	// (an emergency power-on cancels the request) and power off (asks
	// PowerOffCheck, cancels the request at power off - 'holdYourHorses
	// delays it while the cancel is under way), adds the notify action unless
	// the status is managed by hand, and tells the In/Out Box
	BeginIO: func() begin
		local appSym;
		appSym := EnsureInternal(appSymbol);
