									end onexception |evt.ex| do begin
										self:Notify(kNotifyAlert, title, "Error in completionScript")
									end;
								if itemCompletionScript then begin
										l1 := nil
									end
							end else begin
								a1.completionscript := nil
							end
					end;
				if (not a1.completionscript) then begin
						if (not self:ignoreError(a1.error)) then begin
								self:HandleError(a1.error)
							end;
						if (a1.state = 'Sent) then begin
								l1 := (if (not a1.covert) then self:GetConfig('outboxLogging))
							end else begin
								if (if (a1.state = 'ready) then a1.Connect) then begin
										l1 := nil;
