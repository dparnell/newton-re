	// the notify icon's action, while there is one
	activeNotify: nil,
	// GetItemStateString(item): the text of an item's state ("error" for an
	// error to report, "Remote" for a remote item)
	GetItemStateString: func(target) begin
		local text, state;
		if (not self:ignoreError(target.error)) then begin
				return itemStateMsgs.error
			end;
		state := target.state;
		if target.Remote then begin
				state := 'Remote
			end;
