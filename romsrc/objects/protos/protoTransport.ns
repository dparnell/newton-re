			end;
		if (text = nil) then begin
				text := ""
			end;
		text
	end,
	// the slots NewFromItem does not copy
	fromItemSlotsToPunt: [|Array|:
		'category,
		'Connect,
		'completionscript,
		'_saveBodyAlias,
		'sentTimeStamp,
		'Remote,
		'_newFolder
	],
	// non-nil: the transport opens and closes the status slip itself
	manualStatus: nil,
	itemLabel: 'transport,
	// EndIO(): the transport is idle again: tells the In/Out Box, removes the
	// notify action and the power callbacks, and starts the next queued request
	EndIO: func() begin
		local requestQueueItem;
		GetRoot().(owner):?DeactivateTransport(self);
		self:CancelStatusNotify();
		UnRegPowerOn(appSymbol);
		UnRegPowerOff(appSymbol);
		(if (if requestQueue then (Length(requestQueue) > 0)) then begin
				requestQueueItem := requestQueue[0];
				SetRemove(requestQueue, requestQueueItem);
				AddDeferredSend(self, requestQueueItem.function, [Array: requestQueueItem])
			end)
	end,
	// (viewClass 64 is none of the view classes in constants.tsv)
	viewClass: 64,
	// RefreshOwner(): redraws the In/Out Box
	RefreshOwner: func() begin
		GetRoot().(owner):?Refresh()
	end,
	// UpdateStatusDialog(setup): shows the status slip with this setup, making
	// and opening it (modal with modalStatus) if it is not open
	UpdateStatusDialog: func(updateStatusSlots) begin
		lastError := nil;
		if (if statusDialog then statusDialog.viewCObject) then begin
				statusDialog:viewSet(updateStatusSlots)
			end else begin
				if (statusDialog = nil) then begin
						if (not HasSlot(GetRoot(), 'stepChildren)) then begin
								GetRoot().stepChildren := Clone(GetRoot().stepChildren)
							end;
						statusDialog := BuildContext(statusTemplate);
						statusDialog:viewSet(updateStatusSlots);
						if modalStatus then begin
								statusDialog:FilterDialog()
							end else begin
								statusDialog:Open()
							end
					end
			end;
		self:CancelStatusNotify()
	end,
	// IgnoreError(error): whether an error is not worth reporting - none, or a
	// cancellation (request canceled, connection aborted, call aborted, IR
	// cancel, printing stopped)
	ignoreError: func(error) begin
		(((((((error = nil) or (error = 0)) or (error = kCommErrRequestCanceled)) or (error = kCommErrConnectionAborted)) or (error = kError_Call_Aborted)) or (error = kIRErrCancel)) or (error = kPR_ERR_UserCancel))
	end,
	// the last error reported
	lastError: nil,
	debug: 723740,
	// MakeLogEntry(entry, item): fills in a log entry for an item: its title
	// and sent time
	MakeLogEntry: func(next, next2) begin
		next.title := self:GetItemTitle(next2);
		(if HasSlot(next2, 'sentTimeStamp) then (next.sentTimeStamp := next2.sentTimeStamp))
	end,
	// NewItem(context): a new item of this transport from the In/Out Box's
	// default, for the application of the context view if one is given
	NewItem: func(viewfrontmostapp) begin
		local l1;
		(l1 := GetRoot().(owner):GetDefaultItem()).category := GetVariable(self, 'appSymbol);
		if viewfrontmostapp then begin
				l1.appSymbol := GetVariable(viewfrontmostapp, 'appSymbol)
			end;
		l1
	end,
	// the routing information view and the preferences slip
	transportInfoForm: @protoTransportheader,
	preferencesForm: @protoTransportPrefs,
	// GetNameText(address, width, font): an address's routing title, from the
	// addressing class's data def
	GetNameText: func(a1, a2, a3) begin
		local dataDefs;
		(if (dataDefs := GetDataDefs(addressingClass)) then (text := dataDefs:GetRoutingTitle(a1, a2, a3)))
	end,
	// the status slip's current setup
	statusSetup: nil,
	// NormalizeAddress(address): an e-mail address in the form this transport
	// wants: kept if its class is one of addressSymbols, else completed by
	// translate's (or the internet's) entry for its class - a function, or a
	// suffix added if missing
	normalizeAddress: func(value) begin
		local email, cls, l3;
		if (not IsString((email := GetDataDefs('|nameRef.email|):Get(value, 'email, nil)))) then begin
				return email
			end;
		cls := ClassOf(email);
		if (if IsArray(addressSymbols) then LSearch(addressSymbols, cls, 0, '|=|, nil)) then begin
				return email
			end;
		if (not (l3 := (if IsFrame(translate) then translate.(cls)))) then begin
				l3 := EmailSystems.emailInternet.(cls)
			end;
		if l3 then begin
				if IsFunction(l3) then begin
						email := call l3 with (email)
					end else begin
						if (not StrPos(email, l3, 0)) then begin
								email := Stringer([Array: email, l3])
							end
					end
			end;
		email
	end,
	// GetItemTime(item): the item's date and time, for its line
	GetItemTime: func(target) begin
		Stringer([Array: ShortDate(target.timestamp), " ", HourMinute(target.timestamp)])
	end,
	// by address class, how NormalizeAddress makes an address this transport's
	translate: nil,
	// SetStatusDialog(status, configuration, values): sets the status and
	// shows, updates or closes the status slip as autoStatus, manualStatus and
	// the user's closing it say
	SetStatusDialog: func(status2, a2, frame2) begin
		local updateStatusSlots, l2, l3, l4;
		updateStatusSlots := self:UpdateStatusSlots(status2, a2, frame2);
		l2 := (if statusDialog then statusDialog.viewCObject);
		l3 := (if self:GetConfig('autoStatus) then (not manualStatus));
		l4 := (status = 'idle);
		(if (if (if (if l3 then (not l2)) then (not l4)) then (not userClosedStatus)) then self:UpdateStatusDialog(updateStatusSlots) else (if (if (if (not manualStatus) then l2) then l4) then self:CloseStatusDialog(nil) else (if (l2 or (if manualStatus then (not userClosedStatus))) then self:UpdateStatusDialog(updateStatusSlots))))
	end,
	// the routing slip's template
	routingSlip: @protoFullRouteSlip,
	// SetStatus(status, values): SetStatusDialog with the current configuration
	SetStatus: func(text, frame2) begin
		self:SetStatusDialog(text, nil, frame2)
	end,
	// UpdateItem(item): the item changed; tells the In/Out Box
	UpdateItem: func(a1) begin
		GetRoot().(owner):itemchanged(a1, true)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

CheckOutBox_code := same("protoTransport.CheckOutBox.instructions");

itemchanged_code := same("protoTransport.itemchanged.instructions");
