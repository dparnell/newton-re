// protoStateMachineInputSpec, and what only it reaches

protoStateMachineInputSpec := {
	async: true,
	reqTimeout: 200000,
	completionscript: func(a1, a2, a3) begin
		local stateMachine;
		(stateMachine := a1.stateMachine).fOptionsIn := a2;
		stateMachine:AsyncWaitComplete(a3)
	end,
	form: '|string|,
	InputScript: func(a1, a2, a3, a4) begin
		local stateMachine;
		(stateMachine := a1.stateMachine).fIncomingData := a2;
		stateMachine.fOptionsIn := a4;
		stateMachine.fTerminatorIn := a3;
		stateMachine:AsyncWaitComplete(nil)
	end
};
