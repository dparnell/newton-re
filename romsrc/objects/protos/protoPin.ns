// protoPin: the PIN pad that checks and changes the owner's password: a
// prompt, a line of bullets and a numeric keypad, run as a small state
// machine (state): 'getpassword checks a PIN against the stored key,
// 'changePassword asks for the old PIN, 'SetPassword for a new one and
// 'verifyPassword for it again; 'InActive ignores the keys. Success is
// reported by passwordPasses or passwordChanged(key), which the view built
// on it supplies. PINs are kept only as DES password keys.

protoPin := {
	viewClass: clView,
	viewBounds: {left: 0, top: 0, right: 100, bottom: 135},
	viewFlags: vVisible,
	viewFormat: vfFillWhite + vfFrameBlack + vfPen(2) + vfRound(2),
	viewJustify: 0,
	viewTransferMode: modeXor,
	// the key a PIN is checked against (the user configuration's
	// passwordkey unless given), the prompt for 'getpassword (else
	// "Enter PIN"), and the state
	passwordkey: nil,
	prompt: nil,
	state: nil,
	// the digits typed and how many
	pin: uCardPositionAlertButton,
	numKeys: 0,
	// the new PIN's key between 'SetPassword and 'verifyPassword
	tempPassword: nil,
	// on opening: close the correction slip if it is open, take the stored
	// password key, and start asking for the PIN unless a state is given
	viewSetupFormScript: func() begin
		local correct;
		if (correct := GetRoot().correct).viewCObject then begin
				correct:Close()
			end;
		if (not passwordkey) then begin
				passwordkey := GetUserConfig('passwordkey)
			end;
		(if (not state) then self:ChangeState('getpassword))
	end,
	// on closing: forget the digits. Looks like a ROM bug: tempString is no
	// slot of this proto - tempPassword, the new PIN's key, was probably
	// meant; this adds a tempString slot instead and leaves tempPassword
	// set (harmless while the view's frame goes with the view)
	viewQuitScript: func() begin
		pin := nil;
		(tempString := nil)
	end,
	// clears the digits and the bullets
	ResetDisplay: func() begin
		pin := "";
		if PINDisplay then begin
				SetValue(PINDisplay, 'text, "")
			end;
		(numKeys := 0)
	end,
	// moves to state a1, clearing the digits and showing its prompt; refused
	// (nil) while digits of a PIN being checked are typed
	ChangeState: func(a1) begin
		local prompt2;
		if (not state) then begin
				state := a1
			end;
		if (if (numKeys <> 0) then (state = 'getpassword)) then begin
				return nil
			end;
		state := a1;
		self:ResetDisplay();
		if (state = 'getpassword) then begin
				if prompt then begin
						prompt2 := prompt
					end else begin
						prompt2 := "Enter PIN"
					end
			end else begin
				if (state = 'SetPassword) then begin
						prompt2 := "Enter new PIN"
					end else begin
						if (state = 'changePassword) then begin
								prompt2 := "Enter old PIN"
							end else begin
								if (state = 'verifyPassword) then begin
										prompt2 := "Confirm new PIN"
									end else begin
										if (if (state = 'InActive) then promptLine) then begin
												prompt2 := ""
											end
									end
							end
					end
			end;
		SetValue(promptLine, 'text, prompt2)
	end,
	// whether the digits typed are the PIN (their key equals passwordkey)
	CheckPassword: func() begin
		(if BinEqual(DESCreatePasswordKey(pin), passwordkey) then return true else return nil)
	end,
	// the keypad's ent key: act on the PIN typed as the state says - pass,
	// go on to the next step, or say it was wrong and start again
	FinishedPIN: compile(
		constants: {
			kLiteral_5b554d: "Security"
		},
		func() begin
			local dESCreatePasswordKey2;
			(if (state = 'getpassword) then (if self:CheckPassword() then self:passwordPasses() else begin
						self:Notify(kNotifyAlert, kLiteral_5b554d, "An incorrect PIN has been entered. Please try again.");
						self:ResetDisplay()
					end) else (if (state = 'changePassword) then (if self:CheckPassword() then self:ChangeState('SetPassword) else begin
							self:Notify(kNotifyAlert, kLiteral_5b554d, "An incorrect PIN has been entered. Please try again.");
							self:ResetDisplay()
						end) else (if (state = 'SetPassword) then begin
							tempPassword := DESCreatePasswordKey(pin);
							self:ChangeState('verifyPassword)
						end else (if (state = 'verifyPassword) then (if BinEqual((dESCreatePasswordKey2 := DESCreatePasswordKey(pin)), tempPassword) then self:passwordChanged(dESCreatePasswordKey2) else begin
									self:Notify(kNotifyAlert, kLiteral_5b554d, "New PIN's do not match. Please try again.");
									self:ChangeState('SetPassword)
								end)))))
		end),
	viewChildren: [viewChildren: promptLine, PINDisplay, PINKeyPad],
	promptLine: nil,
	allocateContext: [|Array|: 'promptLine, promptLine, 'PINDisplay, PINDisplay, 'PINKeyPad, PINKeyPad],
	PINDisplay: nil,
	PINKeyPad: nil
};

// the prompt (ChangeState sets it)
promptLine := {
	viewBounds: {left: 5, top: 0, right: -5, bottom: 14},
	viewJustify: vjCenterH + vjParentFullH,
	viewFont: tsSystem + tsSize(10) + tsBold,
	viewTransferMode: modeXor,
	text: uCardPositionAlertButton,
	preallocatedContext: 'promptLine,
	_proto: @protoStaticText
};

// the line of bullets, one per digit; the key view, so that a keyboard's
// keys reach the pad
PINDisplay := {
	viewFlags: vVisible,
	textFlags: 1024,
	viewBounds: {left: 5, top: 18, right: -5, bottom: 32},
	viewFormat: 0,
	viewJustify: oneLineOnly + vjParentFullH + vjCenterH + vjCenterV,
	viewFont: tsFancy + tsSize(18),
	viewTransferMode: modeXor,
	text: uCardPositionAlertButton,
	// once open: take the keys, without showing a caret
	viewSetupDoneScript: func() begin
		SetKeyView(self, 0);
		HideCaret()
	end,
	// Closed: the caret shown again.
	viewQuitScript: func() begin
		ShowCaret()
	end,
	// a key typed: a digit is typed on the keypad, Return or Enter is the
	// ent key, Backspace the del key; true: the key is taken
	viewKeyDownScript: func(char2, flags) begin
		if (if (char2 >= $0) then (char2 <= $9)) then begin
				PINKeyPad:keyPressScript(char2)
			end;
		if ((char2 = $\n) or (char2 = $\03)) then begin
				PINKeyPad:keyPressScript($E)
			end;
		if (char2 = $\08) then begin
				PINKeyPad:keyPressScript($<)
			end;
		true
	end,
	preallocatedContext: 'PINDisplay,
	_proto: @protoStaticText
};

// the keypad: rows of [row height, tallest key (8, keyVUnit), then legend,
// result, descriptor per key]; 279971848 is keyAutoHilite + keyFramed + 3 *
// keyRoundingUnit + keyHUnit + keyVUnit (NPR 7-9)
PINKeyPad := {
	keyDefinitions: [|Array|:
		[|Array|: 8, 8, $1, $1, 279971848, $2, $2, 279971848, $3, $3, 279971848],
		[|Array|: 8, 8, $4, $4, 279971848, $5, $5, 279971848, $6, $6, 279971848],
		[|Array|: 8, 8, $7, $7, 279971848, $8, $8, 279971848, $9, $9, 279971848],
		[|Array|: 8, 8, del, $<, 279971848, $0, $0, 279971848, ent, $E, 279971848]
	],
	viewBounds: {left: 5, top: 40, right: -5, bottom: 0},
	viewJustify: vjParentFullH + vjParentFullV,
	// a key (char2) pressed, with a click (ignored in the 'InActive state):
	// $< takes off the last digit, $E with digits typed finishes the PIN
	// (FinishedPIN), any other key adds its digit and a bullet
	keyPressScript: func(char2) begin
		playsound(@click);
		if ((if (char2 = $<) then (numKeys = 0)) or (state = 'InActive)) then begin
				return nil
			end;
		(if (if (char2 = $<) then (numKeys > 0)) then begin
				numKeys := (numKeys - 1);
				if PINDisplay then begin
						SetValue(PINDisplay, 'text, Substr(PINDisplay.text, 0, numKeys))
					end;
				(pin := Substr(pin, 0, numKeys))
			end else (if (if (char2 = $E) then (numKeys > 0)) then self:Parent():FinishedPIN() else (if (if (char2 <> $E) then (char2 <> $<)) then begin
						pin := Stringer([Array: pin, char2]);
						numKeys := (numKeys + 1);
						(if PINDisplay then SetValue(PINDisplay, 'text, Stringer([Array: PINDisplay.text, $\u2022])))
					end)))
	end,
	preallocatedContext: 'PINKeyPad,
	_proto: @protoKeypad
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

viewSetupDoneScript_code_20 := same("PINDisplay.viewSetupDoneScript.instructions");
