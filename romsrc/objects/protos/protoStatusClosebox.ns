						buttonClickScript := l2
					end;
				(if l2 then (visibleAction := 'makeVisible) else (visibleAction := 'makeInvisible))
			end)
	end,
	viewSetupDoneScript: func() begin
		(if visibleAction then (if (visibleAction = 'makeVisible) then self:Show() else self:Hide()))
	end,
	viewUpdateFormScript: func() begin
		self:viewSetupFormScript();
		self:viewSetupDoneScript()
	end,
	_proto: @protoCancelButton
};

