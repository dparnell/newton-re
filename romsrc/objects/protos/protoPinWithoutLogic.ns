// protoPinWithoutLogic, and what only it reaches

protoPinWithoutLogic := {
	viewClass: clView,
	viewBounds: {left: 0, top: 0, right: 100, bottom: 135},
	viewFlags: vVisible,
	viewFormat: vfFillWhite + vfFrameBlack + vfPen(2) + vfRound(2),
	viewJustify: 0,
	viewTransferMode: 2,
	numKeys: 0,
	pin: nil,
	viewSetupFormScript: func() begin
		local l1;
		(if (l1 := GetRoot().correct).viewCObject then l1:Close())
	end,
	viewQuitScript: func() begin
		(if StrFilled(pin) then (newPinKey := DESCreatePasswordKey(pin)))
	end,
	viewChildren: [viewChildren: promptLine_2, PINDisplay_2, PINKeyPad_2],
	promptLine: nil,
	allocateContext: [|Array|: 'promptLine, promptLine_2, 'PINDisplay, PINDisplay_2, 'PINKeyPad, PINKeyPad_2],
	PINDisplay: nil,
	PINKeyPad: nil
};

promptLine_2 := {
	viewBounds: {left: 2, top: 0, right: -5, bottom: 14},
	viewJustify: vjCenterH + vjParentFullH,
	viewFont: tsSystem + tsSize(10) + tsBold,
	viewTransferMode: 2,
	viewSetupFormScript: func() begin
		(text := promptText)
	end,
	preallocatedContext: 'promptLine,
	_proto: @protoStaticText
};

PINDisplay_2 := {
	viewFlags: vVisible,
	textFlags: 1024,
	viewBounds: {left: 5, top: 18, right: -5, bottom: 32},
	viewFormat: 0,
	viewJustify: 8388662,
	viewFont: tsFancy + tsSize(18),
	viewTransferMode: 2,
	text: uCardPositionAlertButton,
	viewSetupDoneScript: func() begin
		SetKeyView(self, 0);
		HideCaret()
	end,
	viewQuitScript: func() begin
		ShowCaret()
	end,
	viewKeyDownScript: func(a1, a2) begin
		if (if ((a1 = $w) or (a1 = $.)) then (BAnd(a2, 33554432) <> 0)) then begin
				base:_DoCloseButton()
			end;
		if (if (a1 >= $0) then (a1 <= $9)) then begin
				PINKeyPad:keyPressScript(a1)
			end;
		if ((a1 = $\n) or (a1 = $\03)) then begin
				PINKeyPad:keyPressScript($E)
			end;
		if (a1 = $\08) then begin
				PINKeyPad:keyPressScript($<)
			end;
		true
	end,
	preallocatedContext: 'PINDisplay,
	_proto: @protoStaticText
};

PINKeyPad_2 := {
	keyDefinitions: [|Array|:
		[|Array|: 8, 8, $1, $1, 279971848, $2, $2, 279971848, $3, $3, 279971848],
		[|Array|: 8, 8, $4, $4, 279971848, $5, $5, 279971848, $6, $6, 279971848],
		[|Array|: 8, 8, $7, $7, 279971848, $8, $8, 279971848, $9, $9, 279971848],
		[|Array|: 8, 8, del, $<, 279971848, $0, $0, 279971848, ent, $E, 279971848]
	],
	viewBounds: {left: 5, top: 40, right: -5, bottom: 130},
	viewJustify: vjParentFullH,
	keyPressScript: func(a1) begin
		playsound(@click);
		if (if (a1 = $<) then (numKeys = 0)) then begin
				return nil
			end;
		(if (if (a1 = $<) then (numKeys > 0)) then begin
				numKeys := (numKeys - 1);
				if PINDisplay then begin
						SetValue(PINDisplay, 'text, Substr(PINDisplay.text, 0, numKeys))
					end;
				(pin := Substr(pin, 0, numKeys))
			end else (if (if (a1 = $E) then (numKeys > 0)) then AddDeferredSend(base, 'Close, nil) else (if (if (a1 <> $E) then (a1 <> $<)) then begin
						pin := Stringer([Array: pin, a1]);
						numKeys := (numKeys + 1);
						(if PINDisplay then SetValue(PINDisplay, 'text, Stringer([Array: PINDisplay.text, $\u2022])))
					end)))
	end,
	preallocatedContext: 'PINKeyPad,
	_proto: @protoKeypad
};
