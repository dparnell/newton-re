// protoFormatPicker: the "Format" label picker of a routing slip - lists the
// slip's formats (their titles) and makes the one picked the active format:
// the item's fields remember it (currentFormat), the format sets up the slip
// and, for an application that keeps one, becomes the default format.

protoFormatPicker := {
	_proto: @protoLabelPicker,
	text: "Format",
	labelCommands: [|Array|: ],
	// the slip (the 'base found from the picker's parent)
	parentBase: nil,
	// viewSetupFormScript: finds the slip; when the active format has an
	// auxiliary form (auxForm), the slip sets it up afterwards (deferred)
	viewSetupFormScript: func() begin
		parentBase := GetVariable(self:Parent(), 'base);
		inherited:?viewSetupFormScript();
		(if (if activeFormat then activeFormat.auxForm) then AddDeferredCall(func() begin
				parentBase:auxSetup()
			end, nil))
	end,
	// TextSetup(), from protoLabelPicker: fills the picker with the formats'
	// titles and returns the active one's, or "Format Missing"
	TextSetup: func() begin
		if GetVariable(self, 'formats) then begin
				labelCommands := (foreach item in formats collect item.title);
				if activeFormat then begin
						return activeFormat.title
					end
			end;
		"Format Missing"
	end,
	// LabelActionScript(index): makes formats[index] active - a format without a
	// symbol throws evt.ex.msg; lets it set up the slip (SetupSlip), sets up
	// its auxiliary form, and has the application (fields.appSymbol, if
	// any) record it as the default format for the item's category
	LabelActionScript: func(index) begin
		local l1;
		activeFormat := formats[index];
		fields.currentFormat := activeFormat.symbol;
		if (fields.currentFormat = nil) then begin
				Throw('|evt.ex.msg|, "Format is missing symbol")
			end;
		activeFormat:?SetupSlip(parentBase, fields);
		if activeFormat.auxForm then begin
				self:auxSetup()
			end else nil;
		(if (if fields.appSymbol then (l1 := GetRoot().(fields.appSymbol))) then l1:SetDefaultFormat(fields.category, target, fields.currentFormat))
	end,
	debug: 1451126
};
