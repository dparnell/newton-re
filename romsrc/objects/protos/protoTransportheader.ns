// protoTransportHeader: the top of a transport's routing information view
// (In/Out Box item info), based on newtInfoBox: the transport's icon and
// the item's title, its size and store, and for a sent item when it was
// sent; a transport adds lines in its BuildText method with AddText.

protoTransportheader := {
	// the transport this view belongs to (set by the In/Out Box)
	transport: nil,
	// the number of text lines so far, which sets the view's height
	currentOffset: 0,
	bbox: nil,
	textWidth: 0,
	height: 0,
	// extra height, in pixels, for child views a transport adds
	addedHeight: 0,
	// New(target, transport, bbox, context): makes and opens the view for an
	// In/Out Box item; context is the view sent InfoChanged when it closes
	New: func(a1, a2, a3, a4) begin
		local context;
		(context := BuildContext(self)).transport := a2;
		context.target := a1;
		context.icon := a2.icon;
		context.description := a2.title;
		context.context := a4;
		context.bbox := a3;
		context:Open();
		context
	end,
	// viewSetupFormScript(): builds the lines (icon, title, size and store,
	// sent time), lets the transport add its own (BuildText), sizes the view
	// and makes it read-only when the item's store is
	viewSetupFormScript: func() begin
		// the text's width: the screen's application area less the icon and
		// margins
		textWidth := (((displayParams.appAreaWidth - 42) - 10) - 18);
		currentOffset := 1;
		pix := [Array: self:addIcon(icon, 0), self:addIconLine(description, 0), self:addTextLine(ParamStr("Size: ^0 bytes (^1)", [Array: EntrySize(target), EntryStore(target):GetName()]), 1)];
		if (if ((target.state = 'Sent) or (target.state = 'OutLog)) then HasSlot(target, 'sentTimeStamp)) then begin
				self:addText(ParamStr("Sent: ^2 ^0 ^1", [Array: LongDateStr(target.sentTimeStamp, @datetimeStrSpecs.abbrDayOfWeekStrSpec), ShortDateStr(target.sentTimeStamp, @datetimeStrSpecs.numericDateStrSpec), HourMinute(target.sentTimeStamp)]))
			end;
		self:?BuildText();
		// 68 pixels for the icon and title, 16 per text line
		height := ((68 + (currentOffset * 16)) + addedHeight);
		viewBounds := self:CalcBounds(bbox);
		if EntryStore(target):IsReadOnly() then begin
				viewFlags := (viewFlags + vWriteProtected)
			end;
		inherited:?viewSetupFormScript()
	end,
	// GetTitle(): the item's title, as its transport gives it
	GetTitle: func() begin
		transport:GetItemTitle(target)
	end,
	// AddText(string): adds a line of text below the others, truncated to
	// the view's width in the bold 10-point system font
	addText: func(text) begin
		currentOffset := (currentOffset + 1);
		textWidth := textWidth;
		text := StyledStrTruncate(Clone(text), textWidth, tsSystem + tsSize(10) + tsBold);
		AddArraySlot(pix, self:addTextLine(text, currentOffset))
	end,
	debug: 46321264,
	_proto: @newtInfoBox
};
