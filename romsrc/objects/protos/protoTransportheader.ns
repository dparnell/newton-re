	end,
	GetTitle: func() begin
		transport:GetItemTitle(target)
	end,
	addText: func(a1) begin
		currentOffset := (currentOffset + 1);
		textWidth := textWidth;
		a1 := StyledStrTruncate(Clone(a1), textWidth, 1058816);
		AddArraySlot(pix, self:addTextLine(a1, currentOffset))
