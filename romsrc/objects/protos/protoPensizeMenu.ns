// protoPensizeMenu, and what only it reaches

protoPensizeMenu := {
	_proto: protoPensizeMenuProto,
	viewBounds: {left: 25, top: 0, right: 54, bottom: 13},
	text: "  Pen",
	slot: 'value,
	pop: [|Array|:
		{icon: @finepentipBitmap, indent: 10, item: "1 pt", value: 1},
		{icon: @smallpentip, item: popItem_2, value: 2},
		{icon: @mediumpentip, item: popItem, value: 3},
		{icon: @largepentip, item: popItem_3, value: 4}
	],
	pickActionScript: func(a1) begin
		self:PenSizeChanged(popup[a1].value);
		self:hilite(nil)
	end,
	setup: func() begin
		self:GetSelectionPenSize()
	end
};
