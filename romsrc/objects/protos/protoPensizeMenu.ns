// protoPensizeMenu: the "Pen" popup button of a drawing palette - a menu of
// four pen sizes (1 to 4 points) with pictures of the pen tips; choosing one
// sends PenSizeChanged with the size.

protoPensizeMenu := {
	_proto: protoPensizeMenuProto,
	viewBounds: {left: 25, top: 0, right: 54, bottom: 13},
	text: "  Pen",
	slot: 'value,
	// the menu's items: value is the pen size in points
	pop: [|Array|:
		{icon: @finepentipBitmap, indent: 10, item: "1 pt", value: 1},
		{icon: @smallpentip, item: popItem_2, value: 2},
		{icon: @mediumpentip, item: popItem, value: 3},
		{icon: @largepentip, item: popItem_3, value: 4}
	],
	// Called when an item of the menu is picked (index into popup): passes its pen
	// size to PenSizeChanged and unhighlights the button.
	pickActionScript: func(index) begin
		self:PenSizeChanged(popup[index].value);
		self:hilite(nil)
	end,
	// Asks the current pen size of the selection (GetSelectionPenSize) when the
	// menu is set up.
	setup: func() begin
		self:GetSelectionPenSize()
	end
};
