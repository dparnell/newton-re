// protoTable, and what only it reaches

protoTable := {
	viewClass: clView,
	viewFlags: vVisible + vReadOnly,
	viewFormat: vfFillWhite + vfFrameBlack + vfPen(1),
	declareSelf: 'tabbase,
	hOrg: 0,
	vOrg: 0,
	scrollAmount: 1,
	selectedCells: [|Array|: ],
	selectThisCell: func(childViewFrame) begin
		local l1, count, l3;
		count := Length(tabbase.selectedCells);
		(if def.tabUniqueSelection then begin
				tabbase.selectedCells := [Array: childViewFrame.vIndex];
				childViewFrame:HiliteUnique(true)
			end else begin
				l3 := nil;
				l1 := 0;
				(loop begin
						if (l1 >= count) then begin
								AddArraySlot(tabbase.selectedCells, childViewFrame.vIndex);
								break
							end;
						if (tabbase.selectedCells[l1] = childViewFrame.vIndex) then begin
								l3 := true;
								break
							end;
						(l1 := (l1 + 1))
					end);
				childViewFrame:hilite((not l3));
				(if l3 then RemoveSlot(tabbase.selectedCells, l1))
			end)
	end,
	updateSelection: func() begin
		childViewFrames := tabbase:ChildViewFrames();
		l1 := (vOrg * (hOrg + 1));
		if childViewFrames then begin
				count := Length(childViewFrames)
			end else begin
				count := 0
			end;
		local l1;
		local count;
		local item;
		local childViewFrames;
		(foreach item in tabbase.selectedCells do begin
				if (if (item >= l1) then ((item - l1) < count)) then begin
						childViewFrames[(item - l1)]:hilite(true)
					end
			end)
	end,
	viewSetupChildrenScript: func() begin
		if (def.tabHeights = 0) then begin
				def.tabHeights := FontHeight(GetVariable(self, 'viewFont))
			end;
		(self.viewChildren := self:LayoutTable(def, hOrg, vOrg))
	end,
	viewScrollDownScript: func() begin
		local most;
		most := max(0, ((def.tabDown - ((viewBounds.bottom - viewBounds.top) div def.tabHeights)) - 1));
		(if (vOrg < most) then begin
				if ((vOrg := (vOrg + scrollAmount)) > most) then begin
						vOrg := most
					end;
				tabbase:RedoChildren();
				self:updateSelection()
			end)
	end,
	viewScrollUpScript: func() begin
		(if (vOrg > 0) then begin
				if ((vOrg := (vOrg - scrollAmount)) < 0) then begin
						vOrg := 0
					end;
				tabbase:RedoChildren();
				self:updateSelection()
			end)
	end,
	viewScroll2DScript: func(arrowDirection, a2) begin
		(if (arrowDirection = 'up) then self:viewScrollUpScript() else (if (arrowDirection = 'down) then self:viewScrollDownScript()))
	end,
	debug: 45085
};
