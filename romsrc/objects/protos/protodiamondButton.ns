// protodiamondButton, and what only it reaches

protodiamondButton := {
	_proto: @protoTextButton,
	PadText: func(text) begin
		(if BeginsWith(text, "  ") then text else (if BeginsWith(text, " ") then Stringer([Array: " ", text]) else Stringer([Array: "  ", text])))
	end,
	viewSetupFormScript: func() begin
		local padText;
		padText := self:PadText(text);
		(if (text <> padText) then (text := padText))
	end,
	SetText: func(a1) begin
		SetValue(self, 'text, self:PadText(a1))
	end,
	viewDrawScript: compile(
		constants: {
			kROM_594: @diamanteBitmap
		},
		func() begin
			local box;
			box := self:LocalBox();
			self:DrawShape(OffsetShape(MakeShape(kROM_594), 1, ((box.bottom - 5) >> 1)), '{transferMode: 1})
		end)
};
