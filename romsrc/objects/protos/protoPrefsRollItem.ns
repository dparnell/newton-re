// protoPrefsRollItem: one section of a preferences roll: a full-width
// container whose first child is a title showing the item's overview text
// and icon.

protoPrefsRollItem := {
	_proto: @protoContainerView,
	viewFlags: vVisible,
	viewJustify: vjParentFullH,
	viewFormat: 0,
	// on opening: SetKeyView(self, 0), the key view at the start of this view
	viewSetupFormScript: func() begin
		SetKeyView(self, 0)
	end,
	pix: nil,
	viewChildren: [viewChildren:
		{
			title: nil,
			// the title shows the item's overview text and its icon
			viewSetupFormScript: func() begin
				title := overview;
				titleicon := icon;
				inherited:viewSetupFormScript()
			end,
			_proto: @protoTitle
		}
	]
};
