// protoSendButton, and what only it reaches

protoSendButton := {
	viewBounds: nil,
	viewJustify: 8407046,
	popup: [|Array|: "Now", later],
	text: send,
	noClone: nil,
	when: nil,
	viewSetupFormScript: func() begin
		local l1;
		if GetVariable(self, 'Editing) then begin
				self.viewFlags := BAnd(self.viewFlags, bnot(1))
			end else begin
				if transport then begin
						when := transport:?ConnectionDetect();
						text := transport.actionTitle
					end
			end;
		if (not when) then begin
				text := Stringer([Array: "  ", text])
			end;
		viewBounds := RelBounds(((-(l1 := (StrFontWidth(text, viewFont) + 6))) - 7), 0, l1, FontHeight(viewFont));
		(_defaultButton := self)
	end,
	PadText: func(a1) begin
		a1
	end,
	viewDrawScript: func() begin
		(if (not when) then inherited:?viewDrawScript())
	end,
	buttonClickScript: func() begin
		(if when then self:PrepareForSubmission(when) else inherited:buttonClickScript())
	end,
	pickActionScript: func(a1) begin
		self:hilite(nil);
		self:PrepareForSubmission((if (a1 = 0) then 'Now else 'Later))
	end,
	PrepareForSubmission: func(a1) begin
		self:SubmitIt(a1)
	end,
	SubmitIt: func(a1) begin
		local l1;
		l1 := fields;
		if (a1 = 'readdress) then begin
				base:Close();
				transport:itemchanged(l1);
				return nil
			end;
		if activeFormat then begin
				l1 := activeFormat:ParseCursor(l1, {target: target, targetView: targetView})
			end;
		if (a1 = 'Now) then begin
				l1.Connect := true
			end else begin
				if l1.Connect then begin
						l1.Connect := nil
					end
			end;
		if (l1.state = 'pending) then begin
				l1.state := 'ready
			end;
		base:Close();
		transport:ItemSubmit(l1)
	end,
	debug: 1444048,
	_proto: @protoPopupButton
};
