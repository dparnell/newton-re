// protoRollItem: one item of a protoRoll - a white, black-framed view that
// stretches across its parent and stacks below its previous sibling (the
// roll lays the items out one under another).

protoRollItem := {
	viewClass: clView,
	viewFlags: vVisible,
	viewFormat: vfFillWhite + vfFrameBlack + vfPen(1),
	viewJustify: vjParentFullH + vjSiblingBottomV,
	debug: 360639
};
