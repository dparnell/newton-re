// protoSmallKeyboardButton: the small keyboard button (a protoKeyboardButton
// with the small keyboard icon and a smaller size) that pops up the list of
// keyboards for the field with the caret.

protoSmallKeyboardButton := {
	icon: @keySmallButtonBitmap,
	viewBounds: {left: 5, top: 0, right: 23, bottom: 13},
	_proto: @protoKeyboardButton
};
