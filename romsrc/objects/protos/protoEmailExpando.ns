// protoEmailExpando, and what only it reaches

protoEmailExpando := {
	_proto: @protoTextExpando,
	labelCommands: nil,
	labelSymbols: nil,
	TextSetup: func() begin
		self:SetLabelText(self:setup1(target));
		inherited:TextSetup()
	end,
	setup1: func(target) begin
		labelCommand := EmailSystems.emailText.|string.email|;
		if target then begin
				cls := ClassOf(target.(path));
				labelCommands := [Array: ];
				local labelCommand;
				local cls;
				(foreach key, value in (labelSymbols := EmailSystems.emailClasses) do begin
						AddArraySlot(labelCommands, EmailSystems.emailText.(value));
						if (value = cls) then begin
								labelCommand := labelCommands[key]
							end
					end)
			end;
		labelCommand
	end,
	textChanged: func() begin
		local l1;
		l1 := (if (not target.(path)) then labelSymbols[0] else ClassOf(target.(path)));
		(target.(path) := SetClass(entryLine.text, l1))
	end,
	LabelActionScript: func(index) begin
		self:SetLabelText(labelCommands[index]);
		labelLine:Dirty();
		if (not target.(path)) then begin
				target.(path) := Clone("")
			end;
		SetClass(target.(path), labelSymbols[index]);
		true
	end
};
