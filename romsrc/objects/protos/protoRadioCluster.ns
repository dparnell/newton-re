// protoRadioCluster, and what only it reaches

protoRadioCluster := {
	viewClass: clView,
	viewFlags: vVisible + vReadOnly,
	viewFormat: 0,
	declareSelf: 'cluster,
	clusterValue: nil,
	clusterChild: nil,
	viewSetupDoneScript: func() begin
		local l1;
		(foreach l2 in (l1 := self:ChildViewFrames()) do begin
				if (clusterValue = l2.buttonValue) then begin
						clusterChild := l2;
						l2.viewValue := l2.buttonValue;
						l2:UpdateBitmap()
					end
			end)
	end,
	SetClusterValue: func(a1) begin
		local l1;
		(foreach l2 in (l1 := self:ChildViewFrames()) do begin
				if (a1 = l2.buttonValue) then begin
						self:SetCluster(l2)
					end
			end)
	end,
	SetCluster: func(a1) begin
		(if (clusterChild <> a1) then begin
				if clusterChild then begin
						AddUndoAction('UndoAction, [Array: clusterChild]);
						clusterChild.viewValue := nil;
						clusterChild:UpdateBitmap()
					end;
				clusterChild := a1;
				clusterValue := a1.buttonValue;
				a1.viewValue := a1.buttonValue;
				a1:UpdateBitmap();
				RefreshViews();
				self:ClusterChanged()
			end)
	end,
	InitClusterValue: func(a1) begin
		l2 := nil;
		local l1;
		local l2;
		(foreach l3 in (l1 := self:ChildViewFrames()) do begin
				if (a1 = l3.buttonValue) then begin
						l2 := true;
						self:InitCluster(l3)
					end
			end);
		(if (if (not l2) then clusterChild) then begin
				clusterChild.viewValue := nil;
				clusterChild:UpdateBitmap();
				(clusterChild := nil)
			end)
	end,
	InitCluster: func(a1) begin
		(if (clusterChild <> a1) then begin
				if clusterChild then begin
						clusterChild.viewValue := nil;
						clusterChild:UpdateBitmap()
					end;
				clusterChild := a1;
				clusterValue := a1.buttonValue;
				a1.viewValue := a1.buttonValue;
				a1:UpdateBitmap()
			end)
	end,
	ClusterChanged: func() begin
		nil
	end,
	UndoAction: func(a1) begin
		self:SetCluster(a1)
	end,
	debug: 5775968
};
