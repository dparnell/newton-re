// protoMultiCursor: a cursor over several soup cursors at once, merging
// their entries into one order (by comparator; by default the entries'
// sorton strings). It answers the usual cursor messages (Next, prev, entry,
// Reset, Goto, GotoKey, move, clone, CountEntries). Each cursor's record
// ("curse") remembers where it stands relative to the merged position:
// 'passed (its entry is behind), 'resident (its entry is the current one)
// or 'prior (its entry is ahead).

protoMultiCursor := {
	// the cursors' records: {cursor, id, state}
	curses: nil,
	// how many cursors there are
	finalCurse: 0,
	// the record of the cursor whose entry is the current one
	metaCursor: nil,
	// The default order: comparator(e1, e2, op) is true when e1 op e2, op being
	// '|=| (the same entry), '|<| or '|>| (by their sorton strings).
	comparator: func(a1, a2, a3) begin
		local strCompare2;
		(if (a3 = '|=|) then IsSameEntry(a1, a2) else ((if ((strCompare2 := StrCompare(a1.sorton, a2.sorton)) < 0) then (a3 = '|<|)) or (if (strCompare2 > 0) then (a3 = '|>|))))
	end,
	// protoMultiCursor:New(cursors, comparator) - a multi-cursor over the array
	// of cursors (ids 0, 1 ...), ordered by comparator if given, reset to its
	// first entry.
	New: func(a1, a2) begin
		frame2 := {_proto: self, curses: [Array: ]};
		if a2 then begin
				frame2.comparator := a2
			end;
		if a1 then begin
				local frame2;
				(foreach item in a1 do begin
						frame2:addCursor(item, nil)
					end)
			end;
		frame2:Reset();
		frame2
	end,
	// Adds a cursor, known by id a2 (default: its number). Returns the new count.
	addCursor: func(item, a2) begin
		local frame2;
		frame2 := {cursor: item, id: (if a2 then a2 else finalCurse), state: 'passed};
		ArrayInsert(curses, frame2, finalCurse);
		(finalCurse := (finalCurse + 1))
	end,
	// Replaces the cursor with id a1 by soupCursor; true if there was one.
	ReplaceCursor: func(a1, soupCursor) begin
		(for i := 0 to (finalCurse - 1) do begin
				if (curses[i].id = a1) then begin
						curses[i].cursor := soupCursor;
						return true
					end
			end);
		nil
	end,
	// Moves the merged position one entry in direction a1 ('Next or 'prev):
	// each cursor is asked for its candidate - the message depends on its state
	// (a cursor already past in that direction just gives its entry) - skipping
	// 'deleted, and the nearest candidate in that direction (by comparator)
	// becomes the current entry, its cursor 'resident. Returns the entry, or nil
	// at the end.
	mover: func(a1) begin
		local perform22;
		(for i := 0 to (Length(curses) - 1) do begin
				local curse, l6, perform2;
				curse := curses[i];
				// l6: the message to send this cursor
				l6 := '{passed: {prev: prev, Next: entry}, resident: {prev: prev, Next: Next}, prior: {prev: entry, Next: Next}}.(curse.state).(a1);
				perform2 := Perform(curse.cursor, l6, [Array: ]);
				(while (perform2 = 'deleted) do (perform2 := Perform(curse.cursor, l6, [Array: ])));
				// a cursor that moved now stands behind the position ('passed) or ahead ('prior)
				if (l6 = a1) then begin
						curse.state := '{Next: passed, prev: prior}.(a1)
					end;
				if perform2 then begin
						if ((not perform22) or call comparator with (perform22, perform2, '{Next: |>|, prev: |<|}.(a1))) then begin
								metaCursor := curse;
								perform22 := perform2
							end
					end
			end);
		// (metaCursor is not cleared first: when no cursor has an entry left it is
		// still the previous one, made 'resident again)
		if metaCursor then begin
				metaCursor.state := 'resident
			end;
		perform22
	end,
	// The cursor messages: the next or previous entry in the merged order, and
	// the current one.
	Next: func() begin
		self:mover('Next)
	end,
	// Back one entry.
	prev: func() begin
		self:mover('prev)
	end,
	// The current entry (of the cursor in front).
	entry: func() begin
		metaCursor.cursor:entry()
	end,
	// Resets every cursor to its start and moves to the first entry overall.
	Reset: func() begin
		(foreach item in curses do begin
				item.cursor:Reset();
				item.state := 'passed
			end);
		self:Next()
	end,
	// Resets every cursor to its end and moves to the last entry overall.
	ResetToEnd: func() begin
		(foreach item in curses do begin
				item.cursor:ResetToEnd();
				item.state := 'prior
			end);
		self:prev()
	end,
	// Moves every cursor to entry a1 and makes the earliest of their answers
	// (by comparator) the current entry; returns it.
	Goto: func(a1) begin
		local goto2;
		(foreach item in curses do begin
				local goto;
				goto := item.cursor:Goto(a1);
				item.state := 'passed;
				if goto then begin
						if ((not goto2) or call comparator with (goto2, goto, '|>|)) then begin
								metaCursor := item;
								goto2 := goto
							end
					end
			end);
		if metaCursor then begin
				metaCursor.state := 'resident
			end;
		goto2
	end,
	// Likewise for the first entry at or after key a1 in each cursor (skipping
	// 'deleted answers).
	GotoKey: func(a1) begin
		local gotoKey2;
		(foreach item in curses do begin
				local gotoKey;
				gotoKey := item.cursor:GotoKey(a1);
				(while (gotoKey = 'deleted) do (gotoKey := item.cursor:Next()));
				item.state := 'passed;
				if gotoKey then begin
						if ((not gotoKey2) or call comparator with (gotoKey2, gotoKey, '|>|)) then begin
								metaCursor := item;
								gotoKey2 := gotoKey
							end
					end
			end);
		if metaCursor then begin
				metaCursor.state := 'resident
			end;
		gotoKey2
	end,
	// A copy standing at the same place, with copies of the cursors. Looks like
	// a ROM bug: the copy's metaCursor is a shallow Clone of the original's
	// record, not one of the copy's curses, so until the copy first moves its
	// entry() reads the original's cursor.
	clone: func() begin
		(copy := Clone(self)).metaCursor := Clone(metaCursor);
		copy.curses := Clone(copy.curses);
		local copy;
		(for i := 0 to (finalCurse - 1) do begin
				copy.curses[i] := Clone(curses[i]);
				copy.curses[i].cursor := copy.curses[i].cursor:clone()
			end);
		copy
	end,
	// The number of entries of all the cursors together.
	CountEntries: func() begin
		l1 := 0;
		local l1;
		(for i := 0 to (finalCurse - 1) do begin
				l1 := (l1 + curses[i].cursor:CountEntries())
			end);
		l1
	end,
	// Moves maxLines entries forward (or back if negative); returns the entry.
	move: func(maxLines) begin
		if (maxLines > 0) then begin
				(while (maxLines > 0) do begin
						maxLines := (maxLines - 1);
						self:Next()
					end)
			end else begin
				(while (maxLines < 0) do begin
						maxLines := (maxLines + 1);
						self:prev()
					end)
			end;
		self:entry()
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

Reset_code := same("protoMultiCursor.Reset.instructions");
