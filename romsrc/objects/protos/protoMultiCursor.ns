// protoMultiCursor, and what only it reaches

protoMultiCursor := {
	curses: nil,
	finalCurse: 0,
	metaCursor: nil,
	comparator: func(a1, a2, a3) begin
		local strCompare2;
		(if (a3 = '|=|) then IsSameEntry(a1, a2) else ((if ((strCompare2 := StrCompare(a1.sorton, a2.sorton)) < 0) then (a3 = '|<|)) or (if (strCompare2 > 0) then (a3 = '|>|))))
	end,
	New: func(a1, a2) begin
		frame2 := {_proto: self, curses: [Array: ]};
		if a2 then begin
				frame2.comparator := a2
			end;
		if a1 then begin
				local frame2;
				(foreach item in a1 do begin
						frame2:addCursor(item, nil)
					end)
			end;
		frame2:Reset();
		frame2
	end,
	addCursor: func(item, a2) begin
		local frame2;
		frame2 := {cursor: item, id: (if a2 then a2 else finalCurse), state: 'passed};
		ArrayInsert(curses, frame2, finalCurse);
		(finalCurse := (finalCurse + 1))
	end,
	ReplaceCursor: func(a1, soupCursor) begin
		(for i := 0 to (finalCurse - 1) do begin
				if (curses[i].id = a1) then begin
						curses[i].cursor := soupCursor;
						return true
					end
			end);
		nil
	end,
	mover: func(a1) begin
		local perform22;
		(for i := 0 to (Length(curses) - 1) do begin
				local curse, l6, perform2;
				curse := curses[i];
				l6 := '{passed: {prev: prev, Next: entry}, resident: {prev: prev, Next: Next}, prior: {prev: entry, Next: Next}}.(curse.state).(a1);
				perform2 := Perform(curse.cursor, l6, [Array: ]);
				(while (perform2 = 'deleted) do (perform2 := Perform(curse.cursor, l6, [Array: ])));
				if (l6 = a1) then begin
						curse.state := '{Next: passed, prev: prior}.(a1)
					end;
				if perform2 then begin
						if ((not perform22) or call comparator with (perform22, perform2, '{Next: |>|, prev: |<|}.(a1))) then begin
								metaCursor := curse;
								perform22 := perform2
							end
					end
			end);
		if metaCursor then begin
				metaCursor.state := 'resident
			end;
		perform22
	end,
	Next: func() begin
		self:mover('Next)
	end,
	prev: func() begin
		self:mover('prev)
	end,
	entry: func() begin
		metaCursor.cursor:entry()
	end,
	Reset: func() begin
		(foreach item in curses do begin
				item.cursor:Reset();
				item.state := 'passed
			end);
		self:Next()
	end,
	ResetToEnd: func() begin
		(foreach item in curses do begin
				item.cursor:ResetToEnd();
				item.state := 'prior
			end);
		self:prev()
	end,
	Goto: func(a1) begin
		local goto2;
		(foreach item in curses do begin
				local goto;
				goto := item.cursor:Goto(a1);
				item.state := 'passed;
				if goto then begin
						if ((not goto2) or call comparator with (goto2, goto, '|>|)) then begin
								metaCursor := item;
								goto2 := goto
							end
					end
			end);
		if metaCursor then begin
				metaCursor.state := 'resident
			end;
		goto2
	end,
	GotoKey: func(a1) begin
		local gotoKey2;
		(foreach item in curses do begin
				local gotoKey;
				gotoKey := item.cursor:GotoKey(a1);
				(while (gotoKey = 'deleted) do (gotoKey := item.cursor:Next()));
				item.state := 'passed;
				if gotoKey then begin
						if ((not gotoKey2) or call comparator with (gotoKey2, gotoKey, '|>|)) then begin
								metaCursor := item;
								gotoKey2 := gotoKey
							end
					end
			end);
		if metaCursor then begin
				metaCursor.state := 'resident
			end;
		gotoKey2
	end,
	clone: func() begin
		(copy := Clone(self)).metaCursor := Clone(metaCursor);
		copy.curses := Clone(copy.curses);
		local copy;
		(for i := 0 to (finalCurse - 1) do begin
				copy.curses[i] := Clone(curses[i]);
				copy.curses[i].cursor := copy.curses[i].cursor:clone()
			end);
		copy
	end,
	CountEntries: func() begin
		l1 := 0;
		local l1;
		(for i := 0 to (finalCurse - 1) do begin
				l1 := (l1 + curses[i].cursor:CountEntries())
			end);
		l1
	end,
	move: func(maxLines) begin
		if (maxLines > 0) then begin
				(while (maxLines > 0) do begin
						maxLines := (maxLines - 1);
						self:Next()
					end)
			end else begin
				(while (maxLines < 0) do begin
						maxLines := (maxLines + 1);
						self:prev()
					end)
			end;
		self:entry()
	end
};

