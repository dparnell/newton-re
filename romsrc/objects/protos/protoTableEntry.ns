// protoTableEntry, and what only it reaches

protoTableEntry := {
	viewClass: clTextView,
	viewFlags: vVisible + vReadOnly + vClickable,
	viewFormat: 0,
	viewTransferMode: 1,
	viewJustify: 8388612,
	text: nil,
	viewBounds: nil,
	viewClickScript: func(a1) begin
		currentSelection := text;
		self:selectThisCell(self);
		true
	end,
	viewHiliteScript: func(a1) begin
		local l1, l2;
		l1 := nil;
		if def.indentX then begin
				l2 := self.viewBounds;
				self:DrawShape(MakeRect((-def.indentX), 0, (l2.right - def.indentX), (l2.bottom - l2.top)), '{transferMode: 2, penPattern: 0, fillPattern: 5});
				l1 := true
			end;
		return l1
	end
};
