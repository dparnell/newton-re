// protoNumberPicker, and what only it reaches

protoNumberPicker := {
	viewFlags: vVisible,
	viewFormat: nil,
	viewBounds: {left: 20, top: 51, right: 180, bottom: 75},
	viewClass: clPictureView,
	declareSelf: 'digitBase,
	icon: nil,
	showLeadingZeros: nil,
	fDigitsProto: {
		_proto: @protoDigit,
		viewJustify: vjCenterH + vjCenterV + vjParentRightH + vjParentCenterV + vjSiblingLeftH + vjSiblingCenterV,
		viewBounds: {left: -22, top: 0, right: 0, bottom: 28},
		increment: 1,
		position: 0,
		GetIndex: func(a1) begin
			((a1 div increment) mod 10)
		end,
		viewDrawScript: func() begin
			(if ((ArrayPos <= hiOrd) or showLeadingZeros) then DrawXBitmap(digitFrame, digits, currentIndex, copyMode))
		end,
		Advance: func(a1) begin
			local l1, l2, l3, l4, l5, l6, l7, l8;
			if (((l1 := (value + a1)) > maxValue) or (l1 < minValue)) then begin
					return nil
				end;
			l3 := (l2 := self):GlobalBox();
			l4 := l2:GetIndex(l1);
			l5 := nil;
			l6 := nil;
			(loop begin
					if (if (if ((if (l2.ArrayPos > hiOrd) then (l4 <> 0)) or (if (l2.ArrayPos = hiOrd) then (l4 = 0))) then (not showLeadingZeros)) then (not l5)) then begin
							l5 := digitBase.hiOrd;
							l6 := digitBase:ScanForHiOrd(l1)
						end;
					if (l4 <> l2:GetIndex(value)) then begin
							l2.currentIndex := l4;
							l3.left := min(l3.left, l2:GlobalBox().left)
						end else begin
							break
						end;
					if (l7 := l2.nextDigit) then begin
							l2 := (if (ClassOf(l7) = 'symbol) then digitBase.(l7) else l7)
						end else begin
							break
						end;
					(l4 := l2:GetIndex(l1))
				end);
			value := l1;
			if (l6 <> l5) then begin
					l5 := GetView(viewChildren[l5]):GlobalBox();
					l6 := GetView(viewChildren[l6]):GlobalBox();
					l3.left := min(min(l5.left, l6.left), l3.left);
					l3.right := max(max(l6.left, l5.left), l3.right)
				end;
			l8 := digitBase:GlobalBox();
			digitBase:RevealEffect(((l3 := RelBounds((l3.left - l8.left), (l3.top - l8.top), (l3.right - l3.left), (l3.bottom - l3.top))).bottom * (if (a1 > 0) then -1 else 1)), l3, @click, nil, nil);
			l1
		end
	},
	hiOrd: 0,
	viewChangedScript: func(a1, a2) begin
		(if (if (a2 = self) then (a1 = 'value)) then a2:RedoChildren())
	end,
	viewSetupDoneScript: compile(
		constants: {
			kROM_685: @digitflaploWord,
			kROM_686: @digitflap
		},
		func() begin
			local l1, l2, l3, l4, l5, l6;
			l1 := AddView(self, {_proto: fDigitsProto, viewJustify: 102, viewBounds: SetBounds(-23, 0, 0, 28), icon: kROM_685, nextDigit: nil, ArrayPos: 0});
			l2 := (value div 10);
			l3 := (maxValue div 10);
			l4 := 10;
			l5 := 1;
			(while (l3 <> 0) do begin
					l6 := {_proto: fDigitsProto, increment: l4, nextDigit: nil, ArrayPos: l5, icon: kROM_686};
					l6 := AddView(self, l6);
					l1.nextDigit := l6;
					l1 := l6;
					l2 := (l2 div 10);
					l3 := (l3 div 10);
					l4 := (l4 * 10);
					(l5 := (l5 + 1))
				end);
			self:ScanForHiOrd(value)
		end),
	ScanForHiOrd: func(a1) begin
		local l1, l2;
		l1 := (a1 div 10);
		l2 := 0;
		(while (l1 <> 0) do begin
				l1 := (l1 div 10);
				(l2 := (l2 + 1))
			end);
		(hiOrd := l2)
	end,
	debug: 5802140
};
