// protoAmpmCluster: the AM/PM pair of radio buttons of a time setter: its
// value follows the Time slot (minutes) and choosing the other half of the
// day moves the setter's hours by 12.  protoAmpmClusterProto is its buttons'
// proto, labelled with the locale's morning and evening strings.

protoAmpmCluster := {
	viewBounds: nil,
	clusterValue: nil,
	// at setup: selects morningStr or eveningStr by which half day Time
	// (minutes) falls in - 720 minutes in a half day
	viewSetupFormScript: func() begin
		local l1;
		(if (BAnd((l1 := (Time div 720)), 1) = 0) then (clusterValue := 'morningStr) else (clusterValue := 'eveningStr))
	end,
	// sent when the user picks a button: moves setter.hours into the chosen
	// half of the day (l1, the change, stays nil if it is there already),
	// rebuilds Time from the day, hours and minutes (1440 minutes in a day)
	// and tells the setter
	ClusterChanged: func() begin
		local l1;
		if (if (clusterValue = 'morningStr) then (setter.hours > 11)) then begin
				l1 := -12
			end;
		if (if (clusterValue = 'eveningStr) then (setter.hours < 12)) then begin
				l1 := 12
			end;
		(if l1 then begin
				setter.hours := (setter.hours + l1);
				Time := ((((Time div 1440) * 1440) + (setter.hours * 60)) + setter.minutes);
				setter:TimeChanged()
			end)
	end,
	viewChildren: [viewChildren:
		{_proto: protoAmpmClusterProto, buttonValue: 'morningStr},
		{_proto: protoAmpmClusterProto, buttonValue: 'eveningStr}
	],
	_proto: @protoRadioCluster
};

// one button of the cluster: buttonValue names its string in the locale's
// timeformat frame
protoAmpmClusterProto := {
	viewBounds: {left: 0, top: 0, right: 35, bottom: 0},
	viewJustify: vjCenterV + vjParentFullV + vjSiblingRightH,
	viewValue: nil,
	text: nil,
	// at setup: the label is the locale's AM or PM string without spaces
	viewSetupFormScript: func() begin
		(text := StringFilter(GetLocale().timeformat.(buttonValue), " ", 'rejectAll))
	end,
	buttonValue: nil,
	_proto: @protoRadioButton
};
