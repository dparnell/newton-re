	end,
	viewClass: clView,
	// doScrollScript(delta): scrolls by delta pixels, within the list, and
	// tells the scroll arrows
	doscrollscript: func(a1) begin
		local l1;
		(if (if ((l1 := (viewOriginY + a1)) >= 0) then (l1 <= spillHeight)) then begin
				self:SetOrigin(0, l1);
