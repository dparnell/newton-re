			end else (viewChildren := [Array: l1]))
	end,
	GetLineHeight: func() begin
		return lineHeight
	end,
	// non-nil: several lines can be selected, each with a check box
	useMultipleSelections: nil,
	viewChildren: [viewChildren: textList, pictList, textListScrollers],
	textList: nil,
	allocateContext: [|Array|: 'textList, textList, 'pictList, pictList, 'textListScrollers, textListScrollers],
