// protoTextList: a scrolling list of text lines (or of shapes, with
// isShapeList) from ListItems, one line per item, with a single selection
// (Selection) or, with useMultipleSelections, several (selectedItems,
// shown with check boxes), and optional up/down scroll arrows
// (useScrollers). Tapping a line selects it and calls buttonClickScript.
// The view's height is a whole number of lines (viewLines).

protoTextList := {
