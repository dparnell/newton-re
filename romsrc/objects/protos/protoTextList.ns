	end,
	debug: 361046,
	// SetChild(view): the list's text or picture view (sent by it)
	SetChild: func(a1) begin
		(self.scrollableChild := a1)
	end,
	// the number of items
	numItems: 0,
	viewFont: @fontSystem10,
	// drawHilite(): draws the selection - the visible lines' check boxes, or
