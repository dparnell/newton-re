// the list as text: the items, one per line
textList := {
	debug: 71574,
	viewClass: clTextView,
	viewFlags: vVisible,
	viewJustify: 0,
	// the left margin, 18 with check boxes
	inset: 3,
	// viewSetupFormScript(): the items joined into one text, a line each
	viewSetupFormScript: func() begin
		if useMultipleSelections then begin
				self.inset := 18
			end;
		TextBase:SetChild(self);
		local text;
		(foreach item in ListItems do begin
				text := Stringer([Array: text, item, "\n"])
			end);
		self.text := text;
		(self.viewBounds := SetBounds(inset, 0, 1000, (Length(ListItems) * self:GetLineHeight())))
	end,
	viewDrawScript: func() begin
		self:Parent():drawHilite()
	end,
	preallocatedContext: 'textList
};

