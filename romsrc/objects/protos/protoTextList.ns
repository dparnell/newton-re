	end,
	viewHeight: 0,
	// non-nil: up/down scroll arrows at the right when the list is longer than
	// the view
	useScrollers: nil,
	viewFlags: vVisible + vClipping + vClickable,
	// ButtonClickScript(index): a line was tapped; the application supplies it
	buttonClickScript: func(a1) begin
		nil
	end,
	CheckOn: CheckOn,
	// the height, in pixels, of the lines below the visible ones
	spillHeight: 0,
	// GetViewWidth(), GetTotalLines(), GetVisibleLines(), GetViewHeight(),
	// GetLineHeight(): the list's measurements, for its parts
	GetViewWidth: func() begin
		return viewWidth
