		(viewWidth := box.right)
	end,
	// ShowScrollers(): whether the scroll arrows are wanted - useScrollers and
	// more lines than fit
	ShowScrollers: func() begin
		return (if useScrollers then (self:GetTotalLines() > self:GetVisibleLines()))
	end,
	// HiliteLine(index): toggles a line in the multiple selection (and its
	// check box), or moves the single selection to it
	HiliteLine: func(temp) begin
		local setContains2;
		(if useMultipleSelections then (if (if (if temp then (temp < numItems)) then (temp >= 0)) then (if (setContains2 := SetContains(selectedItems, temp)) then begin
						ArrayRemoveCount(selectedItems, setContains2, 1);
						self:InvertLine(temp, nil)
					end else begin
						AddArraySlot(selectedItems, temp);
						self:InvertLine(temp, true)
