// protoLabelPicker, and what only it reaches

protoLabelPicker := {
	LabelActionScript: func(index) begin
		nil
	end,
	indent: nil,
	viewFormat: vfInset(1) + vfRound(3),
	iconBounds: nil,
	viewFlags: vVisible + vReadOnly + vClickable,
	UpdateIcon: func(icon) begin
		SetValue(entryLineIcon, 'icon, icon)
	end,
	viewBounds: nil,
	iconSetup: func() begin
		(if (if (if (if labelCommands then iconBounds) then (Length(labelCommands) > 0)) then IsFrame(labelCommands[0])) then labelCommands[0].icon)
	end,
	_proto: @protoStaticText,
	pickerSetup: func() begin
		true
	end,
	viewJustify: 8388608,
	height: nil,
	UpdateText: func(a1) begin
		SetValue(entryLine, 'text, a1);
		self:textChanged()
	end,
	pickCancelledScript: func() begin
		base:hilite(nil)
	end,
	checkCurrentItem: true,
	labelCommands: nil,
	iconIndent: nil,
	TextSetup: func() begin
		local text, l2;
		text := "";
		if (if labelCommands then (Length(labelCommands) > 0)) then begin
				if IsFrame((l2 := (text := labelCommands[0]))) then begin
						if (if (not (text := l2.item)) then l2.keyMessage) then begin
								text := MatchKeyMessage(self, l2.keyMessage).name
							end
					end
			end;
		text
	end,
	textChanged: func() begin
		nil
	end,
	declareSelf: 'base,
	viewSetupFormScript: func() begin
		local l1, l2;
		if (not (if text then BeginsWith(text, "\uFC01\u"))) then begin
				text := Stringer([Array: $\uFC01, text])
			end;
		if (not indent) then begin
				indent := (StrFontWidth(text, viewFont) + 6)
			end;
		if (if iconBounds then (not iconIndent)) then begin
				iconIndent := 3
			end;
		if iconBounds then begin
				l1 := (iconBounds.bottom - iconBounds.top)
			end else begin
				l1 := 0
			end;
		entryLine.text := self:TextSetup();
		textIndent := indent;
		if iconBounds then begin
				entryLineIcon.icon := self:iconSetup();
				l2 := (iconBounds.right - iconBounds.left);
				entryLineIcon.viewBounds := SetBounds(textIndent, 0, (textIndent + l2), (iconBounds.bottom - iconBounds.top));
				textIndent := ((textIndent + l2) + iconIndent)
			end else begin
				self.viewChildren := [Array: entryLine]
			end;
		entryLine.viewBounds := SetBounds(textIndent, 0, self:LocalBox().right, 0);
		if HasPath(self, 'viewLineSpacing) then begin
				entryLine.viewLineSpacing := self.viewLineSpacing
			end else begin
				self.viewLineSpacing := 10
			end;
		(height := FontHeight(viewFont))
	end,
	alwaysCallPickActionScript: nil,
	Popit: func(x) begin
		(if self:pickerSetup() then begin
				copy := Clone(labelCommands);
				if checkCurrentItem then begin
						local copy;
						(foreach key, value in copy do begin
								local item, copy2, popupHiliteBox;
								item := value;
								if IsFrame(value) then begin
										if (if (not (item := value.item)) then value.keyMessage) then begin
												item := MatchKeyMessage(self, value.keyMessage).name
											end
									end;
								if (if IsString(item) then StrEqual(entryLine.text, item)) then begin
										if IsFrame(value) then begin
												(copy2 := Clone(copy[key])).mark := $\uFC0B
											end else begin
												copy2 := {item: item, mark: $\uFC0B}
											end;
										copy[key] := copy2
									end
							end)
					end;
				(popupHiliteBox := self:PopupHiliteBox()).right := x;
				self:PopupMenu(copy, {bounds: popupHiliteBox});
				true
			end)
	end,
	viewClickScript: func(unit) begin
		if self:TrackHilite(unit) then begin
				self:Popit((indent - 2))
			end;
		true
	end,
	viewHiliteScript: func(on) begin
		local popupHiliteBox;
		popupHiliteBox := self:PopupHiliteBox();
		self:DrawShape(MakeRoundRect(-2, popupHiliteBox.top, indent, popupHiliteBox.bottom, 4), '{transferMode: 2, penPattern: 0, fillPattern: 5});
		true
	end,
	pickActionScript: func(index) begin
		local labelCommand, icon, item;
		if IsFrame((labelCommand := labelCommands[index])) then begin
				icon := labelCommand.icon;
				if (if (not (item := labelCommand.item)) then labelCommand.keyMessage) then begin
						item := MatchKeyMessage(self, labelCommand.keyMessage).name
					end
			end else begin
				icon := nil;
				item := labelCommand
			end;
		self:UpdateText(item);
		if iconBounds then begin
				self:UpdateIcon(icon)
			end;
		self:LabelActionScript(index);
		base:hilite(nil)
	end,
	viewCaretActivateScript: func(a1) begin
		local l1;
		(if a1 then begin
				if indent then begin
						l1 := (indent - 2)
					end else begin
						l1 := 0
					end;
				self:Popit(l1)
			end)
	end,
	text: uCardPositionAlertButton,
	debug: 2911004,
	viewFont: @fontSystem9Bold,
	PopupHiliteBox: func() begin
		local box;
		box := self:LocalBox();
		if HasPath(self, 'viewLineSpacing) then begin
				box.top := (viewLineSpacing - FontAscent(viewFont));
				box.bottom := (box.top + FontHeight(viewFont))
			end;
		box
	end,
	textIndent: nil,
	viewChildren: [viewChildren: entryLineIcon, entryLine_4],
	entryLineIcon: nil,
	allocateContext: [|Array|: 'entryLineIcon, entryLineIcon, 'entryLine, entryLine_4],
	entryLine: nil
};

entryLineIcon := {
	viewFlags: vVisible,
	icon: nil,
	viewFormat: nil,
	viewJustify: vjCenterH + vjCenterV,
	viewBounds: {left: 0, top: 0, right: 16, bottom: 16},
	viewClass: clPictureView,
	debug: 280740,
	preallocatedContext: 'entryLineIcon
};

entryLine_4 := {
	_proto: @protoStaticText,
	viewFlags: vVisible + vReadOnly + vClickable,
	viewJustify: 8388800,
	viewFont: tsHWFont + tsSize(10),
	viewClickScript: func(unit) begin
		nil
	end,
	preallocatedContext: 'entryLine
};

