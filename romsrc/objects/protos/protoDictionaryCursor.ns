// protoDictionaryCursor: a cursor over the words of a protoDictionary,
// behaving like a soup cursor (Next, Prev, Move, Entry, Reset ...).  Moving
// and reading are native (class #132: a C function pointer and its argument
// count).  Its entries are frames {word, attribute, terminalClass}.
//   dict           the dictionary it walks
//   prefix, pin, loc   where it starts: the words beginning with prefix
//                  (pin: only those), at the 'first or 'last of them
//   currentEntry   the frame PrivateEntry fills in with the current word
// protoCursorWindow keeps a buffer of the entries around the cursor for a
// list on screen.

protoDictionaryCursor := {
	dict: nil,
	cursor: nil,
	index: nil,
	validTest: nil,
	currentEntry: nil,
	// answers a copy of the cursor at the same place
	clone: func() begin
		local privateClone;
		(privateClone := self:PrivateClone()).currentEntry := Clone(currentEntry);
		privateClone.index := Clone(index);
		privateClone.validTest := Clone(validTest);
		return privateClone
	end,
	// the current word, nil past the end
	ThisWord: func() begin
		(if self:PrivateEntry(currentEntry) then return currentEntry.word else return nil)
	end,
	Next: {class: #132, funcPtr: 6995424, numArgs: 0},
	PrivateClone: {class: #132, funcPtr: 6994397, numArgs: 0},
	// back to the start; a cursor made without a prefix walks every word
	Reset: func() begin
		if (not prefix) then begin
				self.prefix := "";
				self.pin := true;
				self.loc := 'first
			end;
		self.currentEntry := {word: nil, attribute: nil, terminalClass: nil};
		self:PrivateReset(prefix, pin, loc)
	end,
	// Map(fn): calls fn with each entry from the start; answers nil.  fn is
	// given currentEntry itself, which the next step overwrites.
	|map|: func(a1) begin
		self:Reset();
		(while self:ThisWord() do begin
				call a1 with (currentEntry);
				self:Next()
			end);
		return nil
	end,
	// Move(n): steps n entries (back when negative) as far as it can;
	// answers how far it moved, signed
	move: func(maxLines) begin
		local l1, l2, abs2;
		l1 := (if (maxLines < 0) then 'prev else 'Next);
		l2 := 0;
		abs2 := abs(maxLines);
		(while (l2 < abs2) do begin
				if (not Perform(self, l1, [Array: ])) then begin
						break
					end;
				(l2 := (l2 + 1))
			end);
		return (l2 * (if (maxLines < 0) then -1 else 1))
	end,
	// to the first entry, by stepping back as far as it goes
	first: func() begin
		(while self:prev() do nil)
	end,
	// reads the current entry (into nothing): answers whether there is one
	word: func() begin
		self:PrivateEntry(nil)
	end,
	PrivateReset: {class: #132, funcPtr: 6995426, numArgs: 3},
	// to the last entry
	last: func() begin
		(while self:Next() do nil)
	end,
	// the current entry's terminalClass
	terminalClass: func() begin
		self:entry().terminalClass
	end,
	// not implemented: always throws
	GotoKey: func(a1) begin
		Throw('|evt.ex.msg|, "GotoKey NYI")
	end,
	// answers a copy of the current entry, nil past the end
	entry: func() begin
		(if self:PrivateEntry(currentEntry) then return Clone(currentEntry) else return nil)
	end,
	// MakeWindow(n): answers a protoCursorWindow buffering n entries
	MakeWindow: func(numLines) begin
		local frame2;
		frame2 := {_proto: protoCursorWindow};
		frame2:Initialize(self, numLines);
		return frame2
	end,
	// ChangeAttribute(attribute): sets the current word's attribute
	ChangeAttribute: func(word) begin
		(if (if dict then currentEntry.word) then dict:ChangeAttribute(currentEntry.word, word))
	end,
	PrivateEntry: {class: #132, funcPtr: 6995427, numArgs: 1},
	// frees the cursor and takes it off its dictionary's list
	Dispose: func() begin
		if dict then begin
				SetRemove(dict.cursors, self);
				RemoveSlot(self, 'dict)
			end;
		self:PrivateDispose()
	end,
	// the current entry's attribute
	attribute: func() begin
		self:entry().attribute
	end,
	PrivateDispose: {class: #132, funcPtr: 6994398, numArgs: 0},
	// a window on the cursor for a scrolling list: buffer holds bufferSize
	// entries from the cursor's place on; dipStick is how many are filled;
	// cursorLoc is the buffer index the cursor is at (-1: none)
	protoCursorWindow: {
		buffer: nil,
		bufferSize: nil,
		dipStick: nil,
		cursor: nil,
		cursorLoc: nil,
		lastQuery: nil,
		// what a buffered entry is shown as; the entry itself here
		entryFilter: func(a1) begin
			a1
		end,
		// Initialize(cursor, size): makes the buffer and fills it; answers self
		Initialize: func(a1, singleSelect) begin
			self.buffer := Array(singleSelect, nil);
			self.bufferSize := singleSelect;
			self.cursor := a1;
			self.dipStick := self:FillBuffer();
			return self
		end,
		// the key of buffered entry i, as entryFilter makes it
		EntryKey: func(a1) begin
			(if (Length(buffer) > a1) then call entryFilter with (buffer[a1]))
		end,
		// buffered entry i
		GetEntry: func(i) begin
			(if (Length(buffer) > i) then buffer[i])
		end,
		GetBuffer: func() begin
			return buffer
		end,
		// how many entries are buffered
		GetNumberEntries: func() begin
			return dipStick
		end,
		GetBufferSize: func() begin
			return bufferSize
		end,
		GetCursor: func() begin
			return cursor
		end,
		// Scroll(n): moves the window by n entries and refills it, checking
		// before and after that the cursor sits on an entry; answers how far
		// the cursor moved.  (moveCursor is set to 0 and at once replaced.)
		Scroll: func(arrowDirection) begin
			local moveCursor, l2;
			if (if (dipStick > 0) then (not cursor:entry())) then begin
					Throw('|evt.ex.msg|, "cursorLoc out of whack before Scroll")
				end;
			moveCursor := 0;
			moveCursor := self:MoveCursor((arrowDirection - cursorLoc));
			if (not cursor:entry()) then begin
					if (arrowDirection < 0) then begin
							self:MoveCursor(1)
						end else begin
							self:MoveCursor(-1)
						end
				end;
			self:FillBuffer();
			if (if (dipStick > 0) then (not cursor:entry())) then begin
					Throw('|evt.ex.msg|, "cursorLoc out of whack after Scroll")
				end;
			return moveCursor
		end,
		// back to the cursor's start and refilled
		Reset: func() begin
			cursor:Reset();
			self:FillBuffer()
		end,
		// Reposition(prefix): the window from the first word with prefix
		Reposition: func(word) begin
			cursor:Initialize(word, nil, 'first);
			self:FillBuffer()
		end,
		// RepositionLast(prefix): the window from the last word with prefix
		RepositionLast: func(a1) begin
			cursor:Initialize(a1, nil, 'last);
			self:FillBuffer()
		end,
		// fills the buffer from the cursor on, clears the rest and leaves the
		// cursor on the last entry read; answers the count filled.  The
		// decompiler places the local after its use.
		FillBuffer: func() begin
			if ((fillFromEntry := self:FillFromEntry(0, bufferSize)) = 0) then begin
					cursorLoc := -1
				end;
			local fillFromEntry;
			(for i := fillFromEntry to (bufferSize - 1) do begin
					buffer[i] := nil
				end);
			if (not cursor:entry()) then begin
					self:MoveCursor(-1)
				end;
			(dipStick := (cursorLoc + 1))
		end,
		// MoveCursor(n): moves the cursor and cursorLoc with it; answers the
		// distance moved
		MoveCursor: func(a1) begin
			local move;
			move := cursor:move(a1);
			cursorLoc := (cursorLoc + move);
			return move
		end,
		// FillFromEntry(start, count): copies up to count entries from the
		// cursor into the buffer from index start; answers how many
		FillFromEntry: func(a1, bufferSize) begin
			local l1, l2, entry;
			l1 := a1;
			l2 := (a1 + bufferSize);
			if (if (entry := cursor:entry()) then (l1 < l2)) then begin
					(loop begin
							if (not entry) then begin
									break
								end else begin
									buffer[l1] := entry
								end;
							(if ((l1 := (l1 + 1)) = l2) then break else begin
									cursorLoc := l1;
									if (not cursor:Next()) then begin
											break
										end;
									(entry := cursor:entry())
								end)
						end)
				end;
			return (l1 - a1)
		end,
		// SlideUp(n): moves the buffered entries n places towards the end
		// (dropping those that fall off), leaving n empty places at the start
		SlideUp: func(a1) begin
			local l1;
			(for i := ((l1 := (dipStick - max(0, ((dipStick + a1) - bufferSize)))) - 1) to 0 by -1 do begin
					buffer[(i + a1)] := buffer[i]
				end);
			(for i := 0 to (a1 - 1) do begin
					buffer[i] := nil
				end);
			cursorLoc := (cursorLoc + a1);
			(dipStick := (a1 + l1))
		end,
		// SlideDown(n): moves the buffered entries n places towards the
		// start, emptying the last n.  The decompiler places the local after
		// its use.
		SlideDown: func(a1) begin
			l1 := (bufferSize - a1);
			local l1;
			(for i := 0 to (l1 - 1) do begin
					buffer[i] := buffer[(i + a1)]
				end);
			(for i := l1 to (bufferSize - 1) do begin
					buffer[i] := nil
				end);
			cursorLoc := (cursorLoc - a1);
			(dipStick := (dipStick - a1))
		end
	},
	prev: {class: #132, funcPtr: 6995425, numArgs: 0},
	// Initialize(prefix, pin, loc): sets where the cursor walks and puts it
	// at its start (currentEntry is set twice; the first frame is discarded)
	Initialize: func(a1, singleSelect, loc) begin
		self.prefix := a1;
		self.pin := singleSelect;
		self.loc := loc;
		self.currentEntry := {};
		self.currentEntry := {word: nil, attribute: nil, terminalClass: nil};
		self:PrivateReset(a1, singleSelect, loc)
	end
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

Reset_literal6 := same("protoDictionaryCursor.Reset.literals[6]");

first_code := same("protoDictionaryCursor.first.instructions");

Reposition_code := same("protoDictionaryCursor.protoCursorWindow.Reposition.instructions");
