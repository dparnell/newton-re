	GetRoutingTitle: func(fromRef, a2, a3) begin
		if (if fromRef then (IsArray(fromRef) = nil)) then begin
				text := self:Get(fromRef, primaryPath, 'text)
			end else begin
				if (if fromRef then (Length(fromRef) > 0)) then begin
						local text;
						(foreach item in fromRef do begin
