		end),
	// dataDef:Get(object, fieldPath, format) - the primary path through
	// GetPrimaryValue; another column of a group is its number of members
	// ("(n members)" as text); anything else as protoNameRefDataDef gets it.
	Get: func(a1, a2, a3) begin
		local objSlot, count;
		if (if (not (a2 = primaryPath)) then (not (ObjEntryClass(a1) = 'group))) then begin
				return inherited:Get(a1, a2, a3)
			end;
		if (a2 = primaryPath) then begin
				return self:GetPrimaryValue(a1, a3)
			end;
		if IsArray((objSlot := self:GetObjSlot(a1, a2))) then begin
				count := Length(objSlot)
			end else begin
				if a1.members then begin
						count := Length(a1.members)
					end else begin
						count := 0
					end
			end;
		(if (a3 = 'text) then return ParamStr("(^0 members)", [Array: count]) else return objSlot)
	end,
	// A tap on a group only toggles its selection (a group is not edited here);
	// others as protoNameRefDataDef handles them.
	HitItem: func(a1, trackScrollingItem) begin
		local l1;
		(if (ObjEntryClass(a1.nameRef) = 'group) then begin
				trackScrollingItem:Tapped('Toggle);
				_tapinfo := nil;
				_dirtyPaths := nil;
				(_dirtyValues := nil)
			end else inherited:HitItem(a1, trackScrollingItem))
	end,
	// Copies slot item of nameRef into its entry; for the primary path the
	// entry's sorton is remade too ("last first" for a person or owner,
	// "Untitled ..." for none) and Names is told the entry's class
	// (SetIAClass).
	ModifyEntryPath: compile(
		constants: {
			kLiteral_4559fd: {person: SetClass(Clone("Untitled Person"), '|string.noData|), owner: SetClass(Clone("Untitled Owner"), '|string.noData|), company: SetClass(Clone("Untitled Company"), '|string.noData|), group: SetClass(Clone("Untitled Group"), '|string.noData|), worksite: SetClass(Clone("Untitled Worksite"), '|string.noData|)}
		},
		func(nameRef, entryFromObj, item) begin
			local objEntryClass2, l2;
			objEntryClass2 := ObjEntryClass(nameRef);
			(if (item = primaryPathMapper.(objEntryClass2)) then begin
					l2 := (entryFromObj.(item) := nameRef.(item));
					entryFromObj.sorton := (if l2 then (if ((objEntryClass2 = 'person) or (objEntryClass2 = 'owner)) then (if l2.last then ParamStr("^1 ^0", [Array: l2.first, l2.last]) else (if l2.first then l2.first)) else l2) else Clone(kLiteral_4559fd.(objEntryClass2)));
					GetRoot().cardfile:SetIAClass(entryFromObj)
				end else (entryFromObj.(item) := nameRef.(item)))
		end),
	// dataDef:ModifyEntry(nameRef, paths) - as protoNameRefDataDef's, each path
	// through ModifyEntryPath.
	ModifyEntry: func(nameRef, equivalent) begin
		if (entryFromObj2 := EntryFromObj(nameRef)) then begin
				local entryFromObj2;
				(foreach item in equivalent do begin
						self:ModifyEntryPath(nameRef, entryFromObj2, item)
					end);
				EntryChangeXmit(entryFromObj2, 'entryChanged)
			end;
		entryFromObj2
	end,
	// dataDef:NewEntry(nameRef, context) - adds the new card through the Names
	// application (cardfile:addcard), in the name reference's folder (labels).
	// Returns the entry.
	NewEntry: func(a1, _context) begin
		local addcard;
		(addcard := GetRoot().cardfile:addcard((addcard := self:PrepareToAdd(a1)).class, addcard)).labels := a1.labels;
		self:FixupPostAdd(a1, addcard);
		EntryChangeXmit(addcard, 'entryAdded);
		addcard
	end,
	// The edited paths whose values changed: a name when either part (first,
	// last) differs as a string, another slot when it differs and is not an
	// equal string.
	Equivalent: func(nameRef, _dirtyValues, _dirtyPaths) begin
		list := [Array: ];
		local list;
		(foreach item in _dirtyPaths do begin
				if (item = 'name) then begin
						if (nameRef.name <> _dirtyValues.name) then begin
								if (((not (if nameRef.name then _dirtyValues.name)) or (if (nameRef.name.last <> _dirtyValues.name.last) then (not (if (if nameRef.name.last then _dirtyValues.name.last) then StrEqual(nameRef.name.last, _dirtyValues.name.last))))) or (if (nameRef.name.first <> _dirtyValues.name.first) then (not (if (if nameRef.name.first then _dirtyValues.name.first) then StrEqual(nameRef.name.first, _dirtyValues.name.first))))) then begin
										AddArraySlot(list, item)
									end
							end
					end else begin
						if (if (nameRef.(item) <> _dirtyValues.(item)) then (not (if (if IsInstance(nameRef.(item), 'string) then IsInstance(_dirtyValues.(item), 'string)) then StrEqual(nameRef.(item), _dirtyValues.(item))))) then begin
								AddArraySlot(list, item)
							end
					end
			end);
		list
	end,
	// The invalid paths (ValidityCheck), the primary path checked in the slot
