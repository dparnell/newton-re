					if ((not IsString(text)) or (not StrFilled(text))) then begin
							if (not (objEntryClass2 := ObjEntryClass(a1))) then begin
									objEntryClass2 := entryType
								end;
							if (not (text := Clone(kLiteral_4559fd.(objEntryClass2)))) then begin
									text := Clone(kLiteral_450465)
								end
						end
				end;
