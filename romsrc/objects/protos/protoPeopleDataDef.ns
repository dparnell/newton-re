								text2 := self:Get(item, primaryPath, 'text);
								if (if text then StrFilled(text)) then begin
										text := ParamStr("^0, ^1", [Array: text, text2])
									end else begin
										text := text2
									end;
								if (if a3 then a2) then begin
										if (StrFontWidth(text, a3) > a2) then begin
												break
											end
									end
							end);
						if (if (if (if text then StrFilled(text)) then a3) then a2) then begin
								text := StyledStrTruncate(Clone(text), a2, a3)
