// protoPeopleDataDef: the data definition (on protoNameRefDataDef) for
// picking Names entries - people, owners, companies, groups and worksites -
// in a protoListpicker, used for routing (e-mail, fax, beam ...): it shows
// each entry's primary value (a person's name, a company ...), adds new
// entries through the Names application (cardfile), and turns name
// references into routing information (GetRoutingInfo, GetRoutingTitle).

protoPeopleDataDef := {
	_proto: @protoNameRefDataDef,
	name: @cardfileSoupName,
	class: '|nameRef.people|,
	entryType: 'person,
	// the slot shown in the first column, and the one each class of entry
	// keeps it in
	primaryPath: 'name,
	primaryPathMapper: {person: 'name, owner: 'name, company: 'company, group: 'group, worksite: 'place},
	preferredRouting: nil,
	// the slot of the routing information (an address) a subclass routes to
	routePath: nil,
	validationFrame: @nameRefValidationFrame,
	defaultEditTitle: "New Person",
	// the Names soup in sorton order, keeping only the classes this lists
	querySpec: {
		type: 'index,
		indexPath: 'sorton,
		// people, companies, owners, groups, or plain frames
		validTest: func(a1) begin
			local cls;
			((((IsSubclass((cls := ClassOf(a1)), 'person) or IsSubclass(cls, 'company)) or IsSubclass(cls, 'owner)) or IsSubclass(cls, 'group)) or (cls = 'frame))
		end
	},
	// dataDef:MakeNameRef(object, class) - a canonical name reference holding the
	// object's primary value in the primary path for its class; a plain string
	// given for a name becomes {last: string}.
	MakeNameRef: func(frame3, cls) begin
		local canonicalNameRef, frame2, primaryPath, entryFromObj2;
		canonicalNameRef := self:MakeCanonicalNameRef(frame3, cls);
		primaryPath := self:GetPrimaryPath(frame3);
		if IsFrame((entryFromObj2 := (if IsEntryAlias(frame3) then ResolveEntryAlias(frame3) else frame3))) then begin
				if (if (not (frame2 := entryFromObj2.(primaryPath))) then IsNameRef(entryFromObj2)) then begin
						if (entryFromObj2 := EntryFromObj(entryFromObj2)) then begin
								frame2 := entryFromObj2.(primaryPath)
							end
					end
			end else begin
				frame2 := entryFromObj2
			end;
		if (if IsInstance(frame2, 'string) then (primaryPath = 'name)) then begin
				frame2 := {last: frame2}
			end;
		canonicalNameRef.(primaryPath) := frame2;
		canonicalNameRef
	end,
	// The slot holding the object's primary value, by its entry class
	// (primaryPathMapper), else primaryPath.
	GetPrimaryPath: func(a1) begin
		local objEntryClass2, l2;
		if (objEntryClass2 := ObjEntryClass(a1)) then begin
				l2 := primaryPathMapper.(objEntryClass2)
			end;
		(if l2 then l2 else primaryPath)
	end,
	// dataDef:GetPrimaryValue(object, format) - the primary value (from the
	// entry behind an alias or name reference); as 'text a name frame is
	// "first last", as 'sortText "last, first" or the entry's sorton; empty
	// text becomes "Untitled Person" (or the like for the entry's class) or
	// "--", as strings of class 'string.noData.
	GetPrimaryValue: compile(
		constants: {
			kLiteral_4559fd: {person: SetClass(Clone("Untitled Person"), '|string.noData|), owner: SetClass(Clone("Untitled Owner"), '|string.noData|), company: SetClass(Clone("Untitled Company"), '|string.noData|), group: SetClass(Clone("Untitled Group"), '|string.noData|), worksite: SetClass(Clone("Untitled Worksite"), '|string.noData|)},
			kLiteral_450465: SetClass(Clone("--"), '|string.noData|)
		},
		func(a1, a2) begin
			local text, resolveEntryAlias2, entryFromObj2, objEntryClass2;
			if IsEntryAlias(a1) then begin
					resolveEntryAlias2 := ResolveEntryAlias(a1)
				end else begin
					resolveEntryAlias2 := a1
				end;
			if IsFrame(resolveEntryAlias2) then begin
					if IsNameRef(resolveEntryAlias2) then begin
							if (entryFromObj2 := EntryFromObj(resolveEntryAlias2)) then begin
									resolveEntryAlias2 := entryFromObj2
								end
						end;
					if resolveEntryAlias2 then begin
							text := resolveEntryAlias2.(self:GetPrimaryPath(a1))
						end
				end else begin
					text := resolveEntryAlias2
				end;
			if ((a2 = 'sortText) or (a2 = 'text)) then begin
					if IsFrame(text) then begin
							if (a2 = 'sortText) then begin
									text := ParamStr("^?0^?1^0, ^1|^0||^1|", [Array: text.last, text.first])
								end else begin
									text := ParamStr("^?0^?1^0 ^1|^0||^1|", [Array: text.first, text.last])
								end;
							if (if (if (a2 = 'sortText) then IsFrame(resolveEntryAlias2)) then resolveEntryAlias2.sorton) then begin
									text := resolveEntryAlias2.sorton
								end
