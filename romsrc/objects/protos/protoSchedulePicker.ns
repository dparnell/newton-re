// protoSchedulePicker, and what only it reaches

protoSchedulePicker := {
	_proto: @protoAddressPicker,
	textSlot: nil,
	viewFont: tsSystem + tsSize(9) + tsBold,
	singleSelect: nil,
	viewQuitScript: func() begin
		nil
	end,
	DoOpenPicker: func() begin
		local copy;
		if (if pickerSlip then pickerSlip.viewCObject) then begin
				return nil
			end;
		inPeoplePicker := true;
		if singleSelect then begin
				(copy := Clone(GetDataDefs(class))).singleSelect := true
			end else begin
				copy := class
			end;
		(pickerSlip := _picker:New(copy, DeepClone(selected), self, nil))
	end,
	AddMemoryItem: func() begin
		(if (if selected then (Length(selected) > 0)) then AddMemoryItemUnique(memory, selected, func(a1, a2) begin
				self:ToRefEquality(a1, a2)
			end))
	end,
	ToRefEquality: func(a1, a2) begin
		local dataDefs, textFromRef, textFromRef2;
		dataDefs := GetDataDefs(class);
		textFromRef := self:TextFromRef(a1);
		textFromRef2 := self:TextFromRef(a2);
		(if (if StrFilled(textFromRef) then StrFilled(textFromRef2)) then StrEqual(textFromRef, textFromRef2))
	end,
	TextFromRef: func(selected) begin
		dataDefs := GetDataDefs(class);
		if (if (if selected then (IsArray(selected) = nil)) then dataDefs) then begin
				text := dataDefs:Get(selected, textSlot, 'text)
			end else begin
				if (if (if selected then (Length(selected) > 0)) then dataDefs) then begin
						local text;
						local dataDefs;
						(foreach item in selected do begin
								local text2, box, l7;
								text2 := dataDefs:Get(item, textSlot, 'text);
								if (if text then StrFilled(text)) then begin
										text := ParamStr("^0, ^1", [Array: text, text2])
									end else begin
										text := text2
									end
							end);
						if (if text then StrFilled(text)) then begin
								box := self:LocalBox();
								l7 := 12291;
								text := StrTruncate(text, ((box.right - box.left) - indent))
							end else begin
								text := "???"
							end
					end else begin
						text := "None"
					end
			end;
		text
	end
};
