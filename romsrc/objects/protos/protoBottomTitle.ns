// protoBottomTitle: a protoTitle placed along the bottom of its parent
// instead of the top.

protoBottomTitle := {
	_proto: @protoTitle,
	viewJustify: vjCenterV + vjParentFullH + vjParentBottomV,
	// at setup: measures the title (its height from the font unless given)
	// and sets the bounds to a strip one title high at the parent's bottom
	viewSetupFormScript: func() begin
		if (not titleHeight) then begin
				titleHeight := FontHeight(viewFont)
			end;
		titleWidth := StrFontWidth(title, viewFont);
		(self.viewBounds := SetBounds(0, ((-titleHeight) + 2), 0, 2))
	end,
	debug: 2904837
};
