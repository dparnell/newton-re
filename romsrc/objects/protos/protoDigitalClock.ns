							l3 := '{left: 3, top: 2, right: 20, bottom: 26};
							l4 := '{left: 25, top: 2, right: 42, bottom: 26}
						end;
					DrawXBitmap('{left: 0, top: 0, right: 45, bottom: 28}, kROM_651, l5, 0);
					if l11 then begin
							DrawXBitmap(l3, kROM_622, l10, 1)
