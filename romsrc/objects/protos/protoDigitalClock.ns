					DrawXBitmap('{left: 55, top: 2, right: 72, bottom: 26}, kROM_622, (l9 div 10), 1);
					DrawXBitmap('{left: 77, top: 2, right: 94, bottom: 26}, kROM_622, (l9 mod 10), 1);
					(if useAmPm then DrawXBitmap('{left: 100, top: 0, right: 119, bottom: 28}, kROM_604, (l7 div 720), 0))
				end),
			viewClickScript: func(unit) begin
				local box, increment2, l3, l4, l5, l6, time2, least, most, copy;
				InkOff(unit);
				box := self:GlobalBox();
				if ((l3 := (GetPoint(0, unit) - box.left)) > 100) then begin
						increment2 := 720
