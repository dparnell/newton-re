// protoKeyboard, and what only it reaches

protoKeyboard := {
	_proto: @protoFloater,
	textFlags: nil,
	viewBounds: nil,
	saveBounds: nil,
	freeze: nil,
	firstTime: true,
	viewSetupFormScript: func() begin
		local caretBox, box, l3;
		if firstTime then begin
				self.viewBounds := Clone(saveBounds)
			end;
		box := self:GlobalBox();
		caretBox := GetCaretBox();
		if (if (if (if (if (not freeze) then firstTime) then caretBox) then (box.top < caretBox.bottom)) then (box.bottom > caretBox.top)) then begin
				l3 := ((caretBox.top - box.bottom) - 32);
				if ((box.top + l3) > 8) then begin
						viewBounds := OffsetRect(viewBounds, 0, l3)
					end
			end;
		if (if currentKeyboard then (currentKeyboard <> self)) then begin
				currentKeyboard:Close()
			end;
		currentKeyboard := self;
		(firstTime := nil)
	end,
	viewQuitScript: func() begin
		if (currentKeyboard = self) then begin
				currentKeyboard := nil
			end;
		(firstTime := true)
	end,
	debug: 363708
};
