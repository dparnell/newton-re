// protoSoupOverview, and what only it reaches

protoSoupOverview := {
	_proto: @protoOverview,
	Abstract: func(items2Item, copy) begin
		nil
	end,
	viewSetupChildrenScript: func() begin
		self:SetupAbstracts(cursor:clone())
	end,
	SelectItem: SelectItem,
	HitItem: func(a1, trackScrollingItem, trackScrollingItem2) begin
		(if (not inherited:HitItem(a1, trackScrollingItem, trackScrollingItem2)) then begin
				self:Dirty();
				true
			end)
	end,
	isSelected: isSelected,
	Scroller: Scroller,
	ForEachSelected: ForEachSelected
};
