// protoKeyboardButton, and what only it reaches

protoKeyboardButton := {
	viewBounds: {left: 5, top: 0, right: 28, bottom: 13},
	icon: @keyButtonBitmap,
	defaultKeyboard: nil,
	buttonClickScript: func() begin
		if (not (if defaultKeyboard then GetVariable(self, defaultKeyboard))) then begin
				defaultKeyboard := _popupKeyboards[0]
			end;
		if (if root.currentKeyboard then (root.currentKeyboard <> defaultKeyboard)) then begin
				if HasPath(root, 'currentKeyboard.keyboardSymbol) then begin
						defaultKeyboard := root.currentKeyboard.keyboardSymbol
					end else begin
						defaultKeyboard := root.currentKeyboard.preallocatedContext
					end
			end;
		userName := GetVariable(self, defaultKeyboard).userName;
		local userName;
		local l2;
		l2 := (foreach item in _popupKeyboards collect begin
			local value;
			GetVariable(self, item).userName
		end);
		if (defaultPos := ArrayPos(l2, userName, 0, nil)) then begin
				l2[defaultPos] := {item: userName, mark: $\uFC0B, pickable: true}
			end;
		(if root.currentKeyboard then self:PopupMenu(l2, nil) else (if (value := GetVariable(self, defaultKeyboard)) then value:Open()))
	end,
	pickActionScript: func(index) begin
		local _popupKeyboard, value, value2;
		_popupKeyboard := _popupKeyboards[index];
		(if (value := GetVariable(self, _popupKeyboard)).viewCObject then value:MoveBehind(nil) else begin
				if (value2 := GetVariable(self, defaultKeyboard)) then begin
						value2:Close()
					end;
				defaultKeyboard := _popupKeyboard;
				value:Open()
			end)
	end,
	SetDefaultKeyboard: func(a1) begin
		(if ArrayPos(_popupKeyboards, a1, 0, nil) then (defaultKeyboard := a1))
	end,
	SetKeyboardList: func(a1, a2) begin
		local copy;
		copy := Clone(GetVariable(self, '_popupKeyboards));
		if (if (ClassOf(a2) = 'symbol) then (a2 = 'noGlobalKeyboards)) then begin
				copy := SetUnion([Array: ], a1, true)
			end else begin
				copy := SetUnion((copy := SetDifference(copy, a2)), a1, true)
			end;
		(self._popupKeyboards := copy)
	end,
	GetKeyboardList: func() begin
		_popupKeyboards
	end,
	_proto: @protoPictureButton
};
