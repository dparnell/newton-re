// protoPictTextButton, and what only it reaches

protoPictTextButton := {
	_proto: @protoTextButton,
	viewClass: clView,
	viewBounds: nil,
	text: uCardPositionAlertButton,
	icon: nil,
	pix: nil,
	viewDrawScript: func() begin
		local box, l2, l3, fontAscent2, fontHeight2, l6;
		if (not pix) then begin
				box := self:LocalBox();
				l2 := ((StrFontWidth(text, viewFont) + 2) + icon.bounds.right);
				l3 := ((box.right - l2) div 2);
				fontAscent2 := FontAscent(viewFont);
				fontHeight2 := FontHeight(viewFont);
				l6 := ((box.bottom - fontHeight2) div 2);
				pix := [Array: OffsetShape(MakeShape(icon), l3, ((box.bottom - icon.bounds.bottom) div 2)), MakeText(text, ((l3 + 2) + icon.bounds.right), l6, box.right, (l6 + fontAscent2))]
			end;
		self:DrawShape(pix, {font: viewFont})
	end
};
