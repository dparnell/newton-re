// protoLongitudePicker, and what only it reaches

protoLongitudePicker := {
	_proto: @protoLatitudePicker,
	maxValue: 10800,
	minValue: -10800,
	icon: nil,
	compass: @eastwestBitmap,
	viewChildren: [viewChildren:
		protoLatitudePickerItem,
		protoLatitudePickerItem_2,
		minutes10,
		hours1,
		hours10,
		{
			viewBounds: {left: -22, top: 0, right: 0, bottom: 28},
			icon: @digitflap,
			increment: 6000,
			GetIndex: func(value) begin
				((abs(value) div 6000) mod 10)
			end,
			_proto: @protoDigit
		}
	]
};
