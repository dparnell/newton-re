// protoIoStateMachine: a protoStateMachine that runs one data exchange over
// an endpoint ("Data Exchange"): instantiate, bind, then listen and accept
// (mode 'InputFrame), or connect (modes 'OutputFrame and 'AutoInAndOut);
// receive frames (InputSpec, each passed to the callback as 'data) and/or
// send the queued ones (AddSendData); then disconnect, unbind, dispose and
// report 'complete or 'error to the callback. Each state is a frame: action
// returns the next state's name, or 'waitAsync to wait for the endpoint's
// completion, which goes to WaitComplete (OnError on an error).

protoIoStateMachine := {
	// wait for a connection
	DoListen: {
		action: func() begin
			fEndpoint:Listen(fOptionsOut, CallbackSpec);
			'waitAsync
		end,
		WaitComplete: 'DoAccept,
		OnError: 'DoDisconnect
	},
	// send everything queued by AddSendData as one dataArray, and empty the queue
	DoOutput: {
		action: func() begin
			local frame2;
			fEndpoint:output((frame2 := {dataArray: Clone(fOutgoingData)}), fOptionsOut, CallbackSpec);
			fOutgoingData := [Array: ];
			'waitAsync
		end,
		WaitComplete: 'DoAfterOutput,
		OnError: 'DoDisconnect
	},
	// the modes SetMode accepts: receive, send, or (IR) agree who sends first and do both
	legalModes: {InputFrame: true, OutputFrame: true, AutoInAndOut: true},
	// The endpoint's ExceptionHandler (installed by SetEndpoint; self is the
	// endpoint): the state machine's DoError says which state to run, if any.
	StdExceptionHandler: func(a1) begin
		local error;
		(if (error := stateMachine:DoError(a1)) then stateMachine:Run(error))
	end,
	// The options the endpoint returned last.
	GetOptions: func() begin
		return fOptionsIn
	end,
	// machine:SetCallback(fn) - fn(what, value) is called with ('data, frame)
	// for each frame received, then ('complete, nil) or ('error, exception).
	SetCallback: func(singleSelect) begin
		(self.fCallBack := singleSelect)
	end,
	// the options passed to the endpoint's calls (SetOptions)
	fOptionsOut: nil,
	// how many transfers (input or output) have been done
	fStage: 0,
	fOptionsIn: nil,
	// machine:SetEndpoint(endpoint, configOptions) - the endpoint to use: a
	// frame on it carrying its config options, StdExceptionHandler and a link
	// back to the machine; the endpoint's _parent, if any, is copied into the
	// new frame's own slot.
	SetEndpoint: func(frame2, list) begin
		(if (fEndpoint := {_proto: frame2, configOptions: list, ExceptionHandler: StdExceptionHandler, stateMachine: self})._parent then (fEndpoint._parent := fEndpoint._parent))
	end,
	// 'InputFrame, 'OutputFrame or 'AutoInAndOut (SetMode)
	fMode: nil,
	_proto: @protoStateMachine,
	// how many asynchronous endpoint calls are outstanding (see Cancel)
	occupancy: 0,
	DoConnect: {
		action: func() begin
			fEndpoint:Connect(fOptionsOut, CallbackSpec);
			'waitAsync
		end,
		WaitComplete: 'DoPostConnect,
		OnError: 'DoUnbind
	},
	// machine:SetOptions(options) - the options for the endpoint's calls.
	SetOptions: func(a1) begin
		(fOptionsOut := a1)
	end,
	// (cancelBlocked: Cancel does nothing while the machine is in this state)
	DoDispose: {
		cancelBlocked: true,
		action: func() begin
			fEndpoint:Dispose();
			'DoCompletion
		end,
		OnError: 'DoCompletion
	},
	// the default callback: ignores everything
	fCallBack: func(a1, a2) begin
		nil
	end,
	// the first state
	DoInstantiate: {
		action: func() begin
			fEndpoint:Instantiate(fEndpoint, fEndpoint.configOptions);
			'DoBind
		end,
		OnError: 'DoCompletion
	},
	fEndpoint: nil,
	// machine:AddSendData(frame) - queues a frame to send (nil adds nothing).
	AddSendData: func(body) begin
		if IsReadOnly(fOutgoingData) then begin
				fOutgoingData := Clone(fOutgoingData)
			end;
		(if body then AddArraySlot(fOutgoingData, body))
	end,
	// after sending: in 'AutoInAndOut, receive if that was the first transfer; else done
	DoAfterOutput: {
		action: func() begin
			fStage := (fStage + 1);
			(if (if (fMode = 'AutoInAndOut) then (fStage < 2)) then 'DoInputSpec else 'DoDisconnect)
		end,
		OnError: 'DoDisconnect
	},
	fOutgoingData: [|Array|: ],
	DoUnbind: {
		cancelBlocked: true,
		action: func() begin
			fEndpoint:Unbind(CallbackSpec);
			'waitAsync
		end,
		WaitComplete: 'DoDispose,
		OnError: 'DoDispose
	},
	// after receiving: in 'AutoInAndOut, send if that was the first transfer; else done
	DoAfterInput: {
		action: func() begin
			fStage := (fStage + 1);
			(if (if (fMode = 'AutoInAndOut) then (fStage < 2)) then 'DoOutput else 'DoDisconnect)
		end,
		OnError: 'DoDisconnect
	},
	// after the "irco" option of DoPostConnect: the 2 bit of its result says
	// whether this side sends first (set) or receives first (clear)
	DoExchangePostConnect: {
		action: func() begin
			(if (BAnd(fOptionsIn[0].data.arglist[0], 2) = 0) then 'DoInputSpec else 'DoOutput)
		end,
		OnError: 'DoDisconnect
	},
	// the last state: notify the user if autoNotify (Notify level 4), then the
	// callback with 'error or 'complete; 'exit stops the machine
	DoCompletion: {
		cancelBlocked: true,
		action: compile(
			constants: {
				kLiteral_4974a9: "Data Exchange"
			},
			func() begin
				if autoNotify then begin
						if fException then begin
								GetRoot():Notify(4, kLiteral_4974a9, EnsureInternal(Stringer([Array: "Data Exchange (", fException.data, ")"])))
							end else begin
								GetRoot():Notify(4, kLiteral_4974a9, "Data Exchange completed successfully")
							end
					end;
				if fException then begin
						call fCallBack with ('error, fException)
					end else begin
						call fCallBack with ('complete, nil)
					end;
				'exit
			end),
		OnError: 'exit
	},
	fTimeout: 200000,
	// machine:Cancel() - cancels the endpoint's outstanding call, unless nothing
	// is outstanding or the current state blocks cancelling. The cancel's
	// completion (kFunction_4977bd: a1 the endpoint, a2 the options, a3 the
	// result) completes the machine's wait with the result, or
	// kCommErrRequestCanceled, once it is the last outstanding call. An
	// exception other than kEndpointErrAborting from Cancel is passed on.
	Cancel: compile(
		constants: {
			// the cancel's completion script
			kFunction_4977bd: func(a1, a2, a3) begin
				local stateMachine;
				if (stateMachine := a1.stateMachine).tracing then begin
						stateMachine:Trace("Cancel completion", {result: a3, occupancy: stateMachine.occupancy})
					end;
				stateMachine.fOptionsIn := a2;
				(if (stateMachine.occupancy <= 1) then stateMachine:AsyncWaitComplete((if a3 then a3 else kCommErrRequestCanceled)) else (stateMachine.occupancy := (stateMachine.occupancy - 1)))
			end,
			kLiteral_4977dd: {_proto: @protoStateMachineInputSpec, completionscript: kFunction_4977bd}
		},
		func() begin
			if tracing then begin
					self:Trace(Stringer([Array: "Cancel() called.", " ", (if cancelBlocked then "(blocked!)" else "")]), {occupancy: occupancy})
				end;
			(if (if (occupancy > 0) then (not cancelBlocked)) then begin
					occupancy := (occupancy + 1);
					(try begin
							fEndpoint:Cancel(kLiteral_4977dd)
						end onexception |evt.ex| do begin
							occupancy := (occupancy - 1);
							(if (CurrentException().error <> kEndpointErrAborting) then Rethrow())
						end)
				end)
		end),
	// after binding: listen to receive, connect to send (or both)
	DoModeSelect: {
		action: func() begin
			fStage := 0;
			(if (fMode = 'InputFrame) then 'DoListen else (if ((fMode = 'OutputFrame) or (fMode = 'AutoInAndOut)) then 'DoConnect))
		end,
		OnError: 'DoDisconnect
	},
	DoAccept: {
		action: func() begin
			fEndpoint:Accept(fOptionsOut, CallbackSpec);
			'waitAsync
		end,
		WaitComplete: 'DoInputSpec,
		OnError: 'DoDisconnect
	},
	// receive: the input spec (InputSpec) completes into DoPutAway
	DoInputSpec: {
		action: func() begin
			CallbackSpec.rcvOptions := fOptionsOut;
			fEndpoint:SetInputSpec(InputSpec);
			'waitAsync
		end,
		WaitComplete: 'DoPutAway,
		OnError: 'DoDisconnect
	},
	// the frames received (fIncomingData.dataArray) go to the callback as 'data, one by one
	DoPutAway: {
		action: func() begin
			fEndpoint:SetInputSpec(nil);
			fCallBack2 := fCallBack;
			local fCallBack2;
			(foreach item in fIncomingData.dataArray do begin
					call fCallBack2 with ('data, item)
				end);
			'DoAfterInput
		end,
		OnError: 'DoDisconnect
	},
	fIncomingData: nil,
	DoDisconnect: {
		cancelBlocked: true,
		action: func() begin
			fEndpoint:Disconnect(true, CallbackSpec);
			'waitAsync
		end,
		WaitComplete: 'DoUnbind,
		OnError: 'DoUnbind
	},
	// machine:SetMode(mode) - one of legalModes; anything else throws -8608
	// (the state machine error "Invalid mode").
	SetMode: func(a1) begin
		(if legalModes.(a1) then (fMode := a1) else Throw('|evt.ex.proto|, -8608))
	end,
	// after connecting: in 'AutoInAndOut, ask the "irco" option (an IR option, by
	// its name; its current value: opGetCurrent) which side sends first; else send
	DoPostConnect: {
		action: func() begin
			(if (fMode = 'AutoInAndOut) then begin
					fEndpoint:option([Array: Clone('{label: "irco", type: option, opCode: opGetCurrent, form: template, data: {arglist: [Array: 0], typelist: [Array: 10, 1]}})], CallbackSpec);
					'waitAsync
				end else 'DoOutput)
		end,
		WaitComplete: 'DoExchangePostConnect,
		OnError: 'DoDisconnect
	},
	DoBind: {
		action: func() begin
			fEndpoint:Bind(fOptionsOut, CallbackSpec);
			'waitAsync
		end,
		WaitComplete: 'DoModeSelect,
		OnError: 'DoDispose
	}
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

label_value := same("protoIoStateMachine.DoPostConnect.action.literals[2].label");

action_code := same("protoIoStateMachine.DoListen.action.instructions");

action_code_2 := same("protoIoStateMachine.DoAfterOutput.action.instructions");
