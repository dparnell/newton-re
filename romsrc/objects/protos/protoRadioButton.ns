// protoRadioButton: one button of a protoRadioCluster - a protoCheckbox drawn
// with the radio-button bitmaps. Its scripts (shared) tell the cluster when
// it is tapped, so that the cluster turns the others off.

protoRadioButton := {
	_proto: @protoCheckbox,
	// the bitmap drawn now, and the two it switches between
	icon: @radioOffBitmap,
	onBitmap: @radioOnBitmap,
	offBitmap: @radioOffBitmap,
	radioClickScript: radioClickScript,
	viewClickScript: viewClickScript_2,
	debug: 2887824
};
