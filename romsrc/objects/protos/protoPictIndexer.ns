// protoPictIndexer, and what only it reaches

protoPictIndexer := {
	viewClass: clPictureView,
	viewFlags: vVisible + vClickable,
	viewBounds: {left: 0, top: -16, right: 0, bottom: 0},
	viewJustify: vjCenterH + vjCenterV + vjParentFullH + vjParentBottomV,
	viewFormat: vfFillWhite,
	viewBBox: nil,
	startLeft: nil,
	curIndex: -1,
	numIndices: 1,
	_vertical: nil,
	viewSetupDoneScript: func() begin
		viewBBox := self:LocalBox();
		if _vertical then begin
				startLeft := ((viewBBox.bottom - iconBBox.bottom) div 2)
			end else begin
				startLeft := ((viewBBox.right - iconBBox.right) div 2)
			end;
		(if (startLeft < 0) then (startLeft := 0))
	end,
	hiliter: func(a1) begin
		(if (if viewCObject then (a1 >= 0)) then (if _vertical then self:InvertRect(0, (startLeft + ((a1 * iconBBox.bottom) div numIndices)), viewBBox.right, (startLeft + (((a1 + 1) * iconBBox.bottom) div numIndices))) else self:InvertRect((startLeft + ((a1 * iconBBox.right) div numIndices)), 0, (startLeft + (((a1 + 1) * iconBBox.right) div numIndices)), viewBBox.bottom)))
	end,
	unhilite: func() begin
		(if (curIndex >= 0) then begin
				self:DoDrawing('hiliter, [Array: curIndex]);
				(curIndex := -1)
			end)
	end,
	viewDrawScript: func() begin
		self:hiliter(curIndex)
	end,
	viewClickScript: func(a1) begin
		if self:DoDrawing('trackPictHilite, [Array: a1]) then begin
				self:IndexClickScript(curIndex)
			end;
		true
	end,
	IndexClickScript: func(a1) begin
		nil
	end,
	SetHilite: func(a1) begin
		(if (if (a1 <> curIndex) then (a1 >= 0)) then begin
				self:hiliter(curIndex);
				self:hiliter((curIndex := a1))
			end)
	end,
	trackPictHilite: func(a1) begin
		local l1, l2;
		InkOff(a1);
		l1 := self:GlobalBox();
		(loop begin
				if _vertical then begin
						l2 := ((((GetPoint(5, a1) - startLeft) - l1.top) * numIndices) div iconBBox.bottom)
					end else begin
						l2 := ((((GetPoint(4, a1) - startLeft) - l1.left) * numIndices) div iconBBox.right)
					end;
				if (l2 >= numIndices) then begin
						l2 := -1
					end;
				self:SetHilite(l2);
				(if StrokeDone(a1) then break)
			end);
		(if (curIndex >= 0) then curIndex)
	end
};
