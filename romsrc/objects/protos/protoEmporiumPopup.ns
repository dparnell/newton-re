// protoEmporiumPopup, and what only it reaches

protoEmporiumPopup := {
	_proto: @protoPopInPlace,
	viewBounds: {left: 8, top: 10, right: 208, bottom: 23},
	viewFormat: 0,
	viewJustify: vjCenterV,
	viewSetupFormScript: viewSetupFormScript,
	SetupText: func() begin
		local l1, l2;
		(if (l1 := GetUserConfig('currentEmporium)) then begin
				l2 := ResolveEntryAlias(l1);
				Stringer([Array: $\uFC01, l2.place])
			end else Stringer([Array: $\uFC01, GetUserConfig('location).name]))
	end,
	JamIt: JamIt,
	viewDrawScript: viewDrawScript_2,
	buttonClickScript: func() begin
		(if (l2 := GetUserConfig('emporia)) then begin
				local l1;
				local l2;
				local l3;
				l3 := (foreach l4 in l2 collect {item: (if (l1 := ResolveEntryAlias(l4).place) then l1 else "(unnamed location)"), value: l4});
				if (Length(l3) = 0) then begin
						AddArraySlot(place, {item: GetUserConfig('location).name, value: nil})
					end;
				Sort(l3, '|str<|, 'item);
				AddArraySlot(l3, 'pickseparator);
				AddArraySlot(l3, "Other City");
				popup := l3;
				inherited:buttonClickScript()
			end else self:hilite(nil))
	end,
	pickActionScript: func(a1) begin
		if (a1 = (Length(popup) - 1)) then begin
				self:PickOther()
			end else begin
				SetUserConfig('currentEmporium, popup[a1].value);
				UseCurrentEmporium()
			end;
		self:hilite(nil)
	end,
	viewQuitScript: viewQuitScript,
	PickOther: PickOther,
	|map|: {pickActionScript: pickActionScript}
};
