// protoStatusBar: the bar across the bottom of an application that holds
// its clock and buttons (protoStatus adds a close box); it draws a thin
// rule along its top. The time field is a part the bar allocates for each
// instance.

protoStatusBar := {
	viewClass: clView,
	viewFlags: vVisible,
	viewFormat: 0,
	viewJustify: vjParentFullH + vjParentBottomV,
	viewBounds: {left: 0, top: -18, right: 0, bottom: 0},
	// viewDrawScript(): draws a 2-pixel line inset 2 pixels from each side,
	// below the bar's top edge
	viewDrawScript: func() begin
		local box;
		box := self:LocalBox();
		self:DrawShape(MakeRect(2, 4, (box.right - 2), 6), nil)
	end,
	debug: 724016,
	timeField: nil,
	// declares the child whose view is put in the timeField slot when made
	allocateContext: [|Array|: 'timeField, timeField],
	viewChildren: [viewChildren: @analogClock, timeField]
};
