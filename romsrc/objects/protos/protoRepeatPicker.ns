// protoRepeatPicker, and what only it reaches

protoRepeatPicker := {
	viewFont: tsSystem + tsSize(9) + tsBold,
	viewBounds: nil,
	text: "Repeat",
	labelCommands: [|Array|:
		donTRepeat,
		everyDay,
		everyWeek,
		everyOtherWeek,
		everyMonth,
		"Same week each month",
		everyYear,
		"Same week each year",
		otherCategoryName
	],
	currentLabelIndex: nil,
	meetingInstance: nil,
	viewSetupFormScript: func() begin
		local calendar, exception;
		if selectedMeeting.repeatType then begin
				calendar := GetRoot().calendar;
				if (exception := calendar:FindException(originalMtgDate, selectedMeeting)) then begin
						meetingInstance := exception
					end else begin
						meetingInstance := calendar:MakeInstanceOfRepeatingMeeting(selectedMeeting, originalMtgDate)
					end
			end else begin
				meetingInstance := selectedMeeting
			end;
		RepeatingView.meetingInstance := meetingInstance;
		RepeatingView.originalMtgDate := meetingInstance.mtgStartDate;
		inherited:viewSetupFormScript()
	end,
	TextSetup: func() begin
		local repeatTemplate, l2, date2;
		if (repeatTemplate := meetingInstance.repeatTemplate) then begin
				RepeatingView.repeatType := repeatTemplate.repeatType;
				RepeatingView.mtgInfo := repeatTemplate.mtgInfo
			end;
		date2 := Date(meetingInstance.mtgStartDate);
		if (repeatTemplate = nil) then begin
				l2 := 0
			end else begin
				if (if (repeatTemplate.repeatType = 0) then (repeatTemplate.mtgInfo = BOr(4064, 31))) then begin
						l2 := 1
					end else begin
						if (if (repeatTemplate.repeatType = 0) then (repeatTemplate.mtgInfo = BOr((2048 >> date2.dayOfWeek), 31))) then begin
								l2 := 2
							end else begin
								if (repeatTemplate.repeatType = 4) then begin
										l2 := 3
									end else begin
										if (repeatTemplate.repeatType = 2) then begin
												l2 := 4
											end else begin
												if (if (repeatTemplate.repeatType = 1) then (repeatTemplate.mtgInfo = BOr((16 >> ((date2.Date - 1) div 7)), (2048 >> date2.dayOfWeek)))) then begin
														l2 := 5
													end else begin
														if (repeatTemplate.repeatType = 3) then begin
																l2 := 6
															end else begin
																if (repeatTemplate.repeatType = 7) then begin
																		l2 := 7
																	end else begin
																		l2 := 8
																	end
															end
													end
											end
									end
							end
					end
			end;
		currentLabelIndex := l2;
		labelCommands[l2]
	end,
	pickerSetup: func() begin
		(if GetRoot().calendar:IsExceptionMeeting(meetingInstance) then begin
				self:Notify(3, (if appSymbol then GetAppName(appSymbol) else ""), (if (meetingInstance.viewStationery = 'cribNote) then "You cannot change the repeat frequency of an exception event." else "You cannot change the repeat frequency of an exception meeting."));
				self:hilite(nil);
				nil
			end else true)
	end,
	LabelActionScript: func(index) begin
		local date2;
		date2 := Date(newMtgDate);
		if (index = 0) then begin
				RepeatingView.repeatType := 5;
				RepeatingView.mtgInfo := 0
			end else begin
				if (index = 1) then begin
						RepeatingView.repeatType := 0;
						RepeatingView.mtgInfo := BOr(4064, 31)
					end else begin
						if (index = 2) then begin
								RepeatingView.repeatType := 0;
								RepeatingView.mtgInfo := BOr((2048 >> date2.dayOfWeek), 31)
							end else begin
								if (index = 3) then begin
										RepeatingView.repeatType := 4;
										RepeatingView.mtgInfo := (((newMtgDate div 1440) << 8) + 14)
									end else begin
										if (index = 4) then begin
												RepeatingView.repeatType := 2;
												RepeatingView.mtgInfo := date2.Date
											end else begin
												if (index = 5) then begin
														RepeatingView.repeatType := 1;
														RepeatingView.mtgInfo := BOr((16 >> ((date2.Date - 1) div 7)), (2048 >> date2.dayOfWeek))
													end else begin
														if (index = 6) then begin
																RepeatingView.repeatType := 3;
																RepeatingView.mtgInfo := ((date2.month << 8) + date2.Date)
															end else begin
																if (index = 7) then begin
																		RepeatingView.repeatType := 7;
																		RepeatingView.mtgInfo := (((date2.month << 12) + (2048 >> date2.dayOfWeek)) + (16 >> ((date2.Date - 1) div 7)))
																	end else begin
																		RepeatingView:Open()
																	end
															end
													end
											end
									end
							end
					end
			end;
		(currentLabelIndex := index)
	end,
	_proto: @protoLabelPicker
};
