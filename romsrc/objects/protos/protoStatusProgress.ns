				floor2 := floor((viewValue * (box.bottom / (maxValue - minValue))));
				self:DrawShape(MakeRoundRect(box.left, box.top, box.right, floor2, 4), {transferMode: 0, fillPattern: 5})
			end;
		self:DrawShape(MakeRoundRect((box.right - Dogear), box.top, box.right, (box.top + Dogear), 4), {transferMode: 0, fillPattern: 1, penPattern: 0, pensize: 2});
		self:DrawShape(MakePolygon([Array: ((box.right - Dogear) - 1), box.top, ((box.right - Dogear) - 1), (box.top + Dogear), (box.right - 2), (box.top + Dogear), ((box.right - Dogear) - 1), box.top]), {transferMode: 0, fillPattern: 1, penPattern: 5, pensize: 2})
	end
