// protoLogPicker, and what only it reaches

protoLogPicker := {
	_proto: @protoMultiLinePicker,
	viewJustify: 8388608,
	fileTarget: nil,
	viewSetupFormScript: func() begin
		self:doTheShuffle();
		if info then begin
				text := info.logText;
				labelCommands := info.logChoices
			end;
		inherited:?viewSetupFormScript()
	end,
	GetIndex: func() begin
		(if (if info then info.logConfig) then ArrayPos(info.logActions, self:GetTransport():GetConfig(info.logConfig), 0, nil))
	end,
	Popit: func(x) begin
		(if (if info then info.logConfig) then inherited:Popit(x) else (if info then begin
					self:BringUpFiling(info.logText);
					self:pickCancelledScript();
					true
				end))
	end,
	TextSetup: func() begin
		local index, text, strTruncate2;
		index := self:GetIndex();
		if (not info) then begin
				return ""
			end;
		if index then begin
				if info.fileChoices[index] then begin
						strTruncate2 := StrTruncate(Clone(self:GetFolderString()), 120);
						text := ParamStr("^0 in \u201C\u^1\u201D\u", [Array: info.logChoices[index], strTruncate2])
					end else begin
						text := info.logChoices[index]
					end
			end else begin
				strTruncate2 := StrTruncate(Clone(self:GetFolderString()), 150);
				text := ParamStr("\u201C\u^0\u201D\u", [Array: strTruncate2])
			end;
		return text
	end,
	GetFolderString: func() begin
		local config;
		(if (((config := self:GetTransport():GetConfig(info.fileConfig)) = nil) or (GetFolderStr(config) = nil)) then "Unfiled Items" else GetFolderStr(config))
	end,
	BringUpFiling: func(a1) begin
		local frame2;
		fileTarget := {labels: self:GetTransport():GetConfig(info.fileConfig)};
		frame2 := {_parent: GetRoot().(self:GetTransport().owner), appObjectFileThisIn: a1, appObjectFileAction: "Set", caller: self, FileThis: func(target, labelsChanged, a3, storeChanged, a5) begin
			caller:FileThis((if labelsChanged then a3))
		end};
		GetRoot().filingSlip:OpenForUser(self, {target: fileTarget, targetView: frame2}, nil, nil)
	end,
	LabelActionScript: func(index) begin
		self:GetTransport():SetConfig(info.logConfig, info.logActions[index]);
		self:UpdateText(self:TextSetup());
		(if info.fileChoices[index] then self:BringUpFiling(ParamStr(info.fileText, [Array: info.fileChoices[index]])))
	end,
	FileThis: func(target) begin
		self:GetTransport():SetConfig(info.fileConfig, target);
		self:UpdateText(self:TextSetup())
	end
};
