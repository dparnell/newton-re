// protoRoll, and what only it reaches

protoRoll := {
	viewClass: clView,
	viewBounds: {left: 0, top: 16, right: 640, bottom: 480},
	viewFlags: vApplication + vClipping,
	declareSelf: 'roll,
	index: 0,
	overViewItemProto: {
		viewClass: clParagraphView,
		viewFlags: vVisible + vReadOnly + vClickable,
		viewJustify: 8396852,
		viewFormat: 0,
		viewBounds: {left: 3, top: 0, right: -3, bottom: 16},
		viewFont: @fontSystem10Bold,
		viewTransferMode: 1,
		collapsed: true,
		height: 16,
		viewSetupFormScript: func() begin
			(self.text := Stringer([Array: $\u2022, " ", items[itemIndex].overview]))
		end,
		viewClickScript: func(unit) begin
			if (if (StrLen(text) > 0) then self:TrackHilite(unit)) then begin
					self:Parent():ShowItem(itemIndex)
				end;
			true
		end
	},
	allCollapsed: nil,
	collapsedHeight: nil,
	viewSetupChildrenScript: func() begin
		count := Length(items);
		bottom := self:LocalBox().bottom;
		if allCollapsed then begin
				self.collapsedHeight := overViewItemProto.height;
				self._maxIndex := max(0, (count - (bottom div collapsedHeight)));
				self._curItems := Array(count, nil);
				local count;
				local bottom;
				(for i := 0 to (count - 1) do begin
						_curItems[i] := {itemIndex: i, _proto: overViewItemProto}
					end)
			end else begin
				self._maxIndex := (count - 1);
				self._curItems := items;
				if (count > 1) then begin
						self._maxIndex := (count - 1);
						height := items[(count - 1)].height;
						(for i := (count - 2) to 0 by -1 do begin
								local height;
								if ((height := (height + items[i].height)) <= bottom) then begin
										self._maxIndex := i
									end else begin
										break
									end
							end)
					end
			end;
		index := min(_maxIndex, index);
		(self.viewChildren := self:LayoutColumn(_curItems, index))
	end,
	viewQuitScript: func() begin
		(self._curItems := nil)
	end,
	viewScrollUpScript: func() begin
		roll:SyncScroll(_curItems, index, -1)
	end,
	viewScrollDownScript: func() begin
		(if (index < _maxIndex) then roll:SyncScroll(_curItems, index, 1))
	end,
	viewOverviewScript: func() begin
		allCollapsed := (not allCollapsed);
		roll:RedoChildren()
	end,
	ShowItem: func(a1) begin
		(if (a1 < Length(items)) then begin
				allCollapsed := nil;
				index := a1;
				roll:RedoChildren()
			end)
	end,
	debug: 22568
};
