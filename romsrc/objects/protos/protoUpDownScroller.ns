// protoUpDownScroller: a pair of up and down scroll arrows, one above the
// other, at the right of its parent and centred vertically (an
// abstractScroller with two abstractArrow children). The application
// supplies the scrolling methods abstractScroller calls.

protoUpDownScroller := {
	viewBounds: {left: -17, top: 0, right: 0, bottom: 33},
	viewJustify: vjParentRightH + vjParentCenterV,
	// the arrows' pictures in one strip of 17-pixel cells, which DirMap and
	// StateMap index: the cell of a direction plus the offset of a state
	// (normal, more to scroll, hilited)
	Arrows: {
		bits: bitmap('bits, "resources/bits/440c21.png", "00000000001001140114002001250086", 1),
		bounds: {left: 0, top: 0, right: 102, bottom: 17}
	},
	DirMap: {up: 0, down: 1},
	StateMap: {normal: 0, more: 2, hilite: 4},
	ArrowCount: 2,
	viewChildren: [viewChildren:
		{
			viewBounds: {left: 0, top: 0, right: 17, bottom: 17},
			arrowIndex: 0,
			arrowDirection: 'up,
			_proto: @abstractArrow
		},
		{
			viewBounds: {left: 0, top: 16, right: 17, bottom: 33},
			arrowIndex: 1,
			arrowDirection: 'down,
			_proto: @abstractArrow
		}
	],
	_proto: @abstractScroller
};
