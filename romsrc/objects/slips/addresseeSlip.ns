// addresseeSlip (magic pointer 1), and what only it reaches: the auxiliary
// slip of the letter print format (prLetterFormat's auxForm), opened beside
// the print or fax routing slip when that format is chosen.  It edits the
// letter's addressee - a name from the Names file, with that card's address -
// and whether the letter is signed with the owner's signature; what it edits
// is the routing slip's fields frame (targetSlot 'fields).

addresseeSlip := {
	viewJustify: vjParentCenterH + vjParentBottomV,
	viewBounds: {left: 0, top: -196, right: 220, bottom: -26},
	viewEffect: 0,
	fields: nil,
	target: nil,
	debug: 265274,
	ReOrientToScreen: @defRotateFunc,
	stepChildren: [stepChildren:
		// the editing area: a newtFalseEntryView over the routing slip's fields
		{
			_proto: addresseeSlipProto,
			viewJustify: vjParentFullH + vjParentFullV,
			viewBounds: {left: 0, top: 0, right: 0, bottom: -16},
			targetSlot: 'fields,
			viewChildren: [viewChildren:
				explanation_2,
				// "To": a smart name line whose picker is the People popup
				{
					flavor: {
						// a Names card picked: toName gets its primary name, and
						// toFullAddress (path) the name followed, on the next line,
						// by the card's full street address when it has one
						EntryToPath: func(resolveEntryAlias) begin
							local string2;
							target.toName := self:PrimaryName(resolveEntryAlias);
							string2 := GetRoot().cardfile:bcStreetAddress(resolveEntryAlias, 'string);
							target.(path) := self:PrimaryName(resolveEntryAlias);
							(if string2 then (target.(path) := Stringer([Array: target.(path), $\n, self:bcFullAddress(string2[0])])))
						end,
						// the People popup, one name to pick
						picker: func() begin
							@protoPeoplePopup:New({_proto: GetDataDefs('|nameRef.people|), singleSelect: true}, nil, self, nil)
						end,
						_proto: @newtSmartNameFilter
					},
					viewJustify: vjParentFullH,
					viewBounds: {left: 0, top: 13, right: 0, bottom: 138},
					label: to_2,
					indent: 30,
					viewLineSpacing: 30,
					// the entry line takes the view's whole height (a name and an address)
					viewSetupFormScript: func() begin
						inherited:viewSetupFormScript();
						(entryLine.viewJustify := vjParentFullV)
					end,
					// the caret into the name line, at its end (9999: past any text)
					viewSetupDoneScript: func() begin
						SetKeyView(self.entryLine, 9999)
					end,
					memory: 'addressee,
					path: 'toFullAddress,
					_proto: @newtSmartNameView
				},
				// "Sign Letter": the letter signed with the owner's signature; the
				// choice is kept as the user's signLetter setting
				{
					viewJustify: vjSiblingBottomV,
					viewBounds: {left: 30, top: 5, right: 130, bottom: 18},
					text: "Sign Letter",
					added: nil,
					// hidden (viewFlags 0: not even vVisible) when the current owner card
					// (persona) has no signature; added notes that it was shown
					viewSetupFormScript: func() begin
						local resolveEntryAlias2;
						if ((not (resolveEntryAlias2 := ResolveEntryAlias(userConfiguration.currentPersona))) or (not resolveEntryAlias2.owner.signature)) then begin
								viewFlags := 0
							end else begin
								added := true
							end;
						target.fromSignature := GetUserConfig('signLetter);
						inherited:viewSetupFormScript()
					end,
					// the choice made the default for the next letter
					viewQuitScript: func() begin
						(if added then SetUserConfig('signLetter, target.fromSignature))
					end,
					path: 'fromSignature,
					_proto: @newtCheckbox
				}
			],
			explanation: nil,
			allocateContext: [|Array|: 'explanation, explanation_2]
		}
	],
	_proto: @protoFloatNGo
};

// the slip's heading, "Addressee"
explanation_2 := {
	viewJustify: vjCenterH + vjParentFullH + oneLineOnly,
	viewBounds: {left: 0, top: 1, right: 0, bottom: 14},
	text: "Addressee",
	preallocatedContext: 'explanation,
	_proto: @protoStaticText
};
