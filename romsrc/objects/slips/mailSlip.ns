// The completion script of the login scripts' input specs: a3 the error, a cancel
// becoming -38001 (kIRErrTimeout's value; what it stands for here is not known); the
// first error is kept in curerror and the script stopped.
completionscript := func(a1, a2, a3) begin
	if (a3 = kCommErrRequestCanceled) then begin
			a3 := -38001
		end;
	if (if a3 then (a1._parent.curerror = nil)) then begin
			a1._parent.curerror := a3
		end;
	(if a1.curstate then AddDeferredSend(a1, 'stopCCL, nil))
end;

// The SprintNet login script (protoNavigator), and the proto of the other networks':
// mailNavigate sets up the endpoint, runs the script (startCCL) and returns curerror.
mailNetworksProto := {
	title: sprintNet,
	id: 'sprint,
	curerror: nil,
	speed: 0,
	// the AOL address to call, by modem speed: eworld0 to 2400 baud, eworld1 to 9600, eworld2 above
	networkIdentifier: func() begin
		local text;
		text := "eworld2";
		if (speed <= 9600) then begin
				text := "eworld1"
			end;
		if (speed <= 2400) then begin
				text := "eworld0"
			end;
		text
	end,
	cancelSpec: {
		async: true,
		// the request cancelled: stop the script
		completionscript: func(a1, a2, a3) begin
			a1:SetInputSpec(nil);
			AddDeferredSend(a1, 'stopCCL, nil)
		end
	},
	// stops the login: cancels the endpoint's request (curerror: cancelled) or stops at once
	quit: func() begin
		if (not mailEndPoint.curstate) then begin
				return nil
			end;
		mailEndPoint.curstate := nil;
		(if (curerror = nil) then begin
				mailEndPoint:Cancel(cancelSpec);
				(curerror := kCommErrRequestCanceled)
			end else AddDeferredSend(mailEndPoint, 'stopCCL, nil))
	end,
	mailEndPoint: {
		_proto: @protoBasicEndpoint,
		// an endpoint error stops the login, the first error kept. Looks like a ROM bug: ep is
		// no local and nothing here sets a slot of that name (Concert's handler calls quit instead)
		ExceptionHandler: func(ex) begin
			if (mailEndPoint.curstate = nil) then begin
					return nil
				end;
			if (curerror = nil) then begin
					curerror := ex.data
				end;
			AddDeferredSend(ep, 'stopCCL, nil)
		end,
		waitForTerminal: {
			form: '|string|,
			filter: {sevenbit: true},
			discardafter: 200,
			termination: {endsequence: "="},
			// "=" seen: answer "D1" and wait for "@"
			InputScript: func(a1, a2, a3, a4) begin
				(if (a1.curstate = 'waitForTerminal) then begin
						a1.curstate := 'waitForAt;
						(try begin
								a1:SetInputSpec(a1.waitForAt);
								a1:output("D1\n", nil, {async: true})
							end onexception |evt.ex| do begin
								self:quit()
							end)
					end)
			end,
			completionscript: completionscript,
			reqTimeout: 20000
		},
		waitForAt: {
			form: '|string|,
			filter: {sevenbit: true},
			termination: {endsequence: endsequence},
			// "@" seen: call the AOL address (networkIdentifier) and wait for " CONNECTED"
			InputScript: func(a1, a2, a3, a4) begin
				(if (a1.curstate = 'waitForAt) then begin
						a1.curstate := 'waitForConnected;
						(try begin
								a1:SetInputSpec(a1.waitForConnected);
								a1:output(Stringer([Array: "c ", a1:networkIdentifier(), "*NEWTMAIL0001\n"]), nil, {async: true})
							end onexception |evt.ex| do begin
								self:quit()
							end)
					end)
			end,
			completionscript: completionscript,
			reqTimeout: 20000
		},
		waitForConnected: {
			form: '|string|,
			filter: {sevenbit: true},
			termination: {endsequence: " CONNECTED"},
			// connected: the script is done (stopCCL)
			InputScript: func(a1, a2, a3, a4) begin
				(if (a1.curstate = 'waitForConnected) then begin
						a1.curstate := nil;
						a1:SetInputSpec(nil);
						AddDeferredSend(a1, 'stopCCL, nil)
					end)
			end,
			completionscript: completionscript,
			reqTimeout: 20000
		}
	},
	// an endpoint of its own on the connection's endpoint a1
	mailSetup: func(a1) begin
		mailEndPoint:instantiateFromTEndpoint((mailEndPoint := {_proto: mailEndPoint, _parent: self}), nil, a1)
	end,
	// Wakes SprintNet ("@" above 1200 baud or at an unknown speed, a return otherwise;
	// then "D" and a return, 300 ms apart), waits for its "=" prompt, answers "D1", then at "@" calls AOL ("c <id>*NEWTMAIL0001")
	// and waits for " CONNECTED".
	mailStart: func() begin
		mailEndPoint.curstate := 'waitForTerminal;
		mailEndPoint:SetInputSpec(mailEndPoint.waitForTerminal);
		speed := [Array: {label: "mspd", type: 'option, opCode: opGetCurrent, data: {arglist: [Array: 0], typelist: [Array: 10, 1]}}];
		try begin
				speed := mailEndPoint:option(speed, nil)
			end onexception |evt.ex| do begin
				self:quit()
			end;
		speed := speed[0].data.arglist[0];
		if (transport exists) then begin
				transport:?SetStatusDialog('Connecting, 'vStatusTitle, {titleText: Stringer([Array: title, " ", "-", " ", speed, " ", "baud"])})
			end;
		try begin
				if ((speed > 1200) or (speed = 0)) then begin
						mailEndPoint:output($@, nil, {async: true})
					end else begin
						mailEndPoint:output($\n, nil, {async: true})
					end
			end onexception |evt.ex| do begin
				self:quit()
			end;
		AddDelayedCall(func() begin
			self:mailStartContinue1()
		end, nil, 300)
	end,
	// 300 ms on: a "D", and a return 300 ms after that (mailStartContinue2)
	mailStartContinue1: func() begin
		(if (mailEndPoint.curstate = 'waitForTerminal) then begin
				try begin
						mailEndPoint:output($D, nil, {async: true})
					end onexception |evt.ex| do begin
						self:quit()
					end;
				AddDelayedCall(func() begin
					self:mailStartContinue2()
				end, nil, 300)
			end)
	end,
	mailStartContinue2: func() begin
		(if (mailEndPoint.curstate = 'waitForTerminal) then begin
				try begin
						mailEndPoint:output($\n, nil, {async: true})
					end onexception |evt.ex| do begin
						self:quit()
					end;
				nil
			end)
	end,
	// gives the endpoint back to the connection
	mailCleanup: func() begin
		mailEndPoint:disposeLeavingTEndpoint()
	end,
	// runs the login on the connection a1 (protoNavigator): nil, or the error
	mailNavigate: func(a1) begin
		curerror := nil;
		self:mailSetup(a1);
		self:mailStart();
		self:startCCL();
		self:mailCleanup();
		curerror
	end,
	_proto: @protoNavigator
};

