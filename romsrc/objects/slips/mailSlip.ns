	groupTitle: mail_2,
	// protoTransport's SendRequest, from the In/Out Box: when connected the items are sent
	// (or the request queued while busy); automatic delivery ('periodic) connects at once
	// in batch mode; otherwise connectOptionsSlip opens. 'submit requests are not for us.
	SendRequest: func(request) begin
		local resolveEntryAlias2, resolveEntryAlias3;
		(if (request.cause <> 'submit) then begin
				if (if eworld then eworld.connected) then begin
						if (request.cause = 'periodic) then begin
								return nil
							end;
						if (status = 'connected) then begin
								eworld.request := request;
								eworld:SendNextMessage()
							end else begin
								if (lastRequest = 'SendRequest) then begin
										self:QueueRequest(eworld.request, request)
									end else begin
										self:QueueRequest('SendRequest, request);
										return nil
									end
							end
					end else begin
						if (request.cause = 'periodic) then begin
								resolveEntryAlias2 := ResolveEntryAlias(userConfiguration.currentEmporium);
								resolveEntryAlias3 := ResolveEntryAlias(userConfiguration.currentPersona);
								AddDeferredSend(self, 'DoConnect, [Array: resolveEntryAlias2, resolveEntryAlias3, request, 'batch, 'Mail_ListUnread])
							end else begin
								if (if (not (if connectSlip then connectSlip.viewCObject)) then (status = 'idle)) then begin
										(connectSlip := BuildContext(connectOptionsSlip)).request := request;
										connectSlip.theApp := GetRoot().(owner);
										connectSlip.theTransport := self;
										connectSlip.connectionType := 'send;
										connectSlip.clearOnClose := 'connectSlip;
										if connectSlip.theApp.viewCObject then begin
												connectSlip.theApp:RememberedOpen(connectSlip)
											end else begin
												connectSlip:Open()
											end
									end else begin
										return nil
									end
							end
					end;
				(lastRequest := 'SendRequest)
			end)
	end,
	// The last ink conversion: the access number. Then log in to the host (LoginToHost).
	ConvertedMailPhone: func(a1, a2, a3) begin
		local mailPhoneFull;
		(if a1 then begin
				if IsRichString((mailPhoneFull := GetUserConfig('mailPhoneFull))) then begin
						SetUserConfig('mailPhoneFull, a2)
					end;
				eworld.firstTime := true;
				AddDeferredSend(eworld, 'LoginToHost, [Array: eworld._worksite, eworld._owner, nil, nil, nil, nil])
			end else (eworld := nil))
	end,
	// RegisterStart's validation done (a1 true): register (DoRegister) or open mailRegister
	RegisterValidationComplete: func(a1) begin
		local mailSlip;
		mailSlip := GetRoot().mailSlip;
		(if a1 then begin
				if mailSlip.setEmporia then begin
						UseCurrentEmporium()
					end;
				mailSlip.setEmporia := nil;
				(if ((not userConfiguration.mailAccount) or (not StrFilled(userConfiguration.mailAccount))) then mailSlip:DoRegister(nil) else begin
						mailRegister.request := nil;
						mailRegister:Open()
					end)
			end)
	end,
	// The account name converted (a1 true, a2 the text): stored, also in the owner card;
	// the password next (ConvertedPassword).
	ConvertedAccount: func(a1, a2, a3) begin
		local mailAccount, resolveEntryAlias2;
		(if a1 then begin
				if IsRichString((mailAccount := GetUserConfig('mailAccount))) then begin
						SetUserConfig('mailAccount, a2);
						if (resolveEntryAlias2 := ResolveEntryAlias(userConfiguration.currentPersona)) then begin
								GetRoot().cardfile:ReplaceInkData(resolveEntryAlias2, 'email, mailAccount, 'email, a2)
							end
					end;
				self:ConvertInkText(GetUserConfig('mailPassword), 'alpha, nil, "Converting e-mail password", "Please verify that the ink text was converted correctly.", 'InkConvert, 'ConvertedPassword, nil)
			end else (eworld := nil))
	end,
	// protoTransport's GetItemTime: the date, with the time for a mail held on the Newton.
	GetItemTime: func(target) begin
		(if target.Remote then ShortDate(target.timestamp) else Stringer([Array: ShortDate(target.timestamp), " ", HourMinute(target.timestamp)]))
	end,
	translate: nil,
	// protoTransport's SetStatusDialog with the status dialog's button: "Disconnect" once
	// connected (a queued request is started then), "Stop" while working.
	SetStatusDialog: func(status2, a2, frame2) begin
		local text, requestQueueItem;
		text := nil;
		if (status2 = 'connected) then begin
				text := "Disconnect";
				if (if requestQueue then (Length(requestQueue) > 0)) then begin
						requestQueueItem := requestQueue[0];
						SetRemove(requestQueue, requestQueueItem);
						AddDeferredSend(self, requestQueueItem.function, [Array: requestQueueItem])
					end
			end else begin
				if (status = 'connected) then begin
						text := "Stop"
					end
			end;
		if text then begin
				if (frame2 = nil) then begin
						frame2 := {}
					end;
				if (not (frame2:primary exists)) then begin
						frame2.primary := {text: text, script: func() begin
							GetRoot().(appSymbol):CancelRequest('userCancel)
						end}
					end
			end;
		if (if IsFrame(frame2) then StrFilled(frame2.titleText)) then begin
				frame2.titleText := ParamStr("^0", [Array: frame2.titleText])
			end;
		inherited:SetStatusDialog(status2, a2, frame2)
	end,
	// an attachment's progress: the gauge at offset
	filetransferstatus: func(offset, filesize) begin
		self:SetStatus(status, {gauge: offset})
	end,
	// The Mail routing slip (protoFullRouteSlip): To, Cc and Bcc address lines, Subject,
	// Text Only and Receipt Requested, and Show Text to edit the text sent. PrepareToSend
	// checks the addresses and converts ink before the item goes to the Out Box.
	routingSlip: {
		// mailEditor edits the subject; fn gets the new text
		editSubject: func(fn) begin
			mailEditor.message := fields;
			mailEditor.path := 'title;
			mailEditor.updateScript := fn;
			mailEditor.appName := appName;
			mailEditor:Open();
			true
		end,
		// viewSetupDoneScript: the attachment check box follows the format, and the text is
		// made unless the user edited it
		viewSetupDoneScript: func() begin
			inherited:viewSetupDoneScript();
			self:changeformat();
			(if (not fields.edited) then self:generateText())
		end,
		// FormatChanged's Confirm answer: a1 true takes the new format and drops the edited text
		doChangeFormat: func(a1) begin
			(if a1 then begin
					fields.edited := nil;
					RemoveSlot(fields, 'text);
					fields.currentFormat := chosenFormat.symbol;
					chosenFormat := nil;
					self:changeformat()
				end else formatPicker:revertCommand())
		end,
		// true when the address addr cannot be sent to yet: it has no e-mail address, or one
		// in ink (converted then, ConvertStart; inkCount counts those still converting)
		BadAddress: func(dataDefs, addr) begin
			local name;
			email := dataDefs:Get(addr, 'email, nil);
			name := dataDefs:Get(addr, 'name, 'text);
			if IsArray(email) then begin
					local email;
					(foreach item in email do begin
							if self:BadAddress(dataDefs, item) then begin
									return true
								end
						end);
					return nil
				end else begin
					if (((not email) or (not IsString(email))) or (not StrFilled(email))) then begin
							self:Notify(kNotifyAlert, appName, ParamStr("^0 does not have an e-mail address.", [Array: name]))
						end else begin
							if IsRichString(email) then begin
									inkCount := (inkCount + 1);
									AddDeferredCall(func() begin
										self:ConvertStart({addr: addr, name: name})
									end, nil)
								end else begin
									return nil
								end
						end
				end;
			true
		end,
		receiptCheck: nil,
		networkSymbols: networkSymbols,
		// closes a validation slip left open
		viewQuitScript: func() begin
			if (if (ValidateSlip exists) then ValidateSlip.viewCObject) then begin
					ValidateSlip:Close()
				end;
			ValidateSlip := nil;
			inherited:?viewQuitScript()
		end,
		// Show Text: mailEditor edits the text to be sent
		editMessage: func(a1) begin
			mailEditor.message := fields;
			mailEditor.path := 'text;
			mailEditor.updateScript := a1;
			mailEditor.appName := appName;
			mailEditor:Open()
		end,
		// a frame or view format can carry an attachment; other formats are text only
		changeformat: func() begin
			(if ((activeFormat.routingType = 'frame) or (activeFormat.routingType = 'view)) then begin
					if (not fields.reply) then begin
							fields.attachment := (not GetUserConfig('mailTextOnly))
						end;
					attachCheck:AllowChecking(true)
				end else begin
					if (not fields.reply) then begin
							fields.attachment := nil
						end;
					attachCheck:AllowChecking(nil)
				end)
		end,
		// an ink address converted: stored in the address and its Names card; the last one
		// lets PrepareToSend go on
		ConvertComplete: func(a1, a2, a3) begin
			local email, resolveEntryAlias2;
			InkConvert := nil;
			(if (if a1 then a2) then begin
					email := a3.addr.email;
					a3.addr.email := SetClass(a2, a3.type);
					if (resolveEntryAlias2 := ResolveEntryAlias(a3.addr._alias)) then begin
							GetRoot().cardfile:ReplaceInkData(resolveEntryAlias2, 'email, email, 'email, a2)
						end;
					(if ((inkCount := (inkCount - 1)) < 1) then self:PrepareToSend(noworlater))
				end)
		end,
		// protoFullRouteSlip's FormatChanged: an edited text is lost on a change of format,
		// so the user confirms first (doChangeFormat)
		FormatChanged: func(format) begin
			chosenFormat := format;
			if fields.edited then begin
					self:Confirm(appName, "Changing the format will cause your text changes to be lost. Do you want to continue?", self, 'doChangeFormat)
				end else begin
					self:doChangeFormat(true)
				end;
			true
		end,
		fields: nil,
		chosenFormat: nil,
		subject: nil,
		// the AsyncConfirm answer: a1 true removes the ink from the text, nil lets the user edit
		StripInkFromText: func(a1) begin
			(if a1 then begin
					StripInk(fields.text, $\uFC02);
					StrReplace(fields.text, "\uFC02\u", "-ink-", nil);
					self:getAttachment();
					self:shrinkMessage();
					self:ContinueSend(noworlater)
				end else self:editMessage(nil))
		end,
		attachCheck: nil,
		// the subject: 'multiple for several items, else the item's title (cut to 61 characters)
		SetupTitle: func() begin
			local itemTransport;
			(if TargetIsCursor(target) then (fields.title := 'multiple) else begin
					itemTransport := GetItemTransport(fields);
					fields.title := itemTransport:?GetItemTitle(target);
					if (not fields.title) then begin
							fields.title := itemTransport:?GetItemTitle(fields)
						end;
					if ((not fields.title) or (not StrFilled(fields.title))) then begin
							fields.title := " "
						end;
					(if (StrLen(fields.title) > 61) then (fields.title := Substr(fields.title, 0, 61)))
				end)
		end,
		_proto: @protoFullRouteSlip,
		InkConvert: nil,
		// the subject converted from ink (or it had none): text with ink is refused until it is
		// removed or converted
		PrepareToSend2: func(a1, title, a3) begin
			(if a1 then begin
					if (if IsString(title) then (StrLen(title) > 61)) then begin
							fields.title := Substr(title, 0, 61)
						end else begin
							fields.title := title
						end;
					(if IsRichString(fields.text) then AsyncConfirm("The text copy of the mail contains ink which can not be sent.  You may remove or convert the ink words.", [Array: {value: true, text: "Remove"}, {value: nil, text: "Convert"}], func(a1) begin
							self:StripInkFromText(a1)
						end) else begin
							self:getAttachment();
							self:shrinkMessage();
							self:ContinueSend(noworlater)
						end)
				end)
		end,
		appSymbol: 'mail,
		bccLine: nil,
		inkCount: 0,
		// protoFullRouteSlip's PrepareToSend (Send tapped; noworlater2 'now or 'later): needs
		// a To address and every address in text.
		PrepareToSend: func(noworlater2) begin
			noworlater := noworlater2;
			fields.toRef := toLine.selected;
			fields.cc := ccLine.selected;
			fields.bcc := bccLine.selected;
			if ((not fields.toRef) or (Length(fields.toRef) = 0)) then begin
					self:Notify(kNotifyAlert, appName, "You have not chosen a recipient. Please fill in the 'To' address and try again.");
					return nil
				end;
			inkCount := 0;
			dataDefs := GetDataDefs('|nameRef.email|);
			local dataDefs;
			(foreach key, value in fields.toRef do begin
					if self:BadAddress(dataDefs, value) then begin
							return nil
						end
				end);
			if (if fields.cc then (Length(fields.cc) > 0)) then begin
					(foreach key, value in fields.cc do begin
							if self:BadAddress(dataDefs, value) then begin
									return nil
								end
						end)
				end;
			if (if fields.bcc then (Length(fields.bcc) > 0)) then begin
					(foreach key, value in fields.bcc do begin
							if self:BadAddress(dataDefs, value) then begin
									return nil
								end
						end)
				end;
			(if (if IsString(fields.title) then IsRichString(fields.title)) then self:ConvertInkText(fields.title, 'alpha, nil, "Converting e-mail subject", "Please verify that the ink text was converted correctly.", 'InkConvert, 'PrepareToSend2, nil) else self:PrepareToSend2(true, fields.title, nil))
		end,
		currentPickerLine: nil,
		// the text sent: the format's TextScript of the target
		generateText: func() begin
			local textScript, l2;
			l2 := (if fields.appSymbol then GetVariable(self, fields.appSymbol));
			textScript := activeFormat.TextScript;
			fields.text := " ";
			(if textScript then (if (if IsSymbol(textScript) then l2) then (fields.text := Perform(l2, textScript, [Array: fields, target])) else (if IsFunction(textScript) then (fields.text := call textScript with (fields, target)))))
		end,
		appName: americaOnline,
		// drops nil slots and the routing slip's working slots before the item is stored
		shrinkMessage: func() begin
			local l1;
			l1 := (foreach key, value in fields collect (if (not value) then key));
			(foreach key in l1 do begin
					if key then begin
							RemoveSlot(fields, key)
						end
				end);
			RemoveSlot(fields, 'formats);
			RemoveSlot(fields, 'targetBox);
			RemoveSlot(fields, 'alternatives);
			RemoveSlot(fields, 'pageCount);
			RemoveSlot(fields, 'pageID);
			RemoveSlot(fields, 'pageNumber);
			(if (fields.state = 'pending) then RemoveSlot(fields, 'Connect))
		end,
		stepallocatecontext: [|Array|:
			'toLine,
			toLine_2,
			'ccLine,
			ccLine_2,
			'bccLine,
			bccLine_2,
			'subject,
			subject,
			'attachCheck,
			attachCheck,
			'receiptCheck,
			receiptCheck
		],
		toLine: nil,
		noworlater: nil,
		// Fills in the new item: the sender from the current persona, the date, and for a
		// single entry its frame format; for several entries, warns when any of them has ink.
		SetFieldDefaults: func() begin
			l1 := ResolveEntryAlias(GetUserConfig('currentPersona));
			if (not fields.reply) then begin
					fields.attachment := (not GetUserConfig('mailTextOnly))
				end;
			if l1 then begin
					fields.fromName := GetRoot():PrimaryName(l1);
					if (l2 := GetRoot().cardfile:bcEMailAddress(l1, addressSymbols)) then begin
							fields.fromRef := Clone(l2[0])
						end
				end;
			fields.dateStr := LongDateStr(Time(), @datetimeStrSpecs.longDateStrSpec);
			if TargetIsCursor(target) then begin
					if ((l3 := GetTargetCursor(target, nil)):CountEntries() = 1) then begin
							target := l3:entry();
							fields.body := target;
							l4 := nil;
							if ((l5 := GetViewDefs(DataClassOf(target))) <> nil) then begin
									if ((l4 := l5.prFrameFormat) = nil) then begin
											local l1;
											local l2;
											local l3;
											local l4;
											local l5;
											(foreach l6 in l5 do begin
													local l8, l9, l10, l11, l12, l13, l14, l15;
													if (if (if l6 then ((l6.routingType = 'frame) or (l6.routingType = 'view))) then (not l6.usesCursors)) then begin
															l4 := l6;
															break
														end
												end)
										end
								end;
							if l4 then begin
									l8 := {fields: fields, target: target, targetView: targetView};
									fields.currentFormat := l4.symbol;
									if HasSlot(l4, 'SetupSlip) then begin
											l4:?SetupSlip(l8, l8.fields)
										end else begin
											l4:?SetupItem(fields, l8)
										end;
									activeFormat := l4
								end
						end else begin
							fields.title := 'multiple;
							l9 := nil;
							l10 := (if fields.appSymbol then GetVariable(self, fields.appSymbol));
							l11 := activeFormat.TextScript;
							l12 := GetItemTransport(fields);
							l13 := l3:entry();
							(while (if l13 then (not l9)) do begin
									if (not (l14 := l12:?GetItemTitle(l13))) then begin
											l14 := l12:?GetItemTitle(fields)
										end;
									if ((not l14) or (not StrFilled(l14))) then begin
											l14 := " "
										end;
									if IsRichString(l14) then begin
											l9 := true
										end else begin
											l15 := " ";
											if l11 then begin
													if (if IsSymbol(l11) then l10) then begin
															l15 := Perform(l10, l11, [Array: fields, l13])
														end else begin
															if IsFunction(l11) then begin
																	l15 := call l11 with (fields, l13)
																end
														end
												end;
											if IsRichString(l15) then begin
													l9 := true
												end
										end;
									(l13 := l3:Next())
								end);
							l3:Reset();
							if l9 then begin
									self:Notify(kNotifyAlert, appName, "Some of the items contain ink, which will be replaced with the word \u201C\u-ink-\u201D\u.")
								end
						end
				end;
			(if (not fields.title) then self:SetupTitle())
		end,
		currentPicker: nil,
		// viewSetupFormScript: e-mail addresses for the address lines, then the defaults
		viewSetupFormScript: func() begin
			self:ToRefCheck('|nameRef.email|);
			inherited:viewSetupFormScript();
			self:SetFieldDefaults()
		end,
		ccLine: nil,
		// converts an ink e-mail address of the Names card behind theInfo.addr (ConvertComplete)
		ConvertStart: func(theInfo) begin
			self:ConvertInkText(theInfo.addr.email, 'alpha, nil, ParamStr("eMail address for ^0 ", [Array: theInfo.name]), ParamStr("Please verify that ^0 is converted correctly.", [Array: theInfo.addr.email]), 'InkConvert, 'ConvertComplete, {addr: theInfo.addr, type: ClassOf(theInfo.addr.email)})
		end,
		stepChildren: [stepChildren:
			{
				viewJustify: vjCenterH + vjCenterV + oneLineOnly,
				viewBounds: {left: 11, top: 0, right: 71, bottom: 13},
				text: "Show Text",
				// Show Text sits at the bottom of the envelope
				viewSetupFormScript: func() begin
					(viewBounds := DeepClone(viewBounds)).top := (((envelopeHeight + bottomIndent) - 18) - 2);
					(viewBounds.bottom := (viewBounds.top + 13))
				end,
				// Show Text: edit the text that will be sent
				buttonClickScript: func() begin
					self:editMessage(nil)
				end,
				_proto: @protoTextButton
			},
			toLine_2,
			ccLine_2,
			bccLine_2,
			subject,
			attachCheck,
			receiptCheck
		],
		debug: 1301114,
		// opens the subject editor (subject's Popit)
		doEditSubject: func() begin
			subject:Popit(0)
		end,
		// the attachment: the target itself, a package made an attachment of class
		// 'packageFrame (type "pkg ", creator "pkgX"), with a text describing it
		getAttachment: func() begin
			local pkgRefInfo, text;
			(if fields.attachment then begin
					if (fields.body = nil) then begin
							fields.body := DeepClone(target)
						end;
					(if fields.body.package then begin
							fields.IsPackage := true;
							pkgRefInfo := GetPkgRefInfo(fields.body.package);
							try begin
									if (if (if (pkgRefInfo.numparts > 0) then (pkgRefInfo.parttypes[0] = 'form)) then pkgRefInfo.parts[0].text) then begin
											text := pkgRefInfo.parts[0].text
										end else begin
											text := pkgRefInfo.title
										end
								end onexception |evt.ex| do begin
									text := pkgRefInfo.title
								end;
							fields.body.class := 'packageFrame;
							fields.body.data := fields.body.package;
							fields.body.filesize := pkgRefInfo.size;
							fields.body.type := "pkg ";
							fields.body.creator := "pkgX";
							(if (not fields.edited) then (fields.text := ParamStr("Attached package information:\nName: ^0\nSize: ^1 bytes\n^2", [Array: fields.body.filename, pkgRefInfo.size, pkgRefInfo.copyright])))
						end)
				end else (if (not TargetIsCursor(target)) then (fields.body := nil)))
		end,
		addressSymbols: addressSymbols,
		bottomIndent: 74
	},
	ValidateSlip: nil
};

endsequence := "@";

// the address classes the transport takes, best first
addressSymbols := [|Array|: '|string.email.aol|, '|string.email|, '|string|];

networkSymbols := [|Array|: 'sprint, 'concert];

yourConfigurationIsIncomplete := "Your configuration is incomplete. Please enter your America Online account information:";

yourConfigurationIsIncomplete_2 := "Your configuration is incomplete. Please enter the America Online access information:";

// The routing slip's editable address line: only one address picker open at a time.
toLine_2Proto := {
	_proto: @protoAddressPicker,
	indent: 35,
	selected: nil,
	class: '|nameRef.email|,
	// the addresses come from the routing fields (fields.(path): toRef, cc or bcc)
	viewSetupFormScript: func() begin
		selected := fields.(path);
		inherited:?viewSetupFormScript()
	end,
	// another line's picker is closed first; tapping the same line again does nothing
	DoOpenPicker: func() begin
		if (if currentPicker then currentPicker.viewCObject) then begin
				if (currentPickerLine = path) then begin
						return nil
					end;
				currentPicker:Close()
			end;
		inherited:DoOpenPicker();
		currentPicker := pickerSlip;
		(currentPickerLine := path)
	end
};

// A read-only address line of the In/Out Box header (transportInfoForm): tapping it
// lists the addresses ("None" when there are none).
bccLineProto := {
	_proto: @protoAddressPicker,
	indent: 35,
	selected: nil,
	class: '|nameRef.email|,
	readOnly: true,
	// the addresses come from the item shown (target)
	viewSetupFormScript: func() begin
		selected := target.(path);
		inherited:?viewSetupFormScript()
	end,
	// shows the addresses read-only
	Popit: func(x) begin
		local list;
		if (Length(selected) = 0) then begin
				list := [Array: GetDataDefs('|nameRef.email|):MakeNameRef({name: {last: "None"}}, '|nameRef.email|)]
			end else begin
				list := DeepClone(selected)
			end;
		_picker:New(class, list, self, {readOnly: true, suppressFolderTabs: true, suppressCounter: true});
		base:hilite(nil);
		true
	end,
	// the picker is read only: nothing to set up, no choice to act on
	pickerSetup: func() begin
		true
	end,
	viewQuitScript: func() begin
		nil
	end,
	pickActionScript: func(index) begin
		nil
	end
};

bcc := "Bcc";

bccLine := {
	_proto: bccLineProto,
	viewBounds: {left: 20, top: -33, right: -10, bottom: -18},
	viewJustify: vjParentFullH + vjParentBottomV,
	text: bcc,
	path: 'bcc,
	preallocatedContext: 'bccLine
};

cc := "Cc";

ccLine := {
	_proto: bccLineProto,
	viewBounds: {left: 20, top: -15, right: -10, bottom: -5},
	viewJustify: vjParentFullH + vjSiblingTopV,
	text: cc,
	path: 'cc,
	preallocatedContext: 'ccLine
};

toLine := {
	_proto: bccLineProto,
	viewBounds: {left: 20, top: -15, right: -10, bottom: -5},
	viewJustify: vjParentFullH + vjSiblingTopV,
	text: to_2,
	path: 'toRef,
	preallocatedContext: 'toLine
};

labelLine_3 := {
	viewBounds: {left: 15, top: -23, right: -15, bottom: -5},
	viewJustify: vjCenterH + vjBottomV + vjParentFullH + vjSiblingTopV,
	text: nil,
