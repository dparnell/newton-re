// mailSlip, and what only it reaches: the America Online mail transport, the ROM's
// built-in e-mail transport (a protoTransport in the 'mail group, its routing slip
// "Mail"). The In/Out Box calls it to send (SendRequest) and receive (ReceiveRequest)
// mail; it dials an AOL access number through a packet network (mailNetworks: SprintNet
// or Concert, logged in by protoNavigator scripts), talks to the AOL host through
// protoEworld (an @protoEworldEndpoint) and keeps the mail, its account and access
// number in the user configuration (mailAccount, mailPassword, mailPhone, mailNetwork,
// mailMode, mailListMethod, ...). Mail is a 'mailText item: title, text, fromRef/
// fromName, toRef/cc/bcc (|nameRef.email| name references), dateStr, and an optional
// attachment (body, or a package). The root keeps the transport as GetRoot().mailSlip
// (preallocated as 'mailcategory).

mailSlip := {
	key: 'mailSlip,
	// ConvertInkText's completion for the account password (ConvertedAccount asked for it):
	// a1 true when converted, a2 the text. Stores it (and in the owner card), then has the
	// access phone number converted (ConvertedMailPhone); a1 nil abandons the connection.
	ConvertedPassword: func(a1, a2, a3) begin
		local mailPassword, resolveEntryAlias2;
		(if a1 then begin
				if IsRichString((mailPassword := GetUserConfig('mailPassword))) then begin
						SetUserConfig('mailPassword, a2);
						if (resolveEntryAlias2 := ResolveEntryAlias(userConfiguration.currentPersona)) then begin
								GetRoot().cardfile:ReplaceInkData(resolveEntryAlias2, 'email, mailPassword, 'emailPassword, a2)
							end
					end;
				self:ConvertInkText(GetUserConfig('mailPhoneFull), 'phone, vPhoneField, "Converting network phone number", "Please verify that the ink text was converted correctly.", 'InkConvert, 'ConvertedMailPhone, nil)
			end else (eworld := nil))
	end,
	// The common end of doReply and doReplyAll: turns the copy a1 of a received item into
	// a new pending outgoing mail ("Re: " title, the text selected in the item quoted as a
	// Notes body between "------" lines) and hands it to the item's application (a2's
	// appSymbol) as completed, so it opens in the Out Box for editing and sending.
	ReallyDoReply: func(a1, a2) begin
		local hilitedTextItems, rejectAll, l3;
		if (if (hilitedTextItems := GetHilitedTextItems()) then (Length(hilitedTextItems) > 0)) then begin
				hilitedTextItems := hilitedTextItems[0]
			end;
		a1.reply := true;
		a1.box := nil;
		a1._proto := nil;
		a1.state := 'pending;
		RemoveSlot(a1, '_uniqueID);
		RemoveSlot(a1, '_modTime);
		RemoveSlot(a1, 'xlabels);
		RemoveSlot(a1, 'labels);
		RemoveSlot(a1, 'timestamp);
		if (if (if a1.title then IsString(a1.title)) then StrFilled(a1.title)) then begin
				// the title's first six characters without blanks, digits and brackets (so "Re(2):" is
				// seen as "Re:") decide whether it is already a reply
				if (if (not BeginsWith((rejectAll := StringFilter(Substr(a1.title, 0, 6), " 0123456789()", 'rejectAll)), "Re>")) then (not BeginsWith(rejectAll, "Re:"))) then begin
						a1.title := Stringer([Array: "Re: ", a1.title])
					end
			end;
		RemoveSlot(a1, 'text);
		RemoveSlot(a1, 'edited);
		RemoveSlot(a1, 'account);
		if (if IsString(hilitedTextItems) then StrFilled(hilitedTextItems)) then begin
				hilitedTextItems := StringFilter(hilitedTextItems, " \n", 'rejectBeginning);
				(while (EndsWith(hilitedTextItems, "\n") or EndsWith(hilitedTextItems, " ")) do (hilitedTextItems := Substr(hilitedTextItems, 0, (StrLen(hilitedTextItems) - 1))));
				// style runs: 8 characters ("\n------\n") in the user's font, the quote in italic,
				// 8 more in the user's font
				a1.body := GetRoot().paperroll:MakeTextNoteFont(Stringer([Array: "\n------\n", hilitedTextItems, "\n------\n"]), nil, [Array: 8, GetUserConfig('userFont), StrLen(hilitedTextItems), tsFancy + tsSize(12) + tsItalic, 8, GetUserConfig('userFont)])
			end else begin
				a1.body := GetDataDefs('paperroll):MakeNewEntry()
			end;
		a1.currentFormat := 'prFrameFormat;
		a1.appSymbol := 'paperroll;
		a1.attachment := true;
		l3 := GetRoot().(GetVariable(a2, 'appSymbol));
		l3:ItemCompleted(a1, 'save)
	end,
	// protoTransport's ReceiveRequest, from the In/Out Box: frame2.cause 'user (Receive
	// tapped) checks for mail when connected, or opens connectOptionsSlip to connect;
	// 'Remote (a remote item to fetch) reads the next message. A request that comes while
	// the transport is busy is queued (QueueRequest). lastRequest is what came last.
	ReceiveRequest: func(frame2) begin
		if (frame2.cause = 'user) then begin
				if (if eworld then eworld.connected) then begin
						if (status = 'connected) then begin
								self:?SetStatusDialog('Checking, 'vStatus, nil);
								GetRoot().iobox:RemoveTempItems(appSymbol);
								// lists the mail as the user chose: Mail_ListUnread, Mail_ListRead or Mail_ListSent
								Perform(eworld, GetUserConfig('mailListMethod), [Array: ])
							end else begin
								if (lastRequest = 'ReceiveRequest) then begin
										return nil
									end else begin
										self:QueueRequest('ReceiveRequest, frame2);
										return nil
									end
							end
					end else begin
						if (if (not (if connectSlip then connectSlip.viewCObject)) then (status = 'idle)) then begin
								(connectSlip := BuildContext(connectOptionsSlip)).request := frame2;
								connectSlip.theApp := GetRoot().(owner);
								connectSlip.theTransport := self;
								connectSlip.connectionType := 'receive;
								connectSlip.clearOnClose := 'connectSlip;
								if connectSlip.theApp.viewCObject then begin
										connectSlip.theApp:RememberedOpen(connectSlip)
									end else begin
										connectSlip:Open()
									end
							end else begin
								return nil
							end
					end
			end else begin
				if (if (if (frame2.cause = 'Remote) then eworld) then eworld.connected) then begin
						if (status = 'connected) then begin
								eworld.request := frame2;
								eworld:GetNextMessage()
							end else begin
								if (lastRequest = 'ReceiveRequest) then begin
										self:QueueRequest(eworld.request, frame2)
									end else begin
										self:QueueRequest('ReceiveRequest, frame2);
										return nil
									end
							end
					end
			end;
		(lastRequest := 'ReceiveRequest)
	end,
	// The slip shown before connecting ("Send mail for"/"Receive mail for"): the account
	// (protoSenderPopup), the access number and what will be dialled, the kind of mail to
	// retrieve, and Connect, which validates the configuration and then has the transport
	// connect (DoConnect).
	connectOptionsSlip: {
		clearOnClose: nil,
		mailPhonePicker: nil,
		willDial: nil,
		theApp: nil,
		networkSymbols: networkSymbols,
		theTransport: nil,
		viewChildren: [viewChildren:
			{
				viewBounds: {left: 2, top: 2, right: 200, bottom: 15},
				// the slip's title says what the connection is for
				viewSetupFormScript: func() begin
					(if (connectionType = 'send) then (text := "Send mail for") else (text := "Receive mail for"))
				end,
				_proto: @protoStaticText
			},
			{
				viewBounds: {left: 0, top: 16, right: 200, bottom: 42},
				// the sender (persona) changed: refresh the access number picker
				JamIt: func() begin
					inherited:JamIt();
					mailPhonePicker:SyncView();
					mailPhonePicker:RedoChildren();
					mailPhonePicker:JamIt(true)
				end,
				_proto: @protoSenderPopup
			},
			mailPhonePicker,
			willDial_3,
			{
				viewBounds: {left: 5, top: -18, right: 56, bottom: -5},
				viewJustify: vjCenterH + vjCenterV + vjParentBottomV + oneLineOnly,
				text: options,
				popup: nil,
				pop: [|Array|:
					{item: "Retrieve Unread Mail", val: 'Mail_ListUnread, mark: $\ufc0b},
					{item: "Retrieve Read Mail", val: 'Mail_ListRead},
					{item: "Retrieve Sent Mail", val: 'Mail_ListSent}
				],
				// a copy of the menu, so the check mark can move in it
				viewSetupFormScript: func() begin
					popup := DeepClone(pop);
					inherited:viewSetupFormScript()
				end,
				// moves the check mark to the picked item and remembers its list method
				pickActionScript: func(index) begin
					local pos;
					if ((pos := LSearch(popup, listMethod, 0, '|=|, 'val)) <> index) then begin
							RemoveSlot(popup[pos], 'mark);
							popup[index].mark := $\uFC0B;
							listMethod := popup[index].val
						end;
					inherited:pickActionScript(index)
				end,
				_proto: @protoPopupButton
			},
			{
				// Cancel: closes the slip (through the application that opened it, when it is open)
				buttonClickScript: func() begin
					if theApp.viewCObject then begin
							AddDeferredSend(theApp, 'RememberedClose, [Array: base])
						end else begin
							base:Close()
						end;
					if callOptionsSlip.viewCObject then begin
							callOptionsSlip:Close()
						end;
					(if clearOnClose then (theTransport.(clearOnClose) := nil))
				end,
				_proto: @protoCancelButton
			},
			{
				viewBounds: {left: -55, top: 0, right: -7, bottom: 13},
				viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH + vjSiblingTopV,
				ValidateSlip: nil,
				SetPersona: nil,
				setEmporia: nil,
				// true once Connect has been tapped, so a second tap does nothing
				spasticUser: nil,
				text: "Connect",
				// closes a validation slip left open
				viewQuitScript: func() begin
					if ValidateSlip then begin
							ValidateSlip:Close()
						end;
					inherited:?viewQuitScript();
					(spasticUser := nil)
				end,
				// Connect: saves the list method and number; with no account set up it registers one
				// (DoRegister), else it validates the owner's e-mail data (MoreValidation follows)
				buttonClickScript: func() begin
					if spasticUser then begin
							return nil
						end;
					spasticUser := true;
					if (listMethod <> GetUserConfig('mailListMethod)) then begin
							SetUserConfig('mailListMethod, listMethod)
						end;
					if (not StrEqual(willDialNum, GetUserConfig('mailPhoneFull))) then begin
							SetUserConfig('mailPhoneFull, willDialNum)
						end;
					(if ((not userConfiguration.mailAccount) or (not StrFilled(userConfiguration.mailAccount))) then begin
							if theApp.viewCObject then begin
									AddDeferredSend(theApp, 'RememberedClose, [Array: base])
								end else begin
									base:Close()
								end;
							if callOptionsSlip.viewCObject then begin
									callOptionsSlip:Close()
								end;
							if clearOnClose then begin
									theTransport.(clearOnClose) := nil
								end;
							AddDeferredSend(theTransport, 'DoRegister, [Array: request])
						end else (SetPersona := (not self:ValidateConfig('owner, nil, '[Array: email, emailPassword], msgValidateSource, 'ValidateSlip, 'MoreValidation))))
				end,
				// after the owner's account was validated (a1 true): validate the access number too
				// when there is none, then ValidationComplete
				MoreValidation: func(a1) begin
					local mailPhoneFull;
					(if a1 then begin
							setEmporia := nil;
							(if (if (mailPhoneFull := GetUserConfig('mailPhoneFull)) then StrFilled(mailPhoneFull)) then self:ValidationComplete(true) else (setEmporia := (not self:ValidateConfig('location, nil, '[Array: mailPhone], msgValidateNumber, 'ValidateSlip, 'ValidationComplete))))
						end)
				end,
				// everything valid: close the slip and connect with the current worksite and persona
				ValidationComplete: func(a1) begin
					(if a1 then begin
							if callOptionsSlip.viewCObject then begin
									callOptionsSlip:Close()
								end;
							theEmporium := ResolveEntryAlias(userConfiguration.currentEmporium);
							thePersona := ResolveEntryAlias(userConfiguration.currentPersona);
							if SetPersona then begin
									UseCurrentPersona()
								end;
							if setEmporia then begin
									UseCurrentEmporium()
								end;
							SetPersona := nil;
							setEmporia := nil;
							if theApp.viewCObject then begin
									AddDeferredSend(theApp, 'RememberedClose, [Array: base])
								end else begin
									base:Close()
								end;
							if clearOnClose then begin
									theTransport.(clearOnClose) := nil
								end;
							AddDeferredSend(theTransport, 'DoConnect, [Array: theEmporium, thePersona, request, GetUserConfig('mailMode), listMethod])
						end)
				end,
				_proto: @protoTextButton
			},
			callassist_2
		],
		msgValidateSource: yourConfigurationIsIncomplete,
		thePersona: nil,
		ReOrientToScreen: @defRotateFunc,
		// called back by the call options slip: shows the number that will be dialled
		UpdatePhone: func() begin
			willDialNum := callOptionsSlip.outNumber.text;
			SetValue(willDial, 'text, willDialNum)
		end,
		viewBounds: {left: 0, top: 0, right: 210, bottom: 130},
		msgValidateNumber: yourConfigurationIsIncomplete_2,
		allocateContext: [|Array|: 'mailPhonePicker, mailPhonePicker, 'willDial, willDial_3, 'callassist, callassist_2],
		_proto: @protoFloater,
		willDialNum: nil,
		theEmporium: nil,
		viewJustify: vjParentCenterH + vjParentCenterV,
		callassist: nil,
		declareSelf: 'base,
		// starts with unread mail and the number the access number will be dialled as
		viewSetupFormScript: func() begin
			listMethod := 'Mail_ListUnread;
			willDialNum := self:MungePhone(GetUserConfig('mailPhone), GetUserConfig('currentCountry));
			inherited:?viewSetupFormScript()
		end,
		request: nil,
		listMethod: 'Mail_ListUnread,
		addressSymbols: addressSymbols
	},
	// 'SendRequest or 'ReceiveRequest: the request last handled
	lastRequest: nil,
	// Put Away to Notes: makes a Notes item of a1's text.
	doCopyToNotes: func(a1, a2) begin
		playsound(@plunk);
		GetRoot().paperroll:MakeTextNote(a1.text, true)
	end,
	networkSymbols: networkSymbols,
	preallocatedContext: 'mailcategory,
	// the status dialog's text for each status (SetStatusDialog)
	dialogStatusMsgs: {
		idle: uCardPositionAlertButton,
		Initializing: "Initializing Modem…",
		dialing: @connectMessage,
		Connecting: "Connecting to Network…",
		Login: "Connecting to America Online…",
		connected: "Connected…",
		Sending: sending,
		SendFile: "Sending Attachment…",
		Checking: "Checking for Mail…",
		Storing: "Storing…",
		Receiving: receiving,
		ReceiveFile: "Receiving Attachment…",
		Disconnecting: @disconnectMessage,
		Canceling: canceling
	},
	actionTitle: mail_2,
	// protoTransport's AppClosed (the In/Out Box closed): when connected interactively,
	// offers to disconnect (DoShutdown gets the answer).
	AppClosed: func(a1) begin
		(if (if (if eworld then eworld.connected) then (eworld.mode = 'interactive)) then self:Confirm(title, "Do you want to disconnect from America Online? Staying connected may affect handwriting recognition.", self, 'DoShutdown))
	end,
	// The Forward action (GetTransportScripts): a copy of the item a1 as a new outgoing
	// mail, "Fwd: " title, no addressees, the original's header lines put before its text
	// when it has no attachment.
	doForward: func(a1, a2) begin
		local l1, textHeader, rejectAll;
		l1 := GetRoot().(GetVariable(a2, 'appSymbol));
		l1:?MarkRead(a1);
		(a1 := DeepClone(a1)).reply := true;
		a1.box := nil;
		a1._proto := nil;
		a1.state := 'pending;
		a1.Connect := 'notreally;
		RemoveSlot(a1, '_uniqueID);
		RemoveSlot(a1, '_modTime);
		RemoveSlot(a1, 'xlabels);
		RemoveSlot(a1, 'labels);
		RemoveSlot(a1, 'timestamp);
		RemoveSlot(a1, 'account);
		a1.toRef := [Array: ];
		a1.cc := [Array: ];
		a1.bcc := [Array: ];
		a1.edited := true;
		if (not a1.body) then begin
				textHeader := GetRoot().mailSlip:TextHeader(a1);
				a1.text := Stringer([Array: textHeader, $\n, a1.text])
			end;
		if (if (if a1.title then IsString(a1.title)) then StrFilled(a1.title)) then begin
				if (if (not BeginsWith((rejectAll := StringFilter(Substr(a1.title, 0, 6), " 0123456789()", 'rejectAll)), "Fwd>")) then (not BeginsWith(rejectAll, "Fwd:"))) then begin
						a1.title := Stringer([Array: "Fwd: ", a1.title])
					end
			end;
		l1 := GetRoot().(GetVariable(a2, 'appSymbol));
		l1:ItemCompleted(a1, 'save)
	end,
	// the status dialog as a barber pole
	MailReceiveStatus: func() begin
		self:SetStatus(status, {barber: true})
	end,
	// protoTransport's GetItemTitle: the item's title, or else the first 32 characters of
	// its data's text (StringExtract), a longer text cut to 31 and an ellipsis.
	GetItemTitle: func(a1) begin
		local text, targetFromEntry, dataDefs, stringExtract;
		text := "";
		if a1 then begin
				if StrFilled(a1.title) then begin
						text := a1.title
					end else begin
						if (dataDefs := GetDataDefs(DataClassOf((targetFromEntry := GetTargetFromEntry(a1))))) then begin
								if (stringExtract := dataDefs:?StringExtract(targetFromEntry, 1)) then begin
										text := (if (StrLen(stringExtract) > 32) then Stringer([Array: Substr(stringExtract, 0, 31), $\u2026]) else stringExtract)
									end
							end
					end
			end;
		Clone(text)
	end,
	// protoTransport's AppInFront: the In/Out Box going to the back counts as closing.
	AppInFront: func(a1, a2) begin
		(if (not a1) then self:AppClosed(a2))
	end,
	// Turns automatic delivery (the periodic alarm, PeriodicAlarm) on or off.
	EnableAlarms: func(viewValue) begin
		SetUserConfig('mailAlarms, viewValue)
	end,
	// whether automatic delivery is on (preferencesForm's Auto Delivery)
	AlarmsEnabled: func() begin
		GetUserConfig('mailAlarms)
	end,
	group: 'mail,
	msgValidateNumber: yourConfigurationIsIncomplete_2,
	_proto: @protoTransport,
	// The Add to Names action: asks for a name for the sender's e-mail address (split
	// from fromName at its first blank into first and last) and adds a Names card
	// (DoAddName).
	saveAddress: func(a1, a2) begin
		local l1, fromRef, part, text, pos;
		l1 := @protoPeopleDataDef;
		if (if (fromRef := a1.fromRef).name.last then StrEqual(fromRef.name.last, fromRef.email)) then begin
				fromRef.name.last := nil
			end;
		if (if a1.fromName then (StrLen(a1.fromName) > 0)) then begin
				if (if (pos := StrPos((text := TrimString(a1.fromName)), " ", 0)) then (pos > 0)) then begin
						part := Substr(text, (pos + 1), StrLen(text));
						text := Substr(text, 0, pos)
					end;
				fromRef.name.last := part;
				fromRef.name.first := text
			end;
		GetRoot().mailSlip.nameToAdd := fromRef;
		ValidateConfigGuts(fromRef, l1.validationFrame, [Array: 'name], {userText: ParamStr("Please specify a name for eMail address \u201C\u^0\u201D\u", [Array: fromRef.email]), titleText: "E-Mail Name", context: GetRoot().mailSlip, receiver: GetRoot().mailSlip, message: 'DoAddName})
	end,
	// protoTransport's VerifyRoutingInfo, for each item being sent: gives it a title (cut
	// to 61 characters), and the text the format's TextScript makes. Ink in either is
	// removed, each ink word (character $ﰂ) written "-ink-". A body is kept only for
	// an attachment.
	VerifyRoutingInfo: func(copy, fields, next, cursorFormat) begin
		local textScript, l2;
		if (not copy.title) then begin
				copy.title := self:?GetItemTitle(next);
				if (not copy.title) then begin
						copy.title := self:?GetItemTitle(NewItem)
					end;
				if (not copy.title) then begin
						copy.title := Clone(fields.title)
					end
			end;
		if IsRichString(copy.title) then begin
				StripInk(copy.title, $\uFC02);
				StrReplace(copy.title, "\uFC02\u", "-ink-", nil);
				if (StrLen(copy.title) > 61) then begin
						copy.title := Substr(copy.title, 0, 61)
					end
			end;
		if copy.reply then begin
				return nil
			end;
		l2 := GetRoot().(copy.appSymbol);
		textScript := cursorFormat.TextScript;
		copy.text := " ";
		if textScript then begin
				if IsSymbol(textScript) then begin
						copy.text := Perform(l2, textScript, [Array: copy, next])
					end else begin
						copy.text := call textScript with (copy, next)
					end
			end;
		if IsRichString(copy.text) then begin
				StripInk(copy.text, $\uFC02);
				StrReplace(copy.text, "\uFC02\u", "-ink-", nil)
			end;
		(if (if copy.body then (not copy.attachment)) then (copy.body := nil))
	end,
	// the connectOptionsSlip while it is open
	connectSlip: nil,
	// Connects: a1 the worksite (emporium: where the access number comes from), a2 the
	// persona (the account), a3 the request, a4 the mode ('interactive: browse the mail
	// list, 'batch: download it all), a5 the list method. The account, password and number
	// are converted from ink first (ConvertStart and its completions), then LoginToHost.
	DoConnect: func(a1, a2, a3, a4, a5) begin
		self.eworld := {_proto: protoEworld, mode: a4, _parent: self};
		eworld.request := a3;
		eworld.transport := self;
		eworld.listMethod := a5;
		eworld._worksite := a1;
		eworld._owner := a2;
		AddDeferredSend(self, 'ConvertStart, nil)
	end,
	// protoTransport's IOBoxExtensions: the views the In/Out Box may show an item in - a
	// package's information, or the mail's text ('mailTextView, the one chosen).
	IOBoxExtensions: func(entry, targetFromEntry, copy, routeScripts) begin
		if ((entry.class = 'smartMail) or (entry.state = 'InLog)) then begin
				return nil
			end;
		if entry.package then begin
				copy.packageTextView := GetViewDefs('packageFrame).default
			end;
		(if ((if entry.edited then (not IsInstance(targetFromEntry, 'mailText))) or (if (Length(copy) = 0) then entry.text)) then begin
				copy.mailTextView := GetViewDefs('mailText).default;
				'mailTextView
			end)
	end,
	addressingClass: '|nameRef.email|,
	InkConvert: nil,
	error: nil,
	// The header lines (Subject, From, Sent, Received, To, Cc, Bcc) of a received item,
	// as text; doForward puts them before a forwarded mail's text.
	TextHeader: func(target) begin
		text := ParamStr("Subject: ^0\n", [Array: target.title]);
		l2 := (if (if target.fromName then (StrLen(target.fromName) > 0)) then ParamStr("From: ^0 (^1)\n", [Array: target.fromName, target.fromRef.email]) else ParamStr("From: ^0\n", [Array: target.fromRef.email]));
		text := Stringer([Array: (text := Stringer([Array: (text := Stringer([Array: text, l2])), "Sent: ", target.dateStr, $\n])), ParamStr("Received: ^2 ^0 ^1\n", [Array: LongDateStr(target.timestamp, @datetimeStrSpecs.abbrDayOfWeekStrSpec), ShortDateStr(target.timestamp, @datetimeStrSpecs.numericDateStrSpec), HourMinute(target.timestamp)])]);
		if (Length(target.toRef) > 0) then begin
				local text;
				local l2;
				(for i := 0 to (Length(target.toRef) - 1) do begin
						if (i = 0) then begin
								text := Stringer([Array: text, "To: ", target.toRef[0].email])
							end else begin
								text := Stringer([Array: text, ", ", target.toRef[i].email])
							end
					end);
				text := Stringer([Array: text, $\n])
			end;
		if (Length(target.cc) > 0) then begin
				(for i := 0 to (Length(target.cc) - 1) do begin
						if (i = 0) then begin
								text := Stringer([Array: text, "Cc: ", target.cc[0].email])
							end else begin
								text := Stringer([Array: text, ", ", target.cc[i].email])
							end
					end);
				text := Stringer([Array: text, $\n])
			end;
		if (Length(target.bcc) > 0) then begin
				(for i := 0 to (Length(target.bcc) - 1) do begin
						if (i = 0) then begin
								text := Stringer([Array: text, "Bcc: ", target.bcc[0].email])
							end else begin
								text := Stringer([Array: text, ", ", target.bcc[i].email])
							end
					end);
				text := Stringer([Array: text, $\n])
			end;
		text
	end,
	appSymbol: 'mailSlip,
	// The packet networks an AOL access number can be on, each with the protoNavigator
	// script that logs in to AOL through it (newtMailNetChooser lists them by id). The
	// first is SprintNet (mailNetworksProto itself).
	mailNetworks: [|Array|:
		mailNetworksProto,
		{
			_proto: mailNetworksProto,
			title: "Concert",
			id: 'concert,
			curerror: nil,
			// Concert's login: reads the modem speed, then waits for "log in:" (waitForLogin),
			// answers with the network identifier, waits for "+" and asks for NEWTMAIL0001.
			mailStart: func() begin
				speed := (speed := mailEndPoint:option((speed := [Array: {label: "mspd", type: 'option, opCode: opGetCurrent, data: {arglist: [Array: 0], typelist: [Array: 10, 1]}}]), nil))[0].data.arglist[0];
				if (transport exists) then begin
						transport:?SetStatusDialog('Connecting, 'vStatusTitle, {titleText: Stringer([Array: title, " ", "-", " ", speed, " ", "baud"])})
					end;
				mailEndPoint.curstate := 'waitForLogin;
				mailEndPoint:SetInputSpec(mailEndPoint.waitForLogin);
				// in 10 seconds: an "A" if the network has not asked for the login by then
				AddDelayedCall(func() begin
					self:mailStartContinue()
				end, nil, 10000)
			end,
			// 10 seconds into the login: an "A" if the network has not asked for the login yet
			mailStartContinue: func() begin
				(if (mailEndPoint.curstate = 'waitForLogin) then (try begin
							mailEndPoint:output($A, nil, {async: true})
						end onexception |evt.ex| do begin
							self:quit()
						end))
			end,
			mailEndPoint: {
				_proto: @protoBasicEndpoint,
				// an endpoint error stops the login (quit), the first error kept
				ExceptionHandler: func(ex) begin
					if (curerror = nil) then begin
							curerror := ex.data
						end;
					self:quit()
				end,
				waitForLogin: {
					form: '|string|,
					filter: {sevenbit: true},
					termination: {endsequence: "log in:"},
					// "log in:" seen: answer with the AOL address (networkIdentifier) and wait for "+"
					InputScript: func(a1, a2, a3, a4) begin
						(if (a1.curstate = 'waitForLogin) then begin
								a1.curstate := 'waitForPlus;
								(try begin
										a1:SetInputSpec(a1.waitForPlus);
										a1:output(Stringer([Array: a1:networkIdentifier(), "\n"]), nil, {async: true})
									end onexception |evt.ex| do begin
										self:quit()
									end)
							end)
					end,
					completionscript: completionscript,
					// milliseconds
					reqTimeout: 20000
				},
				waitForPlus: {
					form: '|string|,
					filter: {sevenbit: true},
					termination: {endsequence: $+},
					// "+" seen: ask for the Newton mail service and wait for "call connected"
					InputScript: func(a1, a2, a3, a4) begin
						(if (a1.curstate = 'waitForPlus) then begin
								a1.curstate := 'waitForConnected;
								(try begin
										a1:SetInputSpec(a1.waitForConnected);
										a1:output("NEWTMAIL0001\n", nil, {async: true})
									end onexception |evt.ex| do begin
										self:quit()
									end)
							end)
					end,
					completionscript: completionscript,
					reqTimeout: 30000
				},
				waitForConnected: {
					form: '|string|,
					filter: {sevenbit: true},
					termination: {endsequence: "call connected"},
					// connected: the script is done (stopCCL)
					InputScript: func(a1, a2, a3, a4) begin
						(if (a1.curstate = 'waitForConnected) then begin
								a1.curstate := nil;
								a1:SetInputSpec(nil);
								AddDeferredSend(a1, 'stopCCL, nil)
							end)
					end,
					completionscript: completionscript,
					reqTimeout: 30000
				}
			}
		}
	],
	icon: {
		bits: bitmap('bits, "resources/bits/5a3eb9.png", "000000000004003f003f0198004f01ae", 1),
		bounds: {left: 0, top: 0, right: 22, bottom: 16}
	},
	title: americaOnline,
	// protoTransport's CancelRequest (Stop, or 'hostCancel): stops the login script, or
	// cancels or aborts the connection; returns true when there was none.
	CancelRequest: func(symbol2) begin
		self:?SetStatusDialog('Canceling, 'vStatus, {primary: nil});
		if eworld then begin
				if eworld.navigator then begin
						eworld.navigator:quit()
					end else begin
						if (eworld.connectState = 'Bind) then begin
								eworld:Cancel(nil)
							end else begin
								eworld:ConnectionAbort()
							end
					end
			end else begin
				self:SetStatus('idle, nil)
			end;
		(not eworld)
	end,
	dataTypes: [|Array|: 'text, 'frame, 'mail],
	// The Reply action: a reply to the sender of a1 (ReallyDoReply).
	doReply: func(a1, a2) begin
		local l1, l2;
		l2 := GetRoot().(GetVariable(a2, 'appSymbol));
		l2:?MarkRead(a1);
		(a1 := DeepClone(a1)).name := a1.fromName;
		a1.toRef := [Array: a1.fromRef];
		a1.cc := '[Array: ];
		a1.bcc := '[Array: ];
		GetRoot().mailSlip:ReallyDoReply(a1, a2)
	end,
	// The connection to the AOL host: an @protoEworldEndpoint (the native endpoint that
	// speaks AOL's protocol), with the scripts it calls back as each step finishes. The
	// transport makes one per connection (DoConnect: eworld).
	protoEworld: {
		msg: nil,
		mode: nil,
		firstTime: nil,
		_proto: @protoEworldEndpoint,
		// a queued request runs next; with none, log out
		LogoutIfNoRequests: func() begin
			local requestQueueItem;
			(if (if requestQueue then (Length(requestQueue) > 0)) then begin
					requestQueueItem := requestQueue[0];
					SetRemove(requestQueue, requestQueueItem);
					AddDeferredSend(self, requestQueueItem.function, [Array: requestQueueItem])
				end else self:Logout())
		end,
		// logging out: the status dialog says so
		LogoutScript: func() begin
			self:?SetStatusDialog('Disconnecting, 'vStatus, {primary: nil})
		end,
		// logged out: idle; an interactive session's remote items (headers only) are dropped
		LogoutDoneScript: func() begin
			self:SetStatus('idle, nil);
			(if (self.mode = 'interactive) then GetRoot().iobox:RemoveTempItems(appSymbol))
		end,
		// logged in to the host: send what the request has (SendNextMessage)
		LoginDoneScript: func() begin
			self:SendNextMessage()
		end,
		// Sends the next item the request has (Mail_Send; Mail_SendDone follows). With none
		// left: on the first pass after login, lists the mail (or logs out, when the user wants
		// a disconnect after sending a send request); otherwise just shows "connected".
		SendNextMessage: func() begin
			local mailMode, cause, firstTime;
			eworld.msg := self:?ItemRequest(eworld.request);
			(if msg then begin
					self:?SetStatusDialog('Sending, 'vStatusTitle, {titleText: msg.title});
					msg.error := nil;
					self:Mail_Send(msg)
				end else begin
					mailMode := GetUserConfig('mailMode);
					cause := eworld.request.cause;
					firstTime := eworld.firstTime;
					eworld.request := nil;
					eworld.msg := nil;
					eworld.firstTime := nil;
					if (not mailMode) then begin
							mailMode := 'interactive
						end;
					(if firstTime then (if (if GetUserConfig('mailautodisconnect) then (lastRequest = 'SendRequest)) then self:LogoutIfNoRequests() else begin
								// automatic delivery always downloads the mail
								eworld.mode := (if (cause = 'periodic) then 'batch else mailMode);
								self:?SetStatusDialog('Checking, 'vStatus, nil);
								GetRoot().iobox:RemoveTempItems(appSymbol);
								Perform(eworld, listMethod, [Array: ])
							end) else begin
							self:?SetStatusDialog('connected, 'vStatus, nil);
							self:?CloseStatusDialog(nil)
						end)
				end)
		end,
		// the host is ready for an attachment: upload it with a gauge
		File_UploadStart: func(file_out) begin
			self:?SetStatusDialog('SendFile, 'vGauge, {titleText: msg.title, gauge: [Array: 0, 0, file_out.filesize]});
			self:uploadfile(file_out.data, file_out.filesize, transport, file_out.type, file_out.creator);
			(if file_out.reply then self:output(file_out.reply, nil, nil))
		end,
		// an item sent (string2 nil) or not (string2 the error): mark it, send the next
		Mail_SendDone: func(string2) begin
			if string2 then begin
					self:?ItemCompleted(eworld.msg, nil, string2)
				end else begin
					self:?ItemCompleted(eworld.msg, 'Sent, nil)
				end;
			self:SendNextMessage()
		end,
		// The host's answer to Mail_ListUnread/Read/Sent: list.items is a binary of flattened
		// headers. 'batch mode reads them all (GetNextMessage); 'interactive mode puts each into
		// the In Box as a remote item (only its header) to fetch when opened.
		ListDone: func(list) begin
			local mailListMethod, text, unflattenListItem;
			if (not list) then begin
					if ((mailListMethod := GetUserConfig('mailListMethod)) = 'Mail_ListUnread) then begin
							text := "new"
						end else begin
							if (mailListMethod = 'Mail_ListRead) then begin
									text := "read"
								end else begin
									if (mailListMethod = 'Mail_ListSent) then begin
											text := "sent"
										end
								end
						end;
					GetRoot():Notify(kNotifyAlert, transport.title, ParamStr("No ^0 mail", [Array: text]))
				end;
			(if (mode = 'batch) then begin
					self.mail_list := list;
					(if list then self:GetNextMessage() else self:LogoutIfNoRequests())
				end else begin
					try begin
							if (if list then list.items) then begin
									(while (Length(list.items) > 0) do begin
											unflattenListItem := self:UnflattenListItem(list.items);
											// id 0: not a mail item; skipped
											(while (if (unflattenListItem.id = 0) then (Length(list.items) > 0)) do (unflattenListItem := self:UnflattenListItem(list.items)));
											unflattenListItem.Remote := true;
											unflattenListItem.category := appSymbol;
											self:?SetStatusDialog('Storing, 'vBarber, {titleText: Stringer([Array: unflattenListItem.from, ", ", unflattenListItem.title]), barber: true});
											self:?ItemCompleted(unflattenListItem, 'Received, nil)
										end)
								end
						end onexception |evt.ex.outofmem| do begin
							self:?SetStatusDialog('connected, 'vStatus, nil);
							self:?CloseStatusDialog(nil);
							GetRoot().(owner):?UpdateLayout();
							Rethrow()
						end;
					self:?SetStatusDialog('connected, 'vStatus, nil);
					self:?CloseStatusDialog(nil)
				end)
		end,
		// shows a header as it arrives (date, from, title, tab separated)
		ListItem: func(listentry) begin
			local extractLong2, string2;
			extractLong2 := ExtractLong(listentry, 0);
			(if (Length((string2 := StrParse(ExtractBytes(listentry, 12, (extractLong2 - 12), 'string), "\t"))) = 3) then self:?SetStatusDialog('Checking, 'vBarber, {titleText: Stringer([Array: string2[1], ", ", string2[2]]), barber: true}))
		end,
		// Takes the first header out of the binary items and returns it as a frame. Each is a
		// long length (of the whole record), a long id, a long of display flags, and then the
		// text "mm/dd<tab>from<tab>title"; the date gets the year that puts it in the past
		// year.
		UnflattenListItem: func(items) begin
			local copy, extractLong2, strParse2, strParse3, date2, frame2;
			copy := Clone('{id: nil, Display: nil, label: nil, Date: nil, from: nil, title: nil});
			extractLong2 := ExtractLong(items, 0);
			copy.id := ExtractLong(items, 4);
			copy.Display := ExtractLong(items, 8);
			copy.label := ExtractBytes(items, 12, (extractLong2 - 12), 'string);
			if (Length((strParse2 := StrParse(copy.label, "\t"))) = 3) then begin
					copy.Date := strParse2[0];
					copy.from := strParse2[1];
					copy.title := strParse2[2];
					if copy.Date then begin
							if (Length((strParse3 := StrParse(copy.Date, "/"))) > 1) then begin
									if ((frame2 := {year: (date2 := Date(Time())).year, month: floor(StringToNumber(strParse3[0])), Date: floor(StringToNumber(strParse3[1])), hour: 0, minute: 0, second: 0}).month > date2.month) then begin
											frame2.year := (frame2.year - 1)
										end;
									copy.timestamp := TotalMinutes(frame2)
								end else begin
									copy.timestamp := Time()
								end
						end
				end else begin
					copy.Date := (copy.from := (copy.title := ""))
				end;
			BinaryMunger(items, 0, extractLong2, nil, 0, nil);
			copy
		end,
		// Reads the next message: 'batch mode the next of mail_list (all of them, then
		// disconnects), 'interactive mode the item the request asks for (Mail_Read).
		GetNextMessage: func() begin
			local unflattenListItem;
			(if (mode = 'batch) then (if (Length(mail_list.items) > 0) then begin
						unflattenListItem := self:UnflattenListItem(mail_list.items);
						(while (if (unflattenListItem.id = 0) then (Length(mail_list.items) > 0)) do (unflattenListItem := self:UnflattenListItem(mail_list.items)));
						self:?SetStatusDialog('Receiving, 'vBarber, {titleText: Stringer([Array: unflattenListItem.from, ", ", unflattenListItem.title]), barber: true});
						self:Mail_Read(unflattenListItem.id, transport)
					end else begin
						eworld.msg := nil;
						eworld.mail_list := nil;
						self:ConnectionAbort()
					end) else begin
					self.message := self:ItemRequest(eworld.request);
					(if message then begin
							self:?SetStatusDialog('Receiving, 'vBarber, {titleText: message.label, barber: true});
							self:Mail_Read(message.id, transport)
						end else begin
							self:?SetStatusDialog('connected, 'vStatus, nil);
							self:?CloseStatusDialog(nil)
						end)
				end)
		end,
		// A message read (Mail_Read): downloads its attachment first (Mail_Download, with a
		// gauge), else files it (submit). In interactive mode the read slots join the remote
		// item's.
		Mail_Message: func(mail_in) begin
			(if (mode = 'batch) then begin
					if (not mail_in) then begin
							return self:GetNextMessage()
						end;
					(if mail_in.hasfile then begin
							self:?SetStatusDialog('ReceiveFile, 'vGauge, {titleText: mail_in.title, gauge: [Array: 0, 0, mail_in.filesize]});
							self:Mail_Download(mail_in, transport)
						end else self:submit(mail_in))
				end else begin
					if ((mail_in = nil) or (message = nil)) then begin
							return self:GetNextMessage()
						end;
					(foreach key, value in mail_in do begin
							message.(key) := value
						end);
					(if message.hasfile then begin
							self:?SetStatusDialog('ReceiveFile, 'vGauge, {titleText: mail_in.title, gauge: [Array: 0, 0, mail_in.filesize]});
							self:Mail_Download(message, transport)
						end else self:submit(message))
				end)
		end,
		// Files a received message in the In Box: as received ('batch) or completed
		// (interactive), its dateStr ("yy-mm-dd hh:mm:ss") made its timestamp. A text longer than
		// 4096 characters is split, at blanks, into items titled "1/n ...", "2/n ...".
		submit: func(message) begin
			iobox := GetRoot().iobox;
			if (if (mode = 'interactive) then (not iobox.viewCObject)) then begin
					iobox:OpenAsInBox()
				end else begin
					if iobox.viewCObject then begin
							iobox:SetBox('inbox)
						end
				end;
			self:?SetStatusDialog('Storing, 'vStatusTitle, {titleText: message.title});
			message.category := appSymbol;
			message.class := 'mailText;
			if (mode = 'batch) then begin
					message.progress := "";
					message.state := 'Received
				end else begin
					message.Remote := nil
				end;
			if message.dateStr then begin
					if (Length((strParse2 := StrParse(message.dateStr, " "))) > 1) then begin
							strParse3 := StrParse(strParse2[0], "-");
							strParse4 := StrParse(strParse2[1], ":");
							if (if (Length(strParse3) = 3) then (Length(strParse4) = 3)) then begin
									// two-digit years: 95 and on are 19xx, the rest 20xx
									if ((frame2 := {year: floor(StringToNumber(strParse3[0])), month: floor(StringToNumber(strParse3[1])), Date: floor(StringToNumber(strParse3[2])), hour: floor(StringToNumber(strParse4[0])), minute: floor(StringToNumber(strParse4[1])), second: floor(StringToNumber(strParse4[2]))}).year >= 95) then begin
											frame2.year := (frame2.year + 1900)
										end else begin
											frame2.year := (frame2.year + 2000)
										end;
									message.timestamp := TotalMinutes(frame2)
								end else begin
									message.timestamp := Time()
								end
						end
				end;
			// list: the split points as byte offsets (two bytes a character), each cut moved back
			// to a blank
			if (if message.text then (StrLen(message.text) > 4096)) then begin
					list := [Array: 0];
					i := 4095;
					text := message.text;
					message.text := nil;
					(while (i < StrLen(text)) do begin
							(while (not IsWhiteSpace(text[i])) do (i := (i - 1)));
							AddArraySlot(list, (i * 2));
							(i := (i + 4096))
						end);
					AddArraySlot(list, (StrLen(text) * 2));
					l10 := (Length(list) - 1);
					local iobox;
					local strParse2;
					local strParse3;
					local strParse4;
					local frame2;
					local list;
					local i;
					local text;
					local copy;
					local l10;
					(for i := 0 to (Length(list) - 2) do begin
							if (i = 0) then begin
									message := DeepClone((copy := message))
								end else begin
									copy := DeepClone(message)
								end;
							copy.title := Stringer([Array: (i + 1), $/, l10, " ", copy.title]);
							copy.text := self:GetDefaultOwnerStore():NewVBO('string, 2);
							BinaryMunger(copy.text, 0, 0, text, list[i], (list[(i + 1)] - list[i]));
							if (if (i = 0) then (mode = 'interactive)) then begin
									self:?ItemCompleted(copy, 'Received, nil)
								end else begin
									self:?ItemCommit(copy)
								end
						end)
				end else begin
					if (mode = 'batch) then begin
							self:?ItemCommit(message)
						end else begin
							self:?ItemCompleted(message, 'Received, nil)
						end
				end;
			if (mode = 'interactive) then begin
					iobox:Refresh();
					self.message := nil
				end;
			self:GetNextMessage()
		end,
		// an attachment downloaded: the message is filed (submit)
		Mail_DownloadDoneScript: func(mailmessage) begin
			(if (mode = 'batch) then self:submit(mailmessage) else begin
					(foreach key, value in mailmessage do begin
							message.(key) := value
						end);
					self:submit(message)
				end)
		end
	},
	// protoTransport's GetFromText: the sender as the In/Out Box shows it.
	GetFromText: func(target) begin
		(if target.fromRef then GetDataDefs(addressingClass):GetRoutingTitle(target.fromRef, nil, nil) else target.from)
	end,
	// saveAddress's completion: adds the Names card
	DoAddName: func(a1) begin
		@protoPeopleDataDef:NewEntry(GetRoot().mailSlip.nameToAdd, nil)
	end,
	// Sets up the account: without online registration it only says the account
	// information is incomplete; with no account yet it opens newAccountSlip (create an
	// account or use an existing one), else mailRegister. a1: the request to carry on with.
	DoRegister: func(a1) begin
		local context;
		if (not self:GetConfig('onlineRegEnabled)) then begin
				self:Notify(kNotifyQAlert, title, "Your mail account information is not complete or is not valid.  Please make sure you have a valid America Online account and all the account settings are correct.");
				return nil
			end;
		(if ((not userConfiguration.mailAccount) or (not StrFilled(userConfiguration.mailAccount))) then begin
				(context := BuildContext(newAccountSlip)).request := a1;
				context.theApp := GetRoot().(owner);
				context.theTransport := self;
				context:Open()
			end else begin
				mailRegister.request := a1;
				mailRegister:Open()
			end)
	end,
	// The Reply to All action: a reply to the sender and every addressee but this account.
	doReplyAll: func(a1, a2) begin
		local pos, l2;
		l2 := GetRoot().(GetVariable(a2, 'appSymbol));
		l2:?MarkRead(a1);
		ArrayInsert((a1 := DeepClone(a1)).toRef, a1.fromRef, 0);
		a1.name := a1.fromName;
		if (if (pos := LSearch(a1.toRef, a1.account, 0, '|str=|, 'email)) then (Length(a1.toRef) > 1)) then begin
				ArrayRemoveCount(a1.toRef, pos, 1)
			end;
		if (pos := LSearch(a1.cc, a1.account, 0, '|str=|, 'email)) then begin
				ArrayRemoveCount(a1.cc, pos, 1)
			end;
		if (pos := LSearch(a1.bcc, a1.account, 0, '|str=|, 'email)) then begin
				ArrayRemoveCount(a1.bcc, pos, 1)
			end;
		GetRoot().mailSlip:ReallyDoReply(a1, a2)
	end,
	// protoTransport's GetTransportScripts: the Action button's extra items for a received
	// item - Reply, Reply to All (more than one addressee), Forward, and Add to Names when
	// the sender is not in Names.
	GetTransportScripts: compile(
		constants: {
			// the action items' titles
			kFunction_5a3471: func(a1) begin
				"Reply"
			end,
			kROM_756: @routeReply,
			kFunction_5a3491: func(a1) begin
				"Reply to All"
			end,
			kFunction_5a34b1: func(a1) begin
				"Forward"
			end,
			kROM_771: @routeForward,
			kFunction_5a356d: func(a1) begin
				"Add to Names"
			end,
			kROM_772: @routeAddSender
		},
		func(target) begin
			local list, soup, cursor;
			if ((target.state = 'pending) or (target.state = 'ready)) then begin
					return nil
				end;
			list := [Array: ];
			if target.account then begin
					AddArraySlot(list, {GetTitle: kFunction_5a3471, routeScript: doReply, icon: kROM_756});
					if (((if IsArray(target.toRef) then (Length(target.toRef) > 1)) or (if IsArray(target.cc) then (Length(target.cc) > 0))) or (if IsArray(target.bcc) then (Length(target.bcc) > 0))) then begin
							AddArraySlot(list, {GetTitle: kFunction_5a3491, routeScript: doReplyAll, icon: kROM_756})
						end;
					AddArraySlot(list, {GetTitle: kFunction_5a34b1, routeScript: doForward, icon: kROM_771})
				end;
			if target.fromRef then begin
