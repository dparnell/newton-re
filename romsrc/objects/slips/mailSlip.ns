	// The header shown above a mail item in the In/Out Box: its attachment, Sent and From
	// lines for a received item (To for an outgoing one), then the To, Cc and Bcc lines.
	transportInfoForm: {
		// addedHeight is BuildText's: below 20 there are no addressees to show, so the lines
		// are hidden (viewFlags 0)
		viewSetupChildrenScript: func() begin
			(if (addedHeight < 20) then begin
					toLine.viewFlags := 0;
					ccLine.viewFlags := 0;
					bccLine.viewFlags := 0;
					(if (addedHeight = 0) then (labelLine.viewFlags := 0))
				end)
		end,
		// The header's text lines (addText): what is enclosed, then Sent and From for a
		// received item or To for an outgoing one; addedHeight for the address lines
		BuildText: func() begin
			if target.Remote then begin
					return self:addText("Remote Message")
				end;
			if (l1 := (if target.package then ParamStr("Enclosed: ^0 (^1 bytes)", [Array: target.filename, Length(target.package)]) else (if (if (if StrFilled(target.filename) then HasSlot(target, 'package)) then (target.state = 'InLog)) then ParamStr("Was Enclosed: ^0", [Array: target.filename]) else (if (not HasSlot(target, 'body)) then "Text only message")))) then begin
					self:addText(l1)
				end;
			(if transport:IsInItem(target) then begin
					self:addText(Stringer([Array: "Sent: ", (if StrFilled(target.dateStr) then target.dateStr else "--")]));
					self:addText((text := ParamStr("From: ^0", [Array: target.fromRef.email])));
					// addedHeight: the height the address lines take (93), or 18 when there are none
					(if (((Length(target.toRef) > 0) or (Length(target.cc) > 0)) or (Length(target.bcc) > 0)) then (addedHeight := 93) else (addedHeight := 18))
				end else (if target.toRef then begin
						routingInfo := GetDataDefs('|nameRef.email|):GetRoutingInfo(target.toRef);
						text2 := "";
						local l1;
						local text;
						local routingInfo;
						local text2;
						(foreach item in routingInfo do begin
								if (if HasSlot(item, 'email) then StrFilled(item.email)) then begin
										text2 := (if StrFilled(text2) then ParamStr("^0, ^1", [Array: text2, item.email]) else item.email)
									end
							end);
						(if StrFilled(text2) then self:addText(ParamStr("To: ^0", [Array: text2])))
					end))
		end,
