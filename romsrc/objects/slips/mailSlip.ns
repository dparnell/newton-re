// The access number picker: the numbers the worksite's Names card lists for the networks
// above, then Other Number (validated in ValidateConfigGuts).
mailPhonePicker := {
	text: "At",
	viewBounds: {left: 55, top: 14, right: -10, bottom: 30},
	viewJustify: vjParentFullH + vjSiblingBottomV + oneLineOnly,
	mailAccess: nil,
	staticLabelCommands: [|Array|: "Other Number"],
	// the numbers: the worksite's (or location's) Names card's numbers on the known networks
	viewSetupFormScript: func() begin
		l1 := GetRoot().mailcategory.mailNetworks;
		labelCommands := Clone(staticLabelCommands);
		if ((not (l4 := GetUserConfig('currentEmporium))) or (not (l4 := ResolveEntryAlias(l4)))) then begin
				l4 := GetUserConfig('location)
			end;
		local l1;
		local l2;
		local l3;
		local l4;
		local l5;
		l2 := (foreach l6 in l1 collect l6.id);
		if (l3 := GetRoot().cardfile:bcEmailNetwork(l4, l2)) then begin
				l5 := (foreach l6 in l3 collect begin
					local l10, l11, l12;
					l10 := FindMailNetwork(l1, l6.mailNetwork).title;
					l11 := (if (if l6.baud then l10) then Stringer([Array: l6.baud, " ", l10]) else (if l6.baud then l6.baud else l10));
					{item: ParamStr("^0^?1 (^1)||", [Array: ConvertIntToPhone(l6.mailPhone), l11]), number: ConvertIntToPhone(l6.mailPhone), network: l6.mailNetwork}
				end);
				AddArraySlot(l5, 'pickseparator);
				ArrayMunger(labelCommands, 0, 0, l5, 0, nil)
			end;
		if (if (Length(labelCommands) > 1) then (not StrFilled(GetUserConfig('mailPhone)))) then begin
				mailAccess := [Array: {mailPhone: (l12 := labelCommands[0]).number, mailNetwork: l12.network}];
				self:JamIt(true)
			end else begin
				mailAccess := [Array: {mailPhone: GetUserConfig('mailPhone), mailNetwork: GetUserConfig('mailNetwork)}]
			end;
		inherited:?viewSetupFormScript()
	end,
	// a number picked; Other Number asks for one
	pickActionScript: func(index) begin
		local labelCommand;
		if IsFrame((labelCommand := labelCommands[index])) then begin
				mailAccess := [Array: {mailPhone: labelCommand.number, mailNetwork: labelCommand.network}];
				self:JamIt(true)
			end else begin
				mailAccess := nil;
				ValidateConfigGuts(self, 'location, '[Array: mailPhone], {userText: "Enter other E-Mail access number:", titleText: "E-Mail", context: self, receiver: self, message: 'JamIt})
			end;
		base:hilite(nil)
	end,
	// the number shown: the chosen one, or the first listed without its network
	TextSetup: func() begin
		local item, pos;
		(if StrFilled(GetUserConfig('mailPhone)) then GetUserConfig('mailPhone) else (if IsFrame(labelCommands[0]) then (if (pos := StrPos((item := labelCommands[0].item), "(", 0)) then Substr(item, 0, (pos - 1)) else item) else "(no number)"))
	end,
	// the access number picked: stored in the user configuration, and the number to dial shown
	JamIt: func(a1) begin
		local mailPhone, mailNetwork;
		(if a1 then begin
				mailPhone := mailAccess[0].mailPhone;
				mailNetwork := mailAccess[0].mailNetwork;
				if (not StrEqual(mailPhone, GetUserConfig('mailPhone))) then begin
						SetUserConfig('mailPhone, mailPhone)
					end;
				if (mailNetwork <> GetUserConfig('mailNetwork)) then begin
						SetUserConfig('mailNetwork, mailNetwork)
					end;
				willDialNum := self:MungePhone(mailPhone, GetUserConfig('currentCountry));
				SetValue(willDial, 'text, willDialNum);
				(if StrFilled(mailPhone) then self:UpdateText(mailPhone))
			end)
	end,
	preallocatedContext: 'mailPhonePicker,
	_proto: @protoLabelPicker
};

