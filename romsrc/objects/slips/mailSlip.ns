	// The item conversion (ConvertFrame) for mail: returns a 'mailText copy of body whose
	// from and to address strings are made |nameRef.email| name references; nothing when
	// a3 is 'oneO. An item without string addresses goes to the root's MotoConvertEmail
	// when there is one (presumably the Motorola Marco's mail).
	Convert: func(body, a2, a3) begin
		if (if HasPath(GetRoot(), 'MotoConvertEmail) then ((not IsString(body.toEmailAddress)) or (not IsString(body.fromName)))) then begin
				return GetRoot():MotoConvertEmail(body, a2, a3)
			end;
		if (a3 = 'oneO) then begin
				return nil
			end;
		(copy := Clone(body)).class := 'mailText;
		part := nil;
		text := nil;
		if IsArray(body.fromName) then begin
				body.fromName := body.fromName[0]
			end;
		if (if body.fromName then (not IsString(body.fromName))) then begin
				cls := ClassOf(body.fromName);
				SetClass(body.fromName, Intern(Stringer([Array: "string.email.", cls])))
			end;
		if (if body.fromName then StrFilled(body.fromName)) then begin
				if (if (pos := StrPos((text := TrimString(body.fromName)), " ", 0)) then (pos > 0)) then begin
						part := Substr(text, (pos + 1), StrLen(text));
						text := Substr(text, 0, pos)
					end
			end;
		dataDefs := GetDataDefs('|nameRef.email|);
		copy.fromRef := dataDefs:MakeNameRef({name: {first: text, last: part}, email: SetClass(body.fromEmailAddress, '|string.email.aol|)}, '|nameRef.email|);
		copy.toRef := [Array: ];
		if body.toEmailAddress then begin
				if IsArray(body.toEmailAddress) then begin
						body.toEmailAddress := body.toEmailAddress[0]
					end;
				if (not IsString(body.toEmailAddress)) then begin
						cls := ClassOf(body.toEmailAddress);
						SetClass(body.toEmailAddress, Intern(Stringer([Array: "string.email.", cls])));
						if body.ccEmailAddress then begin
								body.ccEmailAddress := nil
							end;
						if body.bccEmailAddress then begin
								body.bccEmailAddress := nil
							end
					end;
				local copy;
				local part;
				local text;
				local cls;
				local pos;
				local dataDefs;
				local strParseTrimmed2;
				(foreach item in (strParseTrimmed2 := StrParseTrimmed(body.toEmailAddress, ",")) do begin
						AddArraySlot(copy.toRef, dataDefs:MakeNameRef({name: item, email: SetClass(item, '|string.email|)}, '|nameRef.email|))
					end)
			end;
		if (Length(copy.toRef) = 0) then begin
				item := Clone("unknown");
				AddArraySlot(copy.toRef, dataDefs:MakeNameRef({name: item, email: SetClass(item, '|string.email|)}, '|nameRef.email|))
			end;
		copy.currentFormat := 'targetFrameFormat;
		copy.cc := [Array: ];
		copy.bcc := [Array: ];
		RemoveSlot(copy, 'fromEmailAddress);
		RemoveSlot(copy, 'toEmailAddress);
		copy
	end,
