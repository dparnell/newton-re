	PeriodicAlarm: func(a1) begin
		if (if GetUserConfig('mailautodisconnect) then (GetRoot().iobox:NumItemsToSend(GetRoot().mailSlip, nil) = 0)) then begin
				return nil
			end;
		GetRoot():SysBeep();
		GetRoot():SysBeep();
		GetRoot():SysBeep();
		GetRoot():SysBeep();
		GetRoot().iobox:StartSend(self, 'periodic, nil, nil)
	end,
	// Put Away to Extras: installs the package a1 holds and says so.
