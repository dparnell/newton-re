// passwordSlip (magic pointer 10), and what only it reaches: a generic slip
// for setting or checking a password, meant to be used as a proto - the
// user of it supplies CurrentPassword (the password now, nil for none),
// SetPassword (store a new one) and, if it wants, MatchedPassword.  Its lines
// are blind entry lines (the typed text hidden, kept in realText).  With
// verifyPassword 'verifyOnly it only asks for the password (Old password and
// a close box that checks it); otherwise it asks for a new password twice,
// and for the old one first when there is one.  With no keyboard attached it
// carries its own on-screen keyboard (alphaKeys).

passwordSlip := {
	oldPass: nil,
	// the caret into the first entry line
	viewSetupDoneScript: func() begin
		local nextKeyView2;
		(if (nextKeyView2 := NextKeyView(self:ChildViewFrames()[0], 0, 0)) then SetKeyView(nextKeyView2, 0))
	end,
	// whether what was typed is the password (compared byte for byte)
	MatchPassword: func(realText, currentPassword) begin
		BinEqual(realText, currentPassword)
	end,
	closeBox: nil,
	confirmPass: nil,
	width: 225,
	ReOrientToScreen: @defRotateFunc,
	viewBounds: nil,
	// to override: keeps the new password (an empty string: none)
	SetPassword: func(realText) begin
		nil
	end,
	// true: the old password asked for when there is one; nil: never;
	// 'verifyOnly: only check the password, set nothing
	verifyPassword: true,
	allocateContext: [|Array|:
		'oldPass,
		oldPass,
		'newPass,
		newPass,
		'confirmPass,
		confirmPass,
		'closeBox,
		closeBox_2,
		'_defaultButton,
		_defaultButton
	],
	_proto: @protoFloater,
	_defaultButton: nil,
	viewJustify: vjParentCenterH + vjParentCenterV,
	height: 78,
	// to override: the password now, nil when there is none
	CurrentPassword: func() begin
		nil
	end,
	verifyOnlyKids: [|Array|: closeBox_2],
	declareSelf: 'base,
	// the children and the slip's size for the case: verifyOnly loses the new
	// password lines (52 pixels, two lines of 26) and its close box is the
	// default button; the old password line (26 more) goes first when one is
	// to be checked; without a keyboard, alphaKeys goes at the bottom (moved
	// up 23 pixels) and the slip takes its width
	viewSetupFormScript: func() begin
		local l1, l2, l3, addArraySlot2;
		if (l1 := (verifyPassword = 'verifyOnly)) then begin
				self.viewChildren := Clone(verifyOnlyKids);
				height := (height - 52);
				_defaultButton := closeBox
			end else begin
				self.viewChildren := Clone(kids)
			end;
		if (if verifyPassword then (l1 or self:CurrentPassword())) then begin
				ArrayMunger(viewChildren, 0, 0, oldPassKids, 0, nil);
				height := (height + 26)
			end;
		if (not KeyboardConnected()) then begin
				addArraySlot2 := AddArraySlot(viewChildren, {_proto: @alphaKeys});
				height := ((height - addArraySlot2.viewBounds.top) + 5);
				width := (addArraySlot2.viewBounds.right - addArraySlot2.viewBounds.left);
				addArraySlot2.viewBounds := Clone(addArraySlot2.viewBounds);
				addArraySlot2.viewBounds.top := (addArraySlot2.viewBounds.top - 23);
				addArraySlot2.viewBounds.bottom := (addArraySlot2.viewBounds.bottom - 23)
			end;
		(self.viewBounds := RelBounds(0, 0, width, height))
	end,
	// sent when the password was right (or a new one set): closes the slip;
	// a user of the proto overrides it to go on
	MatchedPassword: func() begin
		base:Close()
	end,
	kids: [|Array|: newPass, confirmPass, {_proto: @protoCancelButton}, _defaultButton],
	oldPassKids: [|Array|: oldPass],
	newPass: nil,
	// true: an empty new password is refused rather than taken as "none"
	requirePassword: nil
};

// the entry lines: old, new and confirmed password
oldPass :={label: password, preallocatedContext: 'oldPass, _proto: @blindEntryLine};

newPass := {label: "New password", preallocatedContext: 'newPass, _proto: @blindEntryLine};

confirmPass := {label: "Confirm new pswd", preallocatedContext: 'confirmPass, _proto: @blindEntryLine};

// verifyOnly's close box: checks the password typed - MatchedPassword when it
// is right, else the slip closed and an alert
closeBox_2 := {
	// (see above)
	buttonClickScript: func() begin
		(if self:MatchPassword(oldPass.realText, self:CurrentPassword()) then self:MatchedPassword() else begin
				base:Close();
				self:Notify(kNotifyAlert,"Password", "Sorry, the password you entered is incorrect.")
			end)
	end,
	preallocatedContext: 'closeBox,
	_proto: @protoCancelButton
};

// "Set", the default button: the old password checked when there is one;
// then an empty new password means none (confirmed with the user, or
// refused when requirePassword), else the two new ones must agree; on any
// error the caret goes back to the line at fault (99999: past its end)
_defaultButton := {
	viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingLeftH + vjOneLineOnly,
	viewBounds: {left: -29, top: -18, right: -7, bottom: -5},
	text: set,
	// (see above)
	buttonClickScript: compile(
		constants: {
			kLiteral_45c7f1: "Password"
		},
		func() begin
			local l1, currentPassword;
			if (if verifyPassword then (currentPassword := self:CurrentPassword())) then begin
					if (not self:MatchPassword(oldPass.realText, currentPassword)) then begin
							self:Notify(kNotifyAlert, "Incorrect password", "Sorry, the old password you entered is incorrect.");
							SetKeyView(oldPass.entryLine, 99999);
							return nil
						end
				end;
			(if (StrLen(newPass.realText) = 0) then (if requirePassword then begin
						self:Notify(kNotifyAlert, kLiteral_45c7f1, "Sorry, a password is required.");
						SetKeyView(newPass.entryLine, 99999)
					end else self:Confirm(kLiteral_45c7f1, "Don't require password?", self, 'ConfirmCallback)) else (if BinEqual(newPass.realText, confirmPass.realText) then begin
						self:SetPassword(newPass.realText);
						self:MatchedPassword()
					end else (if (not StrFilled(confirmPass.realText)) then begin
							self:Notify(kNotifyAlert, kLiteral_45c7f1, "Confirm the new password by entering it on the confirmation line.");
							SetKeyView(confirmPass.entryLine, 99999)
						end else begin
							self:Notify(kNotifyAlert, kLiteral_45c7f1, "The confirmed password does not match the new password.");
							SetKeyView(confirmPass.entryLine, 99999)
						end)))
		end),
	// the answer to "Don't require password?": yes sets the empty password
	ConfirmCallback: func(a1) begin
		(if a1 then begin
				self:SetPassword(newPass.realText);
				self:MatchedPassword()
			end)
	end,
	preallocatedContext: '_defaultButton,
	_proto: @protoTextButton
};

// the default button's text
set := "Set";
