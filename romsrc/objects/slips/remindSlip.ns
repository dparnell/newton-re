// remindSlip, and what only it reaches: the Assistant's "remind" slip (the
// root's remindSlip; the remembering task, assistFrames.ns, sets its totMin
// and title from what the user wrote and opens it).  It shows a To Do task -
// its text, date and priority - for the user to check, and its Do button
// adds it to the Calendar's To Do List and shows the list.

remindSlip := {
	viewBounds: {left: 0, top: 0, right: 218, bottom: 184},
	viewJustify: vjParentCenterH + vjParentCenterV,
	// the task's date and time, in minutes since 1904 (a day picked in the
	// slip makes it that day's midnight)
	totMin: nil,
	// the task's text (a rich string)
	title: nil,
	declareSelf: 'base,
	// the priority: 0 High, 1 Medium, 2 Low, 3 None (the default, put back at
	// close by removing the slot)
	priority: 3,
	rotationInProgress: nil,
	// on rotation the slip is closed and opened again; rotationInProgress
	// keeps viewQuitScript from forgetting the task meanwhile
	ReOrientToScreen: func() begin
		rotationInProgress := true;
		self:Close();
		self:Open()
	end,
	// a rotation, if any, is over
	viewSetupFormScript: func() begin
		rotationInProgress := nil;
		inherited:?viewSetupFormScript()
	end,
	// the caret at the end of the task's text
	viewSetupDoneScript: func() begin
		local entryLine;
		SetKeyView((entryLine := meetingTitle.entryLine), 9999)
	end,
	// the task forgotten, unless the slip is only being reopened for a rotation
	viewQuitScript: func() begin
		(if (not rotationInProgress) then begin
				totMin := nil;
				title := nil;
				RemoveSlot(self, 'priority)
			end)
	end,
	debug: 42186,
	preallocatedContext: 'remindSlip,
	viewChildren: [viewChildren:
		{
			// the slip closed
			buttonClickScript: func() begin
				remindSlip:Close()
			end,
			debug: -382561072,
			_proto: @protoCancelButton
		},
		_defaultButton_15,
		{titleicon: smallIcon_3, title: toDoTask, _proto: @protoTitle},
		meetingTitle,
		// "Date": the task's day
		{
			viewBounds: {left: 0, top: 3, right: 198, bottom: 21},
			label: date,
			labelFont: tsSystem + tsSize(9) + tsBold,
			viewJustify: vjCenterV + vjSiblingBottomV,
			longFormat: 'abbrDateStrSpec,
			entryFont: tsHWFont + tsSize(10),
			// the picker's date from totMin
			viewSetupFormScript: func() begin
				(Date := totMin)
			end,
			// a day picked: totMin made its midnight (1440: minutes in a day)
			pickActionScript: func(index) begin
				local indexItem;
				indexItem := index[0];
				dirtyFlag := true;
				totMin := (indexItem - (indexItem mod 1440));
				inherited:pickActionScript(index)
			end,
			_proto: @protoDateTextPicker
		},
		// "Priority": a picker of High, Medium, Low and None, each with its icon
		{
			viewFont: tsSystem + tsSize(9) + tsBold,
			viewBounds: {left: 0, top: 3, right: 2, bottom: 20},
			viewJustify: vjParentFullH + vjSiblingBottomV + oneLineOnly,
			text: "Priority",
			iconBounds: {left: 0, top: 0, right: 16, bottom: 16},
			labelCommands: nil,
			priorityItems: @priorityItems,
			viewLineSpacing: 12,
			// the four items, High to None, with their icons
			viewSetupFormScript: func() begin
				labelCommands := [Array: {item: "High", icon: priorityItems[0], indent: 18}, {item: "Medium", icon: priorityItems[1]}, {item: "Low", icon: priorityItems[2]}, {item: "None", icon: priorityItems[3]}];
				inherited:?viewSetupFormScript()
			end,
			// the label starts at None, as priority always does when the slip opens
			iconSetup: func() begin
				labelCommands[3].icon
			end,
			// the item's index is the priority
			LabelActionScript: func(index) begin
				(priority := index)
			end,
			// the label's text at the start: None
			TextSetup: func() begin
				return labelCommands[3].item
			end,
			_proto: @protoLabelPicker
		}
	],
	_defaultButton: nil,
	allocateContext: [|Array|: '_defaultButton, _defaultButton_15, 'meetingTitle, meetingTitle],
	meetingTitle: nil,
	_proto: @protoFloater,
	// the slots the slip's context is built with (the view system's context cache)
	_cacheContext: {
		_parent: nil,
		_proto: nil,
		viewCObject: nil,
		totMin: nil,
		title: nil,
		rotationInProgress: nil,
		viewclipper: nil,
		base: nil,
		viewFlags: vFloating + vClickable,
		_defaultButton: nil,
		meetingTitle: nil
	}
};

// "Do", the default button: the Calendar opened if it is not up, the task
// added to its To Do List (CreateToDoItemAll) for the day, the list shown
// at that day, and the slip closed
_defaultButton_15 := {
	viewBounds: {left: -27, top: 0, right: -7, bottom: 13},
	viewJustify: vjCenterH + vjCenterV + vjSiblingLeftH + vjSiblingCenterV,
	text: do_2,
	// (see above)
	buttonClickScript: func() begin
		local calendar, toDo;
		calendar := GetRoot().calendar;
		ClearUndoStacks();
		if (not whoIsUp('calendar)) then begin
				calendar:Open()
			end;
		toDo := calendar:GetToDo();
		toDo:CreateToDoItemAll(totMin, title, nil, nil, priority, nil);
		calendar:ShowToDoList(totMin);
		remindSlip:Close()
	end,
	preallocatedContext: '_defaultButton,
	_proto: @protoTextButton
};

// "Title": the task's text, rich (ink words kept), several lines; the
// entry line's styles fixed (vFixedTextStyle, vFixedInkTextStyle)
meetingTitle := {
	debug: 156805,
	viewFont: tsHWFont + tsSize(12),
	viewBounds: {left: 0, top: 16, right: -12, bottom: 112},
	// (the entry line's view flags, 0x4fa01: visible, clickable, and what
	// input it takes)
	entryFlags: 326145,
	viewJustify: vjParentFullH + oneLineOnly,
	label: title_2,
	memory: 'todoTitle,
	textFlags: vFixedTextStyle + vFixedInkTextStyle,
	viewLineSpacing: 30,
	text: nil,
	// the entry line's text: the task's title, "" for none
	TextSetup: func() begin
		(if (title <> nil) then title else "")
	end,
	// the text as edited kept as the title (a rich string)
	textChanged: func() begin
		(title := MakeRichString(text, styles))
	end,
	preallocatedContext: 'meetingTitle,
	_proto: @protoRichLabelInputLine
};

