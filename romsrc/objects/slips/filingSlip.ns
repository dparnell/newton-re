};

// the close box
filingSlipItem := {_proto: @protoCancelButton};

// "File", the default button (or the application's appObjectFileAction text,
// the button widened to fit it): files the target and closes the slip
_defaultButton_5 := {
	viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingLeftH + vjOneLineOnly,
	viewBounds: {left: -30, top: -18, right: -7, bottom: -5},
	text: file,
	viewSetupFormScript: func() begin
		(if (targetView:appObjectFileAction exists) then begin
				self.text := GetVariable(targetView, 'appObjectFileAction);
				self.viewBounds := Clone(viewBounds);
				(self.viewBounds.left := (-(StrWidth(self.text) + 12)))
			end)
	end,
	// l2: the target moves to another store; l3: its folder changes (a new
	// folder chosen, or a cursor - always refiled - and not just card routing,
	// and a folder chosen at all: not 42).  The application's FileThis(target,
	// labelsChanged, newLabels, storesChanged, newStore) does both when it has
	// one (on otherOtherTargetView first); else target.labels is set and the
	// view told (filingChanged), then the target moved (UpdateTargetStore)
	buttonClickScript: func() begin
		local selectedStore, l2, l3, l4;
		if (not (fileArea.folderCluster.clusterValue or storeSelector.storeCluster.clusterValue)) then begin
				self:Notify(kNotifyAlert, "Filing", "A folder or store must be chosen to continue.");
				return nil
			end;
		l2 :=(if (if (selectedStore := storeSelector:GetSelectedStore()) then doCardRouting) then (targetStore <> selectedStore));
		l3 := (if (if (doCardRouting <> 'onlyCardRouting) then ((target.labels <> newLabels) or TargetIsCursor(target))) then (newLabels <> 42));
		if ((if otherOtherTargetView then (otherOtherTargetView:FileThis exists)) or (targetView:FileThis exists)) then begin
				l4 := (if otherOtherTargetView then otherOtherTargetView else targetView);
				try begin
						l4:FileThis(target, l3, newLabels, l2, selectedStore)
					end onexception |evt.ex| do begin
						self:hilite(nil);
						Rethrow()
					end;
				if l2 then begin
						filingButton:?Update()
					end
			end else begin
				if l3 then begin
						target.labels := newLabels;
						// looks like a ROM bug: filingChanged is sent twice - l3 already
						// implies doCardRouting is not 'onlyCardRouting, so this test
						// always holds and the send after it repeats it
						if ((not doCardRouting) or (doCardRouting <> 'onlyCardRouting)) then begin
								targetView:?filingChanged()
