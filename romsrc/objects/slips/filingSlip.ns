		_defaultButton_5
	],
	_proto: @protoFloater,
	folderClusterHeight: nil,
	_defaultButton: nil,
	// the folder chosen: a folder symbol, nil for Unfiled, or 42 for none
	// chosen yet (the slip opened without starting at a folder)
	newLabels: nil,
	// the children for each case: folders only, folders and stores, stores only
	kidsWithoutRouting:[viewChildren: fileArea_2, newFolderButton, editFoldersButton, filingSlipItem, _defaultButton_5],
	kidsWithCardRouting: [viewChildren:
		storeSelector,
		fileArea_2,
		newFolderButton,
		editFoldersButton,
		filingSlipItem,
		_defaultButton_5
	],
	viewJustify: vjParentCenterH + vjParentCenterV,
	_nextKeyView: nil,
	targetStore: nil,
	editFoldersButton: nil,
	dontStartWithFolder: nil,
	fileArea: nil,
	folderList: nil,
	kidsJustCardRouting: [viewChildren: storeSelector, filingSlipItem, _defaultButton_5],
	declareSelf: 'base,
	// the application's folders (local only / with the system's, as its view
	// says), the folder to start at (42: none - see newLabels; also when the
	// target's folder no longer exists), the two clusters' heights (two
	// buttons, 14 pixels, a row), which children to show and the slip's size;
	// and a handler that closes the slip when a store it could file to goes
	viewSetupFormScript: func() begin
		local value, value2;
		value := GetVariable(targetView, 'localFoldersOnly);
		value2 := GetVariable(targetView, 'systemFoldersToo);
		folderList := GetAppFolderSyms(GetVariable(targetView, 'appSymbol), value, value2);
		if (dontStartWithFolder or target.dontStartWithFolder) then begin
				newLabels := 42
			end else begin
				newLabels := target.labels
			end;
		if (if (newLabels <> 42) then (not GetFolderStr(newLabels))) then begin
				newLabels := 42
			end;
		folderClusterHeight := (ceiling(((Length(folderList) + 1) / 2)) * 14);
		storeClusterHeight := (ceiling((Length(GetStores()) / 2)) * 14);
		if (doCardRouting = 'onlyCardRouting) then begin
				viewChildren := kidsJustCardRouting;
				self.viewBounds := RelBounds(0, -20, 220, (storeClusterHeight + 49))
			end else begin
				if (if doCardRouting then (Length(GetStores()) > 1)) then begin
						viewChildren := kidsWithCardRouting;
						self.viewBounds := RelBounds(0, 0, 220, ((folderClusterHeight + storeClusterHeight) + 74))
					end else begin
						viewChildren := kidsWithoutRouting;
						self.viewBounds := RelBounds(0, 0, 220, (folderClusterHeight + 49))
					end
			end;
		// (store, what, ...): with card routing any store leaving closes the
		// slip, as the store list changes; else only the target's own store
		RegStoreChange('_filing, func(a1, a2, a3) begin
			(if (if (a2 = 'storeLeaves) then (doCardRouting or (a1 = targetStore))) then AddDeferredSend(self, 'Close, nil))
		end);
		SetKeyView(self, 0)
	end,
	filingButton: nil,
	storeSelector: nil,
	_keyCommands: [|Array|:
		{char: $e, modifiers: kCommandModifier, keyMessage: '_editKeyScript, name: editFolder, category: editing},
		{char: $n, modifiers: kCommandModifier, keyMessage: '_newKeyScript, name: new_2, category: creating}
	],
	debug: 32890,
	// sent after a folder is made or renamed (folderEdit): the slip rebuilt
	// with the new folder list and newSymbol chosen in it
	UpdateToFolder: func(newSymbol) begin
		(if Visible(self) then begin
				filingSlip:SyncView();
				filingSlip:RedoChildren();
				(if (doCardRouting <> 'onlyCardRouting) then fileArea.folderCluster:SetToFolder(newSymbol))
			end)
	end,
	targetView: nil
};

editFolder := "Edit Folder";

// the store section's heading: the application's own text (AppObjectFileThisOn),
// else "File this <thing> on" / "File the selected <things> on" from its
// appObject (singular, plural), else "File on"
fileInText := {
	viewBounds: {left: 9, top: 0, right: -5, bottom: 12},
	viewJustify: vjParentFullH,
	text: nil,
	viewSetupFormScript: func() begin
		(text := (if doCardRouting then (if (targetView:AppObjectFileThisOn exists) then GetVariable(targetView, 'AppObjectFileThisOn) else (if (targetView:appObject exists) then (if ((not target._cursor) or (Length(target._cursor) = 1)) then ParamStr("File this ^0 on", [Array: GetVariable(targetView, 'appObject)[0]]) else ParamStr("File the selected ^0 on", [Array: GetVariable(targetView, 'appObject)[1]])) else "File on"))))
	end,
	preallocatedContext: 'fileInText,
	_proto: @protoStaticText
};

// a radio button for each store (its name, or "Unnamed Card"), the target's
// store chosen; the value is the store's index in GetStores()
storeCluster := {
	viewBounds: nil,
	viewJustify: vjParentFullH + vjSiblingBottomV,
	itemTitles: nil,
	childViewBounds: {left: 3, right: 100, top: 2, bottom: 12},
	viewSetupFormScript: func() begin
		self.viewBounds := SetBounds(5, 4, -5, (storeClusterHeight + 4));
		itemTitles := Array(Length((stores := GetStores())), nil);
		local stores;
		(foreach key, value in stores do begin
				local name;
				if StrFilled((name := value:GetName())) then begin
						itemTitles[key] := name
					end else begin
						itemTitles[key] := "Unnamed Card"
					end;
				if (value = targetStore) then begin
						clusterValue := key
					end
			end)
	end,
	preallocatedContext: 'storeCluster,
	_proto: @protoSmartCluster
};

// the store section: a white box holding fileInText and storeCluster
storeSelector := {
	viewClass: clView,
	viewBounds: nil,
	viewJustify: vjParentFullH + vjSiblingBottomV,
	viewFlags: vVisible + vClickable,
	viewFormat: vfFillWhite,
	viewSetupFormScript: func() begin
		(self.viewBounds := SetBounds(5, 5, -5, (storeClusterHeight + 23)))
	end,
	// the store chosen: the internal store when the section is not shown,
	// else the one picked (nil for none)
	GetSelectedStore: func() begin
		(if (not storeCluster) then GetStores()[0] else (if storeCluster.clusterValue then GetStores()[storeCluster.clusterValue]))
	end,
	preallocatedContext: 'storeSelector,
	viewChildren: [viewChildren: fileInText, storeCluster],
	fileInText: nil,
	allocateContext: [|Array|: 'fileInText, fileInText, 'storeCluster, storeCluster],
	storeCluster: nil
};

// the folder section's heading: "File this <thing> in" and so on as
// fileInText, or "And file in" below the store section
fileArea := {
	viewBounds: {left: 9, top: 0, right: 219, bottom: 12},
	viewJustify: 0,
	text: nil,
	viewSetupFormScript: func() begin
		local text2;
		(text := (if ((not doCardRouting) or (Length(GetStores()) <= 1)) then (if (targetView:appObjectFileThisIn exists) then GetVariable(targetView, 'appObjectFileThisIn) else begin
					if ((not target._cursor) or (Length(target._cursor) = 1)) then begin
							text2 := ParamStr("File this ^0 in", [Array: GetVariable(targetView, 'appObject)[0]])
