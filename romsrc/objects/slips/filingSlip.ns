	UpdateTargetStore: func() begin
		(if (if (selectedStore := storeSelector:GetSelectedStore()) then (targetStore <> selectedStore)) then begin
				if target._cursor then begin
						local resolveEntryAlias2;
						local selectedStore;
						(foreach item in target._cursor do begin
								if (ClassOf(item) = 'alias) then begin
										resolveEntryAlias2 := ResolveEntryAlias(item)
									end else begin
										resolveEntryAlias2 := item
									end;
								if resolveEntryAlias2 then begin
										targetView:MoveTarget(resolveEntryAlias2, selectedStore)
									end
