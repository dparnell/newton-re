// filingSlip, and what only it reaches: the system's Filing slip, opened by
// the filing button (protoFilingButton / newtFilingButton) of an application.
// It files the target - an entry, or a cursor of selected entries - in one of
// the application's folders (labels) and, with card routing, moves it to
// another store; the application's own FileThis does the work when it has
// one, else the slip sets target.labels and sends filingChanged / MoveTarget.
// Its Edit Folder and New buttons open folderEdit.

filingSlip := {
	otherOtherTargetView: nil,
	// filingSlip:OpenForUser(filing button, target info frame {target,
	// targetView, targetStore, otherOtherTargetView}, doCardRouting
	// (nil, true or 'onlyCardRouting), dontStartWithFolder): opens the slip,
	// or closes it when it is already open for the same view; refuses with an
	// alert when there is nothing to file, nowhere to move it, another
	// application's slip is open, or the target's store is locked and the
	// application cannot route to a card
	OpenForUser: compile(
		constants: {
			kLiteral_4836e1: "Filing"
		},
		func(newLabels, a2, value, value2) begin
			(if (not a2.target) then self:Notify(kNotifyAlert, kLiteral_4836e1, "There is nothing to file.") else (if (if (value = 'onlyCardRouting) then (Length(GetStores()) = 1)) then self:Notify(kNotifyAlert, kLiteral_4836e1, "This item is already filed internally.  If you would like to file it on a card, please insert one.") else (if self.viewCObject then (if (a2.targetView = self.targetView) then self:Close() else self:Notify(kNotifyAlert, kLiteral_4836e1, "The filing form is already open.")) else begin
							self.target := a2.target;
							self.targetView := a2.targetView;
							self._nextKeyView := targetView;
							self.targetStore := a2.targetStore;
							self.doCardRouting := value;
							self.filingButton := newLabels;
							self.otherOtherTargetView := a2.otherOtherTargetView;
							self.dontStartWithFolder := value2;
							// a locked store: the target cannot be refiled there, only
							// moved to another card
							if (if targetStore then targetStore:IsReadOnly()) then begin
									if value then begin
											self.doCardRouting := 'onlyCardRouting
										end else begin
											self:Notify(kNotifyAlert, kLiteral_4836e1, "This app does not support card routing and the card is locked");
											return nil
										end
								end;
							self:Open()
						end)))
		end),
	// the slots the slip's context is built with (the view system's context cache)
	_cacheContext: {
		otherOtherTargetView: nil,
		target: nil,
		newFolderButton: nil,
		viewChildren: nil,
		viewFlags: vFloating + vClickable,
		doCardRouting: nil,
		viewBounds: protoDraggerViewBounds,
		storeClusterHeight: nil,
		viewclipper: nil,
		_proto: nil,
		viewCObject: nil,
		folderClusterHeight: nil,
		_defaultButton: nil,
		newLabels: nil,
		targetStore: nil,
		editFoldersButton: nil,
		fileArea: nil,
		folderList: nil,
		filingButton: nil,
		storeSelector: nil,
		_parent: nil,
		targetView: nil,
		base: nil
	},
	// the folder editor closed with the slip, the references to the target
	// let go, and the store-change handler removed
	viewQuitScript: func() begin
		if folderEdit.viewCObject then begin
				folderEdit:Close()
			end;
		target := nil;
		targetView := nil;
		targetStore := nil;
		filingButton := nil;
		folderList := nil;
		otherOtherTargetView := nil;
		_nextKeyView := nil;
		UnRegStoreChange('_filing)
	end,
	preallocatedContext: 'filingSlip,
	// Command-N: New (folder)
	_newKeyScript: func(a1) begin
		PressButton(newFolderButton)
	end,
	target: nil,
	newFolderButton: nil,
	viewChildren: nil,
	viewFlags: vFloating + vClickable,
	// Command-E: Edit Folder
	_editKeyScript: func(a1) begin
		PressButton(editFoldersButton)
	end,
	doCardRouting: nil,
	// a one-off rebuild of the slip (returns nil: no more idling)
	viewIdleScript: func() begin
		if Visible(self) then begin
				filingSlip:SyncView();
				filingSlip:RedoChildren()
			end;
		nil
	end,
	ReOrientToScreen: @defRotateFunc,
	storeClusterHeight: nil,
	allocateContext: [|Array|:
		'storeSelector,
		storeSelector,
