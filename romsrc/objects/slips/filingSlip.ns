// "Edit Folder": the chosen folder renamed or deleted, in folderEdit -
// refused for Unfiled and for a folder that belongs only to the system's
// group ('_System)
editFoldersButton := {
	viewJustify: vjCenterH + vjCenterV + vjParentBottomV + vjSiblingRightH + vjOneLineOnly,
	viewBounds: {left: 7, top: -18, right: 67, bottom: -5},
	text: editFolder,
	buttonClickScript: func() begin
		if ((fileArea.folderCluster.clusterValue = 0) or (Length(SetDifference(GetFolderGroups(newLabels), '[Array: _System])) = 0)) then begin
				self:Notify(kNotifyAlert, "Filing", "This folder name cannot be edited.");
				return nil
			end;
		folderEdit:OpenForUser(newLabels, GetVariable(targetView, 'appSymbol), GetVariable(targetView, 'localFoldersOnly), GetVariable(targetView, 'globalFoldersOnly))
	end,
	preallocatedContext: 'editFoldersButton,
