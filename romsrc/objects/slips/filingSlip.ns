// a radio button for "None (Unfiled)" (value 0) and for each folder (value
// its index in folderList + 1, the name cut to 76 pixels); the target's
// folder chosen, else Unfiled unless the slip starts with no folder
folderCluster := {
	viewBounds: nil,
	viewJustify: vjParentFullH + vjSiblingBottomV,
	itemTitles: nil,
	childViewBounds: {left: 3, right: 100, top: 2, bottom: 12},
	viewSetupFormScript: func() begin
		itemTitles := [Array: "None (Unfiled)"];
		clusterValue := nil;
		(foreach key, value in folderList do begin
				AddArraySlot(itemTitles, StyledStrTruncate(Clone(GetFolderStr(value)), 76, viewFont));
				if (if (if newLabels then (newLabels <> 42)) then (target.labels = value)) then begin
						clusterValue := (key + 1)
					end
			end);
		if (not (dontStartWithFolder or clusterValue)) then begin
				clusterValue := 0
			end;
		(self.viewBounds := SetBounds(5, 4, -5, (folderClusterHeight + 4)))
	end,
	// newLabels follows the choice (nil: Unfiled)
	ClusterChanged: func() begin
		(if (clusterValue = 0) then (newLabels := nil) else (newLabels := folderList[(clusterValue - 1)]))
	end,
	// newSymbol's button chosen, Unfiled when it is not one of the folders
	SetToFolder: func(newSymbol) begin
		local setContains2;
		(if (setContains2 := SetContains(folderList, newSymbol)) then self:SetClusterValue((setContains2 + 1)) else self:SetClusterValue(0))
	end,
	preallocatedContext: 'folderCluster,
	_proto: @protoSmartCluster
};

