// toSubjectSlip (magic pointer 45), and what only it reaches: the auxiliary
// slip of the memo print format (prMemoFormat's auxForm), opened beside the
// print or fax routing slip when that format is chosen.  It edits the memo's
// header: the addressee's name (toName) and the subject (title) in the routing
// slip's fields frame.

toSubjectSlip := {
	viewJustify: vjParentCenterH + vjParentBottomV,
	viewBounds: {left: 0, top: -156, right: 220, bottom: -26},
	viewEffect: 0,
	// (does nothing: the proto's setup is not run)
	viewSetupFormScript: func() begin
		nil
	end,
	debug: 350698,
	ReOrientToScreen: @defRotateFunc,
	stepChildren: [stepChildren:
		// the editing area: a newtFalseEntryView over the routing slip's fields
		{
			_proto: addresseeSlipProto,
			viewJustify: vjParentFullH + vjParentFullV,
			viewBounds: {left: 0, top: 0, right: 0, bottom: -16},
			targetSlot: 'fields,
			viewChildren: [viewChildren:
				explanation,
				toSubject,
				// "Subject": the memo's title (fields.title)
				{
					viewBounds: {left: 0, top: 50, right: -5, bottom: 115},
					viewJustify: vjParentFullH,
					viewLineSpacing: 30,
					newRecFlags: 1636865,
					label: "Subject",
					indent: 55,
					// nothing taken from an entry
					jamFromEntry: func(resolveEntryAlias) begin
						nil
					end,
					path: 'title,
					memory: 'memoSubject,
					_proto: @newtLabelCustomInputLine
				}
			],
			explanation: nil,
			allocateContext: [|Array|: 'explanation, explanation, 'toSubject, toSubject],
			toSubject: nil
		}
	],
	_proto: @protoFloatNGo
};

// the slip's heading, "Memo Header"
explanation := {
	viewJustify: vjCenterH + vjParentFullH + vjOneLineOnly,
	viewBounds: {left: 0, top: 1, right: 0, bottom: 14},
	text: "Memo Header",
	preallocatedContext: 'explanation,
	_proto: @protoStaticText
};

// "Name": the addressee (fields.toName), a smart name line whose picker is
// the People popup
toSubject := {
	flavor: {
		_proto: @newtSmartNameFilter,
		// the People popup, one name to pick
		picker: func() begin
			@protoPeoplePopup:New({_proto: GetDataDefs('|nameRef.people|), singleSelect: true}, nil, self, nil)
		end
	},
	viewBounds: {left: 0, top: 13, right: -5, bottom: 47},
	viewJustify: vjParentFullH,
	label: name,
	indent: 55,
	viewLineSpacing: 30,
	path: 'toName,
	memory: 'memoAddresee,
	// the caret into the name line, at its end
	viewSetupDoneScript: func() begin
		SetKeyView(self.entryLine, 9999)
	end,
	preallocatedContext: 'toSubject,
	_proto: @newtSmartNameView
};

// what the functions above hold and share with other objects (same(): romsrc/README.md)

picker_literal2 := same("toSubject.flavor.picker.literals[2]");

viewSetupDoneScript_code_17 := same("toSubject.viewSetupDoneScript.instructions");

