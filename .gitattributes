# Line endings: normalise text to LF in the repository; shell scripts must be LF
# in the working copy too (Linux), Windows batch files CRLF.
* text=auto
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# The DDK originals keep their classic Mac CR line endings untouched.
headers/** -text

# Binary payloads
DebugRom/** binary
# Third-party packages and their documents, kept byte for byte as they came
fixtures/** binary
*.pdf binary
*.exe binary
*.dll binary

# The ROM source tree (romsrc/, docs/rom-free/README.md): its resources byte
# for byte, its source and manifests LF on every system (the builder reads
# them, and the byte-identical build must not depend on the checkout)
romsrc/**/*.bin binary
romsrc/**/*.png binary
romsrc/**/*.wav binary
romsrc/**/*.pict binary
romsrc/**/*.ttf binary
romsrc/**/*.pkg binary
romsrc/**/*.ns text eol=lf
romsrc/**/*.tsv text eol=lf
romsrc/**/*.md text eol=lf
