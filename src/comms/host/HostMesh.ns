// Mesh: text over a LoRa mesh (MeshCore) as conversations, for a host with
// a mesh node (hal/host/HostMesh.h: the T-Deck Pro's SX1262, or a desktop's
// pretend air, newton --mesh-air).  Compiled into the host as
// HostMeshSource.cpp by src/cmake/EmbedText.cmake, evaluated at boot by
// comms/host/HostMeshApp.cpp, the frame kept in the global HostMesh:host.
//
// DEVIATION (host addition): the ROM has no mesh.  The application is the
// Messages application's design (HostMessages.ns) over the mesh's natives
// rather than a transport: the frame polls HostMeshNextMessage every few
// seconds whether the application is open or not, and keeps what comes in
// the soup "Mesh:host" (a union soup), one entry a message: {class:
// '|meshMessage:host|, thread, name, sender, text, time, dir
// 'incoming/'outgoing, state 'unread/'read/'sending/'sent/'delivered/
// 'failed, sendId}.  A conversation is a thread: a node's public key (64 hex
// digits) for the messages to and from it, or "public" for the Public
// channel every MeshCore node shares, where sender is who said each thing.
// A message sent is kept as 'sending with the engine's id for it
// (HostMeshSendText); the same poll asks HostMeshSendState until it is
// 'sent (a channel's: on the air), 'delivered (acknowledged) or 'failed.
//
// Any screen, as Messages: GetAppParams' area, Layout, the list and a
// conversation drawn by the application, side by side from
// kSideBySideWidth.  Announce sends this node's advert so that others hear
// it.  docs/host-tdeck-pro-mesh.md.
//
// Saved contacts are Names cards (the owner's choice, 2026-10-14): a node's
// key is kept in one of the Names file's custom fields, the one labelled
// "Mesh Key" (made, the first free customN, the first time a node is
// saved), so that a card shows it and it can be edited there.
//
// Channels (the owner's ask, 2026-10-14): Public, and those joined with
// New's "Join Channel" - a hashtag channel ("#name", its secret made from
// its name, as every MeshCore application makes it) or a private one (its
// secret typed: 32 or 64 hex digits, or base64).  A channel's thread is
// "ch:" & its name (Public's stays "public"); each is listed under Public,
// in the order joined, and its header offers Show Key and Leave Channel.
//
// Location (the owner's ask, 2026-10-14), where the host has a GPS
// (HostGPSStatus: the T-Deck Pro's own receiver, tdeck_gps.cpp): the
// Prefs' "Location in adverts" puts this node's position in its adverts
// (HostMeshSetLocation, kept current from the poll once a minute), as
// MeshCore's own firmware can, so that it shows on the mesh's maps; and
// every conversation's header offers Send Location, the position as a
// message with a map link.  The cards
// with a key are given to the engine as MeshCore favourites (HostMesh-
// SaveContact: kept first across restarts, never the one to make room)
// whenever the application starts or opens, and a favourite whose card has
// gone is no longer one.  New lists them, then the nodes heard, then "Add by
// Key", which takes a name and a key (or a meshcore:// contact link) for a
// node never heard; a conversation's header offers to save its node.

{
	appSymbol: '|Mesh:host|,
	soupName: "Mesh:host",
	kPublic: "public",
	kPollMs: 2000,

	// How long messages are kept (the owner's ask, 2026-10-14: a busy mesh
	// says a lot): the Prefs' Keep, a week unless chosen otherwise (kept in
	// the application's prefs, keep: an index); and never more than
	// kMessagesMax, the oldest going first.  A message still sending is
	// never taken.  Pruned at the start, then at most hourly from the poll,
	// and at once when Keep is changed.
	kKeepNames: ["A day", "A week", "A month", "A year", "Always"],
	kKeepMinutes: [1440, 10080, 43200, 525600, nil],
	kKeepDefault: 1,
	kMessagesMax: 1000,
	kPruneEvery: 60,						// minutes
	lastPrune: nil,

	kMeshKeyLabel: "Mesh Key",
	kLocationEvery: 60,						// seconds between the adverts' position updates
	locationAt: nil,
	saved: nil,								// (the saved cards, by "k" & key: {key, name, entry})
	savedAt: nil,							// (when they were read, in seconds)

	app: {
		viewClass: 74,							// clView
		viewFlags: 5,							// vVisible, vApplication
		viewFormat: 273,						// white, a one-pixel black frame
		viewBounds: {left: 0, top: 0, right: 240, bottom: 320},
		declareSelf: 'base,
		viewFont: 10240,
		appSymbol: '|Mesh:host|,
		title: "Mesh",
		ReOrientToScreen: func() :Relayout(),

		kSideBySideWidth: 400,
		kFont: 10240,							// the system font, 10 point
		kBold: 1058816,							// bold
		kSmall: 9216,							// 9 point

		appAll: "All Conversations",
		labelsFilter: '_all,

		mode: 'list,							// 'list or 'thread
		currentThread: nil,						// the thread shown
		selectedId: nil,						// (the message selected in it: its _uniqueID)
		threads: nil,							// the conversations, Public first, then newest first
		listScroll: 0,
		threadScroll: 0,
		pickNodes: nil,							// (New's picker: the nodes it lists)

		folderTab: nil, headerView: nil, listView: nil, threadView: nil, replyLine: nil,
		sendButton: nil, statusBar: nil,
		prefsSlip: nil,							// (the Prefs slip, while it is open)
		replyLines: 1,							// (the lines its text wraps to, as last laid out)

		viewSetupFormScript: func()
		begin
			local p := GetAppParams();
			viewBounds := RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight);
		end,

		viewSetupDoneScript: func()
		begin
			foreach v in :ChildViewFrames() do
				if v.role then
					self.(v.role) := v;
			if folderTab and folderTab.showBarText then begin
				folderTab.showBarText.buttonClickScript := ConversationPicker;
				folderTab.showBarText.pickActionScript := ConversationPicked;
				folderTab.showBarText.pickThreads := nil;
			end;
			// (the alert, if there is one, is done with: what it told is here)
			:Mesh():CloseAlert();
			// (Names may have changed while the application was closed)
			try
				:Mesh():SyncSaved()
			onexception |evt.ex| do
				nil;
			:Reload();
			:Layout();
		end,

		viewQuitScript: func()
		begin
			if prefsSlip and prefsSlip.viewCObject then
				prefsSlip:Close();
			prefsSlip := nil;
			folderTab := headerView := listView := threadView := replyLine := sendButton := statusBar := nil;
		end,

		Relayout: func()
		begin
			local p := GetAppParams();
			SetValue(self, 'viewBounds, RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight));
			:Layout();
		end,

		// Every view placed in the application's area as it is now
		Layout: func()
		begin
			local box := :LocalBox();
			local w := box.right - box.left;
			local h := box.bottom - box.top;
			local barTop := h - (if statusBar then (statusBar:LocalBox()).bottom else 24);
			local headerH := FontHeight(kBold) + 6;
			local wide := w >= kSideBySideWidth;
			local listW := if wide then Min(w * 2 div 5, 300) else w;
			local showList := wide or mode = 'list;
			local showThread := wide or mode <> 'list;
			local tx := if wide then listW + 1 else 0;
			local tabH := (folderTab:LocalBox()).bottom - 5;
			local sendW := StrFontWidth(sendButton.text, kBold) + 20;
			// the reply line as tall as its text wrapped (at most half the
			// conversation), the Send button beside its last line
			local spacing := :ReplySpacing();
			local maxLines := Max(1, (barTop - tabH - headerH) div 2 div spacing);
			replyLines := :ReplyLineCount(w - tx - sendW - 18);
			local replyH := FontHeight(kFont) + 14 + (Min(replyLines, maxLines) - 1) * spacing;
			folderTab:Show();
			if showThread then headerView:Show() else headerView:Hide();
			SetValue(headerView, 'viewBounds, RelBounds(tx, tabH, w - tx, headerH));
			SetValue(listView, 'viewBounds, RelBounds(0, tabH, listW, barTop - tabH));
			local threadTop := tabH + headerH;
			SetValue(threadView, 'viewBounds, RelBounds(tx, threadTop, w - tx, barTop - threadTop - replyH));
			SetValue(replyLine, 'viewBounds, RelBounds(tx + 6, barTop - replyH + 4, w - tx - sendW - 18, replyH - 8));
			local sendH := FontHeight(kFont) + 6;
			SetValue(sendButton, 'viewBounds, RelBounds(w - sendW - 6, barTop - 4 - sendH, sendW, sendH));
			if showList then listView:Show() else listView:Hide();
			if showThread and currentThread then begin
				threadView:Show();
				replyLine:Show();
				sendButton:Show();
			end else begin
				if showThread then threadView:Show() else threadView:Hide();
				replyLine:Hide();
				sendButton:Hide();
			end;
			if folderTab and folderTab.showBarText then
				folderTab.showBarText:SyncView();
			:Redraw();
		end,

		Redraw: func()
		begin
			if headerView then headerView:Dirty();
			if listView then listView:Dirty();
			if threadView then threadView:Dirty();
		end,

		/*------------------------------------------------------------------
			The messages
		------------------------------------------------------------------*/

		Mesh: func() GetGlobalVar('|HostMesh:host|),
		Soup: func() GetUnionSoup(:Mesh().soupName),

		// the conversations: the Public channel first, then the rest newest
		// first - {thread, name, text, sender, time, dir, state, unread}
		Reload: func()
		begin
			local mesh := :Mesh();
			local byThread := {};
			local list := [];
			local soup := :Soup();
			if soup then begin
				local cursor := Query(soup, {type: 'index});
				local e;
				while e := cursor:Entry() do begin
					local key := Intern("t" & e.thread);
					local t := byThread.(key);
					if not t then begin
						t := {thread: e.thread, name: e.name, text: e.text, sender: e.sender, time: e.time,
							dir: e.dir, state: e.state, unread: 0};
						byThread.(key) := t;
						AddArraySlot(list, t);
					end else if e.time >= t.time then begin
						t.text := e.text; t.time := e.time; t.dir := e.dir; t.state := e.state; t.sender := e.sender;
						if e.name and e.thread <> mesh.kPublic then t.name := e.name;
					end;
					if e.state = 'unread then
						t.unread := t.unread + 1;
					cursor:Next();
				end;
			end;
			// (a node chosen with New, nothing said yet, is a conversation too)
			if currentThread and not byThread.(Intern("t" & currentThread)) and not mesh:IsChannel(currentThread) then
				AddArraySlot(list, {thread: currentThread, name: mesh:NodeName(currentThread), text: nil, time: Time(), unread: 0});
			local public := byThread.(Intern("t" & mesh.kPublic));
			if public then
				ArrayRemoveCount(list, LSearch(list, public, 0, '|=|, nil), 1)
			else
				public := {thread: mesh.kPublic, text: nil, time: nil, unread: 0};
			public.name := "Public channel";
			threads := [public];
			// the channels joined, in order, under Public
			local joined := HostMeshChannels();
			if joined then
				foreach i, c in joined do
					if i > 0 then begin
						local thread := mesh:ChannelThread(c.name);
						local t := byThread.(Intern("t" & thread));
						if t then
							ArrayRemoveCount(list, LSearch(list, t, 0, '|=|, nil), 1)
						else
							t := {thread: thread, text: nil, time: nil, unread: 0};
						t.name := c.name;
						AddArraySlot(threads, t);
					end;
			ArrayMunger(threads, Length(threads), 0, Sort(list, '|>|, 'time), 0, nil);
		end,

		// the messages of a thread, oldest first
		ThreadMessages: func(thread)
		begin
			local messages := [];
			local soup := :Soup();
			if soup then begin
				local cursor := Query(soup, {type: 'index});
				local e;
				while e := cursor:Entry() do begin
					if StrEqual(e.thread, thread) then
						AddArraySlot(messages, e);
					cursor:Next();
				end;
			end;
			Sort(messages, '|<|, 'time);
		end,

		ThreadFor: func(thread)
		begin
			if threads then
				foreach t in threads do
					if StrEqual(t.thread, thread) then
						return t;
			nil;
		end,

		OpenThread: func(thread)
		begin
			currentThread := thread;
			selectedId := nil;
			threadScroll := 0;
			mode := 'thread;
			foreach e in :ThreadMessages(thread) do
				if e.state = 'unread then begin
					e.state := 'read;
					EntryChangeXmit(e, nil);
				end;
			:Reload();
			:Layout();
			if replyLine then SetKeyView(replyLine.entryLine, 0);
		end,

		GetTargetInfo: func(reason)
			{target: nil, targetView: self, targetStore: GetDefaultStore()},

		// a conversation's name: its node's Names card's, or as heard, or its id
		ThreadName: func(t)
		begin
			local mesh := :Mesh();
			if StrEqual(t.thread, mesh.kPublic) then return "Public channel";
			if mesh:IsChannel(t.thread) then return mesh:ChannelOf(t.thread);
			local card := mesh:SavedCard(t.thread);
			if card then card.name
			else if t.name then t.name
			else :Mesh():ShortKey(t.thread);
		end,

		ShownThread: func()
			if mode = 'thread and currentThread then :ThreadFor(currentThread),

		// the folder tab's picker: All Conversations, then the conversations
		ConversationPicker: func()
		begin
			local shown := base:ShownThread();
			pickThreads := if base.threads then Clone(base.threads) else [];
			local items := [{item: base.appAll, mark: if shown then $  else $\uFC0B}];
			if Length(pickThreads) > 0 then
				AddArraySlot(items, 'pickseparator);
			foreach t in pickThreads do
				AddArraySlot(items, {item: base:ThreadName(t), mark: if shown and StrEqual(shown.thread, t.thread) then $\uFC0B else $ });
			DoPopup(items, 0, 2, self);
		end,

		ConversationPicked: func(index)
		begin
			local chosen := if index >= 2 and pickThreads and index - 2 < Length(pickThreads) then pickThreads[index - 2];
			pickThreads := nil;
			:hilite(nil);
			if chosen then
				base:OpenThread(chosen.thread)
			else if index = 0 then begin
				base.currentThread := nil;
				base:ShowList();
			end;
		end,

		ShowList: func()
		begin
			mode := 'list;
			selectedId := nil;
			:Reload();
			:Layout();
		end,

		// New: the saved contacts (Names cards with a mesh key), then the
		// people's nodes heard and not saved (chat nodes and room servers:
		// repeaters and sensors take no messages), then Add by Key
		Compose: func()
		begin
			local mesh := :Mesh();
			local cards := mesh:SavedCards(true);
			local savedList := [];
			foreach c in cards do
				AddArraySlot(savedList, {key: c.key, name: c.name});
			Sort(savedList, '|str<|, 'name);
			local items := [];
			pickNodes := [];
			foreach c in savedList do begin
				AddArraySlot(items, {item: c.name, mark: $ });
				AddArraySlot(pickNodes, c.key);
			end;
			local heard := [];
			local nodes := HostMeshContacts();
			if nodes then
				foreach n in nodes do
					if (n.kind = 'chat or n.kind = 'room) and not cards.(Intern("k" & n.key)) then
						AddArraySlot(heard, n);
			if Length(heard) > 0 then begin
				if Length(items) > 0 then begin
					AddArraySlot(items, 'pickseparator);
					AddArraySlot(pickNodes, nil);
				end;
				foreach n in heard do begin
					AddArraySlot(items, {item: n.name & (if n.kind = 'room then " (room)" else ""), mark: $ });
					AddArraySlot(pickNodes, n.key);
				end;
			end;
			if Length(items) > 0 then begin
				AddArraySlot(items, 'pickseparator);
				AddArraySlot(pickNodes, nil);
			end;
			AddArraySlot(items, {item: "Add by Key…\u", mark: $ });
			AddArraySlot(pickNodes, 'addByKey);
			AddArraySlot(items, {item: "Join Channel…\u", mark: $ });
			AddArraySlot(pickNodes, 'joinChannel);
			DoPopup(items, 0, 0, self);
		end,

		pickActionScript: func(index)
		begin
			local nodes := pickNodes;
			pickNodes := nil;
			local chosen := if nodes and index >= 0 and index < Length(nodes) then nodes[index];
			if chosen = 'addByKey then
				:OpenAddByKey()
			else if chosen = 'joinChannel then
				:OpenJoinChannel()
			else if IsString(chosen) then
				:OpenThread(chosen);
		end,

		pickCancelledScript: func() pickNodes := nil,

		// the reply line's text sent to the conversation, and the line emptied
		SendTyped: func()
		begin
			local text := replyLine.entryLine.text;
			// (nothing to send: Send does nothing - StrFilled is only
			// "not empty", spaces count)
			if not text or StrLen(TrimString(Clone(text))) = 0 or not currentThread then
				return nil;
			// emptied first, so that the line is empty however the sending
			// goes; with a string of its own, as typing changes the line's
			// string in place (a literal "" would become the next message)
			SetValue(replyLine.entryLine, 'text, Clone(""));
			:ReplyChanged();
			local t := :ThreadFor(currentThread);
			:Mesh():SendText(currentThread, if t then t.name, text);
			:Reload();
			:Redraw();
		end,

		// the reply line's spacing between lines
		ReplySpacing: func()
			if replyLine and replyLine.entryLine and replyLine.entryLine.viewLineSpacing then
				replyLine.entryLine.viewLineSpacing
			else FontHeight(kFont) + 6,

		// how many lines the reply line's text wraps to in a line this wide
		// (its label's indent taken off; a little narrower than the
		// paragraph's own wrapping, so as to give a line too many rather
		// than one too few)
		ReplyLineCount: func(width)
		begin
			local entry := if replyLine then replyLine.entryLine;
			if not entry or not entry.text or StrLen(entry.text) = 0 then
				return 1;
			local font := if entry.viewFont then entry.viewFont else kFont;
			local textW := width - (if replyLine.indent then replyLine.indent else 0) - 8;
			Max(1, Length(:WrapText(entry.text, Max(textW, 20), font)));
		end,

		// the reply line's text changed: laid out again when it wraps to
		// more lines or fewer
		ReplyChanged: func()
		begin
			if not replyLine then return nil;
			local box := :LocalBox();
			local wide := box.right - box.left >= kSideBySideWidth;
			local tx := if wide then Min((box.right - box.left) * 2 div 5, 300) + 1 else 0;
			local sendW := StrFontWidth(sendButton.text, kBold) + 20;
			local lines := :ReplyLineCount(box.right - box.left - tx - sendW - 18);
			if lines <> replyLines then
				:Layout();
		end,

		// Deleting: a message tapped in the conversation is selected (drawn
		// inverted; tapped again, or another place, it is not); Delete
		// removes the selected message, or - nothing selected - the whole
		// conversation, once confirmed (AsyncConfirm).
		DeleteSelected: func()
		begin
			if not currentThread or (mode = 'list and (:LocalBox()).right < kSideBySideWidth) then begin
				GetRoot():Notify(3, "Mesh", "Open a conversation to delete it, or tap one of its messages to delete just that message.");
				return nil;
			end;
			if selectedId then begin
				foreach e in :ThreadMessages(currentThread) do
					if e._uniqueID = selectedId then
						EntryRemoveFromSoupXmit(e, nil);
				selectedId := nil;
				:Reload();
				:Redraw();
				return true;
			end;
			local thread := currentThread;
			AsyncConfirm(:DeleteQuestion(thread),
				[{value: true, text: "Delete"}, {value: nil, text: "Cancel"}],
				func(confirmed) if confirmed then base:DeleteThread(thread));
		end,

		DeleteQuestion: func(thread)
		begin
			local t := :ThreadFor(thread);
			if StrEqual(thread, :Mesh().kPublic) then "Delete every message on the Public channel?"
			else if :Mesh():IsChannel(thread) then "Delete every message on " & :Mesh():ChannelOf(thread) & "?"
			else "Delete the conversation with " & (if t then :ThreadName(t) else "this node") & "?";
		end,

		// every message of a conversation removed
		DeleteThread: func(thread)
		begin
			foreach e in :ThreadMessages(thread) do
				EntryRemoveFromSoupXmit(e, nil);
			selectedId := nil;
			if StrEqual(currentThread, thread) then begin
				currentThread := nil;
				mode := 'list;
			end;
			:Reload();
			:Layout();
		end,

		Announce: func()
		begin
			if HostMeshAdvertise() then
				GetRoot():Notify(3, "Mesh", "Announced as " & (HostMeshStatus()).name & ".");
		end,

		/*------------------------------------------------------------------
			The Prefs slip (the "i" button's Prefs, as other applications
			have): this node's name, the radio's preset, and its power
			where the board can switch it - each taken as it is changed,
			the name when the slip is closed (a name set is announced)
		------------------------------------------------------------------*/

		// (the "i" button sends DoInfoPrefs to itself, which finds this
		// by inheritance: self is then the button, so the slip is made by
		// the application itself, base - sized from the button, it was
		// too small to see)
		DoInfoPrefs: func()
			base:TogglePrefs(),

		// Add by Key: a node never heard, by its name and its key (64 hex
		// digits, or a meshcore:// contact link pasted in the key's line);
		// saved as a Names card, and its conversation opened
		addSlip: nil,
		OpenAddByKey: func()
		begin
			if addSlip and addSlip.viewCObject then
				addSlip:Close();
			local box := :GlobalBox();
			local width := Min(box.right - box.left - 12, 260);
			local height := Min(110, box.bottom - box.top - 8);
			addSlip := BuildContext({_proto: addTemplate, meshApp: self,
				viewBounds: RelBounds(box.left + (box.right - box.left - width) div 2,
					box.top + (box.bottom - box.top - height) div 3, width, height)});
			addSlip:Open();
		end,

		addTemplate: {
			_proto: @179,						// protoFloatNGo
			meshApp: nil,
			theSlip: nil,
			nameLine: nil, keyLine: nil,
			viewSetupFormScript: func()
			begin
				theSlip := self;
				inherited:?viewSetupFormScript();
			end,
			viewSetupDoneScript: func()
			begin
				inherited:?viewSetupDoneScript();
				foreach v in :ChildViewFrames() do
					if v.role then
						self.(v.role) := v;
			end,
			viewQuitScript: func()
			begin
				if meshApp then meshApp.addSlip := nil;
				nameLine := keyLine := nil;
				inherited:?viewQuitScript();
			end,
			// the node saved and its conversation opened, or what is wrong told
			Add: func()
			begin
				local mesh := GetGlobalVar('|HostMesh:host|);
				local name := if nameLine then TrimString(Clone(nameLine.entryLine.text)) else "";
				local typed := if keyLine then keyLine.entryLine.text else "";
				local link := mesh:ParseLink(typed);
				local key := if link then link.key else mesh:NormalKey(typed);
				if not key then begin
					GetRoot():Notify(3, "Mesh", "A key is 64 hexadecimal digits (0-9, A-F), or a meshcore:// contact link.");
					return nil;
				end;
				if not StrFilled(name) and link and IsString(link.name) then
					name := link.name;
				if not mesh:SaveNode(key, name) then
					return nil;
				local app := meshApp;
				:Close();
				if app and app.viewCObject then
					app:OpenThread(key);
			end,
			stepChildren: [
				{_proto: @218,					// protoStaticText
				 viewBounds: {left: 10, top: 8, right: -10, bottom: 24}, viewJustify: 48,
				 text: "Add a node by its key", viewFont: 1058816},
				{_proto: @189,					// protoLabelInputLine
				 role: 'nameLine,
				 viewBounds: {left: 10, top: 30, right: -10, bottom: 50}, viewJustify: 48,
				 label: "Name", labelFont: 1058816, entryFont: 10240, indent: 46},
				{_proto: @189,					// protoLabelInputLine
				 role: 'keyLine,
				 viewBounds: {left: 10, top: 54, right: -10, bottom: 74}, viewJustify: 48,
				 label: "Key", labelFont: 1058816, entryFont: 9216, indent: 46},
				{_proto: @226,					// protoTextButton
				 viewBounds: {left: -60, top: -28, right: -30, bottom: -10}, viewJustify: 8388774,
				 text: "Add",
				 buttonClickScript: func() theSlip:Add()}
			]
		},

		// this node's position sent to the conversation shown
		SendLocation: func()
		begin
			local mesh := :Mesh();
			local fix := mesh:Fix();
			if not fix then begin
				GetRoot():Notify(3, "Mesh", "The GPS has no fix yet: it needs a view of the sky.");
				return nil;
			end;
			local t := :ThreadFor(currentThread);
			mesh:SendText(currentThread, if t then t.name, mesh:LocationText(fix));
			:Reload();
			:Redraw();
		end,

		// a channel's secret shown, to be typed into another device
		ShowChannelKey: func(thread)
		begin
			local name := :Mesh():ChannelOf(thread);
			local secret := nil;
			local joined := HostMeshChannels();
			if joined then
				foreach c in joined do
					if StrEqual(c.name, name) then secret := c.secret;
			GetRoot():Notify(3, name, if secret then
				(if BeginsWith(name, "#") then "A hashtag channel: anyone who joins " & name & " is in it. Its secret: "
				 else "A private channel: give this secret only to those who should be in it. ") & secret
				else "This node is no longer in the channel.");
		end,

		// a channel left, once confirmed (its messages are kept until deleted)
		LeaveChannel: func(thread)
		begin
			local name := :Mesh():ChannelOf(thread);
			AsyncConfirm("Leave " & name & "? Its messages are kept until you delete them.",
				[{value: true, text: "Leave"}, {value: nil, text: "Cancel"}],
				func(confirmed) if confirmed then begin
					HostMeshLeaveChannel(name);
					base:Reload();
					base:Layout();
				end);
		end,

		// Join Channel: a hashtag channel by its name, or a private one by its
		// name and secret; its conversation opened
		joinSlip: nil,
		OpenJoinChannel: func()
		begin
			if joinSlip and joinSlip.viewCObject then
				joinSlip:Close();
			local box := :GlobalBox();
			local width := Min(box.right - box.left - 12, 260);
			local height := Min(130, box.bottom - box.top - 8);
			joinSlip := BuildContext({_proto: joinTemplate, meshApp: self,
				viewBounds: RelBounds(box.left + (box.right - box.left - width) div 2,
					box.top + (box.bottom - box.top - height) div 3, width, height)});
			joinSlip:Open();
		end,

		joinTemplate: {
			_proto: @179,						// protoFloatNGo
			meshApp: nil,
			theSlip: nil,
			nameLine: nil, secretLine: nil,
			viewSetupFormScript: func()
			begin
				theSlip := self;
				inherited:?viewSetupFormScript();
			end,
			viewSetupDoneScript: func()
			begin
				inherited:?viewSetupDoneScript();
				foreach v in :ChildViewFrames() do
					if v.role then
						self.(v.role) := v;
			end,
			viewQuitScript: func()
			begin
				if meshApp then meshApp.joinSlip := nil;
				nameLine := secretLine := nil;
				inherited:?viewQuitScript();
			end,
			Join: func()
			begin
				local mesh := GetGlobalVar('|HostMesh:host|);
				local name := mesh:ChannelName(if nameLine then nameLine.entryLine.text);
				local secret := if secretLine then TrimString(Clone(secretLine.entryLine.text)) else "";
				if not StrFilled(secret) then secret := nil;
				if not name then begin
					GetRoot():Notify(3, "Mesh", "A channel needs a name: #name for a hashtag channel, or the name of a private one.");
					return nil;
				end;
				local result := HostMeshJoinChannel(name, secret);
				if result <> true then begin
					GetRoot():Notify(3, "Mesh",
						if result = 'badSecret then
							(if BeginsWith(name, "#") then "The secret is 32 or 64 hexadecimal digits, or base64 - or leave it empty: a hashtag channel's comes from its name."
							 else "A private channel needs its secret: 32 or 64 hexadecimal digits, or base64. A hashtag channel's name begins with #.")
						else if result = 'full then "This node is in as many channels as it can be (" & NumberStr(8) & "). Leave one first."
						else if result = 'already then "This node is already in that channel."
						else "That name cannot be a channel's (31 letters at most).");
					return nil;
				end;
				local app := meshApp;
				:Close();
				if app and app.viewCObject then
					app:OpenThread(mesh:ChannelThread(name));
			end,
			stepChildren: [
				{_proto: @218,					// protoStaticText
				 viewBounds: {left: 10, top: 8, right: -10, bottom: 24}, viewJustify: 48,
				 text: "Join a channel", viewFont: 1058816},
				{_proto: @189,					// protoLabelInputLine
				 role: 'nameLine,
				 viewBounds: {left: 10, top: 30, right: -10, bottom: 50}, viewJustify: 48,
				 label: "Name", labelFont: 1058816, entryFont: 10240, indent: 50},
				{_proto: @189,					// protoLabelInputLine
				 role: 'secretLine,
				 viewBounds: {left: 10, top: 54, right: -10, bottom: 74}, viewJustify: 48,
				 label: "Secret", labelFont: 1058816, entryFont: 9216, indent: 50},
				{_proto: @218,					// protoStaticText
				 viewBounds: {left: 10, top: 78, right: -10, bottom: 94}, viewJustify: 48,
				 text: "None for #name: it comes from the name", viewFont: 9216},
				{_proto: @226,					// protoTextButton
				 viewBounds: {left: -60, top: -28, right: -30, bottom: -10}, viewJustify: 8388774,
				 text: "Join",
				 buttonClickScript: func() theSlip:Join()}
			]
		},

		TogglePrefs: func()
		begin
			if prefsSlip and prefsSlip.viewCObject then begin
				prefsSlip:Close();
				prefsSlip := nil;
				return nil;
			end;
			local box := :GlobalBox();
			local width := Min(box.right - box.left - 12, 260);
			local switchable := HostMeshPowerSwitchable();
			local gps := HostGPSAvailable();
			local height := 240 + (if switchable then 22 else 0) + (if gps then 22 else 0);
			height := Min(height, box.bottom - box.top - 8);
			prefsSlip := BuildContext({_proto: prefsTemplate, meshApp: self, switchable: switchable, gps: gps,
				viewBounds: RelBounds(box.left + (box.right - box.left - width) div 2,
					box.top + (box.bottom - box.top - height) div 2, width, height)});
			prefsSlip:Open();
		end,

		// The Prefs slip: the node's name; a preset, which fills in the
		// radio's settings below it (MeshCore's community presets:
		// HostMeshRegions); the settings themselves - frequency, bandwidth,
		// spreading factor, coding rate, power, and the mesh's path hash
		// size - each changeable by hand, the preset then saying which one
		// they are ("Custom" when none); the radio's power where the board
		// can switch it.  The name and the radio's settings are taken when
		// the slip is closed (settings the radio cannot take are told, and
		// left as they were); the power at once.
		prefsTemplate: {
			_proto: @179,						// protoFloatNGo
			meshApp: nil,
			switchable: nil,
			gps: nil,
			theSlip: nil,
			nameShown: nil,						// (the name when the slip opened)
			radio: nil,							// (the settings as they are being changed)
			kRow: 20,
			viewSetupFormScript: func()
			begin
				theSlip := self;
				local status := HostMeshStatus();
				nameShown := if status and status.name then status.name else "";
				radio := HostMeshRadio();
				if not radio then
					radio := {frequency: 916.575, bandwidth: 62.5, spreadingFactor: 7, codingRate: 7, txPower: 22, pathHashSize: 1};
				inherited:?viewSetupFormScript();
			end,
			viewSetupDoneScript: func()
			begin
				inherited:?viewSetupDoneScript();
				foreach v in :ChildViewFrames() do
					if v.role then
						self.(v.role) := v;
			end,
			viewQuitScript: func()
			begin
				local name := if nameLine then TrimString(Clone(nameLine.entryLine.text));
				if name and StrLen(name) > 0 and not StrEqual(name, nameShown) then
					HostMeshSetName(name);
				:TakeTyped();
				if :RadioChanged() and not HostMeshSetRadio(radio) then
					GetRoot():Notify(3, "Mesh", "The radio cannot be set so: the frequency must be 150 to 960 MHz, the power -9 to 22 dBm. Its settings are as they were.");
				if meshApp then begin
					meshApp.prefsSlip := nil;
					meshApp:Redraw();
					// (again once the engine has the new settings: the list's foot)
					local app := meshApp;
					AddDelayedCall(func() if app.viewCObject then app:Redraw(), [], 1000);
				end;
				keepPicker := nil;
				nameLine := presetPicker := frequencyLine := bandwidthPicker := spreadingPicker := codingPicker := powerLine := hashPicker := nil;
				inherited:?viewQuitScript();
			end,
			nameLine: nil, keepPicker: nil, presetPicker: nil, frequencyLine: nil, bandwidthPicker: nil, spreadingPicker: nil,
			codingPicker: nil, powerLine: nil, hashPicker: nil,

			// a number's text with no more decimals than it needs (at most places)
			NumText: func(x, places)
			begin
				local s := FormattedNumberStr(x, "%." & NumberStr(places) & "f");
				if StrPos(s, ".", 0) then begin
					while EndsWith(s, "0") do
						s := SubStr(s, 0, StrLen(s) - 1);
					if EndsWith(s, ".") then
						s := SubStr(s, 0, StrLen(s) - 1);
				end;
				s;
			end,

			// the preset the settings are, or nil
			PresetIndex: func()
			begin
				local names := HostMeshRegions();
				if names then
					foreach i, n in names do begin
						local p := HostMeshRegionSettings(i);
						if p and Abs(p.frequency - radio.frequency) < 0.0005 and Abs(p.bandwidth - radio.bandwidth) < 0.01
							and p.spreadingFactor = radio.spreadingFactor and p.codingRate = radio.codingRate
							and p.pathHashSize = radio.pathHashSize then
							return i;
					end;
				nil;
			end,
			PresetText: func()
			begin
				local i := :PresetIndex();
				if i then HostMeshRegions()[i] else "Custom";
			end,

			// the typed frequency and power taken into the settings (left as
			// they were when they do not read as numbers)
			TakeTyped: func()
			begin
				local n;
				if frequencyLine and (n := StringToNumber(frequencyLine.entryLine.text)) then
					radio.frequency := n;
				if powerLine and (n := StringToNumber(powerLine.entryLine.text)) then
					radio.txPower := RIntToL(n);
			end,

			RadioChanged: func()
			begin
				local now := HostMeshRadio();
				now and (Abs(now.frequency - radio.frequency) >= 0.0005 or Abs(now.bandwidth - radio.bandwidth) >= 0.01
					or now.spreadingFactor <> radio.spreadingFactor or now.codingRate <> radio.codingRate
					or now.txPower <> radio.txPower or now.pathHashSize <> radio.pathHashSize);
			end,

			// every line and picker showing the settings (after a preset)
			ShowRadio: func()
			begin
				if frequencyLine then SetValue(frequencyLine.entryLine, 'text, :NumText(radio.frequency, 3));
				if powerLine then SetValue(powerLine.entryLine, 'text, NumberStr(radio.txPower));
				foreach picker in [bandwidthPicker, spreadingPicker, codingPicker, hashPicker] do
					if picker then picker:UpdateText(picker:TextSetup());
				:ShowPreset();
			end,
			ShowPreset: func()
				if presetPicker then presetPicker:UpdateText(:PresetText()),

			stepChildren: [
				{_proto: @218,					// protoStaticText
				 viewBounds: {left: 10, top: 6, right: -10, bottom: 22}, viewJustify: 48,
				 viewFont: 1058816, text: "Mesh Preferences"},
				{_proto: @189,					// protoLabelInputLine
				 role: 'nameLine,
				 viewBounds: {left: 10, top: 24, right: -10, bottom: 44}, viewJustify: 48,
				 label: "Name", labelFont: 1058816, entryFont: 10240, indent: 76,
				 TextSetup: func() Clone(theSlip.nameShown)},
				{_proto: @190,					// protoLabelPicker
				 role: 'keepPicker,
				 viewBounds: {left: 10, top: 48, right: -10, bottom: 64}, viewJustify: 48,
				 text: "Keep", indent: 76,
				 labelCommands: [""],
				 viewSetupFormScript: func()
				 begin
					labelCommands := GetGlobalVar('|HostMesh:host|).kKeepNames;
					inherited:?viewSetupFormScript();
				 end,
				 TextSetup: func()
				 begin
					local mesh := GetGlobalVar('|HostMesh:host|);
					mesh.kKeepNames[mesh:KeepIndex()];
				 end,
				 // (at once: messages older than that go now)
				 LabelActionScript: func(index) GetGlobalVar('|HostMesh:host|):SetKeep(index)},
				{_proto: @190,					// protoLabelPicker
				 role: 'presetPicker,
				 viewBounds: {left: 10, top: 68, right: -10, bottom: 84}, viewJustify: 48,
				 text: "Preset", indent: 76,
				 labelCommands: [""],
				 viewSetupFormScript: func()
				 begin
					labelCommands := HostMeshRegions();
					if not labelCommands or Length(labelCommands) = 0 then
						labelCommands := [""];
					inherited:?viewSetupFormScript();
				 end,
				 TextSetup: func() theSlip:PresetText(),
				 // (a preset fills the settings in; the power is left)
				 LabelActionScript: func(index)
				 begin
					local p := HostMeshRegionSettings(index);
					if p then begin
						foreach slot, value in p do
							theSlip.radio.(slot) := value;
						theSlip:ShowRadio();
					end;
				 end},
				{_proto: @189,					// protoLabelInputLine
				 role: 'frequencyLine,
				 viewBounds: {left: 10, top: 86, right: -40, bottom: 106}, viewJustify: 48,
				 label: "Frequency", labelFont: 1058816, entryFont: 10240, indent: 76,
				 entryFlags: 0x2A01,			// (numbers and punctuation)
				 TextSetup: func() theSlip:NumText(theSlip.radio.frequency, 3),
				 textChanged: func()
				 begin
					inherited:?textChanged();
					theSlip:TakeTyped();
					theSlip:ShowPreset();
				 end},
				{_proto: @218,					// protoStaticText (the frequency's unit)
				 viewBounds: {left: -36, top: 90, right: -8, bottom: 106}, viewJustify: 32, text: "MHz"},
				{_proto: @190,					// protoLabelPicker
				 role: 'bandwidthPicker,
				 viewBounds: {left: 10, top: 110, right: -10, bottom: 126}, viewJustify: 48,
				 text: "Bandwidth", indent: 76,
				 labelCommands: [""],
				 bandwidths: nil,
				 viewSetupFormScript: func()
				 begin
					bandwidths := HostMeshBandwidths();
					if not bandwidths or Length(bandwidths) = 0 then
						bandwidths := [62.5];
					labelCommands := foreach b in bandwidths collect theSlip:NumText(b, 2) & " kHz";
					inherited:?viewSetupFormScript();
				 end,
				 TextSetup: func() theSlip:NumText(theSlip.radio.bandwidth, 2) & " kHz",
				 LabelActionScript: func(index)
				 begin
					theSlip.radio.bandwidth := bandwidths[index];
					theSlip:ShowPreset();
				 end},
				{_proto: @190,					// protoLabelPicker
				 role: 'spreadingPicker,
				 viewBounds: {left: 10, top: 131, right: -10, bottom: 147}, viewJustify: 48,
				 text: "Spreading", indent: 76,
				 labelCommands: ["5", "6", "7", "8", "9", "10", "11", "12"],
				 TextSetup: func() NumberStr(theSlip.radio.spreadingFactor),
				 LabelActionScript: func(index)
				 begin
					theSlip.radio.spreadingFactor := index + 5;
					theSlip:ShowPreset();
				 end},
				{_proto: @190,					// protoLabelPicker
				 role: 'codingPicker,
				 viewBounds: {left: 10, top: 152, right: -10, bottom: 168}, viewJustify: 48,
				 text: "Coding", indent: 76,
				 labelCommands: ["4/5", "4/6", "4/7", "4/8"],
				 TextSetup: func() "4/" & NumberStr(theSlip.radio.codingRate),
				 LabelActionScript: func(index)
				 begin
					theSlip.radio.codingRate := index + 5;
					theSlip:ShowPreset();
				 end},
				{_proto: @189,					// protoLabelInputLine
				 role: 'powerLine,
				 viewBounds: {left: 10, top: 170, right: -40, bottom: 190}, viewJustify: 48,
				 label: "Power", labelFont: 1058816, entryFont: 10240, indent: 76,
				 entryFlags: 0x2A01,			// (numbers and punctuation)
				 TextSetup: func() NumberStr(theSlip.radio.txPower),
				 textChanged: func()
				 begin
					inherited:?textChanged();
					theSlip:TakeTyped();
				 end},
				{_proto: @218,					// protoStaticText (the power's unit)
				 viewBounds: {left: -36, top: 174, right: -8, bottom: 190}, viewJustify: 32, text: "dBm"},
				{_proto: @190,					// protoLabelPicker
				 role: 'hashPicker,
				 viewBounds: {left: 10, top: 194, right: -10, bottom: 210}, viewJustify: 48,
				 text: "Path hash", indent: 76,
				 labelCommands: ["1 byte", "2 bytes", "3 bytes"],
				 TextSetup: func() labelCommands[Max(0, Min(2, theSlip.radio.pathHashSize - 1))],
				 LabelActionScript: func(index)
				 begin
					theSlip.radio.pathHashSize := index + 1;
					theSlip:ShowPreset();
				 end},
				{_proto: @164,					// protoCheckbox
				 viewBounds: {left: 10, top: 214, right: -10, bottom: 232}, viewJustify: 48,
				 text: "Location in adverts",
				 buttonValue: true,
				 viewValue: nil,
				 viewSetupFormScript: func()
				 begin
					// (only where there is a GPS)
					if not theSlip.gps then
						viewFlags := BAnd(viewFlags, BNot(1));
					viewValue := GetGlobalVar('|HostMesh:host|):ShareLocation();
					inherited:?viewSetupFormScript();
				 end,
				 valueChanged: func() GetGlobalVar('|HostMesh:host|):SetShareLocation(viewValue)},
				{_proto: @164,					// protoCheckbox
				 role: 'powerBox,
				 viewBounds: {left: 10, top: 214, right: -10, bottom: 232}, viewJustify: 48,
				 text: "The radio on",
				 buttonValue: true,
				 viewValue: nil,
				 viewSetupFormScript: func()
				 begin
					// (below Location in adverts where that is shown)
					if theSlip.gps then
						viewBounds := {left: 10, top: 236, right: -10, bottom: 254};
					// (only where the board can switch the radio)
					if not theSlip.switchable then
						viewFlags := BAnd(viewFlags, BNot(1));
					viewValue := HostMeshPowered();
					inherited:?viewSetupFormScript();
				 end,
				 valueChanged: func()
				 begin
					if not HostMeshSetPower(viewValue) then
						SetValue(self, 'viewValue, HostMeshPowered());
				 end},
				{_proto: @218,					// protoStaticText
				 viewBounds: {left: 10, top: -22, right: -40, bottom: -6}, viewJustify: 176,
				 viewFont: 9216,
				 text: "",
				 viewSetupFormScript: func()
				 begin
					local status := HostMeshStatus();
					text := if status and status.id then "This node: " & status.id else "";
					inherited:?viewSetupFormScript();
				 end},
				{_proto: @166}					// protoClosebox
			]
		},

		viewScrollUpScript: func()
		begin
			if mode = 'list then listScroll := Max(0, listScroll - 1)
			else threadScroll := threadScroll + 1;
			:Redraw();
		end,

		viewScrollDownScript: func()
		begin
			if mode = 'list then listScroll := listScroll + 1
			else threadScroll := Max(0, threadScroll - 1);
			:Redraw();
		end,

		/*------------------------------------------------------------------
			Drawing helpers (Messages')
		------------------------------------------------------------------*/

		Diamond: func(x, y, r) MakePolygon([x, y - r, x + r, y, x, y + r, x - r, y]),

		WrapText: func(text, width, font)
		begin
			local lines := [];
			foreach paragraph in :Split(text, $\n) do begin
				local line := "";
				foreach word in :Split(paragraph, $ ) do begin
					local tryLine := if StrLen(line) = 0 then word else line & " " & word;
					if StrFontWidth(tryLine, font) <= width then
						line := tryLine
					else begin
						if StrLen(line) > 0 then
							AddArraySlot(lines, line);
						line := word;
						while StrFontWidth(line, font) > width and StrLen(line) > 1 do begin
							local n := StrLen(line) - 1;
							while n > 1 and StrFontWidth(SubStr(line, 0, n), font) > width do
								n := n - 1;
							AddArraySlot(lines, SubStr(line, 0, n));
							line := SubStr(line, n, StrLen(line) - n);
						end;
					end;
				end;
				AddArraySlot(lines, line);
			end;
			lines;
		end,

		WhenText: func(time)
		begin
			if not time then return "";
			local today := Time() div 1440;
			local day := time div 1440;
			if day = today then :TimeText(time)
			else if day = today - 1 then "Yesterday"
			else ShortDate(time);
		end,

		TimeText: func(time)
		begin
			local minutes := time mod 1440;
			local hour := minutes div 60;
			local minute := minutes mod 60;
			local suffix := if hour >= 12 then " PM" else " AM";
			hour := hour mod 12;
			if hour = 0 then hour := 12;
			NumberStr(hour) & ":" & (if minute < 10 then "0" else "") & NumberStr(minute) & suffix;
		end,

		DayText: func(time)
		begin
			local today := Time() div 1440;
			local day := time div 1440;
			if day = today then "Today" else if day = today - 1 then "Yesterday" else ShortDate(time);
		end,

		StateText: func(m)
		begin
			if m.state = 'failed then "Not sent"
			else if m.state = 'sending then "Sending"
			else if m.state = 'delivered then "Delivered " & :WhenText(m.time)
			else "Sent " & :WhenText(m.time);
		end,

		stepChildren: [
			{
				_proto: @670,						// protoClockFolderTab
				role: 'folderTab,
				RedoText: func()
				begin
					local t := base:ShownThread();
					local text := Stringer([$\uFC01, if t then base:ThreadName(t) else base.appAll]);
					showBarText.text := StrTruncate(text, 137);
					showBarText.width := StrFontWidth(showBarText.text, showBarText.viewFont) + 16;
					showBarText.viewBounds := SetBounds(-showBarText.width - 4, 3, -4, 17);
					showBarText.viewJustify := 8388646;
					:Dirty();
				end
			},

			// the header over a conversation: its name, and the node's id
			{
				viewClass: 74, viewFlags: 513, viewFormat: 0, role: 'headerView,
				viewBounds: {left: 0, top: 0, right: 240, bottom: 24},
				viewDrawScript: func()
				begin
					local b := :LocalBox();
					local w := b.right;
					local h := b.bottom;
					local base := :Parent();
					:DrawShape(MakeLine(0, h - 1, w, h - 1), {penSize: 1});
					local bh := FontHeight(base.kBold);
					local bt := 1;
					local sh := FontHeight(base.kSmall);
					local st := bt + bh - sh;
					local t := if base.currentThread then base:ThreadFor(base.currentThread);
					if t and base.mode = 'thread then begin
						:DrawShape(base:Diamond(12, bt + bh div 2, 4), {penPattern: 0, fillPattern: 5});
						local id := if StrEqual(t.thread, base:Mesh().kPublic) then "everyone"
							else if base:Mesh():IsChannel(t.thread) then "channel"
							else base:Mesh():ShortKey(t.thread);
						local iw := StrFontWidth(id, base.kSmall);
						:DrawShape(MakeText(StyledStrTruncate(base:ThreadName(t), w - iw - 40, base.kBold), 22, bt, w - iw - 12, bt + bh), {font: base.kBold});
						:DrawShape(MakeText(id, w - iw - 8, st, w, st + sh), {font: base.kSmall});
					end;
				end,
				// tapped: a node not saved offers to be (Save to Names), and a
				// narrow screen goes back to the list
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					local narrow := (base:LocalBox()).right < base.kSideBySideWidth;
					local mesh := base:Mesh();
					local thread := if base.mode = 'thread then base.currentThread;
					local node := thread and not mesh:IsChannel(thread) and not mesh:SavedCard(thread);
					local channel := thread and mesh:IsChannel(thread) and not StrEqual(thread, mesh.kPublic);
					local items := [];
					headerPicks := [];
					if node then begin
						AddArraySlot(headerPicks, 'save);
						AddArraySlot(items, {item: "Save to Names", mark: $ });
					end else if channel then begin
						AddArraySlot(headerPicks, 'showKey);
						AddArraySlot(items, {item: "Show Key", mark: $ });
						AddArraySlot(headerPicks, 'leave);
						AddArraySlot(items, {item: "Leave Channel", mark: $ });
					end;
					if thread and HostGPSAvailable() then begin
						AddArraySlot(headerPicks, 'sendLocation);
						AddArraySlot(items, {item: "Send Location", mark: $ });
					end;
					if Length(items) > 0 then begin
						if narrow then begin
							AddArraySlot(items, 'pickseparator);
							AddArraySlot(headerPicks, nil);
							AddArraySlot(items, {item: base.appAll, mark: $ });
							AddArraySlot(headerPicks, 'list);
						end;
						headerPopup := DoPopup(items, 0, 0, self);
					end else begin
						headerPicks := nil;
						if base.mode <> 'list and narrow then
							base:ShowList();
					end;
					true;
				end,
				headerPicks: nil,
				headerPopup: nil,					// (the popup, while it is open)
				pickActionScript: func(index)
				begin
					local base := :Parent();
					local picks := headerPicks;
					headerPicks := headerPopup := nil;
					local chosen := if picks and index >= 0 and index < Length(picks) then picks[index];
					if chosen = 'save and base.currentThread then begin
						local t := base:ThreadFor(base.currentThread);
						if base:Mesh():SaveNode(base.currentThread, if t then t.name) then
							GetRoot():Notify(3, "Mesh", base:ThreadName(base:ThreadFor(base.currentThread)) & " is saved in Names.");
						base:Redraw();
					end else if chosen = 'sendLocation and base.currentThread then
						base:SendLocation()
					else if chosen = 'showKey and base.currentThread then
						base:ShowChannelKey(base.currentThread)
					else if chosen = 'leave and base.currentThread then
						base:LeaveChannel(base.currentThread)
					else if chosen = 'list then
						base:ShowList();
				end,
				pickCancelledScript: func() headerPicks := headerPopup := nil
			},

			// the conversations, and this node at the foot
			{
				viewClass: 74, viewFlags: 513, viewFormat: 0, role: 'listView,
				viewBounds: {left: 0, top: 24, right: 240, bottom: 300},
				RowHeight: func() FontHeight(:Parent().kBold) + FontHeight(:Parent().kFont) + 16,
				viewDrawScript: func()
				begin
					local base := :Parent();
					local b := :LocalBox();
					local w := b.right;
					local rowH := :RowHeight();
					local footH := FontHeight(base.kSmall) + 6;
					local y := 0;
					local i := base.listScroll;
					while base.threads and i < Length(base.threads) and y + rowH <= b.bottom - footH do begin
						local t := base.threads[i];
						local selected := (base:LocalBox()).right >= base.kSideBySideWidth and base.currentThread and StrEqual(base.currentThread, t.thread);
						if selected then
							:DrawShape(MakeRect(0, y, w, y + rowH), {penPattern: 0, fillPattern: 5});
						local ink := if selected then 1 else 5;
						local mode := if selected then 3 else 0;
						if t.unread > 0 then
							:DrawShape(base:Diamond(10, y + 10, 4), {penPattern: 0, fillPattern: ink});
						local when := base:WhenText(if t.text then t.time);
						local whenW := StrFontWidth(when, base.kSmall);
						:DrawShape(MakeText(StyledStrTruncate(base:ThreadName(t), w - whenW - 30, base.kBold), 20, y + 4, w - whenW - 10, y + 4 + FontHeight(base.kBold)),
							{font: base.kBold, transferMode: mode});
						:DrawShape(MakeText(when, w - whenW - 6, y + 6, w, y + 6 + FontHeight(base.kSmall)),
							{font: base.kSmall, transferMode: mode});
						local snippet := if not t.text then "Nothing said yet."
							else (if t.dir = 'outgoing then (if t.state = 'failed then "You: Not sent - " else "You: ")
								else if t.sender then t.sender & ": " else "") & base:Flatten(t.text);
						local font := if t.unread > 0 then base.kBold else base.kFont;
						:DrawShape(MakeText(StyledStrTruncate(snippet, w - 26, font), 20, y + 8 + FontHeight(base.kBold), w - 6, y + rowH - 3),
							{font: font, transferMode: mode});
						:DrawShape(MakeLine(4, y + rowH - 1, w - 4, y + rowH - 1), {penSize: 1, penPattern: 3});
						y := y + rowH;
						i := i + 1;
					end;
					// this node: its name, id and radio, or that it is off
					local status := HostMeshStatus();
					local me := if not status then "No mesh radio."
						else if status.state = 'off then "The LoRa radio is off (Prefs, Host)."
						else "You: " & status.name & " " & status.id & " - " & status.region;
					:DrawShape(MakeLine(0, b.bottom - footH, w, b.bottom - footH), {penSize: 1, penPattern: 3});
					:DrawShape(MakeText(StyledStrTruncate(me, w - 12, base.kSmall), 6, b.bottom - footH + 3, w - 6, b.bottom),
						{font: base.kSmall});
				end,
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					local y := GetPoint(5, unit) - (:GlobalBox()).top;
					local i := base.listScroll + y div :RowHeight();
					if base.threads and i < Length(base.threads) then
						base:OpenThread(base.threads[i].thread);
					true;
				end
			},

			// a conversation
			{
				viewClass: 74, viewFlags: 545, viewFormat: 0, role: 'threadView,
				viewBounds: {left: 0, top: 24, right: 240, bottom: 270},
				viewDrawScript: func()
				begin
					local base := :Parent();
					local b := :LocalBox();
					local w := b.right;
					local h := b.bottom;
					if (base:LocalBox()).right >= base.kSideBySideWidth then
						:DrawShape(MakeLine(0, 0, 0, h), {penSize: 1});
					if not base.currentThread then begin
						:DrawShape(MakeText("Choose a conversation.", 12, 16, w - 12, 40), {font: base.kFont});
						return;
					end;
					local messages := base:ThreadMessages(base.currentThread);
					local font := base.kFont;
					local small := base.kSmall;
					local lineH := FontHeight(font);
					local smallH := FontHeight(small);
					local maxBubble := w * 7 div 10;
					if Length(messages) = 0 then begin
						:DrawShape(MakeText("Nothing said yet. Write below and tap Send.", 12, 16, w - 12, 16 + 3 * lineH), {font: font});
						return;
					end;
					local y := h - 6;
					hits := [];
					local i := Length(messages) - 1 - base.threadScroll;
					local newerDay := nil;
					while i >= 0 and y > 0 do begin
						local m := messages[i];
						local day := m.time div 1440;
						if newerDay and day <> newerDay then
							y := :DaySeparator(y, w, messages[i + 1].time);
						newerDay := day;
						local lines := base:WrapText(m.text, maxBubble - 16, font);
						local textW := 0;
						foreach line in lines do
							textW := Max(textW, StrFontWidth(line, font));
						local bubbleW := textW + 16;
						local bubbleH := Length(lines) * lineH + 10;
						local out := m.dir = 'outgoing;
						// (on a channel, who said it, over its time)
						local meta := if out then base:StateText(m)
							else (if m.sender then m.sender & "  " else "") & base:WhenText(m.time);
						y := y - smallH;
						local metaW := Min(StrFontWidth(meta, small), w - 16);
						local mx := if out then w - metaW - 8 else 8;
						:DrawShape(MakeText(StyledStrTruncate(meta, metaW + 1, small), mx, y, mx + metaW + 2, y + smallH), {font: small});
						y := y - bubbleH - 4;
						local left := if out then w - bubbleW - 10 else 6;
						// (the selected one inverted: Delete removes it)
						local chosen := base.selectedId and m._uniqueID = base.selectedId;
						AddArraySlot(hits, {left: left, top: y, right: left + bubbleW, bottom: y + bubbleH, id: m._uniqueID});
						if out then
							:DrawShape(MakeRoundRect(left + 3, y + 3, left + bubbleW + 3, y + bubbleH + 3, 6), {penPattern: 0, fillPattern: 5});
						:DrawShape(MakeRoundRect(left, y, left + bubbleW, y + bubbleH, 6), {penSize: 1, penPattern: 5, fillPattern: if chosen then 5 else 1});
						local ty := y + 5;
						foreach line in lines do begin
							:DrawShape(MakeText(line, left + 8, ty, left + bubbleW, ty + lineH), {font: font, transferMode: if chosen then 3 else 0});
							ty := ty + lineH;
						end;
						y := y - 8;
						i := i - 1;
					end;
					if i < 0 and newerDay then
						:DaySeparator(y, w, messages[0].time);
				end,
				// (the bubbles as last drawn, for a tap to find: {left, top,
				// right, bottom, id})
				hits: nil,
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					local box := :GlobalBox();
					local x := GetPoint(4, unit) - box.left;
					local y := GetPoint(5, unit) - box.top;
					local hit := nil;
					if hits then
						foreach h in hits do
							if x >= h.left and x < h.right and y >= h.top and y < h.bottom then
								hit := h.id;
					base.selectedId := if hit and hit <> base.selectedId then hit else nil;
					:Dirty();
					true;
				end,
				DaySeparator: func(y, w, time)
				begin
					local base := :Parent();
					local label := base:DayText(time);
					local lw := StrFontWidth(label, base.kSmall);
					local sh := FontHeight(base.kSmall);
					local top := y - sh - 2;
					local cy := top + sh div 2;
					:DrawShape(MakeLine(8, cy, (w - lw) div 2 - 6, cy), {penSize: 1, penPattern: 3});
					:DrawShape(MakeLine((w + lw) div 2 + 6, cy, w - 8, cy), {penSize: 1, penPattern: 3});
					:DrawShape(MakeText(label, (w - lw) div 2, top, (w + lw) div 2 + 2, top + sh), {font: base.kSmall});
					top - 8;
				end
			},

			{
				_proto: @189,						// protoLabelInputLine
				role: 'replyLine,
				viewBounds: {left: 6, top: 270, right: 180, bottom: 290},
				label: "Say",
				labelFont: 1058816,
				entryFont: 10240,
				// the entry wraps (the proto's is one line only), the
				// reply area growing to fit it
				viewSetupChildrenScript: func()
				begin
					inherited:viewSetupChildrenScript();
					if BAnd(entryLine.viewJustify, 0x800000) <> 0 then
						entryLine.viewJustify := entryLine.viewJustify - 0x800000;
				end,
				textChanged: func()
				begin
					inherited:?textChanged();
					base:ReplyChanged();
				end
			},
			{
				_proto: @226,						// protoTextButton
				role: 'sendButton,
				viewBounds: {left: 190, top: 270, right: 234, bottom: 290},
				text: "Send",
				buttonClickScript: func() :Parent():SendTyped()
			},

			// the status bar: the "i" button (Prefs), New, All, Announce, Delete;
			// the close box
			{
				_proto: @73,						// protoStatusBar
				role: 'statusBar,
				menuLeftButtons: [
					{_proto: @478},					// protoInfoButton (DoInfoPrefs)
					{_proto: @226, text: "New", buttonClickScript: func() base:Compose()},
					{_proto: @226, text: "All", buttonClickScript: func() base:ShowList()},
					{_proto: @226, text: "Announce", buttonClickScript: func() base:Announce()},
					{_proto: @226, text: "Delete", buttonClickScript: func() base:DeleteSelected()}
				],
				menuRightButtons: [
					{_proto: @166}					// protoClosebox
				]
			}
		],

		Split: func(text, separator)
		begin
			local pieces := [];
			local start := 0;
			for i := 0 to StrLen(text) - 1 do
				if text[i] = separator then begin
					if i > start then
						AddArraySlot(pieces, SubStr(text, start, i - start));
					start := i + 1;
				end;
			if StrLen(text) > start then
				AddArraySlot(pieces, SubStr(text, start, StrLen(text) - start));
			if Length(pieces) = 0 then
				AddArraySlot(pieces, "");
			pieces;
		end,

		Flatten: func(text)
		begin
			local flat := Clone(text);
			for i := 0 to StrLen(flat) - 1 do
				if flat[i] = $\n then flat[i] := $ ;
			flat;
		end
	},

	/*----------------------------------------------------------------------
		The application's work outside its views
	----------------------------------------------------------------------*/

	Soup: func() GetUnionSoup(soupName),

	KeepIndex: func()
	begin
		local prefs := GetAppPrefs(appSymbol, {named: nil});
		if IsInteger(prefs.keep) and prefs.keep >= 0 and prefs.keep < Length(kKeepNames) then prefs.keep
		else kKeepDefault;
	end,

	SetKeep: func(index)
	begin
		if not IsInteger(index) or index < 0 or index >= Length(kKeepNames) then return nil;
		local prefs := GetAppPrefs(appSymbol, {named: nil});
		prefs.keep := index;
		EntryChange(prefs);
		:Prune(true);
	end,

	// the messages older than Keep, and the oldest past kMessagesMax,
	// removed (not one still sending); force: whenever it was last done
	Prune: func(force)
	begin
		local now := Time();
		if not force and lastPrune and now - lastPrune < kPruneEvery then
			return nil;
		lastPrune := now;
		local soup := :Soup();
		if not soup then return nil;
		local minutes := kKeepMinutes[:KeepIndex()];
		local cutoff := if minutes then now - minutes;
		local cursor := Query(soup, {type: 'index, indexPath: 'time});
		local over := Max(0, cursor:CountEntries() - kMessagesMax);
		local doomed := [];
		local e;
		while e := cursor:Entry() do begin
			if not ((cutoff and e.time < cutoff) or Length(doomed) < over) then
				break;							// (oldest first: the rest are kept)
			if e.state <> 'sending then
				AddArraySlot(doomed, e);
			cursor:Next();
		end;
		foreach e in doomed do
			EntryRemoveFromSoupXmit(e, nil);
		if Length(doomed) > 0 then
			:Refresh();
		Length(doomed);
	end,

	// a key's first eight digits, as the node's id
	ShortKey: func(key) if StrLen(key) > 8 then SubStr(key, 0, 8) else key,

	/*----------------------------------------------------------------------
		Location
	----------------------------------------------------------------------*/

	// the GPS's fix, or nil (no GPS, or no fix yet)
	Fix: func()
	begin
		if not HostGPSAvailable() then return nil;
		local s := HostGPSStatus();
		if s and s.fix and s.latitude and s.longitude then s;
	end,

	ShareLocation: func() (GetAppPrefs(appSymbol, {named: nil})).shareLocation,

	SetShareLocation: func(on)
	begin
		local prefs := GetAppPrefs(appSymbol, {named: nil});
		prefs.shareLocation := if on then true else nil;
		EntryChange(prefs);
		:UpdateLocation(true);
		if on and :Fix() then
			HostMeshAdvertise();				// (the maps told at once)
	end,

	// the adverts' position: the fix's while Location in adverts is on, else
	// none; force: whenever it was last done
	UpdateLocation: func(force)
	begin
		local now := Ticks() div 60;
		if not force and locationAt and now - locationAt < kLocationEvery then
			return nil;
		locationAt := now;
		local fix := if :ShareLocation() then :Fix();
		if fix then
			HostMeshSetLocation(fix.latitude, fix.longitude)
		else
			HostMeshSetLocation(nil, nil);
	end,

	// a position as a message: the degrees, and a map link
	LocationText: func(fix)
	begin
		local lat := FormattedNumberStr(fix.latitude, "%.5f");
		local lon := FormattedNumberStr(fix.longitude, "%.5f");
		"My location: " & lat & ", " & lon & " https://maps.google.com/?q=" & lat & "," & lon;
	end,

	/*----------------------------------------------------------------------
		Channels
	----------------------------------------------------------------------*/

	// a channel's thread: "public" for Public, "ch:" & its name for another
	ChannelThread: func(name) if StrEqual(name, "Public") then kPublic else "ch:" & name,
	IsChannel: func(thread) IsString(thread) and (StrEqual(thread, kPublic) or BeginsWith(thread, "ch:")),
	ChannelOf: func(thread) if StrEqual(thread, kPublic) then "Public" else SubStr(thread, 3, StrLen(thread) - 3),

	// a channel's name as typed made one: spaces trimmed; a hashtag
	// channel's in small letters, as MeshCore's applications make them (its
	// secret is made from its name, so "#Melbourne" would be another
	// channel) ==> the name, or nil
	ChannelName: func(text)
	begin
		if not IsString(text) then return nil;
		local name := TrimString(Clone(text));
		if BeginsWith(name, "#") then
			name := Downcase(name);
		if StrLen(name) = 0 or StrEqual(name, "#") or StrLen(name) > 31 then nil else name;
	end,

	/*----------------------------------------------------------------------
		Saved contacts: Names cards with a mesh key
	----------------------------------------------------------------------*/

	// the custom field of the Names file labelled "Mesh Key": its slot
	// ('custom1 .. 'custom10), made - the first one with no label - when make
	MeshKeyPath: func(make)
	begin
		local cardfile := GetRoot().cardfile;
		if not cardfile then return nil;
		local info := cardfile:GetCustomInfo();
		if info then
			for i := 1 to 10 do begin
				local p := Intern("custom" & NumberStr(i));
				local f := info.(p);
				if f and IsString(f.label) and StrEqual(TrimString(Clone(f.label)), kMeshKeyLabel) then
					return p;
			end;
		if not make then return nil;
		local changed := if info then Clone(info) else {};
		for i := 1 to 10 do begin
			local p := Intern("custom" & NumberStr(i));
			local f := changed.(p);
			if not f or not IsString(f.label) or not StrFilled(TrimString(Clone(f.label))) then begin
				changed.(p) := {label: kMeshKeyLabel};
				cardfile:SetCustomInfo(changed);
				return p;
			end;
		end;
		nil;
	end,

	// text read as a key: 64 hex digits, spaces and colons between them let
	// be, in capitals as the engine has them - or nil
	NormalKey: func(text)
	begin
		if not IsString(text) then return nil;
		local digits := [];
		for i := 0 to StrLen(text) - 1 do begin
			local c := text[i];
			if (c >= $0 and c <= $9) or (c >= $A and c <= $F) or (c >= $a and c <= $f) then
				AddArraySlot(digits, c)
			else if c <> $  and c <> $: and c <> $\n and c <> $\t then
				return nil;
		end;
		if Length(digits) <> 64 then return nil;
		Upcase(Stringer(digits));
	end,

	// a meshcore:// contact link (MeshCore's apps share a contact as
	// meshcore://contact/add?name=...&public_key=...&type=1) ==> {name, key},
	// or nil when the text is not one
	ParseLink: func(text)
	begin
		if not IsString(text) or not StrPos(text, "public_key=", 0) then return nil;
		local key := :NormalKey(:LinkParam(text, "public_key="));
		if not key then return nil;
		{name: :LinkParam(text, "name="), key: key};
	end,

	// a link's parameter, its %XX and + decoded (nil: not there)
	LinkParam: func(text, param)
	begin
		local at := StrPos(text, param, 0);
		if not at then return nil;
		at := at + StrLen(param);
		local stop := StrPos(text, "&", at);
		local raw := SubStr(text, at, (if stop then stop else StrLen(text)) - at);
		local out := [];
		local i := 0;
		while i < StrLen(raw) do begin
			local c := raw[i];
			if c = $+ then
				AddArraySlot(out, $ )
			else if c = $% and i + 2 < StrLen(raw) then begin
				local n := :HexDigit(raw[i + 1]) * 16 + :HexDigit(raw[i + 2]);
				// (a byte above 127 is part of a UTF-8 letter: not decoded)
				AddArraySlot(out, if n >= 32 and n < 127 then Chr(n) else $?);
				i := i + 2;
			end else
				AddArraySlot(out, c);
			i := i + 1;
		end;
		Stringer(out);
	end,

	// a hex digit's value (-1000: not one, so that a sum of two is negative)
	HexDigit: func(c)
		if c >= $0 and c <= $9 then Ord(c) - Ord($0)
		else if c >= $A and c <= $F then Ord(c) - Ord($A) + 10
		else if c >= $a and c <= $f then Ord(c) - Ord($a) + 10
		else -1000,

	// a card's name as Names shows it
	CardName: func(e)
	begin
		local name := if e.name then GetRoot():bcFullName(e.name);
		if IsString(name) and StrFilled(name) then name
		else if IsString(e.company) and StrFilled(e.company) then e.company
		else "?";
	end,

	// the saved cards, read again when force or older than half a minute
	SavedCards: func(force)
	begin
		local now := Ticks() div 60;
		if saved and not force and savedAt and now - savedAt < 30 then
			return saved;
		local cards := {};
		local path := :MeshKeyPath(nil);
		local soup := GetUnionSoup("Names");
		if path and soup then begin
			local cursor := Query(soup, {type: 'index, validTest: func(e) IsString(e.(path)) and StrFilled(e.(path))});
			local e;
			while e := cursor:Entry() do begin
				local key := :NormalKey(e.(path));
				if key then
					cards.(Intern("k" & key)) := {key: key, name: :CardName(e), entry: e};
				cursor:Next();
			end;
		end;
		saved := cards;
		savedAt := now;
		cards;
	end,

	// a node's card, or nil
	SavedCard: func(key) if IsString(key) then (:SavedCards(nil)).(Intern("k" & key)),

	// the engine told which nodes are saved: every card's, and no other
	SyncSaved: func()
	begin
		local cards := :SavedCards(true);
		foreach c in cards do
			HostMeshSaveContact(c.key, c.name, true);
		local nodes := HostMeshContacts();
		if nodes then
			foreach n in nodes do
				if n.saved and not cards.(Intern("k" & n.key)) then
					HostMeshSaveContact(n.key, nil, nil);
	end,

	// a node saved as a new Names card (name: as heard, or given) ==> the card
	SaveNode: func(key, name)
	begin
		local card := :SavedCard(key);
		if card then return card.entry;
		local path := :MeshKeyPath(true);
		local cardfile := GetRoot().cardfile;
		if not path or not cardfile then begin
			GetRoot():Notify(3, "Mesh", "The Names file has no custom field free for the node's key.");
			return nil;
		end;
		if not IsString(name) or not StrFilled(TrimString(Clone(name))) then
			name := :NodeName(key);
		if not IsString(name) or not StrFilled(name) then
			name := :ShortKey(key);
		local frame := {name: {first: TrimString(Clone(name))}};
		frame.(path) := SetClass(Clone(key), '|string.custom|);
		local entry := cardfile:AddCard('person, frame);
		:SyncSaved();
		:Refresh();
		entry;
	end,

	// a node's name: its card's, or as last heard
	NodeName: func(key)
	begin
		local card := :SavedCard(key);
		if card then return card.name;
		local nodes := HostMeshContacts();
		if nodes then
			foreach n in nodes do
				if StrEqual(n.key, key) then
					return n.name;
		nil;
	end,

	Base: func()
	begin
		local base := GetRoot().(appSymbol);
		if base and base.viewCObject then base;
	end,

	Refresh: func()
	begin
		local base := :Base();
		if base then begin
			base:Reload();
			base:Redraw();
		end;
	end,

	// a message the mesh received
	Received: func(m)
	begin
		local thread := if m.channel then :ChannelThread(m.channel) else m.key;
		local entry := {class: '|meshMessage:host|, thread: thread,
			name: if m.channel then nil else m.name, sender: if m.channel then m.name else nil,
			text: m.text, time: if m.age then Time() - m.age else Time(), dir: 'incoming, state: 'unread};
		local base := :Base();
		local locked := :ScreenLocked();
		if base and base.currentThread and StrEqual(base.currentThread, thread) and not locked then
			entry.state := 'read;
		:Soup():AddToDefaultStoreXmit(entry, nil);
		:Refresh();
		// (the screen locked: the lock screen tells it)
		if base and not locked then
			PlaySound(@102)
		else
			:Tell(m, thread);
	end,

	/*----------------------------------------------------------------------
		The alert while the application is closed: one slip, kept up to
		date - the first message's sender and text, then how many are
		unread and the latest (the owner's ask, 2026-10-14: an alert each
		piled up, one over another); Show opens the application at the
		conversation (or the list, when they came from more than one)
	----------------------------------------------------------------------*/

	alertSlip: nil,
	alertCount: 0,
	alertThread: nil,						// (the conversation they all came from, or nil)
	alertTitle: nil, alertBody: nil,		// (what it says)

	Tell: func(m, thread)
	begin
		local from := if m.channel then m.channel else if StrFilled(m.name) then m.name else :ShortKey(thread);
		local card := if not m.channel then :SavedCard(thread);
		if card then from := card.name;
		local said := (if m.channel and StrFilled(m.name) then m.name & ": " else "") & m.text;
		alertThread := if alertCount = 0 or (alertThread and StrEqual(alertThread, thread)) then thread;
		alertCount := alertCount + 1;
		local title := if alertCount = 1 then "Mesh: " & from
			else "Mesh: " & NumberStr(alertCount) & " unread messages";
		local body := if alertCount = 1 then said else "The latest, " & from & ": " & said;
		if StrLen(body) > 140 then
			body := SubStr(body, 0, 139) & "…\u";
		alertTitle := title;
		alertBody := body;
		// (the screen locked: on the lock screen instead)
		if not (:ScreenLocked() and :NotifyLocked()) then
			:ShowAlert();
		PlaySound(@102);
	end,

	// the slip opened with what the alert says (or the one open changed)
	ShowAlert: func()
	begin
		if alertSlip and alertSlip.viewCObject then
			alertSlip:Show(alertTitle, alertBody)
		else begin
			// (protoFloatNGo centres itself across the screen: its left is an
			// offset from there)
			local box := GetRoot():LocalBox();
			local width := Min(box.right - box.left - 16, 260);
			alertSlip := BuildContext({_proto: alertTemplate, title: alertTitle, body: alertBody,
				viewBounds: RelBounds(0, box.top + 24, width, 104)});
			alertSlip:Open();
		end;
	end,

	// the slip gone (closed, or the application opened): the count begun again
	AlertClosed: func()
	begin
		alertSlip := nil;
		alertCount := 0;
		alertThread := nil;
		alertTitle := alertBody := nil;
		if GetGlobalFn('ScreenLockWithdraw) then
			call GetGlobalFn('ScreenLockWithdraw) with (appSymbol, 'unread);
	end,

	CloseAlert: func()
	begin
		if alertSlip and alertSlip.viewCObject then
			alertSlip:Close();
		:AlertClosed();
	end,

	// Show: the application open at the conversation, or its list
	ShowAlerted: func()
	begin
		local thread := alertThread;
		:CloseAlert();
		local base := GetRoot().(appSymbol);
		if not base then return nil;
		if not base.viewCObject then
			base:Open();
		if thread then
			base:OpenThread(thread)
		else
			base:ShowList();
	end,

	/*----------------------------------------------------------------------
		The lock screen (host/HostQuickSheet.h, docs/host-lock-screen.md):
		while the screen is locked, what the alert would say is left on
		the lock screen instead - one notification, kept up to date as
		the slip is (its key 'unread) - and the message is not taken as
		read, even with its conversation open behind the lock screen.  At
		the unlock the notification gives it back: tapped on the lock
		screen (Opened), Mesh opens at the conversation as the slip's
		Show does; otherwise (Unlocked) the slip comes up with it - or,
		Mesh open already, the open conversation takes in what came.
	----------------------------------------------------------------------*/

	ScreenLocked: func()
		GetGlobalFn('ScreenLockIsLocked) and call GetGlobalFn('ScreenLockIsLocked) with (),

	// what the alert says, on the lock screen (==> whether it is there)
	NotifyLocked: func()
		GetGlobalFn('ScreenLockNotify) and call GetGlobalFn('ScreenLockNotify) with (appSymbol,
			{key: 'unread, title: alertTitle, text: alertBody,
			 Opened: func() GetGlobalVar('|HostMesh:host|):ShowAlerted(),
			 Unlocked: func() GetGlobalVar('|HostMesh:host|):LockLifted()}),

	// the lock screen gone, its notification not tapped
	LockLifted: func()
	begin
		local base := GetRoot().(appSymbol);
		if base and base.viewCObject then begin
			local thread := alertThread;
			:CloseAlert();
			if thread and base.currentThread and StrEqual(base.currentThread, thread) then
				base:OpenThread(thread)
			else begin
				base:Reload();
				base:Redraw();
			end;
		end else if alertCount > 0 then
			:ShowAlert();
	end,

	alertTemplate: {
		_proto: @179,						// protoFloatNGo
		meshAlert: true,
		title: "", body: "",
		titleView: nil, bodyView: nil,
		viewSetupDoneScript: func()
		begin
			inherited:?viewSetupDoneScript();
			foreach v in :ChildViewFrames() do
				if v.role then
					self.(v.role) := v;
		end,
		viewQuitScript: func()
		begin
			titleView := bodyView := nil;
			GetGlobalVar('|HostMesh:host|):AlertClosed();
			inherited:?viewQuitScript();
		end,
		// (a later message: the same slip, its words changed)
		Show: func(newTitle, newBody)
		begin
			title := newTitle;
			body := newBody;
			if titleView then SetValue(titleView, 'text, newTitle);
			if bodyView then SetValue(bodyView, 'text, newBody);
		end,
		stepChildren: [
			{_proto: @218,					// protoStaticText
			 role: 'titleView,
			 viewBounds: {left: 10, top: 8, right: -30, bottom: 24}, viewJustify: 48,
			 viewFont: 1058816,
			 viewSetupFormScript: func()
			 begin
				text := :Parent().title;
				inherited:?viewSetupFormScript();
			 end},
			{_proto: @218,					// protoStaticText
			 role: 'bodyView,
			 viewBounds: {left: 10, top: 28, right: -10, bottom: 72}, viewJustify: 48,
			 viewFont: 10240,
			 viewSetupFormScript: func()
			 begin
				text := :Parent().body;
				inherited:?viewSetupFormScript();
			 end},
			{_proto: @226,					// protoTextButton
			 viewBounds: {left: -76, top: -28, right: -32, bottom: -10}, viewJustify: 8388774,
			 text: "Show",
			 buttonClickScript: func() GetGlobalVar('|HostMesh:host|):ShowAlerted()},
			{_proto: @166}					// protoClosebox (closing: AlertClosed)
		]
	},

	// a message sent: kept as 'sending, handed to the mesh
	SendText: func(thread, name, text)
	begin
		local channel := :IsChannel(thread);
		local id := if StrEqual(thread, kPublic) then HostMeshSendText(nil, text)
			else if channel then HostMeshSendChannelText(:ChannelOf(thread), text)
			else HostMeshSendText(thread, text);
		local entry := {class: '|meshMessage:host|, thread: thread, name: if channel then nil else name,
			text: text, time: Time(), dir: 'outgoing, state: if id then 'sending else 'failed, sendId: id};
		:Soup():AddToDefaultStoreXmit(entry, nil);
		pending := true;
		entry;
	end,

	pending: true,							// (messages 'sending to ask after: at boot, any left)

	// the poll: messages received, and how the sendings went
	Poll: func()
	begin
		local changed := nil;
		local m;
		// (each message filed on its own: one that cannot be is told on the
		// console and the rest still are, and the poll goes on - a throw
		// out of here would end the polling until the next restart)
		while m := HostMeshNextMessage() do begin
			try
				:Received(m)
			onexception |evt.ex| do
				Print("[mesh] a message from " & (if m.name then m.name else "?") & " could not be filed");
			changed := true;
		end;
		if pending then begin
			pending := nil;
			local soup := :Soup();
			if soup then begin
				local cursor := Query(soup, {type: 'index});
				local e;
				while e := cursor:Entry() do begin
					if e.state = 'sending then begin
						local state := if e.sendId then HostMeshSendState(e.sendId);
						if state = 'busy then
							pending := true
						else begin
							e.state := if state then state else 'failed;	// (nil: a sending from before a restart)
							EntryChangeXmit(e, nil);
							changed := true;
						end;
					end;
					cursor:Next();
				end;
			end;
		end;
		if changed then begin
			try
				:Refresh()
			onexception |evt.ex| do
				nil;
		end;
		try
			:Prune(nil)
		onexception |evt.ex| do
			nil;
		try
			:UpdateLocation(nil)
		onexception |evt.ex| do
			nil;
		AddDelayedCall(func() GetGlobalVar('|HostMesh:host|):Poll(), [], kPollMs);
	end,

	// an antenna and its waves, for the Extras drawer
	MakeIcon: func()
	begin
		local bitmap := MakeBitmap(28, 26, nil);
		DrawIntoBitmap([MakeLine(14, 10, 14, 25), MakeLine(9, 25, 19, 25)], {penSize: 2}, bitmap);
		DrawIntoBitmap([MakeOval(11, 7, 17, 13)], {penSize: 1, fillPattern: 5}, bitmap);
		// (the waves either side: two short strokes each)
		DrawIntoBitmap([MakeLine(8, 6, 6, 10), MakeLine(6, 10, 8, 14), MakeLine(20, 6, 22, 10), MakeLine(22, 10, 20, 14),
			MakeLine(4, 3, 1, 10), MakeLine(1, 10, 4, 17), MakeLine(24, 3, 27, 10), MakeLine(27, 10, 24, 17)], {penSize: 1}, bitmap);
		bitmap;
	end,

	Start: func()
	begin
		RegUnionSoup(appSymbol, {name: soupName, userName: "Mesh", ownerApp: appSymbol,
			ownerAppName: "Mesh", userDescr: "Mesh messages",
			indexes: [{structure: 'slot, path: 'time, type: 'int}]});
		if not GetRoot().(appSymbol) then
			GetRoot().(appSymbol) := BuildContext(app);
		// the node named after the owner, the first time (it may be named
		// again later; this is only so it is not "Newton" on the mesh)
		local prefs := GetAppPrefs(appSymbol, {named: nil});
		local owner := GetUserConfig('name);
		if not prefs.named and StrFilled(owner) then begin
			if HostMeshSetName(owner) then begin
				prefs.named := true;
				EntryChange(prefs);
			end;
		end;
		local extras := GetUnionSoup(@307.name);
		if extras then begin
			local cursor := Query(extras, {type: 'index});
			local e;
			local found := nil;
			while not found and (e := cursor:Entry()) do begin
				if e.app = appSymbol then found := e;
				cursor:Next();
			end;
			if not found then
				extras:AddToDefaultStoreXmit({class: 'ROMFormEntry, text: "Mesh", app: appSymbol,
					icon: :MakeIcon(), labels: nil, sequence: 31, _tagList: ['_icon, '_noBackup]}, nil);
		end;
		:Prune(true);
		try
			:UpdateLocation(true)
		onexception |evt.ex| do
			nil;
		try
			:SyncSaved()
		onexception |evt.ex| do
			nil;
		:Poll();
	end
}
