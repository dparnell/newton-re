// The host's link for the Newton Internet Enabler (comms/host/HostLink.h):
// a physical layer and a link layer service in the NIE's service registry
// (the global InetServices:NIE) and a "Host network" setup in its
// "Internet Setups" soup, so InetGrabLink connects over the host's own
// network.  This file is compiled into the host (HostLinkSource.cpp, made
// by src/cmake/EmbedText.cmake) and evaluated at boot; it answers the frame
// kept in the global HostLink:host.
//
// DEVIATION (owner's decision - docs/comms/README.md, "The link"): the
// NIE's services (enetsup.pkg's Ethernet and DHCP, modmsup.pkg's modem and
// PPP) load the NIE's native stack modules and drive the card or the modem;
// the host's network is always up, so each step the NIE's link state
// machine asks of these two succeeds at once.
//
// The protocol is the NIE's own, as its link state machine (inetenbl.pkg,
// 0x401f5's states) speaks it to a service - read with
// tools/newton-rom/analysis/pkgns.py:
//   service:InstantiateAndPerform(nil, 'Create, nil) makes the service's
//   instance; then instance:DoEvent(event, params) with
//     'SetCCE [cce], 'SetLinkEntry [entry]      (kept)
//     'LoadDriverProtocol [frame, symbol]       answered 'Loaded
//     'connect [frame, symbol]                  answered 'Connected
//     'EngageLinkProtocol [frame, symbol]       answered 'Engaged
//     'ProcessStackActive [frame, symbol]       answered 'Processed
//     'DisengageLinkProtocol [frame, symbol]    answered 'Disengaged
//     'Disconnect [frame, symbol]               answered 'Disconnected
//     'Cancel, 'Dispose, 'Abort                 (nothing to undo)
//   and instance:Release() when the link manager is done with it.
//   an answer being frame:symbol(InetBuildStatusFrame(linkID, status, nil,
//   nil, nil, nil)), as enetsup.pkg's Ethernet service answers 'connect
//   (0x10649).

{
	service: {
		fCCE: nil,
		fLinkEntry: nil,
		InstantiateAndPerform: func(parent, event, params)
		begin
			local instance := {_proto: self, fCCE: nil, fLinkEntry: nil};
			if event then
				instance:DoEvent(event, params);
			instance;
		end,
		DoEvent: func(event, params)
		begin
			if event = 'SetCCE then
				fCCE := params[0]
			else if event = 'SetLinkEntry then
				fLinkEntry := params[0]
			else begin
				local status := if event = 'LoadDriverProtocol then 'Loaded
					else if event = 'connect then 'Connected
					else if event = 'EngageLinkProtocol then 'Engaged
					else if event = 'ProcessStackActive then 'Processed
					else if event = 'DisengageLinkProtocol then 'Disengaged
					else if event = 'Disconnect then 'Disconnected;
				if status and params and params[0] then
					Perform(params[0], params[1],
						[InetBuildStatusFrame(if fLinkEntry then fLinkEntry.linkID, status, nil, nil, nil, nil)]);
			end;
			nil;
		end,
		// (the link manager's CleanUp, 0x4764d, releases each service's
		// instance after its Dispose, as protoFSM's Release frees a machine's
		// engine view: an instance here has none)
		Release: func() nil,
	},

	// the two services, made when the NIE is there
	Services: func()
	begin
		[{_proto: service, class: 'PhysicalService, symbol: '|HostNetwork:host|,
		  name: "Host network", description: "The host computer's own network"},
		 {_proto: service, class: 'LogicalService, symbol: '|HostLink:host|,
		  name: "Host", description: "The host computer's TCP/IP",
		  excludeFrom: []}];
	end,

	// What a Host network setup holds besides its names: the slots of an
	// Ethernet setup (Ethernet:NIE's blankEntry, inetstup.pkg 0x1cec9, which
	// its FillNewEntry, 0x1e751, deep-clones into a new setup), less the
	// card.  Internet Setup's editor reads them all - the generic
	// stationery's ValidateTarget (0x1a001), run when a setup is closed,
	// takes Length(entry.DNSServers) and so throws type.ref.frame (-48418)
	// on a setup without them; the pages' fields and verifyFuncs read
	// configuration, the three addresses and defaultDomain.  The NIE's
	// domain manager (inetenbl.pkg's connect.action, 0x37a0d) hands
	// defaultDomain and each valid address of DNSServers to the DNS tool
	// ('ddom, 'dnic).  The host's network configures itself, as a server
	// configures an Ethernet setup: 'usingServer.
	blankEntry: {configuration: 'usingServer,
		subnetMask: [0, 0, 0, 0],
		gatewayaddress: [0, 0, 0, 0],
		localAddress: [0, 0, 0, 0],
		defaultDomain: "",
		dnsServers: [[0, 0, 0, 0]]},

	// a setup's missing slots filled in from blankEntry (a setup made
	// before they were there); answers true when it added any
	FillMissing: func(entry)
	begin
		local added := nil;
		foreach slot, value in blankEntry do
			if not HasSlot(entry, slot) then begin
				entry.(slot) := DeepClone(value);
				added := true;
			end;
		added;
	end,

	// Internet Setup's stationery for the Host network setup.  The
	// application shows and edits a setup through the data definition named
	// by the entry's class - one per physical layer, its symbol the
	// layer's, registered by inetstup.pkg's parts (the Ethernet one,
	// 0x18e19, and the rest) - so the host registers one for its own layer,
	// made from Ethernet's (else another's) with the host's names and a
	// FillNewEntry that picks the host's two layers, and the prototype's
	// view definitions under its symbol, once Internet Setup's own are there.
	CheckStationery: func()
	begin
		local host := '|HostNetwork:host|;
		if GetDataDefs(host) then
			return nil;
		local base;
		foreach s in ['|Ethernet:NIE|, '|LocalTalk:NIE|, '|Modem:NIE|, '|Serial:NIE|] do
			if not base and GetDataDefs(s) then base := s;
		if not base then
			return nil;
		local views := GetDataDefs(base).viewsToDisplay;
		if IsArray(views) then begin
			local kept := [];
			foreach v in views do
				if v <> 'cardData then AddArraySlot(kept, v);
			views := kept;
		end;
		// (and the new setup's pages less the card's picker - a child whose
		// path starts with cardData, Ethernet's first page's third)
		local noCard := func(pages) if not IsArray(pages) then pages else begin
			local out := [];
			foreach page in pages do begin
				local children := [];
				foreach c in page.stepChildren do
					if not (IsArray(c.path) and Length(c.path) > 0 and c.path[0] = 'cardData) then
						AddArraySlot(children, c);
				AddArraySlot(out, {_proto: page, stepChildren: children});
			end;
			out;
		end;
		local blank := DeepClone(blankEntry);
		blank.linkLayer := '|HostLink:host|;
		RegDataDef(host, {_proto: GetDataDefs(base),
			symbol: host,
			name: "Host network",
			description: "Host network",
			helpText: "Use this to connect through the host computer's own network.",
			// (offered in the New Internet Setup's picker when the layer is
			// there, as the Ethernet one asks for its service)
			DependenciesLoaded: func() InetGetService('|HostNetwork:host|) <> nil,
			// (the fields the setup's pages show: the prototype's, less its
			// card - Ethernet's, 0x1cec9, has one; the host's network needs
			// none)
			viewsToDisplay: views,
			newEntryViews: call noCard with (GetDataDefs(base).newEntryViews),
			AlternateNewViews: call noCard with (GetDataDefs(base).AlternateNewViews),
			// (the prototype's FillNewEntry deep-clones blankEntry's slots
			// into a new setup - Ethernet's does, 0x1e751 - so the host's
			// are given it: its own and the link layer)
			blankEntry: blank,
			FillNewEntry: func(entry) begin
				inherited:?FillNewEntry(entry);
				GetGlobalVar('|HostLink:host|):FillMissing(entry);
				entry.setupName := "Host network";
				entry.physicalLayer := '|HostNetwork:host|;
				entry.linkLayer := '|HostLink:host|;
				entry;
			end});
		local viewDefs := GetViewDefs(base);
		if viewDefs then
			foreach vd in viewDefs do
				RegisterViewDef(vd, host);
		true;
	end,

	// once the NIE's service registry exists (its UnitsInstalledScript makes
	// it, when its packages' units are all there) and the host's services
	// are not in it yet: the services registered, the setup added unless it
	// is there already, and made the default link when there is none
	Check: func()
	begin
		// (once: a change to the packages while the host's services are
		// there - another package, the NIE's own removal - leaves the NIE
		// alone)
		:CheckStationery();
		local registry := GetGlobalVar('|InetServices:NIE|);
		if not registry or registry.|HostNetwork:host| then
			return nil;
		local physical, logical;
		foreach s in :Services() do begin
			registry.(s.symbol) := s;
			if s.class = 'PhysicalService then physical := s else logical := s;
		end;
		// (Internet Setup registers its soup when it is first opened -
		// newtSoup's, inetstup.pkg 0xe4e1 - and the NIE finds a setup by its
		// linkID index, so the host registers the same soup with the same
		// indexes: its tags index, which only the application's own filing
		// uses, comes with the application)
		RegUnionSoup('|HostLink:host|, {name: "Internet Setups", userName: "Internet Setups",
			ownerApp: '|InternetSetup:Newton|, userDescr: "The Internet Setup soup.",
			indexes: [{structure: 'slot, path: 'setupName, type: 'string},
			          {structure: 'slot, path: 'linkID, type: 'int}]});
		local soup := GetUnionSoupAlways("Internet Setups");
		// (every Host network setup - the first found is the host's own -
		// given the slots a setup made before they were there lacks)
		local cursor := soup:Query(nil);
		local entry := nil;
		local e := cursor:Entry();
		while e do begin
			if e.physicalLayer = physical.symbol then begin
				if :FillMissing(e) then
					EntryChangeXmit(e, '|HostLink:host|);
				if not entry then entry := e;
			end;
			e := cursor:Next();
		end;
		// (without the NIE's link manager, which InetStartUp would start:
		// a link id is the ticks, unique among the setups, as the manager's
		// MGetLinkUniqueID, 0x46ac9, makes one; the default link is the
		// user configuration's InetDefaultLink, which its
		// MSetLinkDefaultID, 0x466d9, sets)
		if not entry then begin
			local linkID := Ticks();
			while soup:Query({type: 'index, indexPath: 'linkID, beginKey: linkID, endKey: linkID}):Entry() do
				linkID := linkID + 1;
			entry := {class: physical.symbol, version: 2,
				linkID: linkID,
				setupName: "Host network",
				physicalLayer: physical.symbol,
				linkLayer: logical.symbol};
			:FillMissing(entry);
			soup:AddToDefaultStoreXmit(entry, '|HostLink:host|);
		end;
		if not GetUserConfig('InetDefaultLink) then
			SetUserConfig('InetDefaultLink, entry.linkID);
		entry.linkID;
	end,

	// the NIE's registry is looked for now, and again after each change to
	// the "Packages" soup (the NIE's own units wait on it, 0x16c5, and
	// then take a second: this takes two) - and two seconds from now: a
	// restart activates the store's packages just before this starts
	// (TNewtWorld::PreMain), so their changes to the soup have been and
	// gone, and the NIE makes its registry a second after them
	Start: func()
	begin
		RegSoupChange("Packages", '|HostLink:host|,
			func(soupName, appSymbol, changeType, changeData)
				AddProcrastinatedCall('|HostLink:host|, func() GetGlobalVar('|HostLink:host|):Check(), nil, 2000));
		:Check();
		AddProcrastinatedCall('|HostLink:host|, func() GetGlobalVar('|HostLink:host|):Check(), nil, 2000);
	end,
}
