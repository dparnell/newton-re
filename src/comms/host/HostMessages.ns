// Messages: text messages as conversations, for a host with a cellular
// module (comms/host/HostCellProvider.h starts it with the telephone
// provider and the text transport; compiled into the host as
// HostMessagesSource.cpp by src/cmake/EmbedText.cmake, evaluated at boot,
// the frame kept in the global HostMessages:host).
//
// DEVIATION (host addition): the ROM has no text messages.  The text
// transport (HostText.ns) hands each message it receives to this
// application - its appSymbol, which the In Box's AutoFunction sends
// AutoPutAway, as it does Notes a beamed note - and the application sends
// through the transport with Send (no routing slip), hidden from the Out
// Box, its ItemCompletionScript told how each sending ended.  The messages
// live in the soup "Messages:host" (a union soup, RegUnionSoup), one entry
// a message: {class: '|message:host|, thread, number, name, text, time,
// dir 'incoming/'outgoing, state 'unread/'read/'sending/'sent/'failed}; a
// conversation is the entries of one thread - a number's last eight digits,
// so "+61 412 ..." and "0412 ..." are one.
//
// The application is installed as a package's form part installs one
// (InstallFormPart: GetRoot().(appSymbol) := BuildContext(template)) and
// given an icon in the Extras drawer as the ROM's own applications have
// one (an entry of the Extras soup with app, text and an icon of its own).
//
// Any screen: nothing is laid out at a fixed size.  The application takes
// the area GetAppParams gives it (again when the screen turns:
// ReOrientToScreen) and Layout places its views in it; the conversation list
// and a conversation are drawn by the application itself, their rows and
// bubbles measured from the system fonts and the text, a bubble at most
// seven tenths of the width.  A screen at least kSideBySideWidth wide shows
// the list and the open conversation side by side; a narrower one shows one
// at a time.  The designs: docs/host-tdeck-pro-phone.md, "Messages".

{
	appSymbol: '|Messages:host|,
	soupName: "Messages:host",

	app: {
		viewClass: 74,							// clView
		viewFlags: 5,							// vVisible, vApplication
		viewFormat: 273,						// white, a one-pixel black frame
		viewBounds: {left: 0, top: 0, right: 240, bottom: 320},
		declareSelf: 'base,
		viewFont: 10240,						// (the system font: its views inherit it - a
												// picker sizes its label by it)
		appSymbol: '|Messages:host|,
		title: "Messages",
		ReOrientToScreen: func() :Relayout(),

		kSideBySideWidth: 400,
		kFont: 10240,							// the system font, 10 point
		kBold: 1058816,							// bold (face 1: 1 << 20)
		kSmall: 9216,							// 9 point

		// (the folder tab's: its picker the conversations - ConversationPicker -
		// not the folders; labelsFilter always '_all, which the tab looks at)
		appAll: "All Messages",
		labelsFilter: '_all,

		mode: 'list,							// 'list, 'thread or 'compose
		currentThread: nil,						// the thread shown
		selectedId: nil,						// (the message selected in it: its _uniqueID)
		threads: nil,							// the conversations, newest first
		listScroll: 0,							// conversations scrolled past
		threadScroll: 0,						// messages scrolled past, from the newest

		// (the child views, found by their role once they exist)
		folderTab: nil, headerView: nil, listView: nil, threadView: nil, replyLine: nil,
		sendButton: nil, toPicker: nil, statusBar: nil,
		replyLines: 1,							// (the lines its text wraps to, as last laid out)

		viewSetupFormScript: func()
		begin
			local p := GetAppParams();
			viewBounds := RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight);
		end,

		viewSetupDoneScript: func()
		begin
			foreach v in :ChildViewFrames() do
				if v.role then
					self.(v.role) := v;
			// the folder tab's picker: the conversations (the button's own
			// scripts, which its proto would find before the tab's)
			if folderTab and folderTab.showBarText then begin
				folderTab.showBarText.buttonClickScript := ConversationPicker;
				folderTab.showBarText.pickActionScript := ConversationPicked;
				folderTab.showBarText.pickThreads := nil;	// (the conversations it lists)
			end;
			// (the alert, if there is one, is done with: what it told is here)
			GetGlobalVar('|HostMessages:host|):CloseAlert();
			:Reload();
			:Layout();
		end,

		viewQuitScript: func()
		begin
			folderTab := headerView := listView := threadView := replyLine := sendButton := toPicker := statusBar := nil;
		end,

		Relayout: func()
		begin
			local p := GetAppParams();
			SetValue(self, 'viewBounds, RelBounds(p.appAreaLeft, p.appAreaTop, p.appAreaWidth, p.appAreaHeight));
			:Layout();
		end,

		// Every view placed in the application's area as it is now
		Layout: func()
		begin
			local box := :LocalBox();
			local w := box.right - box.left;
			local h := box.bottom - box.top;
			local barTop := h - (if statusBar then (statusBar:LocalBox()).bottom else 24);
			local headerH := FontHeight(kBold) + 6;			// (tight: a small screen)
			local wide := w >= kSideBySideWidth;
			local listW := if wide then Min(w * 2 div 5, 300) else w;
			local showList := wide or mode = 'list;
			local showThread := wide or mode <> 'list;
			local tx := if wide then listW + 1 else 0;
			// the folder tab across the top whatever is shown (the owner asked
			// for the top to stay the same over a conversation): the list or
			// the conversation's header under it
			local tabH := (folderTab:LocalBox()).bottom - 5;	// (over its button's last lines, which draw nothing)
			local sendW := StrFontWidth(sendButton.text, kBold) + 20;
			// the reply line as tall as its text wrapped (at most half the
			// conversation), the Send button beside its last line
			local spacing := :ReplySpacing();
			local maxLines := Max(1, (barTop - tabH - headerH) div 2 div spacing);
			replyLines := :ReplyLineCount(w - tx - sendW - 18);
			local replyH := FontHeight(kFont) + 14 + (Min(replyLines, maxLines) - 1) * spacing;
			folderTab:Show();
			if showThread then headerView:Show() else headerView:Hide();
			SetValue(headerView, 'viewBounds, RelBounds(tx, tabH, w - tx, headerH));
			SetValue(listView, 'viewBounds, RelBounds(0, tabH, listW, barTop - tabH));
			local threadTop := tabH + headerH;
			SetValue(threadView, 'viewBounds, RelBounds(tx, threadTop, w - tx, barTop - threadTop - replyH));
			SetValue(replyLine, 'viewBounds, RelBounds(tx + 6, barTop - replyH + 4, w - tx - sendW - 18, replyH - 8));
			local sendH := FontHeight(kFont) + 6;
			SetValue(sendButton, 'viewBounds, RelBounds(w - sendW - 6, barTop - 4 - sendH, sendW, sendH));
			local pickerH := 13;
			SetValue(toPicker, 'viewBounds, RelBounds(tx + 8, tabH + (headerH - pickerH) div 2, w - tx - 16, pickerH));
			if showList then listView:Show() else listView:Hide();
			if showThread then begin
				threadView:Show();
				replyLine:Show();
				sendButton:Show();
			end else begin
				threadView:Hide();
				replyLine:Hide();
				sendButton:Hide();
			end;
			toPicker:Hide();
			// (the tab's title: the conversation shown, or All Messages)
			if folderTab and folderTab.showBarText then
				folderTab.showBarText:SyncView();
			:Redraw();
		end,

		Redraw: func()
		begin
			if headerView then headerView:Dirty();
			if listView then listView:Dirty();
			if threadView then threadView:Dirty();
		end,

		/*------------------------------------------------------------------
			The messages
		------------------------------------------------------------------*/

		Soup: func() GetUnionSoup(GetGlobalVar('|HostMessages:host|).soupName),

		// the conversations, newest first: {thread, number, name, text, time, dir, state, unread}
		Reload: func()
		begin
			local byThread := {};
			local list := [];
			local soup := :Soup();
			if soup then begin
				local cursor := Query(soup, {type: 'index});
				local e;
				while e := cursor:Entry() do begin
					local key := Intern("t" & e.thread);
					local t := byThread.(key);
					if not t then begin
						t := {thread: e.thread, number: e.number, name: e.name, text: e.text, time: e.time,
							dir: e.dir, state: e.state, unread: 0};
						byThread.(key) := t;
						AddArraySlot(list, t);
					end else if e.time >= t.time then begin
						t.text := e.text; t.time := e.time; t.dir := e.dir; t.state := e.state;
						if e.name then t.name := e.name;
					end;
					if e.state = 'unread then
						t.unread := t.unread + 1;
					cursor:Next();
				end;
			end;
			threads := Sort(list, '|>|, 'time);
		end,

		// the messages of a thread, oldest first
		ThreadMessages: func(thread)
		begin
			local messages := [];
			local soup := :Soup();
			if soup then begin
				local cursor := Query(soup, {type: 'index});
				local e;
				while e := cursor:Entry() do begin
					if StrEqual(e.thread, thread) then
						AddArraySlot(messages, e);
					cursor:Next();
				end;
			end;
			Sort(messages, '|<|, 'time);
		end,

		ThreadFor: func(thread)
		begin
			foreach t in threads do
				if StrEqual(t.thread, thread) then
					return t;
			nil;
		end,

		OpenThread: func(thread)
		begin
			currentThread := thread;
			selectedId := nil;
			threadScroll := 0;
			mode := 'thread;
			// (read now)
			foreach e in :ThreadMessages(thread) do
				if e.state = 'unread then begin
					e.state := 'read;
					EntryChangeXmit(e, nil);
				end;
			:Reload();
			:Layout();
			if replyLine then SetKeyView(replyLine.entryLine, 0);
		end,

		// what the folder tab looks at: the application itself
		GetTargetInfo: func(reason)
			{target: nil, targetView: self, targetStore: GetDefaultStore()},

		// a conversation's name: its card's, or its number
		ThreadName: func(t) if t.name then t.name else t.number,

		// the conversation shown, if one is (the tab's title)
		ShownThread: func()
			if mode = 'thread and currentThread then :ThreadFor(currentThread),

		// The folder tab's picker (its button's buttonClickScript, self the
		// button): All Messages, then the conversations, newest first, the one
		// shown checked - in place of the ROM's folders and stores
		ConversationPicker: func()
		begin
			local shown := base:ShownThread();
			pickThreads := if base.threads then Clone(base.threads) else [];
			local items := [{item: base.appAll, mark: if shown then $  else $\uFC0B}];
			if Length(pickThreads) > 0 then
				AddArraySlot(items, 'pickseparator);
			foreach t in pickThreads do
				AddArraySlot(items, {item: base:ThreadName(t), mark: if shown and StrEqual(shown.thread, t.thread) then $\uFC0B else $ });
			DoPopup(items, 0, 2, self);
		end,

		// ... and its choice (its pickActionScript): the list, or a conversation
		ConversationPicked: func(index)
		begin
			local chosen := if index >= 2 and pickThreads and index - 2 < Length(pickThreads) then pickThreads[index - 2];
			pickThreads := nil;
			:hilite(nil);
			if chosen then
				base:OpenThread(chosen.thread)
			else if index = 0 then begin
				base.currentThread := nil;
				base:ShowList();
			end;
		end,

		ShowList: func()
		begin
			mode := 'list;
			selectedId := nil;
			:Reload();
			:Layout();
		end,

		Compose: func()
		begin
			mode := 'compose;
			currentThread := nil;
			threadScroll := 0;
			if toPicker then begin
				toPicker.selected := [];
				SetValue(toPicker, 'text, "To");
			end;
			:Layout();
		end,

		// the reply line's text sent to the conversation (or the To line's
		// recipients), and the line emptied
		// Deleting: a message tapped in the conversation is selected (drawn
		// inverted; tapped again, or another place, it is not); Delete
		// removes the selected message, or - nothing selected - the whole
		// conversation, once confirmed (AsyncConfirm).
		DeleteSelected: func()
		begin
			if not currentThread or (mode = 'list and (:LocalBox()).right < kSideBySideWidth) then begin
				GetRoot():Notify(3, "Messages", "Open a conversation to delete it, or tap one of its messages to delete just that message.");
				return nil;
			end;
			if selectedId then begin
				foreach e in :ThreadMessages(currentThread) do
					if e._uniqueID = selectedId then
						EntryRemoveFromSoupXmit(e, nil);
				selectedId := nil;
				:Reload();
				:Redraw();
				return true;
			end;
			local thread := currentThread;
			AsyncConfirm(:DeleteQuestion(thread),
				[{value: true, text: "Delete"}, {value: nil, text: "Cancel"}],
				func(confirmed) if confirmed then base:DeleteThread(thread));
		end,

		DeleteQuestion: func(thread)
		begin
			local t := :ThreadFor(thread);
			"Delete the conversation with " & (if t then :ThreadName(t) else "this number") & "?";
		end,

		// every message of a conversation removed
		DeleteThread: func(thread)
		begin
			foreach e in :ThreadMessages(thread) do
				EntryRemoveFromSoupXmit(e, nil);
			selectedId := nil;
			if StrEqual(currentThread, thread) then begin
				currentThread := nil;
				mode := 'list;
			end;
			:Reload();
			:Layout();
		end,

		SendTyped: func()
		begin
			local text := replyLine.entryLine.text;
			// (nothing to send: Send does nothing - StrFilled is only
			// "not empty", spaces count)
			if not text or StrLen(TrimString(Clone(text))) = 0 then
				return nil;
			local messages := GetGlobalVar('|HostMessages:host|);
			if mode = 'compose then begin
				local transport := GetRoot().|SMS:host|;
				local refs := if toPicker then toPicker.selected;
				local numbers := if refs and Length(refs) > 0 and transport then transport:ItemNumbers({toRef: refs});
				if not numbers or Length(numbers) = 0 then
					return nil;
				local name := GetDataDefs('|nameRef.phone|):GetRoutingInfo(refs[0])[0].name;
				foreach number in numbers do
					messages:SendText(number, name, text);
				SetValue(replyLine.entryLine, 'text, Clone(""));
				:ReplyChanged();
				:OpenThread(messages:ThreadKey(numbers[0]));
			end else if currentThread then begin
				// emptied first, so that the line is empty however the
				// sending goes
				SetValue(replyLine.entryLine, 'text, Clone(""));
				:ReplyChanged();
				local t := :ThreadFor(currentThread);
				if t then
					messages:SendText(t.number, t.name, text);
				:Reload();
				:Redraw();
			end;
		end,

		// the reply line's spacing between lines
		ReplySpacing: func()
			if replyLine and replyLine.entryLine and replyLine.entryLine.viewLineSpacing then
				replyLine.entryLine.viewLineSpacing
			else FontHeight(kFont) + 6,

		// how many lines the reply line's text wraps to in a line this wide
		// (its label's indent taken off; a little narrower than the
		// paragraph's own wrapping, so as to give a line too many rather
		// than one too few)
		ReplyLineCount: func(width)
		begin
			local entry := if replyLine then replyLine.entryLine;
			if not entry or not entry.text or StrLen(entry.text) = 0 then
				return 1;
			local font := if entry.viewFont then entry.viewFont else kFont;
			local textW := width - (if replyLine.indent then replyLine.indent else 0) - 8;
			Max(1, Length(:WrapText(entry.text, Max(textW, 20), font)));
		end,

		// the reply line's text changed: laid out again when it wraps to
		// more lines or fewer
		ReplyChanged: func()
		begin
			if not replyLine then return nil;
			local box := :LocalBox();
			local wide := box.right - box.left >= kSideBySideWidth;
			local tx := if wide then Min((box.right - box.left) * 2 div 5, 300) + 1 else 0;
			local sendW := StrFontWidth(sendButton.text, kBold) + 20;
			local lines := :ReplyLineCount(box.right - box.left - tx - sendW - 18);
			if lines <> replyLines then
				:Layout();
		end,

		// a To line's choice: its card's name, or the number
		RecipientName: func(ref)
		begin
			local info := GetDataDefs('|nameRef.phone|):GetRoutingInfo(ref);
			local name := if info and Length(info) > 0 then info[0].name;
			if StrFilled(name) then name else if IsFrame(ref) and ref.phone then ref.phone else "?";
		end,

		CallCurrent: func()
		begin
			local t := if currentThread then :ThreadFor(currentThread);
			if t then
				HostCellDial(t.number);
		end,

		// the transport's message handed to the application (the In Box's
		// AutoFunction): kept, the user told, the views brought up to date
		AutoPutaway: func(item)
		begin
			GetGlobalVar('|HostMessages:host|):Received(item);
		end,

		ItemCompletionScript: func(item)
		begin
			GetGlobalVar('|HostMessages:host|):Completed(item);
		end,

		viewScrollUpScript: func()
		begin
			if mode = 'list then listScroll := Max(0, listScroll - 1)
			else threadScroll := threadScroll + 1;
			:Redraw();
		end,

		viewScrollDownScript: func()
		begin
			if mode = 'list then listScroll := listScroll + 1
			else threadScroll := Max(0, threadScroll - 1);
			:Redraw();
		end,

		/*------------------------------------------------------------------
			Drawing helpers (the application's own: any size)
		------------------------------------------------------------------*/

		Diamond: func(x, y, r) MakePolygon([x, y - r, x + r, y, x, y + r, x - r, y]),

		// the text in lines no wider than width in font
		WrapText: func(text, width, font)
		begin
			local lines := [];
			local paragraphs := :Split(text, $\n);
			foreach paragraph in paragraphs do begin
				local line := "";
				foreach word in :Split(paragraph, $ ) do begin
					local tryLine := if StrLen(line) = 0 then word else line & " " & word;
					if StrFontWidth(tryLine, font) <= width then
						line := tryLine
					else begin
						if StrLen(line) > 0 then
							AddArraySlot(lines, line);
						// (a word wider than a line, broken where it must be)
						line := word;
						while StrFontWidth(line, font) > width and StrLen(line) > 1 do begin
							local n := StrLen(line) - 1;
							while n > 1 and StrFontWidth(SubStr(line, 0, n), font) > width do
								n := n - 1;
							AddArraySlot(lines, SubStr(line, 0, n));
							line := SubStr(line, n, StrLen(line) - n);
						end;
					end;
				end;
				AddArraySlot(lines, line);
			end;
			lines;
		end,

		// "2:38 PM" today, "Yesterday", the date before
		WhenText: func(time)
		begin
			if not time then return "";
			local today := Time() div 1440;
			local day := time div 1440;
			if day = today then :TimeText(time)
			else if day = today - 1 then "Yesterday"
			else ShortDate(time);
		end,

		// "2:38 PM"
		TimeText: func(time)
		begin
			local minutes := time mod 1440;
			local hour := minutes div 60;
			local minute := minutes mod 60;
			local suffix := if hour >= 12 then " PM" else " AM";
			hour := hour mod 12;
			if hour = 0 then hour := 12;
			NumberStr(hour) & ":" & (if minute < 10 then "0" else "") & NumberStr(minute) & suffix;
		end,

		DayText: func(time)
		begin
			local today := Time() div 1440;
			local day := time div 1440;
			if day = today then "Today" else if day = today - 1 then "Yesterday" else ShortDate(time);
		end,

		stepChildren: [
			// the folder tab, the clock beside it, as the Extras drawer's
			// (protoClockFolderTab: its picker the conversations - the
			// button given ConversationPicker in viewSetupDoneScript)
			{
				_proto: @670,						// protoClockFolderTab (on protoNewFolderTab @669, on @211)
				role: 'folderTab,
				// its title the conversation shown, or All Messages (in place of
				// @669's RedoText - the folder - placed as @669 places it; self
				// is the button, whose viewSetupFormScript calls it)
				RedoText: func()
				begin
					local t := base:ShownThread();
					local text := Stringer([$\uFC01, if t then base:ThreadName(t) else base.appAll]);
					showBarText.text := StrTruncate(text, 137);
					showBarText.width := StrFontWidth(showBarText.text, showBarText.viewFont) + 16;
					showBarText.viewBounds := SetBounds(-showBarText.width - 4, 3, -4, 17);
					showBarText.viewJustify := 8388646;
					:Dirty();
				end
			},

			// the header over a conversation: its name and number - a new
			// message's To line (the folder tab is a view of its own: Layout)
			{
				viewClass: 74, viewFlags: 513, viewFormat: 0, role: 'headerView,
				viewBounds: {left: 0, top: 0, right: 240, bottom: 24},
				viewDrawScript: func()
				begin
					local b := :LocalBox();
					local w := b.right;
					local h := b.bottom;
					local base := :Parent();
					:DrawShape(MakeLine(0, h - 1, w, h - 1), {penSize: 1});
					// (each text in a box its font's height, near the top - more
					// room under it, against the conversation, than over it; the
					// number and the diamond lined up with the name)
					local bh := FontHeight(base.kBold);
					local bt := 1;
					local sh := FontHeight(base.kSmall);
					local st := bt + bh - sh;
					// a new message's To line: tapped, the Names file's picker (the
					// address picker's own, which is kept hidden: on the host its
					// label came out half drawn)
					if base.mode = 'compose then begin
						local sel := base.toPicker.selected;
						local who := if sel and Length(sel) > 0 then base:RecipientName(sel[0]) else "Choose a name";
						:DrawShape(MakeText("To", 8, bt, 30, bt + bh), {font: base.kBold});
						:DrawShape(base:Diamond(38, bt + bh div 2, 4), {penPattern: 0, fillPattern: 5});
						:DrawShape(MakeText(StyledStrTruncate(who, w - 60, base.kBold), 48, bt, w, bt + bh), {font: base.kBold});
					end;
					local t := if base.currentThread then base:ThreadFor(base.currentThread);
					if t and base.mode = 'thread then begin
						:DrawShape(base:Diamond(12, bt + bh div 2, 4), {penPattern: 0, fillPattern: 5});
						local name := if t.name then t.name else t.number;
						local nw := if t.name then StrFontWidth(t.number, base.kSmall) else 0;
						:DrawShape(MakeText(StyledStrTruncate(name, w - nw - 40, base.kBold), 22, bt, w - nw - 12, bt + bh), {font: base.kBold});
						if t.name then
							:DrawShape(MakeText(t.number, w - nw - 8, st, w, st + sh), {font: base.kSmall});
					end;
				end,
				// the header's name: back to the list on a narrow screen
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					if base.mode = 'compose then
						base.toPicker:DoOpenPicker()
					else if base.mode <> 'list and (base:LocalBox()).right < base.kSideBySideWidth then
						base:ShowList();
					true;
				end
			},

			// the conversations
			{
				viewClass: 74, viewFlags: 513, viewFormat: 0, role: 'listView,
				viewBounds: {left: 0, top: 24, right: 240, bottom: 300},
				RowHeight: func() FontHeight(:Parent().kBold) + FontHeight(:Parent().kFont) + 16,
				viewDrawScript: func()
				begin
					local base := :Parent();
					local b := :LocalBox();
					local w := b.right;
					local rowH := :RowHeight();
					if not base.threads or Length(base.threads) = 0 then begin
						:DrawShape(MakeText("No messages yet.", 12, 16, w - 12, 40), {font: base.kFont});
						:DrawShape(MakeText("Tap New to write one.", 12, 16 + FontHeight(base.kFont) + 4, w - 12, 80), {font: base.kFont});
						return;
					end;
					local y := 0;
					local i := base.listScroll;
					while i < Length(base.threads) and y < b.bottom do begin
						local t := base.threads[i];
						local selected := (base:LocalBox()).right >= base.kSideBySideWidth and base.currentThread and StrEqual(base.currentThread, t.thread);
						if selected then
							:DrawShape(MakeRect(0, y, w, y + rowH), {penPattern: 0, fillPattern: 5});
						local ink := if selected then 1 else 5;
						if t.unread > 0 then
							:DrawShape(base:Diamond(10, y + 10, 4), {penPattern: 0, fillPattern: ink});
						local name := if t.name then t.name else t.number;
						local when := base:WhenText(t.time);
						local whenW := StrFontWidth(when, base.kSmall);
						local nameRoom := w - whenW - 30;
						:DrawShape(MakeText(StyledStrTruncate(name, nameRoom, base.kBold), 20, y + 4, w - whenW - 10, y + 4 + FontHeight(base.kBold)),
							{font: base.kBold, transferMode: if selected then 3 else 0});
						:DrawShape(MakeText(when, w - whenW - 6, y + 6, w, y + 6 + FontHeight(base.kSmall)),
							{font: base.kSmall, transferMode: if selected then 3 else 0});
						local snippet := (if t.dir = 'outgoing then (if t.state = 'failed then "You: Not sent - " else "You: ") else "")
							& base:Flatten(t.text);
						:DrawShape(MakeText(StyledStrTruncate(snippet, w - 26, if t.unread > 0 then base.kBold else base.kFont), 20,
								y + 8 + FontHeight(base.kBold), w - 6, y + rowH - 3),
							{font: if t.unread > 0 then base.kBold else base.kFont, transferMode: if selected then 3 else 0});
						:DrawShape(MakeLine(4, y + rowH - 1, w - 4, y + rowH - 1), {penSize: 1, penPattern: 3});
						y := y + rowH;
						i := i + 1;
					end;
				end,
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					local y := GetPoint(5, unit) - (:GlobalBox()).top;
					local i := base.listScroll + y div :RowHeight();
					if base.threads and i < Length(base.threads) then
						base:OpenThread(base.threads[i].thread);
					true;
				end
			},

			// a conversation
			{
				viewClass: 74, viewFlags: 545, viewFormat: 0, role: 'threadView,	// (vClipping: older bubbles cut at its top, not over the header)
				viewBounds: {left: 0, top: 24, right: 240, bottom: 270},
				viewDrawScript: func()
				begin
					local base := :Parent();
					local b := :LocalBox();
					local w := b.right;
					local h := b.bottom;
					if (base:LocalBox()).right >= base.kSideBySideWidth then
						:DrawShape(MakeLine(0, 0, 0, h), {penSize: 1});
					if not base.currentThread then begin
						if base.mode <> 'compose then
							:DrawShape(MakeText("Choose a conversation.", 12, 16, w - 12, 40), {font: base.kFont});
						return;
					end;
					local messages := base:ThreadMessages(base.currentThread);
					local font := base.kFont;
					local small := base.kSmall;
					local lineH := FontHeight(font);
					local smallH := FontHeight(small);
					local maxBubble := w * 7 div 10;
					local y := h - 6;
					hits := [];
					local i := Length(messages) - 1 - base.threadScroll;
					local newerDay := nil;
					while i >= 0 and y > 0 do begin
						local m := messages[i];
						local day := m.time div 1440;
						if newerDay and day <> newerDay then begin
							y := :DaySeparator(y, w, messages[i + 1].time);
						end;
						newerDay := day;
						local lines := base:WrapText(m.text, maxBubble - 16, font);
						local textW := 0;
						foreach line in lines do
							textW := Max(textW, StrFontWidth(line, font));
						local bubbleW := textW + 16;
						local bubbleH := Length(lines) * lineH + 10;
						local out := m.dir = 'outgoing;
						local meta := if out then (if m.state = 'failed then "Not sent"
							else if m.state = 'sending then "Sending" else "Sent " & base:WhenText(m.time))
							else base:WhenText(m.time);
						y := y - smallH;
						local metaW := StrFontWidth(meta, small);
						local mx := if out then w - metaW - 8 else 8;
						:DrawShape(MakeText(meta, mx, y, mx + metaW + 2, y + smallH), {font: small});
						y := y - bubbleH - 4;
						local left := if out then w - bubbleW - 10 else 6;
						// (the selected one inverted: Delete removes it)
						local chosen := base.selectedId and m._uniqueID = base.selectedId;
						AddArraySlot(hits, {left: left, top: y, right: left + bubbleW, bottom: y + bubbleH, id: m._uniqueID});
						if out then
							:DrawShape(MakeRoundRect(left + 3, y + 3, left + bubbleW + 3, y + bubbleH + 3, 6), {penPattern: 0, fillPattern: 5});
						:DrawShape(MakeRoundRect(left, y, left + bubbleW, y + bubbleH, 6), {penSize: 1, penPattern: 5, fillPattern: if chosen then 5 else 1});
						local ty := y + 5;
						foreach line in lines do begin
							:DrawShape(MakeText(line, left + 8, ty, left + bubbleW, ty + lineH), {font: font, transferMode: if chosen then 3 else 0});
							ty := ty + lineH;
						end;
						y := y - 8;
						i := i - 1;
					end;
					if i < 0 and newerDay then
						:DaySeparator(y, w, messages[0].time);
				end,
				// (the bubbles as last drawn, for a tap to find: {left, top,
				// right, bottom, id})
				hits: nil,
				viewClickScript: func(unit)
				begin
					local base := :Parent();
					local box := :GlobalBox();
					local x := GetPoint(4, unit) - box.left;
					local y := GetPoint(5, unit) - box.top;
					local hit := nil;
					if hits then
						foreach h in hits do
							if x >= h.left and x < h.right and y >= h.top and y < h.bottom then
								hit := h.id;
					base.selectedId := if hit and hit <> base.selectedId then hit else nil;
					:Dirty();
					true;
				end,
				DaySeparator: func(y, w, time)
				begin
					local base := :Parent();
					local label := base:DayText(time);
					local lw := StrFontWidth(label, base.kSmall);
					local sh := FontHeight(base.kSmall);
					local top := y - sh - 2;
					local cy := top + sh div 2;
					:DrawShape(MakeLine(8, cy, (w - lw) div 2 - 6, cy), {penSize: 1, penPattern: 3});
					:DrawShape(MakeLine((w + lw) div 2 + 6, cy, w - 8, cy), {penSize: 1, penPattern: 3});
					:DrawShape(MakeText(label, (w - lw) div 2, top, (w + lw) div 2 + 2, top + sh), {font: base.kSmall});
					top - 8;
				end
			},

			// the To line of a new message: the Names file's numbers
			{
				_proto: @259,						// protoAddressPicker
				role: 'toPicker,
				viewJustify: 0,						// (its proto's is full width: Layout gives its bounds)
				viewBounds: {left: 30, top: 4, right: 230, bottom: 20},
				text: "To",
				class: '|nameRef.phone|,
				selected: nil,
				alternatives: nil,
				useMemory: nil,
				pickActionScript: func(index)
				begin
					inherited:?pickActionScript(index);
					:Parent():Redraw();
				end
			},

			// the reply line and its Send button
			{
				_proto: @189,						// protoLabelInputLine
				role: 'replyLine,
				viewBounds: {left: 6, top: 270, right: 180, bottom: 290},
				label: "Reply",
				labelFont: 1058816,
				entryFont: 10240,
				// the entry wraps (the proto's is one line only), the
				// reply area growing to fit it
				viewSetupChildrenScript: func()
				begin
					inherited:viewSetupChildrenScript();
					if BAnd(entryLine.viewJustify, 0x800000) <> 0 then
						entryLine.viewJustify := entryLine.viewJustify - 0x800000;
				end,
				textChanged: func()
				begin
					inherited:?textChanged();
					base:ReplyChanged();
				end
			},
			{
				_proto: @226,						// protoTextButton
				role: 'sendButton,
				viewBounds: {left: 190, top: 270, right: 234, bottom: 290},
				text: "Send",
				buttonClickScript: func() :Parent():SendTyped()
			},

			// the status bar: New, All (back to the list), Call, Delete; the close box
			{
				_proto: @73,						// protoStatusBar
				role: 'statusBar,
				menuLeftButtons: [
					{_proto: @226, text: "New", buttonClickScript: func() base:Compose()},
					{_proto: @226, text: "All", buttonClickScript: func() base:ShowList()},
					{_proto: @226, text: "Call", buttonClickScript: func() base:CallCurrent()},
					{_proto: @226, text: "Delete", buttonClickScript: func() base:DeleteSelected()}
				],
				menuRightButtons: [
					{_proto: @166}					// protoClosebox
				]
			}
		],

		// the text in pieces between each separator (one empty piece for none)
		Split: func(text, separator)
		begin
			local pieces := [];
			local start := 0;
			for i := 0 to StrLen(text) - 1 do
				if text[i] = separator then begin
					if i > start then
						AddArraySlot(pieces, SubStr(text, start, i - start));
					start := i + 1;
				end;
			if StrLen(text) > start then
				AddArraySlot(pieces, SubStr(text, start, StrLen(text) - start));
			if Length(pieces) = 0 then
				AddArraySlot(pieces, "");
			pieces;
		end,

		Flatten: func(text)
		begin
			local flat := Clone(text);
			for i := 0 to StrLen(flat) - 1 do
				if flat[i] = $\n then flat[i] := $ ;
			flat;
		end
	},

	/*----------------------------------------------------------------------
		The application's work outside its views
	----------------------------------------------------------------------*/

	// a number's last eight digits: the conversation it belongs to
	ThreadKey: func(number)
	begin
		local digits := "";
		for i := 0 to StrLen(number) - 1 do begin
			local c := number[i];
			if c >= $0 and c <= $9 then
				digits := digits & c;
		end;
		if StrLen(digits) > 8 then SubStr(digits, StrLen(digits) - 8, 8) else digits;
	end,

	Soup: func() GetUnionSoup(soupName),

	// a message the transport received
	Received: func(item)
	begin
		local number := if item.smsNumber then item.smsNumber else "";
		local text := if item.smsText then item.smsText else "";
		local entry := {class: '|message:host|, thread: :ThreadKey(number), number: number,
			name: item.smsName, text: text, time: if item.timestamp then item.timestamp else Time(),
			dir: 'incoming, state: 'unread};
		local base := GetRoot().(appSymbol);
		local locked := :ScreenLocked();
		if base and base.viewCObject and base.currentThread and StrEqual(base.currentThread, entry.thread) and not locked then
			entry.state := 'read;
		:Soup():AddToDefaultStoreXmit(entry, nil);
		if base and base.viewCObject then begin
			base:Reload();
			base:Redraw();
		end;
		// (the user told: an alert, or - Messages open - the list or the
		// conversation shows it, and a beep says so; the screen locked, the
		// lock screen tells it)
		if base and base.viewCObject and not locked then
			PlaySound(@102)
		else
			:Tell(entry);
		true;
	end,

	/*----------------------------------------------------------------------
		The alert while the application is closed: one slip, kept up to
		date - the first message's sender and text, then how many are
		unread and the latest (the owner's ask, 2026-10-14, as Mesh's:
		Notify piled an alert on an alert); Show opens the application at
		the conversation (or the list, when they came from more than one)
	----------------------------------------------------------------------*/

	alertSlip: nil,
	alertCount: 0,
	alertThread: nil,						// (the conversation they all came from, or nil)
	alertTitle: nil, alertBody: nil,		// (what it says)

	Tell: func(entry)
	begin
		local from := if entry.name then entry.name else entry.number;
		alertThread := if alertCount = 0 or (alertThread and StrEqual(alertThread, entry.thread)) then entry.thread;
		alertCount := alertCount + 1;
		local title := if alertCount = 1 then "Text from " & from
			else "Messages: " & NumberStr(alertCount) & " unread";
		local body := if alertCount = 1 then entry.text else "The latest, from " & from & ": " & entry.text;
		if StrLen(body) > 140 then
			body := SubStr(body, 0, 139) & "…\u";
		alertTitle := title;
		alertBody := body;
		// (the screen locked: on the lock screen instead)
		if not (:ScreenLocked() and :NotifyLocked()) then
			:ShowAlert();
		PlaySound(@102);
	end,

	// the slip opened with what the alert says (or the one open changed)
	ShowAlert: func()
	begin
		if alertSlip and alertSlip.viewCObject then
			alertSlip:Show(alertTitle, alertBody)
		else begin
			// (protoFloatNGo centres itself across the screen: its left is an
			// offset from there)
			local box := GetRoot():LocalBox();
			local width := Min(box.right - box.left - 16, 260);
			alertSlip := BuildContext({_proto: alertTemplate, title: alertTitle, body: alertBody,
				viewBounds: RelBounds(0, box.top + 24, width, 104)});
			alertSlip:Open();
		end;
	end,

	// the slip gone (closed, or the application opened): the count begun again
	AlertClosed: func()
	begin
		alertSlip := nil;
		alertCount := 0;
		alertThread := nil;
		alertTitle := alertBody := nil;
		if GetGlobalFn('ScreenLockWithdraw) then
			call GetGlobalFn('ScreenLockWithdraw) with (appSymbol, 'unread);
	end,

	CloseAlert: func()
	begin
		if alertSlip and alertSlip.viewCObject then
			alertSlip:Close();
		:AlertClosed();
	end,

	// Show: the application open at the conversation, or its list
	ShowAlerted: func()
	begin
		local thread := alertThread;
		:CloseAlert();
		local base := GetRoot().(appSymbol);
		if not base then return nil;
		if not base.viewCObject then
			base:Open();
		if thread then
			base:OpenThread(thread)
		else
			base:ShowList();
	end,

	/*----------------------------------------------------------------------
		The lock screen (host/HostQuickSheet.h, docs/host-lock-screen.md):
		while the screen is locked, what the alert would say is left on
		the lock screen instead - one notification, kept up to date as
		the slip is (its key 'unread) - and the message is not taken as
		read, even with its conversation open behind the lock screen.  At
		the unlock the notification gives it back: tapped on the lock
		screen (Opened), Messages opens at the conversation as the slip's
		Show does; otherwise (Unlocked) the slip comes up with it - or,
		Messages open already, the open conversation takes in what came.
	----------------------------------------------------------------------*/

	ScreenLocked: func()
		GetGlobalFn('ScreenLockIsLocked) and call GetGlobalFn('ScreenLockIsLocked) with (),

	// what the alert says, on the lock screen (==> whether it is there)
	NotifyLocked: func()
		GetGlobalFn('ScreenLockNotify) and call GetGlobalFn('ScreenLockNotify) with (appSymbol,
			{key: 'unread, title: alertTitle, text: alertBody,
			 Opened: func() GetGlobalVar('|HostMessages:host|):ShowAlerted(),
			 Unlocked: func() GetGlobalVar('|HostMessages:host|):LockLifted()}),

	// the lock screen gone, its notification not tapped
	LockLifted: func()
	begin
		local base := GetRoot().(appSymbol);
		if base and base.viewCObject then begin
			local thread := alertThread;
			:CloseAlert();
			if thread and base.currentThread and StrEqual(base.currentThread, thread) then
				base:OpenThread(thread)
			else begin
				base:Reload();
				base:Redraw();
			end;
		end else if alertCount > 0 then
			:ShowAlert();
	end,

	alertTemplate: {
		_proto: @179,						// protoFloatNGo
		messagesAlert: true,
		title: "", body: "",
		titleView: nil, bodyView: nil,
		viewSetupDoneScript: func()
		begin
			inherited:?viewSetupDoneScript();
			foreach v in :ChildViewFrames() do
				if v.role then
					self.(v.role) := v;
		end,
		viewQuitScript: func()
		begin
			titleView := bodyView := nil;
			GetGlobalVar('|HostMessages:host|):AlertClosed();
			inherited:?viewQuitScript();
		end,
		// (a later message: the same slip, its words changed)
		Show: func(newTitle, newBody)
		begin
			title := newTitle;
			body := newBody;
			if titleView then SetValue(titleView, 'text, newTitle);
			if bodyView then SetValue(bodyView, 'text, newBody);
		end,
		stepChildren: [
			{_proto: @218,					// protoStaticText
			 role: 'titleView,
			 viewBounds: {left: 10, top: 8, right: -30, bottom: 24}, viewJustify: 48,
			 viewFont: 1058816,
			 viewSetupFormScript: func()
			 begin
				text := :Parent().title;
				inherited:?viewSetupFormScript();
			 end},
			{_proto: @218,					// protoStaticText
			 role: 'bodyView,
			 viewBounds: {left: 10, top: 28, right: -10, bottom: 72}, viewJustify: 48,
			 viewFont: 10240,
			 viewSetupFormScript: func()
			 begin
				text := :Parent().body;
				inherited:?viewSetupFormScript();
			 end},
			{_proto: @226,					// protoTextButton
			 viewBounds: {left: -76, top: -28, right: -32, bottom: -10}, viewJustify: 8388774,
			 text: "Show",
			 buttonClickScript: func() GetGlobalVar('|HostMessages:host|):ShowAlerted()},
			{_proto: @166}					// protoClosebox (closing: AlertClosed)
		]
	},

	// a message sent: kept as 'sending, handed to the transport (Send: the Out
	// Box, hidden, its completion told to ItemCompletionScript)
	SendText: func(number, name, text)
	begin
		local entry := :Soup():AddToDefaultStoreXmit({class: '|message:host|, thread: :ThreadKey(number),
			number: number, name: name, text: text, time: Time(), dir: 'outgoing, state: 'sending}, nil);
		local transport := GetRoot().|SMS:host|;
		if not transport then begin
			entry.state := 'failed;
			EntryChangeXmit(entry, nil);
			return entry;
		end;
		local item := transport:NewItem(nil);
		local recipient := GetDataDefs('|nameRef.phone|):MakeNameRef({}, '|nameRef.phone|);
		recipient.phone := number;
		item.appSymbol := appSymbol;
		item.body := text;
		item.toRef := [recipient];
		item.title := "Text to " & (if name then name else number);
		item.completionScript := true;
		item.hidden := true;
		item.messageEntry := MakeEntryAlias(entry);
		item.Connect := true;
		Send(transport.appSymbol, item);
		entry;
	end,

	// how a sending ended: the message 'sent or 'failed (==> true: the Out Box
	// keeps nothing of it)
	Completed: func(item)
	begin
		local entry := if item.messageEntry then ResolveEntryAlias(item.messageEntry);
		if entry then begin
			entry.state := if item.state = 'sent and not item.error then 'sent else 'failed;
			EntryChangeXmit(entry, nil);
			local base := GetRoot().(appSymbol);
			if base and base.viewCObject then begin
				base:Reload();
				base:Redraw();
			end;
		end;
		true;
	end,

	// a speech bubble for the Extras drawer
	MakeIcon: func()
	begin
		local bitmap := MakeBitmap(28, 26, nil);
		DrawIntoBitmap([MakeRoundRect(1, 1, 27, 19, 6), MakePolygon([7, 18, 7, 25, 14, 18])],
			{penSize: 2, penPattern: 5, fillPattern: 1}, bitmap);
		DrawIntoBitmap([MakeLine(7, 8, 21, 8), MakeLine(7, 12, 17, 12)], {penSize: 1}, bitmap);
		bitmap;
	end,

	Start: func()
	begin
		RegUnionSoup(appSymbol, {name: soupName, userName: "Messages", ownerApp: appSymbol,
			ownerAppName: "Messages", userDescr: "Text messages",
			indexes: [{structure: 'slot, path: 'time, type: 'int}]});
		// the application, as a package's form part installs one
		if not GetRoot().(appSymbol) then
			GetRoot().(appSymbol) := BuildContext(app);
		// its icon in the Extras drawer, once
		local extras := GetUnionSoup(@307.name);
		if extras then begin
			local cursor := Query(extras, {type: 'index});
			local e;
			local found := nil;
			while not found and (e := cursor:Entry()) do begin
				if e.app = appSymbol then found := e;
				cursor:Next();
			end;
			// (as the ROM's own: its class, and the tags the drawer lists by -
			// '_icon - and the backup leaves alone)
			if not found then
				extras:AddToDefaultStoreXmit({class: 'ROMFormEntry, text: "Messages", app: appSymbol,
					icon: :MakeIcon(), labels: nil, sequence: 30, _tagList: ['_icon, '_noBackup]}, nil)
			else if not found._tagList then begin
				found.class := 'ROMFormEntry;
				found._tagList := ['_icon, '_noBackup];
				EntryChangeXmit(found, nil);
			end;
		end;
	end
}
