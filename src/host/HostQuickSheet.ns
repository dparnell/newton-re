// The quick sheet and the lock screen (host/HostQuickSheet.h).  This file is
// compiled into the program (HostQuickSheetSource.cpp, made by
// src/cmake/EmbedText.cmake) and evaluated at boot by HostInstallQuickSheet;
// it answers the frame kept in the global QuickSheet:host.
//
// The sheet: pulled down from the top of the screen (the T-Deck Pro's
// finger, tdeck_input.cpp; HostQuickSheetPulled sends Pulled), a floating
// view across the top - "Lock screen", and a checkbox for each of the
// board's radios and receivers it can switch: the 4G module and the GPS
// through the Host preferences panel's settings (cellPower, gpsPower: kept
// there as if changed in the panel), the LoRa radio through the Mesh
// application's switch (HostMeshSetPower: the board keeps it).  Pulled again
// while it is open, it closes; so does its close box.
//
// The lock screen: a floating view over the whole screen - the time, the
// date, the notifications applications have left on it, and a slider whose
// knob is dragged from its left end to its right to unlock.  A press that
// does not start on the knob does nothing, and a knob let go short of the
// end goes back, so a tap anywhere (a pocket) cannot unlock it.  The time is
// redrawn when the minute changes.  The host is told (HostScreenLocked) so
// that it can leave the keyboard out meanwhile.
//
// The notifications (the interface any application uses: the global
// functions ScreenLockIsLocked, ScreenLockNow, ScreenLockNotify,
// ScreenLockWithdraw, ScreenLockNotifications, RegScreenLockChange and
// UnRegScreenLockChange that Start defines - docs/host-lock-screen.md): an
// application whose news the user would otherwise see in a slip of its own
// leaves a notification on the lock screen instead while it is locked, one
// for each of its keys - the same key again replaces it, which a count of
// unread messages wants.  They are listed newest first between the date and
// the slider, as many as fit, "and N more" below them.  One tapped is
// chosen (its frame thick, "Unlock to open"); a tap on it again leaves it.
// At the unlock they are all taken off and given back to the applications:
// the one chosen its Opened method, the rest their Unlocked - an
// application shows then what it would have shown had the screen not been
// locked.  Nothing is kept while the screen is not locked (Notify ==> nil:
// the application shows its own slip).
//
// The auto-lock: once the user has left the pen and the keys alone for the
// Host panel's "Auto-lock" (HostAutoLockSeconds; 0 never), the screen locks
// itself.  Watch looks at the count of the user's pen samples and keys
// (HostUserActivity) every few seconds - every 30 while the auto-lock is
// off; a change of the setting starts it again at once, HostSetAutoLock
// sending Rewatch - and the idle time is counted again from any change of
// it, from a change of the setting, and from the unlock.

{
	kFont: 10240,							// the system font, 10 point
	kBold: 1058816,							// ... bold (face 1: 1 << 20)
	kBig: 1067008,							// ... 18 point, bold
	kSmall: 9216,							// ... 9 point
	kRowHeight: 22,
	kMostNotes: 20,							// (notifications kept: the oldest dropped past it)

	sheetView: nil,
	lockView: nil,
	notes: [],								// the notifications, newest first: {appSymbol, key, note, time, chosen}
	watchers: nil,							// RegScreenLockChange's: {callbackID: fn}
	autoLocked: nil,						// (the lock screen up by the auto-lock)

	// the auto-lock's watch: the activity seen last, when (Ticks), the
	// setting then
	lastActivity: nil,
	lastActive: 0,
	lastSeconds: 0,
	watchGen: 0,							// (a watch begun before the last Rewatch stops)

	Start: func()
	begin
		notes := [];
		watchers := {};
		// the interface, as global functions (the ROM's own LockScreen and
		// ReleaseScreenLock are something else: QuickDraw's)
		DefGlobalFn('ScreenLockIsLocked, func() GetGlobalVar('|QuickSheet:host|):IsLocked());
		DefGlobalFn('ScreenLockNow, func() GetGlobalVar('|QuickSheet:host|):Lock() and true);
		DefGlobalFn('ScreenLockNotify, func(appSymbol, note) GetGlobalVar('|QuickSheet:host|):Notify(appSymbol, note));
		DefGlobalFn('ScreenLockWithdraw, func(appSymbol, key) GetGlobalVar('|QuickSheet:host|):Withdraw(appSymbol, key));
		DefGlobalFn('ScreenLockNotifications, func() GetGlobalVar('|QuickSheet:host|):Notifications());
		DefGlobalFn('RegScreenLockChange, func(callbackID, fn) GetGlobalVar('|QuickSheet:host|):RegChange(callbackID, fn));
		DefGlobalFn('UnRegScreenLockChange, func(callbackID) GetGlobalVar('|QuickSheet:host|):UnRegChange(callbackID));
		:Watch(watchGen);
	end,

	// the auto-lock set anew (HostSetAutoLock): watched from now
	Rewatch: func()
	begin
		watchGen := watchGen + 1;
		:Watch(watchGen);
	end,

	IsLocked: func() if lockView then true,

	// two keys the same: strings by their characters, anything else by =
	SameKey: func(a, b) if IsString(a) and IsString(b) then StrEqual(a, b) else a = b,

	// a notification left on the lock screen (or the one with the same
	// application and key replaced, newest again) ==> true; nil when the
	// screen is not locked, or the notification will not do
	Notify: func(appSymbol, note)
	begin
		if not lockView or not IsSymbol(appSymbol) or not IsFrame(note) then return nil;
		local key := note.key;
		local chosen := nil;
		local kept := [];
		foreach r in notes do
			if r.appSymbol = appSymbol and :SameKey(r.key, key) then chosen := r.chosen
			else AddArraySlot(kept, r);
		local record := {appSymbol: appSymbol, key: key, note: note,
			time: if IsInteger(note.time) then note.time else Time(), chosen: chosen};
		notes := [record];
		foreach r in kept do
			if Length(notes) < kMostNotes then AddArraySlot(notes, r);
		:NotesChanged();
		true;
	end,

	// an application's notification taken off (key nil: all of the
	// application's) ==> how many were
	Withdraw: func(appSymbol, key)
	begin
		local kept := [];
		local taken := 0;
		foreach r in notes do
			if r.appSymbol = appSymbol and (key = nil or :SameKey(r.key, key)) then taken := taken + 1
			else AddArraySlot(kept, r);
		notes := kept;
		if taken > 0 then :NotesChanged();
		taken;
	end,

	// the notifications on the lock screen, newest first: {appSymbol, key,
	// title, text, time, chosen}
	Notifications: func()
		foreach r in notes collect {appSymbol: r.appSymbol, key: r.key, title: r.note.title, text: r.note.text,
			time: r.time, chosen: r.chosen},

	RegChange: func(callbackID, fn)
	begin
		if not watchers then watchers := {};
		watchers.(callbackID) := fn;
		true;
	end,

	UnRegChange: func(callbackID)
	begin
		if watchers and HasSlot(watchers, callbackID) then RemoveSlot(watchers, callbackID);
		true;
	end,

	// those registered told (each on its own: one that throws does not stop
	// the rest)
	TellWatchers: func(locked)
	begin
		if not watchers then return;
		foreach id, fn in watchers do
			try
				call fn with (locked)
			onexception |evt.ex| do
				Print("[lock] " & SPrintObject(id) & " threw when told the screen " & (if locked then "locked" else "unlocked"));
	end,

	NotesChanged: func()
	begin
		if lockView then
			foreach c in lockView:ChildViewFrames() do
				if c.lockRole = 'notes then c:Dirty();
	end,

	// the auto-lock's watch (again in a few seconds)
	Watch: func(gen)
	begin
		if gen <> watchGen then return;
		local seconds := 0;
		try
			begin
				seconds := HostAutoLockSeconds();
				local activity := HostUserActivity();
				local now := Ticks();
				if activity <> lastActivity or seconds <> lastSeconds or lockView or now < lastActive then begin
					lastActivity := activity;
					lastSeconds := seconds;
					lastActive := now;
				end else if seconds > 0 and now - lastActive >= seconds * 60 then begin
					:Lock();
					autoLocked := true;
					lastActive := now;
				end;
			end
		onexception |evt.ex| do
			Print("[lock] the auto-lock's watch threw");
		AddDelayedCall(func(gen) GetGlobalVar('|QuickSheet:host|):Watch(gen), [gen],
			if seconds <= 0 then 30000 else Max(1000, Min(5000, seconds * 250)));
	end,

	Pulled: func()
	begin
		if lockView then return;
		if sheetView then :CloseSheet() else :OpenSheet();
	end,

	// one of the Host preferences panel's settings as a switch: {label, Get,
	// Set} - changed through the panel's frame, so that it keeps it
	SettingSwitch: func(label, setting)
	begin
		{label: label,
		 Get: func() begin
			local on := nil;
			foreach item in HostSettingsList() do
				if item.setting = setting and item.value then on := true;
			on;
		 end,
		 Set: func(on) begin
			local settings := GetGlobalVar('|HostSettings:host|);
			if settings then settings:Change(setting, on) else HostSetSetting(setting, on);
		 end};
	end,

	// the board's switches, in the sheet's order
	Switches: func()
	begin
		local switches := [];
		local have := [];
		foreach item in HostSettingsList() do AddArraySlot(have, item.setting);
		if SetContains(have, 'cellPower) then AddArraySlot(switches, :SettingSwitch("4G module", 'cellPower));
		if SetContains(have, 'gpsPower) then AddArraySlot(switches, :SettingSwitch("GPS", 'gpsPower));
		if GetGlobalFn('HostMeshPowerSwitchable) and call GetGlobalFn('HostMeshPowerSwitchable) with () then
			AddArraySlot(switches, {label: "LoRa radio",
				Get: func() call GetGlobalFn('HostMeshPowered) with (),
				Set: func(on) call GetGlobalFn('HostMeshSetPower) with (on)});
		switches;
	end,

	OpenSheet: func()
	begin
		local root := GetRoot():LocalBox();
		local width := root.right - root.left;
		local children := [
			{_proto: @218, viewBounds: {left: 10, top: 6, right: -10, bottom: 22}, viewJustify: 48,	// protoStaticText
			 viewFont: kBold, text: "Quick settings"}];
		local top := 28;
		foreach s in :Switches() do begin
			AddArraySlot(children,
				{_proto: @164,												// protoCheckbox
				 viewBounds: {left: 10, top: top, right: -10, bottom: top + 18},
				 viewJustify: 48,
				 text: s.label & " on",
				 buttonValue: true,
				 viewValue: nil,
				 switch: s,
				 viewSetupFormScript: func() begin
					viewValue := call switch.Get with ();
					inherited:?viewSetupFormScript();
				 end,
				 valueChanged: func() begin
					call switch.Set with (viewValue);
					// (what the board has now, whether or not it took it)
					local now := call switch.Get with ();
					if (now and true) <> (viewValue and true) then SetValue(self, 'viewValue, now);
				 end});
			top := top + kRowHeight;
		end;
		AddArraySlot(children,
			{_proto: @226,													// protoTextButton
			 viewBounds: {left: 10, top: top + 4, right: 110, bottom: top + 22},
			 text: "Lock screen",
			 sheetRole: 'lock,
			 buttonClickScript: func() GetGlobalVar('|QuickSheet:host|):Lock()});
		AddArraySlot(children, {_proto: @166, sheetRole: 'close,				// protoClosebox, at the top right
			viewBounds: {left: -20, top: 6, right: -6, bottom: 20}, viewJustify: 32});	// (vjParentRightH)
		local height := top + 34;
		// (its edge a black rule inside it: a frame is drawn outside the
		// bounds, off the screen at the top and the sides)
		AddArraySlot(children, {viewClass: 74, viewFlags: 1, viewFormat: 5,	// black
			viewBounds: {left: 0, top: height - 3, right: width, bottom: height}});
		sheetView := BuildContext({
			viewClass: 74,													// clView
			viewFlags: 580,													// vApplication, vFloating, vClickable (not vVisible: Open shows it - a view visible already is not drawn, TView::Show)
			viewFormat: 1,													// white
			viewBounds: {left: 0, top: 0, right: width, bottom: height},
			viewFont: kFont,
			quickSheet: true,
			declareSelf: 'base,												// (the close box closes base)
			stepChildren: children,
			viewQuitScript: func() GetGlobalVar('|QuickSheet:host|).sheetView := nil});
		sheetView:Open();
		sheetView;
	end,

	CloseSheet: func()
	begin
		if sheetView then sheetView:Close();
		sheetView := nil;
	end,

	Lock: func()
	begin
		:CloseSheet();
		if lockView then return lockView;
		local root := GetRoot():LocalBox();
		local width := root.right - root.left;
		local height := root.bottom - root.top;
		local sliderTop := height - 70;
		local clockTop := height div 6;
		notes := [];
		lockView := BuildContext({
			viewClass: 74,
			viewFlags: 580,
			viewFormat: 1,													// white
			viewBounds: {left: 0, top: 0, right: width, bottom: height},
			viewFont: kFont,
			lockScreen: true,
			stepChildren: [
				{_proto: @218, viewBounds: {left: 0, top: clockTop, right: width, bottom: clockTop + 26},
				 viewJustify: 2, viewFont: kBig, text: "", lockRole: 'time},
				{_proto: @218, viewBounds: {left: 0, top: clockTop + 30, right: width, bottom: clockTop + 46},
				 viewJustify: 2, viewFont: kFont, text: "", lockRole: 'date},
				{_proto: notesList, viewBounds: {left: 12, top: clockTop + 56, right: width - 12, bottom: sliderTop - 10}},
				{_proto: slider, viewBounds: {left: 16, top: sliderTop, right: width - 16, bottom: sliderTop + 36}}],
			viewSetupDoneScript: func() begin
				:ShowTime();
				:SetupIdle(1000);
			end,
			ShowTime: func() begin
				local now := Time();
				foreach c in :ChildViewFrames() do begin
					if c.lockRole = 'time then SetValue(c, 'text, TimeStr(now, @66.shortTimeStrSpec));
					if c.lockRole = 'date then SetValue(c, 'text, LongDateStr(now, @66.longDateStrSpec));
				end;
				shownMinute := now;
			end,
			shownMinute: nil,
			// (once a second: the time redrawn only when the minute changes,
			// which a panel that flashes to redraw wants)
			viewIdleScript: func() begin
				if Time() <> shownMinute then :ShowTime();
				1000;
			end,
			viewQuitScript: func() GetGlobalVar('|QuickSheet:host|).lockView := nil});
		lockView:Open();
		autoLocked := nil;
		HostScreenLocked(true);
		:TellWatchers(true);
		lockView;
	end,

	// the lock screen gone; its notifications given back to their
	// applications - those left Unlocked, then the one chosen Opened (last,
	// so that what it opens is on top)
	Unlock: func()
	begin
		if lockView then lockView:Close();
		lockView := nil;
		autoLocked := nil;
		lastActive := Ticks();
		HostScreenLocked(nil);
		local given := notes;
		notes := [];
		local opened := nil;
		foreach r in given do
			if r.chosen then opened := r
			else
				try
					r.note:?Unlocked()
				onexception |evt.ex| do
					Print("[lock] " & SPrintObject(r.appSymbol) & "'s notification threw at the unlock");
		if opened then
			try
				opened.note:?Opened()
			onexception |evt.ex| do
				Print("[lock] " & SPrintObject(opened.appSymbol) & "'s notification threw when opened");
		:TellWatchers(nil);
	end,

	// a notification's words fitted to a width: the text wrapped at its
	// spaces (a word too long for a line broken), at most so many lines, the
	// last cut short with "..." when there is more
	Split: func(text, separator)
	begin
		local parts := [];
		local start := 0;
		local n := StrLen(text);
		for i := 0 to n - 1 do
			if text[i] = separator then begin
				AddArraySlot(parts, SubStr(text, start, i - start));
				start := i + 1;
			end;
		AddArraySlot(parts, SubStr(text, start, n - start));
		parts;
	end,

	Fit: func(text, width, font)
	begin
		if StrFontWidth(text, font) <= width then return text;
		local n := StrLen(text);
		while n > 0 and StrFontWidth(SubStr(text, 0, n) & "...", font) > width do n := n - 1;
		SubStr(text, 0, n) & "...";
	end,

	WrapText: func(text, width, font, most)
	begin
		local lines := [];
		foreach paragraph in :Split(text, $\n) do begin
			local line := "";
			foreach word in :Split(paragraph, $ ) do begin
				local tryLine := if StrLen(line) = 0 then word else line & " " & word;
				if StrFontWidth(tryLine, font) <= width then
					line := tryLine
				else begin
					if StrLen(line) > 0 then AddArraySlot(lines, line);
					line := word;
					while StrFontWidth(line, font) > width and StrLen(line) > 1 do begin
						local n := StrLen(line) - 1;
						while n > 1 and StrFontWidth(SubStr(line, 0, n), font) > width do n := n - 1;
						AddArraySlot(lines, SubStr(line, 0, n));
						line := SubStr(line, n, StrLen(line) - n);
					end;
				end;
			end;
			AddArraySlot(lines, line);
		end;
		if Length(lines) > most then begin
			local cut := [];
			for i := 0 to most - 1 do AddArraySlot(cut, lines[i]);
			cut[most - 1] := :Fit(cut[most - 1] & " " & lines[most], width, font);
			if not EndsWith(cut[most - 1], "...") then cut[most - 1] := :Fit(cut[most - 1] & "...", width, font);
			lines := cut;
		end;
		lines;
	end,

	// when a notification came: the time today, the date before
	WhenText: func(time)
		if time div 1440 = Time() div 1440 then TimeStr(time, @66.shortTimeStrSpec) else ShortDate(time),

	// The notifications' list: drawn by itself, each a frame with its title
	// in bold and its time at the right, its text below in at most two
	// lines; as many as fit, newest first, "and N more" below them.  A tap
	// on one chooses it (or leaves it, chosen already).
	notesList: {
		viewClass: 74,
		viewFlags: 513,														// vVisible, vClickable
		viewFormat: 0,
		lockRole: 'notes,
		kPad: 5,
		kGap: 6,
		kTextLines: 2,
		rows: nil,															// (as drawn: {top, bottom, record})
		viewDrawScript: func()
		begin
			local sheet := GetGlobalVar('|QuickSheet:host|);
			local b := :LocalBox();
			local w := b.right - b.left;
			local h := b.bottom - b.top;
			local titleH := FontHeight(sheet.kBold);
			local lineH := FontHeight(sheet.kFont);
			local moreH := lineH + 2;
			rows := [];
			local y := 0;
			local shown := 0;
			foreach i, r in sheet.notes do begin
				local title := if IsString(r.note.title) then r.note.title else "";
				local text := if IsString(r.note.text) then r.note.text else "";
				local when := if r.chosen then "Unlock to open" else sheet:WhenText(r.time);
				local whenW := StrFontWidth(when, sheet.kSmall);
				local lines := if StrLen(text) > 0 then sheet:WrapText(text, w - 2 * kPad, sheet.kFont, kTextLines) else [];
				local rowH := kPad + titleH + 2 + lineH * Length(lines) + kPad;
				local room := if i = Length(sheet.notes) - 1 then h else h - moreH;
				if y + rowH > room then break;
				:DrawShape(MakeRoundRect(0, y, w, y + rowH, 6),
					{penSize: if r.chosen then 3 else 1, penPattern: 5, fillPattern: 1});
				:DrawShape(MakeText(sheet:Fit(title, w - 3 * kPad - whenW, sheet.kBold), kPad, y + kPad, w - 2 * kPad - whenW, y + kPad + titleH),
					{font: sheet.kBold});
				:DrawShape(MakeText(when, w - kPad - whenW - 2, y + kPad + 1, w - kPad, y + kPad + titleH),
					{font: sheet.kSmall, justification: 'right});
				local ly := y + kPad + titleH + 2;
				foreach line in lines do begin
					:DrawShape(MakeText(line, kPad, ly, w - kPad, ly + lineH), {font: sheet.kFont});
					ly := ly + lineH;
				end;
				AddArraySlot(rows, {top: y, bottom: y + rowH, record: r});
				y := y + rowH + kGap;
				shown := shown + 1;
			end;
			local more := Length(sheet.notes) - shown;
			if more > 0 then
				:DrawShape(MakeText("and " & NumberStr(more) & " more", 0, y, w, y + lineH),
					{font: sheet.kFont, justification: 'center});
		end,
		viewClickScript: func(unit)
		begin
			InkOff(unit);
			:Tapped(GetPoint(1, unit) - (:GlobalBox()).top);				// (firstY)
			true;
		end,
		// a tap at y (in the list): the notification there chosen, or left
		// (==> the notification, or nil: none there)
		Tapped: func(y)
		begin
			local sheet := GetGlobalVar('|QuickSheet:host|);
			if not rows then return nil;
			local hit := nil;
			foreach row in rows do
				if y >= row.top and y < row.bottom then hit := row.record;
			if not hit then return nil;
			local choose := not hit.chosen;
			foreach r in sheet.notes do r.chosen := nil;
			hit.chosen := choose;
			:Dirty();
			hit;
		end,
	},

	// The slider: a frame with the knob in it at knobX (0 at the left end),
	// "slide to unlock" in what is left of it.  A press on the knob drags it
	// with the pen (its ink off); let go at the right end, the screen
	// unlocks, short of it the knob goes back.
	slider: {
		viewClass: 74,
		viewFlags: 513,														// vVisible, vClickable
		viewFormat: 0,
		lockRole: 'slider,
		knobX: 0,
		kKnobWidth: 44,
		Travel: func() begin
			local b := :LocalBox();
			b.right - b.left - kKnobWidth - 4;
		end,
		viewDrawScript: func()
		begin
			local b := :LocalBox();
			local w := b.right - b.left;
			local h := b.bottom - b.top;
			:DrawShape(MakeRoundRect(0, 0, w, h, 10), {penSize: 2, penPattern: 5, fillPattern: 1});
			local left := 2 + knobX;
			:DrawShape(MakeRoundRect(left, 2, left + kKnobWidth, h - 2, 8), {penPattern: 0, fillPattern: 5});
			// the knob's arrow, in white
			local cx := left + kKnobWidth div 2;
			local cy := h div 2;
			:DrawShape(MakePolygon([cx - 6, cy - 8, cx + 6, cy, cx - 6, cy + 8]), {penPattern: 0, fillPattern: 1});
			local fh := FontHeight(10240);
			local textLeft := left + kKnobWidth + 4;
			if textLeft < w - 60 then
				:DrawShape(MakeText("slide to unlock", textLeft, (h - fh) div 2 - 2, w - 4, (h + fh) div 2),
					{font: 10240, justification: 'center});
		end,
		viewClickScript: func(unit)
		begin
			InkOff(unit);
			local origin := (:GlobalBox()).left;
			local grab := GetPoint(0, unit) - origin - 2 - knobX;			// (firstX)
			if grab < -6 or grab > kKnobWidth + 6 then return true;			// not on the knob
			local travel := :Travel();
			local x := knobX;
			loop begin
				local wanted := GetPoint(4, unit) - origin - 2 - grab;		// (finalX)
				if wanted < 0 then wanted := 0;
				if wanted > travel then wanted := travel;
				// (a few pixels at a time: each redraw is the panel's)
				if Abs(wanted - x) >= 6 or (wanted = travel and x <> travel) then begin
					x := wanted;
					knobX := x;
					:Dirty();
					RefreshViews();
				end;
				if StrokeDone(unit) then break;
				Sleep(1);
			end;
			local final := GetPoint(4, unit) - origin - 2 - grab;
			if final >= travel - 4 then
				GetGlobalVar('|QuickSheet:host|):Unlock()
			else begin
				knobX := 0;
				:Dirty();
			end;
			true;
		end,
	},
}
