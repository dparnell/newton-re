// The quick sheet and the lock screen (host/HostQuickSheet.h).  This file is
// compiled into the program (HostQuickSheetSource.cpp, made by
// src/cmake/EmbedText.cmake) and evaluated at boot by HostInstallQuickSheet;
// it answers the frame kept in the global QuickSheet:host.
//
// The sheet: pulled down from the top of the screen (the T-Deck Pro's
// finger, tdeck_input.cpp; HostQuickSheetPulled sends Pulled), a floating
// view across the top - "Lock screen", and a checkbox for each of the
// board's radios and receivers it can switch: the 4G module and the GPS
// through the Host preferences panel's settings (cellPower, gpsPower: kept
// there as if changed in the panel), the LoRa radio through the Mesh
// application's switch (HostMeshSetPower: the board keeps it).  Pulled again
// while it is open, it closes; so does its close box.
//
// The lock screen: a floating view over the whole screen - the time, the
// date, the notifications applications have left on it, and a slider whose
// knob is dragged from its left end to its right to unlock.  A press that
// does not start on the knob does nothing, and a knob let go short of the
// end goes back, so a tap anywhere (a pocket) cannot unlock it.  The time is
// redrawn when the minute changes.  The host is told (HostScreenLocked) so
// that it can leave the keyboard out meanwhile.
//
// The notifications (the interface any application uses: the global
// functions ScreenLockIsLocked, ScreenLockNow, ScreenLockNotify,
// ScreenLockWithdraw, ScreenLockNotifications, RegScreenLockChange and
// UnRegScreenLockChange that Start defines - docs/host-lock-screen.md): an
// application whose news the user would otherwise see in a slip of its own
// leaves a notification on the lock screen instead while it is locked, one
// for each of its keys - the same key again replaces it, which a count of
// unread messages wants.  They are listed newest first between the date and
// the slider, as many as fit, "and N more" below them.  One tapped is
// chosen (its frame thick, "Unlock to open"); a tap on it again leaves it.
// A notification may carry actions - buttons along its foot, such as a
// call's Decline and Answer: a tap on one runs it at once (its Chosen),
// unlocking first when it says unlock (the notification itself then taken
// off, so neither Opened nor Unlocked).
// At the unlock they are all taken off and given back to the applications:
// the one chosen its Opened method, the rest their Unlocked - an
// application shows then what it would have shown had the screen not been
// locked.  Nothing is kept while the screen is not locked (Notify ==> nil:
// the application shows its own slip).
//
// The machine's own sleep - the power switch, the idle timer (Prefs' Sleep
// time, which is the lock screen's auto-lock: the host has none of its own)
// - locks the screen first, on every host: a power-off function
// (RegPowerOff) locks it and draws it, so that the machine wakes to it.
//
// Sleep while locked (a host whose screen keeps its picture for nothing -
// the T-Deck Pro's e-paper - says HostLockSleeps()): locked, the machine is
// put to sleep (the root's GotoSleep, as the power switch does) a moment
// after the lock screen is drawn, and the screen shows it meanwhile; and
// woken while locked - a tap, a key, a message (the root sleeps again 45 s
// after the serial line's wake anyway) - it sleeps again once the user has
// left it alone kAwakeLocked seconds.
//
// Do not disturb (the sheet's switch; the global functions DoNotDisturbIsOn,
// DoNotDisturbSet, DoNotDisturbHolds, DoNotDisturbRecord and
// DoNotDisturbHeld - docs/host-do-not-disturb.md): while it is on, the
// applications that would ring, beep or put up a slip for something that
// came in - Phone, Messages, Mesh - ask DoNotDisturbHolds whether to stay
// quiet (a Names card marked hostDNDAllowed, its number the sender's, is let
// through) and record what they kept quiet about (DoNotDisturbRecord).
// Turned off, a slip sums up what came in meanwhile (the screen locked: a
// notification on the lock screen, the slip at the unlock).  The setting and
// the record are kept in the user configuration (hostDoNotDisturb,
// hostDNDSince, hostDNDLog), so a restart in the middle loses neither.  A
// schedule (the sheet's Schedule button: hostDNDSchedule {on, start, stop},
// minutes of the day) turns it on at start and off at stop every day - each
// time crossed, so a hand that turned it off within the hours is not
// overruled until the next day (DNDCheck).  Names' status bar has a DND
// button (RegAuxButton) that lets the card shown through.
//
// Shutting down (ShutDown: the sheet's button, the Host preferences panel's):
// the ROM's PowerOff, so that the applications are asked and told as for a
// sleep, with the host's end in place of the sleep (HostPowerOff(true)).  An
// application that says no, or a board that will not go, leaves the machine up
// and the user told why.

{
	kFont: 10240,							// the system font, 10 point
	kBold: 1058816,							// ... bold (face 1: 1 << 20)
	offView: nil,							// the off screen (ShowOff), while it is up
	shuttingDown: nil,						// (ShutDown: on the way)
	kBig: 1067008,							// ... 18 point, bold
	kSmall: 9216,							// ... 9 point
	kRowHeight: 22,
	kMostNotes: 20,							// (notifications kept: the oldest dropped past it)
	kAwakeLocked: 20,						// (seconds left alone, locked, before the machine sleeps again)
	kSleepAfterLock: 1500,					// (ms after the lock before it sleeps: the finger lifted, the screen drawn)

	sheetView: nil,
	lockView: nil,
	notes: [],								// the notifications, newest first: {appSymbol, key, note, time, chosen}
	watchers: nil,							// RegScreenLockChange's: {callbackID: fn}

	// the machine awake while locked: the activity and the sleeps seen
	// last, and when (a wake counts as activity: the time asleep does not
	// count as left alone)
	lockedActivity: nil,
	lockedSleeps: nil,
	lockedSince: 0,

	Start: func()
	begin
		notes := [];
		watchers := {};
		// the interface, as global functions (the ROM's own LockScreen and
		// ReleaseScreenLock are something else: QuickDraw's)
		DefGlobalFn('ScreenLockIsLocked, func() GetGlobalVar('|QuickSheet:host|):IsLocked());
		DefGlobalFn('ScreenLockNow, func() GetGlobalVar('|QuickSheet:host|):Lock() and true);
		DefGlobalFn('ScreenLockNotify, func(appSymbol, note) GetGlobalVar('|QuickSheet:host|):Notify(appSymbol, note));
		DefGlobalFn('ScreenLockWithdraw, func(appSymbol, key) GetGlobalVar('|QuickSheet:host|):Withdraw(appSymbol, key));
		DefGlobalFn('ScreenLockNotifications, func() GetGlobalVar('|QuickSheet:host|):Notifications());
		DefGlobalFn('RegScreenLockChange, func(callbackID, fn) GetGlobalVar('|QuickSheet:host|):RegChange(callbackID, fn));
		DefGlobalFn('UnRegScreenLockChange, func(callbackID) GetGlobalVar('|QuickSheet:host|):UnRegChange(callbackID));
		RegPowerOff('|QuickSheet:host|, func(what, why) GetGlobalVar('|QuickSheet:host|):PowerOffAsked(what, why));
		DefGlobalFn('DoNotDisturbIsOn, func() GetGlobalVar('|QuickSheet:host|):DNDOn());
		DefGlobalFn('DoNotDisturbSet, func(on) GetGlobalVar('|QuickSheet:host|):SetDND(on));
		DefGlobalFn('DoNotDisturbHolds, func(number) GetGlobalVar('|QuickSheet:host|):DNDHolds(number));
		DefGlobalFn('DoNotDisturbRecord, func(appSymbol, event) GetGlobalVar('|QuickSheet:host|):DNDRecord(appSymbol, event));
		DefGlobalFn('DoNotDisturbHeld, func() GetGlobalVar('|QuickSheet:host|):DNDHeld());
		DefGlobalFn('DoNotDisturbAllow, func(card, allow) GetGlobalVar('|QuickSheet:host|):DNDAllow(card, allow));
		DefGlobalFn('DoNotDisturbSchedule, func() GetGlobalVar('|QuickSheet:host|):DNDSchedule());
		DefGlobalFn('DoNotDisturbSetSchedule, func(schedule) GetGlobalVar('|QuickSheet:host|):SetDNDSchedule(schedule));
		// Names' status bar: the card shown let through, or not
		RegAuxButton('|DNDNames:host|, {destApp: 'cardfile, _proto: @226,		// protoTextButton
			text: "DND", buttonClickScript: func() GetGlobalVar('|QuickSheet:host|):NamesButton(self)});
		// (the schedule, once the user configuration is there)
		AddDeferredCall(func() GetGlobalVar('|QuickSheet:host|):DNDCheck(), nil);
	end,

	/*----------------------------------------------------------------------
		Do not disturb
	----------------------------------------------------------------------*/

	kMostHeld: 100,							// (events kept: the oldest dropped past it)
	dndSlip: nil,							// (the summary, while it is up)

	DNDOn: func() if GetUserConfig('hostDoNotDisturb) then true,

	// on or off; turned off, the summary of what came in meanwhile
	SetDND: func(on)
	begin
		local was := :DNDOn();
		SetUserConfig('hostDNDBySchedule, nil);
		if on and not was then begin
			SetUserConfig('hostDNDLog, []);
			SetUserConfig('hostDNDSince, Time());
			SetUserConfig('hostDoNotDisturb, true);
		end else if was and not on then begin
			SetUserConfig('hostDoNotDisturb, nil);
			:DNDSummary();
		end;
		:DNDOn();
	end,

	// whether news from this number (nil: none known) is to be kept quiet
	DNDHolds: func(number) :DNDOn() and not :DNDAllowed(number),

	// a Names card marked to be let through has this number (by its last
	// eight digits, as Messages and Phone tell numbers apart)
	DNDAllowed: func(number)
	begin
		local key := :LastDigits(number);
		if StrLen(key) = 0 then return nil;
		local soup := GetUnionSoup("Names");
		if not soup then return nil;
		local cursor := Query(soup, {type: 'index});
		local e;
		while e := cursor:Entry() do begin
			if e.hostDNDAllowed and e.phones then
				foreach p in e.phones do
					if IsString(p) and StrEqual(:LastDigits(p), key) then return true;
			cursor:Next();
		end;
		nil;
	end,

	LastDigits: func(number)
	begin
		local digits := "";
		if IsString(number) then
			for i := 0 to StrLen(number) - 1 do
				if number[i] >= $0 and number[i] <= $9 then digits := digits & number[i];
		if StrLen(digits) > 8 then SubStr(digits, StrLen(digits) - 8, 8) else digits;
	end,

	// something kept quiet: {kind 'missedCall/'text/'mesh (or the application's
	// own), title, text}, kept with the time
	DNDRecord: func(appSymbol, event)
	begin
		if not IsFrame(event) then return nil;
		local log := GetUserConfig('hostDNDLog);
		local kept := [];
		if log then
			foreach r in log do AddArraySlot(kept, r);
		AddArraySlot(kept, {appSymbol: appSymbol, kind: event.kind,
			title: if IsString(event.title) then Clone(event.title) else "",
			text: if IsString(event.text) then Clone(event.text) else "", time: Time()});
		while Length(kept) > kMostHeld do begin
			local rest := [];
			for i := 1 to Length(kept) - 1 do AddArraySlot(rest, kept[i]);
			kept := rest;
		end;
		SetUserConfig('hostDNDLog, kept);
		true;
	end,

	// what has been kept quiet, oldest first
	DNDHeld: func()
	begin
		local log := GetUserConfig('hostDNDLog);
		if log then foreach r in log collect Clone(r) else [];
	end,

	// a card let through (its slot hostDNDAllowed) or not ==> whether it is
	DNDAllow: func(card, allow)
	begin
		if not IsFrame(card) then return nil;
		if allow then card.hostDNDAllowed := true
		else if HasSlot(card, 'hostDNDAllowed) then RemoveSlot(card, 'hostDNDAllowed);
		if IsSoupEntry(card) then EntryChangeXmit(card, nil);
		card.hostDNDAllowed and true;
	end,

	// Names' DND button: the card shown - "Allow during Do not disturb",
	// ticked when it is - in a picker
	NamesButton: func(button)
	begin
		local names := GetRoot().cardfile;
		local card := if names then names.target;
		if not IsFrame(card) or not IsSoupEntry(card) or not card.phones or Length(card.phones) = 0 then begin
			GetRoot():Notify(3, "Do not disturb", "Show a card with a phone number first: its calls and texts can then be let through Do not disturb.");
			return nil;
		end;
		button.dndCard := card;
		button.pickActionScript := func(index) begin
			if index = 0 and dndCard then
				GetGlobalVar('|QuickSheet:host|):DNDAllow(dndCard, not dndCard.hostDNDAllowed);
			dndCard := nil;
		end;
		button.pickCancelledScript := func() dndCard := nil;
		DoPopup([{item: "Allow during Do not disturb", mark: if card.hostDNDAllowed then $\uFC0B else $ }], 0, 0, button);
	end,

	/*----------------------------------------------------------------------
		Do not disturb's schedule
	----------------------------------------------------------------------*/

	kDNDStep: 15,							// (the schedule's times, in steps of so many minutes)
	scheduleGen: 0,							// (the delayed check in force: an older one does nothing)
	scheduleSlip: nil,

	DNDSchedule: func()
	begin
		local s := GetUserConfig('hostDNDSchedule);
		if IsFrame(s) then {on: s.on, start: s.start, stop: s.stop} else {on: nil, start: 22 * 60, stop: 7 * 60};
	end,

	SetDNDSchedule: func(schedule)
	begin
		SetUserConfig('hostDNDSchedule, {on: schedule.on and true, start: schedule.start mod 1440, stop: schedule.stop mod 1440});
		SetUserConfig('hostDNDLastEdge, nil);
		:DNDCheck();
		:DNDSchedule();
	end,

	// The schedule followed: the latest of today's (or yesterday's) start and
	// stop that has passed, if it has not been acted on yet, acted on - on at
	// start; off at stop, if the schedule turned it on - and a check put off
	// until the next one (a delayed call; the unlock and the sheet check
	// too, for a machine that slept through one)
	DNDCheck: func()
	begin
		scheduleGen := scheduleGen + 1;
		local s := :DNDSchedule();
		if not s.on or s.start = s.stop then return nil;
		local now := Time();
		local day := now div 1440 * 1440;
		local lastStart := day + s.start;
		if lastStart > now then lastStart := lastStart - 1440;
		local lastEnd := day + s.stop;
		if lastEnd > now then lastEnd := lastEnd - 1440;
		local edge := Max(lastStart, lastEnd);
		local applied := GetUserConfig('hostDNDLastEdge);
		if not applied or edge > applied then begin
			SetUserConfig('hostDNDLastEdge, edge);
			if edge = lastStart then begin
				if not :DNDOn() then begin
					:SetDND(true);
					SetUserConfig('hostDNDBySchedule, true);
				end;
			end else if :DNDOn() and GetUserConfig('hostDNDBySchedule) then
				:SetDND(nil);
		end;
		local next := Min(lastStart, lastEnd) + 1440;
		if Max(lastStart, lastEnd) + 1440 < next then next := Max(lastStart, lastEnd) + 1440;
		local gen := scheduleGen;
		AddDelayedCall(func() begin
			local sheet := GetGlobalVar('|QuickSheet:host|);
			if sheet.scheduleGen = gen then sheet:DNDCheck();
		end, nil, (next - now) * 60000 + 2000);
	end,

	// a time of day (minutes) as the user's clock writes it: "10:00 pm"
	TimeOfDay: func(minutes) TimeStr(Time() div 1440 * 1440 + minutes mod 1440, @66.shortTimeStrSpec),

	// The schedule's slip: "On a schedule, every day", then From and Until,
	// each with - and + a kDNDStep apart; each change kept at once
	OpenSchedule: func()
	begin
		if scheduleSlip and scheduleSlip.viewCObject then return scheduleSlip;
		local box := GetRoot():LocalBox();
		local width := Min(box.right - box.left - 16, 280);
		scheduleSlip := BuildContext({_proto: @179,								// protoFloatNGo
			viewBounds: RelBounds(0, box.top + 30, width, 150),
			dndSchedule: true,
			viewQuitScript: func() begin
				GetGlobalVar('|QuickSheet:host|).scheduleSlip := nil;
				inherited:?viewQuitScript();
			end,
			stepChildren: [
				{viewClass: 74, viewFlags: 513, viewFormat: 0,						// (drawn, and tapped, by itself)
				 viewBounds: {left: 8, top: 6, right: -26, bottom: -6}, viewJustify: 0xF0,
				 hits: nil,
				 viewDrawScript: func() begin
					local sheet := GetGlobalVar('|QuickSheet:host|);
					local s := sheet:DNDSchedule();
					local b := :LocalBox();
					local w := b.right - b.left;
					local bh := FontHeight(sheet.kBold);
					local lh := FontHeight(sheet.kFont);
					hits := [];
					:DrawShape(MakeText("Do not disturb's schedule", 0, 0, w, bh), {font: sheet.kBold});
					// the switch: a box, crossed when on
					local y := bh + 10;
					local bs := 14;
					:DrawShape(MakeRect(0, y, bs, y + bs), {penSize: 1});
					if s.on then
						:DrawShape([MakeLine(2, y + 2, bs - 2, y + bs - 2), MakeLine(2, y + bs - 2, bs - 2, y + 2)], {penSize: 2});
					:DrawShape(MakeText("On every day, as below", bs + 6, y, w, y + lh), {font: sheet.kFont});
					AddArraySlot(hits, {left: 0, top: y - 4, right: w, bottom: y + bs + 4, action: 'toggle});
					y := y + bs + 12;
					foreach row in [{label: "From", slot: 'start}, {label: "Until", slot: 'stop}] do begin
						local bw := 30;
						local rh := 24;
						:DrawShape(MakeText(row.label, 0, y + (rh - lh) div 2, 44, y + (rh - lh) div 2 + lh), {font: sheet.kFont});
						:DrawShape(MakeText(sheet:TimeOfDay(s.(row.slot)), 46, y + (rh - bh) div 2, w - 2 * bw - 12, y + (rh - bh) div 2 + bh), {font: sheet.kBold});
						foreach k in [{x: w - 2 * bw - 6, text: "-", delta: -1}, {x: w - bw, text: "+", delta: 1}] do begin
							:DrawShape(MakeRoundRect(k.x, y, k.x + bw, y + rh, 8), {penSize: 1, penPattern: 5, fillPattern: 1});
							local tw := StrFontWidth(k.text, sheet.kBold);
							:DrawShape(MakeText(k.text, k.x + (bw - tw) div 2, y + (rh - bh) div 2, k.x + (bw + tw) div 2 + 2, y + (rh - bh) div 2 + bh),
								{font: sheet.kBold, transferMode: 1});
							AddArraySlot(hits, {left: k.x, top: y, right: k.x + bw, bottom: y + rh, action: row.slot, delta: k.delta});
						end;
						y := y + rh + 8;
					end;
				 end,
				 viewClickScript: func(unit) begin
					InkOff(unit);
					local box := :GlobalBox();
					local x := GetPoint(0, unit) - box.left;
					local y := GetPoint(1, unit) - box.top;
					local sheet := GetGlobalVar('|QuickSheet:host|);
					if hits then
						foreach h in hits do
							if x >= h.left and x < h.right and y >= h.top and y < h.bottom then begin
								local s := sheet:DNDSchedule();
								if h.action = 'toggle then s.on := not s.on
								else s.(h.action) := (s.(h.action) + h.delta * sheet.kDNDStep + 1440) mod 1440;
								sheet:SetDNDSchedule(s);
								:Dirty();
								return true;
							end;
					true;
				 end},
				{_proto: @166}]});												// protoClosebox
		scheduleSlip:Open();
		scheduleSlip;
	end,

	// "2 missed calls" and the like, for a kind and a count
	DNDCount: func(n, kind)
		NumberStr(n) & " " & (if kind = 'missedCall then (if n = 1 then "missed call" else "missed calls")
			else if kind = 'text then (if n = 1 then "text" else "texts")
			else if kind = 'mesh then (if n = 1 then "mesh message" else "mesh messages")
			else (if n = 1 then "notification" else "notifications")),

	// The summary: what came in while Do not disturb was on - how many of
	// each kind, then each, newest first, as many as fit - in a slip
	DNDSummary: func()
	begin
		// (the screen locked - the schedule's end in the night: on the lock
		// screen, the slip at the unlock)
		if lockView then begin
			local count := Length(:DNDHeld());
			if :Notify('|DoNotDisturb:host|, {key: 'summary, title: "Do not disturb is off",
				text: if count = 0 then "Nothing came in." else NumberStr(count) & " held: tap and unlock to see them.",
				Opened: func() GetGlobalVar('|QuickSheet:host|):DNDSummary(),
				Unlocked: func() GetGlobalVar('|QuickSheet:host|):DNDSummary()}) then
				return nil;
		end;
		local held := :DNDHeld();
		local since := GetUserConfig('hostDNDSince);
		SetUserConfig('hostDNDLog, nil);
		SetUserConfig('hostDNDSince, nil);
		if dndSlip and dndSlip.viewCObject then dndSlip:Close();
		local counts := {};
		local order := [];
		foreach r in held do begin
			local k := if r.kind then r.kind else 'other;
			if not counts.(k) then begin
				counts.(k) := 0;
				AddArraySlot(order, k);
			end;
			counts.(k) := counts.(k) + 1;
		end;
		local summary := "Nothing came in.";
		if Length(held) > 0 then begin
			summary := "";
			foreach k in order do
				summary := (if StrLen(summary) > 0 then summary & ", " else "") & :DNDCount(counts.(k), k);
			summary := summary & ".";
		end;
		if since then summary := "Since " & :WhenText(since) & ": " & summary;
		local lines := [];
		for i := Length(held) - 1 to 0 by -1 do begin
			local r := held[i];
			AddArraySlot(lines, {when: :WhenText(r.time), title: r.title, text: r.text});
		end;
		local box := GetRoot():LocalBox();
		local width := Min(box.right - box.left - 16, 300);
		local height := Min(box.bottom - box.top - 40, 70 + Max(1, Length(lines)) * (FontHeight(kFont) + FontHeight(kSmall) + 6));
		dndSlip := BuildContext({_proto: @179,								// protoFloatNGo (centred across the screen)
			viewBounds: RelBounds(0, box.top + 20, width, height),
			dndSummary: true,
			title: "While Do not disturb was on",
			summary: summary, lines: lines,
			viewQuitScript: func() begin
				GetGlobalVar('|QuickSheet:host|).dndSlip := nil;
				inherited:?viewQuitScript();
			end,
			stepChildren: [
				{viewClass: 74, viewFlags: 1, viewFormat: 0,
				 viewBounds: {left: 8, top: 6, right: -26, bottom: -6}, viewJustify: 0xF0,	// (the slip's width and height, inset)
				 viewDrawScript: func() begin
					local sheet := GetGlobalVar('|QuickSheet:host|);
					local slip := :Parent();
					local b := :LocalBox();
					local w := b.right - b.left;
					local bh := FontHeight(sheet.kBold);
					local lh := FontHeight(sheet.kFont);
					local sh := FontHeight(sheet.kSmall);
					:DrawShape(MakeText(sheet:Fit(slip.title, w, sheet.kBold), 0, 0, w, bh), {font: sheet.kBold});
					:DrawShape(MakeText(sheet:Fit(slip.summary, w, sheet.kFont), 0, bh + 4, w, bh + 4 + lh), {font: sheet.kFont});
					local y := bh + lh + 12;
					local shown := 0;
					// each: when and what in bold, its words below
					foreach line in slip.lines do begin
						local rowH := lh + (if StrLen(line.text) > 0 then sh + 1 else 0);
						if y + rowH > b.bottom - (if shown < Length(slip.lines) - 1 then lh + 2 else 0) then break;
						local ww := StrFontWidth(line.when, sheet.kSmall) + 6;
						:DrawShape(MakeText(line.when, 0, y + 1, ww, y + 1 + sh), {font: sheet.kSmall});
						:DrawShape(MakeText(sheet:Fit(line.title, w - ww, sheet.kBold), ww, y, w, y + lh), {font: sheet.kBold});
						if StrLen(line.text) > 0 then
							:DrawShape(MakeText(sheet:Fit(line.text, w - ww, sheet.kSmall), ww, y + lh, w, y + lh + sh), {font: sheet.kSmall});
						y := y + rowH + 5;
						shown := shown + 1;
					end;
					if shown < Length(slip.lines) then
						:DrawShape(MakeText("and " & NumberStr(Length(slip.lines) - shown) & " more", 0, y, w, y + lh), {font: sheet.kFont});
				 end},
				{_proto: @166}]});										// protoClosebox
		dndSlip:Open();
		dndSlip;
	end,

	// the machine about to sleep (RegPowerOff): the screen locked and drawn
	// first, so that it wakes to it (and a screen that keeps its picture
	// shows it meanwhile)
	PowerOffAsked: func(what, why)
	begin
		if what <> 'okToPowerOff then return nil;
		if shuttingDown then return true;
		try
			if not lockView then begin
				:Lock();
				RefreshViews();
			end
		onexception |evt.ex| do
			Print("[lock] the lock before sleeping threw");
		true;
	end,

	// locked: the machine put to sleep (the root's, as the power switch
	// does) - unless it was unlocked meanwhile, or has slept since this was
	// asked for (sleeps: HostSleepCount() then; nil: whatever)
	SleepLocked: func(sleeps)
	begin
		if sleeps and HostSleepCount() <> sleeps then return;
		if lockView and HostLockSleeps() then begin
			lockedActivity := HostUserActivity();
			lockedSince := Ticks();
			RefreshViews();
			GetRoot():GotoSleep();
		end;
	end,

	// once a second while locked (the lock screen's idle): the machine
	// awake - woken by a tap, a key or news - put to sleep again once it
	// has been left alone kAwakeLocked seconds
	LockedIdle: func()
	begin
		if not HostLockSleeps() then return;
		local activity := HostUserActivity();
		local sleeps := HostSleepCount();
		local now := Ticks();
		if activity <> lockedActivity or sleeps <> lockedSleeps or now < lockedSince then begin
			lockedActivity := activity;
			lockedSleeps := sleeps;
			lockedSince := now;
		end else if now - lockedSince >= kAwakeLocked * 60 then
			:SleepLocked(nil);
	end,

	IsLocked: func() if lockView then true,

	// two keys the same: strings by their characters, anything else by =
	SameKey: func(a, b) if IsString(a) and IsString(b) then StrEqual(a, b) else a = b,

	// a notification left on the lock screen (or the one with the same
	// application and key replaced, newest again) ==> true; nil when the
	// screen is not locked, or the notification will not do
	Notify: func(appSymbol, note)
	begin
		if not lockView or not IsSymbol(appSymbol) or not IsFrame(note) then return nil;
		local key := note.key;
		local chosen := nil;
		local kept := [];
		foreach r in notes do
			if r.appSymbol = appSymbol and :SameKey(r.key, key) then chosen := r.chosen
			else AddArraySlot(kept, r);
		local record := {appSymbol: appSymbol, key: key, note: note,
			time: if IsInteger(note.time) then note.time else Time(), chosen: chosen};
		notes := [record];
		foreach r in kept do
			if Length(notes) < kMostNotes then AddArraySlot(notes, r);
		:NotesChanged();
		true;
	end,

	// an application's notification taken off (key nil: all of the
	// application's) ==> how many were
	Withdraw: func(appSymbol, key)
	begin
		local kept := [];
		local taken := 0;
		foreach r in notes do
			if r.appSymbol = appSymbol and (key = nil or :SameKey(r.key, key)) then taken := taken + 1
			else AddArraySlot(kept, r);
		notes := kept;
		if taken > 0 then :NotesChanged();
		taken;
	end,

	// the notifications on the lock screen, newest first: {appSymbol, key,
	// title, text, time, chosen}
	Notifications: func()
		foreach r in notes collect {appSymbol: r.appSymbol, key: r.key, title: r.note.title, text: r.note.text,
			time: r.time, chosen: r.chosen},

	RegChange: func(callbackID, fn)
	begin
		if not watchers then watchers := {};
		watchers.(callbackID) := fn;
		true;
	end,

	UnRegChange: func(callbackID)
	begin
		if watchers and HasSlot(watchers, callbackID) then RemoveSlot(watchers, callbackID);
		true;
	end,

	// those registered told (each on its own: one that throws does not stop
	// the rest)
	TellWatchers: func(locked)
	begin
		if not watchers then return;
		foreach id, fn in watchers do
			try
				call fn with (locked)
			onexception |evt.ex| do
				Print("[lock] " & SPrintObject(id) & " threw when told the screen " & (if locked then "locked" else "unlocked"));
	end,

	NotesChanged: func()
	begin
		if lockView then
			foreach c in lockView:ChildViewFrames() do
				if c.lockRole = 'notes then c:Dirty();
	end,

	Pulled: func()
	begin
		if lockView then return;
		:DNDCheck();
		if sheetView then :CloseSheet() else :OpenSheet();
	end,

	// The machine shut down.  An e-paper keeps what it last drew for as long
	// as it likes, so what is left on it says so and how to start it again
	// (HostPowerOffHint), drawn before the power goes.
	ShutDown: func()
	begin
		if shuttingDown then return;
		:CloseSheet();
		if not HostPowerOff(nil) then return :CannotPowerOff();
		shuttingDown := true;
		local hint := HostPowerOffHint();
		if hint then begin
			:ShowOff(hint);
			RefreshViews();
		end;
		AddDelayedCall(func() GetGlobalVar('|QuickSheet:host|):ShutDownNow(), nil, 200);
	end,

	ShutDownNow: func()
	begin
		HostPowerOff(true);
		PowerOff('user);
		:ShutDownWatch();
	end,

	// (the ROM's PoweringOff is set until its power off is over, however long
	// an application's 'holdYourHorses holds it)
	ShutDownWatch: func()
		AddDelayedCall(func() GetGlobalVar('|QuickSheet:host|):ShutDownLooked(), nil, 500),

	ShutDownLooked: func()
	begin
		if GetGlobalVar('PoweringOff) then return :ShutDownWatch();
		if not HostPowerOffStopped() then return;						// (going)
		shuttingDown := nil;
		:HideOff();
		if HostPowerOff(nil) then
			GetRoot():Notify(3, "Shut down", "An application would not let the machine shut down.")
		else
			:CannotPowerOff();
	end,

	CannotPowerOff: func()
		GetRoot():Notify(3, "Shut down", "Unplug the USB cable first: the board cannot switch off while USB powers it."),

	// the whole screen, white, with the message in the middle of it
	ShowOff: func(hint)
	begin
		local root := GetRoot():LocalBox();
		local width := root.right - root.left;
		local middle := (root.bottom - root.top) div 2;
		offView := BuildContext({
			viewClass: 74,													// clView
			viewFlags: 580,													// vApplication, vFloating, vClickable (not vVisible: Open shows it)
			viewFormat: 1,													// white
			viewBounds: {left: 0, top: 0, right: width, bottom: root.bottom - root.top},
			viewFont: kFont,
			offScreen: true,
			stepChildren: [
				{_proto: @218, viewJustify: 2,								// protoStaticText, vjCenterH
				 viewBounds: {left: 10, top: middle - 44, right: width - 10, bottom: middle - 22},
				 viewFont: kBig, text: "This device is off"},
				{_proto: @218, viewJustify: 2,
				 viewBounds: {left: 16, top: middle - 12, right: width - 16, bottom: middle + 44},
				 viewFont: kFont,
				 text: hint}],
			viewQuitScript: func() GetGlobalVar('|QuickSheet:host|).offView := nil});
		offView:Open();
		offView;
	end,

	HideOff: func()
	begin
		if offView then offView:Close();
		offView := nil;
	end,

	// one of the Host preferences panel's settings as a switch: {label, Get,
	// Set} - changed through the panel's frame, so that it keeps it
	SettingSwitch: func(label, setting)
	begin
		{label: label,
		 Get: func() begin
			local on := nil;
			foreach item in HostSettingsList() do
				if item.setting = setting and item.value then on := true;
			on;
		 end,
		 Set: func(on) begin
			local settings := GetGlobalVar('|HostSettings:host|);
			if settings then settings:Change(setting, on) else HostSetSetting(setting, on);
		 end};
	end,

	// the board's switches, in the sheet's order
	Switches: func()
	begin
		local switches := [{label: "Do not disturb",
			Get: func() GetGlobalVar('|QuickSheet:host|):DNDOn(),
			Set: func(on) GetGlobalVar('|QuickSheet:host|):SetDND(on),
			button: {text: "Schedule", Click: func() GetGlobalVar('|QuickSheet:host|):OpenSchedule()}}];
		local have := [];
		foreach item in HostSettingsList() do AddArraySlot(have, item.setting);
		if SetContains(have, 'cellPower) then AddArraySlot(switches, :SettingSwitch("4G module", 'cellPower));
		if SetContains(have, 'gpsPower) then AddArraySlot(switches, :SettingSwitch("GPS", 'gpsPower));
		if GetGlobalFn('HostMeshPowerSwitchable) and call GetGlobalFn('HostMeshPowerSwitchable) with () then
			AddArraySlot(switches, {label: "LoRa radio",
				Get: func() call GetGlobalFn('HostMeshPowered) with (),
				Set: func(on) call GetGlobalFn('HostMeshSetPower) with (on)});
		switches;
	end,

	OpenSheet: func()
	begin
		local root := GetRoot():LocalBox();
		local width := root.right - root.left;
		local children := [
			{_proto: @218, viewBounds: {left: 10, top: 6, right: -10, bottom: 22}, viewJustify: 48,	// protoStaticText
			 viewFont: kBold, text: "Quick settings"}];
		local top := 28;
		foreach s in :Switches() do begin
			// (a switch's button - Do not disturb's Schedule - at the right)
			if s.button then
				AddArraySlot(children,
					{_proto: @226,											// protoTextButton
					 viewBounds: {left: -84, top: top - 1, right: -10, bottom: top + 17}, viewJustify: 32,	// (vjParentRightH)
					 text: s.button.text, sheetRole: 'schedule, switchButton: s.button,
					 buttonClickScript: func() call switchButton.Click with ()});
			AddArraySlot(children,
				{_proto: @164,												// protoCheckbox
				 viewBounds: {left: 10, top: top, right: if s.button then -92 else -10, bottom: top + 18},
				 viewJustify: 48,
				 text: s.label & " on",
				 buttonValue: true,
				 viewValue: nil,
				 switch: s,
				 viewSetupFormScript: func() begin
					viewValue := call switch.Get with ();
					inherited:?viewSetupFormScript();
				 end,
				 valueChanged: func() begin
					call switch.Set with (viewValue);
					// (what the board has now, whether or not it took it)
					local now := call switch.Get with ();
					if (now and true) <> (viewValue and true) then SetValue(self, 'viewValue, now);
				 end});
			top := top + kRowHeight;
		end;
		AddArraySlot(children,
			{_proto: @226,													// protoTextButton
			 viewBounds: {left: 10, top: top + 4, right: 110, bottom: top + 22},
			 text: "Lock screen",
			 sheetRole: 'lock,
			 buttonClickScript: func() GetGlobalVar('|QuickSheet:host|):Lock()});
		if HostCanPowerOff() then
			AddArraySlot(children,
				{_proto: @226,												// protoTextButton
				 viewBounds: {left: 120, top: top + 4, right: 220, bottom: top + 22},
				 text: "Shut down",
				 sheetRole: 'shutDown,
				 buttonClickScript: func() GetGlobalVar('|QuickSheet:host|):ShutDown()});
		AddArraySlot(children, {_proto: @166, sheetRole: 'close,				// protoClosebox, at the top right
			viewBounds: {left: -20, top: 6, right: -6, bottom: 20}, viewJustify: 32});	// (vjParentRightH)
		local height := top + 34;
		// (its edge a black rule inside it: a frame is drawn outside the
		// bounds, off the screen at the top and the sides)
		AddArraySlot(children, {viewClass: 74, viewFlags: 1, viewFormat: 5,	// black
			viewBounds: {left: 0, top: height - 3, right: width, bottom: height}});
		sheetView := BuildContext({
			viewClass: 74,													// clView
			viewFlags: 580,													// vApplication, vFloating, vClickable (not vVisible: Open shows it - a view visible already is not drawn, TView::Show)
			viewFormat: 1,													// white
			viewBounds: {left: 0, top: 0, right: width, bottom: height},
			viewFont: kFont,
			quickSheet: true,
			declareSelf: 'base,												// (the close box closes base)
			stepChildren: children,
			viewQuitScript: func() GetGlobalVar('|QuickSheet:host|).sheetView := nil});
		sheetView:Open();
		sheetView;
	end,

	CloseSheet: func()
	begin
		if sheetView then sheetView:Close();
		sheetView := nil;
	end,

	Lock: func()
	begin
		:CloseSheet();
		if lockView then return lockView;
		local root := GetRoot():LocalBox();
		local width := root.right - root.left;
		local height := root.bottom - root.top;
		local sliderTop := height - 70;
		local clockTop := height div 6;
		notes := [];
		lockView := BuildContext({
			viewClass: 74,
			viewFlags: 580,
			viewFormat: 1,													// white
			viewBounds: {left: 0, top: 0, right: width, bottom: height},
			viewFont: kFont,
			lockScreen: true,
			stepChildren: [
				{_proto: @218, viewBounds: {left: 0, top: clockTop, right: width, bottom: clockTop + 26},
				 viewJustify: 2, viewFont: kBig, text: "", lockRole: 'time},
				{_proto: @218, viewBounds: {left: 0, top: clockTop + 30, right: width, bottom: clockTop + 46},
				 viewJustify: 2, viewFont: kFont, text: "", lockRole: 'date},
				{_proto: notesList, viewBounds: {left: 12, top: clockTop + 56, right: width - 12, bottom: sliderTop - 10}},
				{_proto: slider, viewBounds: {left: 16, top: sliderTop, right: width - 16, bottom: sliderTop + 36}}],
			viewSetupDoneScript: func() begin
				:ShowTime();
				:SetupIdle(1000);
			end,
			ShowTime: func() begin
				local now := Time();
				foreach c in :ChildViewFrames() do begin
					if c.lockRole = 'time then SetValue(c, 'text, TimeStr(now, @66.shortTimeStrSpec));
					if c.lockRole = 'date then SetValue(c, 'text, LongDateStr(now, @66.longDateStrSpec));
				end;
				shownMinute := now;
			end,
			shownMinute: nil,
			// (once a second: the time redrawn only when the minute changes,
			// which a panel that flashes to redraw wants)
			viewIdleScript: func() begin
				if Time() <> shownMinute then :ShowTime();
				GetGlobalVar('|QuickSheet:host|):LockedIdle();
				1000;
			end,
			viewQuitScript: func() GetGlobalVar('|QuickSheet:host|).lockView := nil});
		lockView:Open();
		HostScreenLocked(true);
		:TellWatchers(true);
		if HostLockSleeps() then begin
			lockedActivity := HostUserActivity();
			lockedSince := Ticks();
			AddDelayedCall(func(sleeps) GetGlobalVar('|QuickSheet:host|):SleepLocked(sleeps), [HostSleepCount()], kSleepAfterLock);
		end;
		lockView;
	end,

	// the lock screen gone; its notifications given back to their
	// applications - those left Unlocked, then the one chosen Opened (last,
	// so that what it opens is on top)
	Unlock: func()
	begin
		if lockView then lockView:Close();
		lockView := nil;
		HostScreenLocked(nil);
		:DNDCheck();
		local given := notes;
		notes := [];
		local opened := nil;
		foreach r in given do
			if r.chosen then opened := r
			else
				try
					r.note:?Unlocked()
				onexception |evt.ex| do
					Print("[lock] " & SPrintObject(r.appSymbol) & "'s notification threw at the unlock");
		if opened then
			try
				opened.note:?Opened()
			onexception |evt.ex| do
				Print("[lock] " & SPrintObject(opened.appSymbol) & "'s notification threw when opened");
		:TellWatchers(nil);
	end,

	// one of a notification's actions run: unlocking first if it says so
	// (the notification taken off, so that neither its Opened nor its
	// Unlocked is sent; the others are given back as at any unlock)
	Act: func(record, action)
	begin
		if action.unlock then begin
			notes := foreach r in notes collect if r <> record then r;
			local kept := [];
			foreach r in notes do if r then AddArraySlot(kept, r);
			notes := kept;
			:Unlock();
		end;
		try
			action:?Chosen()
		onexception |evt.ex| do
			Print("[lock] " & SPrintObject(record.appSymbol) & "'s action threw");
		:NotesChanged();
	end,

	// a notification's words fitted to a width: the text wrapped at its
	// spaces (a word too long for a line broken), at most so many lines, the
	// last cut short with "..." when there is more
	Split: func(text, separator)
	begin
		local parts := [];
		local start := 0;
		local n := StrLen(text);
		for i := 0 to n - 1 do
			if text[i] = separator then begin
				AddArraySlot(parts, SubStr(text, start, i - start));
				start := i + 1;
			end;
		AddArraySlot(parts, SubStr(text, start, n - start));
		parts;
	end,

	Fit: func(text, width, font)
	begin
		if StrFontWidth(text, font) <= width then return text;
		local n := StrLen(text);
		while n > 0 and StrFontWidth(SubStr(text, 0, n) & "...", font) > width do n := n - 1;
		SubStr(text, 0, n) & "...";
	end,

	WrapText: func(text, width, font, most)
	begin
		local lines := [];
		foreach paragraph in :Split(text, $\n) do begin
			local line := "";
			foreach word in :Split(paragraph, $ ) do begin
				local tryLine := if StrLen(line) = 0 then word else line & " " & word;
				if StrFontWidth(tryLine, font) <= width then
					line := tryLine
				else begin
					if StrLen(line) > 0 then AddArraySlot(lines, line);
					line := word;
					while StrFontWidth(line, font) > width and StrLen(line) > 1 do begin
						local n := StrLen(line) - 1;
						while n > 1 and StrFontWidth(SubStr(line, 0, n), font) > width do n := n - 1;
						AddArraySlot(lines, SubStr(line, 0, n));
						line := SubStr(line, n, StrLen(line) - n);
					end;
				end;
			end;
			AddArraySlot(lines, line);
		end;
		if Length(lines) > most then begin
			local cut := [];
			for i := 0 to most - 1 do AddArraySlot(cut, lines[i]);
			cut[most - 1] := :Fit(cut[most - 1] & " " & lines[most], width, font);
			if not EndsWith(cut[most - 1], "...") then cut[most - 1] := :Fit(cut[most - 1] & "...", width, font);
			lines := cut;
		end;
		lines;
	end,

	// when a notification came: the time today, the date before
	WhenText: func(time)
		if time div 1440 = Time() div 1440 then TimeStr(time, @66.shortTimeStrSpec) else ShortDate(time),

	// The notifications' list: drawn by itself, each a frame with its title
	// in bold and its time at the right, its text below in at most two
	// lines; as many as fit, newest first, "and N more" below them.  A tap
	// on one chooses it (or leaves it, chosen already).
	notesList: {
		viewClass: 74,
		viewFlags: 513,														// vVisible, vClickable
		viewFormat: 0,
		lockRole: 'notes,
		kPad: 5,
		kGap: 6,
		kTextLines: 2,
		rows: nil,															// (as drawn: {top, bottom, record})
		viewDrawScript: func()
		begin
			local sheet := GetGlobalVar('|QuickSheet:host|);
			local b := :LocalBox();
			local w := b.right - b.left;
			local h := b.bottom - b.top;
			local titleH := FontHeight(sheet.kBold);
			local lineH := FontHeight(sheet.kFont);
			local moreH := lineH + 2;
			rows := [];
			local y := 0;
			local shown := 0;
			foreach i, r in sheet.notes do begin
				local title := if IsString(r.note.title) then r.note.title else "";
				local text := if IsString(r.note.text) then r.note.text else "";
				local when := if r.chosen then "Unlock to open" else sheet:WhenText(r.time);
				local whenW := StrFontWidth(when, sheet.kSmall);
				local lines := if StrLen(text) > 0 then sheet:WrapText(text, w - 2 * kPad, sheet.kFont, kTextLines) else [];
				local actions := if IsArray(r.note.actions) then r.note.actions else [];
				local buttonH := if Length(actions) > 0 then lineH + 12 else 0;
				local rowH := kPad + titleH + 2 + lineH * Length(lines) + kPad
					+ (if buttonH > 0 then buttonH + kPad else 0);
				local room := if i = Length(sheet.notes) - 1 then h else h - moreH;
				if y + rowH > room then break;
				:DrawShape(MakeRoundRect(0, y, w, y + rowH, 6),
					{penSize: if r.chosen then 3 else 1, penPattern: 5, fillPattern: 1});
				:DrawShape(MakeText(sheet:Fit(title, w - 3 * kPad - whenW, sheet.kBold), kPad, y + kPad, w - 2 * kPad - whenW, y + kPad + titleH),
					{font: sheet.kBold});
				:DrawShape(MakeText(when, w - kPad - whenW - 2, y + kPad + 1, w - kPad, y + kPad + titleH),
					{font: sheet.kSmall, justification: 'right});
				local ly := y + kPad + titleH + 2;
				foreach line in lines do begin
					:DrawShape(MakeText(line, kPad, ly, w - kPad, ly + lineH), {font: sheet.kFont});
					ly := ly + lineH;
				end;
				// the actions: buttons side by side along the foot, the
				// primary one black
				local buttons := [];
				if buttonH > 0 then begin
					local n := Length(actions);
					local bw := (w - kPad * (n + 1)) div n;
					local bt := ly + kPad div 2;
					foreach j, a in actions do begin
						local bl := kPad + j * (bw + kPad);
						local primary := a.primary;
						:DrawShape(MakeRoundRect(bl, bt, bl + bw, bt + buttonH, buttonH div 2),
							{penSize: 1, penPattern: 5, fillPattern: if primary then 5 else 1});
						local label := if IsString(a.text) then a.text else "";
						local lw := StrFontWidth(label, sheet.kBold);
						local lx := bl + (bw - lw) div 2;
						local lt := bt + (buttonH - titleH) div 2;
						:DrawShape(MakeText(label, lx, lt, lx + lw + 2, lt + titleH),
							{font: sheet.kBold, transferMode: if primary then 3 else 1});
						AddArraySlot(buttons, {left: bl, top: bt, right: bl + bw, bottom: bt + buttonH, action: a});
					end;
				end;
				AddArraySlot(rows, {top: y, bottom: y + rowH, record: r, buttons: buttons});
				y := y + rowH + kGap;
				shown := shown + 1;
			end;
			local more := Length(sheet.notes) - shown;
			if more > 0 then
				:DrawShape(MakeText("and " & NumberStr(more) & " more", 0, y, w, y + lineH),
					{font: sheet.kFont, justification: 'center});
		end,
		viewClickScript: func(unit)
		begin
			InkOff(unit);
			local box := :GlobalBox();
			local x := GetPoint(0, unit) - box.left;						// (firstX)
			local y := GetPoint(1, unit) - box.top;						// (firstY)
			if not :Acted(x, y) then
				:Tapped(y);
			true;
		end,
		// a tap at x, y on one of a notification's actions: run (==> true),
		// or nil - no action there
		Acted: func(x, y)
		begin
			if not rows then return nil;
			foreach row in rows do
				if row.buttons then
					foreach b in row.buttons do
						if x >= b.left and x < b.right and y >= b.top and y < b.bottom then begin
							GetGlobalVar('|QuickSheet:host|):Act(row.record, b.action);
							return true;
						end;
			nil;
		end,
		// a tap at y (in the list): the notification there chosen, or left
		// (==> the notification, or nil: none there)
		Tapped: func(y)
		begin
			local sheet := GetGlobalVar('|QuickSheet:host|);
			if not rows then return nil;
			local hit := nil;
			foreach row in rows do
				if y >= row.top and y < row.bottom then hit := row.record;
			if not hit then return nil;
			local choose := not hit.chosen;
			foreach r in sheet.notes do r.chosen := nil;
			hit.chosen := choose;
			:Dirty();
			hit;
		end,
	},

	// The slider: a frame with the knob in it at knobX (0 at the left end),
	// "slide to unlock" in what is left of it.  A press on the knob drags it
	// with the pen (its ink off); let go at the right end, the screen
	// unlocks, short of it the knob goes back.
	slider: {
		viewClass: 74,
		viewFlags: 513,														// vVisible, vClickable
		viewFormat: 0,
		lockRole: 'slider,
		knobX: 0,
		kKnobWidth: 44,
		Travel: func() begin
			local b := :LocalBox();
			b.right - b.left - kKnobWidth - 4;
		end,
		viewDrawScript: func()
		begin
			local b := :LocalBox();
			local w := b.right - b.left;
			local h := b.bottom - b.top;
			:DrawShape(MakeRoundRect(0, 0, w, h, 10), {penSize: 2, penPattern: 5, fillPattern: 1});
			local left := 2 + knobX;
			:DrawShape(MakeRoundRect(left, 2, left + kKnobWidth, h - 2, 8), {penPattern: 0, fillPattern: 5});
			// the knob's arrow, in white
			local cx := left + kKnobWidth div 2;
			local cy := h div 2;
			:DrawShape(MakePolygon([cx - 6, cy - 8, cx + 6, cy, cx - 6, cy + 8]), {penPattern: 0, fillPattern: 1});
			local fh := FontHeight(10240);
			local textLeft := left + kKnobWidth + 4;
			if textLeft < w - 60 then
				:DrawShape(MakeText("slide to unlock", textLeft, (h - fh) div 2 - 2, w - 4, (h + fh) div 2),
					{font: 10240, justification: 'center});
		end,
		viewClickScript: func(unit)
		begin
			InkOff(unit);
			local origin := (:GlobalBox()).left;
			local grab := GetPoint(0, unit) - origin - 2 - knobX;			// (firstX)
			if grab < -6 or grab > kKnobWidth + 6 then return true;			// not on the knob
			local travel := :Travel();
			local x := knobX;
			loop begin
				local wanted := GetPoint(4, unit) - origin - 2 - grab;		// (finalX)
				if wanted < 0 then wanted := 0;
				if wanted > travel then wanted := travel;
				// (a few pixels at a time: each redraw is the panel's)
				if Abs(wanted - x) >= 6 or (wanted = travel and x <> travel) then begin
					x := wanted;
					knobX := x;
					:Dirty();
					RefreshViews();
				end;
				if StrokeDone(unit) then break;
				Sleep(1);
			end;
			local final := GetPoint(4, unit) - origin - 2 - grab;
			if final >= travel - 4 then
				GetGlobalVar('|QuickSheet:host|):Unlock()
			else begin
				knobX := 0;
				:Dirty();
			end;
			true;
		end,
	},
}
