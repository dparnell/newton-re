// The host's Host preferences panel (host/HostSettings.h): the settings of
// the machine newton runs on that can change while it runs - beaming over
// the network, and on a reMarkable the panel's pen waveform, a finger as
// the pen and a flashing redraw that clears the e-ink's ghosts.  This file
// is compiled into newton (HostSettingsSource.cpp, made by
// src/cmake/EmbedText.cmake) and evaluated at boot by HostInstallSettings;
// it answers the frame kept in the global HostSettings:host, whose Start
// puts back the settings chosen before and registers the panel.
//
// The panel lists what HostSettingsList() says this host has - each a
// frame {setting, label, kind ('check or 'button), value} - so a desktop
// shows only beaming and a reMarkable its panel's settings as well.  A
// change goes to the host at once (HostSetSetting) and is kept where the
// ROM keeps an application's settings, its entry in the System soup
// (GetAppPrefs '|HostSettings:host|, its settings slot), as the Network
// Printers panel keeps its printers (print/host/HostPrinters.ns); only a
// setting changed here is kept, so one never touched stays as newton was
// started (--ir-lan, NEWTON_RM_*).
//
// A host that draws fonts (qd/HostFonts.h) has "More fonts from the host"
// and "Choose fonts...", which opens a list of every family the host has
// to tick those the font menus offer; the families chosen are kept in the
// same entry (its fontFamilies slot, an array of names - none kept: the
// host's usual ones), and given to the host first at boot.

{
	kAppSymbol: '|HostSettings:host|,

	// the settings chosen before, given to the host again (at boot)
	Restore: func()
	begin
		local prefs := GetAppPrefs(kAppSymbol, nil);
		// (the families chosen before the setting that adds them)
		if prefs and HasSlot(prefs, 'fontFamilies) and IsArray(prefs.fontFamilies) then
			HostSetFontFamilies(prefs.fontFamilies);
		if prefs and prefs.settings then
			foreach item in HostSettingsList() do
				if item.kind <> 'button and not item.nextStart and HasSlot(prefs.settings, item.setting) then
					HostSetSetting(item.setting, prefs.settings.(item.setting));
	end,

	// one setting changed: given to the host, and kept (a choice as the
	// index of the one chosen; one for the next start the host keeps itself)
	Change: func(setting, value)
	begin
		local taken := HostSetSetting(setting, value);
		local nextStart := nil;
		foreach item in HostSettingsList() do
			if item.setting = setting and item.nextStart then nextStart := true;
		if not nextStart then begin
			local prefs := GetAppPrefs(kAppSymbol, {settings: {}});
			if not prefs.settings then prefs.settings := {};
			prefs.settings.(setting) := if IsInteger(value) then value else if value then true else nil;
			EntryChange(prefs);
		end;
		taken;
	end,

	// the panel's icon, a monitor on its stand (a 16x12 'bits frame, as the
	// ROM's own panels' icons are)
	MakeIcon: func()
	begin
		local rows := [0x7FFE, 0x4002, 0x4002, 0x4002, 0x4002, 0x4002,
					   0x4002, 0x7FFE, 0x0180, 0x0180, 0x0FF0, 0x0000];
		local b := MakeBinary(16 + 4 * Length(rows), 'bits);
		for i := 0 to 15 do StuffByte(b, i, 0);
		StuffByte(b, 5, 4);								// rowBytes
		StuffByte(b, 13, Length(rows));					// bounds.bottom
		StuffByte(b, 15, 16);							// bounds.right
		foreach i, r in rows do begin
			StuffByte(b, 16 + 4 * i, r div 256);
			StuffByte(b, 17 + 4 * i, r mod 256);
			StuffByte(b, 18 + 4 * i, 0);
			StuffByte(b, 19 + 4 * i, 0);
		end;
		{bits: b, bounds: {left: 0, top: 0, right: 16, bottom: Length(rows)}};
	end,

	// The preferences panel: a line of text, then a checkbox for each
	// setting that is on or off, a picker for each that is one of several
	// (protoLabelPicker: "Ink  Fast"), and a button for each done once -
	// made by Start, since the roll lays out and builds the panel from its
	// template (a viewSetupFormScript's stepChildren come too late)
	panel: {
		_proto: @385,								// protoPrefsRollItem
		overview: "Host",
		icon: nil,
		height: 60,
		viewBounds: {left: 0, top: 0, right: 0, bottom: 60},
		stepChildren: [],
	},

	// the panel's children for the settings this host has
	MakeChildren: func()
	begin
		local children := [
			{_proto: @218, viewBounds: {left: 10, top: 20, right: -10, bottom: 36},		// protoStaticText
			 viewJustify: 48, text: "The machine newton runs on:"}];
		local top := 42;
		foreach item in HostSettingsList() do begin
			if item.kind = 'choice then
				AddArraySlot(children,
					{_proto: @190,												// protoLabelPicker
					 viewBounds: {left: 10, top: top, right: -10, bottom: top + 16},
					 viewJustify: 48,
					 text: item.label,
					 labelCommands: item.choices,
					 setting: item.setting,
					 // (the choice the host has now, each time the panel opens)
					 TextSetup: func() begin
						local shown := labelCommands[0];
						foreach i in HostSettingsList() do
							if i.setting = setting and IsInteger(i.value) and i.value >= 0
								and i.value < Length(labelCommands) then shown := labelCommands[i.value];
						shown;
					 end,
					 LabelActionScript: func(index) GetGlobalVar('|HostSettings:host|):Change(setting, index)})
			else if item.kind = 'check then
				AddArraySlot(children,
					{_proto: @164,												// protoCheckbox
					 viewBounds: {left: 10, top: top, right: -10, bottom: top + 18},
					 viewJustify: 48,
					 text: item.label,
					 buttonValue: true,
					 viewValue: nil,
					 setting: item.setting,
					 // (the value the host has now, each time the panel opens)
					 viewSetupFormScript: func() begin
						viewValue := nil;
						foreach i in HostSettingsList() do
							if i.setting = setting and i.value then viewValue := true;
						inherited:?viewSetupFormScript();
					 end,
					 valueChanged: func() GetGlobalVar('|HostSettings:host|):Change(setting, viewValue)})
			else
				AddArraySlot(children,
					{_proto: @226,												// protoTextButton
					 viewBounds: {left: 10, top: top, right: 130, bottom: top + 16},
					 text: item.label,
					 setting: item.setting,
					 action: item.action,
					 // (a button the panel does itself names its method)
					 buttonClickScript: func()
						if action then Perform(GetGlobalVar('|HostSettings:host|), action, [:Parent()])
						else HostSetSetting(setting, true)});
			top := top + 22;
		end;
		panel.stepChildren := children;
		panel.height := top + 8;
		panel.viewBounds := {left: 0, top: 0, right: 0, bottom: panel.height};
	end,

	// The font chooser: every family the host has in a list, those the
	// font menus offer ticked (the ROM's protoTextList with several
	// selections), Done keeping what is ticked - and turning the host's
	// fonts on, if they are off, when anything is - Usual going back to
	// the host's usual families.
	OpenFontChooser: func(panelView)
	begin
		local names := HostFontFamilies();
		if not names or Length(names) = 0 then return;
		local chosen := HostFontsChosen();
		local ticked := [];
		foreach i, name in names do
			foreach c in chosen do
				if StrEqual(c, name) and not SetContains(ticked, i) then AddArraySlot(ticked, i);
		local app := GetAppParams();
		local width := Min(app.appAreaWidth - 20, 300);
		local height := Min(app.appAreaHeight - 20, 420);
		local slip := BuildContext({_proto: fontChooser, familyNames: names, ticked: ticked, panelView: panelView,
			viewBounds: RelBounds((app.appAreaWidth - width) div 2, (app.appAreaHeight - height) div 2, width, height),
			listBottom: height - 34});
		slip:Open();
		slip;
	end,

	// the families chosen (nil: the host's usual ones) given to the host
	// and kept
	ChooseFonts: func(names)
	begin
		HostSetFontFamilies(names);
		local prefs := GetAppPrefs(kAppSymbol, {settings: {}});
		if names then prefs.fontFamilies := names else RemoveSlot(prefs, 'fontFamilies);
		EntryChange(prefs);
	end,

	fontChooser: {
		_proto: @179,
		viewFlags: 580,
		viewBounds: {left: 0, top: 0, right: 300, bottom: 420},
		fontChooser: true,
		familyNames: [],
		ticked: [],
		panelView: nil,
		listBottom: 386,
		stepChildren: [
			{_proto: @218, viewBounds: {left: 10, top: 6, right: -10, bottom: 22}, viewJustify: 48,
			 viewFont: {family: 'espy, face: 1, size: 10},
			 text: "Fonts from the host"},
			{_proto: @218, viewBounds: {left: 10, top: 22, right: -10, bottom: 38}, viewJustify: 48,
			 text: "Tick those the font menus offer:"},
			{_proto: @228, viewBounds: {left: 10, top: 42, right: -10, bottom: 380}, viewJustify: 48,
			 useMultipleSelections: true, useScrollers: true, fontList: true,
			 listItems: [], selectedItems: nil,
			 viewSetupFormScript: func() begin
				listItems := familyNames;
				selectedItems := Clone(ticked);
				viewBounds := {left: 10, top: 42, right: -10, bottom: listBottom};
				inherited:?viewSetupFormScript();
			 end,
			 // (the list measured and its rows made once it has its box: the
			 //  ROM's protoTextList leaves SetupList to its user)
			 viewSetupDoneScript: func() begin
				inherited:?viewSetupDoneScript();
				:SetupList();
				:RedoChildren();
			 end},
			{_proto: @226, viewBounds: {left: -204, top: -26, right: -144, bottom: -10}, viewJustify: 8388774,
			 text: "Usual", buttonClickScript: func() :Parent():Finish('usual)},
			{_proto: @226, viewBounds: {left: -136, top: -26, right: -76, bottom: -10}, viewJustify: 8388774,
			 text: "Cancel", buttonClickScript: func() :Parent():Finish(nil)},
			{_proto: @226, viewBounds: {left: -68, top: -26, right: -8, bottom: -10}, viewJustify: 8388774,
			 text: "Done", buttonClickScript: func() :Parent():Finish('done)}
		],
		// the families ticked, in the list's order
		PickedNames: func()
		begin
			local list := nil;
			foreach c in :ChildViewFrames() do
				if c.fontList then list := c;
			local picked := if list and list.selectedItems then Clone(list.selectedItems) else [];
			Sort(picked, '|<|, nil);
			foreach i in picked collect familyNames[i];
		end,
		Finish: func(how)
		begin
			local settings := GetGlobalVar('|HostSettings:host|);
			if how = 'usual then
				settings:ChooseFonts(nil)
			else if how = 'done then begin
				local names := :PickedNames();
				settings:ChooseFonts(names);
				if Length(names) > 0 and Length(HostFontsAdded()) = 0 then begin
					settings:Change('hostFonts, true);
					if panelView then
						foreach c in panelView:ChildViewFrames() do
							if c.setting = 'hostFonts then SetValue(c, 'viewValue, true);
				end;
			end;
			:Close();
		end,
	},

	Start: func()
	begin
		:Restore();
		panel.icon := :MakeIcon();
		:MakeChildren();
		RegPrefs(kAppSymbol, panel);
	end,
}
