# The T-Deck Pro: 16 MB quad flash, 8 MB quad PSRAM (not the octal LilyGO's
# README says - tools/tdeck/spike found it), the console on the ESP32-S3's
# own USB serial/JTAG port, 240 MHz.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
# (malloc reaches the PSRAM; a block bigger than 4 KB goes there, so the
#  kernel heap does and the internal SRAM is left for stacks and DMA)
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# the largest data cache, with 64-byte lines: the interpreter walks objects
# all over megabytes of PSRAM and flash, and a miss costs a microsecond
# or two (docs/host-tdeck-pro.md, "What the device spike showed")
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# the reconstruction: C++ exceptions (newton_try is setjmp-based, but the
# host's task runtime redirects and a few re-expressions throw), RTTI (one
# typeid), and optimised for speed
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# (a script may keep the processor as long as it likes)
CONFIG_ESP_TASK_WDT_EN=n
# the flash in quad I/O, as the chip can (dual I/O, the default, halves a
# cache miss's reading - and the ROM's objects are read from it)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# the Newton's tasks' stacks in PSRAM (twenty-odd of 48 KB: the internal RAM
# has room for a few) - xTaskCreateStatic with a PSRAM stack
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# a millisecond tick: the Newton's timers and sleeps are finer than 10 ms
CONFIG_FREERTOS_HZ=1000
# the WiFi (tdeck_wifi.cpp) in as little internal RAM as it can: its
# buffers and lwIP's in PSRAM, few static receive buffers, its code and
# lwIP's left in flash rather than IRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# statics in PSRAM: the WiFi's and lwIP's, and the tree's large buffers
# (HOST_LARGE_STATIC, host/host_compat.h)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_RX_BA_WIN=6
# ESP-IDF's event task (2304 bytes by default) overflowed when an address
# was got from the network (its own handlers and ours): 4 KB
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# power management (tdeck_power.cpp): the processor's clock scaled down to
# 80 MHz while nothing holds it up (the Newton holds 240 MHz while it runs)
# and the chip in light sleep between FreeRTOS's ticks when every task is
# waiting - except while the USB console is connected (the USB serial/JTAG
# does not work across light sleep: its connection monitor holds it off)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# (and the pins left as they are while asleep: ESP-IDF's workaround for an
#  ESD reset isolates every GPIO in light sleep, which would let go of the
#  power switches of the GPS, the 4G module and the LoRa radio, the panel's
#  and the radio's chip selects and the keyboard's light)
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n
# (each lock's time held and the time in each mode - light sleep among them -
#  printed by the console's !pm: tdeck_power.cpp)
CONFIG_PM_PROFILING=y
