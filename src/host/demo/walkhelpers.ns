// What the walkthroughs share (walkthrough.ns, walkthrough2.ns), run by
// HostInclude("walkhelpers.ns") after common.ns: finding views by their
// text, the pen and the keys, the soups, and the steps - a list of
// functions each called with the one to call when it is done, run by
// wtNext, checked by wtCheck ("walkthrough: <step>: ok" or "FAILED").
// The globals have names ROM scripts do not use: a ROM script that reads
// a free variable (index, next, open, wait...) finds a demo's global of
// that name.

findView := func(v, test) begin
	local found := nil;
	if call test with (v) then found := v
	else foreach child in v:ChildViewFrames() do
		if not found then found := call findView with (child, test);
	found;
end;

// (a label's text may carry an invisible character: the Assist slip's
// "Please" is seven long)
hasText := func(t) func(v) IsString(v.text) and StrPos(v.text, t, 0);
viewWithText := func(t) call findView with (GetRoot(), call hasText with (t));

typeStr := func(codes) foreach c in codes do call typeKey with (c);

stroke := func(points) begin
	PenDown(points[0], points[1]);
	for i := 2 to Length(points) - 2 by 2 do PenMove(points[i], points[i + 1]);
	PenUp();
end;

oval := func(cx, cy, rx, ry) begin
	local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
	local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
	local pts := [];
	for k := 0 to 12 do begin
		AddArraySlot(pts, cx + (rx * c[k]) div 100);
		AddArraySlot(pts, cy - (ry * s[k]) div 100);
	end;
	pts;
end;

// "ton" on a baseline at y = base, from x = 60 (as write.ns writes it)
ton := func(base)
	[[66, base - 24, 66, base - 18, 66, base - 12, 66, base - 6, 66, base],
	 [60, base - 14, 64, base - 14, 68, base - 14, 72, base - 14],
	 call oval with (82, base - 7, 6, 7),
	 [94, base - 14, 94, base - 7, 94, base, 94, base - 7,
	  95, base - 11, 97, base - 13, 100, base - 14, 103, base - 13,
	  104, base - 10, 104, base - 5, 104, base]];

// a soup's entries, as an array
soupEntries := func(soupName) begin
	local r := [];
	local c := Query(GetUnionSoup(soupName), {type: 'index});
	local e := c:Entry();
	while e do begin AddArraySlot(r, e); e := c:Next(); end;
	r;
end;

anyEntry := func(soupName, test) begin
	local found := nil;
	foreach e in call soupEntries with (soupName) do
		if not found and call test with (e) then found := e;
	found;
end;

noteText := func(e) begin
	local s := "";
	if e.data then foreach p in e.data do
		if HasSlot(p, 'text) and IsString(p.text) then s := s & p.text;
	s;
end;

// The steps are a list of actions, each a function that is called with
// the function to call when it is done.  `tap` taps and then waits for a
// test (the thing the tap should bring up); `tapLine` taps an input line
// and waits for the caret to be in it.
wtName := "walkthrough";		// what a step's line starts with (a demo of its own sets it)
wtIndex := 0;
wtFailures := 0;
wtSteps := nil;

wtNext := func() begin
	if wtIndex < Length(wtSteps) then begin
		local s := wtSteps[wtIndex];
		wtIndex := wtIndex + 1;
		call s with (wtNext);
	end;
end;

wtCheck := func(name, ok, why) begin
	if ok then Print(wtName & ": " & name & ": ok")
	else begin
		wtFailures := wtFailures + 1;
		Print(wtName & ": " & name & ": FAILED " & why);
	end;
end;

shotStep := func(file) func(done) begin
	ScreenSnapshot("build/walkthrough-" & file & ".pgm");
	call done with ();
end;

tapStep := func(what, x, y, test) func(done) begin
	call tapAt with (x, y);
	call waitFor with (wtName & ": " & what, test, done, 20);
end;

// the caret has come to (x, y): in a view there, on that line
keyViewAt := func(x, y) func() begin
	local k := GetKeyView();
	local c := GetCaretBox();
	if k and c then begin
		local b := k:GlobalBox();
		x >= b.left and x < b.right and y >= b.top and y < b.bottom
			and c.top <= y + 12 and c.bottom >= y - 12;
	end;
end;

tapLineStep := func(what, x, y) call tapStep with (what, x, y, call keyViewAt with (x, y));

// a moment for the application's idle to run what was just done (the
// pen's units go through the recogniser's arbitration there)
settleStep := func(done) AddDelayedCall(done, nil, 600);

keysStep := func(codes) func(done) begin
	call typeStr with (codes);
	call settleStep with (done);
end;

doStep := func(fn) func(done) begin
	call fn with ();
	call done with ();
end;

waitStep := func(what, test) func(done) call waitFor with (wtName & ": " & what, test, done, 30);

isOpen := func(sym) func() begin local v := GetRoot().(sym); v and v.viewCObject; end;
isClosed := func(sym) func() begin local v := GetRoot().(sym); not (v and v.viewCObject); end;
