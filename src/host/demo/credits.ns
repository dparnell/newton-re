// The About slip's credits (MakePict): the ROM's about slip (@152) opened
// for an application whose aboutInfo has a credits list - the MP2x00 ships
// none, so this one is made up - shows its basic information, and after
// eight seconds idle closes that and opens its credits view, whose
// viewSetupDoneScript makes every line a text shape (a line starting with
// '%' a heading in bold) and records them all into one picture with
// MakePict; its viewDrawScript draws the picture with CopyBits, scrolled a
// step every five seconds by its viewIdleScript.  Run from the repository
// root:
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 --script src/host/demo/credits.ns --headless 40
//   python tools/imaging/pgm2png.py build/credits.pgm build/credits.png

app := {
	title: "Reconstruction",
	appName: "Reconstruction",
	aboutInfo: {
		tagLine: "The reconstruction",
		version: "1.0",
		copyright: "(c) the Newton RE project",
		credits: [
			"%Picture playback",
			"ParsePicCodes",
			"DrawPicture",
			"%Picture recording",
			"OpenPicture",
			"ClosePicture",
			"MakePict",
			"%Scaling",
			"TQDScaler",
			"%Thanks",
			"Apple's Newton team"]},
	allSoups: []};

// the Setup assistant walked through first, as open-apps.ns does (a
// modal slip keeps the idlers from running)

HostInclude("common.ns");			// tapAt, typeKey, waitFor, walkSetup

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes


call walkSetup with (name, func() begin
		about := call @152.New with (app, nil, nil);
		Print("credits: the about slip is open");
		// (the slip changes to its credits by itself after eight seconds
		// idle: waited for until the credits' picture is made)
		call waitFor with ("credits: the credits shown", func() about.creditPict, func() begin
				if about.creditPict then
					begin
						local b := ShapeBounds(about.creditPict);
						Print("credits: creditPict " & (b.right - b.left) & " by " & (b.bottom - b.top) & ", creditHeight " & about.creditHeight);
					end
				else
					Print("credits: no picture");
				ScreenSnapshot("build/credits.pgm");
				Print("credits: written build/credits.pgm");
				Print("credits: done");
				HostQuit();
			end, 60);
	end);
