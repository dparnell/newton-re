// Ink: a stroke drawn with the pen, and the page keeping it.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --scale 2 --store build/newton.store --script src/host/demo/ink.ns
//
// or, without a window:
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --store build/newton.store --script src/host/demo/ink.ns --headless 50
//   build/venv/Scripts/python tools/imaging/pgm2png.py build/ink-kept.pgm build/ink-kept.png
//
// With a window, just drag the mouse across the page: the ink follows it,
// and stays when the pen is lifted.  What draws it while the pen is down
// is TStroke::Draw over InkerLine (qd/Draw.h), reached from StrokeTime as
// the ROM's inker task reaches it from TInker::LCDEntry; what keeps it
// afterwards is the word recogniser deciding it cannot read the writing
// (recognition/InkRecognizer.h) and the edit view putting it down as a
// paragraph of one ink word (views/EditView.h's aeInkWord).
//
// The setup assistant is walked through first (src/host/demo/setup.ns, the
// same taps), because the host's store is in memory and every boot starts
// there; without it the stroke lands on the "Enter your Name" page.
//
// Two pictures are taken: build/ink.pgm with the pen still down, which is
// what the inker drew, and build/ink-kept.pgm a few seconds after the pen
// is lifted, which is what the page kept.  The two differ: the writing is
// brought down to a size a line of text can hold, and the ROM starts it at
// the middle of the box it was written in.
//
// IdleStrokes() must not be called while the pen is down.  It runs the
// click through to the view under it, and a view that tracks the pen waits
// for the pen to come up - which only this script could queue, and it is
// the thing that is waiting.  The inker task pumps the queued pen records
// every tick on its own, so nothing here needs to.

tapAt := func(x, y) begin PenDown(x, y); PenUp(); IdleStrokes(); end;
typeKey := func(code) begin KeyEvent(code, true); KeyEvent(code, nil); end;

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

page := 0;
nextPage := func()
  begin
    page := page + 1;
    if page < 10 then
      begin
        call tapAt with (293, 468);			// Continue
        AddDelayedCall(nextPage, nil, 1800);
      end
    else
      call tapAt with (297, 468);			// Done, on "Congratulations"
  end;

AddDelayedCall(func() begin
    call tapAt with (293, 468);				// past "Welcome"
    AddDelayedCall(func() begin
        call tapAt with (200, 150);			// the caret into the First line
        foreach c in name do call typeKey with (c);
        AddDelayedCall(nextPage, nil, 1500);
      end, nil, 2000);
  end, nil, 3000);

// the Notepad is up by now: a stroke across it, and its picture while the
// pen is still down
AddDelayedCall(func() begin
    PenDown(60, 160);
    for i := 1 to 30 do
      PenMove(60 + i * 5, 160 + (i * i) div 12);
    AddDelayedCall(func() begin
        ScreenSnapshot("build/ink.pgm");
        Print("ink: written build/ink.pgm");
        PenUp();
        IdleStrokes();
        // the word is not finished with until the pen has been still for
        // the domain's delay, and the arbiter then has to let it win
        AddDelayedCall(func() begin
            ScreenSnapshot("build/ink-kept.pgm");
            Print("ink: written build/ink-kept.pgm");
          end, nil, 5000);
      end, nil, 900);
  end, nil, 27000);
Print("ink: the script is loaded");
