// Cursive: the writer's letter set made a cursive one, so ParaGraph's
// cursive recogniser (the 'STXR' and 'XRWR' domains) reads the page in
// place of Rosetta, and "ton" and "to" written on the Notepad.
//
//   NEWTON_TRACE_CURSIVE=1 build/host/host/newton --rom build/MP2x00US/rom.bin
//       --display 320x480 --script src/host/demo/cursive.ns --headless 50
//
// The words are grouped by ParaGraph's word segmenter into two word
// descriptors and each is given to the reader (GCTryToRecognize): the
// low level cuts it into xrs and xrw_algs reads them into a word graph
// ("[cursive] xrw_algs: graph ..."), the graph is made into the readings
// ("[cursive] answers: ..."), and the XRWR domain hands the best of them
// to the page as a word unit, which types it: the page reads "ton to"
// ("For to" until FillSHR's shift classes were put right - see
// docs/recognition/README.md, "Joined-up writing").  "[cursive] word of strokes
// ..." lines say how far each word got, the script prints the page's
// text (ctest host.NewtonCursive checks both), and build/cursive.pgm is
// the page.  Then "ton" is read again with learning on and learnt
// ("[cursive] learning: ..."), and the letter weights are no longer the
// defaults.  Otherwise as src/host/demo/write.ns.
//
// This run once locked up one time in three, in the heap's compaction:
// CreateTrigramHeader asked for the ROM's 0x98 bytes and zeroed the
// host's larger header over the next block (fixed; NEWTON_HEAPCHECK,
// host/HostHeapCheck.h, is how it was found).

HostInclude("common.ns");			// tapAt, typeKey, waitFor, walkSetup

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

// One stroke: the pen put down on the first point, moved through the
// rest, and lifted.
stroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

// the text of the first paragraph under a view whose text starts with
// `prefix`
findText := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v.text
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call findText with (child, prefix);
    found;
  end;

// An oval of `n` points, from the top going anticlockwise, as an o is
// written.  (Twelfths of a turn, worked out once: cos and sin of 30n.)
oval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// Learning: with learning on (the Handwriting Settings' "learning"
// check box), "ton"'s strokes read again (Recognize) keep their training
// data, and the word info's Learn(0) - what picking a word in the
// corrector does - hands the reading and the pen's trace
// (GetTraceFromStrokes) to the word domain, which moves the letter
// weights on the fly (FlyLearn): GetLetterWeights answers nil while they
// are the letter set's defaults and the weights once learnt.
yx := func(points)
  begin
    local out := [];
    for i := 0 to Length(points) - 2 by 2 do
      begin
        AddArraySlot(out, points[i + 1]);
        AddArraySlot(out, points[i]);
      end;
    out;
  end;
tonStrokes := nil;
learn := func()
  begin
    SetUserConfig('learningEnabledOption, true);
    // (with the "big" learning on too, the reader also ties each letter
    // of the word to the trace - its orthographic learn array, 'ORTL' -
    // and learning trains the letters' shapes into the orthographic
    // database: "[cursive] orthographic learn array" and "[cursive]
    // learning: ... trained into the orthographic database")
    SetUserConfig('bigLearningEnabled, true);
    ReadCursiveOptions();
    local strokes := [];
    foreach s in tonStrokes do AddArraySlot(strokes, call yx with (s));
    local ci := Recognize([MakeStrokeBundle(strokes, 0)], nil, nil);
    if ci and Length(ci.info) > 0 then
      begin
        local info := ci.info[0];
        Print("cursive: read again as \"" & info.words[0].word & "\"");
        local before := GetLetterWeights();
        // (a word put on a page is marked as carrying its training data
        // by the paragraph - SetOffsetInfo's flags; one read by Recognize
        // is marked here)
        if info.unitData then info:SetFlags(1);
        Print("cursive: the word info " & (if info.unitData then "keeps" else "has no") & " training data");
        info:Learn(0);
        local after := GetLetterWeights();
        Print("cursive: the letter weights " & (if before then "had been learnt" else "were the defaults")
              & ", after learning " & (if after then "learnt" else "the defaults"));
      end
    else
      Print("cursive: read again as nothing");
    Print("cursive: done");
    HostQuit();
  end;

// "ton", on a baseline at y = 200, from x = 60 - the letter set made
// cursive first
call walkSetup with (name, func() begin
    local base := 200;
    SetUserConfig('letterSetSelection, 0);
    ReadCursiveOptions();
    Print("cursive: the letter set is" && GetUserConfig('letterSetSelection));
    // t: the stem, then the bar; o; n: down, back up, over the arch and
    // down again
    tonStrokes := [[66, base - 24, 66, base - 18, 66, base - 12, 66, base - 6, 66, base],
                   [60, base - 14, 64, base - 14, 68, base - 14, 72, base - 14],
                   call oval with (82, base - 7, 6, 7),
                   [94, base - 14, 94, base - 7, 94, base, 94, base - 7,
                    95, base - 11, 97, base - 13, 100, base - 14, 103, base - 13,
                    104, base - 10, 104, base - 5, 104, base]];
    foreach s in tonStrokes do call stroke with (s);
    // "to", a word's gap further along the line, once the recogniser has
    // put "ton" down
    call waitFor with ("cursive: ton read", func() call findText with (GetRoot(), "ton"), func() begin
        local x := 130;
        call stroke with ([x + 6, base - 24, x + 6, base - 18, x + 6, base - 12, x + 6, base - 6, x + 6, base]);
        call stroke with ([x, base - 14, x + 4, base - 14, x + 8, base - 14, x + 12, base - 14]);
        call stroke with (call oval with (x + 22, base - 7, 6, 7));
        ScreenSnapshot("build/cursive-ink.pgm");
        Print("cursive: written build/cursive-ink.pgm");
        IdleStrokes();
        call waitFor with ("cursive: to read", func() StrEqual(call findText with (GetRoot(), ""), "ton to"), func() begin
            ScreenSnapshot("build/cursive.pgm");
            Print("cursive: written build/cursive.pgm");
            Print("cursive: the page reads \"" & call findText with (GetRoot(), "") & "\"");
            call learn with ();
          end, 60);
      end, 60);
  end);
Print("cursive: the script is loaded");
