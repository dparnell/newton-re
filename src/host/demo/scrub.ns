// Scrubbing: "ton" is written on the Notepad and read, then scrubbed out
// with a zigzag.  The word goes and nothing takes its place - the scrub is
// a gesture (the edge-list domain's 'SCRB', TParagraphView::HandleScrub),
// not writing.
//
//   build/host/host/newton --display 320x480 --headless 90 --script src/host/demo/scrub.ns
//
// Prints "scrub: <step>: ok" or "FAILED", and "scrub: done" (ctest
// host.NewtonScrub).  build/scrub-before.pgm and build/scrub.pgm are the page.

HostInclude("common.ns");			// tapAt, waitFor, walkSetup
HostInclude("penhelpers.ns");		// penWriteWord, penFindPara, penStroke

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
scrubFailures := 0;

scrubCheck := func(what, ok)
  begin
    if not ok then scrubFailures := scrubFailures + 1;
    Print("scrub: " & what & (if ok then ": ok" else ": FAILED"));
  end;

// nothing left on the page: no paragraph of "ton", no ink
scrubbed := func()
  begin
    not call penFindPara with (GetRoot(), "ton") and not call penFindPara with (GetRoot(), nil)
    and Length(call penFindShapes with (GetRoot(), [])) = 0;
  end;

call walkSetup with (name, func() begin
    local base := 200;
    call penWriteWord with ("ton", 60, base);
    local up := Ticks();
    IdleStrokes();
    call waitFor with ("scrub: ton", func() Ticks() - up > 40 and call penFindPara with (GetRoot(), "ton"), func() begin
        local para := call penFindPara with (GetRoot(), "ton");
        call scrubCheck with ("\"ton\" read", para <> nil);
        if not para then
          begin
            Print("scrub: done, " & scrubFailures & " failed");
            return HostQuit();
          end;
        ScreenSnapshot("build/scrub-before.pgm");
        // the scrub: back and forth across the word
        local b := para:GlobalBox();
        local pts := [];
        for k := 0 to 7 do
          begin
            AddArraySlot(pts, if k mod 2 = 0 then b.left - 4 else b.right + 4);
            AddArraySlot(pts, b.top + 6 + k * 2);
          end;
        call penStroke with (pts);
        IdleStrokes();
        call waitFor with ("scrub: scrubbed", scrubbed, func() begin
            call scrubCheck with ("the word scrubbed out, nothing in its place", call scrubbed with ());
            ScreenSnapshot("build/scrub.pgm");
            Print("scrub: done, " & scrubFailures & " failed");
            HostQuit();
          end, 20);
      end, 20);
  end);
