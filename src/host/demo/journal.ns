// The journal: a word written while recording, then played back.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --script src/host/demo/journal.ns --headless 60
//
// The setup assistant is walked through (as src/host/demo/write.ns does)
// and "ton" written on the Notepad while the journal records
// (testing/Journal.h): JournalStartRecord sends each finished stroke to
// the recorder frame below as a JournalStroke binary - the stroke's times
// and its tablet sample words.  Recording stopped, the four strokes are
// made into a stroke file (a 0x18-byte header and each stroke's own
// bytes end to end) and played back with JournalReplayStrokes, 80 pixels
// lower down: the journal puts their samples into the tablet buffer at
// the pace they were written (the tablet bypassed meanwhile), the
// recogniser reads them as it read the pen, and the words go where the
// caret is, after the first "ton".  A replayed stroke loses its last point
// to the pen-up, as on the machine, so the n comes back without the end
// of its last leg - and is read as "tor".  (The word, written 80 pixels
// below any text, goes in at the caret with no child of the page having
// asked for it; TEditView::HandleWord answers a leftover register there,
// as the ROM does, and that is what stops the recogniser turning the
// word's strokes into ink as well.)
//
// The journal is played by the test agent's idle proc (testing/
// TestAgent.h), so the agent is started first - with this script as its
// test manager ("*"), which makes it idle every fifty milliseconds - and
// stopped at the end, which also ends the tablet's bypass.  (Played one
// stroke at a time with JournalReplayAStroke, the strokes come three
// seconds apart - the agent idles that long after each replay ends - and
// are read as four words; a file keeps them together at their own pace.)
//
// It prints lines starting "journal:"; ctest's host.NewtonJournal checks
// them.  build/journal.pgm is the page at the end.

tapAt := func(x, y) begin PenDown(x, y); PenUp(); IdleStrokes(); end;
typeKey := func(code) begin KeyEvent(code, true); KeyEvent(code, nil); end;

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

page := 0;
nextPage := func()
  begin
    page := page + 1;
    if page < 10 then
      begin
        call tapAt with (293, 468);			// Continue
        AddDelayedCall(nextPage, nil, 1800);
      end
    else
      call tapAt with (297, 468);			// Done, on "Congratulations"
  end;

AddDelayedCall(func() begin
    call tapAt with (293, 468);				// past "Welcome"
    AddDelayedCall(func() begin
        call tapAt with (200, 150);			// the caret into the First line
        foreach c in name do call typeKey with (c);
        AddDelayedCall(nextPage, nil, 1500);
      end, nil, 2000);
  end, nil, 3000);

stroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

oval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

base := 200;
ton := [[66, base - 24, 66, base - 18, 66, base - 12, 66, base - 6, 66, base],
        [60, base - 14, 64, base - 14, 68, base - 14, 72, base - 14],
        call oval with (82, base - 7, 6, 7),
        [94, base - 14, 94, base - 7, 94, base, 94, base - 7,
         95, base - 11, 97, base - 13, 100, base - 14, 103, base - 13,
         104, base - 10, 104, base - 5, 104, base]];

// the journal's recorder: each stroke comes as [binary, size]
recorder := {
    strokes: [],
    Record: func(binary, size) AddArraySlot(strokes, binary),
    Start: func() JournalStartRecord('Record, 1)};

// the text of the paragraph under a view whose text starts with `prefix`
findText := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v.text
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call findText with (child, prefix);
    found;
  end;

// the test manager the agent is started with
testMgr := {
    testMgrCaseDoneScript: func() nil,
    testMgrFrameDoneScript: func() nil,
    Start: func() ActivateTestAgent("*", nil)};	// (self, this frame, becomes the manager)

// the recorded strokes as a stroke file: the header (format 1 at +2, the
// count at +4, the sample rate at +6) and each stroke's own bytes - its
// size is its first word (a recorded binary is eight bytes longer)
strokeFile := func(strokes)
  begin
    local file := SetLength(MakeBinary(0, 'journal), 0x18);
    for i := 0 to 0x17 do StuffByte(file, i, 0);
    StuffWord(file, 2, 1);
    StuffWord(file, 4, Length(strokes));
    StuffWord(file, 6, 100);
    foreach s in strokes do
      file := BinaryMunger(file, Length(file), 0, s, 0, ExtractLong(s, 0));
    file;
  end;

// the file played back, 80 pixels lower, and the page read afterwards
replay := func()
  begin
    local err := JournalReplayStrokes(call strokeFile with (recorder.strokes), 0, 80, 0);
    if err <> 0 then
      Print("journal: the strokes not played (" & err & ")");
    local waitForIt;
    waitForIt := func()
      if JournalReplayBusy() then
        AddDelayedCall(waitForIt, nil, 100)
      else
        AddDelayedCall(func() begin
            IdleStrokes();
            AddDelayedCall(func() begin
                Print("journal: after the replay the page reads \"" & call findText with (GetRoot(), "ton") & "\"");
                ScreenSnapshot("build/journal.pgm");
                DeactivateTestAgent();
                Print("journal: done");
              end, nil, 5000);
          end, nil, 1000);
    AddDelayedCall(waitForIt, nil, 100);
  end;

AddDelayedCall(func() begin
    Print("journal: recording " & (if recorder:Start() = 0 then "started" else "refused"));
    foreach s in ton do call stroke with (s);
    AddDelayedCall(func() begin
        IdleStrokes();
        JournalStopRecord();
        Print("journal: " & Length(recorder.strokes) & " strokes recorded");
        AddDelayedCall(func() begin
            Print("journal: before the replay the page reads \"" & call findText with (GetRoot(), "ton") & "\"");
            ScreenSnapshot("build/journal-before.pgm");
            testMgr:Start();
            call replay with ();
          end, nil, 3000);
      end, nil, 1500);
  end, nil, 27000);
Print("journal: the script is loaded");
