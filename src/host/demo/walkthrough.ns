// A first hour with a MessagePad: what a person does with a new machine,
// done the way they would do it - with the pen and the keyboard, on the
// screen - and each step checked and photographed.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --erase --store build/walkthrough.store --headless 300 \
//       --script src/host/demo/walkthrough.ns
//   (and again without --erase: the restart)
//
// The first run, on an erased store, walks the Setup assistant and then:
//
//    1 note        "ton" written on the Notepad and read, and the note
//                  read back out of the Notes soup
//    2 names       a Names card made with New > Person and typed in -
//                  first and last name, a home phone, and the Work line
//                  turned into a Fax line
//    3 find        Find, "tester", Everywhere: one item found, the card
//    4 dates       Dates, a tap on a line and "lunch" typed: a
//                  meeting in the Calendar soup and in the day view
//    5 todo        Show > To Do List, New > To Do Task, "shop milk"
//    6 scrub       the to-do scrubbed out with the pen: gone from the
//                  list and from the soup
//    7 assist      Assist, "call ann", Do: the Call slip, addressed to Ann
//    8 route       the note faxed Later to Ann: an item in the Out Box,
//                  and the In/Out Box showing it
//    9 file        the note filed in Business
//   10 calculator  Extras > Calculator, 2 + 3 =: 5
//   11 volume      the Extras drawer's volume slider pulled down to 1
//
// The second run starts on the same store without Setup and checks that
// all of it is still there - the volume first, which is kept in the
// System soup's user configuration.
//
// Each step prints "walkthrough: <step>: ok" or "walkthrough: <step>:
// FAILED <why>" and writes build/walkthrough-<n>-<step>.pgm (the restart:
// build/walkthrough-restart.pgm); tools/imaging/pgm2png.py makes PNGs.
// The clock is the host's: the note is dated today (the ROM's own
// year-2010 overflow would date it 1992 - intl/Dates.h's fix).
//
// Everything waits on what it waits for (a view open, a key view moved,
// an entry in a soup) rather than for a fixed time.

HostInclude("common.ns");			// tapAt, typeKey, waitFor, walkSetup
HostInclude("walkhelpers.ns");		// the views, the pen and keys, the soups, the steps

// minutes at the hour today
todayAt := func(hour) begin
	local d := Date(Time());
	TotalMinutes({year: d.year, month: d.month, date: d.date, hour: hour, minute: 0});
end;

// ADB key codes
kAnn := [0, 45, 45];
kTester := [17, 14, 1, 17, 14, 15];
kHome := [23, 23, 23, 18, 19, 20, 21];		// 5551234
kFax := [23, 23, 23, 25, 28, 26, 22];		// 5559876
kLunch := [37, 32, 45, 8, 4];
kShopMilk := [1, 4, 31, 35, 49, 46, 34, 37, 40];
kCallAnn := [8, 0, 37, 37, 49, 0, 45, 45];


// --- the first hour -------------------------------------------------------

wtFirstHour := [
	// 1 a note, written and read back
	func(done) begin
		foreach s in call ton with (200) do call stroke with (s);
		IdleStrokes();
		call done with ();
	end,
	call waitStep with ("the word read", func() call viewWithText with ("ton")),
	call waitStep with ("the note saved", func() call anyEntry with ("Notes", func(e) StrEqual(call noteText with (e), "ton"))),
	func(done) begin
		local e := call anyEntry with ("Notes", func(e) StrEqual(call noteText with (e), "ton"));
		call wtCheck with ("note", e and Abs(e.timestamp - Time()) < 24 * 60,		// dated today
			if e then "dated " & DateNTime(e.timestamp) else "no note reads \"ton\"");
		call done with ();
	end,
	call shotStep with ("1-note"),

	// 2 a Names card, typed in
	call tapStep with ("Names", 100, 460, call isOpen with ('cardfile)),
	call tapStep with ("New", 82, 416, func() call viewWithText with ("Person") or GetRoot():ChildViewFrames()[Length(GetRoot():ChildViewFrames()) - 1].viewClass = 91),
	call tapStep with ("Person", 100, 358, func() GetKeyView() <> nil),
	settleStep,
	call keysStep with (kAnn),
	call tapLineStep with ("the Last line", 150, 200),
	call keysStep with (kTester),
	call tapLineStep with ("the Home line", 200, 280),
	call keysStep with (kHome),
	call tapStep with ("the Work label", 30, 322, func() true),
	settleStep,
	call tapStep with ("Fax", 68, 364, func() true),
	settleStep,
	call tapLineStep with ("the Fax line", 200, 320),
	call keysStep with (kFax),
	call shotStep with ("2-names-card"),
	call tapStep with ("close the card", 300, 414, func() call anyEntry with ("Names", func(e) e.name and IsString(e.name.last) and StrEqual(e.name.last, "tester"))),
	func(done) begin
		local e := call anyEntry with ("Names", func(e) e.name and IsString(e.name.last) and StrEqual(e.name.last, "tester"));
		local phones := if e and e.phones then foreach p in e.phones collect p;
		call wtCheck with ("names",
			e and StrEqual(e.name.first, "ann") and phones and Length(phones) = 2
				and StrEqual(phones[0], "5551234") and ClassOf(phones[0]) = 'homePhone
				and StrEqual(phones[1], "5559876") and ClassOf(phones[1]) = 'faxPhone,
			if e then begin
				local why := "the card's phones:";
				if phones then foreach p in phones do why := why & " " & p & " (" & ClassOf(p) & ")";
				why;
			end else "no card for tester");
		call done with ();
	end,
	settleStep,
	call shotStep with ("2-names"),

	// 3 Find
	call tapStep with ("Find", 220, 460, func() call viewWithText with ("Look for")),
	call keysStep with (kTester),
	call tapStep with ("Everywhere", 78, 380, func() true),
	settleStep,
	call tapStep with ("the Find button", 274, 396,
		func() call findView with (GetRoot(), func(v) IsString(v.text) and StrPos(v.text, "found", 0))),
	func(done) begin
		local found := call findView with (GetRoot(), func(v) IsString(v.text) and StrPos(v.text, "found", 0));
		call wtCheck with ("find", found and StrEqual(found.text, "One item was found."),
			if found then "\"" & found.text & "\"" else "no result");
		call done with ();
	end,
	call shotStep with ("3-find"),
	call doStep with (func() foreach sym in ['findDrawer, 'cardfile] do
		if GetRoot().(sym) and GetRoot().(sym).viewCObject then GetRoot().(sym):Close()),
	settleStep,

	// 4 Dates: a meeting typed on the day view
	call tapStep with ("Dates", 140, 460, call isOpen with ('calendar)),
	call tapLineStep with ("a line of the day view", 150, 225),
	call keysStep with (kLunch),
	call tapStep with ("off the meeting", 160, 330, func() call anyEntry with ("Calendar", func(e) IsString(e.mtgText) and StrEqual(e.mtgText, "lunch"))),
	func(done) begin
		local e := call anyEntry with ("Calendar", func(e) IsString(e.mtgText) and StrEqual(e.mtgText, "lunch"));
		local shown := call findView with (GetRoot(), func(v) v.viewClass = 95);
		call wtCheck with ("dates",
			// (the day view opens scrolled to the time of day, so the line
			// tapped is whichever hour is there: today, on the hour)
			e and e.mtgStartDate >= call todayAt with (0) and e.mtgStartDate < call todayAt with (24)
				and e.mtgStartDate mod 60 = 0 and shown,
			if e then "at " & DateNTime(e.mtgStartDate) & (if shown then "" else ", not in the day view") else "no meeting");
		call done with ();
	end,
	call shotStep with ("4-dates"),

	// 5 a To Do
	call tapStep with ("Show", 153, 424, func() call viewWithText with ("To Do List") or true),
	settleStep,
	call tapStep with ("To Do List", 170, 378, func() call findView with (GetRoot(), func(v) v.viewClass = 99)),
	call tapStep with ("New", 112, 424, func() true),
	settleStep,
	call tapStep with ("To Do Task", 150, 407, func() GetKeyView() <> nil),
	settleStep,
	call keysStep with (kShopMilk),
	call tapStep with ("close the task", 281, 345, func() call anyEntry with ("To do List", func(e) e.topics and Length(e.topics) > 0)),
	settleStep,
	func(done) begin
		local e := call anyEntry with ("To do List", func(e) e.topics and Length(e.topics) > 0);
		local text := if e then e.topics[0].text;
		call wtCheck with ("todo", IsString(text) and StrEqual(text, "shop milk") and call viewWithText with ("shop milk"),
			if e then "the topic reads " & text else "no to-do");
		call done with ();
	end,
	call shotStep with ("5-todo"),

	// 6 the to-do scrubbed out
	func(done) begin
		local pts := [];
		for k := 0 to 7 do begin
			AddArraySlot(pts, if k mod 2 = 0 then 40 else 110);
			AddArraySlot(pts, 82 + k * 2);
		end;
		call stroke with (pts);
		IdleStrokes();
		call done with ();
	end,
	call waitStep with ("the to-do gone", func() not call viewWithText with ("shop milk")),
	settleStep,
	func(done) begin
		local left := call anyEntry with ("To do List", func(e) e.topics and Length(e.topics) > 0);
		call wtCheck with ("scrub", not left and not call viewWithText with ("shop milk"),
			if left then "the soup still has a topic" else "the list still shows it");
		call done with ();
	end,
	call shotStep with ("6-scrub"),
	call doStep with (func() GetRoot().calendar:Close()),
	settleStep,

	// 7 the Assistant (the caret out of the note's paragraph first: with the
	// caret in a paragraph, Assist takes that paragraph's text -
	// GleanIntendedText)
	call tapStep with ("off the note's text", 160, 330, func() true),
	settleStep,
	call tapStep with ("Assist", 260, 460, func() call viewWithText with ("Please")),
	call keysStep with (kCallAnn),
	call tapStep with ("Do", 277, 414, func() call viewWithText with ("Phone")),
	settleStep,
	func(done) begin
		local name := call findView with (GetRoot(), func(v) IsString(v.text) and StrPos(v.text, "ann", 0));
		call wtCheck with ("assist", name, "the Call slip is not addressed to Ann");
		call done with ();
	end,
	call shotStep with ("7-assist"),
	call tapStep with ("close the Call slip", 258, 285, func() not call viewWithText with ("Phone")),
	settleStep,

	// 8 the note faxed later: into the Out Box
	call tapStep with ("the action button", 310, 28, func() call viewWithText with ("Fax") or true),
	settleStep,
	call tapStep with ("Fax", 250, 50, func() call viewWithText with ("Cover Page")),
	call tapStep with ("Name", 95, 178, func() call viewWithText with ("Faxes")),
	settleStep,
	call shotStep with ("8-route-names"),
	call tapStep with ("ann tester", 90, 259, func() true),		// the second row: daniel, ann tester
	settleStep,
	call tapStep with ("close the picker", 267, 420, func() not call viewWithText with ("Faxes")),
	settleStep,
	call tapStep with ("the Fax button", 228, 304, func() true),		// Now or Later
	settleStep,
	call tapStep with ("Later", 232, 289, func() Length(call soupEntries with ("OutBox")) > 0),
	func(done) begin
		local items := call soupEntries with ("OutBox");
		call wtCheck with ("route", Length(items) = 1, NumberStr(Length(items)) & " items in the Out Box");
		call done with ();
	end,
	call tapStep with ("In/Out Box", 60, 460, call isOpen with ('iobox)),
	settleStep,
	call tapStep with ("Out Box", 238, 28, func() true),
	settleStep,
	call shotStep with ("8-route"),
	call doStep with (func() GetRoot().iobox:Close()),
	settleStep,

	// 9 the note filed in Business
	call tapStep with ("the folder button", 292, 28, func() call viewWithText with ("Business") or true),
	settleStep,
	call tapStep with ("Business", 70, 221, func() true),
	settleStep,
	call tapStep with ("File", 232, 243, func() call anyEntry with ("Notes", func(e) e.labels = 'Business)),
	func(done) begin
		local e := call anyEntry with ("Notes", func(e) e.labels = 'Business);
		call wtCheck with ("file", e and StrEqual(call noteText with (e), "ton"), "no note in Business");
		call done with ();
	end,
	call shotStep with ("9-file"),

	// 10 the Calculator
	call tapStep with ("Extras", 20, 460, call isOpen with ('ExtrasDrawer)),
	call tapStep with ("Calculator", 223, 300, call isOpen with ('calculator)),
	call tapStep with ("2", 125, 300, func() true), settleStep,
	call tapStep with ("+", 193, 329, func() true), settleStep,
	call tapStep with ("3", 158, 300, func() true), settleStep,
	call tapStep with ("=", 229, 300, func() true), settleStep,
	func(done) begin
		local shown := call findView with (GetRoot().calculator, func(v) IsString(v.text) and StrEqual(v.text, "5"));
		call wtCheck with ("calculator", shown, "the display does not read 5");
		call done with ();
	end,
	call shotStep with ("10-calculator"),
	call doStep with (func() GetRoot().calculator:Close()),
	settleStep,

	// 11 the volume turned down to 1 in the Extras drawer (which closed
	// when the Calculator was opened from it)
	call tapStep with ("Extras", 20, 460, call isOpen with ('ExtrasDrawer)),
	settleStep,
	func(done) begin
		call stroke with ([60, 398, 50, 398, 40, 398, 30, 398, 25, 398]);
		IdleStrokes();
		call done with ();
	end,
	call waitStep with ("the volume changed", func() GetUserConfig('soundVolume) = 1),
	func(done) begin
		call wtCheck with ("volume", GetUserConfig('soundVolume) = 1, "the volume is " & GetUserConfig('soundVolume));
		call done with ();
	end,
	call shotStep with ("11-volume"),
	func(done) begin
		Print("walkthrough: done, " & wtFailures & " failed");
		HostQuit();
	end];

// --- the restart ----------------------------------------------------------

wtRestart := [
	call waitStep with ("the Notepad", call isOpen with ('paperroll)),
	settleStep,
	func(done) begin
		call wtCheck with ("restart volume", GetUserConfig('soundVolume) = 1, "the volume is " & GetUserConfig('soundVolume));
		local note := call anyEntry with ("Notes", func(e) e.labels = 'Business);
		call wtCheck with ("restart note", note and StrEqual(call noteText with (note), "ton"), "the filed note is gone");
		local card := call anyEntry with ("Names", func(e) e.name and IsString(e.name.last) and StrEqual(e.name.last, "tester"));
		call wtCheck with ("restart names", card, "Ann's card is gone");
		local mtg := call anyEntry with ("Calendar", func(e) IsString(e.mtgText) and StrEqual(e.mtgText, "lunch"));
		call wtCheck with ("restart dates", mtg, "the meeting is gone");
		call wtCheck with ("restart outbox", Length(call soupEntries with ("OutBox")) = 1, "the Out Box has " & Length(call soupEntries with ("OutBox")));
		call done with ();
	end,
	call tapStep with ("Extras", 20, 460, call isOpen with ('ExtrasDrawer)),
	settleStep,
	call shotStep with ("restart"),
	func(done) begin
		Print("walkthrough: restart done, " & wtFailures & " failed");
		HostQuit();
	end];

// a fresh store starts with the Setup assistant, a set-up one with the Notepad
call waitFor with ("walkthrough: the boot",
	func() call (call isOpen with ('setup)) with () or call (call isOpen with ('paperroll)) with (),
	func() begin
		if call (call isOpen with ('setup)) with () then begin
			Print("walkthrough: a new machine");
			wtSteps := wtFirstHour;
			call walkSetup with ([2, 0, 45, 34, 14, 37], wtNext);		// "Daniel"
		end else begin
			Print("walkthrough: the restart");
			wtSteps := wtRestart;
			call wtNext with ();
		end;
	end, 60);
Print("walkthrough: the script is loaded");
