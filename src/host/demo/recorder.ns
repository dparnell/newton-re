// The Sound Recorder, driven through its own buttons: after the Setup walk
// (as setup.ns does) it is opened, Rec is tapped, two seconds of the
// microphone are recorded, Stop is tapped, then Play, and what the
// recorder's status line says at each step is printed - the last once the
// recording has played to its end and the recorder is ready again.  Headless, the
// microphone is the null sound backend's test tone (newton's
// --microphone-tone) and what is played is kept, so newton says at the
// end how much of the playback was that tone.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --script src/host/demo/recorder.ns --headless 45 --microphone-tone 1000
//
// The buttons are at the places the recorder puts them on a 320x480
// screen: Rec (83..130, 182..218), Stop (130..177), Play (177..224).


HostInclude("common.ns");			// tapAt, typeKey, waitFor, walkSetup

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes


recorder := nil;
status := func(step)
  begin
    local text := recorder.statusText.text;
    Print("recorder: " & step & ": " & (if text then text else "-"));
  end;

// the recorder's status line starts with `text` ("Recording...")
says := func(text) begin
    local now := recorder.statusText.text;
    IsString(now) and StrPos(now, text, 0) = 0;
  end;

// Each step once the status line says the one before it has happened; the
// two seconds of recording are the recording's length, not a wait
call walkSetup with (name, func() begin
    recorder := GetRoot().SoundRecorder;
    recorder:Open();
    call waitFor with ("recorder: open", func() call says with ("Ready to record"), func() begin
        call status with ("opened");
        call tapAt with (106, 200);				// Rec
        call waitFor with ("recorder: recording", func() call says with ("Recording"), func() begin
            AddDelayedCall(func() begin
                call status with ("recording");
                call tapAt with (153, 200);			// Stop
                call waitFor with ("recorder: stopped", func() call says with ("Ready to play or record"), func() begin
                    call status with ("stopped");
                    call tapAt with (200, 200);		// Play
                    call waitFor with ("recorder: playing", func() call says with ("Playing"), func() begin
                        call status with ("played");
                        // (the recording played to its end: the sound's
                        // completion goes back to the recorder, which
                        // says so)
                        call waitFor with ("recorder: played to the end", func() not call says with ("Playing"), func() begin
                            call status with ("finished");
                            recorder:Close();
                            Print("recorder: done");
                            HostQuit();
                          end, 60);
                      end, 60);
                  end, 60);
              end, nil, 2000);
          end, 60);
      end, 60);
  end);
Print("recorder: the script is loaded");
