// What the application demos share (apps-*.ns), run by
// HostInclude("apphelpers.ns") after common.ns and walkhelpers.ns: an
// application opened as its user opens it - its icon tapped in the Extras
// drawer - and a button tapped by its label.

// the view whose text is exactly `label` (spaces around it aside)
viewLabelled := func(root, label) call findView with (root, func(v)
	IsString(v.text) and StrEqual(TrimString(Clone(v.text)), label));

tapCentre := func(v) begin
	local b := v:GlobalBox();
	call tapAt with ((b.left + b.right) div 2, (b.top + b.bottom) div 2);
end;

// The open Prefs list's row named `name` tapped (its panel opened); ==>
// whether there was one.  The list draws its rows itself, as shapes kept
// in its `pieces` - each a [text, icon] pair, the text shape's data the
// row's name as a 'textdata binary (a string's characters) and its bounds
// a 'boundsrect binary (top, left, bottom, right halfwords) - so the row is
// found there, not among views, and wherever RegPrefs's alphabetical order
// has put it.
tapPrefsItem := func(name) begin
	local tapped := nil;
	local roll := GetRoot().preferenceRoll;
	if roll.viewCObject then
		foreach list in roll:ChildViewFrames() do
			if list.pieces then
				foreach piece in list.pieces do
					if not tapped and IsArray(piece) and IsFrame(piece[0]) and IsBinary(piece[0].data)
						and StrEqual(SetClass(Clone(piece[0].data), 'string), name) then begin
						local box := list:GlobalBox();
						local r := piece[0].bounds;
						local top := ExtractWord(r, 0), left := ExtractWord(r, 2), bottom := ExtractWord(r, 4);
						call tapAt with (box.left + left + 10, box.top + (top + bottom) div 2);
						tapped := true;
					end;
	tapped;
end;

// the button labelled `label` in `root`, tapped
tapButtonText := func(root, label) begin
	local v := call viewLabelled with (root, label);
	if v then call tapCentre with (v)
	else call wtCheck with ("the " & label & " button", nil, "(not found)");
end;

// the Extras drawer opened, the application's icon tapped (an icon's
// `target` is the drawer's entry for its part, whose `app` is the
// application's symbol), and done() once the application `sym` is open
// (`label` names it in what is printed)
openFromExtras := func(label, sym, done) begin
	local drawer := GetRoot().extrasDrawer;
	drawer:Open();
	call waitFor with (wtName & ": the Extras drawer", func() drawer.viewCObject, func() begin
		local icon := call findView with (drawer, func(v) v.target and v.target.fentry and v.target.fentry.app = sym);
		if not icon then call wtCheck with ("the " & label & " icon", nil, "(not in the drawer)")
		else call tapCentre with (icon);
		call waitFor with (wtName & ": " & label & " open", func() GetRoot().(sym) and GetRoot().(sym).viewCObject, func() begin
			call wtCheck with ("opened from the Extras drawer", GetRoot().(sym).viewCObject, "(did not open)");
			AddDelayedCall(done, nil, 1000);
		end, 30);
	end, 20);
end;

// text typed on the keyboard, a key (ADB key code) a character: letters,
// digits, space, . / - , ; = ' and, shifted, : + " ( ) * < > $ ! ? & # % _
appLetterKeys := {a: 0, s: 1, d: 2, f: 3, h: 4, g: 5, z: 6, x: 7, c: 8, v: 9, b: 11, q: 12, w: 13,
	e: 14, r: 15, y: 16, t: 17, o: 31, u: 32, i: 34, p: 35, l: 37, j: 38, k: 40, n: 45, m: 46};
appDigitKeys := [29, 18, 19, 20, 21, 23, 22, 26, 28, 25];
typeText := func(text) begin
	for i := 0 to StrLen(text) - 1 do begin
		local c := text[i];
		local code := nil, shifted := nil;
		if c >= $0 and c <= $9 then code := appDigitKeys[Ord(c) - Ord($0)]
		else if c = $  then code := 49
		else if c = $. then code := 47
		else if c = $/ then code := 44
		else if c = $- then code := 27
		else if c = $: then begin code := 41; shifted := true; end
		else if c = $, then code := 43
		else if c = $; then code := 41
		else if c = $= then code := 24
		else if c = $' then code := 39
		else if c = $+ then begin code := 24; shifted := true; end
		else if c = $" then begin code := 39; shifted := true; end
		else if c = $( then begin code := 25; shifted := true; end
		else if c = $) then begin code := 29; shifted := true; end
		else if c = $* then begin code := 28; shifted := true; end
		else if c = $< then begin code := 43; shifted := true; end
		else if c = $> then begin code := 47; shifted := true; end
		else if c = $$ then begin code := 21; shifted := true; end
		else if c = $! then begin code := 18; shifted := true; end
		else if c = $? then begin code := 44; shifted := true; end
		else if c = $& then begin code := 26; shifted := true; end
		else if c = $# then begin code := 20; shifted := true; end
		else if c = $% then begin code := 23; shifted := true; end
		else if c = $_ then begin code := 27; shifted := true; end
		else if c >= $A and c <= $Z then begin
			code := GetSlot(appLetterKeys, Intern(SPrintObject(c)));		// (symbols are alike whatever their case)
			shifted := true;
		end
		else code := GetSlot(appLetterKeys, Intern(SPrintObject(c)));
		if shifted then KeyEvent(56, true);
		KeyEvent(code, true);
		KeyEvent(code, nil);
		if shifted then KeyEvent(56, nil);
	end;
end;

// the picker on the screen: a pick view (class 91) with items
pickerUp := func() call findView with (GetRoot(), func(v) v.viewClass = 91 and v.pickItems and Length(v.pickItems) > 0);

// the item of the picker on the screen whose text begins with `prefix`,
// tapped (a picker draws its items itself: the item's row); ==> the item's
// index, or nil when there is no such item
pickItem := func(prefix) begin
	local picker := call pickerUp with ();
	local k := nil;
	if picker then foreach i, item in picker.pickItems do begin
		local text := if IsFrame(item) then item.item else item;
		if not k and IsString(text) and BeginsWith(text, prefix) then k := i;
	end;
	if k then begin
		local b := picker:GlobalBox();
		local n := Length(picker.pickItems);
		call tapAt with ((b.left + b.right) div 2, b.top + ((b.bottom - b.top) * (2 * k + 1)) div (2 * n));
	end;
	k
end;
