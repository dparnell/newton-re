// A fax sent (ctest host.NewtonFaxSend): a note put in the Out Box through
// the fax routing slip (Send('fax, ...), the ROM's own) and sent by the
// fax transport ('|faxsend:newton|): the note is printed in its print
// format through the print view (views/PrintView.h, class 94), the dot
// printer and the fax driver (print/FaxDriver.h) over the fax tool 'faxs
// and the modem tool 'mods, to tools/modem/fakemodem.py acting as a Class 1
// fax machine that answers (--fax-answer), which decodes the pages with
// t4.py.  The routing slip's own Send is skipped: the Out Box entry is
// given the number and the transport told to send it.  Two pages go -
// the cover page and the note - and tools/modem/faxcheck.py checks them.
//
//   python tools/modem/fakemodem.py --fax-answer build/fax-sent.pbm \
//       --spawn build/host/host/newton --rom build/MP2x00US/rom.bin \
//       --serial-port 0 --headless 200 --script src/host/demo/fax-send.ns
//   python tools/modem/faxcheck.py build/fax-sent.pbm --pages 2
HostInclude("common.ns");
note := {appSymbol: 'paperroll, title: "Faxed note", currentFormat: 'prPlainFormat,
		 body: {class: 'paperroll, viewStationery: 'paperroll, height: 100,
		        data: [{viewStationery: 'para, text: "hello from the Newton's fax",
		                viewBounds: {left: 10, top: 10, right: 220, bottom: 30}}]}};
Send('fax, note);
outbox := GetUnionSoup("OutBox");
sent := nil;

call waitFor with ("fax-send: the Out Box", func() outbox:Query(nil):Entry() <> nil, func() begin
	local e := outbox:Query(nil):Entry();
	e.toRef := nil;
	e.phoneNumber := "5551234";
	e.name := "Fakemodem";
	EntryChange(e);
	Print("fax-send: sending");
	TransportNotify('|faxsend:newton|, 'SendRequest, [{cause: 'user, item: e}]);
	// the entry leaves the Out Box once the fax has gone
	call waitFor with ("fax-send: the fax sent", func() outbox:Query(nil):Entry() = nil, func() begin
		Print("fax-send: the Out Box is empty");
		HostQuit();
	end, 180);
end, 30);
