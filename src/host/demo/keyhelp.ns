// The key-help slip: the list of command keys in force, which the Newton
// shows while the command key on a keyboard is held down.  Its layout and
// drawing are native (views/KeyHelpSlip.cpp: FKeyHelpSlipSetup,
// FKeyHelpSlipDraw); this opens it over the boot's first screen (the
// Setup assistant, once it is up) and photographs it.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --headless 60 --script src/host/demo/keyhelp.ns
//   python tools/imaging/pgm2png.py keyhelp.pgm keyhelp.png
//
// Prints "keyhelp: open" and the slip's layout, then writes keyhelp.pgm.

HostInclude("common.ns");			// waitFor

call waitFor with ("keyhelp: the first screen", func() GetRoot().setup and GetRoot().setup.viewCObject, func() begin
	local slip := GetRoot().keyHelpSlip;
	if not slip then begin
		Print("keyhelp: no slip");
		HostQuit();
		return;
	end;
	slip:Open();
	Print("keyhelp: open");
	Print("keyhelp: numcols " & slip.numcols & ", lineHeight " & slip.lineHeight
		  & ", slipHeight " & slip.slipHeight & ", groups " & Length(slip.keyCommands));
	foreach group in slip.keyCommands do
		Print("keyhelp: " & group.category & " (" & Length(group.keyCommands) & ")");
	call waitFor with ("keyhelp: the slip drawn", func() slip.viewCObject and Visible(slip), func() begin
		RefreshViews();
		ScreenSnapshot("keyhelp.pgm");
		Print("keyhelp: snapshot");
		Print("keyhelp: done");
		HostQuit();
	end, 30);
end, 60);
