// The Host panel's "Colour screen (next start)" (host/HostSettings.cpp,
// docs/qd/colour.md): behind --colour - not offered until colour has been
// asked for - then kept beside the store, the colour screen there when
// newton next starts with no --colour.  Three runs on one store, the phase
// in COLOURPREF (ctests host.NewtonColourPref.hidden, .set and .kept):
//   hidden  a fresh store, no --colour: the setting not on the panel
//   set     --colour: on the panel, turned on through HostSetSetting (what
//           the panel calls)
//   kept    no --colour: a red rectangle shows red, the setting still on
//           the panel; turned off again
//
//   COLOURPREF=set build/host/host/newton --colour --display 320x480 --erase \
//       --store tmp/colourpref.store --headless 60 --script src/host/demo/colour-pref.ns

colourPrefPhase := HostGetEnv("COLOURPREF");

colourPrefListed := func() begin
	local listed := nil;
	foreach item in HostSettingsList() do
		if item.setting = 'colourScreen and item.nextStart then listed := true;
	listed;
end;

colourPrefTest := func() begin
	if colourPrefPhase and StrEqual(colourPrefPhase, "hidden") then
		Print("colourpref: not on the panel without --colour: " & (if call colourPrefListed with () then "FAILED" else "ok"))
	else if colourPrefPhase and StrEqual(colourPrefPhase, "set") then begin
		Print("colourpref: listed on the Host panel: " & (if call colourPrefListed with () then "ok" else "FAILED"));
		Print("colourpref: asked for: " & (if HostSetSetting('colourScreen, true) then "ok" else "FAILED"));
	end else begin
		GetRoot():DoDrawing('DrawShape, [MakeRect(10, 40, 50, 80), {fillPattern: PackRGB(0xFFFF, 0, 0), penSize: 0}]);
		Print("colourpref: the colour screen at this start: " & (if ScreenColour(30, 60) = 0xFF0000 then "ok" else "FAILED"));
		Print("colourpref: still on the panel: " & (if call colourPrefListed with () then "ok" else "FAILED"));
		HostSetSetting('colourScreen, nil);
	end;
	Print("colourpref: done");
	HostQuit();
end;

AddDelayedCall(func() call colourPrefTest with (), nil, 8000);
