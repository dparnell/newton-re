// The colour screen (newton --colour; qd/Colour.h, docs/qd/colour.md):
// what applications say in colour drawn in colour.  On the root view, once
// the machine is up: rectangles filled with PackRGB colours, text in a
// font colour, a 'ditherPattern of two colours, and one rectangle inverted
// (xor: its colour's complement); each checked with ScreenColour at its
// middle, the text by finding its colour in its box.  The screen is written
// to tmp/colour-demo.ppm.  Without --colour every check is of a gray, and
// the demo says so and stops.
//
//   build/host/host/newton --colour --display 320x480 --erase --store tmp/colour.store \
//       --headless 60 --script src/host/demo/colour.ns

HostInclude("common.ns");

colourFailures := 0;

colourExpect := func(what, h, v, want) begin
	local got := ScreenColour(h, v);
	if got <> want then begin
		Print("colour: " & what & " at " & NumberStr(h) & "," & NumberStr(v) & " is " & SPrintObject(got) & ", not " & SPrintObject(want) & " - FAILED");
		colourFailures := colourFailures + 1;
	end else
		Print("colour: " & what & " ok");
end;

// whether any pixel in the box shows the colour
colourFind := func(left, top, right, bottom, want) begin
	for v := top to bottom - 1 do
		for h := left to right - 1 do
			if ScreenColour(h, v) = want then return true;
	nil;
end;

colourDraw := func() begin
	local root := GetRoot();
	local boxes := [
		{name: "red", left: 20, colour: PackRGB(0xFFFF, 0, 0), rgb: 0xFF0000},
		{name: "green", left: 100, colour: PackRGB(0, 0xFFFF, 0), rgb: 0x00FF00},
		{name: "blue", left: 180, colour: PackRGB(0, 0, 0xFFFF), rgb: 0x0000FF},
		{name: "yellow", left: 260, colour: PackRGB(0xFFFF, 0xFFFF, 0), rgb: 0xFFFF00}];
	foreach box in boxes do
		root:DoDrawing('DrawShape, [MakeRect(box.left, 60, box.left + 40, 100), {fillPattern: box.colour, penSize: 0}]);
	// text in a colour
	root:DoDrawing('DrawShape, [MakeText("Colour!", 20, 120, 300, 160),
		{font: {family: 'espy, face: 1, size: 24, color: PackRGB(0, 0, 0xFFFF)}, justification: 'left}]);
	// two colours dithered: red on yellow
	root:DoDrawing('DrawShape, [MakeRect(20, 180, 140, 220),
		{fillPattern: {_proto: nil, class: 'ditherPattern, pattern: 3, foreground: PackRGB(0xFFFF, 0, 0), background: PackRGB(0xFFFF, 0xFFFF, 0)}, penSize: 0}]);
	// the red one inverted: cyan
	root:DoDrawing('DrawShape, [MakeRect(20, 240, 80, 280), {fillPattern: PackRGB(0xFFFF, 0, 0), penSize: 0}]);
	root:DoDrawing('DrawShape, [MakeRect(20, 240, 80, 280), {fillPattern: 5, transferMode: 2, penSize: 0}]);	// (vfBlack, modeXor)

	foreach box in boxes do
		call colourExpect with (box.name, box.left + 20, 80, box.rgb);
	if call colourFind with (20, 120, 300, 160, 0x0000FF) then
		Print("colour: blue text ok")
	else begin
		Print("colour: no blue in the text's box - FAILED");
		colourFailures := colourFailures + 1;
	end;
	if (call colourFind with (20, 180, 140, 220, 0xFF0000)) and (call colourFind with (20, 180, 140, 220, 0xFFFF00)) then
		Print("colour: red on yellow dither ok")
	else begin
		Print("colour: the dither is not red and yellow - FAILED");
		colourFailures := colourFailures + 1;
	end;
	call colourExpect with ("red inverted", 50, 260, 0x00FFFF);

	// a 32-bit direct-colour bitmap (MakeBitmap's 'pixels: a 0x1c-byte
	// header, then rows of pad, red, green, blue): the left half red, the
	// right blue
	local direct := MakeBitmap(32, 16, {depth: 32});
	for y := 0 to 15 do
		for x := 0 to 31 do begin
			local at := 0x1c + y * 128 + x * 4;
			StuffByte(direct.data, at + 1, if x < 16 then 255 else 0);
			StuffByte(direct.data, at + 2, 0);
			StuffByte(direct.data, at + 3, if x < 16 then 0 else 255);
		end;
	root:DoDrawing('DrawShape, [direct, {transform: [200, 240]}]);
	call colourExpect with ("32-bit bitmap's red", 208, 248, 0xFF0000);
	call colourExpect with ("32-bit bitmap's blue", 224, 248, 0x0000FF);

	// a 16-bit one (x, then five bits each of red, green, blue): green
	local green16 := MakeBitmap(16, 16, {depth: 16});
	for y := 0 to 15 do
		for x := 0 to 15 do begin
			local at := 0x1c + y * 64 + x * 2;
			StuffByte(green16.data, at, 0x03);		// (0x03e0: green all ones)
			StuffByte(green16.data, at + 1, 0xE0);
		end;
	root:DoDrawing('DrawShape, [green16, {transform: [250, 240]}]);
	call colourExpect with ("16-bit bitmap's green", 258, 248, 0x00FF00);

	// a four-bit bitmap with a colour table ('colordata: its cbits a 'bits
	// layout - a 16-byte header, then rows - and its colortable eight bytes
	// an entry: a word, then red, green, blue): every pixel entry 1, magenta
	local cbits := MakeBinary(16 + 8 * 4, 'bits);
	for i := 0 to Length(cbits) - 1 do StuffByte(cbits, i, 0);
	StuffWord(cbits, 4, 4);								// rowBytes
	StuffWord(cbits, 12, 8);							// bounds: bottom
	StuffWord(cbits, 14, 8);							// right
	for i := 16 to Length(cbits) - 1 do StuffByte(cbits, i, 0x11);
	local table := MakeBinary(16, 'colortable);
	for i := 0 to 15 do StuffByte(table, i, 0xFF);	// entry 0 white
	StuffWord(table, 8 + 4, 0);							// entry 1: no green - magenta
	local tabled := {class: 'bitmap, bounds: SetBounds(0, 0, 8, 8), colordata: [{cbits: cbits, bitdepth: 4, colortable: table}]};
	root:DoDrawing('DrawShape, [tabled, {transform: [280, 240]}]);
	call colourExpect with ("colour-table bitmap's magenta", 284, 244, 0xFF00FF);
	ScreenSnapshot("tmp/colour-demo.ppm");
	Print("colour: done, " & NumberStr(colourFailures) & " failed");
	HostQuit();
end;

AddDelayedCall(func() begin
	if ScreenColour(0, 0) = nil then begin
		Print("colour: no screen");
		HostQuit();
	end else
		call colourDraw with ();
end, nil, 8000);
