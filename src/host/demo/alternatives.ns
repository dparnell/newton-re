// The correction and word-unit methods a script calls on a paragraph and
// on the correction info.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --script src/host/demo/alternatives.ns --headless 50
//
// The setup assistant is walked through and "ton" written on the Notepad,
// as src/host/demo/recognize.ns does.  Then, on the paragraph that holds
// it:
//
//   para:GetAlternatives(0, 3)          what the corrector would offer:
//                                        the readings and the strokes
//   correctInfo:Extract(para, 0, 3)     the word infos over the range, a
//                                        correction info of their own
//   correctInfo:insert(range, para)     ... put back
//
// Last, a view of its own is made; view:HandleRawInk(nil) hands it the
// aeRawInk command, which a plain view does not take.  "ton" is written
// on it, and its viewWordScript asks
// the paragraph what it would do with the word (para:VoteOnWordUnit)
// and hands the unit back to its own view as an aeWord command
// (view:HandleUnit).
//
// Each prints a line starting "alternatives:"; ctest's
// host.NewtonAlternatives checks them.

tapAt := func(x, y) begin PenDown(x, y); PenUp(); IdleStrokes(); end;
typeKey := func(code) begin KeyEvent(code, true); KeyEvent(code, nil); end;

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

page := 0;
nextPage := func()
  begin
    page := page + 1;
    if page < 10 then
      begin
        call tapAt with (293, 468);			// Continue
        AddDelayedCall(nextPage, nil, 1800);
      end
    else
      call tapAt with (297, 468);			// Done, on "Congratulations"
  end;

AddDelayedCall(func() begin
    call tapAt with (293, 468);				// past "Welcome"
    AddDelayedCall(func() begin
        call tapAt with (200, 150);			// the caret into the First line
        foreach c in name do call typeKey with (c);
        AddDelayedCall(nextPage, nil, 1500);
      end, nil, 2000);
  end, nil, 3000);

stroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

oval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", on a baseline at `base`, from x = 60
ton := func(base)
  [[66, base - 24, 66, base - 18, 66, base - 12, 66, base - 6, 66, base],
   [60, base - 14, 64, base - 14, 68, base - 14, 72, base - 14],
   call oval with (82, base - 7, 6, 7),
   [94, base - 14, 94, base - 7, 94, base, 94, base - 7,
    95, base - 11, 97, base - 13, 100, base - 14, 103, base - 13,
    104, base - 10, 104, base - 5, 104, base]];

findParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and	// clParagraphView (flags above it)
       IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call findParagraph with (child, prefix);
    found;
  end;

para := nil;

// "ton" written on a view of its own that reads words: its word script
// asks the paragraph about the unit, and hands the unit back to itself
voteView := func()
  begin
    local v := AddView(GetRoot(), {
        viewClass: 74,
        viewFlags: 1 + 0x200 + 0x800 + 0x1000 + 0x4000,	// visible, clickable, words, characters, letters
        viewBounds: {left: 20, top: 250, right: 300, bottom: 350},
        viewFormat: 0x151,
        handled: nil,
        viewWordScript: func(unit)
          begin
            if not handled then
              begin
                handled := true;
                local vote := para:VoteOnWordUnit(unit);
                Print("alternatives: VoteOnWordUnit answered " & (if IsInteger(vote) then "an integer" else "something else"));
                local took := :HandleUnit(0x12, unit);		// aeWord, back to this view
                Print("alternatives: HandleUnit answered " & (if took then "true" else "nil"));
              end;
            true;
          end});
    v:Dirty();
    // a plain view has no raw ink handler: the command is not taken
    local raw := 'thrown;
    try raw := v:HandleRawInk(nil) onexception |evt.ex| do raw := 'thrown;
    Print("alternatives: HandleRawInk answered " & (if raw = 'thrown then "an exception" else if raw then "true" else "nil"));
    AddDelayedCall(func() begin
        foreach s in call ton with (320) do call stroke with (s);
        IdleStrokes();
      end, nil, 1000);
  end;

AddDelayedCall(func() begin
    foreach s in call ton with (200) do call stroke with (s);
    AddDelayedCall(func() begin
        IdleStrokes();
        AddDelayedCall(func() begin
            para := call findParagraph with (GetRoot(), "ton");
            Print("alternatives: the paragraph is " & (if para then "there" else "missing"));

            local alt := para:GetAlternatives(0, 3);
            Print("alternatives: GetAlternatives offered "
                  & (if alt and alt.words then Length(alt.words) & " words, the first \"" & alt.words[0] & "\"" else "nothing")
                  & (if alt and alt.ink then ", with strokes" else ", no strokes"));

            local range := correctInfo:Extract(para, 0, 3);
            Print("alternatives: Extract took "
                  & (if range then Length(range.info) & " word info(s)" else "nothing"));
            local nothing := correctInfo:Extract(para, 100, 200);
            Print("alternatives: Extract past the text took " & (if nothing then "something" else "nothing"));
            correctInfo:insert(range, para);
            Print("alternatives: insert put the range back");

            call voteView with ();
          end, nil, 6000);
      end, nil, 3000);
  end, nil, 27000);
Print("alternatives: the script is loaded");
