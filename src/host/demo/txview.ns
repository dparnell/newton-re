// A protoTXView - the text engine's view (src/text/TXView.h) - in the
// booted Newton world: text put in, a word typed at its end and made bold,
// drawn, and scrolled, with a picture before and after the scroll.  Run
// from the repository root:
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --headless 16 --script src/host/demo/txview.ns
//   build/venv/Scripts/python tools/imaging/pgm2png.py build/txview-1.pgm build/txview-1.png
//
// build/txview-1.pgm: the text as put in and typed into, the typed word in
// bold (the caret at the end having scrolled the text up); build/txview-2.pgm:
// the same scrolled back to the start; build/txview-3.pgm: "hello" cut to a
// clipping (its icon at the screen's left edge) and pasted at the start;
// build/txview-4.pgm: "hello" and the next word scrubbed out with the pen
// (the mark at the text's left edge is the caret, at the start);
// build/txview-5.pgm: 2100 characters kept on the store (the middle view),
// saved with Externalize and read into another view (the bottom one);
// build/txview-6.pgm: that view with the ruler bar shown over it.  Each check
// prints "txview: FAILED ..." when it does not hold (the ctest looks for
// that), and the last line says how the view came out.
//
// The key codes are the ADB ones host/HostKeyboard.cpp maps a PC keyboard
// to; protoTXView is magic pointer 826.

typeKey := func(code) begin KeyEvent(code, true); KeyEvent(code, nil); end;

AddDelayedCall(func() begin
	tx := AddView(GetRoot(), {
		_proto: @826,						// protoTXView
		viewFlags: 0x0A01,					// visible, clickable, gestures
		viewBounds: {left: 20, top: 220, right: 300, bottom: 262},
		viewFormat: 0x151,					// white fill, a one-pixel frame
		viewFont: 0x2800 });				// espy 10
	// the page as wide as the view and as tall as it likes: without this
	// the page is the view's own size, and text below it is not drawn even
	// when scrolled to (the ROM's GeometryChanged)
	tx:SetGeometry(nil, 280, 0x7fff, {left: 0, top: 0, right: 0, bottom: 0});
	tx:Dirty();

	local text := "The Newton's text engine: a document of styled text with rulers, tabs and page breaks, written in C++ over storage of its own, which a script reaches through protoTXView.";
	tx:Replace({first: 0, last: 0}, {text: text, styles: [StrLen(text), {family: 'espy, size: 12, face: 0}]}, nil);
	local count := tx:GetCountCharacters();
	if count <> StrLen(text) then Print("txview: FAILED - the text put in is " & count & " characters");

	// the caret at the end, the view made the key view, and a word typed
	tx:SetHiliteRange({first: count, last: count}, nil, true);
	KeyboardConnect(true);
	foreach c in [49, 4, 14, 37, 37, 31] do			// " hello"
		call typeKey with (c);

	AddDelayedCall(func() begin
		local typed := tx:GetRangeData({first: count, last: count + 6}, 'text);
		if not StrEqual(typed, " hello") then Print("txview: FAILED - typed \"" & typed & "\"");

		// the typed word made bold, undoably
		tx:ChangeRangeRuns({first: count + 1, last: count + 6}, {family: 'espy, size: 12, face: 1}, nil, true);
		tx:SetHiliteRange({first: count + 2, last: count + 3}, nil, nil);
		local style := tx:GetContinuousRun();
		if style.face <> 1 then Print("txview: FAILED - the word is not bold");
		RefreshViews();
		ScreenSnapshot("build/txview-1.pgm");

		// the caret at the end scrolled the text up to show it: scrolled
		// back to the start
		local height := tx:GetLineRange(tx:GetCountCharacters());
		local before := tx:GetScrollValues();
		if before.y <= 0 then Print("txview: FAILED - the caret did not scroll the text (" & before.y & ")");
		tx:Scroll({x: 0, y: -before.y});		// the text moved down
		local scrolled := tx:GetScrollValues();
		if scrolled.y <> 0 then Print("txview: FAILED - scrolled back to " & scrolled.y);
		RefreshViews();
		ScreenSnapshot("build/txview-2.pgm");

		// "hello" cut to a clipping, and pasted at the start
		tx:SetHiliteRange({first: count + 1, last: count + 6}, nil, nil);
		tx:Cut();
		if tx:GetCountCharacters() <> count + 1 then Print("txview: FAILED - cut left " & tx:GetCountCharacters());
		tx:SetHiliteRange({first: 0, last: 0}, nil, nil);
		tx:Paste();
		local pasted := tx:GetRangeData({first: 0, last: 5}, 'text);
		if not StrEqual(pasted, "hello") then Print("txview: FAILED - pasted \"" & pasted & "\"");
		RefreshViews();
		ScreenSnapshot("build/txview-3.pgm");
		// "hello" scrubbed out with the pen: back and forth across it
		AddDelayedCall(func() begin
			local pts := [];
			for k := 0 to 7 do
				begin
				AddArraySlot(pts, if k mod 2 = 0 then 18 else 60);
				AddArraySlot(pts, 224 + k * 2);
				end;
			PenDown(pts[0], pts[1]);
			for i := 2 to Length(pts) - 2 by 2 do PenMove(pts[i], pts[i + 1]);
			PenUp();
			AddDelayedCall(func() begin
				local after := tx:GetRangeData({first: 0, last: 3}, 'text);
				if StrEqual(after, "hel") then Print("txview: FAILED - the scrub left \"" & after & "\"");
				RefreshViews();
				ScreenSnapshot("build/txview-4.pgm");
				Print("txview: scrubbed to " & tx:GetCountCharacters() & " characters");

				// text kept on the store: a second view given the store before
				// it is set up, 2100 characters (five chunks) put in, the whole
				// saved (Externalize) and read into a third view
				local onStore := AddView(GetRoot(), {
					_proto: @826, viewFlags: 1,
					viewBounds: {left: 20, top: 320, right: 300, bottom: 360},
					viewFormat: 0x151,
					viewSetupFormScript: func() :SetStore(GetStores()[0]) });
				onStore:SetGeometry(nil, 280, 0x7fff, {left: 0, top: 0, right: 0, bottom: 0});
				local long := "";
				for i := 1 to 150 do long := long & "fourteen chars";
				onStore:Replace({first: 0, last: 0}, {text: long, styles: [StrLen(long), {family: 'espy, size: 12, face: 0}]}, nil);
				onStore:SetHiliteRange({first: 0, last: 0}, true, nil);	// back to the start
				local saved := onStore:Externalize();
				if not IsVBO(saved.txText) then Print("txview: FAILED - the text is not on the store");
				local reader := AddView(GetRoot(), {
					_proto: @826, viewFlags: 0x0A01,
					viewBounds: {left: 20, top: 370, right: 300, bottom: 452},
					viewFormat: 0x151 });
				reader:Internalize(saved);
				local back := reader:GetRangeData({first: 2086, last: 2100}, 'text);
				if not StrEqual(back, "fourteen chars") then Print("txview: FAILED - read back \"" & back & "\"");
				RefreshViews();
				ScreenSnapshot("build/txview-5.pgm");
				Print("txview: " & onStore:GetCountCharacters() & " characters on the store, " & reader:GetCountCharacters() & " read back");
				// the ruler bar over the third view, its first paragraph given a
				// left margin, an indent, a right margin and two tabs
				reader:ShowRuler(nil);
				reader:ChangeRangeRulers({first: 0, last: 0},
					{leftMargin: 20, indent: 40, rightMargin: 30, justification: 'center, lineSpacing: 2,
					 tabs: [{value: 100, kind: 'left}, {value: 160, kind: 'right}]}, nil);
				if not reader:IsRulerShown() then Print("txview: FAILED - no ruler");
				RefreshViews();
				ScreenSnapshot("build/txview-6.pgm");

				// the first justification icon (left: the icons at x 199, 221, 243, 265) tapped
				PenDown(207, 400); PenUp(); IdleStrokes();
				AddDelayedCall(func() begin
					local rulers := reader:GetRangeData({first: 0, last: 0}, 'rulers);
					Print("txview: the ruler's justification is now " & rulers[1].justification);
					Print("txview: done");
					HostQuit();
				  end, nil, 1000);

				// all of it replaced undoably: the undo keeps 4200 bytes, which
				// the stream factory puts in a large binary on the store
				onStore:Replace({first: 0, last: 2100}, {text: "gone"}, true);
				Print("txview: replaced undoably, " & onStore:GetCountCharacters() & " characters left");
			  end, nil, 4000);
		  end, nil, 500);
		Print("txview: " & tx:GetCountCharacters() & " characters, " & height.first & "-" & height.last & " the last line, scrolled from " & before.y & " to " & scrolled.y);
	  end, nil, 1500);
  end, nil, 2500);								// after the boot
Print("txview: the script is loaded");
