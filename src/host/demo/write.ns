// Writing: words written with the pen on the Notepad, and read.
//
//   build/host/host/newton --display 320x480 --headless 90 --script src/host/demo/write.ns
//
// With a window (no --headless), just write on the page with the mouse:
// the ROM's own handwriting engine, Rosetta (recognition/RosRecognizer.h),
// reads it, and the page puts the word down as text.
//
// After the Setup walk, "ton" is written in four strokes - the stem of the
// t, its bar, an o and an n - about the size a person writes on the
// screen, and then "to" a word's gap along the same line.  Remote writing
// sends the second word to the caret the first left, so the page reads
// "ton to" (ctest host.NewtonWrite).  build/write.pgm is the page.
//
// Prints "write: <step>: ok" or "FAILED", and "write: done".

HostInclude("common.ns");			// tapAt, waitFor, walkSetup
HostInclude("penhelpers.ns");		// penWriteWord, penFindPara

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
writeFailures := 0;

writeCheck := func(what, ok)
  begin
    if not ok then writeFailures := writeFailures + 1;
    Print("write: " & what & (if ok then ": ok" else ": FAILED"));
  end;

call walkSetup with (name, func() begin
    local base := 200;
    call penWriteWord with ("ton", 60, base);
    local up := Ticks();
    IdleStrokes();
    call waitFor with ("write: ton", func() Ticks() - up > 40 and call penFindPara with (GetRoot(), "ton"), func() begin
        call writeCheck with ("\"ton\" read", call penFindPara with (GetRoot(), "ton") <> nil);
        call penWriteWord with ("to", 130, base);
        IdleStrokes();
        call waitFor with ("write: ton to", func() call penFindPara with (GetRoot(), "ton to"), func() begin
            local p := call penFindPara with (GetRoot(), "ton to");
            call writeCheck with ("the page reads \"ton to\"", p and StrEqual(p.text, "ton to"));
            ScreenSnapshot("build/write.pgm");
            Print("write: done, " & writeFailures & " failed");
            HostQuit();
          end, 20);
      end, 20);
  end);
