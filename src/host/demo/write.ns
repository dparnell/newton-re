// Writing: a word written with the pen on the Notepad, and read.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --scale 2 --script src/host/demo/write.ns
//
// or, without a window:
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --script src/host/demo/write.ns --headless 50
//   build/venv/Scripts/python tools/imaging/pgm2png.py build/write.pgm build/write.png
//
// With a window, just write on the page with the mouse: the ROM's own
// handwriting engine, Rosetta (recognition/RosRecognizer.h), reads it,
// and the page puts the word down as text.
//
// The setup assistant is walked through first, as src/host/demo/ink.ns
// does, and then "ton" is written in four strokes - the stem of the t,
// its bar, an o and an n - about the size a person writes on the screen.
// A picture is taken with the pen still up after the last stroke
// (build/write-ink.pgm, the writing as the inker drew it) and another a
// few seconds later (build/write.pgm, what the page kept).

tapAt := func(x, y) begin PenDown(x, y); PenUp(); IdleStrokes(); end;
typeKey := func(code) begin KeyEvent(code, true); KeyEvent(code, nil); end;

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

page := 0;
nextPage := func()
  begin
    page := page + 1;
    if page < 10 then
      begin
        call tapAt with (293, 468);			// Continue
        AddDelayedCall(nextPage, nil, 1800);
      end
    else
      call tapAt with (297, 468);			// Done, on "Congratulations"
  end;

AddDelayedCall(func() begin
    call tapAt with (293, 468);				// past "Welcome"
    AddDelayedCall(func() begin
        call tapAt with (200, 150);			// the caret into the First line
        foreach c in name do call typeKey with (c);
        AddDelayedCall(nextPage, nil, 1500);
      end, nil, 2000);
  end, nil, 3000);

// One stroke: the pen put down on the first point, moved through the
// rest, and lifted.
stroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

// An oval of `n` points, from the top going anticlockwise, as an o is
// written.  (Twelfths of a turn, worked out once: cos and sin of 30n.)
oval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", on a baseline at y = 200, from x = 60
AddDelayedCall(func() begin
    local base := 200;
    // t: the stem, then the bar
    call stroke with ([66, base - 24, 66, base - 18, 66, base - 12, 66, base - 6, 66, base]);
    call stroke with ([60, base - 14, 64, base - 14, 68, base - 14, 72, base - 14]);
    // o
    call stroke with (call oval with (82, base - 7, 6, 7));
    // n: down, back up, over the arch and down again
    call stroke with ([94, base - 14, 94, base - 7, 94, base, 94, base - 7,
                       95, base - 11, 97, base - 13, 100, base - 14, 103, base - 13,
                       104, base - 10, 104, base - 5, 104, base]);
    AddDelayedCall(func() begin
        ScreenSnapshot("build/write-ink.pgm");
        Print("write: written build/write-ink.pgm");
        IdleStrokes();
        AddDelayedCall(func() begin
            ScreenSnapshot("build/write.pgm");
            Print("write: written build/write.pgm");
          end, nil, 6000);
      end, nil, 1500);
  end, nil, 27000);
Print("write: the script is loaded");
