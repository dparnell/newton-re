// Snapping: shapes drawn near shapes already on the Notepad are fitted to
// them.  Two circles of nearly one size in a row come out in line and the
// same size (GlobalTrends), and a line started just off a box's corner
// starts on the corner (SnapPtToLC).
//
//   build/host/host/newton --display 320x480 --headless 90 --script src/host/demo/snapping.ns
//
// As src/host/demo/shapes.ns, the Notepad set to shapes and each shape
// drawn once the one before it is on the page (ctest host.NewtonSnapping).
// build/snapping.pgm is the page.
//
// Prints "snapping: <step>: ok" or "FAILED", and "snapping: done".

HostInclude("common.ns");			// tapAt, waitFor, walkSetup
HostInclude("penhelpers.ns");		// penStroke, penPath, penRound, penFindPolys

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
snapFailures := 0;

snapCheck := func(what, ok)
  begin
    if not ok then snapFailures := snapFailures + 1;
    Print("snapping: " & what & (if ok then ": ok" else ": FAILED"));
  end;

snapToDraw := [
    call penRound with (80, 300, 40),									// a circle
    call penRound with (210, 306, 43),									// another, a little lower and larger
    call penPath with ([40, 100, 140, 102, 139, 190, 41, 188, 40, 103]),	// a box
    call penPath with ([146, 106, 280, 96])							// a line from near its corner
  ];

snapShapes := func() call penFindPolys with (GetRoot(), []);

snapNext := func(n)
  begin
    if n >= Length(snapToDraw) then
      begin
        local shapes := call snapShapes with ();
        call snapCheck with ("four shapes on the page", Length(shapes) = 4);
        if Length(shapes) = 4 then
          begin
            // (in the order they were drawn: the page adds each as its last child)
            local c1 := shapes[0]:GlobalBox(), c2 := shapes[1]:GlobalBox();
            local box := shapes[2]:GlobalBox(), line := shapes[3]:GlobalBox();
            call snapCheck with ("the circles the same size", c1.right - c1.left = c2.right - c2.left
                                  and c1.bottom - c1.top = c2.bottom - c2.top);
            call snapCheck with ("the circles in line", c1.top = c2.top);
            call snapCheck with ("the line from the box's corner", Abs(line.left - box.right) <= 2);
          end;
        ScreenSnapshot("build/snapping.pgm");
        Print("snapping: done, " & snapFailures & " failed");
        return HostQuit();
      end;
    call penStroke with (snapToDraw[n]);
    IdleStrokes();
    call waitFor with ("snapping: shape " & n, func() Length(call snapShapes with ()) > n,
      func() call snapNext with (n + 1), 20);
  end;

call walkSetup with (name, func() begin
    GetRoot().paperroll._recogSettings := 128;
    PurgeAreaCache();
    call snapNext with (0);
  end);
