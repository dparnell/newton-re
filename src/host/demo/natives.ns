// The last natives of the ROM outside the communications area, each asked
// once (ctest host.NewtonNatives):
//
//   RepeatInfoToText   a repeating meeting's pattern in words
//   MeasuredNumberStr  a number's text cut to fit a width
//   DrawOriginal       a stroke bundle's writing drawn into a box
//   LoadFontCache      the font table loaded again
//   an expando's viewDrawScript (DrawExpando)
//   InitSerialDebugging, PreInitSerialDebugging (no debugger on the host)
//   instance:Dispatch (a protocol method by its number)
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --headless 30 --script src/host/demo/natives.ns

// the days of the week are bits 0x800 (Sunday) down to 0x20 (Saturday)
Print(["days", RepeatInfoToText(0x400 + 0x80, 0, nil)]);			// Monday and Thursday
Print(["every day", RepeatInfoToText(0xfe0, 0, nil)]);
// a day in weeks of the month: the second and last Friday
Print(["weeks", RepeatInfoToText(0x40 + 0x08 + 0x01, 1, nil)]);
// the dates of the month: the 15th
Print(["date", RepeatInfoToText(15, 2, nil)]);
// a date in the year: March 4, in the year of the time given
Print(["in the year", RepeatInfoToText((3 << 8) + 4, 3, Time())]);
// every other week, from day 34000 since 1904
Print(["every other", RepeatInfoToText(34000 << 8, 4, nil)]);
// a day in a week of a month: the first Monday of September
Print(["week in year", RepeatInfoToText((9 << 12) + 0x400 + 0x10, 7, nil)]);
Print(["kind 5", RepeatInfoToText(1, 5, nil)]);

// the text cut to fit: digits after the point go first; a whole number
// too wide, and text that cannot be cut far enough, answer nil
constant kFont := 0x2800;			// espy 10 point, plain
Print(["fits", MeasuredNumberStr("3.14159", 200, kFont)]);
Print(["cut", MeasuredNumberStr("3.14159", StrFontWidth("3.14", kFont) + 1, kFont)]);
Print(["whole", MeasuredNumberStr("314159", 10, kFont)]);
Print(["too narrow", MeasuredNumberStr("31.4159", 5, kFont)]);

// the writing a stroke bundle holds drawn into a box: as large as fits,
// kept within twice its size (and the box grown, not shrunk, when the
// writing is too wide for it - a ROM bug, fixed by default; the limit to
// twice the writing's size makes the narrow box come out the same either way)
kBundle := {bounds: {left: 0, top: 0, right: 20, bottom: 10}, strokes: []};
Print(["original", DrawOriginal(kBundle, {left: 0, top: 0, right: 100, bottom: 50})]);
Print(["original narrow", DrawOriginal(kBundle, {left: 0, top: 0, right: 50, bottom: 100})]);
try DrawOriginal({bounds: {left: 0}, strokes: []}, {left: 0, top: 0, right: 1, bottom: 1}) onexception |evt.ex.msg| do Print(["bad bundle", CurrentException().message]);
GetRoot():LoadFontCache();
Print("fonts loaded");

// an expando (@175)'s lines drawn: each line's label and text asked of
// it (setup1, setup2); an empty text drawn as the view's `empty`
kAsked := [];
kLine := func(label, text) {setup1: func(target) begin AddArraySlot(kAsked, label); label end,
						  setup2: func(target) text};
expando := AddView(GetRoot(), {_proto: @175, viewBounds: {left: 10, top: 300, right: 230, bottom: 360},
	numLines: 2, lines: [call kLine with ("Name", "Daniel"), call kLine with ("Phone", "")],
	viewSetupFormScript: nil, viewSetupChildrenScript: nil});
expando:viewDrawScript();
Print(["expando asked", kAsked]);

// the serial debugger: none on the host, so starting it answers
// kError_Call_Not_Implemented (-10005); stopping it and reading the debug
// card answer nought
Print(["debugger", InitSerialDebugging("extr", 10), InitSerialDebugging("extr", 0),
	InitSerialDebugging("extr", 2), PreInitSerialDebugging("extr", 57600, 1), PreInitSerialDebugging("extr", 57600, -1)]);

// a protocol instance's method by its number: a host protocol that is not
// a monitor has no numbered methods (-10005); a value that will not
// marshal throws evt.ex.marshal.type
kCodec := NewByName("TSoundCodec", "TMuLawCodec", nil);
try kCodec:Dispatch([1], ['long], 3, 'long) onexception |evt.ex.fr| do Print(["dispatch", CurrentException().error]);
try kCodec:Dispatch(["x"], ['long], 3, 'long) onexception |evt.ex.marshal| do Print(["dispatch marshal", CurrentException().name]);
kCodec:Destroy();

QuickLookDone(nil);
Print("natives: done");
HostQuit();
