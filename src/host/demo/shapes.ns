// Shapes: a line, a box, a triangle and a circle drawn with the pen on the
// Notepad set to shapes, and cleaned up by the shape recogniser
// (recognition/ShapeDomain.h).
//
//   build/host/host/newton --display 320x480 --headless 90 --script src/host/demo/shapes.ns
//
// The Notepad keeps its own recognition settings, a set of bits in its
// paper roll's _recogSettings that the ROM's ExpandSettings turns into a
// configuration (32 text, 64 ink words, 128 shapes, 256 words, 512
// numbers; the Notepad starts at 864).  Shapes alone is 128.  A page's
// recognition area is cached, so the cache is purged after the change,
// as the Notepad's own recognition menu does.  Each shape is drawn once
// the one before it is on the page; four shapes (polygon views that are
// not ink) must be there at the end (ctest host.NewtonShapes).
// build/shapes.pgm is the page.
//
// Prints "shapes: <step>: ok" or "FAILED", and "shapes: done".

HostInclude("common.ns");			// tapAt, waitFor, walkSetup
HostInclude("penhelpers.ns");		// penStroke, penPath, penRound, penFindPolys

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
shapesFailures := 0;

shapesCheck := func(what, ok)
  begin
    if not ok then shapesFailures := shapesFailures + 1;
    Print("shapes: " & what & (if ok then ": ok" else ": FAILED"));
  end;

shapesToDraw := [
    call penPath with ([30, 120, 140, 132]),							// a line
    call penPath with ([180, 110, 290, 112, 288, 190, 182, 188, 181, 114]),	// a box
    call penPath with ([80, 220, 140, 320, 25, 318, 78, 224]),		// a triangle
    call penRound with (220, 270, 50)									// a circle
  ];

shapesCount := func() Length(call penFindPolys with (GetRoot(), []));

shapesNext := func(n)
  begin
    if n >= Length(shapesToDraw) then
      begin
        call shapesCheck with ("four shapes on the page", call shapesCount with () = 4);
        ScreenSnapshot("build/shapes.pgm");
        Print("shapes: done, " & shapesFailures & " failed");
        return HostQuit();
      end;
    call penStroke with (shapesToDraw[n]);
    IdleStrokes();
    call waitFor with ("shapes: shape " & n, func() call shapesCount with () > n,
      func() call shapesNext with (n + 1), 20);
  end;

call walkSetup with (name, func() begin
    GetRoot().paperroll._recogSettings := 128;
    PurgeAreaCache();
    call shapesNext with (0);
  end);
