// Deferred recognition: writing already on the machine read again, now.
//
//   build/host/host/newton --rom build/MP2x00US/rom.bin --display 320x480 \
//       --script src/host/demo/recognize.ns --headless 50
//
// The setup assistant is walked through and "ton" written on the Notepad,
// as src/host/demo/write.ns does; the recogniser reads it and the page
// shows the text.  The same four strokes are then made into a stroke
// bundle (MakeStrokeBundle, from the points the pen was given), and that
// is what the rest reads again (views/Rerecognize.h):
//
//   Recognize([bundle], nil, nil)     the strokes, read in an area of
//                                      their own: a correct info frame
//   Recognize([bundle], {...}, nil)    ... where nothing may read them:
//                                      grouped into ink, which the ROM
//                                      then drops (nothing comes back)
//   RecognizeInkWord(ink)              the same strokes packed into an
//                                      ink word, read: its words
//   RecognizeTextInStyles(frame, nil)  a text-and-styles frame holding
//                                      that ink word, the ink replaced by
//                                      its text
//   RecognizePara(view, start, stop)   the ink word put into the
//                                      paragraph after "ton" and read
//                                      there: the text becomes "ton ton"
//
// Last, "ton" is written twice, well apart, on a view that recognises
// nothing: the strokes expire, the word segmenter (recognition/
// WordSegment.h) groups them into two words, and half a second after the
// last one each word reaches the view as one piece of raw ink - its
// viewRawInkScript prints how many strokes it was given.
//
// Each prints a line starting "recognize:"; ctest's host.NewtonRecognize
// checks them.

HostInclude("common.ns");			// tapAt, typeKey, waitFor, walkSetup

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes

// One stroke, x and y alternating: the pen down on the first point,
// moved through the rest, and lifted.
stroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

// The same points as a stroke's points array wants them: v (y) first.
yx := func(points)
  begin
    local out := [];
    for i := 0 to Length(points) - 2 by 2 do
      begin
        AddArraySlot(out, points[i + 1]);
        AddArraySlot(out, points[i]);
      end;
    out;
  end;

oval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "ton", on a baseline at y = 200, from x = 60
base := 200;
ton := [[66, base - 24, 66, base - 18, 66, base - 12, 66, base - 6, 66, base],
        [60, base - 14, 64, base - 14, 68, base - 14, 72, base - 14],
        call oval with (82, base - 7, 6, 7),
        [94, base - 14, 94, base - 7, 94, base, 94, base - 7,
         95, base - 11, 97, base - 13, 100, base - 14, 103, base - 13,
         104, base - 10, 104, base - 5, 104, base]];

// the paragraph whose text starts with `prefix`, anywhere under a view
findParagraph := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and	// clParagraphView (flags above it)
       IsString(v.text) and StrPos(v.text, prefix, 0) = 0 then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call findParagraph with (child, prefix);
    found;
  end;

firstWord := func(words)
  if words and Length(words) > 0 then words[0].word else "nothing";

// "ton" written twice on a view that reads nothing: two pieces of ink
inkOnly := func()
  begin
    local v := AddView(GetRoot(), {
        viewClass: 74,
        viewFlags: 1 + 0x200 + 0x400,		// visible, clickable, strokes allowed - and nothing read
        viewBounds: {left: 20, top: 250, right: 300, bottom: 350},
        viewFormat: 0x151,					// white fill, a thin frame
        viewRawInkScript: func(strokes)
          begin
            Print("recognize: ink came back as a piece of " & Length(strokes.strokes) & " strokes");
            inkPieces := inkPieces + 1;
            true;
          end});
    v:Dirty();
    AddDelayedCall(func() begin
        local b := 320;
        foreach dx in [0, 150] do
          foreach s in ton do
            begin
              local moved := Clone(s);
              for i := 0 to Length(moved) - 2 by 2 do
                begin
                  moved[i] := moved[i] + dx;
                  moved[i + 1] := moved[i + 1] + (b - base);
                end;
              call stroke with (moved);
            end;
        IdleStrokes();
        call waitFor with ("recognize: the two pieces of ink", func() inkPieces >= 2, func() begin
            Print("recognize: done");
            HostQuit();
          end, 60);
      end, nil, 1000);
  end;
inkPieces := 0;

call walkSetup with (name, func() begin
    foreach s in ton do call stroke with (s);
    IdleStrokes();
    // (once the recogniser has finished with the word: its page then has
    // a paragraph "ton")
    call waitFor with ("recognize: the word read", func() call findParagraph with (GetRoot(), "ton"), func() begin
            local para := call findParagraph with (GetRoot(), "ton");
            Print("recognize: the paragraph is " & (if para then "there" else "missing"));

            local strokes := [];
            foreach s in ton do AddArraySlot(strokes, call yx with (s));
            local bundle := MakeStrokeBundle(strokes, 0);

            local ci := Recognize([bundle], nil, nil);
            Print("recognize: Recognize read " & (if ci and Length(ci.info) > 0
                                                  then call firstWord with (ci.info[0].words) else "nothing"));

            // the same strokes where nothing may read them: they are
            // grouped into ink, but the ROM's HandleBulkStrokes hands
            // the ink to AddWordInfo, which keeps only word infos with a
            // word - so nothing comes back (a ROM quirk kept)
            local unread := Recognize([bundle], {doTextRecognition: nil, doShapeRecognition: nil}, nil);
            Print("recognize: unread strokes came back as "
                  & (if unread and Length(unread.info) > 0 then Length(unread.info) & " piece(s)" else "nothing"));

            local ink := StrokeBundleToInkWord(bundle);
            Print("recognize: RecognizeInkWord read " & call firstWord with (RecognizeInkWord(ink)));

            // (the ink word's character, U+F701, spelt with NewtonScript's
            // \u, which turns hexadecimal characters on and off)
            local frame := {text: "an \u", styles: [3, 'userFont, 1, ink]};
            local read := RecognizeTextInStyles(frame, nil);
            Print("recognize: RecognizeTextInStyles made \"" & read.text & "\"");

            // the ink word put into the paragraph after "ton", and the
            // paragraph asked to read it
            SetKeyView(para, StrLen(para.text));
            InsertItemsAtCaret({insertItems: [ink], addSpace: true, undoable: nil, moveCaret: true});
            Print("recognize: the paragraph holds " & StrLen(para.text) & " characters");
            local stop := RecognizePara(para, 0, StrLen(para.text), nil, nil);
            Print("recognize: RecognizePara made \"" & para.text & "\", the range ending at " & stop);
            // (a snapshot is taken after the event; the paragraph is
            // redrawn a moment later)
            AddDelayedCall(func() begin
                ScreenSnapshot("build/recognize.pgm");
                Print("recognize: written build/recognize.pgm");
                call inkOnly with ();
              end, nil, 2000);
          end, 60);
  end);
Print("recognize: the script is loaded");
