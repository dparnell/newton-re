// The Messages application (comms/host/HostMessages.ns) over the host's
// cellular module: its icon in the Extras drawer; texts received filed into
// conversations, the list and a conversation drawn; a reply sent from the
// conversation's Reply line, the message 'sent; a new message to a Names
// card; the Reply line growing with a long message, Send doing nothing
// with only spaces; a message tapped and deleted, then the whole
// conversation once confirmed; the alert slip while it is closed; texts
// while the screen is locked left on the lock screen (read at the unlock
// in the open conversation, opened at it when chosen there, the slip at
// the unlock otherwise); each screen snapshotted
// (messages-<width>x<height>-<n>.pgm), so a
// run at each display size shows the layout made for it.  The module is
// tools/modem/fakecell.py on --cell-port (ctests host.NewtonMessages.*):
//
//   python tools/modem/fakecell.py \
//       --spawn build/host/host/newton --cell-port 0 --display 240x320 --erase \
//       --store messages.store --headless 150 --script src/host/demo/messages.ns

HostInclude("common.ns");
msFailures := 0;
msApp := nil;
msCard := nil;
msShot := 0;
msDeleteCount := 0;
msDeleteId := nil;

msCheck := func(what, ok, why) begin
	if ok then
		Print("messages: " & what & " ok")
	else begin
		Print("messages: " & what & " FAILED - " & why);
		msFailures := msFailures + 1;
	end;
end;

msSnap := func() begin
	if msApp then msApp:Dirty();
	RefreshViews();
	local p := GetAppParams();
	msShot := msShot + 1;
	ScreenSnapshot("messages-" & NumberStr(p.appAreaWidth + p.appAreaLeft) & "x"
		& NumberStr(p.appAreaHeight + p.appAreaTop) & "-" & NumberStr(msShot) & ".pgm");
end;

msEntries := func() begin
	local items := [];
	local soup := GetUnionSoup("Messages:host");
	if soup then begin
		local cursor := Query(soup, {type: 'index});
		local e;
		while e := cursor:Entry() do begin
			AddArraySlot(items, e);
			cursor:Next();
		end;
	end;
	items;
end;

msEntryWith := func(text) begin
	foreach e in call msEntries with () do
		if StrEqual(e.text, text) then
			return e;
	nil;
end;

msIconThere := func() begin
	local cursor := Query(GetUnionSoup(@307.name), {type: 'index});
	local e;
	while e := cursor:Entry() do begin
		// (with the tag the drawer's All Icons lists by)
		if e.app = '|Messages:host| then
			return e._tagList and SetContains(e._tagList, '_icon);
		cursor:Next();
	end;
	nil;
end;

msSteps := [
	// (a fresh store's Setup assistant closed first, once it is up: its
	// Continue button and pictures sit over the application's status bar on
	// a wide screen - walkSetup taps where a 320x480 screen has them)
	func(next) begin
		local start := Ticks();
		local poll;
		poll := func() begin
			if GetRoot().setup and GetRoot().setup.viewCObject then begin
				GetRoot().setup:Close();
				AddDelayedCall(next, nil, 500);
			end else if Ticks() - start > 20 * 60 then
				call next with ()
			else
				AddDelayedCall(poll, nil, 250);
		end;
		call poll with ();
	end,
	func(next) call waitFor with ("messages: the application",
		func() GetRoot().|Messages:host| and HostCellStatus().state = 'home, next, 90),
	func(next) begin
		msApp := GetRoot().|Messages:host|;
		call msCheck with ("its icon in the Extras drawer", call msIconThere with (), "none");
		msCard := GetUnionSoup("Names"):AddToDefaultStoreXmit({class: 'person, cardType: 0,
			name: {class: 'person, first: "Alice", last: "Ng"}, sorton: "Ng Alice",
			phones: ["0400 000 002"]}, nil);
		msApp:Open();
		HostCellCommand("AT+FAKETEXT=\"+61400000002\",\"Are we still on for dinner tonight?\"");
		HostCellCommand("AT+FAKETEXT=\"+61499999999\",\"Who is this?\"");
		call waitFor with ("messages: two texts", func() Length(call msEntries with ()) = 2, next, 30);
	end,
	func(next) begin
		local alice := call msEntryWith with ("Are we still on for dinner tonight?");
		call msCheck with ("Alice's text", alice and alice.dir = 'incoming and StrEqual(alice.name, "Alice Ng")
			and StrEqual(alice.thread, "00000002"), "it is " & (if alice then alice.name & " " & alice.thread));
		call msCheck with ("unread", alice and alice.state = 'unread, "it is " & (if alice then alice.state));
		call msCheck with ("two conversations", Length(msApp.threads) = 2, Length(msApp.threads) & " of them");
		call msCheck with ("none left in the In Box", Length(call msInBox with ()) = 0, "some");
		call msSnap with ();
		// the folder tab's picker: All Messages and the two conversations (not
		// folders); its title All Messages; choosing Alice opens hers
		local tab := msApp.folderTab.showBarText;
		call msCheck with ("the tab's title", StrPos(tab.text, "All Messages", 0), "it is " & tab.text);
		local popup := tab:buttonClickScript();
		call msCheck with ("the tab's picker", tab.pickThreads and Length(tab.pickThreads) = 2,
			"it lists " & (if tab.pickThreads then Length(tab.pickThreads)));
		local alice := 2;
		if tab.pickThreads and not StrEqual(tab.pickThreads[0].thread, "00000002") then alice := 3;
		if popup and popup.viewCObject then popup:Close();
		tab:pickActionScript(alice);
		call msCheck with ("a conversation chosen from the tab", msApp.mode = 'thread
			and StrEqual(msApp.currentThread, "00000002"), "the mode is " & msApp.mode);
		call msCheck with ("the tab's title the conversation", StrPos(tab.text, "Alice Ng", 0), "it is " & tab.text);
		AddDelayedCall(next, nil, 500);
	end,
	func(next) begin
		local alice := call msEntryWith with ("Are we still on for dinner tonight?");
		call msCheck with ("read once opened", alice.state = 'read, "it is " & alice.state);
		call msSnap with ();
		SetValue(msApp.replyLine.entryLine, 'text, "Yes - 8 at the usual place");
		msApp.sendButton:buttonClickScript();
		call waitFor with ("messages: the reply sent", func() begin
			local e := call msEntryWith with ("Yes - 8 at the usual place");
			e and e.state = 'sent;
		end, next, 30);
	end,
	func(next) begin
		local reply := call msEntryWith with ("Yes - 8 at the usual place");
		call msCheck with ("the reply in Alice's conversation", reply and reply.dir = 'outgoing
			and StrEqual(reply.thread, "00000002"), "it is " & (if reply then reply.thread));
		HostCellCommand("AT+FAKETEXT=\"+61400000002\",\"Running late, be there by 8:15. Save me a seat near the window if you can.\"");
		call waitFor with ("messages: the answer", func() Length(call msEntries with ()) = 4, next, 30);
	end,
	func(next) begin
		local answer := call msEntryWith with ("Running late, be there by 8:15. Save me a seat near the window if you can.");
		call msCheck with ("read: the conversation is open", answer and answer.state = 'read,
			"it is " & (if answer then answer.state));
		call msSnap with ();
		// a new message, to the card
		msApp:Compose();
		local recipient := GetDataDefs('|nameRef.phone|):MakeNameRef(msCard, '|nameRef.phone|);
		recipient.phone := msCard.phones[0];
		msApp.toPicker.selected := [recipient];
		msApp:Redraw();
		SetValue(msApp.replyLine.entryLine, 'text, "Also - bring the cable");
		call msSnap with ();
		msApp.sendButton:buttonClickScript();
		call waitFor with ("messages: the new message sent", func() begin
			local e := call msEntryWith with ("Also - bring the cable");
			e and e.state = 'sent;
		end, next, 30);
	end,
	func(next) begin
		call msCheck with ("back in the conversation", msApp.mode = 'thread and StrEqual(msApp.currentThread, "00000002"),
			"the mode is " & msApp.mode);
		// the Reply line: Send with only spaces does nothing; it grows with a
		// long message and is one line again when emptied
		local count := Length(call msEntries with ());
		SetValue(msApp.replyLine.entryLine, 'text, Clone("   "));
		msApp.sendButton:buttonClickScript();
		call msCheck with ("Send with only spaces does nothing", Length(call msEntries with ()) = count,
			Length(call msEntries with ()) - count & " sent");
		local oneLine := msApp.replyLine:LocalBox().bottom;
		SetValue(msApp.replyLine.entryLine, 'text, Clone("A message long enough to wrap onto several lines of the reply area, which grows to fit it"));
		call msCheck with ("the Reply line grown", msApp.replyLines > 1 and msApp.replyLine:LocalBox().bottom > oneLine,
			"it is " & msApp.replyLines & " lines");
		call msSnap with ();
		SetValue(msApp.replyLine.entryLine, 'text, Clone(""));
		msApp:ReplyChanged();
		call msCheck with ("the Reply line one line again", msApp.replyLine:LocalBox().bottom = oneLine, "it is not");
		// deleting: the newest message tapped (the pen, at the bubble as
		// drawn) is selected, and Delete removes just it
		RefreshViews();
		local hit := msApp.threadView.hits[0];
		local box := msApp.threadView:GlobalBox();
		msDeleteCount := Length(msApp:ThreadMessages("00000002"));
		msDeleteId := hit.id;
		HostPenTap(box.left + (hit.left + hit.right) div 2, box.top + (hit.top + hit.bottom) div 2);
		call waitFor with ("messages: a message tapped", func() HostPenReplayDone() and msApp.selectedId, next, 10);
	end,
	func(next) begin
		call msCheck with ("the tapped message selected", msApp.selectedId = msDeleteId, "it is " & msApp.selectedId);
		call msSnap with ();
		msApp:DeleteSelected();
		local left := msApp:ThreadMessages("00000002");
		local still := nil;
		foreach e in left do
			if e._uniqueID = msDeleteId then still := true;
		call msCheck with ("Delete removing just that message", Length(left) = msDeleteCount - 1 and not still,
			Length(left) & " left of " & msDeleteCount);
		// nothing selected: the whole conversation, once confirmed
		local confirm := msApp:DeleteSelected();
		call msCheck with ("Delete with nothing selected asking first", confirm and confirm.viewCObject, "it did not ask");
		call msSnap with ();
		confirm.confirmedValue := true;
		confirm:Close();
		call waitFor with ("messages: Alice's conversation deleted", func() Length(msApp:ThreadMessages("00000002")) = 0, next, 10);
	end,
	func(next) begin
		call msCheck with ("back to the list, one conversation left", msApp.mode = 'list and not msApp.currentThread
			and Length(msApp.threads) = 1, "the mode is " & msApp.mode & ", " & Length(msApp.threads) & " conversations");
		call msSnap with ();
		call next with ();
	end,
	// the alert while Messages is closed: one slip, kept up to date
	func(next) begin
		local messages := GetGlobalVar('|HostMessages:host|);
		msApp:Close();
		messages:Received({smsNumber: "0400111222", smsName: "Bob", smsText: "Running late, sorry"});
		local slip := messages.alertSlip;
		call msCheck with ("an alert slip with the text", slip and slip.viewCObject
			and StrPos(slip.titleView.text, "Bob", 0) and StrEqual(slip.bodyView.text, "Running late, sorry"),
			"it is " & (if slip and slip.viewCObject then slip.titleView.text));
		messages:Received({smsNumber: "0400111222", smsName: "Bob", smsText: "Ten minutes away"});
		call msCheck with ("the same slip, two unread, the latest", messages.alertSlip = slip and slip.viewCObject
			and StrPos(slip.titleView.text, "2 unread", 0) and StrPos(slip.bodyView.text, "Ten minutes away", 0),
			"it is " & (if slip and slip.viewCObject then slip.titleView.text & " / " & slip.bodyView.text));
		local slips := 0;
		foreach v in GetRoot():ChildViewFrames() do
			if v.messagesAlert then slips := slips + 1;
		call msCheck with ("only one slip on the screen", slips = 1, slips & " of them");
		call msSnap with ();
		messages:ShowAlerted();
		call msCheck with ("Show: Messages open at Bob's conversation, the slip gone", msApp.viewCObject and msApp.mode = 'thread
			and StrEqual(msApp.currentThread, messages:ThreadKey("0400111222")) and not messages.alertSlip and messages.alertCount = 0,
			"the mode is " & msApp.mode);
		// (Ada's conversation open, for the locked screen's)
		messages:Received({smsNumber: "0400333444", smsName: "Ada", smsText: "Hello"});
		msApp:OpenThread(messages:ThreadKey("0400333444"));
		call next with ();
	end,
	// the screen locked (host/HostQuickSheet.h): what came left on the lock
	// screen, not in a slip; Messages open at the conversation behind it
	// does not take it as read until the unlock
	func(next) begin
		local app := GetGlobalVar('|HostMessages:host|);
		local sheet := GetGlobalVar('|QuickSheet:host|);
		ScreenLockNow();
		app:Received({smsNumber: "0400333444", smsName: "Ada", smsText: "While locked"});
		local notes := ScreenLockNotifications();
		call msCheck with ("locked: no slip, a notification on the lock screen", not app.alertSlip and Length(notes) = 1
			and notes[0].appSymbol = app.appSymbol and StrPos(notes[0].title, "Ada", 0),
			Length(notes) & " notifications, the slip " & (if app.alertSlip then "up" else "not up"));
		app:Received({smsNumber: "0400333444", smsName: "Ada", smsText: "Still locked"});
		notes := ScreenLockNotifications();
		call msCheck with ("the same notification, two unread", Length(notes) = 1 and StrPos(notes[0].title, "2 unread", 0)
			and StrPos(notes[0].text, "Still locked", 0), if Length(notes) = 1 then notes[0].title else Length(notes) & " of them");
		local unread := 0;
		foreach e in msApp:ThreadMessages(app:ThreadKey("0400333444")) do if e.state = 'unread then unread := unread + 1;
		call msCheck with ("unread with its conversation open behind the lock", unread = 2, unread & " unread");
		sheet:Unlock();
		unread := 0;
		foreach e in msApp:ThreadMessages(app:ThreadKey("0400333444")) do if e.state = 'unread then unread := unread + 1;
		call msCheck with ("unlocked: read in the open conversation, no slip", unread = 0 and not app.alertSlip
			and app.alertCount = 0 and Length(ScreenLockNotifications()) = 0, unread & " unread");
		// closed: the notification tapped (chosen) opens it at the conversation
		msApp:Close();
		ScreenLockNow();
		app:Received({smsNumber: "0400333444", smsName: "Ada", smsText: "While locked"});
		sheet.notes[0].chosen := true;
		sheet:Unlock();
		call msCheck with ("chosen on the lock screen: Messages opened at the conversation", msApp.viewCObject
			and msApp.mode = 'thread and StrEqual(msApp.currentThread, app:ThreadKey("0400333444")) and not app.alertSlip,
			"the mode is " & msApp.mode);
		// closed, not chosen: the slip at the unlock
		msApp:Close();
		ScreenLockNow();
		app:Received({smsNumber: "0400333444", smsName: "Ada", smsText: "While locked"});
		call msCheck with ("closed and locked: no slip yet", not app.alertSlip, "the slip is up");
		sheet:Unlock();
		local slip := app.alertSlip;
		call msCheck with ("unlocked: the slip with what came", slip and slip.viewCObject
			and StrPos(slip.titleView.text, "Ada", 0) and StrPos(slip.bodyView.text, "While locked", 0),
			"it is " & (if slip and slip.viewCObject then slip.titleView.text else "not up"));
		app:ShowAlerted();
		call next with ();
	end,
	func(next) begin
		Print("messages: done, " & msFailures & " failed");
		HostQuit();
	end];

msInBox := func() begin
	local items := [];
	local cursor := Query(GetUnionSoup("InBox"), {type: 'index});
	local e;
	while e := cursor:Entry() do begin
		if e.state = 'Received then AddArraySlot(items, e);
		cursor:Next();
	end;
	items;
end;

msStep := 0;
msNext := func() begin
	local step := msSteps[msStep];
	msStep := msStep + 1;
	call step with (msNext);
end;

call msNext with ();
