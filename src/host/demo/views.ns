// A view hierarchy drawn by the reconstructed view system on the host
// display and written out as an image.  Run from the repository root:
//
//   build/host/host/newtonscript --rom build/MP2100D/rom.bin --display 320x480 src/host/demo/views.ns
//
// The ROM image supplies the fonts and prototypes (protoPicker); the
// picture lands in build/views-demo.pgm (any image viewer opens a PGM).

constant kBold12 := 0x3000;			// espy, 12 point, bold (the packed font spec: family 0, size << 10, face << 20)

// a "slip": a rounded, framed white box with a title and some text
slip := AddView(GetRoot(), {
	viewClass: 74,
	viewFlags: 1,
	viewBounds: {left: 20, top: 30, right: 300, bottom: 260},
	viewFormat: 0x4000451,				// white fill, black frame 4 wide, rounded 4
	viewChildren: [
		{ viewClass: 98, viewFlags: 1,		// a title (TTextView), one line, centred
		  viewBounds: {left: 0, top: 4, right: 280, bottom: 24},
		  viewJustify: 0x800006, viewFont: 0x4800, text: "Newton OS on the host" },
		{ viewClass: 81, viewFlags: 3,		// a paragraph (TParagraphView), wrapped, read-only
		  viewBounds: {left: 12, top: 34, right: 268, bottom: 120},
		  viewFont: 0x3000, viewLineSpacing: 16,
		  text: "This slip, its title and this paragraph are drawn by the reconstructed view system: TView, TTextView and TParagraphView over the reconstructed QuickDraw, with the fonts read out of the MP2100 ROM image." },
		{ viewClass: 74, viewFlags: 1,		// a line across (viewFormat lines)
		  viewBounds: {left: 12, top: 126, right: 268, bottom: 128},
		  viewFormat: 0x4 },			// dark gray fill
		{ viewClass: 92, viewFlags: 3,		// a gauge (TGaugeView)
		  viewBounds: {left: 12, top: 140, right: 268, bottom: 154},
		  viewValue: 62 },
		{ viewClass: 92, viewFlags: 1,		// a slider (an editable gauge): the knob
		  viewBounds: {left: 12, top: 164, right: 268, bottom: 180},
		  viewValue: 25, gaugeDrawLimits: true },
		{ viewClass: 74, viewFlags: 1,		// shapes drawn from a viewDrawScript
		  viewBounds: {left: 12, top: 190, right: 268, bottom: 222},
		  viewDrawScript: func()
		  	:DrawShape([{penPattern: 0, fillPattern: 5}, MakeOval(0, 0, 30, 30),
		  	            {penPattern: 5, fillPattern: 3}, MakeRoundRect(40, 2, 110, 28, 8),
		  	            {fillPattern: 0}, MakePolygon([130, 28, 150, 2, 170, 28]),
		  	            MakeLine(190, 2, 250, 28), MakeLine(190, 28, 250, 2)], nil) },
	]});
slip:Dirty();

// an editable paragraph made the key view: the caret shows under its text
// (a keyboard connected), and a key typed goes in at the caret
para := AddView(GetRoot(), {
	viewClass: 81, viewFlags: 1, viewBounds: {left: 20, top: 400, right: 300, bottom: 430},
	viewFormat: 0x111, viewFont: kBold12, text: "Type here" });
para:Dirty();
KeyboardConnect(true);
SetKeyView(para, 4);
KeyEvent(2, true); KeyEvent(2, nil);		// the d key (the ROM's German layout) typed at the caret: "Typed here"

// the pen: a tap on a button (before the picker opens: a click outside a
// popup closes it instead) - aeClick to its viewClickScript, which tracks
// the press (the button inverted while the pen is down) and runs the
// buttonClickScript when the pen lifts inside; the tap gesture follows a
// click nobody claimed
tapped := AddView(GetRoot(), {
	viewClass: 98, viewFlags: 1 + 0x200 + 0x800, viewBounds: {left: 180, top: 300, right: 300, bottom: 320},
	viewFormat: 0x4000551, viewJustify: 0x800006, viewFont: kBold12, text: "Tap me",
	viewClickScript: func(unit) begin :TrackButton(unit); true end,
	buttonClickScript: func() begin SetValue(self, 'text, "Tapped!"); Print("the button was tapped") end,
	viewGestureScript: func(unit, kind) Print("gesture " & kind) });
tapped:Dirty();
PenDown(240, 310);
PenMove(241, 310);
PenUp();
IdleStrokes();

// a popup menu, as the ROM's protoPicker lays it out, below a "button"
// (opened last: while it is up the keys go to it - the arrows move its
// pick, return picks, escape closes it)
button := AddView(GetRoot(), {
	viewClass: 98, viewFlags: 1, viewBounds: {left: 60, top: 300, right: 160, bottom: 320},
	viewFormat: 0x4000551, viewJustify: 0x800006, viewFont: kBold12, text: "Pick one" });
button:Dirty();
picker := AddView(GetRoot(), {
	_proto: ROMConstant("protoPicker"),
	pickItems: ["Alpha", "Beta", {item: "Gamma", mark: $*}, 'pickSeparator, "A rather longer item that gets cut", "Omega"],
	bounds: button:GlobalBox(),
	pickActionScript: func(index) Print("picked " & index) });
picker:Open();

RefreshViews();
ScreenSnapshot("build/views-demo.pgm");
Print("written build/views-demo.pgm");
