// Correcting: a word written, read, and put right from the corrector.
//
//   build/host/host/newton --display 320x480 --headless 90 --script src/host/demo/correct.ns
//
// "ton" is written and read, then a double tap on it opens the corrector -
// the other readings the engine sent with the word and what the spelling
// checker makes of it - (build/corrector.pgm), and a tap on "tone" puts
// that in its place (build/corrected.pgm).
//
// Prints "correct: <step>: ok" or "FAILED", and "correct: done" (ctest
// host.NewtonCorrect).

HostInclude("common.ns");			// tapAt, waitFor, walkSetup
HostInclude("penhelpers.ns");		// penWriteWord, penFindPara, penDoubleTap

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
correctFailures := 0;

correctCheck := func(what, ok)
  begin
    if not ok then correctFailures := correctFailures + 1;
    Print("correct: " & what & (if ok then ": ok" else ": FAILED"));
  end;

correctFinish := func()
  begin
    Print("correct: done, " & correctFailures & " failed");
    HostQuit();
  end;

// the corrector's list of readings, when it is up: a picker (view class
// 89-91) under the root
findPicker := func(v)
  begin
    local found := nil;
    local cls := BAnd(v.viewClass, 0xFFFF);
    if cls >= 89 and cls <= 91 and v.pickItems then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call findPicker with (child);
    found;
  end;
correctorUp := func() call findPicker with (GetRoot());

// the index of the item that reads word
itemIndex := func(items, word)
  begin
    local found := nil;
    for i := 0 to Length(items) - 1 do
      begin
        local it := items[i];
        local t := if IsString(it) then it else if IsFrame(it) then it.item;
        if not found and IsString(t) and StrEqual(t, word) then found := i;
      end;
    found;
  end;

call walkSetup with (name, func() begin
    call penWriteWord with ("ton", 60, 200);
    local up := Ticks();
    IdleStrokes();
    call waitFor with ("correct: ton", func() Ticks() - up > 40 and call penFindPara with (GetRoot(), "ton"), func() begin
        local para := call penFindPara with (GetRoot(), "ton");
        call correctCheck with ("\"ton\" read", para <> nil);
        if not para then return call correctFinish with ();
        local b := para:GlobalBox();
        call penDoubleTap with (b.left + 10, (b.top + b.bottom) div 2);
        call waitFor with ("correct: the corrector", correctorUp, func() begin
            call correctCheck with ("the corrector up", call correctorUp with ());
            ScreenSnapshot("build/corrector.pgm");
            local picker := call findPicker with (GetRoot());
            local i := call itemIndex with (picker.pickItems, "tone");
            call correctCheck with ("\"tone\" offered", i <> nil);
            if not i then return call correctFinish with ();
            // the items are rows of the list's font, from the top of the
            // picker (Print(picker:GlobalBox()) and the picture show where)
            local pb := picker:GlobalBox();
            call tapAt with ((pb.left + pb.right) div 2, pb.top + 4 + 13 * i + 6);
            call waitFor with ("correct: corrected", func() call penFindPara with (GetRoot(), "tone"), func() begin
                call correctCheck with ("the page reads \"tone\"", call penFindPara with (GetRoot(), "tone") <> nil);
                ScreenSnapshot("build/corrected.pgm");
                call correctFinish with ();
              end, 20);
          end, 20);
      end, 20);
  end);
