// Dragging a selection: "ton" is written on the Notepad and read, selected
// with the hilite stroke (the pen held still, then drawn through the
// word), and then pressed on and dragged 80 pixels down the page.  The
// word ends up that much lower down.
//
//   build/host/host/newton --display 320x480 --headless 90 --script src/host/demo/drag.ns
//
// The drag is paced (PacePen: a sample a tick, as a real pen's arrive), so
// that the page sees the pen still down and drags the word along with it
// (TEditView::HiliteClick, DragAndDrop) - ctest host.NewtonDrag, which is
// what would notice if the paced pen came in all at once again.
// build/drag-before.pgm and build/drag.pgm are the page.
//
// Prints "drag: <step>: ok" or "FAILED", and "drag: done".

HostInclude("common.ns");			// tapAt, waitFor, walkSetup
HostInclude("penhelpers.ns");		// penWriteWord, penFindPara, penDrag

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
dragFailures := 0;

dragCheck := func(what, ok)
  begin
    if not ok then dragFailures := dragFailures + 1;
    Print("drag: " & what & (if ok then ": ok" else ": FAILED"));
  end;

dragFinish := func()
  begin
    Print("drag: done, " & dragFailures & " failed");
    HostQuit();
  end;

call walkSetup with (name, func() begin
    local base := 200;
    call penWriteWord with ("ton", 60, base);
    local up := Ticks();
    IdleStrokes();
    call waitFor with ("drag: ton read", func() Ticks() - up > 40 and call penFindPara with (GetRoot(), "ton"), func() begin
        local para := call penFindPara with (GetRoot(), "ton");
        call dragCheck with ("\"ton\" read", para <> nil);
        if not para then return call dragFinish with ();
        local before := para:GlobalBox();
        // the hilite stroke: the pen held still on the word, then drawn
        // through it
        local y := (before.top + before.bottom) div 2;
        PenDown(before.left - 2, y);
        for i := 1 to 60 do PenMove(before.left - 2, y);
        for x := before.left - 2 to before.right + 2 by 3 do PenMove(x, y);
        PenUp();
        IdleStrokes();
        local selected := Ticks();
        call waitFor with ("drag: selected", func() Ticks() - selected > 70, func() begin
            ScreenSnapshot("build/drag-before.pgm");
            local x := (before.left + before.right) div 2;
            call penDrag with (x, y, x, y + 80);
            local moved := func()
              begin
                local p := call penFindPara with (GetRoot(), "ton");
                p and p:GlobalBox().top > before.top + 60;
              end;
            call waitFor with ("drag: moved", moved,
                func() begin
                    call dragCheck with ("\"ton\" dragged 80 pixels down", call moved with ());
                    ScreenSnapshot("build/drag.pgm");
                    call dragFinish with ();
                  end, 20);
          end, 10);
      end, 20);
  end);
