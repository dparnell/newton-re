// Ink dropped on a paragraph: a word kept as ink, selected with the lasso
// and dragged with the pen onto a paragraph of text, goes into the text as
// an ink word (TParagraphView::Drop: the shape's ink turned into an ink
// word by InkConvert - the CIC converter - and put in where it was let go).
//
//   build/host/host/newton --display 320x480 --headless 120 --script src/host/demo/dropink.ns
//
// "ton" is written and read as text; then, the Notepad keeping writing as
// it was written (_recogSettings 0), "to" further down is kept as a shape
// of ink.  The lasso selects the shape, and the pen, pressed on it, drags
// it up onto the end of "ton" and lets go.  The paragraph then has "ton"
// and an ink word, and the shape is gone.  build/dropink-before.pgm and
// build/dropink.pgm are the page.
//
// Prints "dropink: <step>: ok" or "FAILED", and "dropink: done".

HostInclude("common.ns");			// tapAt, waitFor, walkSetup

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
dropFailures := 0;

dropCheck := func(what, ok)
  begin
    if not ok then dropFailures := dropFailures + 1;
    Print("dropink: " & what & (if ok then ": ok" else ": FAILED"));
  end;

stroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

oval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

// "to", "on" or "ton" written from x on the baseline, a letter at a time
// (the letters of src/host/demo/write.ns)
writeWord := func(word, x, base)
  begin
    for i := 0 to StrLen(word) - 1 do
      begin
        local c := word[i];
        if c = $t then
          begin
            call stroke with ([x + 6, base - 24, x + 6, base - 18, x + 6, base - 12, x + 6, base - 6, x + 6, base]);
            call stroke with ([x, base - 14, x + 4, base - 14, x + 8, base - 14, x + 12, base - 14]);
            x := x + 16;
          end
        else if c = $o then
          begin
            call stroke with (call oval with (x + 6, base - 7, 6, 7));
            x := x + 16;
          end
        else if c = $n then
          begin
            call stroke with ([x, base - 14, x, base - 7, x, base, x, base - 7,
                               x + 1, base - 11, x + 3, base - 13, x + 6, base - 14, x + 9, base - 13,
                               x + 10, base - 10, x + 10, base - 5, x + 10, base]);
            x := x + 16;
          end;
      end;
  end;

// whether a text has an ink word in it (the character 0xF701 standing
// for one)
hasInkWord := func(text)
  begin
    local found := nil;
    for i := 0 to StrLen(text) - 1 do
      if Ord(text[i]) = 0xF701 then found := true;
    found;
  end;

// the first paragraph under v whose text has an ink word in it, or whose
// text starts with `prefix`
findPara := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and IsString(v.text)
       and (if prefix then StrPos(v.text, prefix, 0) = 0 else call hasInkWord with (v.text)) then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call findPara with (child, prefix);
    found;
  end;

// the shapes of ink under v, into an array
findShapes := func(v, into)
  begin
    if BAnd(v.viewClass, 0xFFFF) = 82 and v.ink then
      AddArraySlot(into, v)
    else
      foreach child in v:ChildViewFrames() do
        call findShapes with (child, into);
    into;
  end;

// the lasso: the pen held still beside the box, then drawn round it
lasso := func(box)
  begin
    local l := box.left - 10;
    local t := box.top - 10;
    local r := box.right + 10;
    local b := box.bottom + 10;
    PenDown(l, t);
    for i := 1 to 60 do PenMove(l, t);
    for x := l to r by 3 do PenMove(x, t);
    for y := t to b by 3 do PenMove(r, y);
    for x := r to l by -3 do PenMove(x, b);
    for y := b to t by -3 do PenMove(l, y);
    PenUp();
    IdleStrokes();
  end;

// how many ink words a text has
inkWords := func(text)
  begin
    local n := 0;
    for i := 0 to StrLen(text) - 1 do
      if Ord(text[i]) = 0xF701 then n := n + 1;
    n;
  end;

// the paragraph of text "ton" and, once dropped, the ink word after it
dropped := func()
  begin
    local p := call findPara with (GetRoot(), "ton");
    p and call inkWords with (p.text) = 1 and Length(call findShapes with (GetRoot(), [])) = 0;
  end;

finish := func()
  begin
    Print("dropink: done, " & dropFailures & " failed");
    HostQuit();
  end;

call walkSetup with (name, func() begin
    call writeWord with ("ton", 60, 200);
    local tonUp := Ticks();
    IdleStrokes();
    call waitFor with ("dropink: ton read", func() Ticks() - tonUp > 40 and call findPara with (GetRoot(), "ton"), func() begin
        GetRoot().paperroll._recogSettings := 0;
        PurgeAreaCache();
        call writeWord with ("to", 60, 320);
        local toUp := Ticks();
        IdleStrokes();
        call waitFor with ("dropink: the shape", func() Ticks() - toUp > 40 and Length(call findShapes with (GetRoot(), [])) = 1, func() begin
            local para := call findPara with (GetRoot(), "ton");
            local shape := (call findShapes with (GetRoot(), []))[0];
            call dropCheck with ("\"ton\" read and \"to\" kept as a shape of ink", para and shape);
            if not (para and shape) then return call finish with ();
            GetRoot().paperroll._recogSettings := 864;
            PurgeAreaCache();
            ScreenSnapshot("build/dropink-before.pgm");
            local sb := shape:GlobalBox();
            call lasso with (sb);
            local lassoed := Ticks();
            call waitFor with ("dropink: selected", func() Ticks() - lassoed > 70, func() begin
                // pressed on the selection and dragged up onto the end of
                // "ton" (paced, a sample a tick, so the page sees the pen
                // down all the way)
                local pb := para:GlobalBox();
                local x0 := (sb.left + sb.right) div 2;
                local y0 := (sb.top + sb.bottom) div 2;
                local x1 := pb.right - 2;
                local y1 := (pb.top + pb.bottom) div 2;
                PacePen(true);
                PenDown(x0, y0);
                for k := 1 to 40 do PenMove(x0 + ((x1 - x0) * k) div 40, y0 + ((y1 - y0) * k) div 40);
                for i := 1 to 10 do PenMove(x1 + i mod 2, y1);
                PenUp();
                PacePen(nil);
                call waitFor with ("dropink: dropped", func() call dropped with (), func() begin
                    call dropCheck with ("the ink went into \"ton\" as an ink word", call dropped with ());
                    ScreenSnapshot("build/dropink.pgm");
                    call finish with ();
                  end, 30);
              end, 10);
          end, 20);
      end, 20);
  end);
