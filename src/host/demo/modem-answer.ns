// The modem tool (comms/ModemTool.h) answering a call: a
// protoBasicEndpoint (@383) over the modem service ('mecp 0: no error
// correction) listening - the modem asked the rings so far ("ATS1?"),
// then waiting; each RING has them asked again, and after the two the
// dialing options ask for, "ATA" - then the call accepted, "hello" and a
// line written and read back from the caller (the echo server newton runs
// with --tcp-echo, which tools/modem/fakemodem.py rings the Newton with),
// and the endpoint disconnected (ctest host.NewtonModemAnswer):
//
//   python tools/modem/fakemodem.py --incoming 127.0.0.1:52376 \
//       --spawn build/host/host/newton --rom build/MP2x00US/rom.bin \
//       --serial-port 0 --tcp-echo 52376 --headless 120 \
//       --script src/host/demo/modem-answer.ns

HostInclude("common.ns");
done := nil;

ep := {_proto: @383,
	exceptionHandler: func(e) begin
		Print("modem-answer: exception " & e.name & " " & e.data);
		true;
	end};

options := [
	{label: "mods", type: 'service, opCode: 512},
	{label: "mecp", type: 'option, opCode: 512,
	 data: {arglist: [0], typelist: ['struct, 'ulong]}}];

ep:Instantiate(ep, options);
ep:Bind(nil, nil);
Print("modem-answer: listening");
ep:Listen(nil, nil);
Print("modem-answer: a call, state " & ep:State());
ep:Accept(nil, nil);
Print("modem-answer: accepted, state " & ep:State());

ep:SetInputSpec({
	form: 'string,
	termination: {byteCount: 5},
	inputScript: func(endpoint, data, terminator, options) begin
		Print("modem-answer: received " & data);
		endpoint:SetInputSpec({
			form: 'string,
			termination: {endSequence: $\n},
			inputScript: func(endpoint, data, terminator, options) begin
				Print("modem-answer: line of " & StrLen(data) & " characters");
				done := true;
			end});
		endpoint:Output("answered the telephone\n", nil, nil);
	end});
ep:Output("hello", nil, nil);

call waitFor with ("modem-answer: the echo", func() done, func() begin
	ep:Cancel(nil);
	ep:Disconnect(true, nil);
	Print("modem-answer: disconnected, state " & ep:State());
	ep:Unbind(nil);
	ep:Dispose();
	Print("modem-answer: done");
	HostQuit();
end, 60);
