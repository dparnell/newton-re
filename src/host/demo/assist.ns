// The Intelligent Assistant: "call Daniel" parsed and carried out.  The
// Setup walk leaves an owner card for Daniel in the Names file; the
// sentence is handed to ParseUtter, which opens the Assist slip with it,
// looks each run of words up in the lexicon (the ROM's trie knows "call"
// as the call action; "Daniel" is found in the Names file), picks the
// call task and opens its slip addressed to him.  The picture is taken
// with the Call slip up.
//
//   build/host/host/newton --display 320x480 --headless 90 --script src/host/demo/assist.ns
//
// ctest host.NewtonAssist: the frontmost view is the Call slip - a "Call"
// button and Daniel's name in it.  build/assist.pgm is the screen.
//
// Prints "assist: <step>: ok" or "FAILED", and "assist: done".

HostInclude("common.ns");			// tapAt, waitFor, walkSetup

name := [2, 0, 45, 34, 14, 37];				// "Daniel" in ADB key codes
assistFailures := 0;

assistCheck := func(what, ok)
  begin
    if not ok then assistFailures := assistFailures + 1;
    Print("assist: " & what & (if ok then ": ok" else ": FAILED"));
  end;

// a view under v whose text has the words in it
assistFind := func(v, words)
  begin
    local found := nil;
    if IsString(v.text) and StrPos(v.text, words, 0) then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call assistFind with (child, words);
    found;
  end;

// the Call slip: the frontmost view, with a Call button and Daniel in it
callSlip := func()
  begin
    local kids := GetRoot():ChildViewFrames();
    local front := kids[Length(kids) - 1];
    call assistFind with (front, "Call") and call assistFind with (front, "daniel");
  end;

call walkSetup with (name, func() begin
    local task := ParseUtter("call Daniel");
    call assistCheck with ("\"call Daniel\" parsed into a task", task <> nil);
    call waitFor with ("assist: the Call slip", callSlip, func() begin
        call assistCheck with ("the Call slip open, addressed to Daniel", call callSlip with ());
        ScreenSnapshot("build/assist.pgm");
        Print("assist: done, " & assistFailures & " failed");
        HostQuit();
      end, 20);
  end);
