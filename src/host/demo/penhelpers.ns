// What the pen demos share, run by `HostInclude("penhelpers.ns")` after
// common.ns (whose tapAt, waitFor and walkSetup they use):
//
//   penStroke(points)          one stroke through [x0, y0, x1, y1, ...]
//   penOval(cx, cy, rx, ry)    the points of an o, from the top anticlockwise
//   penWriteWord(word, x, base)
//                              "t", "o" and "n" written from x on the
//                              baseline, a letter at a time (the letters
//                              of write.ns - Rosetta reads them)
//   penFindPara(v, prefix)     the first paragraph under v whose text starts
//                              with prefix - or, prefix nil, has an ink word
//   penInkWords(text)          how many ink words (0xF701) a text has
//   penFindShapes(v, into)     the shapes of ink under v, added to into
//   penLasso(box)              the pen held still beside box, then drawn
//                              round it: the lasso selects what it circles
//   penDoubleTap(x, y)         two taps at once
//   penDrag(x0, y0, x1, y1)    pressed and dragged, a sample a tick
//                              (PacePen), so a view tracking it sees it down
//   penPath(corners)           a stroke's points through the corners, a
//                              point every few pixels, a little wobble,
//                              the pen pausing at each corner
//   penRound(cx, cy, r)        a circle's points from the right anticlockwise
//   penFindPolys(v, into)      the shapes (polygon views, class 82) under v
//                              that are not ink, added to into
//
// Timing the ROM holds a script to: a tap sooner than half a second after
// the pen came up from writing is taken for more writing (HandleUnit's
// fPrevUpTime + 30), and a press within 60 ticks of the click before it is
// the second half of a tap-drag (PartOfTapDrag) - so a demo waits on
// Ticks() for those, a condition rather than a fixed delay.

penStroke := func(points)
  begin
    PenDown(points[0], points[1]);
    for i := 2 to Length(points) - 2 by 2 do
      PenMove(points[i], points[i + 1]);
    PenUp();
  end;

penOval := func(cx, cy, rx, ry)
  begin
    local c := [ 0, -50, -87, -100, -87, -50, 0, 50, 87, 100, 87, 50, 0];
    local s := [100, 87, 50, 0, -50, -87, -100, -87, -50, 0, 50, 87, 100];
    local pts := [];
    for k := 0 to 12 do
      begin
        AddArraySlot(pts, cx + (rx * c[k]) div 100);
        AddArraySlot(pts, cy - (ry * s[k]) div 100);
      end;
    pts;
  end;

penWriteWord := func(word, x, base)
  begin
    for i := 0 to StrLen(word) - 1 do
      begin
        local c := word[i];
        if c = $t then
          begin
            call penStroke with ([x + 6, base - 24, x + 6, base - 18, x + 6, base - 12, x + 6, base - 6, x + 6, base]);
            call penStroke with ([x, base - 14, x + 4, base - 14, x + 8, base - 14, x + 12, base - 14]);
            x := x + 16;
          end
        else if c = $o then
          begin
            call penStroke with (call penOval with (x + 6, base - 7, 6, 7));
            x := x + 16;
          end
        else if c = $n then
          begin
            call penStroke with ([x, base - 14, x, base - 7, x, base, x, base - 7,
                                  x + 1, base - 11, x + 3, base - 13, x + 6, base - 14, x + 9, base - 13,
                                  x + 10, base - 10, x + 10, base - 5, x + 10, base]);
            x := x + 16;
          end;
      end;
  end;

penInkWords := func(text)
  begin
    local n := 0;
    for i := 0 to StrLen(text) - 1 do
      if Ord(text[i]) = 0xF701 then n := n + 1;
    n;
  end;

penFindPara := func(v, prefix)
  begin
    local found := nil;
    if BAnd(v.viewClass, 0xFFFF) = 81 and IsString(v.text)
       and (if prefix then StrPos(v.text, prefix, 0) = 0 else call penInkWords with (v.text) > 0) then
      found := v
    else
      foreach child in v:ChildViewFrames() do
        if not found then
          found := call penFindPara with (child, prefix);
    found;
  end;

penFindShapes := func(v, into)
  begin
    if BAnd(v.viewClass, 0xFFFF) = 82 and v.ink then
      AddArraySlot(into, v)
    else
      foreach child in v:ChildViewFrames() do
        call penFindShapes with (child, into);
    into;
  end;

penLasso := func(box)
  begin
    local l := box.left - 10;
    local t := box.top - 10;
    local r := box.right + 10;
    local b := box.bottom + 10;
    PenDown(l, t);
    for i := 1 to 60 do PenMove(l, t);
    for x := l to r by 3 do PenMove(x, t);
    for y := t to b by 3 do PenMove(r, y);
    for x := r to l by -3 do PenMove(x, b);
    for y := b to t by -3 do PenMove(l, y);
    PenUp();
    IdleStrokes();
  end;

penDoubleTap := func(x, y)
  begin
    PenDown(x, y); PenUp(); IdleStrokes();
    PenDown(x, y); PenUp(); IdleStrokes();
  end;

penDrag := func(x0, y0, x1, y1)
  begin
    PacePen(true);
    PenDown(x0, y0);
    for k := 1 to 40 do PenMove(x0 + ((x1 - x0) * k) div 40, y0 + ((y1 - y0) * k) div 40);
    for i := 1 to 10 do PenMove(x1 + i mod 2, y1);
    PenUp();
    PacePen(nil);
  end;

penPath := func(corners)
  begin
    local pts := [];
    local wobble := [0, 1, 1, 0, -1, -1];
    local w := 0;
    for c := 0 to Length(corners) - 4 by 2 do
      begin
        local x0 := corners[c], y0 := corners[c + 1];
        local x1 := corners[c + 2], y1 := corners[c + 3];
        local steps := Max(Abs(x1 - x0), Abs(y1 - y0)) div 4;
        // the pen pauses at a corner, as a hand slows into one: the shape
        // recogniser takes a join the pen did not slow at for a smooth one
        // (RSmallDists, with its ROM bug fixed)
        if c > 0 then
          for k := 1 to 4 do
            begin
              AddArraySlot(pts, x0);
              AddArraySlot(pts, y0);
            end;
        for k := 0 to steps - 1 do
          begin
            AddArraySlot(pts, x0 + ((x1 - x0) * k) div steps + wobble[w mod 6]);
            AddArraySlot(pts, y0 + ((y1 - y0) * k) div steps + wobble[(w + 2) mod 6]);
            w := w + 1;
          end;
      end;
    AddArraySlot(pts, corners[Length(corners) - 2]);
    AddArraySlot(pts, corners[Length(corners) - 1]);
    pts;
  end;

penRound := func(cx, cy, r)
  begin
    local c := [100, 98, 94, 87, 77, 64, 50, 34, 17, 0, -17, -34, -50, -64, -77, -87, -94, -98,
                -100, -98, -94, -87, -77, -64, -50, -34, -17, 0, 17, 34, 50, 64, 77, 87, 94, 98, 100];
    local s := [0, 17, 34, 50, 64, 77, 87, 94, 98, 100, 98, 94, 87, 77, 64, 50, 34, 17,
                0, -17, -34, -50, -64, -77, -87, -94, -98, -100, -98, -94, -87, -77, -64, -50, -34, -17, 0];
    local pts := [];
    for k := 0 to 35 do
      begin
        AddArraySlot(pts, cx + (r * c[k]) div 100);
        AddArraySlot(pts, cy - (r * s[k]) div 100);
      end;
    pts;
  end;

penFindPolys := func(v, into)
  begin
    if BAnd(v.viewClass, 0xFFFF) = 82 and not v.ink then
      AddArraySlot(into, v)
    else
      foreach child in v:ChildViewFrames() do
        call penFindPolys with (child, into);
    into;
  end;
