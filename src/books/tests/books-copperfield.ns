// Copperfield, the book reader for books that are not help books: a copy
// of the ROM's help book under an ISBN of its own is put in the library
// (BookAvailable, as a package's 'book part is), opened (OpenBook) and
// turned (TurnToPage, ScrollPage), its reading place kept in the Library
// soup (CurrentPage, PreviousPage) and bookmarked (AddBookmark).  The
// display is written to tmp/books-copperfield.pgm (the book's page 5, with
// the reader's control panel).
//
//   build/host/host/newton --rom <image> --display 320x480 --headless 10 --script src/books/tests/books-copperfield.ns

failures := 0;
check := func(what, ok)
  begin
    if not ok then
      begin
        Print("books-copperfield: FAILED " & what);
        failures := failures + 1;
      end;
  end;

AddDelayedCall(func() begin
    local root := GetRoot();
    local cf := root.copperfield;
    local book := Clone(cf.library.|GECKO!HDI?|.book);
    book.isbn := "HELP-COPY";
    book.title := "Help Copy";
    RemoveSlot(book, 'help);
    call check with ("BookAvailable", IsFrame(BookAvailable({book: book}, 5)));
    cf:OpenBook("HELP-COPY");
    call check with ("the reader is open", Visible(cf));
    call check with ("at the book", StrEqual(cf.isbn, "HELP-COPY"));
    cf:TurnToPage(5);
    call check with ("at page 5", cf:CurrentPage() = 5);
    cf:ScrollPage(1);
    call check with ("a page on", cf:CurrentPage() = 6 and cf:PreviousPage() = 5);
    cf:ScrollPage(-100);
    call check with ("not before the first page", cf:CurrentPage() = 6);
    cf:ScrollPage(-1);
    call check with ("and back", cf:CurrentPage() = 5);
    local marks := cf:AddBookmark(5);
    call check with ("a bookmark", marks and Length(marks) = 1 and marks[0] = 5);
    call check with ("not twice", cf:AddBookmark(5) = nil);
    call check with ("the title from the Library soup", StrEqual(cf:BookTitle(), "Help Copy"));
    AddDelayedCall(func() begin
        ScreenSnapshot("tmp/books-copperfield.pgm");
        local kids := cf.cuPage.contentArea:ChildViewFrames();
        call check with ("the page has views", Length(kids) >= 2);
        // a thumbnail of the page: PageCThumbnail's remote view (class 88)
        // drawn into a 60x80 bitmap, which is shown in the corner
        local bits := cf:PageThumbnail(5);
        call check with ("a thumbnail", bits and bits.data);
        if bits then
          begin
            local black := 0;
            // (the pixels are the last 80 rows of 8 bytes of the binary)
            local data := bits.data;
            for i := Length(data) - 640 to Length(data) - 1 do
              begin
                local b := ExtractByte(data, i);
                while b <> 0 do
                  begin
                    black := black + (b mod 2);
                    b := b div 2;
                  end;
              end;
            Print("books-copperfield: thumbnail " & NumberStr(black) & " black pixels");
            call check with ("something drawn in it", black > 20 and black < 2400);
            // the whole page, not only its top-left corner: ink in the right
            // half (bytes 3 to 7 of a row, x 24 and on) and below row 40
            local right := 0;
            local low := 0;
            for i := Length(data) - 640 to Length(data) - 1 do
              if ExtractByte(data, i) <> 0 then
                begin
                  local k := i - (Length(data) - 640);
                  if k mod 8 >= 3 then right := right + 1;
                  if k div 8 >= 40 then low := low + 1;
                end;
            call check with ("the thumbnail's right half is drawn", right > 20);
            call check with ("the thumbnail's lower half is drawn", low > 20);
            GetRoot():DrawShape(MakeShape(bits), {transform: [250, 400]});
          end;
        ScreenSnapshot("tmp/books-thumbnail.pgm");
        Print("books-copperfield: done, " & NumberStr(failures) & " failed");
      end, nil, 2000);
  end, nil, 3000);
